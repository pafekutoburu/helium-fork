Index: src/chrome/browser/ui/views/tabs/vertical/arc_sidebar_top_container.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/views/tabs/vertical/arc_sidebar_top_container.cc
@@ -0,0 +1,85 @@
+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/vertical/arc_sidebar_top_container.h"
+
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/views/layout/flex_layout_types.h"
+#include "ui/views/view_class_properties.h"
+
+ArcSidebarTopContainer::ArcSidebarTopContainer() {
+  SetOrientation(views::LayoutOrientation::kHorizontal);
+  SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+
+  caption_spacer_ = AddChildView(std::make_unique<views::View>());
+  caption_spacer_->SetCanProcessEventsWithinSubtree(false);
+  caption_spacer_->SetVisible(false);
+
+  flex_spacer_ = AddChildView(std::make_unique<views::View>());
+  flex_spacer_->SetCanProcessEventsWithinSubtree(false);
+  // The orientation-tagged specification flexes the spacer along the row
+  // only. The two-argument form applies to BOTH axes, which lets the spacer
+  // demand unbounded height and inflates the whole row (measured: a 298px
+  // top row splitting the sidebar's spare space with the bottom container).
+  flex_spacer_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::LayoutOrientation::kHorizontal,
+                               views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kUnbounded));
+}
+
+ArcSidebarTopContainer::~ArcSidebarTopContainer() = default;
+
+void ArcSidebarTopContainer::SetCaptionExclusion(int width,
+                                                 int min_height,
+                                                 bool on_trailing_edge) {
+  const gfx::Size reservation(std::max(width, 0),
+                              width > 0 ? std::max(min_height, 0) : 0);
+  const size_t target_index = on_trailing_edge ? children().size() - 1 : 0;
+  const bool changed = caption_spacer_->GetPreferredSize() != reservation ||
+                       GetIndexOf(caption_spacer_).value() != target_index;
+  if (!changed) {
+    return;
+  }
+  caption_spacer_->SetPreferredSize(reservation);
+  caption_spacer_->SetVisible(width > 0);
+  ReorderChildView(caption_spacer_, target_index);
+  InvalidateLayout();
+}
+
+void ArcSidebarTopContainer::AddLeadingControl(views::View* control) {
+  // Right after the caption spacer when it leads; index 0 otherwise.
+  const size_t spacer_index = GetIndexOf(caption_spacer_).value();
+  const size_t flex_index = GetIndexOf(flex_spacer_).value();
+  AddChildViewAt(control,
+                 spacer_index < flex_index ? spacer_index + 1 : size_t{0});
+}
+
+void ArcSidebarTopContainer::AddTrailingControl(views::View* control) {
+  // Trailing controls sit after the flex spacer, before a trailing caption
+  // spacer if one is active (right-aligned tab strip).
+  const size_t spacer_index = GetIndexOf(caption_spacer_).value();
+  const size_t flex_index = GetIndexOf(flex_spacer_).value();
+  AddChildViewAt(control, spacer_index > flex_index ? spacer_index
+                                                    : children().size());
+}
+
+bool ArcSidebarTopContainer::IsPositionInWindowCaption(
+    const gfx::Point& point) {
+  for (views::View* child : children()) {
+    if (!child->GetVisible() || child == caption_spacer_ ||
+        child == flex_spacer_) {
+      continue;
+    }
+    gfx::Point point_in_child = point;
+    views::View::ConvertPointToTarget(this, child, &point_in_child);
+    if (child->HitTestPoint(point_in_child)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+BEGIN_METADATA(ArcSidebarTopContainer)
+END_METADATA
