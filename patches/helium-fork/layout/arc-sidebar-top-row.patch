@@ -0,0 +1,42 @@
+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_ARC_SIDEBAR_TOP_CONTAINER_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_ARC_SIDEBAR_TOP_CONTAINER_H_
+
+#include "ui/views/layout/flex_layout_view.h"
+
+// helium-fork: top row of the vertical tab strip in the Arc shell. Reserves
+// room for the macOS window controls at its leading edge, keeps the collapse
+// button next to them, and right-aligns navigation controls against the
+// content side. The buttons themselves are owned by ToolbarView and reparented
+// in here by BrowserView; this container only lays them out.
+class ArcSidebarTopContainer : public views::FlexLayoutView {
+  METADATA_HEADER(ArcSidebarTopContainer, views::FlexLayoutView)
+ public:
+  ArcSidebarTopContainer();
+  ~ArcSidebarTopContainer() override;
+
+  // Reserves `width` at the leading (or, for a right-aligned tab strip,
+  // trailing) edge so the row's controls never render under the window
+  // controls, and keeps the row at least `min_height` tall while reserving.
+  // A zero `width` clears the reservation (sidebar below the caption area,
+  // fullscreen, non-mac).
+  void SetCaptionExclusion(int width, int min_height, bool on_trailing_edge);
+
+  // Places `control` right after the caption reservation (collapse button).
+  void AddLeadingControl(views::View* control);
+  // Places `control` against the content-side edge (navigation buttons).
+  void AddTrailingControl(views::View* control);
+
+  // True when `point` (in this view's coordinates) hits no interactive child
+  // and should therefore drag the window.
+  bool IsPositionInWindowCaption(const gfx::Point& point);
+
+ private:
+  raw_ptr<views::View> caption_spacer_ = nullptr;
+  raw_ptr<views::View> flex_spacer_ = nullptr;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_ARC_SIDEBAR_TOP_CONTAINER_H_
