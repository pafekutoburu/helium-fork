+void VerticalTabStripRegionView::SetCaptionExclusionForLayout(
+    int width,
+    int min_height,
+    int caption_center,
+    bool on_trailing_edge) {
+  arc_top_container_->SetCaptionExclusion(width, min_height, on_trailing_edge);
+
+  // helium-fork: center the row on the caption buttons instead of parking it
+  // at a fixed padding. The row's own height is whatever its tallest control
+  // needs, and the strip's origin moves (docked vs floating card vs zen), so
+  // any constant here is wrong in at least one state -- which is exactly how
+  // the traffic lights ended up 2-10px off the icon row.
+  //
+  // caption_center <= 0 means there is no caption on this side (right-aligned
+  // sidebar; macOS keeps the lights on the left): fall back to plain padding.
+  const int row_height = arc_top_container_->GetPreferredSize().height();
+  const int top_margin =
+      caption_center > 0
+          ? std::max(0, caption_center - row_height / 2)
+          : kArcTopContainerGap;
+  const int horizontal_padding =
+      GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+  const gfx::Insets margins =
+      gfx::Insets::TLBR(top_margin, horizontal_padding, kArcTopContainerGap,
+                        horizontal_padding);
+  if (arc_top_container_->GetProperty(views::kMarginsKey) &&
+      *arc_top_container_->GetProperty(views::kMarginsKey) == margins) {
+    return;
+  }
+  arc_top_container_->SetProperty(views::kMarginsKey, margins);
+}
