+}
+
+void TopContainerView::DOMContentLoaded(
+    content::RenderFrameHost* render_frame_host) {
+  // A fresh tab reports its color only once the document is up; without this
+  // the band would keep the previous page's tint until the next layout.
+  OnPageColorMaybeChanged();
+}
+
+void TopContainerView::DidFirstVisuallyNonEmptyPaint() {
+  // Kept as a backstop only. It used to be the signal that opened the gate,
+  // and that is what made the band trail the page: blink registers this
+  // through NotifyPresentationTime (web_frame_widget_impl.cc), so it is a
+  // receipt for a frame that viz has already *presented* -- the browser hears
+  // about it a compositor round trip plus a mojo hop after the user has seen
+  // the new page, and then still has to lay out and paint. The frame metadata
+  // callback below beats it by that whole margin. ReleasePagePaintGate() is
+  // idempotent, so leaving this wired costs nothing.
+  ReleasePagePaintGate();
+}
+
+void TopContainerView::RenderFrameHostChanged(
