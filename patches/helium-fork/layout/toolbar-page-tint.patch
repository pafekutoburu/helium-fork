+std::optional<SkColor> BrowserViewLayoutDelegateImpl::GetAddressBarBandTint()
+    const {
+  // helium-fork: the page's declared theme color wins; failing that, the color
+  // actually rendered at the top of the viewport; failing that, the document's
+  // background color.
+  //
+  // The middle step is the important one. GetBackgroundColor() reports the
+  // *document* background, which for a light document carrying a full-bleed
+  // dark header (films.dance, and Squarespace sites generally) is near-white
+  // while the strip the band abuts is black -- the band and the page then read
+  // as two obviously different surfaces, which is the whole complaint.
+  content::WebContents* const contents = browser_view_->GetActiveWebContents();
+  if (!contents) {
+    return std::nullopt;
+  }
+  std::optional<SkColor> page_color = contents->GetThemeColor();
+  if (!page_color && browser_view_->top_container()) {
+    page_color = browser_view_->top_container()->sampled_page_top_color();
+  }
+  if (!page_color) {
+    page_color = contents->GetBackgroundColor();
+  }
+  const ui::ColorProvider* const colors = browser_view_->GetColorProvider();
+  if (!page_color || !colors) {
+    return std::nullopt;
+  }
+
+  // Either color can be arbitrary, while the band's text and icons come from
+  // the browser theme -- so blend the tint back toward the theme's own
+  // toolbar color until it clears a legibility floor against them. A page
+  // whose color already contrasts is used verbatim; one that does not (a
+  // black page under a light theme) lands somewhere in between rather than
+  // swallowing the omnibox.
+  constexpr float kMinBandContrast = 4.5f;
+  constexpr float kBlendStep = 0.2f;
+  constexpr int kMaxBlendSteps = 8;
+  const SkColor foreground = colors->GetColor(kColorToolbarText);
+  const SkColor theme_color = colors->GetColor(kColorToolbar);
+  SkColor tint = SkColorSetA(*page_color, SK_AlphaOPAQUE);
+  for (int i = 0; i < kMaxBlendSteps &&
+                  color_utils::GetContrastRatio(tint, foreground) <
+                      kMinBandContrast;
+       ++i) {
+    tint = color_utils::AlphaBlend(theme_color, tint, kBlendStep);
+  }
+  return tint;
+}
