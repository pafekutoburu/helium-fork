+}
+
+void TopContainerView::OnVisibilityChanged(content::Visibility visibility) {
+  // A tab that was hidden when it became active has no surface to copy from,
+  // so the sample taken at switch time was dropped. This is the retry.
+  if (visibility == content::Visibility::VISIBLE) {
+    SyncFrameMetadataObservation();
+    SamplePageTopColor();
+  }
+}
+
+void TopContainerView::OnRenderFrameMetadataChangedBeforeActivation(
+    const cc::RenderFrameMetadata& metadata) {
+  // helium-fork: this is the earliest point at which the browser knows the new
+  // document has a frame -- the renderer has submitted it and viz has not yet
+  // activated it. Opening the gate here is what lets the band's color land in
+  // the same browser frame the page's own pixels land in.
+  //
+  // It fires for every frame the renderer submits, so it must not do work per
+  // frame: ReleasePagePaintGate() early-returns unless the gate is actually
+  // closed, and awaiting_first_frame_ keeps it to the first frame after a
+  // commit. Re-sampling on every frame would also make the band follow
+  // scrolling, which this shell has already ruled out.
+  if (!awaiting_first_frame_) {
+    return;
+  }
+  awaiting_first_frame_ = false;
+  ReleasePagePaintGate();
+}
+
+void TopContainerView::OnRenderFrameMetadataChangedAfterActivation(
+    base::TimeTicks activation_time) {}
+
+void TopContainerView::OnRenderFrameSubmission() {}
+
+void TopContainerView::OnLocalSurfaceIdChanged(
+    const cc::RenderFrameMetadata& metadata) {}
+
+void TopContainerView::RenderWidgetHostDestroyed(
+    content::RenderWidgetHost* widget_host) {
+  if (observed_widget_ == widget_host) {
+    StopObservingFrameMetadata();
+  }
+}
+
+void TopContainerView::SyncFrameMetadataObservation() {
+  content::RenderWidgetHost* const widget = WidgetFor(web_contents());
+  if (widget == observed_widget_) {
+    return;
+  }
+  StopObservingFrameMetadata();
+  if (!widget) {
+    return;
+  }
+  content::RenderFrameMetadataProvider* const provider =
+      widget->GetRenderFrameMetadataProvider();
+  if (!provider) {
+    return;
+  }
+  observed_widget_ = widget;
+  widget->AddObserver(this);
+  provider->AddObserver(this);
+}
+
+void TopContainerView::StopObservingFrameMetadata() {
+  if (!observed_widget_) {
+    return;
+  }
+  if (content::RenderFrameMetadataProvider* const provider =
+          observed_widget_->GetRenderFrameMetadataProvider()) {
+    provider->RemoveObserver(this);
+  }
+  observed_widget_->RemoveObserver(this);
+  observed_widget_ = nullptr;
+}
+
+void TopContainerView::DocumentOnLoadCompletedInPrimaryMainFrame() {
+  // A document with nothing to paint (about:blank, an empty response) never
+  // reports a first paint, but it *is* on screen -- Chromium stops holding the
+  // previous page's pixels for it. Load completion is the signal that covers
+  // that case; for a document with content it lands at or after the first
+  // paint, so it changes nothing there.
+  ReleasePagePaintGate();
+}
+
+void TopContainerView::DidFinishNavigation(
+    content::NavigationHandle* navigation_handle) {
+  if (!navigation_handle->IsInPrimaryMainFrame() ||
+      !navigation_handle->HasCommitted()) {
+    return;
+  }
+  // Keep the previous page's color until the new page produces one: the
+  // sample generation counter already keeps a stale readback from landing on
+  // the new page, and dropping the color here snapped the band and all its
+  // icons back to the default toolbar look on every reload ("地址栏很清晰的
+  // 自己又跳出来了").
+  if (!navigation_handle->IsSameDocument()) {
+    // A new document owns the band's color only once it is the one on screen.
+    page_painted_ = false;
+    awaiting_first_frame_ = true;
+    SyncFrameMetadataObservation();
+    // Backstop, in case neither signal arrives. It is blink's own paint-holding
+    // deadline on purpose: that is exactly how long the previous page's pixels
+    // can stay on screen, so the band cannot outlast what it is describing.
+    // (A shorter guess here is not a safety net, it is the bug -- a 500ms one
+    // opened the gate 700ms before a deliberately slow page painted, and the
+    // band went black over a still-white page just as before.)
+    page_paint_timer_.Start(
+        FROM_HERE, blink::kNewContentRenderingDelay,
+        base::BindOnce(&TopContainerView::ReleasePagePaintGate,
+                       base::Unretained(this)));
+  }
+  OnPageColorMaybeChanged();
+}
+
+void TopContainerView::ReleasePagePaintGate() {
+  page_paint_timer_.Stop();
+  awaiting_first_frame_ = false;
+  if (page_painted_) {
+    return;
+  }
+  page_painted_ = true;
+  OnPageColorMaybeChanged();
+}
+
+void TopContainerView::OnPageColorMaybeChanged() {
+  SamplePageTopColor();
+  // The tint is resolved in BrowserViewLayoutImpl's post-layout pass, so a
+  // repaint alone would not pick it up.
+  browser_view_->InvalidateLayout();
+}
+
+void TopContainerView::SamplePageTopColor() {
+  // helium-fork: read back the strip of page the band sits against.
+  //
+  // Only the first few rows: a header's text and logo are normally vertically
+  // centered well below them, so this averages background and not content.
+  // The GPU does the averaging by scaling the strip to a single pixel, which
+  // is why the output size is 1x1 rather than a bitmap we would reduce here.
+  constexpr int kSampleStripHeight = 4;
+
+  content::WebContents* const contents = web_contents();
+  if (!contents) {
+    return;
+  }
+  content::RenderWidgetHostView* const view =
+      contents->GetRenderWidgetHostView();
+  if (!view || !view->IsSurfaceAvailableForCopy()) {
+    // Normal at tab-switch time: the incoming tab has not been shown yet, so
+    // it has no surface. OnVisibilityChanged() retries once it does.
+    return;
+  }
+  const gfx::Size viewport = view->GetVisibleViewportSize();
+  if (viewport.IsEmpty()) {
+    return;
+  }
+  const gfx::Rect strip(
+      0, 0, viewport.width(),
+      std::min(kSampleStripHeight, viewport.height()));
+  constexpr base::TimeDelta kSampleTimeout = base::Milliseconds(500);
+  view->CopyFromSurface(
+      strip, gfx::Size(1, 1), kSampleTimeout,
+      base::BindOnce(&TopContainerView::OnPageTopColorSampled,
+                     weak_factory_.GetWeakPtr(), contents->GetWeakPtr(),
+                     ++EnsurePageTint(contents).sample_generation));
+}
+
+// static
+void TopContainerView::OnPageTopColorSampled(
+    base::WeakPtr<TopContainerView> self,
+    base::WeakPtr<content::WebContents> contents,
+    int generation,
+    const content::CopyFromSurfaceResult& result) {
+  // The tab the sample was taken from may be gone, or may no longer be the one
+  // whose color the band is showing.
+  if (!contents || !result.has_value() ||
+      result.value().bitmap.drawsNothing()) {
+    return;
+  }
+  PageTint& tint = EnsurePageTint(contents.get());
+  // A navigation (or another sample) started after this one was requested.
+  if (generation != tint.sample_generation) {
+    return;
+  }
+  const SkColor sampled =
+      SkColorSetA(result.value().bitmap.getColor(0, 0), SK_AlphaOPAQUE);
+  if (tint.sampled_top == sampled) {
+    return;
+  }
+  tint.sampled_top = sampled;
+  // The result is cached on the tab either way; only the tab that is actually
+  // showing needs a re-layout out of it.
+  if (self && self->web_contents() == contents.get()) {
+    self->browser_view_->InvalidateLayout();
+  }
+}
+
 BEGIN_METADATA(TopContainerView)
 END_METADATA
