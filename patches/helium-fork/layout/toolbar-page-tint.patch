+namespace {
+
+// helium-fork: the band's color is a property of the *page*, so what has been
+// learned about a page is cached on the page rather than on the window.
+//
+// A window-wide cache handed a freshly activated tab whatever the *previous*
+// tab had sampled: readback is asynchronous, the new tab's widget is still
+// hidden at the moment WatchPageColors() runs (BrowserView::OnActiveTabChanged
+// swaps the contents into the WebView a hundred lines further down), so
+// SamplePageTopColor() bailed out and left the old value in place. The band
+// then showed a color that was not merely stale, it belonged to another page.
+// Keeping it here also means the value survives a tab being dragged into
+// another window.
+struct PageTint : public base::SupportsUserData::Data {
+  std::optional<SkColor> sampled_top;
+  // Readback is asynchronous; a sample requested before a navigation must not
+  // be allowed to paint the new page with the old page's color.
+  int sample_generation = 0;
+};
+
+constexpr char kPageTintUserDataKey[] = "helium-fork-arc-page-tint";
+
+PageTint* FindPageTint(content::WebContents* contents) {
+  return contents ? static_cast<PageTint*>(
+                        contents->GetUserData(kPageTintUserDataKey))
+                  : nullptr;
+}
+
+PageTint& EnsurePageTint(content::WebContents* contents) {
+  PageTint* tint = FindPageTint(contents);
+  if (!tint) {
+    auto owned = std::make_unique<PageTint>();
+    tint = owned.get();
+    contents->SetUserData(kPageTintUserDataKey, std::move(owned));
+  }
+  return *tint;
+}
+
+content::RenderWidgetHost* WidgetFor(content::WebContents* contents) {
+  content::RenderWidgetHostView* const view =
+      contents ? contents->GetRenderWidgetHostView() : nullptr;
+  return view ? view->GetRenderWidgetHost() : nullptr;
+}
