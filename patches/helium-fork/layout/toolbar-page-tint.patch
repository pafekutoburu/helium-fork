+
+void TopContainerView::WatchPageColors(content::WebContents* contents) {
+  // helium-fork: called on every active tab change. A page can change its
+  // theme color at any time (dark-mode toggles, per-route colors), and the
+  // band paints in that color, so the change has to reach layout.
+  if (web_contents() == contents) {
+    return;
+  }
+  Observe(contents);
+  // A tab being switched to is already on screen, painted, whatever its
+  // navigation is doing; the gate is about the *current* document's pixels, so
+  // it has to be re-read from the contents rather than carried over.
+  page_paint_timer_.Stop();
+  page_painted_ = !contents || contents->CompletedFirstVisuallyNonEmptyPaint();
+  awaiting_first_frame_ = !page_painted_;
+  SyncFrameMetadataObservation();
+  // The tint the new tab already resolved is cached on the tab itself, so this
+  // publishes it in the same layout pass that swaps the contents in -- no
+  // readback round trip, and nothing of the previous tab's color survives the
+  // switch.
+  OnPageColorMaybeChanged();
+}
+
+void TopContainerView::DidChangeThemeColor() {
