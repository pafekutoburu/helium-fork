+void LocationBarView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& p,
+    ui::mojom::MenuSourceType source_type) {
+  // helium-fork: `p` is in screen coordinates. Blank field = titlebar, so the
+  // window's own controller (BrowserWidget -- the system/layout menu) takes
+  // it; it re-checks NonClientHitTest itself, which resolves to HTCAPTION
+  // through the same delegation chain. Content keeps the omnibox menu.
+  gfx::Point local(p);
+  views::View::ConvertPointFromScreen(this, &local);
+  if (IsPositionInWindowCaption(local)) {
+    if (views::Widget* widget = GetWidget()) {
+      if (views::ContextMenuController* controller =
+              widget->non_client_view()->context_menu_controller()) {
+        controller->ShowContextMenuForView(widget->non_client_view(), p,
+                                           source_type);
+      }
+    }
+    return;
+  }
+  if (views::ContextMenuController* controller =
+          omnibox_view_ ? omnibox_view_->context_menu_controller() : nullptr) {
+    controller->ShowContextMenuForView(source, p, source_type);
+  }
+}
+
+bool LocationBarView::IsPositionInWindowCaption(const gfx::Point& point) const {
+  // helium-fork: outside the Arc band's minimal treatment the whole field is
+  // content, upstream behavior.
+  if (!ShouldMinimizeArcChrome()) {
+    return false;
+  }
+  // Anything that is a real, event-taking child under the point is content;
+  // the rest of the field is Dia's window-drag blank. The focus ring (a
+  // full-bleed, event-transparent child) must not veto -- hence the
+  // CanProcessEventsWithinSubtree filter.
+  for (views::View* const child : children()) {
+    if (!child->GetVisible() || !child->GetCanProcessEventsWithinSubtree()) {
+      continue;
+    }
+    gfx::Point point_in_child(point);
+    ConvertPointToTarget(this, child, &point_in_child);
+    if (child->HitTestPoint(point_in_child)) {
+      return false;
+    }
+  }
+  return true;
+}
