 bool LocationBarView::OnMousePressed(const ui::MouseEvent& event) {
+  // helium-fork: presses on the minimal field's blank are the window's
+  // business (drag / caption), never the omnibox's -- forwarding them focused
+  // the field from a right-click on empty band. Left presses never even get
+  // here (the caption hit test hands them to AppKit before Views sees them);
+  // right presses do: NativeWidgetMacNSWindow::sendEvent forwards them into
+  // Views "to potentially bring up a frame context menu", and that forwarded
+  // event reaches this view with UNRELIABLE coordinates (observed (0,0)), so
+  // the classification reads the real cursor position instead.
+  gfx::Point local(display::Screen::Get()->GetCursorScreenPoint());
+  views::View::ConvertPointFromScreen(this, &local);
+  if (IsPositionInWindowCaption(local)) {
+    arc_press_forwarded_to_omnibox_ = false;
+    if (event.IsOnlyRightMouseButton()) {
+      // The blank is titlebar: hand the click to the window's own controller
+      // (BrowserWidget -- the system/layout menu). It re-checks
+      // NonClientHitTest at the point itself, which resolves to HTCAPTION
+      // through the same delegation chain.
+      gfx::Point screen_point =
+          display::Screen::Get()->GetCursorScreenPoint();
+      if (views::Widget* widget = GetWidget()) {
+        if (views::ContextMenuController* controller =
+                widget->non_client_view()->context_menu_controller()) {
+          controller->ShowContextMenuForView(widget->non_client_view(),
+                                             screen_point,
+                                             ui::mojom::MenuSourceType::kMouse);
+        }
+      }
+      return true;
+    }
+    return false;
+  }
+  arc_press_forwarded_to_omnibox_ = true;
   return omnibox_view_->OnMousePressed(
       AdjustMouseEventLocationForOmniboxView(event));
 }
 
 bool LocationBarView::OnMouseDragged(const ui::MouseEvent& event) {
+  // helium-fork: paired with the press -- an unforwarded press must not grow
+  // a forwarded drag (the omnibox would see a drag with no press).
+  if (!arc_press_forwarded_to_omnibox_) {
+    return false;
+  }
   return omnibox_view_->OnMouseDragged(
       AdjustMouseEventLocationForOmniboxView(event));
 }
 
 void LocationBarView::OnMouseReleased(const ui::MouseEvent& event) {
+  // helium-fork: paired with the press. The unconditional forward here is
+  // what leaked the omnibox context menu onto the blank -- Textfield shows
+  // its menu from OnMouseReleased, not from the press.
+  if (!arc_press_forwarded_to_omnibox_) {
+    return;
+  }
   omnibox_view_->OnMouseReleased(AdjustMouseEventLocationForOmniboxView(event));
 }
 
