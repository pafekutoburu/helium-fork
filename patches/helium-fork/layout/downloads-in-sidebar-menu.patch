+// helium-fork M6: the downloads button has moved out of the toolbar into the
+// sidebar's bottom "⌄" menu (user ruling 2026-09-02 -- in the hidden
+// address bar mode it was squeezed in among the extension icons, and both
+// modes now keep it in one place). Show()/Hide() light a dot on the "⌄"
+// instead of popping the toolbar button, the bubble anchors to the "⌄", and
+// everything behind them -- the bubble controller, the display controller's
+// progress state machine, the action item -- runs unchanged. A window with
+// no sidebar (an app or popup window) keeps the toolbar button.
+VerticalTabStripRegionView* DownloadToolbarUIController::SidebarRegion() const {
+  return browser_view_ ? browser_view_->vertical_tab_strip_region_view()
+                       : nullptr;
+}
+
+views::View* DownloadToolbarUIController::SidebarAnchor() const {
+  VerticalTabStripRegionView* const region = SidebarRegion();
+  return region ? region->SidebarMenuAnchor() : nullptr;
+}
