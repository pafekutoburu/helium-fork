@@ -0,0 +1,74 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_ARC_LOADING_BAR_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_ARC_LOADING_BAR_VIEW_H_
+
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/helium/arc_loading_bar.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+// helium-fork: the shell's own page-loading indicator -- a thin line pinned to
+// the contents' top edge, i.e. right under the band while the band is docked
+// and along the card's top when it is not, so one anchor covers both layouts.
+//
+// It follows the active tab the way the band's tint does (rebound from
+// BrowserView::OnActiveTabChanged), shows real load progress for
+// cross-document navigations, and a fixed sweep for same-document ones; the
+// timing lives in helium::ArcLoadingBarModel where the unit tests can reach
+// it.
+//
+// A BrowserView child rather than anything inside the contents hierarchy:
+// ContentsLayoutManager's header forbids new members (split view will multiply
+// them per pane), and the band clips its own contents so nothing inside it can
+// draw below the band's bottom edge. Like ArcOmniboxPanelView it is placed
+// from the tail of BrowserView::Layout(), not by the layout impl -- the
+// contents container's settled bounds are the anchor, and mid-pass ancestors
+// still hold their old ones.
+class ArcLoadingBarView : public views::View,
+                          public content::WebContentsObserver {
+  METADATA_HEADER(ArcLoadingBarView, views::View)
+
+ public:
+  ArcLoadingBarView();
+  ArcLoadingBarView(const ArcLoadingBarView&) = delete;
+  ArcLoadingBarView& operator=(const ArcLoadingBarView&) = delete;
+  ~ArcLoadingBarView() override;
+
+  // Follows the window's active tab; the bar snaps to the new tab's current
+  // loading state. Null detaches (window teardown).
+  void WatchTab(content::WebContents* contents);
+
+  // Called from the tail of BrowserView::Layout() with the settled contents
+  // bounds in BrowserView coordinates and the contents' top corner radius
+  // (zero while the band owns the card's top).
+  void UpdatePlacement(const gfx::Rect& contents_bounds,
+                       int contents_top_corner_radius);
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+
+  // content::WebContentsObserver:
+  void DidStartNavigation(content::NavigationHandle* handle) override;
+  void LoadProgressChanged(double progress) override;
+  void DidStopLoading() override;
+  void WebContentsDestroyed() override;
+
+ private:
+  // Applies the model's current output to visibility, layer opacity and
+  // paint, and keeps the tick timer running exactly while the model animates.
+  void SyncFromModel();
+
+  helium::ArcLoadingBarModel model_;
+
+  // ~60Hz, running only while the model reports NeedsTicks(). Every input
+  // event re-arms it through SyncFromModel().
+  base::RepeatingTimer tick_timer_;
+
+  double painted_fraction_ = -1.0;
+};
