--- /dev/null
+++ src/chrome/browser/ui/views/frame/arc_loading_bar_view.cc
@@ -0,0 +1,140 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/arc_loading_bar_view.h"
+
+#include "base/numerics/safe_conversions.h"
+#include "chrome/browser/ui/helium_workspace/workspace_blank_tab.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/canvas.h"
+
+namespace {
+
+// The browser's own blank pages must not flash the bar: every new tab starts
+// with a navigation to the new tab page, and a load indicator on "nothing is
+// loading" reads as noise. Same literals as the close-window predicate
+// (workspace_blank_tab.h) so an upstream rename fails one build, not two ways.
+bool IsBrowserBlankUrl(const GURL& url) {
+  if (url.IsAboutBlank()) {
+    return true;
+  }
+  return url.SchemeIs(helium_workspace::kNewTabScheme) &&
+         (url.host() == helium_workspace::kNewTabHost ||
+          url.host() == helium_workspace::kNewTabPageHost);
+}
+
+}  // namespace
+
+ArcLoadingBarView::ArcLoadingBarView() {
+  // Same footing as ArcOmniboxPanelView: invisible to input, and its own layer
+  // -- the contents WebView is layer-backed, so a view painting into the
+  // shared parent layer would composite *below* the page whatever the child
+  // order says.
+  SetCanProcessEventsWithinSubtree(false);
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  SetVisible(false);
+}
+
+ArcLoadingBarView::~ArcLoadingBarView() = default;
+
+void ArcLoadingBarView::WatchTab(content::WebContents* contents) {
+  Observe(contents);
+  if (contents) {
+    // The blank-URL filter applies here too: the window's very first
+    // navigation starts before this observer attaches, so a fresh tab's NTP
+    // load arrives through this snapshot, not through DidStartNavigation.
+    const bool loading = contents->IsLoading() &&
+                         !IsBrowserBlankUrl(contents->GetVisibleURL());
+    model_.TabSwitched(loading, contents->GetLoadProgress(),
+                       base::TimeTicks::Now());
+  } else {
+    model_.Hide();
+  }
+  SyncFromModel();
+}
+
+void ArcLoadingBarView::UpdatePlacement(const gfx::Rect& contents_bounds,
+                                        int contents_top_corner_radius) {
+  const gfx::Rect bar = helium::ComputeLoadingBarBounds(
+      contents_bounds, contents_top_corner_radius);
+  if (bar != bounds()) {
+    SetBoundsRect(bar);
+  }
+}
+
+void ArcLoadingBarView::OnPaint(gfx::Canvas* canvas) {
+  const int fill = base::ClampRound(painted_fraction_ * width());
+  if (fill <= 0) {
+    return;
+  }
+  canvas->FillRect(GetMirroredRect(gfx::Rect(0, 0, fill, height())),
+                   GetColorProvider()->GetColor(ui::kColorThrobber));
+}
+
+void ArcLoadingBarView::DidStartNavigation(content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame()) {
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (IsBrowserBlankUrl(handle->GetURL())) {
+    // Navigating to the browser's own blank page: nothing worth indicating,
+    // and any bar still animating for the previous page is stale.
+    model_.Hide();
+  } else if (handle->IsSameDocument()) {
+    model_.SameDocumentNavigation(now);
+  } else {
+    model_.NavigationStarted(now);
+  }
+  SyncFromModel();
+}
+
+void ArcLoadingBarView::LoadProgressChanged(double progress) {
+  model_.ProgressChanged(progress, base::TimeTicks::Now());
+  SyncFromModel();
+}
+
+void ArcLoadingBarView::DidStopLoading() {
+  model_.LoadingStopped(base::TimeTicks::Now());
+  SyncFromModel();
+}
+
+void ArcLoadingBarView::WebContentsDestroyed() {
+  Observe(nullptr);
+  model_.Hide();
+  SyncFromModel();
+}
+
+void ArcLoadingBarView::SyncFromModel() {
+  const helium::ArcLoadingBarModel::PaintState paint =
+      model_.Tick(base::TimeTicks::Now());
+
+  if (paint.visible != GetVisible()) {
+    SetVisible(paint.visible);
+  }
+  // The fade is layer opacity, not paint: the compositor animates it without
+  // re-rasterizing the strip.
+  layer()->SetOpacity(paint.visible ? paint.opacity : 1.0f);
+  if (paint.visible && paint.fraction != painted_fraction_) {
+    painted_fraction_ = paint.fraction;
+    SchedulePaint();
+  }
+
+  if (model_.NeedsTicks()) {
+    if (!tick_timer_.IsRunning()) {
+      tick_timer_.Start(FROM_HERE, base::Hertz(60), this,
+                        &ArcLoadingBarView::SyncFromModel);
+    }
+  } else {
+    tick_timer_.Stop();
+  }
+}
+
+BEGIN_METADATA(ArcLoadingBarView)
+END_METADATA
