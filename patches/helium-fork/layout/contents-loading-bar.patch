===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_loading_bar.h
@@ -0,0 +1,224 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_LOADING_BAR_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_LOADING_BAR_H_
+
+#include <algorithm>
+#include <cmath>
+
+#include "base/notreached.h"
+#include "base/time/time.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/rect.h"
+
+// helium-fork: the loading bar's state machine and geometry, kept free of
+// //ui/views and //content so they can be asserted in helium_workspace_
+// unittests (see arc_card_layout.h on why anything reaching TestingProfile
+// cannot be built in this tree).
+//
+// The bar is the shell's own load indicator, not a copy of anything the
+// reference browsers draw: stock Helium's only system-level signal is the tab
+// throbber, and the thin line users see at the top of some pages is drawn by
+// the page itself. The ask (2026-08-18) is to make that line system-level:
+// every navigation shows it, sites that never drew one included.
+//
+// Progress display is a ratchet: WebContents load progress can go backwards
+// (a new subframe arriving shrinks the done fraction), but a bar that retreats
+// reads as the page unloading. The displayed fraction only ever grows, easing
+// toward the largest progress reported so far.
+namespace helium {
+
+// The bar's height. The reference line in the user's screenshot is ~2pt.
+inline constexpr int kLoadingBarThickness = 2;
+
+// Where the bar starts on a fresh navigation, so a click gives instant
+// feedback even before the first LoadProgressChanged (which reports ~0.1 at
+// the earliest).
+inline constexpr double kLoadingBarInitialFraction = 0.05;
+
+// Easing time constant while following real load progress: per tick the
+// displayed fraction closes 1 - exp(-dt/tau) of its distance to the target.
+inline constexpr base::TimeDelta kLoadingBarRampTau = base::Milliseconds(150);
+
+// A finished load fills the remainder in one quick sweep, then fades.
+inline constexpr base::TimeDelta kLoadingBarFinishDuration =
+    base::Milliseconds(150);
+inline constexpr base::TimeDelta kLoadingBarFadeDuration =
+    base::Milliseconds(200);
+
+// A same-document navigation has no load progress to report, but "every click
+// shows the bar" is the point of the feature -- SPA route changes are exactly
+// where the user first saw a page draw its own line. So it gets a fixed sweep
+// to full, then the same fade.
+inline constexpr base::TimeDelta kLoadingBarFlashSweepDuration =
+    base::Milliseconds(250);
+
+// The bar spans the contents' top edge. While the band owns the card's top the
+// contents' corners are square and the bar can run edge to edge; without the
+// band (kHidden, and any future band-less state) the card's rounded top
+// corners are the contents' own, and a full-width bar would poke past their
+// arcs -- so it retreats by the radius on each side. Never round the bar's own
+// layer instead: a non-uniform rounded-corner quad anywhere in the frame
+// forfeits the CoreAnimation compositing path for the whole frame
+// (ca_layer_overlay.cc, kCALayerFailedQuadRoundedCornerNotUniform).
+inline gfx::Rect ComputeLoadingBarBounds(const gfx::Rect& contents_bounds,
+                                         int contents_top_corner_radius) {
+  const int inset = std::max(0, contents_top_corner_radius);
+  gfx::Rect bar = contents_bounds;
+  bar.Inset(gfx::Insets::TLBR(0, inset, 0, inset));
+  bar.set_height(std::min(kLoadingBarThickness, contents_bounds.height()));
+  return bar;
+}
+
+class ArcLoadingBarModel {
+ public:
+  struct PaintState {
+    bool visible = false;
+    double fraction = 0.0;
+    double opacity = 1.0;
+  };
+
+  // A cross-document navigation started in the watched tab. Restarts the bar
+  // even mid-animation: the newest navigation owns it.
+  void NavigationStarted(base::TimeTicks now) {
+    state_ = State::kLoading;
+    displayed_ = 0.0;
+    target_ = kLoadingBarInitialFraction;
+    last_tick_ = now;
+  }
+
+  // A same-document navigation. A real load in flight keeps its real progress
+  // -- a flash would reset a bar that is telling the truth.
+  void SameDocumentNavigation(base::TimeTicks now) {
+    if (state_ == State::kLoading) {
+      return;
+    }
+    state_ = State::kFlashing;
+    phase_start_ = now;
+    displayed_ = 0.0;
+    last_tick_ = now;
+  }
+
+  void ProgressChanged(double progress, base::TimeTicks now) {
+    if (state_ != State::kLoading) {
+      return;
+    }
+    target_ = std::max(target_, std::clamp(progress, 0.0, 1.0));
+    last_tick_ = now;
+  }
+
+  void LoadingStopped(base::TimeTicks now) {
+    if (state_ != State::kLoading) {
+      return;
+    }
+    state_ = State::kFinishing;
+    phase_start_ = now;
+    finish_from_ = displayed_;
+  }
+
+  // The watched tab changed. No animation: the bar snaps to the new tab's
+  // truth, exactly like the band's tint does.
+  void TabSwitched(bool is_loading, double progress, base::TimeTicks now) {
+    if (!is_loading) {
+      Hide();
+      return;
+    }
+    state_ = State::kLoading;
+    displayed_ = target_ =
+        std::max(kLoadingBarInitialFraction, std::clamp(progress, 0.0, 1.0));
+    last_tick_ = now;
+  }
+
+  void Hide() { state_ = State::kIdle; }
+
+  // Whether Tick() would change anything -- the view runs its timer only while
+  // this is true, and re-arms it on the next input.
+  bool NeedsTicks() const {
+    switch (state_) {
+      case State::kIdle:
+        return false;
+      case State::kLoading:
+        return target_ - displayed_ > kDoneEpsilon;
+      case State::kFinishing:
+      case State::kFlashing:
+      case State::kFading:
+        return true;
+    }
+    NOTREACHED();
+  }
+
+  PaintState Tick(base::TimeTicks now) {
+    switch (state_) {
+      case State::kIdle:
+        break;
+      case State::kLoading: {
+        const base::TimeDelta dt = now - last_tick_;
+        const double closing =
+            1.0 - std::exp(-dt / kLoadingBarRampTau);
+        displayed_ += (target_ - displayed_) * closing;
+        last_tick_ = now;
+        break;
+      }
+      case State::kFinishing: {
+        const double t = Phase(now, kLoadingBarFinishDuration);
+        displayed_ = finish_from_ + (1.0 - finish_from_) * t;
+        if (t >= 1.0) {
+          StartFade(now);
+        }
+        break;
+      }
+      case State::kFlashing: {
+        displayed_ = Phase(now, kLoadingBarFlashSweepDuration);
+        if (displayed_ >= 1.0) {
+          StartFade(now);
+        }
+        break;
+      }
+      case State::kFading:
+        break;
+    }
+
+    PaintState paint;
+    paint.visible = state_ != State::kIdle;
+    paint.fraction = std::clamp(displayed_, 0.0, 1.0);
+    if (state_ == State::kFading) {
+      const double t = Phase(now, kLoadingBarFadeDuration);
+      paint.fraction = 1.0;
+      paint.opacity = 1.0 - t;
+      if (t >= 1.0) {
+        state_ = State::kIdle;
+        paint.visible = false;
+      }
+    }
+    return paint;
+  }
+
+ private:
+  enum class State { kIdle, kLoading, kFinishing, kFlashing, kFading };
+
+  static constexpr double kDoneEpsilon = 1e-3;
+
+  // 0..1 of the current phase's duration.
+  double Phase(base::TimeTicks now, base::TimeDelta duration) const {
+    return std::clamp((now - phase_start_) / duration, 0.0, 1.0);
+  }
+
+  void StartFade(base::TimeTicks now) {
+    state_ = State::kFading;
+    phase_start_ = now;
+    displayed_ = 1.0;
+  }
+
+  State state_ = State::kIdle;
+  double displayed_ = 0.0;
+  double target_ = 0.0;
+  double finish_from_ = 0.0;
+  base::TimeTicks phase_start_;
+  base::TimeTicks last_tick_;
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_LOADING_BAR_H_
Index: src/chrome/browser/ui/helium/arc_loading_bar_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_loading_bar_unittest.cc
@@ -0,0 +1,177 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_loading_bar.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace helium {
+namespace {
+
+#define EXPECT_RECT_EQ(a, b) EXPECT_EQ((a).ToString(), (b).ToString())
+
+// Absolute times mean nothing to the model; only the deltas do.
+constexpr base::TimeTicks kT0 = base::TimeTicks() + base::Seconds(100);
+
+using PaintState = ArcLoadingBarModel::PaintState;
+
+TEST(ArcLoadingBarModelTest, IdleUntilNavigation) {
+  ArcLoadingBarModel model;
+  EXPECT_FALSE(model.NeedsTicks());
+  EXPECT_FALSE(model.Tick(kT0).visible);
+}
+
+TEST(ArcLoadingBarModelTest, NavigationShowsBarImmediately) {
+  ArcLoadingBarModel model;
+  model.NavigationStarted(kT0);
+  const PaintState paint = model.Tick(kT0);
+  EXPECT_TRUE(paint.visible);
+  EXPECT_EQ(paint.opacity, 1.0);
+  // The head start is the target, not the first frame's fill.
+  EXPECT_LT(paint.fraction, kLoadingBarInitialFraction + 1e-9);
+  EXPECT_TRUE(model.NeedsTicks());
+}
+
+TEST(ArcLoadingBarModelTest, DisplayedFractionConvergesToProgress) {
+  ArcLoadingBarModel model;
+  model.NavigationStarted(kT0);
+  model.ProgressChanged(0.6, kT0);
+  // 1.5s is ten ramp taus: the ease has effectively arrived.
+  const PaintState paint = model.Tick(kT0 + base::Seconds(1.5));
+  EXPECT_NEAR(paint.fraction, 0.6, 1e-3);
+  EXPECT_FALSE(model.NeedsTicks());
+}
+
+TEST(ArcLoadingBarModelTest, ProgressIsARatchet) {
+  ArcLoadingBarModel model;
+  model.NavigationStarted(kT0);
+  model.ProgressChanged(0.6, kT0);
+  model.Tick(kT0 + base::Seconds(1.5));
+  // A regressing report must not pull the bar backwards.
+  model.ProgressChanged(0.3, kT0 + base::Seconds(1.5));
+  const PaintState paint = model.Tick(kT0 + base::Seconds(3));
+  EXPECT_NEAR(paint.fraction, 0.6, 1e-3);
+}
+
+TEST(ArcLoadingBarModelTest, StopFillsThenFadesOut) {
+  ArcLoadingBarModel model;
+  model.NavigationStarted(kT0);
+  model.ProgressChanged(0.5, kT0);
+  model.Tick(kT0 + base::Seconds(1.5));
+  model.LoadingStopped(kT0 + base::Seconds(2));
+
+  // Mid-finish: past the old progress, not yet full.
+  const PaintState mid =
+      model.Tick(kT0 + base::Seconds(2) + kLoadingBarFinishDuration / 2);
+  EXPECT_TRUE(mid.visible);
+  EXPECT_GT(mid.fraction, 0.5);
+  EXPECT_LT(mid.fraction, 1.0);
+
+  // Finished: full, starting to fade.
+  const PaintState full =
+      model.Tick(kT0 + base::Seconds(2) + kLoadingBarFinishDuration);
+  EXPECT_TRUE(full.visible);
+  EXPECT_EQ(full.fraction, 1.0);
+
+  // Mid-fade: still full, translucent.
+  const PaintState fading =
+      model.Tick(kT0 + base::Seconds(2) + kLoadingBarFinishDuration +
+                 kLoadingBarFadeDuration / 2);
+  EXPECT_TRUE(fading.visible);
+  EXPECT_EQ(fading.fraction, 1.0);
+  EXPECT_LT(fading.opacity, 1.0);
+
+  // Fade over: gone.
+  const PaintState done =
+      model.Tick(kT0 + base::Seconds(2) + kLoadingBarFinishDuration +
+                 kLoadingBarFadeDuration);
+  EXPECT_FALSE(done.visible);
+  EXPECT_FALSE(model.NeedsTicks());
+}
+
+TEST(ArcLoadingBarModelTest, SameDocumentNavigationFlashes) {
+  ArcLoadingBarModel model;
+  model.SameDocumentNavigation(kT0);
+
+  const PaintState mid = model.Tick(kT0 + kLoadingBarFlashSweepDuration / 2);
+  EXPECT_TRUE(mid.visible);
+  EXPECT_NEAR(mid.fraction, 0.5, 1e-3);
+
+  model.Tick(kT0 + kLoadingBarFlashSweepDuration);
+  const PaintState done = model.Tick(kT0 + kLoadingBarFlashSweepDuration +
+                                     kLoadingBarFadeDuration);
+  EXPECT_FALSE(done.visible);
+}
+
+TEST(ArcLoadingBarModelTest, SameDocumentDoesNotInterruptARealLoad) {
+  ArcLoadingBarModel model;
+  model.NavigationStarted(kT0);
+  model.ProgressChanged(0.4, kT0);
+  model.Tick(kT0 + base::Seconds(1.5));
+  model.SameDocumentNavigation(kT0 + base::Seconds(1.5));
+  // Still the real load's progress, not a flash restarted from zero.
+  const PaintState paint = model.Tick(kT0 + base::Seconds(1.6));
+  EXPECT_NEAR(paint.fraction, 0.4, 1e-2);
+  // And the real load still finishes normally.
+  model.LoadingStopped(kT0 + base::Seconds(2));
+  EXPECT_TRUE(model.NeedsTicks());
+}
+
+TEST(ArcLoadingBarModelTest, NewNavigationRestartsMidAnimation) {
+  ArcLoadingBarModel model;
+  model.NavigationStarted(kT0);
+  model.LoadingStopped(kT0 + base::Seconds(1));
+  model.Tick(kT0 + base::Seconds(1) + kLoadingBarFinishDuration);
+  // Mid-fade, a new navigation begins: the bar restarts from the left.
+  model.NavigationStarted(kT0 + base::Seconds(1.2));
+  const PaintState paint = model.Tick(kT0 + base::Seconds(1.2));
+  EXPECT_TRUE(paint.visible);
+  EXPECT_EQ(paint.opacity, 1.0);
+  EXPECT_LT(paint.fraction, kLoadingBarInitialFraction + 1e-9);
+}
+
+TEST(ArcLoadingBarModelTest, TabSwitchSnapsWithoutAnimation) {
+  ArcLoadingBarModel model;
+  model.TabSwitched(/*is_loading=*/true, /*progress=*/0.42, kT0);
+  const PaintState loading = model.Tick(kT0);
+  EXPECT_TRUE(loading.visible);
+  EXPECT_NEAR(loading.fraction, 0.42, 1e-9);
+
+  model.TabSwitched(/*is_loading=*/false, /*progress=*/0.0, kT0);
+  EXPECT_FALSE(model.Tick(kT0).visible);
+  EXPECT_FALSE(model.NeedsTicks());
+}
+
+TEST(ArcLoadingBarModelTest, HideIsImmediate) {
+  ArcLoadingBarModel model;
+  model.NavigationStarted(kT0);
+  model.Hide();
+  EXPECT_FALSE(model.Tick(kT0).visible);
+  EXPECT_FALSE(model.NeedsTicks());
+}
+
+TEST(ArcLoadingBarBoundsTest, SpansContentsTopEdgeUnderTheBand) {
+  // Docked band above: square contents corners, edge-to-edge bar.
+  const gfx::Rect contents(203, 37, 1074, 760);
+  EXPECT_RECT_EQ(ComputeLoadingBarBounds(contents, 0),
+                 gfx::Rect(203, 37, 1074, kLoadingBarThickness));
+}
+
+TEST(ArcLoadingBarBoundsTest, RetreatsFromRoundedTopCorners) {
+  // kHidden: the card's rounded top is the contents' own; the bar retreats by
+  // the radius on each side rather than rounding its own layer (a non-uniform
+  // rounded quad would forfeit the CoreAnimation path for the whole frame).
+  const gfx::Rect contents(3, 3, 1274, 794);
+  EXPECT_RECT_EQ(ComputeLoadingBarBounds(contents, 14),
+                 gfx::Rect(17, 3, 1246, kLoadingBarThickness));
+}
+
+TEST(ArcLoadingBarBoundsTest, NeverTallerThanTheContents) {
+  const gfx::Rect contents(0, 0, 100, 1);
+  EXPECT_EQ(ComputeLoadingBarBounds(contents, 0).height(), 1);
+}
+
+}  // namespace
+}  // namespace helium
