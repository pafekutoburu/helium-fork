   EXPECT_DOUBLE_EQ(1.0, CapFirstStepOrigin(1.0, 1.01));
 }
 
+TEST(ArcSpaceMotionTest, ALateFrameLaterOnTakesOneDisplayFrameToo) {
+  SpringFrameCap cap;
+  // Before any gap: a 120 Hz frame's step and a half.
+  EXPECT_NEAR(1.5 / 120.0, cap.MaxStep(), 1e-12);
+  // A new window's first steps stall: each shows 12.5 ms of the curve, and
+  // a stall is not taken for the frame (reviewer 2026-11-21 r3).
+  EXPECT_DOUBLE_EQ(0.0, cap.Step(10.0));
+  EXPECT_NEAR(0.042 - 1.5 / 120.0, cap.Step(10.042), 1e-12);
+  EXPECT_NEAR(0.040 - 1.5 / 120.0, cap.Step(10.082), 1e-12);
+  EXPECT_NEAR(1.5 / 120.0, cap.MaxStep(), 1e-12);
+  // 120 Hz frames on time keep the spring's clock...
+  cap.Aim();
+  double t = 0.0;
+  EXPECT_DOUBLE_EQ(0.0, cap.Step(t));
+  for (int i = 0; i < 5; ++i) {
+    t += 1.0 / 120.0;
+    EXPECT_DOUBLE_EQ(0.0, cap.Step(t));
+  }
+  EXPECT_NEAR(1.5 / 120.0, cap.MaxStep(), 1e-12);
+  // ...one dropped 120 Hz frame shows 12.5 ms of the curve, 4.2 ms on...
+  t += 1.0 / 60.0;
+  EXPECT_NEAR(1.0 / 60.0 - 1.5 / 120.0, cap.Step(t), 1e-12);
+  // ...a 66.7 ms freeze too: the origin moves on by the rest.
+  t += 4.0 / 60.0;
+  EXPECT_NEAR(4.0 / 60.0 - 1.5 / 120.0, cap.Step(t), 1e-12);
+  // The next aim keeps the frame, and its first gap is capped by it -- a
+  // switch's stall comes right after an aim.
+  cap.Aim();
+  EXPECT_NEAR(1.5 / 120.0, cap.MaxStep(), 1e-12);
+  EXPECT_DOUBLE_EQ(0.0, cap.Step(0.5));
+  EXPECT_NEAR(0.050 - 1.5 / 120.0, cap.Step(0.550), 1e-12);
+  // A window moved to a 60 Hz display: a gap there is 16.7 ms, over 12.5 --
+  // 4.2 ms each until the median of the last 8 gaps moves (at most four
+  // frames), then 60 Hz frames on time keep the clock.
+  cap.Aim();
+  t = 1.0;
+  EXPECT_DOUBLE_EQ(0.0, cap.Step(t));
+  int late = 0;
+  for (int i = 0; i < 4; ++i) {
+    t += 1.0 / 60.0;
+    late += cap.Step(t) > 1e-9;
+  }
+  EXPECT_LE(late, 4);
+  for (int i = 0; i < 10; ++i) {
+    t += 1.0 / 60.0;
+    EXPECT_NEAR(0.0, cap.Step(t), 1e-9);
+  }
+  // ...and a 60 Hz stall shows one 60 Hz frame of the curve, not 1.5.
+  EXPECT_NEAR(kSpaceSpringMaxFirstStep, cap.MaxStep(), 1e-9);
+  t += 0.050;
+  EXPECT_NEAR(0.050 - kSpaceSpringMaxFirstStep, cap.Step(t), 1e-9);
+  // Worst place on each curve, one capped step: the cover's launched spring
+  // at 120 Hz, the swipe's spring at 60 Hz -- at most 20% of the way.
+  double cover = 0.0;
+  double swipe = 0.0;
+  for (double s = 0.0; s < 0.3; s += 0.0005) {
+    const SpringState from = LaunchCriticalSpring({0.0, 0.0}, 1.0, 30.0, 0.4);
+    cover = std::max(cover, StepCriticalSpring(from, 1.0, 30.0, s + 1.5 / 120.0).x -
+                                StepCriticalSpring(from, 1.0, 30.0, s).x);
+    swipe = std::max(
+        swipe, StepCriticalSpring({0.0, 0.0}, 1.0, kSpaceSlideOmega,
+                                  s + kSpaceSpringMaxFirstStep).x -
+                   StepCriticalSpring({0.0, 0.0}, 1.0, kSpaceSlideOmega, s).x);
+  }
+  EXPECT_LT(cover, 0.20);
+  EXPECT_LT(swipe, 0.20);
+}
