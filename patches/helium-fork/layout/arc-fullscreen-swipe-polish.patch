+// helium-fork (2026-11-20, item 3).
+void SendSyntheticMouseExit(views::Widget* widget) {
+  if (views::View* const root = widget->GetRootView()) {
+    const ui::MouseEvent exited(ui::EventType::kMouseExited, gfx::Point(),
+                                gfx::Point(), ui::EventTimeForNow(),
+                                ui::EF_IS_SYNTHESIZED, 0);
+    root->OnMouseExited(exited);
+  }
+}
+
+// Whether the pointer hovers |widget|'s rows at all: the key window does; so
+// does another browser window under the pointer while the app is in front
+// (macOS tracks hover in every window of the active app; reviewer 2026-11-21
+// r3: two windows side by side). Not a window of an app in the background.
+bool PointerCanHover(views::Widget* widget) {
+  if (widget->IsActive()) {
+    return true;
+  }
+  display::Screen* const screen = display::Screen::Get();
+  if (!screen || !screen->IsWindowUnderCursor(widget->GetNativeWindow())) {
+    return false;
+  }
+  BrowserWindowInterface* const last =
+      GlobalBrowserCollection::GetInstance()->GetLastActiveBrowser();
+  return last && last->IsActive();
+}
+
+}  // namespace
+
+void TabStripView::SetListHoverHeld(bool held) {
+  if (list_hover_held_ == held) {
+    return;
+  }
+  list_hover_held_ = held;
+  if (held) {
+    // The row hovered when the lists start to move lets go of its hover
+    // too, whatever kind of row it is (reviewer 2026-11-21 r3: a Today row
+    // kept it and slid with it, a picture of the leaving space caught it,
+    // the "+ New Tab" row kept a hover state that showed up after the move
+    // wherever the row landed). Only with the pointer on the lists: an exit
+    // elsewhere would reach the page.
+    if (views::Widget* const widget = GetWidget();
+        widget && IsDrawn() && IsMouseHovered()) {
+      SendSyntheticMouseExit(widget);
+    }
+    return;
+  }
+  // Not from inside the carousel's step (Stop() runs in an animation
+  // callback and a layout): the move it synthesizes re-enters views.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&TabStripView::ResyncListHover,
+                                hover_weak_factory_.GetWeakPtr()));
+}
+
+void TabStripView::ResyncListHover() {
+  views::Widget* const widget = GetWidget();
+  // Not for a window another one covers, or a strip no longer drawn
+  // (reviewer 2026-11-21 r2: IsMouseHovered() only tests the rectangle).
+  if (!widget || list_hover_held_ || !PointerCanHover(widget) ||
+      !IsDrawn() || !IsMouseHovered()) {
+    return;
+  }
+  // RootView still names the view it last sent an enter to -- maybe a row
+  // that slid away, maybe the row now under the pointer that was kept dark:
+  // a synthesized move alone would reach the latter as a plain move, which
+  // not every row lights a hover on. An exit first, then the move: every
+  // row type takes its hover through its own OnMouseEntered.
+  SendSyntheticMouseExit(widget);
+  widget->SynthesizeMouseMoveEvent();
+}
+
+bool IsSidebarListHoverHeld(const views::View* view) {
+  for (const views::View* v = view; v; v = v->parent()) {
+    if (const auto* strip = views::AsViewClass<TabStripView>(v)) {
+      return strip->list_hover_held();
+    }
+  }
+  return false;
+}
