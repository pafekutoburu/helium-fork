@@ -6,6 +6,7 @@
 #define CHROME_BROWSER_UI_HELIUM_ARC_SPACE_MOTION_H_
 
 #include <algorithm>
+#include <array>
 #include <cmath>
 #include <numbers>
 
@@ -210,10 +211,73 @@
 // The origin (seconds, on the caller's clock) that frame is evaluated
 // against: |origin_seconds|, or one step back from |now_seconds| when the
 // frame came later than that.
-inline double CapFirstStepOrigin(double origin_seconds, double now_seconds) {
-  return std::max(origin_seconds, now_seconds - kSpaceSpringMaxFirstStep);
+inline double CapFirstStepOrigin(double origin_seconds,
+                                 double now_seconds,
+                                 double max_step = kSpaceSpringMaxFirstStep) {
+  return std::max(origin_seconds, now_seconds - max_step);
 }
 
+// ⛔ helium-fork (2026-11-20, the user: 「横滑……冻住 50–75 ms 没有新画面，接着一帧跳过
+// 42–55% 的行程」; 「手感不要动……是过程中掉帧」): every frame of a spring, not only the
+// first after an aim, shows at most one display frame's step of the curve: a frame
+// that comes late (a stall on the main thread) shows that step on from where the
+// motion was shown, and the motion ends that much later. The user's swipes fit a
+// spring that had run 55-72 ms at the first frame after the freeze -- the first-step
+// cap (CapFirstStepOrigin) had been spent on a frame before it. The step is the
+// display's own: 1.5 x the median of the last 8 gaps between steps that came on
+// time (a gap over 25 ms is a stall, not a frame; before any, a 120 Hz frame), and
+// never more than a 60 Hz frame's -- 12.5 ms at 120 Hz, 16.7 ms at 60 Hz -- so
+// frames on time are untouched (the curve is the same) and a stall shows at most
+// that much of it (120 Hz: the Cmd+S / reveal cover, launched, 16%; 60 Hz: the
+// swipe 19% -- reviewer 2026-11-21: 1/60 s for the cover was 21%, r3: 1.5 x 1/60 s
+// for the swipe 28%). ⚠ Ours.
+struct SpringFrameCap {
+  // A new aim: the step clock starts over; the frame measured so far stays
+  // (it is the display's).
+  void Aim() { last = -1.0; }
+  // The display's frame: the median of the last kGaps gaps between steps
+  // that came on time (a window moved to another display is followed within
+  // a few frames); a 120 Hz frame before any.
+  double Frame() const {
+    if (count == 0) {
+      return 1.0 / 120.0;
+    }
+    std::array<double, kGaps> sorted = gaps;
+    std::sort(sorted.begin(), sorted.begin() + count);
+    return count % 2 ? sorted[count / 2]
+                     : (sorted[count / 2 - 1] + sorted[count / 2]) / 2.0;
+  }
+  double MaxStep() const {
+    return std::min(1.5 * Frame(), kSpaceSpringMaxFirstStep);
+  }
+  // The step at |now| (seconds, the spring's clock): how far to move the
+  // spring's origin forward so that it shows at most MaxStep() of the curve.
+  double Step(double now) {
+    double stall = 0.0;
+    if (last >= 0.0 && now >= last) {
+      const double gap = now - last;
+      // Capped by the frame known so far: the first gap after an aim is the
+      // stall a switch makes.
+      stall = std::max(0.0, gap - MaxStep());
+      // Not two steps in one frame, and not a stall: neither is a frame.
+      if (gap >= 1.0 / 480.0 && gap <= kLongestFrame) {
+        gaps[next] = gap;
+        next = (next + 1) % kGaps;
+        count = std::min(count + 1, kGaps);
+      }
+    }
+    last = now;
+    return stall;
+  }
+
+  static constexpr int kGaps = 8;
+  static constexpr double kLongestFrame = 1.0 / 40.0;
+  double last = -1.0;
+  std::array<double, kGaps> gaps{};
+  int next = 0;
+  int count = 0;
+};
