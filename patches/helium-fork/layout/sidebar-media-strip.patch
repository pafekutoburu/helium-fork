+void HeliumMediaStripExpandedView::AnimationProgressed(
+    const gfx::Animation* animation) {
+  UpdatePanelBounds();
+}
+
+void HeliumMediaStripExpandedView::AnimationEnded(
+    const gfx::Animation* animation) {
+  UpdatePanelBounds();
+  if (animation->GetCurrentValue() == 0.0) {
+    SetVisible(false);
+  }
+}
