+namespace {
+
+// One glyph button of the strip. No hover backplate: Arc's strip icons are
+// bare glyphs whose color carries the enabled state.
+std::unique_ptr<views::ImageButton> MakeStripButton(
+    base::RepeatingClosure pressed) {
+  auto button = std::make_unique<views::ImageButton>(
+      base::BindRepeating([](base::RepeatingClosure cb) { cb.Run(); },
+                          std::move(pressed)));
+  button->SetImageHorizontalAlignment(views::ImageButton::ALIGN_CENTER);
+  button->SetImageVerticalAlignment(views::ImageButton::ALIGN_MIDDLE);
+  return button;
+}
+
+// Resolves a per-capsule action id at *press* time: bound id if that row is
+// still alive, else the controller's primary row -- so a rebind between
+// press-down and press-up never fires at the wrong tab.
+std::string ResolveItemId(HeliumMediaStripController* controller,
+                          const std::string& bound_item_id) {
+  if (!bound_item_id.empty()) {
+    for (const HeliumMediaStripModel* row : controller->rows()) {
+      if (row->item_id == bound_item_id) {
+        return bound_item_id;
+      }
+    }
+  }
+  return controller->model().item_id;
+}
+
+const HeliumMediaStripModel& ResolveRow(
+    HeliumMediaStripController* controller,
+    const std::string& bound_item_id) {
+  if (!bound_item_id.empty()) {
+    for (const HeliumMediaStripModel* row : controller->rows()) {
+      if (row->item_id == bound_item_id) {
+        return *row;
+      }
+    }
+  }
+  return controller->model();
+}
+
+void CenterViewAt(views::View* view, int center_x, int center_y, int size) {
+  view->SetBounds(center_x - size / 2, center_y - size / 2, size, size);
+}
+
+void SetGlyph(views::ImageButton* button,
+              const gfx::VectorIcon& icon,
+              SkColor color,
+              int size) {
+  button->SetImageModel(views::Button::STATE_NORMAL,
+                        ui::ImageModel::FromVectorIcon(icon, color, size));
+  // Disabled state shares the image; the color already encodes it.
+  button->SetImageModel(views::Button::STATE_DISABLED,
+                        ui::ImageModel::FromVectorIcon(icon, color, size));
+}
+
+void PaintStripSurface(gfx::Canvas* canvas,
+                       const gfx::Rect& bounds,
+                       SkColor surface) {
+  cc::PaintFlags fill;
+  fill.setStyle(cc::PaintFlags::kFill_Style);
+  fill.setAntiAlias(true);
+  fill.setColor(surface);
+  canvas->DrawRoundRect(gfx::RectF(bounds), helium::kMediaStripCornerRadius,
+                        fill);
+  // Borderless by design: the card's elevation is carried entirely by its
+  // shadow (Dia-measured 2026-08-20), painted by a sibling HeliumCardShadowView
+  // -- this view's own paint is clipped to its bounds.
+}
+
+// The five control slots shared by the pill and the panel's bottom row.
+struct StripControls {
+  views::ImageButton* favicon;
+  views::ImageButton* previous;
+  views::ImageButton* play_pause;
+  views::ImageButton* next;
+  views::ImageButton* mute;
+};
+
+void LayoutStripControls(const StripControls& controls,
+                         int width,
+                         int center_y) {
+  views::View* const slots[5] = {controls.favicon, controls.previous,
+                                 controls.play_pause, controls.next,
+                                 controls.mute};
+  for (int i = 0; i < 5; ++i) {
+    // Buttons get a hit target comfortably larger than the glyph.
+    CenterViewAt(slots[i], helium::MediaStripSlotCenter(width, i), center_y,
+                 helium::kMediaStripRowHeight);
+  }
+}
+
+void UpdateStripControls(const StripControls& controls,
+                         const HeliumMediaStripModel& model,
+                         SkColor surface) {
+  const SkColor enabled_color =
+      helium::GetMediaStripIconColor(surface, /*enabled=*/true);
+  const SkColor disabled_color =
+      helium::GetMediaStripIconColor(surface, /*enabled=*/false);
+
+  controls.favicon->SetTooltipText(model.source_title);
+  controls.previous->SetTooltipText(l10n_util::GetStringUTF16(
+      IDS_MEDIA_MESSAGE_CENTER_MEDIA_NOTIFICATION_ACTION_PREVIOUS_TRACK));
+  controls.play_pause->SetTooltipText(l10n_util::GetStringUTF16(
+      model.is_playing ? IDS_MEDIA_MESSAGE_CENTER_MEDIA_NOTIFICATION_ACTION_PAUSE
+                       : IDS_MEDIA_MESSAGE_CENTER_MEDIA_NOTIFICATION_ACTION_PLAY));
+  controls.next->SetTooltipText(l10n_util::GetStringUTF16(
+      IDS_MEDIA_MESSAGE_CENTER_MEDIA_NOTIFICATION_ACTION_NEXT_TRACK));
+  controls.mute->SetTooltipText(l10n_util::GetStringUTF16(
+      model.muted ? IDS_MEDIA_MESSAGE_CENTER_MEDIA_NOTIFICATION_ACTION_UNMUTE
+                  : IDS_MEDIA_MESSAGE_CENTER_MEDIA_NOTIFICATION_ACTION_MUTE));
+
+  if (model.favicon.isNull()) {
+    SetGlyph(controls.favicon, vector_icons::kGlobeIcon, enabled_color,
+             helium::kMediaStripFaviconSize);
+  } else {
+    controls.favicon->SetImageModel(
+        views::Button::STATE_NORMAL,
+        ui::ImageModel::FromImageSkia(
+            gfx::ImageSkiaOperations::CreateResizedImage(
+                model.favicon, skia::ImageOperations::RESIZE_BEST,
+                gfx::Size(helium::kMediaStripFaviconSize,
+                          helium::kMediaStripFaviconSize))));
+  }
+
+  SetGlyph(controls.previous, vector_icons::kMediaPreviousTrackOldIcon,
+           model.can_previous ? enabled_color : disabled_color,
+           helium::kMediaStripIconSize);
+  controls.previous->SetEnabled(model.can_previous);
+
+  SetGlyph(controls.play_pause,
+           model.is_playing ? vector_icons::kPauseOldIcon
+                            : vector_icons::kPlayArrowOldIcon,
+           enabled_color, helium::kMediaStripIconSize);
+
+  SetGlyph(controls.next, vector_icons::kMediaNextTrackOldIcon,
+           model.can_next ? enabled_color : disabled_color,
+           helium::kMediaStripIconSize);
+  controls.next->SetEnabled(model.can_next);
+
+  SetGlyph(controls.mute,
+           model.muted ? vector_icons::kVolumeOffIcon
+                       : vector_icons::kVolumeUpFilledIcon,
+           enabled_color, helium::kMediaStripIconSize);
+}
+
+}  // namespace
+
+// ---------------------------------------------------------------------------
+// HeliumMediaStripView -- one session's capsule.
+
+HeliumMediaStripView::HeliumMediaStripView(
+    HeliumMediaStripController* controller,
+    base::RepeatingClosure on_hovered)
+    : views::AnimationDelegateViews(this),
+      controller_(controller),
+      on_hovered_(std::move(on_hovered)) {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  layer()->SetOpacity(0.0f);
+  SetVisible(false);
+  SetNotifyEnterExitOnChild(true);
+  shown_animation_.SetSlideDuration(base::Milliseconds(200));
+
+  favicon_button_ = AddChildView(MakeStripButton(
+      BoundAction(&HeliumMediaStripController::ActivateSource)));
+  previous_button_ = AddChildView(MakeStripButton(
+      BoundAction(&HeliumMediaStripController::PreviousTrack)));
+  play_pause_button_ = AddChildView(MakeStripButton(
+      BoundAction(&HeliumMediaStripController::TogglePlayPause)));
+  next_button_ = AddChildView(MakeStripButton(
