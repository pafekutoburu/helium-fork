+SkColor HeliumMediaStripExpandedView::SurfaceColor() const {
+  const ui::ColorProvider* const provider = GetColorProvider();
+  const SkColor sidebar =
+      provider ? provider->GetColor(kColorToolbar) : SK_ColorWHITE;
+  return helium::GetMediaStripSurfaceColor(sidebar);
+}
+
+int HeliumMediaStripExpandedView::ExpandedHeight() const {
+  const HeliumMediaStripModel& model = BoundRow();
+  return helium::MediaStripExpandedHeight(!model.title.empty() ||
+                                          !model.artist.empty());
+}
+
+void HeliumMediaStripExpandedView::UpdatePanelBounds() {
+  if (anchor_strip_bounds_.IsEmpty()) {
+    return;
+  }
+  const double progress = expand_animation_.GetCurrentValue();
+  // Grows upward out of the hovered capsule, bottom edge pinned.
+  const helium::MediaStripPanelBounds panel = helium::GetMediaStripPanelBounds(
+      anchor_strip_bounds_.bottom(), ExpandedHeight(), progress,
+      max_available_height_);
+  const gfx::Rect panel_bounds(anchor_strip_bounds_.x(), panel.y,
+                               anchor_strip_bounds_.width(), panel.height);
+  SetBoundsRect(panel_bounds);
+  // Height and fade ride the same tween value: synchronized by construction.
+  layer()->SetOpacity(static_cast<float>(progress));
+  if (shadow_frame_) {
+    // Sibling layer: fade opacity and visibility do not carry over (and a
+    // hidden-but-boundsy shadow would still hit the caption test).
+    const bool shadow_visible =
+        GetVisible() && progress > 0.0 &&
+        helium::CanShowCardShadow(panel_bounds.width(), panel_bounds.height(),
+                                  helium::kMediaStripCornerRadius);
+    shadow_frame_->SetVisible(shadow_visible);
+    shadow_frame_->SetShadowOpacity(progress);
+    shadow_frame_->SetShadowCornerRadius(helium::kMediaStripCornerRadius);
+    shadow_frame_->SetCardBounds(panel_bounds);
+  }
+  // Last: the region slides the capsules above this panel by exactly the
+  // growth we just applied, so the two moves land in the same frame.
+  if (on_bounds_changed_) {
+    on_bounds_changed_.Run();
+  }
+}
