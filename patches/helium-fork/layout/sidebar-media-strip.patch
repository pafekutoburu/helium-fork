+bool HeliumMediaStripExpandedView::OnMousePressed(const ui::MouseEvent& event) {
+  // Claim the press so the release below is ours; child buttons have already
+  // taken theirs by the time this runs.
+  return true;
+}
+
+void HeliumMediaStripExpandedView::OnMouseReleased(
+    const ui::MouseEvent& event) {
+  // Any non-button spot on the panel activates the source -- the user asked
+  // for the title/URL to be clickable like Arc (2026-08-20), and the labels
+  // pass events through by construction.
+  if (event.IsOnlyLeftMouseButton() && HitTestPoint(event.location())) {
+    controller_->ActivateSource(ResolveItemId(controller_, bound_item_id_));
+  }
+}
