+void HeliumMediaScrimView::SetShown(bool shown) {
+  if (shown_ == shown) {
+    return;
+  }
+  shown_ = shown;
+  if (shown) {
+    SetVisible(true);
+    shown_animation_.Show();
+  } else {
+    shown_animation_.Hide();
+  }
+}
+
+void HeliumMediaScrimView::AnimationProgressed(
+    const gfx::Animation* animation) {
+  layer()->SetOpacity(static_cast<float>(animation->GetCurrentValue()));
+}
+
+void HeliumMediaScrimView::AnimationEnded(const gfx::Animation* animation) {
+  layer()->SetOpacity(static_cast<float>(animation->GetCurrentValue()));
+  if (animation->GetCurrentValue() == 0.0) {
+    SetVisible(false);
+  }
+}
+
+void HeliumMediaScrimView::OnPaint(gfx::Canvas* canvas) {
+  const ui::ColorProvider* const provider = GetColorProvider();
+  if (!provider) {
+    return;
+  }
+  const SkColor sidebar = provider->GetColor(kColorToolbar);
+  const int fade = std::min(helium::kMediaScrimFadeHeight, height());
+  if (fade > 0) {
+    cc::PaintFlags gradient;
+    gradient.setShader(gfx::CreateGradientShader(
+        gfx::Point(0, 0), gfx::Point(0, fade),
+        SkColorSetA(sidebar, 0), sidebar));
+    canvas->DrawRect(gfx::RectF(0, 0, width(), fade), gradient);
+  }
+  if (height() > fade) {
+    canvas->FillRect(gfx::Rect(0, fade, width(), height() - fade), sidebar);
+  }
+}
