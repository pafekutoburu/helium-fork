+
+void HeliumMediaStripView::SyncShadow() {
+  if (!shadow_frame_) {
+    return;
+  }
+  // The shadow is a sibling layer: it inherits neither this view's fade
+  // opacity nor its visibility, and a hidden-but-boundsy shadow would still
+  // register in the region's caption hit-test. Drive all three by hand.
+  const float opacity = layer()->opacity();
+  const bool shadow_visible =
+      GetVisible() && opacity > 0.0f &&
+      helium::CanShowCardShadow(width(), height(),
+                                helium::kMediaStripCornerRadius);
+  shadow_frame_->SetVisible(shadow_visible);
+  shadow_frame_->SetShadowOpacity(opacity);
+  shadow_frame_->SetShadowCornerRadius(helium::kMediaStripCornerRadius);
+  shadow_frame_->SetCardBounds(bounds());
+}
