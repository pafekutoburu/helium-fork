--- /dev/null
+++ src/chrome/browser/ui/helium/arc_media_strip.h
@@ -0,0 +1,275 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_MEDIA_STRIP_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_MEDIA_STRIP_H_
+
+#include <cmath>
+#include <cstddef>
+#include <vector>
+
+#include "chrome/browser/ui/helium/arc_sidebar_surface.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/color_utils.h"
+
+// helium-fork: the sidebar's bottom media strip -- a pill of playback
+// controls for every tab with a live media session.
+//
+// Everything measured off the real Arc 2026-08-19 (@2x, reference strip
+// width 261pt = a 277pt sidebar minus the 8pt margins): a 33pt pill, corner
+// radius ~7.75, five elements at evenly spaced, symmetric centers (the
+// play/pause button lands exactly mid-pill), a 16pt site favicon, enabled
+// glyphs at ~L125 and disabled ones at ~L210 on the white pill. Hovering
+// expands it upward -- the bottom edge never moves -- into a panel that adds
+// a 33pt header row (site name inset 17pt; picture-in-picture and close
+// buttons at 46pt and 18pt from the right edge). We add one fused row Arc
+// does not have: title + artist from the media session, between the header
+// and the controls (user 2026-08-19).
+//
+// Two deliberate departures from Arc, both user-chosen 2026-08-19: the
+// volume button toggles mute instead of opening Arc's volume slider, and the
+// metadata row exists at all. Three more user rulings moved it further off
+// pure replication on 2026-08-20:
+// - It shows whenever a session exists. Arc hides the strip while the
+//   playing tab is the active one (live-verified 2026-08-19); ours stays,
+//   and activating the source tab no longer clears it.
+// - Two or more sessions: one capsule per session (r5, user-chosen
+//   2026-08-20), stacked upward -- the oldest keeps the pill's place in the
+//   layout flow, later ones float over the tab rows behind a fading scrim,
+//   and hovering any capsule expands that capsule alone. Every capsule above
+//   the hovered one slides up by exactly the panel's growth, so an open
+//   panel never covers a sibling (r6, user 2026-08-20). The r4 multi-session
+//   list rows and r5's global pause-all/mute-all card are both gone with
+//   their geometry.
+// - The strip is a floating card now (arc_sidebar_surface.h), which folded
+//   its radius into the unified capsule language.
+//
+// Header-only and free of //ui/views so all of it pins in the lightweight
+// test target.
+namespace helium {
+
+// One row of the strip -- the collapsed pill, the expanded header, and the
+// expanded controls row are all this tall (Arc: 33pt collapsed, 66pt for the
+// two-row expansion).
+inline constexpr int kMediaStripRowHeight = 33;
+
+// The metadata row: title only since r5 (the user cut the artist line,
+// 2026-08-20), so it is an ordinary 33pt row with the 17pt-tall line
+// centered -- ~8pt of air above and below, the tab capsule's own rhythm.
+inline constexpr int kMediaStripMetadataRowHeight = kMediaStripRowHeight;
+
+// Was Arc's own ~8 under the replicate-first rule; the user folded it into
+// the unified capsule radius when the strip became a floating card
+// (2026-08-20). Keep equal to kVerticalTabCornerRadius.
+inline constexpr int kMediaStripCornerRadius = 12;
+
+inline constexpr int kMediaStripFaviconSize = 16;
+
+// Control glyph size. Arc's prev/next are ~13pt wide, the volume glyph ~19pt;
+// vector icons come square, so this splits the difference. Acceptance-tunable.
+inline constexpr int kMediaStripIconSize = 18;
+
+// Expanded header row: site-name text inset from the left edge, and the two
+// buttons' centers from the right edge (Arc at width 261: pip x215, close
+// x243).
+inline constexpr int kMediaStripHeaderLeftInset = 17;
+inline constexpr int kMediaStripPipCenterFromRight = 46;
+inline constexpr int kMediaStripCloseCenterFromRight = 18;
+
+// Capsule-to-capsule gap in the stack: the sidebar-wide 8pt (card-to-card is
+// one of the four unified gaps, M3.9c-pre-r2); deliberately not Zen's 6.
+inline constexpr int kMediaStripStackGap = 8;
+
+// The scrim's fade band above the topmost floating capsule: sidebar color,
+// transparent at the top edge, solid at the band's bottom. Tab rows dissolve
+// across it instead of colliding with the stack. Acceptance-tunable.
+inline constexpr int kMediaScrimFadeHeight = 16;
+
+// The first and last slot centers sit this far in from the pill's edges
+// (Arc: 21.75/22 at width 261; the three middle slots divide the rest
+// evenly, 54.4pt apart).
+inline constexpr int kMediaStripEdgeSlotInset = 22;
+
+// Below this the five slots collide and the strip hides. A collapsed 42pt
+// sidebar (strip width 42-16 = 26) hides it; the narrowest expanded sidebar
+// (160pt, strip width 144) shows it.
+inline constexpr int kMediaStripMinWidth = 120;
+
+// The center x of slot 0..4 (favicon, previous, play/pause, next, volume) in
+// a strip `strip_width` wide. Even spacing, symmetric, slot 2 at the exact
+// middle -- all three are what Arc measures.
+inline int MediaStripSlotCenter(int strip_width, int slot) {
+  const double span = strip_width - 2.0 * kMediaStripEdgeSlotInset;
+  return static_cast<int>(
+      std::lround(kMediaStripEdgeSlotInset + span * slot / 4.0));
+}
+
+// Expanded height: Arc's exact two rows when the session has no title to
+// show, header + metadata + controls when it does.
+inline constexpr int MediaStripExpandedHeight(bool has_metadata) {
+  return kMediaStripRowHeight + (has_metadata ? kMediaStripMetadataRowHeight : 0) +
+         kMediaStripRowHeight;
+}
+
+struct MediaStripPanelBounds {
+  int y = 0;
+  int height = 0;
+};
+
+// The hover panel's bounds at `progress` (0 = collapsed pill, 1 = fully
+// expanded), growing upward from a pinned bottom edge: y + height ==
+// `anchor_bottom_y` at every step, which is the "the pill does not move, the
+// panel rises out of it" of the real thing. `max_available` caps the height
+// so a short sidebar cannot push the panel out the top.
+inline MediaStripPanelBounds GetMediaStripPanelBounds(int anchor_bottom_y,
+                                                      int expanded_height,
+                                                      double progress,
+                                                      int max_available) {
+  MediaStripPanelBounds bounds;
+  const double clamped = progress < 0.0 ? 0.0 : (progress > 1.0 ? 1.0 : progress);
+  int target = expanded_height;
+  if (target > max_available) {
+    target = max_available;
+  }
+  if (target < kMediaStripRowHeight) {
+    target = kMediaStripRowHeight;
+  }
+  bounds.height = static_cast<int>(std::lround(
+      kMediaStripRowHeight + (target - kMediaStripRowHeight) * clamped));
+  bounds.y = anchor_bottom_y - bounds.height;
+  return bounds;
+}
+
+// "Nothing is hovered" for the stack functions below.
+inline constexpr size_t kMediaStripNoHover = static_cast<size_t>(-1);
+
+// How much room the stack makes above the hovered capsule while its panel is
+// open: the panel's growth, exactly. Feed it the panel's *live* animated
+// height and the slide rides the panel's own tween -- one operation, one
+// timeline (M3.3h).
+inline constexpr int MediaStripExpansionShift(int panel_height) {
+  return panel_height > kMediaStripRowHeight
+             ? panel_height - kMediaStripRowHeight
+             : 0;
+}
+
+// Capsule `index` measured upward from the base capsule's top edge. Index 0
+// is the base capsule (the one that keeps its slot in the layout flow, hence
+// offset 0); index j >= 1 is floating capsule j-1. `hovered_index` is the
+// capsule whose panel is open, kMediaStripNoHover when none is.
+//
+// Self-check, two sessions and a 99pt panel. Hovering the base: capsule 1
+// sits 41 + 66 = 107 up, so its bottom edge is 74 up while the panel's top
+// edge is 66 up -- the 8pt stack gap, at every frame. Hovering capsule 1:
+// the shift applies to nothing, the panel's bottom edge lands 8 above the
+// base capsule's top. One formula, both directions.
+inline constexpr int MediaStripCapsuleOffsetFromBase(size_t index,
+                                                     size_t hovered_index,
+                                                     int panel_height) {
+  if (index == 0) {
+    return 0;
+  }
+  const int stacked =
+      static_cast<int>(index) * (kMediaStripRowHeight + kMediaStripStackGap);
+  const bool above_hovered =
+      hovered_index != kMediaStripNoHover && index > hovered_index;
+  return stacked + (above_hovered ? MediaStripExpansionShift(panel_height) : 0);
+}
+
+// The floating stack above the base capsule: total height of the overlay
+// portion for `extra_capsules` sessions beyond the first. Equal to the
+// topmost capsule's offset by construction, so the stack always ends exactly
+// at that capsule's top edge.
+inline constexpr int MediaStripOverlayStackHeight(int extra_capsules,
+                                                  size_t hovered_index,
+                                                  int panel_height) {
+  return extra_capsules <= 0
+             ? 0
+             : MediaStripCapsuleOffsetFromBase(
+                   static_cast<size_t>(extra_capsules), hovered_index,
+                   panel_height);
+}
+
+// The tallest panel that still leaves every capsule above the hovered one
+// inside the sidebar. `room_above_anchor` is the distance from the hovered
+// capsule's bottom edge up to the ceiling (the address row); each capsule
+// that gets pushed up needs one stacked slot of it.
+inline constexpr int MediaStripMaxPanelHeight(int room_above_anchor,
+                                              int overlay_count,
+                                              size_t hovered_index) {
+  const int pushed =
+      hovered_index == kMediaStripNoHover
+          ? 0
+          : overlay_count - static_cast<int>(hovered_index);
+  const int room =
+      room_above_anchor -
+      (pushed > 0 ? pushed * (kMediaStripRowHeight + kMediaStripStackGap) : 0);
+  return room < kMediaStripRowHeight ? kMediaStripRowHeight : room;
+}
+
+// What the selection policy needs to know about one active media item, in
+// MediaItemManager order (actively-playing first).
+struct MediaStripItemFacts {
+  // The item's WebContents is a tab in this window.
+  bool in_this_window = false;
+  // The user closed this one from the strip; it stays gone until the session
+  // itself goes away.
+  bool dismissed = false;
+};
+// There is deliberately no is_active_tab here anymore: Arc skips the active
+// tab's session, and the user overrode that on 2026-08-20 ("show whenever
+// anything is playing").
+
+// The indices of every item the strip should show, in the caller's order.
+// This decides membership only -- the controller keeps its rows in bind
+// order, so a play/pause cannot reshuffle the list.
+inline std::vector<int> SelectMediaStripItems(
+    const std::vector<MediaStripItemFacts>& items) {
+  std::vector<int> selected;
+  for (size_t i = 0; i < items.size(); ++i) {
+    if (items[i].in_this_window && !items[i].dismissed) {
+      selected.push_back(static_cast<int>(i));
+    }
+  }
+  return selected;
+}
+
+inline constexpr bool ShouldShowSidebarMediaStrip(int item_count,
+                                                  int strip_width) {
+  return item_count > 0 && strip_width >= kMediaStripMinWidth;
+}
+
+// The pill's surface is the sidebar floating card (pure white in light
+// themes, a white lift in dark ones) -- one function with the active tab
+// row, so the two cards cannot drift apart. The hairline that used to
+// separate white-on-white is gone with it: the card is borderless and the
+// shadow carries the elevation (Dia-measured, 2026-08-20).
+inline SkColor GetMediaStripSurfaceColor(SkColor sidebar) {
+  return GetSidebarFloatingCardColor(sidebar);
+}
+
+// Control glyphs. Arc on its white pill: enabled ~(125,124,124), disabled
+// ~(211,210,210). GetColorWithMaxContrast(white) is Google Grey 900 (L~32),
+// not pure black, so those measurements are 0.58 and 0.20 of it -- pinned by
+// the unit test, theme-generic by construction.
+inline SkColor GetMediaStripIconColor(SkColor surface, bool enabled) {
+  return color_utils::AlphaBlend(color_utils::GetColorWithMaxContrast(surface),
+                                 surface, enabled ? 0.58f : 0.20f);
+}
+
+// Header row site name / metadata title.
+inline SkColor GetMediaStripPrimaryTextColor(SkColor surface) {
+  return color_utils::AlphaBlend(color_utils::GetColorWithMaxContrast(surface),
+                                 surface, 0.87f);
+}
+
+// Metadata artist line.
+inline SkColor GetMediaStripSecondaryTextColor(SkColor surface) {
+  return color_utils::AlphaBlend(color_utils::GetColorWithMaxContrast(surface),
+                                 surface, 0.55f);
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_MEDIA_STRIP_H_
Index: src/chrome/browser/ui/helium/arc_media_strip_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_media_strip_unittest.cc
@@ -0,0 +1,264 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_media_strip.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+// Arc's own strip, 2026-08-19: width 261, slot centers 22 / 76 / 130 / 184.5
+// / 239 -- evenly spaced, symmetric, play/pause dead center.
+TEST(ArcMediaStripTest, SlotCentersMatchTheMeasuredArcStrip) {
+  constexpr int kArcWidth = 261;
+  const int expected[] = {22, 76, 130, 184, 238};
+  for (int slot = 0; slot < 5; ++slot) {
+    EXPECT_NEAR(expected[slot], MediaStripSlotCenter(kArcWidth, slot), 1)
+        << "slot " << slot;
+  }
+  // Play/pause is the pill's own center.
+  EXPECT_NEAR(kArcWidth / 2, MediaStripSlotCenter(kArcWidth, 2), 1);
+}
+
+// Symmetry is a property, not a lucky width: the favicon sits as far from the
+// left edge as the volume button from the right, at any width.
+TEST(ArcMediaStripTest, SlotCentersAreSymmetric) {
+  for (const int width : {120, 144, 200, 261, 262, 384}) {
+    for (int slot = 0; slot < 5; ++slot) {
+      EXPECT_NEAR(width,
+                  MediaStripSlotCenter(width, slot) +
+                      MediaStripSlotCenter(width, 4 - slot),
+                  1)
+          << "width " << width << " slot " << slot;
+    }
+  }
+}
+
+// At the minimum width the five glyphs still clear each other -- that is what
+// the minimum is for.
+TEST(ArcMediaStripTest, SlotsClearEachOtherAtTheMinimumWidth) {
+  for (int slot = 0; slot < 4; ++slot) {
+    EXPECT_GE(MediaStripSlotCenter(kMediaStripMinWidth, slot + 1) -
+                  MediaStripSlotCenter(kMediaStripMinWidth, slot),
+              kMediaStripIconSize);
+  }
+}
+
+// Arc's expansion is exactly two of its rows; ours adds the fused metadata
+// row only when there is metadata to put in it.
+TEST(ArcMediaStripTest, ExpandedHeightMatchesTheRows) {
+  EXPECT_EQ(2 * kMediaStripRowHeight, MediaStripExpandedHeight(false));
+  EXPECT_EQ(2 * kMediaStripRowHeight + kMediaStripMetadataRowHeight,
+            MediaStripExpandedHeight(true));
+}
+
+// progress 0 is the pill itself; progress 1 is the full panel.
+TEST(ArcMediaStripTest, PanelBoundsEndpoints) {
+  const int bottom = 700;
+  const int expanded = MediaStripExpandedHeight(true);
+  const MediaStripPanelBounds rest =
+      GetMediaStripPanelBounds(bottom, expanded, 0.0, 1000);
+  EXPECT_EQ(kMediaStripRowHeight, rest.height);
+  EXPECT_EQ(bottom - kMediaStripRowHeight, rest.y);
+  const MediaStripPanelBounds full =
+      GetMediaStripPanelBounds(bottom, expanded, 1.0, 1000);
+  EXPECT_EQ(expanded, full.height);
+  EXPECT_EQ(bottom - expanded, full.y);
+}
+
+// The bottom edge is pinned through the whole tween -- the pill does not
+// move, the panel rises out of it -- and the height never retreats.
+TEST(ArcMediaStripTest, PanelBottomIsPinnedAndGrowthIsMonotonic) {
+  const int bottom = 700;
+  const int expanded = MediaStripExpandedHeight(true);
+  int last_height = 0;
+  for (int step = 0; step <= 10; ++step) {
+    const MediaStripPanelBounds bounds =
+        GetMediaStripPanelBounds(bottom, expanded, step / 10.0, 1000);
+    EXPECT_EQ(bottom, bounds.y + bounds.height) << "step " << step;
+    EXPECT_GE(bounds.height, last_height) << "step " << step;
+    last_height = bounds.height;
+  }
+  // Out-of-range progress clamps to the endpoints.
+  EXPECT_EQ(kMediaStripRowHeight,
+            GetMediaStripPanelBounds(bottom, expanded, -0.5, 1000).height);
+  EXPECT_EQ(expanded,
+            GetMediaStripPanelBounds(bottom, expanded, 1.5, 1000).height);
+}
+
+// A short sidebar caps the panel instead of pushing it out the top, and the
+// cap never goes below the pill itself.
+TEST(ArcMediaStripTest, PanelHeightIsClampedToTheAvailableRoom) {
+  const int bottom = 100;
+  const int expanded = MediaStripExpandedHeight(true);
+  EXPECT_EQ(80, GetMediaStripPanelBounds(bottom, expanded, 1.0, 80).height);
+  EXPECT_EQ(kMediaStripRowHeight,
+            GetMediaStripPanelBounds(bottom, expanded, 1.0, 10).height);
+  EXPECT_GE(GetMediaStripPanelBounds(bottom, expanded, 1.0, 80).y, 0);
+}
+
+// The strip shows for *every* session in this window -- active tab included.
+// Arc skips the active tab's session; the user overrode that on 2026-08-20
+// ("show whenever anything is playing"), which is why there is no
+// is_active_tab fact left to consult.
+TEST(ArcMediaStripTest, SelectionCollectsEveryEligibleItem) {
+  EXPECT_EQ(std::vector<int>({0}),
+            SelectMediaStripItems({{.in_this_window = true}}));
+  EXPECT_EQ(std::vector<int>({0, 2}),
+            SelectMediaStripItems({{.in_this_window = true},
+                                   {.in_this_window = false},
+                                   {.in_this_window = true}}));
+  EXPECT_TRUE(SelectMediaStripItems({}).empty());
+}
+
+TEST(ArcMediaStripTest, SelectionSkipsOtherWindowsAndDismissed) {
+  EXPECT_TRUE(SelectMediaStripItems({{.in_this_window = false}}).empty());
+  EXPECT_TRUE(SelectMediaStripItems({{.in_this_window = true,
+                                      .dismissed = true}})
+                  .empty());
+}
+
+// Hidden below the width where the slots collide: a collapsed 42pt sidebar
+// (strip 26) hides it, the narrowest expanded sidebar (160pt, strip 144)
+// shows it.
+TEST(ArcMediaStripTest, VisibilityHasAWidthFloor) {
+  EXPECT_FALSE(ShouldShowSidebarMediaStrip(1, 26));
+  EXPECT_FALSE(ShouldShowSidebarMediaStrip(1, kMediaStripMinWidth - 1));
+  EXPECT_TRUE(ShouldShowSidebarMediaStrip(1, kMediaStripMinWidth));
+  EXPECT_TRUE(ShouldShowSidebarMediaStrip(2, 144));
+  EXPECT_FALSE(ShouldShowSidebarMediaStrip(0, 300));
+}
+
+int Luminance(SkColor color) {
+  return (SkColorGetR(color) + SkColorGetG(color) + SkColorGetB(color)) / 3;
+}
+
+// Arc's glyphs on its white pill: enabled ~(125,124,124), disabled
+// ~(211,210,210). Ours must land there on a white surface and flip direction
+// on a dark one.
+TEST(ArcMediaStripTest, IconColorsMatchArcOnAWhiteSurface) {
+  EXPECT_NEAR(125, Luminance(GetMediaStripIconColor(SK_ColorWHITE, true)), 2);
+  EXPECT_NEAR(210, Luminance(GetMediaStripIconColor(SK_ColorWHITE, false)), 2);
+  const SkColor dark_surface = SkColorSetRGB(0x30, 0x30, 0x30);
+  EXPECT_GT(Luminance(GetMediaStripIconColor(dark_surface, true)),
+            Luminance(dark_surface));
+  EXPECT_GT(Luminance(GetMediaStripIconColor(dark_surface, true)),
+            Luminance(GetMediaStripIconColor(dark_surface, false)));
+}
+
+// The pill is the sidebar floating card -- pure white on light, a lift on
+// dark, and the same answer as the active tab row's card so the two cannot
+// drift apart. (The hairline is gone: the card is borderless, the shadow
+// carries the elevation.)
+TEST(ArcMediaStripTest, SurfaceIsTheSidebarFloatingCard) {
+  const SkColor dark_sidebar = SkColorSetRGB(0x35, 0x35, 0x35);
+  EXPECT_GT(Luminance(GetMediaStripSurfaceColor(dark_sidebar)),
+            Luminance(dark_sidebar));
+  EXPECT_EQ(SK_ColorWHITE, GetMediaStripSurfaceColor(SK_ColorWHITE));
+  EXPECT_EQ(GetSidebarFloatingCardColor(dark_sidebar),
+            GetMediaStripSurfaceColor(dark_sidebar));
+  // Text hierarchy holds on both.
+  for (const SkColor surface : {SK_ColorWHITE, dark_sidebar}) {
+    EXPECT_NE(GetMediaStripPrimaryTextColor(surface),
+              GetMediaStripSecondaryTextColor(surface));
+  }
+}
+
+// The strip joined the unified capsule radius when it became a floating card
+// (user 2026-08-20). If kVerticalTabCornerRadius ever moves off 12, move
+// this with it.
+TEST(ArcMediaStripTest, CornerRadiusIsTheUnifiedCapsuleRadius) {
+  EXPECT_EQ(12, kMediaStripCornerRadius);
+}
+
+// r5: one capsule per extra session, stack-gapped; zero extras, zero
+// overlay. Nothing is hovered, so nothing is pushed.
+TEST(ArcMediaStripTest, OverlayStackHeightCountsExtrasOnly) {
+  constexpr int kSlot = kMediaStripRowHeight + kMediaStripStackGap;
+  EXPECT_EQ(0, MediaStripOverlayStackHeight(0, kMediaStripNoHover,
+                                            kMediaStripRowHeight));
+  EXPECT_EQ(0, MediaStripOverlayStackHeight(-1, kMediaStripNoHover,
+                                            kMediaStripRowHeight));
+  EXPECT_EQ(kSlot, MediaStripOverlayStackHeight(1, kMediaStripNoHover,
+                                                kMediaStripRowHeight));
+  EXPECT_EQ(3 * kSlot, MediaStripOverlayStackHeight(3, kMediaStripNoHover,
+                                                    kMediaStripRowHeight));
+  // A collapsed panel is exactly one row tall, so hovering with it closed
+  // must read identically to not hovering at all.
+  EXPECT_EQ(3 * kSlot,
+            MediaStripOverlayStackHeight(3, 0, kMediaStripRowHeight));
+}
+
+// r6, the user's ask: expanding a capsule must never cover a sibling. The
+// capsules above the hovered one move up by exactly the panel's growth, so
+// the gap between the panel's top edge and the capsule above it is the
+// unified 8 -- at every frame of the tween, whichever capsule is hovered.
+TEST(ArcMediaStripTest, ExpandingAPanelPushesOnlyTheCapsulesAboveIt) {
+  constexpr int kSlot = kMediaStripRowHeight + kMediaStripStackGap;
+  constexpr int kPanel = 99;  // header + title + controls
+  // Hovering the base capsule (index 0) of a two-session stack.
+  EXPECT_EQ(0, MediaStripCapsuleOffsetFromBase(0, 0, kPanel));
+  EXPECT_EQ(kSlot + (kPanel - kMediaStripRowHeight),
+            MediaStripCapsuleOffsetFromBase(1, 0, kPanel));
+  // Hovering the floating capsule (index 1): the base does not move, and
+  // neither does the hovered capsule itself.
+  EXPECT_EQ(0, MediaStripCapsuleOffsetFromBase(0, 1, kPanel));
+  EXPECT_EQ(kSlot, MediaStripCapsuleOffsetFromBase(1, 1, kPanel));
+  // Three capsules, middle one hovered: only the top one is displaced.
+  EXPECT_EQ(kSlot, MediaStripCapsuleOffsetFromBase(1, 1, kPanel));
+  EXPECT_EQ(2 * kSlot + (kPanel - kMediaStripRowHeight),
+            MediaStripCapsuleOffsetFromBase(2, 1, kPanel));
+  EXPECT_EQ(0, MediaStripExpansionShift(kMediaStripRowHeight));
+  EXPECT_EQ(0, MediaStripExpansionShift(0));
+}
+
+// The 8pt gap is the whole point: derive it from the two functions rather
+// than restating it, so a change to either has to keep them consistent.
+TEST(ArcMediaStripTest, ExpandedPanelKeepsTheUnifiedGapToTheCapsuleAbove) {
+  constexpr int kBaseTop = 800;
+  for (int panel = kMediaStripRowHeight; panel <= 99; ++panel) {
+    for (size_t hovered = 0; hovered <= 2; ++hovered) {
+      // The panel's bottom edge is pinned to the hovered capsule's bottom.
+      const int anchor_bottom =
+          kBaseTop -
+          MediaStripCapsuleOffsetFromBase(hovered, hovered, panel) +
+          kMediaStripRowHeight;
+      const int panel_top = anchor_bottom - panel;
+      const int above_bottom =
+          kBaseTop -
+          MediaStripCapsuleOffsetFromBase(hovered + 1, hovered, panel) +
+          kMediaStripRowHeight;
+      EXPECT_EQ(kMediaStripStackGap, panel_top - above_bottom)
+          << "panel " << panel << " hovered " << hovered;
+    }
+  }
+}
+
+// The clamp has to budget for the capsules the panel is about to displace,
+// or the topmost one is pushed through the address row.
+TEST(ArcMediaStripTest, MaxPanelHeightBudgetsForTheDisplacedCapsules) {
+  constexpr int kSlot = kMediaStripRowHeight + kMediaStripStackGap;
+  // Two overlay capsules, base hovered: both get pushed.
+  EXPECT_EQ(500 - 2 * kSlot, MediaStripMaxPanelHeight(500, 2, 0));
+  // Topmost hovered: nothing above it, so the full room is available.
+  EXPECT_EQ(500, MediaStripMaxPanelHeight(500, 2, 2));
+  // Nothing hovered, no budget to reserve.
+  EXPECT_EQ(500, MediaStripMaxPanelHeight(500, 2, kMediaStripNoHover));
+  // Never below one row, however cramped.
+  EXPECT_EQ(kMediaStripRowHeight, MediaStripMaxPanelHeight(20, 2, 0));
+  EXPECT_EQ(kMediaStripRowHeight, MediaStripMaxPanelHeight(0, 0, 0));
+}
+
+// The r5 metadata row is a plain 33pt row (single line since the artist
+// line was cut, user 2026-08-20); the scrim's fade band is a real band.
+TEST(ArcMediaStripTest, StackGeometryHoldsItsShape) {
+  EXPECT_EQ(kMediaStripRowHeight, kMediaStripMetadataRowHeight);
+  EXPECT_GT(kMediaScrimFadeHeight, 0);
+  // Card-to-card is the sidebar-wide 8 (M3.9c-pre-r2's unified gaps).
+  EXPECT_EQ(8, kMediaStripStackGap);
+}
+
