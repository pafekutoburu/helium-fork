+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_HELIUM_MEDIA_STRIP_CONTROLLER_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_HELIUM_MEDIA_STRIP_CONTROLLER_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/containers/flat_set.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/global_media_controls/public/media_item_manager.h"
+#include "components/global_media_controls/public/media_item_manager_observer.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/media_session/public/mojom/audio_focus.mojom.h"
+#include "services/media_session/public/mojom/media_controller.mojom.h"
+#include "services/media_session/public/mojom/media_session.mojom.h"
+#include "ui/gfx/image/image_skia.h"
+
+class Browser;
+
+namespace content {
+class WebContents;
+}
+
+// helium-fork: everything one row of the sidebar media strip shows, in one
+// struct the views can render without asking anything else. Pushed whole on
+// every change; `has_item` flips true only once the row's first session info
+// has arrived, so a row never appears half-populated (the fork's "everything
+// in one operation appears together" rule).
+struct HeliumMediaStripModel {
+  HeliumMediaStripModel();
+  HeliumMediaStripModel(const HeliumMediaStripModel&);
+  HeliumMediaStripModel& operator=(const HeliumMediaStripModel&);
+  ~HeliumMediaStripModel();
+
+  // The MediaItemManager item id (== the media session request id), the
+  // stable identity the view diffs rows by and the buttons address.
+  std::string item_id;
+  bool has_item = false;
+  bool is_playing = false;
+  bool can_previous = false;
+  bool can_next = false;
+  bool can_pip = false;
+  bool pip_active = false;
+  bool muted = false;
+  std::u16string title;
+  std::u16string artist;
+  std::u16string source_title;
+  gfx::ImageSkia favicon;
+};
+
+// helium-fork: the data half of the sidebar media strip (arc_media_strip.h
+// holds the policy, HeliumMediaStripView the pixels).
+//
+// One SessionRow per live media session in this window, in *bind order* --
+// stable, so a pause or a new track cannot reshuffle the list. Membership is
+// decided by SelectMediaStripItems() over the MediaItemManager's active ids,
+// but a bound row is sticky: muting the tab (the strip's own volume button!)
+// or a long pause drops the session out of the manager's *active* list while
+// the session, the tab and our MediaController binding all stay alive --
+// evicting by list would strand the user with no way to unmute (probe-hit
+// 2026-08-19). A row leaves on exactly four signals: its WebContents dies,
+// its session's info goes null (audio focus abandoned), its tab leaves this
+// window, or the user dismisses it.
+//
+// Each row deliberately binds its own MediaController mojo remote instead of
+// taking the MediaSessionNotificationItem's view slot: SetView() is a single
+// slot, and a persistent strip in it would fight the media dialog bubble over
+// the same item. MediaControllerManager explicitly supports any number of
+// controllers per session, so the strip observes and drives each session
+// directly and the dialog keeps working untouched.
+//
+// But a MediaController is *only* as durable as the session's audio focus:
+// AudioFocusManager::CreateMediaControllerForSession only binds while the id
+// is on the focus stack, and the MediaController itself is owned by the
+// AudioFocusRequest -- abandon focus (a long pause, a muted tab, another app
+// taking the speaker) and the pipe dies without a word. Rebinding cannot help
+// either: the id is off the stack, so the receiver is dropped silently. The
+// button then does nothing at all, which is what the user hit ("sometimes it
+// just will not pause", 2026-08-20).
+//
+// So every row runs two lines to the same session (r6):
+//   * the MediaController, for membership, teardown (null session info) and
+//     the pre-decoded source icon;
+//   * a *direct* content::MediaSession -- one per WebContents, wholly
+//     independent of audio focus -- which is both the authoritative source of
+//     playback state / actions / metadata and the target of every transport
+//     action. It cannot go zombie, so the buttons cannot go dead.
+// The two overlapping observer methods have identical C++ signatures, so one
+// override serves both bindings; only the controller line ever passes null.
+//
+// Mute is the tab's, not the session's: MediaController::SetMute() silently
+// no-ops unless the session has exactly one player and never advertises the
+// action, so the strip mutes the WebContents the way the tab strip's speaker
+// icon does. The muted bit is fed back only by DidUpdateAudioMutingState, so
+// mutes from anywhere (tab context menu included) stay in sync.
+class HeliumMediaStripController
+    : public global_media_controls::MediaItemManagerObserver,
+      public media_session::mojom::AudioFocusObserver,
+      public TabStripModelObserver {
+ public:
+  HeliumMediaStripController(Browser* browser,
+                             base::RepeatingClosure on_model_changed);
+  HeliumMediaStripController(const HeliumMediaStripController&) = delete;
+  HeliumMediaStripController& operator=(const HeliumMediaStripController&) =
+      delete;
+  ~HeliumMediaStripController() override;
+
+  // The rows that are ready to render (first session info arrived), in bind
+  // order. Pointers are owned by the controller and valid until the next
+  // model-changed notification.
+  std::vector<const HeliumMediaStripModel*> rows() const;
+  int ready_row_count() const;
+
+  // The single-session strip's row: the first ready one, or an empty model
+  // when there is none (has_item false). The single-pill UI reads this and
+  // uses the parameterless button methods below; the list UI addresses rows
+  // by item id.
+  const HeliumMediaStripModel& model() const;
+
+  // The strip's buttons, addressed to one row.
+  void TogglePlayPause(const std::string& item_id);
+  void PreviousTrack(const std::string& item_id);
+  void NextTrack(const std::string& item_id);
+  void ToggleMute(const std::string& item_id);
+  void TogglePictureInPicture(const std::string& item_id);
+  // The X: stop the session and keep this item out of the strip until the
+  // session itself goes away.
+  void Dismiss(const std::string& item_id);
+  // The favicon or any of the row's text: bring the playing tab forward. The
+  // strip stays -- it shows for every session now, active tab included (user
+  // 2026-08-20; Arc hides it there).
+  void ActivateSource(const std::string& item_id);
+
+  // global_media_controls::MediaItemManagerObserver:
+  void OnItemListChanged() override;
+  void OnMediaDialogOpened() override {}
+  void OnMediaDialogClosed() override {}
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+ private:
+  // One live session: its mojo binding, its tab observation, its row model.
+  // Owns nothing but connections; tells the controller when its model
+  // changed or its session ended.
+  class SessionRow;
+
+  // Re-derives the row set from the manager's active ids: prunes stale
+  // dismissals, binds rows for new eligible items (append -- bind order is
+  // the display order), and drops rows whose tab left this window. Never
+  // drops a row merely for leaving the active list (stickiness, above).
+  void RescanItems();
+  // media_session::mojom::AudioFocusObserver:
+  //
+  // helium-fork M4-r1: the edge the strip was missing. A row used to leave
+  // on only four signals -- its WebContents dies, its session info goes
+  // null, its tab leaves this window, or the user dismisses it -- and the
+  // second of those never fires. MediaSessionInfoChanged(nullptr) is only
+  // sent by MediaController::ClearMediaSession(), which serves the one
+  // global "active" controller; the per-session controller this class binds
+  // is simply destroyed with its AudioFocusRequest, silently.
+  //
+  // The upshot, reported 2026-08-26: finish a video, search for something
+  // else, and the toolbar's own media button disappears while the sidebar
+  // strip stays -- clicking it then lands on the search results, because a
+  // row tracks a WebContents, not a document. MediaSessionImpl survives the
+  // navigation, so even the direct line only reports state=kInactive.
+  //
+  // Native does not rely on that null either: MediaSessionItemProducer
+  // watches real focus events and freezes the item for 2.5s before removing
+  // it. This observes the same events, from the same service.
+  void OnFocusGained(
+      media_session::mojom::AudioFocusRequestStatePtr state) override;
+  void OnFocusLost(
+      media_session::mojom::AudioFocusRequestStatePtr state) override;
+  void OnRequestIdReleased(const base::UnguessableToken& request_id) override;
+
+  SessionRow* FindRow(const std::string& item_id) const;
+  // Removes `row` and notifies. Safe to call from the row's own callbacks --
+  // the caller must return immediately afterwards.
+  void RemoveRow(SessionRow* row);
+  void NotifyModelChanged();
+
+  const raw_ptr<Browser> browser_;
+  const base::RepeatingClosure on_model_changed_;
+
+  raw_ptr<global_media_controls::MediaItemManager> item_manager_ = nullptr;
+  base::ScopedObservation<global_media_controls::MediaItemManager,
+                          global_media_controls::MediaItemManagerObserver>
+      item_manager_observation_{this};
+
+  mojo::Remote<media_session::mojom::MediaControllerManager>
+      controller_manager_;
+
+  // Bind order == display order.
+  std::vector<std::unique_ptr<SessionRow>> rows_;
+
+  // Items the user closed from the strip. Pruned as the sessions leave the
+  // active list, so a site that starts playing again gets its strip back.
+  base::flat_set<std::string> dismissed_item_ids_;
+
+  mojo::Remote<media_session::mojom::AudioFocusManager> audio_focus_remote_;
+  mojo::Receiver<media_session::mojom::AudioFocusObserver>
+      audio_focus_observer_receiver_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_HELIUM_MEDIA_STRIP_CONTROLLER_H_
