+    const HeliumMediaStripModel&) = default;
+HeliumMediaStripModel::~HeliumMediaStripModel() = default;
+
+// One live session's connections and row model. Self-reports through the
+// owner; the two "session ended" callbacks delete |this| via RemoveRow, so
+// they return immediately afterwards. Deleting the mojo receivers from
+// within their own dispatch and the WebContentsObserver from within
+// WebContentsDestroyed are both supported patterns (the old single-session
+// code already reset its receivers mid-dispatch).
+class HeliumMediaStripController::SessionRow
+    : public content::WebContentsObserver,
+      public media_session::mojom::MediaControllerObserver,
+      public media_session::mojom::MediaSessionObserver,
+      public media_session::mojom::MediaControllerImageObserver {
+ public:
+  SessionRow(HeliumMediaStripController* owner,
+             const std::string& item_id,
+             content::WebContents* contents,
+             media_session::mojom::MediaControllerManager* manager)
+      : content::WebContentsObserver(contents), owner_(owner) {
+    model_.item_id = item_id;
+    model_.muted = contents->IsAudioMuted();
+    BindController(manager);
+    BindSession();
+  }
+  SessionRow(const SessionRow&) = delete;
+  SessionRow& operator=(const SessionRow&) = delete;
+  ~SessionRow() override = default;
+
+  // Rebinds when the item re-enters the manager's active list. Losing audio
+  // focus (a muted tab, an expired pause) leaves the old MediaController
+  // remote connected but *mute*: no disconnect, no updates, dead actions
+  // (probe-hit 2026-08-20 -- a paused row kept its playing glyph forever).
+  // A fresh controller's AddObserver replays the latest state, healing the
+  // model in the same breath.
+  void SetInActiveList(bool in_list,
+                       media_session::mojom::MediaControllerManager* manager) {
+    if (in_list && !in_active_list_ && manager) {
+      BindController(manager);
+    }
+    in_active_list_ = in_list;
+  }
+
+  const HeliumMediaStripModel& model() const { return model_; }
+  media_session::mojom::MediaController* media_controller() {
+    return media_controller_.get();
+  }
+  // Every transport action goes here, never through media_controller(): this
+  // one is the WebContents' own session and survives audio focus loss, which
+  // the controller does not (see the class comment). content::MediaSession
+  // rather than the mojom interface it implements -- DidReceiveAction() is
+  // only on the concrete one, and the pause path needs it.
+  content::MediaSession* session() {
+    content::WebContents* const contents = web_contents();
+    return contents ? content::MediaSession::GetIfExists(contents) : nullptr;
+  }
+  bool session_active() const { return session_active_; }
+  bool session_inactive() const { return session_inactive_; }
+
+  // helium-fork M4-r1: audio focus went away. Native freezes the item for
+  // kFreezeTimerDelay and only then removes it, so that a session that
+  // merely handed the speaker over for a moment comes straight back. Same
+  // grace here.
+  void StartFocusLostGrace() {
+    focus_lost_timer_.Start(
+        FROM_HERE, base::Milliseconds(2500),
+        base::BindOnce(&SessionRow::OnFocusLostGraceElapsed,
+                       base::Unretained(this)));
+  }
+  void CancelFocusLostGrace() { focus_lost_timer_.Stop(); }
+
+  // content::WebContentsObserver:
+  void DidUpdateAudioMutingState(bool muted) override {
+    model_.muted = muted;
+    owner_->NotifyModelChanged();
+  }
+  void WebContentsDestroyed() override {
+    owner_->RemoveRow(this);  // Deletes |this|.
+  }
+
+  void OnFocusLostGraceElapsed() {
+    // ⛔ A muted tab keeps its row. Losing focus and being muted look alike
+    // from the outside, and r3 fixed a real complaint by making the row
+    // sticky: without it the strip vanishes the moment you mute, taking the
+    // only control that could unmute it again. Subscribing to focus events
+    // instead of diffing the active list is what lets these two be told
+    // apart -- this guard is the belt to that braces.
+    if (web_contents() && web_contents()->IsAudioMuted()) {
+      return;
+    }
+    owner_->RemoveRow(this);  // Deletes |this|.
+  }
+
+  // media_session::mojom::MediaControllerObserver and
+  // media_session::mojom::MediaSessionObserver: the four overlapping methods
+  // have identical C++ signatures, so each override below serves both
+  // bindings. Only the controller line ever delivers a null session info --
+  // the direct line's parameter is non-nullable in mojom -- so the teardown
+  // branch keeps meaning exactly what it meant before r6.
+  void MediaSessionInfoChanged(
+      media_session::mojom::MediaSessionInfoPtr session_info) override {
+    if (!session_info) {
+      // Audio focus abandoned -- the session is over.
+      owner_->RemoveRow(this);  // Deletes |this|.
+      return;
+    }
+    // The first info is what makes the row real -- appearing before it would
+    // show a row with every control in its zero state for a frame.
+    model_.has_item = true;
+    model_.is_playing = session_info->playback_state ==
+                        media_session::mojom::MediaPlaybackState::kPlaying;
+    // Audio focus, which is *not* the playback state (a session commonly
+    // holds focus while paused, and commonly plays on without it -- a muted
+    // tab, or one that another app took the speaker from). The transport
+    // dispatch needs it because MediaSessionImpl::Suspend() bails on
+    // !IsActive() and Stop() DCHECKs on kInactive.
+    using SessionState = media_session::mojom::MediaSessionInfo::SessionState;
+    session_active_ = session_info->state == SessionState::kActive ||
+                      session_info->state == SessionState::kDucking;
+    session_inactive_ = session_info->state == SessionState::kInactive;
+    model_.pip_active =
+        session_info->picture_in_picture_state ==
+        media_session::mojom::MediaPictureInPictureState::kInPictureInPicture;
+    owner_->NotifyModelChanged();
+  }
+  void MediaSessionMetadataChanged(
+      const std::optional<media_session::MediaMetadata>& metadata) override {
+    model_.title = metadata ? metadata->title : std::u16string();
+    model_.artist = metadata ? metadata->artist : std::u16string();
+    model_.source_title = metadata ? metadata->source_title : std::u16string();
+    owner_->NotifyModelChanged();
+  }
+  void MediaSessionActionsChanged(
+      const std::vector<media_session::mojom::MediaSessionAction>& actions)
+      override {
+    const auto has =
+        [&actions](media_session::mojom::MediaSessionAction action) {
+          return std::find(actions.begin(), actions.end(), action) !=
+                 actions.end();
+        };
+    model_.can_previous =
+        has(media_session::mojom::MediaSessionAction::kPreviousTrack);
+    model_.can_next =
+        has(media_session::mojom::MediaSessionAction::kNextTrack);
+    model_.can_pip =
+        has(media_session::mojom::MediaSessionAction::kEnterPictureInPicture) ||
+        has(media_session::mojom::MediaSessionAction::kExitPictureInPicture);
+    owner_->NotifyModelChanged();
+  }
+  void MediaSessionChanged(
+      const std::optional<base::UnguessableToken>& request_id) override {}
+  void MediaSessionPositionChanged(
+      const std::optional<media_session::MediaPosition>& position) override {}
+
+  // media_session::mojom::MediaSessionObserver only. The strip's icon comes
+  // pre-decoded from the controller's ObserveImages, so the raw image list is
+  // of no use here.
+  void MediaSessionImagesChanged(
+      const base::flat_map<media_session::mojom::MediaSessionImageType,
+                           std::vector<media_session::MediaImage>>& images)
+      override {}
+
+  // media_session::mojom::MediaControllerImageObserver:
+  void MediaControllerImageChanged(
+      media_session::mojom::MediaSessionImageType type,
+      const SkBitmap& bitmap) override {
+    if (type != media_session::mojom::MediaSessionImageType::kSourceIcon) {
+      return;
+    }
+    model_.favicon = bitmap.drawsNothing()
+                         ? gfx::ImageSkia()
+                         : gfx::ImageSkia::CreateFrom1xBitmap(bitmap);
+    owner_->NotifyModelChanged();
+  }
+  void MediaControllerChapterImageChanged(int chapter_index,
+                                          const SkBitmap& bitmap) override {}
+
+ private:
+  void BindController(media_session::mojom::MediaControllerManager* manager) {
+    observer_receiver_.reset();
+    icon_receiver_.reset();
+    media_controller_.reset();
+    content::WebContents* const contents = web_contents();
+    if (!contents || !manager) {
+      return;
+    }
+    manager->CreateMediaControllerForSession(
+        media_controller_.BindNewPipeAndPassReceiver(),
+        content::MediaSession::GetRequestIdFromWebContents(contents));
+    // AddObserver replays the latest state, so the model fills in without a
+    // poll; has_item flips on that replayed info.
+    media_controller_->AddObserver(
+        observer_receiver_.BindNewPipeAndPassRemote());
+    media_controller_->ObserveImages(
+        media_session::mojom::MediaSessionImageType::kSourceIcon,
+        helium::kMediaStripFaviconSize, 2 * helium::kMediaStripFaviconSize,
+        icon_receiver_.BindNewPipeAndPassRemote());
+  }
+
+  // Bound once, for the row's whole life: content::MediaSession is per
+  // WebContents and outlives any number of audio focus handovers, so there is
+  // nothing here to heal and no rebinding path to get wrong.
+  void BindSession() {
+    session_observer_receiver_.reset();
+    if (content::MediaSession* const media_session = session()) {
+      media_session->AddObserver(
+          session_observer_receiver_.BindNewPipeAndPassRemote());
+    }
+  }
+
+  const raw_ptr<HeliumMediaStripController> owner_;
+  base::OneShotTimer focus_lost_timer_;
+  bool in_active_list_ = true;
+  bool session_active_ = false;
+  bool session_inactive_ = false;
+
+  mojo::Remote<media_session::mojom::MediaController> media_controller_;
+  mojo::Receiver<media_session::mojom::MediaControllerObserver>
+      observer_receiver_{this};
+  mojo::Receiver<media_session::mojom::MediaControllerImageObserver>
+      icon_receiver_{this};
+  mojo::Receiver<media_session::mojom::MediaSessionObserver>
+      session_observer_receiver_{this};
+
+  HeliumMediaStripModel model_;
+};
+
+HeliumMediaStripController::HeliumMediaStripController(
+    Browser* browser,
+    base::RepeatingClosure on_model_changed)
+    : browser_(browser), on_model_changed_(std::move(on_model_changed)) {
+  MediaNotificationService* const service =
+      MediaNotificationServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!service) {
+    // No service (some profile types); the strip simply never shows.
+    return;
+  }
+  item_manager_ = service->media_item_manager();
+  item_manager_observation_.Observe(item_manager_);
+  browser_->tab_strip_model()->AddObserver(this);
+  content::GetMediaSessionService().BindMediaControllerManager(
+      controller_manager_.BindNewPipeAndPassReceiver());
+  // The edge the four end-of-life signals were missing: real audio focus
+  // events, from the same service the native producer watches.
+  content::GetMediaSessionService().BindAudioFocusManager(
+      audio_focus_remote_.BindNewPipeAndPassReceiver());
+  audio_focus_remote_->AddObserver(
+      audio_focus_observer_receiver_.BindNewPipeAndPassRemote());
+  RescanItems();
+}
+
+HeliumMediaStripController::~HeliumMediaStripController() {
+  if (item_manager_) {
+    browser_->tab_strip_model()->RemoveObserver(this);
+  }
+}
+
+std::vector<const HeliumMediaStripModel*> HeliumMediaStripController::rows()
+    const {
+  std::vector<const HeliumMediaStripModel*> ready;
+  ready.reserve(rows_.size());
+  for (const std::unique_ptr<SessionRow>& row : rows_) {
+    if (row->model().has_item) {
+      ready.push_back(&row->model());
+    }
+  }
+  return ready;
+}
+
+int HeliumMediaStripController::ready_row_count() const {
+  int count = 0;
+  for (const std::unique_ptr<SessionRow>& row : rows_) {
+    if (row->model().has_item) {
+      ++count;
+    }
+  }
+  return count;
+}
+
+const HeliumMediaStripModel& HeliumMediaStripController::model() const {
+  for (const std::unique_ptr<SessionRow>& row : rows_) {
+    if (row->model().has_item) {
+      return row->model();
+    }
+  }
+  static const base::NoDestructor<HeliumMediaStripModel> kEmpty;
+  return *kEmpty;
+}
+
+void HeliumMediaStripController::TogglePlayPause(const std::string& item_id) {
+  SessionRow* const row = FindRow(item_id);
+  content::MediaSession* const session = row ? row->session() : nullptr;
+  if (!session) {
+    return;
+  }
+  // Not MediaController::ToggleSuspendResume(): that one reads the
+  // controller's *cached* session info and early-returns when it is null,
+  // which is precisely the dead-button case. The model's is_playing comes
+  // from the direct observer, so it is fresh even with no audio focus.
+  using SuspendType = media_session::mojom::MediaSession::SuspendType;
+  if (!row->model().is_playing) {
+    // Resume() routes to the site's play handler first and requests audio
+    // focus itself, so it needs no help.
+    session->Resume(SuspendType::kUI);
+    return;
+  }
+  if (row->session_active()) {
+    session->Suspend(SuspendType::kUI);
+    return;
+  }
+  // Playing without audio focus -- a muted tab, or one another app took the
+  // speaker from. Suspend() returns at its `if (!IsActive())` line *before*
+  // it would have routed the action, so it is a silent no-op here; that is
+  // the second half of the dead-button report. DidReceiveAction(kPause) is
+  // the same thing Suspend() would have done and has no focus check: it
+  // suspends every player outside the routed frame directly and hands the
+  // action to the site's own pause handler.
+  session->DidReceiveAction(media_session::mojom::MediaSessionAction::kPause);
+}
+
+void HeliumMediaStripController::PreviousTrack(const std::string& item_id) {
+  SessionRow* const row = FindRow(item_id);
+  if (content::MediaSession* const session = row ? row->session() : nullptr) {
+    session->PreviousTrack();
+  }
+}
+
+void HeliumMediaStripController::NextTrack(const std::string& item_id) {
+  SessionRow* const row = FindRow(item_id);
+  if (content::MediaSession* const session = row ? row->session() : nullptr) {
+    session->NextTrack();
+  }
+}
+
+void HeliumMediaStripController::ToggleMute(const std::string& item_id) {
+  SessionRow* const row = FindRow(item_id);
+  content::WebContents* const contents = row ? row->web_contents() : nullptr;
+  if (!contents) {
+    return;
+  }
+  // The tab's mute, exactly like the tab strip's speaker click. The model is
+  // updated from DidUpdateAudioMutingState, not here.
+  SetTabAudioMuted(contents, !contents->IsAudioMuted(),
+                   TabMutedReason::kAudioIndicator, std::string());
+}
+
+void HeliumMediaStripController::TogglePictureInPicture(
+    const std::string& item_id) {
+  SessionRow* const row = FindRow(item_id);
+  content::MediaSession* const session = row ? row->session() : nullptr;
+  if (!session) {
+    return;
+  }
+  if (row->model().pip_active) {
+    session->ExitPictureInPicture();
+  } else {
+    session->EnterPictureInPicture();
+  }
+}
+
+void HeliumMediaStripController::Dismiss(const std::string& item_id) {
+  SessionRow* const row = FindRow(item_id);
+  if (!row) {
+    return;
+  }
+  dismissed_item_ids_.insert(item_id);
+  // MediaSessionImpl::Stop() DCHECKs that the session still holds focus, and
+  // going through content::MediaSession means we can now be called when it
+  // does not. Nothing is playing in that state, so there is nothing to stop.
+  if (content::MediaSession* const session =
+          row->session_inactive() ? nullptr : row->session()) {
+    session->Stop(media_session::mojom::MediaSession::SuspendType::kUI);
+  }
+  RemoveRow(row);
+}
+
+void HeliumMediaStripController::ActivateSource(const std::string& item_id) {
+  // Local tab activation rather than MediaController::Raise(): the strip only
+  // ever binds tabs of this window (selection policy), and the mojo Raise
+  // proved a no-op here on the probe. The strip *stays* -- it shows for every
+  // session now, active tab included (user 2026-08-20; Arc hides it there).
+  SessionRow* const row = FindRow(item_id);
+  content::WebContents* const contents = row ? row->web_contents() : nullptr;
+  if (!contents) {
+    return;
+  }
+  const int index =
+      browser_->tab_strip_model()->GetIndexOfWebContents(contents);
+  if (index != TabStripModel::kNoTab) {
+    browser_->tab_strip_model()->ActivateTabAt(index);
+  }
+}
+
+void HeliumMediaStripController::OnItemListChanged() {
+  RescanItems();
+  NotifyModelChanged();
+}
