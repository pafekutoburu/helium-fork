+void HeliumMediaStripExpandedView::UpdateFromModel() {
+  const SkColor surface = SurfaceColor();
+  const SkColor enabled_color =
+      helium::GetMediaStripIconColor(surface, /*enabled=*/true);
+  const HeliumMediaStripModel& model = BoundRow();
+
+  site_label_->SetText(model.source_title);
+  site_label_->SetEnabledColor(
+      helium::GetMediaStripPrimaryTextColor(surface));
+  SetGlyph(pip_button_,
+           model.pip_active ? vector_icons::kPipExitOldIcon
+                            : vector_icons::kPictureInPictureAltOldIcon,
+           model.can_pip
+               ? enabled_color
+               : helium::GetMediaStripIconColor(surface, /*enabled=*/false),
+           helium::kMediaStripIconSize);
+  pip_button_->SetEnabled(model.can_pip);
+  pip_button_->SetTooltipText(l10n_util::GetStringUTF16(
+      model.pip_active ? IDS_MEDIA_MESSAGE_CENTER_MEDIA_NOTIFICATION_ACTION_EXIT_PIP
+                       : IDS_MEDIA_MESSAGE_CENTER_MEDIA_NOTIFICATION_ACTION_ENTER_PIP));
+  SetGlyph(close_button_, vector_icons::kCloseIcon, enabled_color,
+           helium::kMediaStripIconSize - 2);
+  close_button_->SetTooltipText(l10n_util::GetStringUTF16(IDS_APP_CLOSE));
+
+  // Single line since r5: the title, falling back to the artist so a
+  // title-less session still shows something readable. The artist's own line
+  // is gone (user 2026-08-20).
+  title_label_->SetText(model.title.empty() ? model.artist : model.title);
+  title_label_->SetEnabledColor(
+      helium::GetMediaStripPrimaryTextColor(surface));
+  title_label_->SetVisible(!title_label_->GetText().empty());
+
+  UpdateStripControls({favicon_button_, previous_button_, play_pause_button_,
+                       next_button_, mute_button_},
+                      model, surface);
+  UpdatePanelBounds();
+  DeprecatedLayoutImmediately();
+  SchedulePaint();
+}
