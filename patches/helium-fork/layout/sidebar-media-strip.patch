+void VerticalTabStripRegionView::OnBoundsChanged(
+    const gfx::Rect& previous_bounds) {
+  BaseTabStripRegionView::OnBoundsChanged(previous_bounds);
+  // The strip's width gate (helium::kMediaStripMinWidth) rides the sidebar's
+  // drag-resize and collapse, both of which land here.
+  UpdateMediaStripVisibility();
+}
+
+void VerticalTabStripRegionView::OnMediaStripModelChanged() {
+  SyncMediaCapsules();
+  if (media_strip_) {
+    media_strip_->UpdateFromModel();
+  }
+  if (media_strip_panel_) {
+    media_strip_panel_->UpdateFromModel();
+  }
+  UpdateMediaStripVisibility();
+}
+
+void VerticalTabStripRegionView::SyncMediaCapsules() {
+  if (!media_strip_ || !media_strip_controller_ || !media_overlay_stack_) {
+    return;
+  }
+  const std::vector<const HeliumMediaStripModel*> rows =
+      media_strip_controller_->rows();
+  // The base capsule is the oldest session -- bind order is display order
+  // (rows never reshuffle), so rows[0] keeps its slot until it dies.
+  media_strip_->SetBoundItemId(rows.empty() ? std::string()
+                                            : rows[0]->item_id);
+  std::vector<std::string> ids;
+  for (size_t i = 1; i < rows.size(); ++i) {
+    ids.push_back(rows[i]->item_id);
+  }
+  if (ids != overlay_capsule_ids_) {
+    // Rebuild on membership change only, same rule as everything else here:
+    // metadata churn updates in place and a pressed button is never deleted
+    // under the pointer.
+    if (hovered_media_capsule_ && hovered_media_capsule_ != media_strip_) {
+      hovered_media_capsule_ = nullptr;
+    }
+    for (HeliumMediaStripView* capsule : overlay_capsules_) {
+      media_overlay_stack_->RemoveChildViewT(capsule);
+    }
+    for (HeliumCardShadowView* shadow : overlay_capsule_shadows_) {
+      media_overlay_stack_->RemoveChildViewT(shadow);
+    }
+    overlay_capsules_.clear();
+    overlay_capsule_shadows_.clear();
+    for (const std::string& id : ids) {
+      // Shadow first, capsule second: the pair's paint order within the
+      // stack puts every ring under every card body.
+      HeliumCardShadowView* shadow = media_overlay_stack_->AddChildView(
+          std::make_unique<HeliumCardShadowView>());
+      shadow->SetVisible(false);
+      overlay_capsule_shadows_.push_back(shadow);
+      HeliumMediaStripView* capsule = media_overlay_stack_->AddChildView(
+          std::make_unique<HeliumMediaStripView>(
+              media_strip_controller_.get(),
+              base::BindRepeating(
+                  [](VerticalTabStripRegionView* region,
+                     size_t capsule_index) {
+                    if (capsule_index < region->overlay_capsules_.size()) {
+                      region->OnMediaCapsuleHovered(
+                          region->overlay_capsules_[capsule_index]);
+                    }
+                  },
+                  base::Unretained(this), overlay_capsules_.size())));
+      capsule->SetBoundItemId(id);
+      capsule->SetShadowFrame(shadow);
+      overlay_capsules_.push_back(capsule);
+    }
+    overlay_capsule_ids_ = ids;
+    InvalidateLayout();
+  }
+  for (HeliumMediaStripView* capsule : overlay_capsules_) {
+    capsule->UpdateFromModel();
+  }
+}
+
+size_t VerticalTabStripRegionView::HoveredMediaCapsuleIndex() const {
+  if (!hovered_media_capsule_) {
+    return helium::kMediaStripNoHover;
+  }
+  if (hovered_media_capsule_ == media_strip_) {
+    return 0;
+  }
+  for (size_t i = 0; i < overlay_capsules_.size(); ++i) {
+    if (overlay_capsules_[i] == hovered_media_capsule_) {
+      return i + 1;
+    }
+  }
+  return helium::kMediaStripNoHover;
+}
+
+int VerticalTabStripRegionView::MaxMediaPanelHeightFor(
+    const gfx::Rect& anchor,
+    size_t hovered_index) const {
+  // Up to the bottom of the address row, minus one stacked slot for every
+  // capsule the panel is about to push up: the panel may never overlap the
+  // row or the caption area, and neither may the capsules it displaces.
+  const int ceiling =
+      arc_top_container_ ? arc_top_container_->bounds().bottom() : 0;
+  return helium::MediaStripMaxPanelHeight(
+      std::max(0, anchor.bottom() - ceiling),
+      static_cast<int>(overlay_capsules_.size()), hovered_index);
+}
+
+void VerticalTabStripRegionView::LayoutMediaStack() {
+  if (!media_strip_ || !media_overlay_stack_) {
+    return;
+  }
+  const gfx::Rect strip = media_strip_->bounds();
+  // The floating stack rides directly above the base capsule, one 33pt card
+  // per extra session, stack-gapped -- plus, while a panel is open, the
+  // panel's own growth for every capsule above the hovered one. That is what
+  // keeps an expanding panel from covering its neighbours (user 2026-08-20);
+  // feeding it the panel's *live* height puts the slide on the panel's tween.
+  const size_t hovered = HoveredMediaCapsuleIndex();
+  const int panel_height = media_strip_panel_
+                               ? media_strip_panel_->panel_height()
+                               : helium::kMediaStripRowHeight;
+  const int stack_height = helium::MediaStripOverlayStackHeight(
+      static_cast<int>(overlay_capsules_.size()), hovered, panel_height);
+  media_overlay_stack_->SetBounds(strip.x(), strip.y() - stack_height,
+                                  strip.width(), stack_height);
+  for (size_t i = 0; i < overlay_capsules_.size(); ++i) {
+    const int local_y =
+        stack_height - helium::MediaStripCapsuleOffsetFromBase(
+                           i + 1, hovered, panel_height);
+    overlay_capsules_[i]->SetBounds(0, local_y, strip.width(),
+                                    helium::kMediaStripRowHeight);
+  }
+  if (media_scrim_) {
+    // The scrim covers the whole floating zone plus its fade band above,
+    // full sidebar width so the rows' own margins dissolve with them. An
+    // open panel that reaches higher than the stack extends it.
+    int top = strip.y() - stack_height;
+    if (!overlay_capsules_.empty() && media_strip_panel_ &&
+        media_strip_panel_->GetVisible()) {
+      top = std::min(top, media_strip_panel_->bounds().y());
+    }
+    const int scrim_top = top - helium::kMediaScrimFadeHeight;
+    media_scrim_->SetBounds(0, scrim_top, width(),
+                            std::max(0, strip.y() - scrim_top));
+  }
+}
+
+gfx::Rect VerticalTabStripRegionView::CapsuleBoundsInRegion(
+    const HeliumMediaStripView* capsule) const {
+  if (!capsule) {
+    return gfx::Rect();
+  }
+  if (capsule == media_strip_) {
+    return capsule->bounds();
+  }
+  gfx::Rect bounds = capsule->bounds();
+  if (media_overlay_stack_) {
+    bounds.Offset(media_overlay_stack_->bounds().OffsetFromOrigin());
+  }
+  return bounds;
+}
+
+bool VerticalTabStripRegionView::AnyMediaAreaHovered() const {
+  if (media_strip_panel_ && media_strip_panel_->IsMouseHovered()) {
+    return true;
+  }
+  if (media_strip_ && media_strip_->IsMouseHovered()) {
+    return true;
+  }
+  for (const HeliumMediaStripView* capsule : overlay_capsules_) {
+    if (capsule->IsMouseHovered()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void VerticalTabStripRegionView::OnMediaCapsuleHovered(
+    HeliumMediaStripView* capsule) {
+  if (!capsule || !media_strip_panel_) {
+    return;
+  }
+  hovered_media_capsule_ = capsule;
+  media_strip_panel_->SetBoundItemId(capsule->bound_item_id());
+  const gfx::Rect anchor = CapsuleBoundsInRegion(capsule);
+  media_strip_panel_->SetAnchor(
+      anchor, MaxMediaPanelHeightFor(anchor, HoveredMediaCapsuleIndex()));
+  SetMediaStripExpanded(true);
+}
+
+void VerticalTabStripRegionView::UpdateMediaStripVisibility() {
+  if (!media_strip_ || !media_strip_controller_) {
+    return;
+  }
+  const int strip_width =
+      width() - 2 * GetLayoutConstant(
+                        LayoutConstant::kVerticalTabStripHorizontalPadding);
+  const bool shown = helium::ShouldShowSidebarMediaStrip(
+      media_strip_controller_->ready_row_count(), strip_width);
+  media_strip_->SetShown(shown);
+  // The floating half: capsules for sessions beyond the first, plus the
+  // scrim under them -- one shown flag, one trigger frame, one 200ms fade
+  // for all of it (M3.3h).
+  const bool stack_shown = shown && !overlay_capsules_.empty();
+  if (media_overlay_stack_) {
+    media_overlay_stack_->SetVisible(stack_shown);
+  }
+  for (HeliumMediaStripView* capsule : overlay_capsules_) {
+    capsule->SetShown(stack_shown);
+  }
+  if (media_scrim_) {
+    media_scrim_->SetShown(stack_shown);
+  }
+  if (!shown) {
+    SetMediaStripExpanded(false);
+  }
+}
+
+void VerticalTabStripRegionView::SetMediaStripExpanded(bool expanded) {
+  if (!media_strip_panel_) {
+    return;
+  }
+  if (expanded && (!media_strip_ || !media_strip_->shown())) {
+    return;
+  }
+  if (media_strip_panel_->expanded() == expanded) {
+    return;
+  }
+  media_strip_panel_->SetExpanded(expanded);
+  if (expanded) {
+    // Hovering the panel must not also flip the collapsed sidebar's
+    // expand-on-hover state under it.
+    if (!media_strip_hover_lock_) {
+      media_strip_hover_lock_ =
+          GetExpandOnHoverLock(ExpandOnHoverLockType::kKeepCurrentState);
+    }
+  } else {
+    media_strip_hover_lock_.reset();
+  }
+}
+
+void VerticalTabStripRegionView::OnMediaStripPointerLeft() {
+  // Leaving one media view is only leaving the media *area* if the cursor is
+  // on none of them; IsMouseHovered() re-checks against the live cursor, so
+  // a stray or swallowed exit event costs nothing.
+  if (AnyMediaAreaHovered()) {
+    return;
+  }
+  if (media_strip_panel_ && media_strip_panel_->expanded()) {
+    SetMediaStripExpanded(false);
+  }
+  // hovered_media_capsule_ deliberately stays set until the collapse tween
