+void HeliumMediaStripController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  // Any structural change can move a playing tab into or out of this window
+  // -- and a tab dragged *in* arrives with its item already in the
+  // profile-wide manager, so OnItemListChanged never fires for it. Rescan on
+  // everything; it is a handful of id lookups.
+  RescanItems();
+  NotifyModelChanged();
+}
+
+void HeliumMediaStripController::OnFocusGained(
+    media_session::mojom::AudioFocusRequestStatePtr state) {
+  if (!state || !state->request_id.has_value()) {
+    return;
+  }
+  if (SessionRow* const row = FindRow(state->request_id->ToString())) {
+    // Back within the grace window -- native calls this unfreezing.
+    row->CancelFocusLostGrace();
+  }
+}
+
+void HeliumMediaStripController::OnFocusLost(
+    media_session::mojom::AudioFocusRequestStatePtr state) {
+  if (!state || !state->request_id.has_value()) {
+    return;
+  }
+  if (SessionRow* const row = FindRow(state->request_id->ToString())) {
+    row->StartFocusLostGrace();
+  }
+}
+
+void HeliumMediaStripController::OnRequestIdReleased(
+    const base::UnguessableToken& request_id) {
+  // The session is gone for good; no point waiting out the grace period.
+  if (SessionRow* const row = FindRow(request_id.ToString())) {
+    RemoveRow(row);  // Deletes |row|.
+  }
+}
+
+void HeliumMediaStripController::RescanItems() {
+  if (!item_manager_) {
+    return;
+  }
+  const std::list<std::string> id_list = item_manager_->GetActiveItemIds();
+  const std::vector<std::string> ids(id_list.begin(), id_list.end());
+
+  // Forget dismissals whose sessions are gone, so the same site playing
+  // again later is a fresh item.
+  base::flat_set<std::string> still_active_dismissed;
+  for (const std::string& id : ids) {
+    if (dismissed_item_ids_.contains(id)) {
+      still_active_dismissed.insert(id);
+    }
+  }
+  dismissed_item_ids_ = std::move(still_active_dismissed);
+
+  TabStripModel* const tab_strip_model = browser_->tab_strip_model();
+  std::vector<helium::MediaStripItemFacts> facts;
+  facts.reserve(ids.size());
+  for (const std::string& id : ids) {
+    content::WebContents* const contents = WebContentsForItem(id);
+    helium::MediaStripItemFacts item;
+    // Cast/presentation items have no WebContents and fall out here; the
+    // strip is session media only (v1).
+    item.in_this_window = contents &&
+                          tab_strip_model->GetIndexOfWebContents(contents) !=
+                              TabStripModel::kNoTab;
+    item.dismissed = dismissed_item_ids_.contains(id);
+    facts.push_back(item);
+  }
+
+  // Bind rows for new eligible items. Append order is display order; an
+  // already-bound row just stays where it is (stickiness: the list decides
+  // who joins, the four end-of-life signals decide who leaves).
+  if (controller_manager_) {
+    for (const int index : helium::SelectMediaStripItems(facts)) {
+      const std::string& id = ids[static_cast<size_t>(index)];
+      if (!FindRow(id)) {
+        rows_.push_back(std::make_unique<SessionRow>(
+            this, id, WebContentsForItem(id), controller_manager_.get()));
+      }
+    }
+  }
+
+  // Rebind rows whose items came back to the active list (see
+  // SessionRow::SetInActiveList).
+  const base::flat_set<std::string> active_ids(ids.begin(), ids.end());
+  for (const std::unique_ptr<SessionRow>& row : rows_) {
+    row->SetInActiveList(active_ids.contains(row->model().item_id),
+                         controller_manager_.get());
+  }
+
+  // The one membership signal the sessions cannot deliver themselves: the
+  // tab left this window (detached, not destroyed).
+  std::erase_if(rows_, [tab_strip_model](
+                           const std::unique_ptr<SessionRow>& row) {
+    content::WebContents* const contents = row->web_contents();
+    return !contents || tab_strip_model->GetIndexOfWebContents(contents) ==
+                            TabStripModel::kNoTab;
+  });
+}
+
+HeliumMediaStripController::SessionRow* HeliumMediaStripController::FindRow(
+    const std::string& item_id) const {
+  if (item_id.empty()) {
+    return nullptr;
+  }
+  for (const std::unique_ptr<SessionRow>& row : rows_) {
+    if (row->model().item_id == item_id) {
+      return row.get();
+    }
+  }
+  return nullptr;
+}
+
+void HeliumMediaStripController::RemoveRow(SessionRow* row) {
+  const auto it = std::find_if(
+      rows_.begin(), rows_.end(),
+      [row](const std::unique_ptr<SessionRow>& owned) {
+        return owned.get() == row;
+      });
+  if (it == rows_.end()) {
+    return;
+  }
+  rows_.erase(it);
+  NotifyModelChanged();
+}
+
+void HeliumMediaStripController::NotifyModelChanged() {
+  if (on_model_changed_) {
+    on_model_changed_.Run();
+  }
+}
