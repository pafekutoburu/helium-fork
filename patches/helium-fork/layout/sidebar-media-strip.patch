+
+void HeliumMediaStripExpandedView::Layout(PassKey) {
+  const int panel_width = width();
+  const int panel_height = height();
+  // Rows anchor to the *bottom*, so the controls stay put over the capsule
+  // they grew out of and the header slides into view as the panel rises.
+  const int controls_top = panel_height - helium::kMediaStripRowHeight;
+  LayoutStripControls({favicon_button_, previous_button_, play_pause_button_,
+                       next_button_, mute_button_},
+                      panel_width,
+                      controls_top + helium::kMediaStripRowHeight / 2);
+
+  const bool has_metadata = title_label_->GetVisible();
+  const int metadata_top =
+      controls_top - (has_metadata ? helium::kMediaStripMetadataRowHeight : 0);
+  if (has_metadata) {
+    const int text_x = helium::kMediaStripHeaderLeftInset;
+    const int text_width =
+        std::max(0, panel_width - 2 * helium::kMediaStripHeaderLeftInset);
+    // Centered in its 33pt row -- the tab capsule's own text rhythm (~8pt of
+    // air), which is what the user asked the media text to match.
+    title_label_->SetBounds(
+        text_x, metadata_top + (helium::kMediaStripMetadataRowHeight - 17) / 2,
+        text_width, 17);
+  }
+
+  const int header_top = metadata_top - helium::kMediaStripRowHeight;
+  const int header_center_y = header_top + helium::kMediaStripRowHeight / 2;
+  CenterViewAt(close_button_,
+               panel_width - helium::kMediaStripCloseCenterFromRight,
+               header_center_y, helium::kMediaStripRowHeight - 4);
+  CenterViewAt(pip_button_,
+               panel_width - helium::kMediaStripPipCenterFromRight,
+               header_center_y, helium::kMediaStripRowHeight - 4);
+  const int site_width =
+      std::max(0, panel_width - helium::kMediaStripHeaderLeftInset -
+                      (helium::kMediaStripPipCenterFromRight +
+                       helium::kMediaStripRowHeight / 2));
+  site_label_->SetBounds(helium::kMediaStripHeaderLeftInset, header_top + 7,
+                         site_width, helium::kMediaStripRowHeight - 14);
+}
+
+void HeliumMediaStripExpandedView::OnPaintBackground(gfx::Canvas* canvas) {
+  PaintStripSurface(canvas, GetLocalBounds(), SurfaceColor());
+}
