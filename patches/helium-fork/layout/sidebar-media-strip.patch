+// helium-fork: the faces of the sidebar's bottom media area. Geometry and
+// colors all come from chrome/browser/ui/helium/arc_media_strip.h; the data
+// comes as HeliumMediaStripModel rows pushed by the controller. The region
+// view owns every one of these and decides when each is on screen.
+//
+// r5 (user-chosen 2026-08-20): one capsule *per session*, stacked upward --
+// the oldest session keeps the original pill's place in the layout flow, and
+// every later one floats above it as an overlay over the tab rows (a scrim
+// fades the rows out underneath, so the list never reflows when sessions
+// come and go). Hovering a capsule expands *that* capsule into the panel,
+// which is where its picture-in-picture and close buttons live. The r4
+// multi-session list is gone.
+
+// One session's capsule: [favicon | previous | play-pause | next | mute].
+// Which session is this capsule's business is bound by the region's sync
+// (SetBoundItemId); every button resolves the id at press time, so a rebind
+// never fires an action at the wrong tab.
+class HeliumMediaStripView : public views::View,
+                             public views::AnimationDelegateViews {
+  METADATA_HEADER(HeliumMediaStripView, views::View)
+
+ public:
+  // `on_hovered` fires with this view as sender context (the region binds a
+  // closure per capsule).
+  HeliumMediaStripView(HeliumMediaStripController* controller,
+                       base::RepeatingClosure on_hovered);
+  HeliumMediaStripView(const HeliumMediaStripView&) = delete;
+  HeliumMediaStripView& operator=(const HeliumMediaStripView&) = delete;
+  ~HeliumMediaStripView() override;
+
+  // Binds this capsule to one session. Empty id = follow the controller's
+  // primary (first ready) row, which is what the base capsule does.
+  void SetBoundItemId(const std::string& item_id);
+  const std::string& bound_item_id() const { return bound_item_id_; }
+  // The bound row's live model, or the primary row when unbound/gone.
+  const HeliumMediaStripModel& BoundRow() const;
+
+  void UpdateFromModel();
+  // Fades the pill in or out; visibility flips at the fade's ends so the
+  // layout only ever changes once per appearance.
+  void SetShown(bool shown);
+  bool shown() const { return shown_; }
+
+  // The card's shadow: a sibling HeliumCardShadowView (region-owned for the
+  // base capsule, stack-owned for overlay capsules -- either way the shadow
+  // and this view share a parent, so bounds() carries over unchanged). Its
+  // layer does not ride this view's fading layer, so this view drives its
+  // bounds, visibility and opacity by hand.
+  void SetShadowFrame(HeliumCardShadowView* shadow_frame);
+
+  // views::View:
+  void Layout(PassKey) override;
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void OnPaintBackground(gfx::Canvas* canvas) override;
+  void OnMouseEntered(const ui::MouseEvent& event) override;
+  void OnThemeChanged() override;
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override;
+
+  // views::AnimationDelegateViews:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+ private:
+  SkColor SurfaceColor() const;
+  void SyncShadow();
+  // A strip button acting on this capsule's bound row, id resolved at press.
+  using ControllerAction =
+      void (HeliumMediaStripController::*)(const std::string&);
+  base::RepeatingClosure BoundAction(ControllerAction action);
+
+  const raw_ptr<HeliumMediaStripController> controller_;
+  const base::RepeatingClosure on_hovered_;
+  std::string bound_item_id_;
+
+  raw_ptr<views::ImageButton> favicon_button_ = nullptr;
+  raw_ptr<views::ImageButton> previous_button_ = nullptr;
+  raw_ptr<views::ImageButton> play_pause_button_ = nullptr;
+  raw_ptr<views::ImageButton> next_button_ = nullptr;
+  raw_ptr<views::ImageButton> mute_button_ = nullptr;
+
+  raw_ptr<HeliumCardShadowView> shadow_frame_ = nullptr;
+
+  bool shown_ = false;
+  gfx::SlideAnimation shown_animation_{this};
+};
+
+// The hover panel of one capsule: header (site name, picture-in-picture,
+// close), the single-line title row, the controls row -- grown *upward* out
+// of the hovered capsule, bottom edge pinned. An overlay child (ignored by
+// layout, manual bounds); the tab list never reflows. Bound to the hovered
+// capsule's session via SetBoundItemId, same resolution rules as the
+// capsule's.
+class HeliumMediaStripExpandedView : public views::View,
+                                     public views::AnimationDelegateViews {
+  METADATA_HEADER(HeliumMediaStripExpandedView, views::View)
+
+ public:
+  // `on_bounds_changed` fires on every frame of the expand tween, so the
+  // region can slide the capsules above this panel out of its way on the
+  // same timeline (r6; without it an opening panel covers its neighbours).
+  HeliumMediaStripExpandedView(HeliumMediaStripController* controller,
+                               base::RepeatingClosure on_pointer_left,
+                               base::RepeatingClosure on_bounds_changed);
+  HeliumMediaStripExpandedView(const HeliumMediaStripExpandedView&) = delete;
