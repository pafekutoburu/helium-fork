+HeliumMediaScrimView::HeliumMediaScrimView()
+    : views::AnimationDelegateViews(this) {
+  // Never interactive: the tab rows dissolving under it stay clickable while
+  // they are still readable, and the capsules above it take their own hits.
+  SetCanProcessEventsWithinSubtree(false);
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  layer()->SetOpacity(0.0f);
+  SetVisible(false);
+  shown_animation_.SetSlideDuration(base::Milliseconds(200));
+}
