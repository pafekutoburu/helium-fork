+// The fade behind the floating capsules: sidebar-colored, transparent at its
+// top edge and solid from the fade band down, so tab rows dissolve before
+// they reach the stack instead of colliding with it (user 2026-08-20). Not
+// interactive; its opacity is driven by the region alongside the overlay
+// stack's own fade so the two can never appear apart (M3.3h).
+class HeliumMediaScrimView : public views::View,
+                            public views::AnimationDelegateViews {
+  METADATA_HEADER(HeliumMediaScrimView, views::View)
+
+ public:
+  HeliumMediaScrimView();
+  HeliumMediaScrimView(const HeliumMediaScrimView&) = delete;
+  HeliumMediaScrimView& operator=(const HeliumMediaScrimView&) = delete;
+  ~HeliumMediaScrimView() override;
+
+  // Same 200ms opacity fade as the capsules, triggered on the same frame --
+  // scrim and stack appear and disappear as one move (M3.3h).
+  void SetShown(bool shown);
+  bool shown() const { return shown_; }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+
+  // views::AnimationDelegateViews:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+ private:
+  bool shown_ = false;
+  gfx::SlideAnimation shown_animation_{this};
+};
