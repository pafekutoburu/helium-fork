+
+void HeliumMediaStripView::AnimationEnded(const gfx::Animation* animation) {
+  layer()->SetOpacity(static_cast<float>(animation->GetCurrentValue()));
+  if (animation->GetCurrentValue() == 0.0) {
+    SetVisible(false);
+  }
+  SyncShadow();
