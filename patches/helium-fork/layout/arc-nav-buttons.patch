+bool BrowserView::IsArcSidebarTopRowOnScreen() const {
+  // helium-fork: whether the sidebar's top row is somewhere the user can see
+  // and click it. Docked, obviously; and also while the hidden sidebar is
+  // revealed as a floating card, which is the case the collapse button used to
+  // fall through -- it went back to the toolbar the moment the sidebar hid, so
+  // the hover-revealed card came up with an empty top row and the Favorites
+  // placeholder sitting directly under the traffic lights.
+  //
+  // A commanded hide is the exception. There the layout flips to the collapsed
+  // geometry in one atomic step and the card then slides out *over* it, so the
+  // reveal ratio stays at 1 for the whole 200ms slide -- which left the four
+  // controls in the departing card while the toolbar had already moved to its
+  // collapsed x. The URL sat at a third position for the length of the slide
+  // and jumped again when they finally arrived: "cmd+s 开合，域名的位置会闪…
+  // 中间有跳动". The hand-off belongs in the same atomic flip as the geometry;
+  // the card is on its way off screen and nobody reads its top row. Only
+  // kSliding is tested, so the hover-revealed card above is untouched.
+  if (sidebar_toggle_phase_ == SidebarTogglePhase::kSliding) {
+    return false;
+  }
+  auto* const controller =
+      tabs::VerticalTabStripStateController::From(browser_);
+  if (!controller || !controller->ShouldDisplayVerticalTabs() ||
+      !GetIsNormalType()) {
+    return false;
+  }
+  return !IsSidebarHiddenModeActive() || GetSideChromeRevealRatio() > 0.0f;
 }
 
