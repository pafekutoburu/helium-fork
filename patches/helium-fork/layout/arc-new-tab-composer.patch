@@ -0,0 +1,35 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/arc_composer_host_view.h"
+
+#include "chrome/browser/ui/helium/arc_composer.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/compositor/layer.h"
+
+ArcComposerHostView::ArcComposerHostView() {
+  // A layer of its own so the field composites above the panel's card, which
+  // is itself layer-backed; a view without one paints into the shared parent
+  // layer, which is *below* every layer-backed sibling whatever the child
+  // order says. (The same trap ArcOmniboxPanelView's comment records.)
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  SetVisible(false);
+}
+
+ArcComposerHostView::~ArcComposerHostView() = default;
+
+void ArcComposerHostView::Layout(PassKey) {
+  // One child, and the geometry is the shell's, not a layout manager's: the
+  // row is centred in the box by helium::ArcComposerFieldBounds() so the two
+  // rectangles cannot be derived twice.
+  if (children().empty()) {
+    return;
+  }
+  children().front()->SetBoundsRect(
+      helium::ArcComposerFieldBounds(GetLocalBounds()));
+}
+
+BEGIN_METADATA(ArcComposerHostView)
+END_METADATA
