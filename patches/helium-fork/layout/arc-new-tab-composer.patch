--- /dev/null
+++ src/chrome/browser/ui/helium/arc_composer_unittest.cc
@@ -0,0 +1,250 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_composer.h"
+
+#include <cstdlib>
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace helium {
+namespace {
+
+// The measured baseline: our own window at 1728x1084 with the default sidebar,
+// where MultiContentsView reads (261,37) 1467x1047 -- the numbers the acceptance
+// probe checks against.
+constexpr int kWindowHeight = 1084;
+constexpr gfx::Rect kContentArea(261, 37, 1467, 1047);
+
+gfx::Rect Box() {
+  return ArcComposerBounds(kContentArea, kWindowHeight);
+}
+
+// The three numbers the user ruled on, pinned so a later "tidy-up" cannot
+// quietly drift them.
+TEST(ArcComposerTest, BoxIsTheMeasuredSize) {
+  EXPECT_EQ(651, Box().width());
+  EXPECT_EQ(57, Box().height());
+  // The box's BOTTOM EDGE is the anchor, and it lands HALF A BOX above the
+  // content area's half-way line -- see TheBoxesBottomEdgeSitsHalfABoxHigh.
+  EXPECT_EQ(kContentArea.y() + kContentArea.height() / 2 -
+                kArcComposerFieldHeight / 2,
+            Box().bottom());
+}
+
+// The width is a constant, NOT a fraction of the content area (r8.4 reversal;
+// r8.3 read `Dia:`'s single measurement as a ratio and the shrink at narrow
+// windows was the first thing the user cut). Widening the window past the
+// crossover must not widen the box by a single point.
+TEST(ArcComposerTest, WidthIsConstantUntilTheContentAreaRunsOut) {
+  for (int content_width : {700, 1139, 1467, 2200}) {
+    const gfx::Rect content(261, 37, content_width, 1047);
+    SCOPED_TRACE(testing::Message() << "content_width=" << content_width);
+    EXPECT_EQ(kArcComposerWidth,
+              ArcComposerBounds(content, kWindowHeight).width());
+  }
+}
+
+// "当网页的窗口缩小到搜索框固定宽度之后继续缩小的时候,搜索框的宽度才开始变小"
+// -- below the crossover it gives way, keeping kArcComposerMinSideMargin a
+// side, and it never outgrows the content area it sits in.
+TEST(ArcComposerTest, WidthGivesWayOnlyBelowTheCrossover) {
+  constexpr int kCrossover = kArcComposerWidth + 2 * kArcComposerMinSideMargin;
+  EXPECT_EQ(kArcComposerWidth,
+            ArcComposerBounds(gfx::Rect(0, 0, kCrossover, 1047), kWindowHeight)
+                .width());
+
+  int previous = kArcComposerWidth;
+  for (int content_width : {kCrossover - 1, 600, 500, 400}) {
+    const gfx::Rect content(0, 0, content_width, 1047);
+    const gfx::Rect box = ArcComposerBounds(content, kWindowHeight);
+    SCOPED_TRACE(testing::Message() << "content_width=" << content_width);
+    EXPECT_EQ(content_width - 2 * kArcComposerMinSideMargin, box.width());
+    EXPECT_LT(box.width(), previous);
+    previous = box.width();
+  }
+
+  // The floor keeps a transient sliver of a content area from producing a
+  // negative width, and the box never spills out of the content area.
+  for (int content_width : {200, 40, 1}) {
+    const gfx::Rect content(0, 0, content_width, 1047);
+    const gfx::Rect box = ArcComposerBounds(content, kWindowHeight);
+    SCOPED_TRACE(testing::Message() << "content_width=" << content_width);
+    EXPECT_GT(box.width(), 0);
+    EXPECT_LE(box.width(), content_width);
+  }
+}
+
+// The height is the row plus its padding and nothing else -- it does not move
+// with the width, and it does not carry Dia's two-row proportion. r8.3 did
+// carry it, which put a 44pt row in the middle of a 114pt card: "搜索胶囊在这个
+// 悬浮面板的中间很奇怪" (user 2026-08-21).
+TEST(ArcComposerTest, HeightIsTheSolveLessFivePerCent) {
+  // The solve: height is icon + 2*margin, and the margin is the column the
+  // suggestion rows put their icons in -- `Dia:`'s 21.5, taken as 22 (measured
+  // 2026-08-22; r8.5 used Chromium's stock 13 and the box came out too flat).
+  constexpr int kSolved = kArcComposerIconSize + 2 * kArcComposerIconInset;
+  EXPECT_EQ(60, kSolved);
+  // ...and then r8.6b's five per cent off it by hand ("输入框的高度在现在的基础
+  // 上矮百分之五", user 2026-08-22). Pinned as the arithmetic rather than as a
+  // literal so that moving the icon column still moves the box.
+  EXPECT_EQ(kSolved * 95 / 100, kArcComposerFieldHeight);
+  for (int content_width : {400, 839, 1467, 2200}) {
+    const gfx::Rect box = ArcComposerBounds(
+        gfx::Rect(261, 37, content_width, 1047), kWindowHeight);
+    SCOPED_TRACE(testing::Message() << "content_width=" << content_width);
+    EXPECT_EQ(kArcComposerFieldHeight, box.height());
+  }
+}
+
+// The leading icon lands in the suggestion list's column: the field's own
+// inset gives back exactly the 6pt LocationBarView + LocationIconView put in
+// front of the glyph.
+TEST(ArcComposerTest, LeadingIconLandsInTheListsColumn) {
+  const gfx::Rect box = Box();
+  const gfx::Rect field = ArcComposerFieldBounds(box);
+  const int glyph_left =
+      field.x() + kArcComposerFieldLeadingIconOffset - box.x();
+  EXPECT_EQ(kArcComposerIconInset, glyph_left);
+  // ⚠ The margin above and below is NO LONGER the same number -- r8.6b's five
+  // per cent came off the height alone, so the glyph clears 22 to its left and
+  // (57-16)/2 = 20 above and below. `Dia:` holds all three equal (29.75/30.0,
+  // measured 2026-08-22); this is the one place we knowingly do not. Pinned so
+  // the gap stays exactly this and does not widen unnoticed.
+  EXPECT_EQ(20, (field.height() - kArcComposerIconSize) / 2);
+  EXPECT_EQ(2, kArcComposerIconInset -
+                   (field.height() - kArcComposerIconSize) / 2);
+}
+
+// Centred on the content area, not on the window. `Dia:` its centre landed
+// 2.3pt off the content area's and 134.5pt off the window's -- that difference
+// is the sidebar, and it is the whole reason this takes a content rect.
+TEST(ArcComposerTest, CentredOnTheContentAreaNotTheWindow) {
+  const gfx::Rect box = Box();
+  EXPECT_LE(std::abs(kContentArea.CenterPoint().x() - box.CenterPoint().x()), 1);
+  EXPECT_NE(kWindowHeight, box.y());
+  // The window's own centre is 864; the content area's is 994.
+  EXPECT_GT(box.CenterPoint().x(), 1728 / 2);
+}
+
+// The whole group lives in the TOP HALF and then some: r8.6a put the box's
+// bottom edge on the half-way line ("面板最下沿刚好在垂直高度的百分之五十处"),
+// and r8.6b lifted the pair another half box off it ("中央框和logo这个整体UI，
+// 这两个元素整体再往上走，差不多输入框高度的一半", user 2026-08-22). The band
+// moving means the page moves and the group goes with it -- that is the point
+// of measuring against the content area rather than the window.
+TEST(ArcComposerTest, TheBoxesBottomEdgeSitsHalfABoxHigh) {
+  for (int band_height : {0, 34}) {
+    const gfx::Rect content(261, 3 + band_height, 1467,
+                            kWindowHeight - 3 - band_height);
+    const gfx::Rect box = ArcComposerBounds(content, kWindowHeight);
+    const gfx::Rect logo = ArcComposerLogoBounds(box);
+    SCOPED_TRACE(testing::Message() << "band_height=" << band_height);
+    const int half = content.y() + content.height() / 2;
+    EXPECT_EQ(half - kArcComposerFieldHeight / 2, box.bottom());
+    // ...and therefore every last point of ink clears that line by half a box.
+    EXPECT_LT(logo.y(), half);
+    EXPECT_LT(box.bottom(), half);
+  }
+}
+
+// One row, at the TOP of the box, inset a side. It is the first row, not the
+// only possible row: "它应该是在靠上第一行的位置" (user 2026-08-21). With the
+// box sized to the row the padding above and below happens to match, and that
+// is the intended reading -- but the anchor is the top edge.
+TEST(ArcComposerTest, FieldRowIsTheFirstRow) {
+  const gfx::Rect box = Box();
+  const gfx::Rect field = ArcComposerFieldBounds(box);
+  EXPECT_EQ(kArcComposerFieldHeight, field.height());
+  EXPECT_EQ(box.width() - 2 * kArcComposerFieldInset, field.width());
+  EXPECT_EQ(box.x() + kArcComposerFieldInset, field.x());
+  EXPECT_EQ(box.y(), field.y());
+  EXPECT_TRUE(box.Contains(field));
+
+  // A taller box (the day a second row lands) leaves the first row where it
+  // is rather than re-centring it.
+  gfx::Rect two_rows = box;
+  two_rows.set_height(box.height() + 40);
+  EXPECT_EQ(box.y(), ArcComposerFieldBounds(two_rows).y());
+}
+
+// The mark above the box: `Dia:` measured 2026-08-21 as centred on the card to
+// within 0.05pt with 29.5pt of clear air under it.
+TEST(ArcComposerTest, LogoSitsAboveTheBoxAndCentredOnIt) {
+  const gfx::Rect box = Box();
+  const gfx::Rect logo = ArcComposerLogoBounds(box);
+  EXPECT_EQ(kArcComposerLogoSize, logo.width());
+  EXPECT_EQ(kArcComposerLogoSize, logo.height());
+  EXPECT_LE(std::abs(box.CenterPoint().x() - logo.CenterPoint().x()), 1);
+  EXPECT_EQ(kArcComposerLogoGap, box.y() - logo.bottom());
+  EXPECT_FALSE(logo.Intersects(box));
+  EXPECT_TRUE(ArcComposerLogoBounds(gfx::Rect()).IsEmpty());
+}
+
+// The row is meaningfully taller than the band's capsule -- "在 new tab 中，
+// 这个搜索框是主要视觉，它不能太小" (user 2026-08-21). 28 is the band's
+// kLocationBarHeight.
+TEST(ArcComposerTest, FieldRowIsTallerThanTheBandCapsule) {
+  EXPECT_GT(kArcComposerFieldHeight, 28);
+  // r8.6b: 57 -- the r8.6 solve of 60 less the user's five per cent, see
+  // HeightIsTheSolveLessFivePerCent. Pinned here too so a change to either
+  // input has to come past both tests. `Dia:` reads 59.5 for the untrimmed
+  // solve (icon centre 29.75 from the card's left edge and 30.0 from its top,
+  // measured 2026-08-22).
+  EXPECT_EQ(57, kArcComposerFieldHeight);
+}
+
+// The list is the other half of the height solve, and this is the invariant
+// that binds them: `Dia:` measured 2026-08-22 puts its suggestion favicons in
+// the SAME column as its input row's magnifier (21.5pt off the card's left
+// edge), in a 36pt band inside a 40pt pitch, text at 50.5. Let the list's
+// column drift from the box's and the box's height stops being a solution.
+TEST(ArcComposerTest, TheListStandsInTheBoxesColumn) {
+  EXPECT_EQ(kArcComposerIconInset, kArcComposerListIconInset);
+  EXPECT_EQ(36, kArcComposerListRowHeight);
+  EXPECT_EQ(8, kArcComposerListRowInset);
+  EXPECT_EQ(50, kArcComposerListTextInset);
+  EXPECT_EQ(40, kArcComposerListRowPitch);
+  // The proportion the user rejected from both ends: r8.4's 68/30 = 2.27 was
+  // "很不协调" and r8.5's 42/30 = 1.4 was "过矮". `Dia:` runs 59.5/40 = 1.49;
+  // r8.6 landed on 1.50 and r8.6b's five per cent takes it to 57/40 = 1.425,
+  // which is the user's own trim and the one number here that is not Dia's.
+  EXPECT_NEAR(1.425,
+              static_cast<double>(kArcComposerFieldHeight) /
+                  kArcComposerListRowPitch,
+              0.02);
+}
+
+// And the cross-check that ties the two halves together the way the eye reads
+// them: `Dia:` measures 49.5pt from the magnifier's centre down to the first
+// suggestion's favicon centre (2026-08-22). Ours is the same arithmetic --
+// half a box, then the row gap, then half a band.
+TEST(ArcComposerTest, FirstSuggestionSitsWhereDiasDoes) {
+  const int field_icon_centre = kArcComposerFieldHeight / 2;
+  const int first_row_icon_centre = kArcComposerFieldHeight +
+                                    kArcComposerListRowGap +
+                                    kArcComposerListRowHeight / 2;
+  // r8.6 read 50 here against `Dia:`'s 49.5; r8.6b's shorter box lands on 49,
+  // i.e. half a point the other side of the same measurement.
+  EXPECT_EQ(49, first_row_icon_centre - field_icon_centre);
+  // And the box's own top margin above the glyph, which is the 20 that used to
+  // be 22 -- see LeadingIconLandsInTheListsColumn.
+  EXPECT_EQ(20, field_icon_centre - kArcComposerIconSize / 2);
+}
+
+// Degenerate inputs yield nothing rather than a stripe at the origin: both
+// happen before the first layout and during teardown.
+TEST(ArcComposerTest, DegenerateInputsYieldNothing) {
+  EXPECT_TRUE(ArcComposerBounds(gfx::Rect(), kWindowHeight).IsEmpty());
+  EXPECT_TRUE(ArcComposerBounds(kContentArea, 0).IsEmpty());
+  EXPECT_TRUE(ArcComposerFieldBounds(gfx::Rect()).IsEmpty());
+  // A box shorter than the row keeps the row inside it rather than
+  // overflowing -- the top inset gives way before the row does.
+  const gfx::Rect squat(0, 0, 200, 20);
+  EXPECT_TRUE(squat.Contains(ArcComposerFieldBounds(squat)));
+}
+
+}  // namespace
