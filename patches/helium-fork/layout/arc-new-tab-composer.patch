+  EXPECT_FALSE(ShouldHostFieldInComposer(/*shell_hosts_field=*/true,
+                                         /*blank_new_tab=*/false));
+}
+
+// The band never shows a capsule while the composer holds the field. ⚠ This is
+// only a statement about the band: since r8.4 ShouldShowArcBandField's
+// `band_hosted=false` (the sidebar row, a popup) answers "shown" while the
+// composer may still have taken the field, and reconciling those two is the
+// caller's job, from the fact of where the field actually is.
+TEST(ArcToolbarHostTest, TheBandNeverCompetesWithTheComposer) {
+  for (bool blank : {false, true}) {
+    SCOPED_TRACE(testing::Message() << "blank=" << blank);
