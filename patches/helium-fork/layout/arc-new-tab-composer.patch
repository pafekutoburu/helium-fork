Index: src/chrome/browser/ui/helium/arc_composer.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_composer.h
@@ -0,0 +1,311 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_COMPOSER_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_COMPOSER_H_
+
+#include <algorithm>
+
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/geometry/rect.h"
+
+// helium-fork: the geometry of the Arc shell's new tab composer -- the search
+// box that sits in the middle of a blank new tab and is the only place that
+// page has for typing.
+//
+// Why it exists at all, in the user's words (2026-08-21), because it is the
+// whole argument for the module and not a detail:
+//
+//   "我对 new tab 这个界面，把搜索框放到页面中央的理解，就是为了削弱顶部地址栏
+//    的存在。有了这个中央面板的存在之后，用户基本上百分之九十的时间都是在这个
+//    输入框去操作的……我实际在使用 arc/dia 中也是这个感受，几乎没有点击过顶部的
+//    地址栏。而且从实际使用中来讲，把搜索框放到页面的中央，当然是比每次把鼠标
+//    移到窗口最上部更方便。"
+//
+// So this is not a second address bar. It is THE address bar for that page:
+// the band's capsule is not merely hidden there, the field itself has moved
+// (see ShouldHostFieldInComposer in arc_toolbar_host.h), which is why Cmd+L
+// lands here and the band never flashes a capsule.
+//
+// `Dia:` measured 2026-08-21 (window 1728x1084pt, burst captures, screencapture
+// only): card 651x111 at radius ~20, horizontally centred on the CONTENT area
+// (not the window -- its centre landed 2.3pt off the content area's and 134.5pt
+// off the window's), card top at 33.5% of the window's height, white
+// (254,255,255). Typing does not move it: the box stays put and grows
+// downwards, 111 -> 379 at six suggestions.
+//
+// Three deliberate departures, all the user's (the first two restated at
+// r8.4 acceptance, 2026-08-21):
+//
+//   * `Dia:` has two rows -- the input, and an AI attachment bar ("+ Add tabs
+//     or files / ... / mic / Go"). We copy ONE (M3.5, restated 2026-08-21):
+//     every control on that row is a feature we do not have, so building it
+//     means a row of dead buttons.
+//   * And therefore NOT Dia's height. r8.3 kept Dia's 111/651 proportion even
+//     with one row, which at a wide window made a 114pt card with a 44pt row
+//     floating in the middle of it: "搜索胶囊在这个悬浮面板的中间很奇怪,它应该
+//     是在靠上第一行的位置。" The box is now the row plus its padding, full
+//     stop. When a second row does arrive, the height grows by that row -- the
+//     user's own framing: "以后需要做两行的时候再动高度吧".
+//   * The width is a CONSTANT, not a fraction of the content area (r8.4
+//     reversal of r8.3's ratio; the r8.3 acceptance list had flagged the
+//     narrow-window shrink as the price of the ratio and it was the first
+//     thing the user cut): "搜索框的宽度做成固定长度。当网页的窗口缩小到搜索框
+//     固定宽度之后继续缩小的时候,搜索框的宽度才开始变小。"
+//
+// Header-only and free of //ui/views so it can be linked into the lightweight
+// test target (see PROGRESS.md on why anything reaching TestingProfile cannot
+// be built in this tree).
+namespace helium {
+
+// The box's width. `Dia:` measured 651 at a 1728pt window and we take that
+// literally now -- it does not follow the content area. Only when the content
+// area can no longer hold it (plus a margin a side so the card never touches
+// the page's edges) does it give way.
+inline constexpr int kArcComposerWidth = 651;
+inline constexpr int kArcComposerMinSideMargin = 16;
+
+// Below this the box has stopped being a place to type. Nothing in the shell
+// gets this narrow in practice; the floor exists so a transient one-pixel
+// content area cannot produce a negative width.
+inline constexpr int kArcComposerMinWidth = 240;
+
+// ⚠ r8.6b: the anchor is the box's BOTTOM EDGE, and it sits HALF A BOX-HEIGHT
+// above the content area's half-way line -- "中央框和logo这个整体UI，这两个元素
+// 整体再往上走，差不多输入框高度的一半" (user 2026-08-22), applied on top of
+// r8.6a's rule, which had put that same edge exactly on the line:
+//
+//   "我觉得视觉上居中，你试试面板最下沿刚好在垂直高度的百分之五十处。也就是
+//    logo+搜索面板，这两个元素整体都在页面的上半部分。" (2026-08-22)
+//
+// So the whole group lives in the top half and then some. This is the fourth
+// rule in four rounds -- r8.5 centred the box, r8.6 centred the group (logo top
+// to box bottom), r8.6a put the box's bottom on the line -- and every step has
+// been upwards, which is the usual outcome of centring something the eye reads
+// as a heading.
+//
+// ⚠ `Dia:` is a fourth answer again (group centre at 35.4% of the window, i.e.
+// its card's bottom edge at 43.7%), and it is not copied here: Dia's new tab
+// page carries a headline, two connect cards and a full-width image below the
+// composer, and ours carries nothing.
+
+// The box's corner radius. `Dia:` fits R=40 device px, the same arc as the
+// band's edit panel -- one shell, one radius for "a white surface you type
+// into".
+inline constexpr int kArcComposerRadius = 20;
+
+// ⚠ The box's height is SOLVED, not chosen, and these are the constraints that
+// solve it -- the user's, stated at r8.5 and unchanged:
+//
+//   "搜索框中的icon要和搜索列表的icon对齐……要注意左边的icon距离搜索框上/左/下的
+//    边距,尽量保持同样的边距,这样视觉上会很舒服" (2026-08-21)
+//
+// Two constraints: (a) the leading icon sits in the same column as the
+// suggestion list's icons, (b) its clear margin is the same on the left, the
+// top and the bottom. Together they leave exactly one height:
+//
+//     box height = icon + 2 * icon margin
+//
+// r8.5 read the margin off Chromium's stock suggestion row (13) and got a 42pt
+// box, which the user rejected as too flat ("高度又过矮了一些"). r8.6 reads it
+// off `Dia:` instead and moves the LIST to match -- which is the only way all
+// three of the user's asks can hold at once, since Dia's own list is indented
+// exactly this far.
+//
+// `Dia:` measured 2026-08-22 off the live window (1728x1084pt, resting new tab
+// and the same tab with six suggestions, screencapture only):
+//
+//   card               673.0..1323.5 x 363.5..474.5  = 650.5 x 111 (two rows)
+//   magnifier glyph    696.0..709.5 x 386.5..400.5   -> centre (702.75, 393.5)
+//   centre from left   702.75 - 673.0 = 29.75
+//   centre from top    393.5  - 363.5 = 30.0        <- the same number
+//   first suggestion   row band starts 423 -> 59.5 below the card's top
+//
+// So Dia's own "non-result section" is 59.5 tall, i.e. what its card would
+// measure with the second row removed -- 2 * 29.75 = 59.5, the same solve. We
+// take 22 (=(60-16)/2) and 60. `Arc:` satisfies the identical rule at its own
+// scale (icons at 25.0 from the card edge, non-result section 66 = 16 + 2*25,
+// measured 2026-08-21), which is the check that this is a rule and not a
+// coincidence in one browser.
+//
+// Ratio check, the r8.5 complaint ("搜索框的高度这么高，搜索列表每个搜索结果的
+// 高度又这么矮，很不协调"): box/row is 60/40 = 1.50 here, `Dia:` 59.5/40 = 1.49,
+// `Arc:` 66/50 = 1.32. r8.4's 68/30 = 2.27 was the disproportion he reported.
+inline constexpr int kArcComposerIconSize = 16;
+inline constexpr int kArcComposerIconInset = 22;
+
+// ⚠ Chromium's, not ours: LocationBarView lays its leading decoration out at
+// x+2, and LocationIconView centres a 16pt image in a 24pt bubble, so the
+// glyph lands 6pt inside the field. The field's own inset has to give that
+// back for the icon to reach kArcComposerIconInset.
+inline constexpr int kArcComposerFieldLeadingIconOffset = 6;
+inline constexpr int kArcComposerFieldInset =
+    kArcComposerIconInset - kArcComposerFieldLeadingIconOffset;
+
+// The row fills the box, and the icon centres itself in the row.
+//
+// ⚠ r8.6b: the solve above (16 + 2*22 = 60) is now the STARTING point, not the
+// answer -- the user took five per cent off it by hand: "输入框的高度在现在的
+// 基础上矮百分之五" (2026-08-22). 60 * 0.95 = 57.
+//
+// The cost, stated rather than buried: the icon's clear margin is 22 to the
+// left (the column the list stands in, `Dia:` 21.5) but (57 - 16) / 2 = 20.5
+// above and below, so the "same margin on three sides" that solved the height
+// is off by 1.5pt where `Dia:` holds it to 0.25 (29.75 / 30.0, measured
+// 2026-08-22). The HORIZONTAL column is the one the static_assert below
+// protects and it has not moved, so the list still stands in the box's column
+// -- which was the user's first constraint and is the one that shows.
+inline constexpr int kArcComposerFieldHeight = 57;
+static_assert(kArcComposerFieldHeight <
+                  kArcComposerIconSize + 2 * kArcComposerIconInset,
+              "r8.6b trims the solved height; if this ever inverts, the box is "
+              "taller than its own solve and the comment above is stale");
+
+// == The suggestion list's own metrics, which are the same measurement ==
+//
+// The box's height only solves if the list's icons stand in the box's icon
+// column, and Chromium's stock row puts them at 13 (row inset 4 + cell margin
+// 4 + image indent -3 + 12 to centre a 16pt image in a 40pt image box). r8.5
+// took that as given and shrank the box to fit it; the user's answer was that
+// the box is too flat and that the list should be Dia's, so from r8.6 the list
+// moves instead. Every number below is `Dia:`, measured 2026-08-22 off the same
+// two captures as the box:
+//
+//   selected row band  680.5..1316.5 x 425..461   -> inset 7.5 a side, 36 tall
+//   row pitch          40.0 (five gaps between six favicon centres)
+//   row favicon        694.5..710.5                -> 21.5 from the card edge,
+//                                                     the SAME column as the
+//                                                     input row's magnifier
+//   row text           starts 723.5                -> 50.5 from the card edge
+//
+// These live here rather than in the omnibox views because they are one
+// measurement with the box's: kArcComposerListIconInset MUST equal
+// kArcComposerIconInset or the box's height stops being a solution. The
+// static_assert below is that invariant, not a style preference.
+inline constexpr int kArcComposerListRowHeight = 36;
+inline constexpr int kArcComposerListRowGap = 2;  // above and below, so pitch 40
+inline constexpr int kArcComposerListRowInset = 8;
+inline constexpr int kArcComposerListIconInset = 22;
+inline constexpr int kArcComposerListTextInset = 50;
+
+static_assert(kArcComposerListIconInset == kArcComposerIconInset,
+              "the list's icon column IS the box's icon column -- that is what "
+              "solves the box's height (see above)");
+static_assert(kArcComposerListRowInset < kArcComposerListIconInset,
+              "the icon sits inside the row band, not on its edge");
+
+// The pitch the eye reads: `Dia:` 40.0.
+inline constexpr int kArcComposerListRowPitch =
+    kArcComposerListRowHeight + 2 * kArcComposerListRowGap;
+
+// `Dia:`'s hint grey, measured 2026-08-22: the resting placeholder ("Ask
+// anything...") and the magnifier beside it are the SAME (152,153,153) on a
+// (254,255,255) card. r8.5 used kColorOmniboxTextDimmed (L71 measured on our
+// card) because the reference then was `Arc:` at L125; the user has since
+// pointed at Dia for this ("示意文字的灰度也参考Dia", 2026-08-22).
+//
+// ⚠ Light only. `Dia:` has never been captured dark, so the mixer falls back
+// to upstream's dimmed id there rather than inventing a number.
+inline constexpr SkColor kArcComposerHintColor =
+    SkColorSetRGB(0x98, 0x99, 0x99);
+
+// And the row action hint ("Hold ⌘ to switch") one step lighter again:
+// `Dia:` (187,188,188), measured 2026-08-22, right-aligned in the row with no
+// outline at all -- which is the part the user asked for by name ("'Switch to
+// this tab' 也要像[Dia]一样放在右侧，且没有外边框").
+inline constexpr SkColor kArcComposerRowActionHintColor =
+    SkColorSetRGB(0xBB, 0xBC, 0xBC);
+
+// The list's own two colours, same capture: the selected/hovered row band at
+// `Dia:` (225,226,227) -- twice GM3's wash on our card -- and the grey Dia
+// writes the URL half of a row in, `Dia:` (100,105,116), where Chromium uses
+// its primary blue.
+inline constexpr SkColor kArcListRowSelectedColor =
+    SkColorSetRGB(0xE1, 0xE2, 0xE3);
+inline constexpr SkColor kArcListUrlColor = SkColorSetRGB(0x64, 0x69, 0x74);
+
+// The product mark above the box. `Dia:` measured 2026-08-21 off the user's
+// own capture: a 50.0 x 41.0pt flat mark in neutral (219,219,219) on a
+// (248,247,247) page, centred on the card to within 0.05pt, its baseline
+// 29.5pt above the card's top edge.
+//
+// Ours is square where Dia's is wide, so 44 rather than 50 keeps a comparable
+// amount of ink. The user picked Dia's treatment over Helium's own blue app
+// icon: the mark is meant to be the quietest thing on the page.
+// ⚠ r8.6a: +20% on the user's ask ("logo的大小再放大百分之二十，我看看效果",
+// 2026-08-22). 44 * 1.2 = 52.8 -> 53.
+// ⚠ r8.6b: +10% again, same day ("logo再大百分之十"). 53 * 1.1 = 58.3 -> 58,
+// which now overshoots `Dia:`'s own 50.0 x 41.0 mark -- knowingly: ours is
+// square where Dia's is wide, so 58 square carries about the ink of a 50x41
+// wide mark plus a fifth.
+inline constexpr int kArcComposerLogoSize = 58;
+// ⚠ r8.5: doubled. 30 read as crowded once the box shrank -- "Logo和搜索框的
+// 位置现在有些近，再增加一倍的距离" (user 2026-08-21).
+inline constexpr int kArcComposerLogoGap = 60;
+
+// `Dia:`'s mark reads (219,219,219) against a (248,247,247) page. We take the
+// literal grey rather than a theme colour id: this is one mark on one page,
+// and every id near enough (disabled foreground, subtle icon) is defined
+// against a chrome surface, not against the web contents' own background.
+// ⚠ Dark themes are UNMEASURED -- `Dia:` was only ever captured light. Same
+// grey for now, flagged for the acceptance pass.
+inline constexpr SkColor kArcComposerLogoColor = SkColorSetRGB(0xDB, 0xDB, 0xDB);
+
+// Where the composer goes. `content_area` is the web contents' rect (the card
+// below the band) and `window_height` the browser window's own -- both in the
+// same space the caller will place the host in.
+//
+// Empty for an empty content area, which is the state during teardown and
+// before the first layout; a box derived from it would be a stripe at the
+// origin.
+// ⚠ `window_height` is no longer read (r8.5 centres on the content area);
+// kept so the one caller keeps failing loudly on a zero-height window rather
+// than placing a box in a window that has not been sized yet.
+inline gfx::Rect ArcComposerBounds(const gfx::Rect& content_area,
+                                   int window_height) {
+  if (content_area.IsEmpty() || window_height <= 0) {
+    return gfx::Rect();
+  }
+  int width = std::min(kArcComposerWidth,
+                       content_area.width() - 2 * kArcComposerMinSideMargin);
+  width = std::max(width, std::min(kArcComposerMinWidth, content_area.width()));
+  const int height = kArcComposerFieldHeight;
+  const int x = content_area.x() + (content_area.width() - width) / 2;
+  // The bottom edge half a box-height above the half-way line (see above), so
+  // the box's own top is one and a half boxes higher and the mark higher
+  // again. On a very short window the mark's top can fall above the content
+  // area -- it is dropped there rather than clipped, which BrowserView already
+  // handles.
+  const int y = content_area.y() + content_area.height() / 2 - height * 3 / 2;
+  return gfx::Rect(x, y, width, height);
+}
+
+// The input row inside the box: full width less kArcComposerFieldInset a side,
+// and the full height. It is still the FIRST row -- anchored at the top, so a
+// second one can be added underneath without this function moving.
+inline gfx::Rect ArcComposerFieldBounds(const gfx::Rect& box) {
+  if (box.IsEmpty()) {
+    return gfx::Rect();
+  }
+  const int width = std::max(0, box.width() - 2 * kArcComposerFieldInset);
+  const int height = std::min(kArcComposerFieldHeight, box.height());
+  return gfx::Rect(box.x() + kArcComposerFieldInset, box.y(), width, height);
+}
+
+// The product mark above the box: centred on it, sitting kArcComposerLogoGap
+// clear of its top edge. Deliberately NOT a child of the composer host -- the
+// host's local bounds are what the panel paints as the white card, so anything
+// added inside it makes the card taller.
+inline gfx::Rect ArcComposerLogoBounds(const gfx::Rect& box) {
+  if (box.IsEmpty()) {
+    return gfx::Rect();
+  }
+  return gfx::Rect(box.x() + (box.width() - kArcComposerLogoSize) / 2,
+                   box.y() - kArcComposerLogoGap - kArcComposerLogoSize,
+                   kArcComposerLogoSize, kArcComposerLogoSize);
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_COMPOSER_H_
