@@ -0,0 +1,46 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_ARC_COMPOSER_HOST_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_ARC_COMPOSER_HOST_VIEW_H_
+
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+// helium-fork: where the address field lives while a blank new tab is showing
+// -- the centred composer, the only place that page has for typing.
+//
+// It holds the real LocationBarView, reparented out of the toolbar. Not a copy
+// and not a second omnibox: there is one field in the window, and on a new tab
+// it is here. That is what makes Cmd+L land in the composer without a single
+// line of routing, and what makes it impossible for the band to flash a capsule
+// at the same time -- the capsule is not hidden, it is absent.
+//
+// It paints nothing. The white card behind the field is ArcOmniboxPanelView's,
+// the same painter the band's edit panel and the suggestion popup use, so the
+// three surfaces cannot drift apart and the hand-off from "empty box" to "box
+// with suggestions" stays invisible. This view is ordered directly after that
+// one in BrowserView so the field sits ON the card rather than under it -- and
+// that is also why the panel leaves no hole here, unlike on the band where the
+// field is a layer below it.
+//
+// Only the field moves. The extensions, the avatar and the app menu stay in
+// the band (`Dia:` does the same -- measured 2026-08-21, its new tab page keeps
+// the sidebar toggle, the navigation buttons and Personalization and simply has
+// nothing in the middle), so the toolbar keeps hosting everything else and
+// ToolbarView's trailing spacer keeps them against the right edge.
+class ArcComposerHostView : public views::View {
+  METADATA_HEADER(ArcComposerHostView, views::View)
+
+ public:
+  ArcComposerHostView();
+  ArcComposerHostView(const ArcComposerHostView&) = delete;
+  ArcComposerHostView& operator=(const ArcComposerHostView&) = delete;
+  ~ArcComposerHostView() override;
+
+  // views::View:
+  void Layout(PassKey) override;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_ARC_COMPOSER_HOST_VIEW_H_
