   const bool arc_shell = layout_data_->tab_strip_type == TabStripType::kVertical;
   const bool arc_content_card = arc_shell && should_use_rounded_frame;
 
-  // helium-fork: the band stops reserving the caption area only while the
-  // sidebar is genuinely covering it -- i.e. docked on the caption side. The
-  // rule is "does the sidebar actually sit on top of the window controls",
-  // never "which layout is this"; getting that wrong is how the toolbar's
-  // leading controls ended up drawn straight over the traffic lights.
-  //
-  // Two cases keep the reservation: a right-aligned strip (macOS keeps the
-  // lights on the left, so the band still owns that corner), and a floating
-  // strip -- collapsed or zen-unpinned -- where the band spans the full width
-  // with nothing above the lights but itself.
-  if (arc_shell && !vertical_right_aligned &&
-      !zen.floating_vertical_tab_strip) {
+  // helium-fork: with a left-aligned strip the caption corner belongs to the
+  // sidebar, full stop (Dia behavior, 2026-08-16) -- docked it sits on top of
+  // the lights, hidden there are no lights at all and the band runs flush to
+  // the window edge; during the hover reveal the floating card overlays the
+  // band and the lights fade in over the card, so the band never needs to
+  // make room for them. Only a right-aligned strip keeps the reservation:
+  // macOS keeps the lights on the left, so there the band still owns that
+  // corner. (The floating-strip case used to keep it too -- that was the
+  // ~70px of dead space in front of the URL whenever the sidebar was
+  // collapsed.)
+  if (arc_shell && !vertical_right_aligned) {
     needs_exclusion = false;
   }
 
