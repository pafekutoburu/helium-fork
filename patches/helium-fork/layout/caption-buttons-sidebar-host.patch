Index: src/chrome/browser/ui/helium/arc_caption_opacity.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_caption_opacity.h
@@ -0,0 +1,40 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_CAPTION_OPACITY_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_CAPTION_OPACITY_H_
+
+// helium-fork: the one formula for the traffic lights' opacity. Kept
+// dependency-free so the minimal unit-test target can cover it.
+namespace helium {
+
+// macOS keeps the window controls in the top-left corner, so their host is
+// whatever piece of chrome owns that corner:
+//
+//  * Left-aligned sidebar: the sidebar is the only host (Dia behavior,
+//    2026-08-16). Hidden sidebar means no traffic lights at all; the hover
+//    reveal brings them back with the floating card, fading with its ratio.
+//    The docked address-bar band deliberately stopped being a fallback host
+//    -- that fallback is what kept the lights on while the sidebar was away.
+//  * Right-aligned sidebar: the sidebar never covers that corner; the band
+//    owns it whenever it exists. Zen used to fade the lights with the band's
+//    reveal; retired, but the ratio passthrough stays harmless.
+inline constexpr float ComputeCaptionButtonsOpacity(bool right_aligned,
+                                                    bool sidebar_hidden,
+                                                    float side_reveal_ratio,
+                                                    bool has_band,
+                                                    bool zen_enabled,
+                                                    float top_reveal_ratio) {
+  if (!right_aligned) {
+    return sidebar_hidden ? side_reveal_ratio : 1.0f;
+  }
+  if (!has_band) {
+    return 0.0f;
+  }
+  return zen_enabled ? top_reveal_ratio : 1.0f;
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_CAPTION_OPACITY_H_
Index: src/chrome/browser/ui/helium/arc_caption_opacity_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_caption_opacity_unittest.cc
@@ -0,0 +1,60 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_caption_opacity.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+TEST(ArcCaptionOpacityTest, LeftAlignedDockedSidebarHosts) {
+  EXPECT_EQ(1.0f, ComputeCaptionButtonsOpacity(
+                      /*right_aligned=*/false, /*sidebar_hidden=*/false,
+                      /*side_reveal_ratio=*/0.0f, /*has_band=*/true,
+                      /*zen_enabled=*/false, /*top_reveal_ratio=*/1.0f));
+}
+
+TEST(ArcCaptionOpacityTest, LeftAlignedHiddenSidebarFollowsReveal) {
+  for (const float ratio : {0.0f, 0.25f, 0.5f, 1.0f}) {
+    EXPECT_EQ(ratio, ComputeCaptionButtonsOpacity(
+                         /*right_aligned=*/false, /*sidebar_hidden=*/true,
+                         /*side_reveal_ratio=*/ratio, /*has_band=*/true,
+                         /*zen_enabled=*/false, /*top_reveal_ratio=*/1.0f));
+  }
+}
+
+// The Dia rule this round pinned down (2026-08-16): a docked band is NOT a
+// fallback host -- with the sidebar hidden and no reveal, the lights are
+// gone even though the band is right there.
+TEST(ArcCaptionOpacityTest, DockedBandIsNotAFallbackHost) {
+  EXPECT_EQ(0.0f, ComputeCaptionButtonsOpacity(
+                      /*right_aligned=*/false, /*sidebar_hidden=*/true,
+                      /*side_reveal_ratio=*/0.0f, /*has_band=*/true,
+                      /*zen_enabled=*/false, /*top_reveal_ratio=*/1.0f));
+}
+
+TEST(ArcCaptionOpacityTest, RightAlignedBandHosts) {
+  EXPECT_EQ(1.0f, ComputeCaptionButtonsOpacity(
+                      /*right_aligned=*/true, /*sidebar_hidden=*/true,
+                      /*side_reveal_ratio=*/0.0f, /*has_band=*/true,
+                      /*zen_enabled=*/false, /*top_reveal_ratio=*/0.0f));
+}
+
+TEST(ArcCaptionOpacityTest, RightAlignedWithoutBandHidesLights) {
+  EXPECT_EQ(0.0f, ComputeCaptionButtonsOpacity(
+                      /*right_aligned=*/true, /*sidebar_hidden=*/false,
+                      /*side_reveal_ratio=*/1.0f, /*has_band=*/false,
+                      /*zen_enabled=*/false, /*top_reveal_ratio=*/1.0f));
+}
+
+TEST(ArcCaptionOpacityTest, RightAlignedZenFollowsTopReveal) {
+  EXPECT_EQ(0.3f, ComputeCaptionButtonsOpacity(
+                      /*right_aligned=*/true, /*sidebar_hidden=*/false,
+                      /*side_reveal_ratio=*/0.0f, /*has_band=*/true,
+                      /*zen_enabled=*/true, /*top_reveal_ratio=*/0.3f));
+}
+
+}  // namespace
+}  // namespace helium
