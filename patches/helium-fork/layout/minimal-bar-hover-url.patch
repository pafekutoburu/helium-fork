@@ -2556,9 +2556,29 @@ void LocationBarView::OnOmniboxHovered(b
   } else {
     hover_animation_.Hide();
   }
+  // helium-fork: the text swap (host <-> host+path, title out <-> in) is
+  // edge-triggered here -- exactly once per boundary crossing, never per
+  // animation frame. The capsule and the trailing icons keep riding the
+  // 200ms tween above; Dia switches the text instantly (measured
+  // 2026-08-16), so the swap does not animate.
+  if (is_hovering != arc_hovered_) {
+    arc_hovered_ = is_hovering;
+    if (ShouldMinimizeArcChrome() && omnibox_view_ &&
+        !omnibox_view_->HasFocus() &&
+        !GetOmniboxController()->edit_model()->user_input_in_progress()) {
+      omnibox_view_->Update();
+      RefreshArcTitleLabel();
+    }
+  }
   UpdateArcMinimalDecorations();
 }
 
+bool LocationBarView::IsArcHoverUrlPreview() const {
+  return ShouldMinimizeArcChrome() && arc_hovered_ &&
+         !(omnibox_view_ && omnibox_view_->HasFocus()) &&
+         !GetOmniboxController()->edit_model()->user_input_in_progress();
+}
