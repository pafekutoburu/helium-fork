Index: src/chrome/browser/ui/helium/arc_floating_sidebar.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_floating_sidebar.h
@@ -0,0 +1,150 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_FLOATING_SIDEBAR_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_FLOATING_SIDEBAR_H_
+
+#include <algorithm>
+
+#include "base/time/time.h"
+#include "chrome/browser/ui/helium/arc_sidebar_surface.h"
+#include "ui/gfx/animation/tween.h"
+
+// helium-fork (M3.9d): every number of the hidden-sidebar hover card -- the
+// floating sidebar that slides out of the window's left edge in the kHidden
+// layout and retracts when the pointer leaves it. Before this header those
+// numbers were upstream zen-mode constants scattered over browser_view.cc,
+// browser_view_tabbed_layout_impl.cc and vertical_tab_strip_region_view.cc;
+// calibrating the card against a reference browser means editing this file
+// only. Dependency-free (base + gfx::Tween) so the lightweight unit-test
+// target can pin the invariants.
+//
+// The reference for this card is Dia (user 2026-08-23: UI details including
+// motion follow Dia's style). Every figure below is either Dia's, measured
+// 2026-08-23 on the user's machine (light theme, 2x; the table with the raw
+// readings is progress/decisions.md「M3.9d 参考物改判 + Dia 实测规格」), or a
+// deliberate departure called out in place.
+namespace helium {
+
+// --- 1. geometry -----------------------------------------------------------
+
+// Gap between the floating card and the window edges (all four sides), in
+// DIPs. Dia: 3 top/bottom, 4 left counting its own 1px window edge line --
+// i.e. the same 3 as ours. The contents card keeps its own inset
+// (MultiContentsView::kContentCardInset, user-ruled 3); the two used to be
+// one alias.
+inline constexpr int kFloatingSidebarGap = 3;
+
+// The card's corner radius: concentric with the system window radius
+// (user-ruled "先走同心"), i.e. the window radius minus the gap. Dia measures
+// 14.0 -- exactly 17 - 3. Never negative: a gap wider than the window radius
+// degrades to square corners.
+inline constexpr int FloatingSidebarCornerRadius(int window_radius) {
+  return std::max(0, window_radius - kFloatingSidebarGap);
+}
+
+// --- 2. rim ----------------------------------------------------------------
+
+// A 1px highlight stroke around the card (views::Separator::kThickness), white
+// over the card's opaque fill. Dia: present on all four edges, 1pt, two
+// levels lighter than its L248 fill (L250) -- barely there. Replicated by
+// *contrast*, not by Dia's absolute alpha (0.29 on a near-white fill): the
+// same +2 L on our L228 fill is white at ~0.08; 0.29 would read as a bright
+// edge Dia does not have. Dark theme unmeasured (Dia's dark mode was not
+// driven); kept at the same faint level.
+// The alphas themselves live next to the other surface colours in
+// arc_sidebar_surface.h (kSidebarFloatingCardRimAlpha{Light,Dark}) because the
+// color mixer that defines kColorArcFloatingSidebarRim compiles that header
+// and must not pull gfx::Tween in.
+inline constexpr bool kFloatingSidebarRimEnabled = true;
+inline constexpr double kFloatingSidebarRimAlphaLight =
+    kSidebarFloatingCardRimAlphaLight;
+inline constexpr double kFloatingSidebarRimAlphaDark =
+    kSidebarFloatingCardRimAlphaDark;
+
+// --- 3. shadow -------------------------------------------------------------
+
+// Self-painted (HeliumCardShadowView, same pass model as the sidebar's row
+// cards). Dia's shadow is a near-isotropic halo: measured right of the card
+// on a L247 page, delta L at d px = 1:-24 2:-23 4:-21 8:-16 12:-11.6 16:-8
+// 24:-3.4 32:-1 40:0, and the same ~-20 in all three window gaps. A single
+// centred gaussian, sigma 8pt / alpha 0.205, reproduces that profile to rms
+// 0.25 -- no hug/drift passes needed. The MD shadow this replaced (elevation
+// 4, key alpha .3) was gone by 5pt; Dia's carries to 16. Dark theme
+// unmeasured; the row cards' convention (black at doubled alpha) applies.
+inline constexpr SidebarCardShadowPass kFloatingSidebarShadowPasses[] = {
+    {/*offset_y=*/0, /*sigma=*/8.0, /*light_alpha=*/0.205,
+     /*dark_alpha=*/0.41, /*inset_h=*/0},
+};
+// The shadow view's overhang past the card on each side: 4 sigma (the tail
+// beyond is sub-1% alpha). The window clips what falls into its 3pt gaps.
+inline constexpr int kFloatingSidebarShadowOutsetH = 32;
+inline constexpr int kFloatingSidebarShadowOutsetV = 32;
+inline constexpr CardShadowSpec kFloatingSidebarShadowSpec{
+    kFloatingSidebarShadowPasses, kFloatingSidebarShadowOutsetH,
+    kFloatingSidebarShadowOutsetV};
+
+// --- 4. motion -------------------------------------------------------------
+
+// Slide-out and slide-back durations and easings. Dia (two cycles each):
+// out ~130ms, back ~120ms, both a plain ease-out (normalized 0.37@28ms,
+// 0.64@53, 0.86@78, 1.0@115 -- gfx::Tween::EASE_OUT fits to rms 8px of 550);
+// the ~1% overshoot Dia's spring adds is not reproduced. Callers wrap the
+// durations in gfx::Animation::RichAnimationDuration() so "reduce motion"
+// still wins.
+inline constexpr base::TimeDelta kFloatingSidebarShowDuration =
+    base::Milliseconds(130);
+inline constexpr base::TimeDelta kFloatingSidebarHideDuration =
+    base::Milliseconds(120);
+inline constexpr gfx::Tween::Type kFloatingSidebarShowTween =
+    gfx::Tween::EASE_OUT;
+inline constexpr gfx::Tween::Type kFloatingSidebarHideTween =
+    gfx::Tween::EASE_OUT;
+
+// --- 5. retract ------------------------------------------------------------
+
+// Dia retracts by *distance*, not by time: a slow exit and a fast one both
+// began sliding back with the pointer ~82-92pt past the card's right edge
+// (92pt after 550ms, 86pt after 265ms), so the band past the card is ~82pt
+// wide and the grace after leaving it is nil (<= 50ms, within the clock's
+// resolution). Vertical leeway was not exercised; the old 8 stays there.
+// The grace when the pointer leaves the window entirely is unmeasured too.
+inline constexpr base::TimeDelta kFloatingSidebarHoverExitGrace =
+    base::Milliseconds(0);
+inline constexpr int kFloatingSidebarHoverLeewayH = 82;
+inline constexpr int kFloatingSidebarHoverLeewayV = 8;
+inline constexpr base::TimeDelta kFloatingSidebarWindowExitGrace =
+    base::Milliseconds(3000);
+
+// --- 6. hot zone -----------------------------------------------------------
+
+// Width in DIPs of the strip along the window edge that reveals the card.
+// Dia: x <= 5 (a pointer parked at x = 5 for 180ms did not count; 4 did; the
+// strip is read as x < 6, the same as ours). The same figure is the
+// horizontal slack past the window edge within which the pointer still counts
+// as inside the window (so a 1px overshoot does not start the window-exit
+// grace).
+inline constexpr int kFloatingSidebarTriggerThickness = 6;
+
+// Dia does not reveal on contact: both cycles started sliding 310ms (+-40ms)
+// after the pointer entered the strip, regardless of whether it kept
+// creeping inside it -- a fixed hover-intent delay. Leaving the strip before
+// it elapses cancels the reveal. 0 means immediate.
+inline constexpr base::TimeDelta kFloatingSidebarRevealDelay =
+    base::Milliseconds(300);
+
+// Whether `x` (BrowserView-local) lies in the reveal strip of a window
+// `width` wide; the strip hugs the left edge, or the right one for a
+// right-aligned sidebar.
+inline constexpr bool IsInFloatingSidebarTrigger(int x,
+                                                 int width,
+                                                 bool right_aligned) {
+  return right_aligned ? (x >= width - kFloatingSidebarTriggerThickness &&
+                          x < width)
+                       : (x >= 0 && x < kFloatingSidebarTriggerThickness);
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_FLOATING_SIDEBAR_H_
Index: src/chrome/browser/ui/helium/arc_floating_sidebar_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_floating_sidebar_unittest.cc
@@ -0,0 +1,99 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_floating_sidebar.h"
+
+#include <cmath>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+// The card's corners stay concentric with the window: radius = window radius
+// minus the gap, never negative, monotone in the window radius.
+TEST(ArcFloatingSidebarTest, CornerRadiusIsConcentricWithTheWindow) {
+  EXPECT_EQ(17 - kFloatingSidebarGap, FloatingSidebarCornerRadius(17));
+  EXPECT_EQ(12 - kFloatingSidebarGap, FloatingSidebarCornerRadius(12));
+  EXPECT_EQ(0, FloatingSidebarCornerRadius(kFloatingSidebarGap));
+  EXPECT_EQ(0, FloatingSidebarCornerRadius(0));
+  EXPECT_LE(FloatingSidebarCornerRadius(12), FloatingSidebarCornerRadius(17));
+}
+
+// The gap must keep the macOS window controls inside the card's top row: an
+// 8px inset once cut into the traffic lights (layout_impl.cc history), and a
+// zero gap lets the card's corner eat them.
+TEST(ArcFloatingSidebarTest, GapStaysWithinTheTrafficLightBudget) {
+  EXPECT_GE(kFloatingSidebarGap, 1);
+  EXPECT_LE(kFloatingSidebarGap, 7);
+}
+
+// The rim is a highlight by contrast: faint (never a visible bright edge),
+// and present on both themes while the switch is on.
+TEST(ArcFloatingSidebarTest, RimAlphasAreFaintButVisibleWhenEnabled) {
+  EXPECT_GE(kFloatingSidebarRimAlphaLight, 0.0);
+  EXPECT_LE(kFloatingSidebarRimAlphaLight, 0.2);
+  EXPECT_GE(kFloatingSidebarRimAlphaDark, 0.0);
+  EXPECT_LE(kFloatingSidebarRimAlphaDark, 0.2);
+  if (kFloatingSidebarRimEnabled) {
+    EXPECT_GT(kFloatingSidebarRimAlphaLight, 0.0);
+    EXPECT_GT(kFloatingSidebarRimAlphaDark, 0.0);
+  }
+}
+
+// The halo's passes stay paintable (alphas in range, sigma positive) and the
+// shadow view's overhang swallows every pass's practical reach (offset +
+// 3 sigma), so the tail is never cut flat.
+TEST(ArcFloatingSidebarTest, ShadowConstantsHoldTheirShape) {
+  EXPECT_FALSE(kFloatingSidebarShadowSpec.passes.empty());
+  for (const SidebarCardShadowPass& pass : kFloatingSidebarShadowSpec.passes) {
+    EXPECT_GT(pass.sigma, 0.0);
+    EXPECT_GE(pass.light_alpha, 0.0);
+    EXPECT_LE(pass.light_alpha, 1.0);
+    EXPECT_GE(pass.dark_alpha, 0.0);
+    EXPECT_LE(pass.dark_alpha, 1.0);
+    EXPECT_GE(pass.inset_h, 0);
+    EXPECT_GE(kFloatingSidebarShadowSpec.outset_h,
+              3 * pass.sigma - pass.inset_h);
+    EXPECT_GE(kFloatingSidebarShadowSpec.outset_v,
+              3 * pass.sigma + std::abs(pass.offset_y));
+  }
+}
+
+// Motion: both legs finite and non-negative; the retract timings ordered --
+// leaving the card can never wait longer than leaving the window.
+TEST(ArcFloatingSidebarTest, MotionAndRetractTimingsAreOrdered) {
+  EXPECT_GE(kFloatingSidebarShowDuration, base::TimeDelta());
+  EXPECT_GE(kFloatingSidebarHideDuration, base::TimeDelta());
+  EXPECT_LT(kFloatingSidebarShowDuration, base::Seconds(2));
+  EXPECT_LT(kFloatingSidebarHideDuration, base::Seconds(2));
+  EXPECT_GE(kFloatingSidebarHoverExitGrace, base::TimeDelta());
+  EXPECT_LE(kFloatingSidebarHoverExitGrace, kFloatingSidebarWindowExitGrace);
+  EXPECT_GE(kFloatingSidebarHoverLeewayH, 0);
+  EXPECT_GE(kFloatingSidebarHoverLeewayV, 0);
+  EXPECT_GE(kFloatingSidebarRevealDelay, base::TimeDelta());
+  EXPECT_LT(kFloatingSidebarRevealDelay, base::Seconds(1));
+}
+
+// The reveal strip hugs the edge: x = 0 is in, x = thickness is out, and the
+// right-aligned strip mirrors it exactly.
+TEST(ArcFloatingSidebarTest, TriggerStripHugsTheEdge) {
+  constexpr int t = kFloatingSidebarTriggerThickness;
+  constexpr int w = 1000;
+  EXPECT_GE(t, 1);
+  EXPECT_FALSE(IsInFloatingSidebarTrigger(-1, w, false));
+  EXPECT_TRUE(IsInFloatingSidebarTrigger(0, w, false));
+  EXPECT_TRUE(IsInFloatingSidebarTrigger(t - 1, w, false));
+  EXPECT_FALSE(IsInFloatingSidebarTrigger(t, w, false));
+  EXPECT_FALSE(IsInFloatingSidebarTrigger(w - 1, w, false));
+
+  EXPECT_FALSE(IsInFloatingSidebarTrigger(w, w, true));
+  EXPECT_TRUE(IsInFloatingSidebarTrigger(w - 1, w, true));
+  EXPECT_TRUE(IsInFloatingSidebarTrigger(w - t, w, true));
+  EXPECT_FALSE(IsInFloatingSidebarTrigger(w - t - 1, w, true));
+  EXPECT_FALSE(IsInFloatingSidebarTrigger(0, w, true));
+}
+
+}  // namespace
+}  // namespace helium
