+// helium-fork: every mouse press in this window ends the address field's edit
+// state unless it landed on the field. Clicking the web contents already did
+// that on its own -- the contents take focus -- but nothing else in the window
+// is focusable, so a click on the sidebar or the tab strip used to leave the
+// panel standing.
+//
+// It has to be an EventMonitor rather than a pre-target handler on the root
+// view: the sidebar's blank, the tab strip's blank and the window's caption are
+// all HTCAPTION, and a press there makes -[BridgedContentView hitTest:] return
+// nil so AppKit runs a window drag and Views never sees the event at all
+// (measured 2026-08-17 -- a click on the sidebar's blank reached no Views code
+// whatsoever). EventMonitorMac hangs off +[NSEvent addLocalMonitorFor...],
+// which is upstream of that, and filters to this window so the suggestion
+// popup's own presses (a different NSWindow) never reach it.
+class ArcOmniboxDismissHandler : public ui::EventObserver {
+ public:
+  ArcOmniboxDismissHandler(BrowserView* browser_view,
+                           gfx::NativeWindow window)
+      : browser_view_(browser_view),
+        monitor_(views::EventMonitor::CreateWindowMonitor(
+            this,
+            window,
+            {ui::EventType::kMousePressed})) {}
+  ArcOmniboxDismissHandler(const ArcOmniboxDismissHandler&) = delete;
+  ArcOmniboxDismissHandler& operator=(const ArcOmniboxDismissHandler&) = delete;
+  ~ArcOmniboxDismissHandler() override = default;
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override {
+    browser_view_->MaybeEndArcFieldEditing();
+  }
+
+ private:
+  const raw_ptr<BrowserView> browser_view_;
+  std::unique_ptr<views::EventMonitor> monitor_;
+};
