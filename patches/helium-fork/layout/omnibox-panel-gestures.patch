+  // helium-fork: a blank press that starts moving is a window drag. Movement
+  // is the only discriminator -- there is deliberately no time limit, because
+  // Dia opens the panel even after a five-second hold as long as the pointer
+  // stayed put.
+  if (arc_blank_press_.has_value()) {
+    if (arc_blank_press_moved_) {
+      return true;  // The move loop already ran; the gesture is spent.
+    }
