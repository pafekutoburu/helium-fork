+void LocationBarView::EndArcFieldEditing() {
+  if (!omnibox_view_ || !IsArcFieldEditing()) {
+    return;
+  }
+  // Only the focus has to be taken away -- OmniboxViewViews::OnBlur does the
+  // rest, and it is the same path a click on the web contents already takes.
+  if (views::FocusManager* const focus_manager = GetFocusManager()) {
+    if (focus_manager->GetFocusedView() &&
+        Contains(focus_manager->GetFocusedView())) {
+      focus_manager->ClearFocus();
+    }
+    // And drop the view the widget parked focus on for its next activation.
+    // Deactivating stores the focused view so it can be handed back when the
+    // user returns; without this the field takes focus again the moment the
+    // window comes forward and the panel is standing there as if nothing had
+    // happened. Clearing it covers both orderings of "store" against this
+    // observer, which is why it is unconditional rather than guarded.
+    if (focus_manager->GetStoredFocusView() &&
+        Contains(focus_manager->GetStoredFocusView())) {
+      focus_manager->SetStoredFocusView(nullptr);
+    }
+  }
+  // OnBlur only reverts while the widget is active ("merely Alt-Tabbing to
+  // another window and back should not change the Omnibox state"), so on
+  // deactivation the field would keep the unelided URL that focusing put there
+  // and the band would never go back to "host / title". Reverting is only safe
+  // when the user has typed nothing -- their in-progress input is theirs.
+  if (!GetOmniboxController()->edit_model()->user_input_in_progress()) {
+    omnibox_view_->RevertAll();
+  }
+}
