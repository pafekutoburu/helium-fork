+void BrowserView::MaybeEndArcFieldEditing() {
+  LocationBarView* const location_bar =
+      toolbar_ ? toolbar_->location_bar_view() : nullptr;
+  if (!location_bar || !location_bar->GetArcOmniboxPanelMetrics().enabled ||
+      !location_bar->IsArcFieldEditing()) {
+    return;
+  }
+  // A press inside the field is the field's own business -- moving the caret,
+  // extending a selection, hitting a page-action icon. The monitor sees the
+  // press before dispatch, so the pointer is exactly where it was pressed;
+  // reading the cursor rather than the event's coordinates is the same thing
+  // #337 does, and it dodges the question of which space a monitored event's
+  // location is in.
+  gfx::Point local(display::Screen::Get()->GetCursorScreenPoint());
+  views::View::ConvertPointFromScreen(location_bar, &local);
+  if (location_bar->HitTestPoint(local)) {
+    return;
+  }
+  location_bar->EndArcFieldEditing();
+}
