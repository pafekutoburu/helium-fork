+
+void BrowserView::MaybeBeginArcFieldEditFromPress() {
+  if (arc_field_edit_active_ || !toolbar_) {
+    return;
+  }
+  LocationBarView* const location_bar = toolbar_->location_bar_view();
+  if (!location_bar || !ToolbarView::IsArcSidebarHostedFor(location_bar)) {
+    return;
+  }
+  // Same cursor-over-event-coordinates trick as MaybeEndArcFieldEditing: the
+  // monitor fires pre-dispatch, so the pointer is exactly where it pressed.
+  gfx::Point local(display::Screen::Get()->GetCursorScreenPoint());
+  views::View::ConvertPointFromScreen(location_bar, &local);
+  if (!location_bar->HitTestPoint(local)) {
+    return;
+  }
+  BeginArcSidebarFieldEdit();
+}
+
+void BrowserView::BeginArcSidebarFieldEdit() {
+  if (arc_field_edit_active_ || !arc_field_edit_host_ || !toolbar_ ||
+      !vertical_tab_strip_region_view_) {
+    return;
+  }
+  views::View* const address_row =
+      vertical_tab_strip_region_view_->arc_address_row();
+  // Only when the sidebar row hosts the toolbar and the row is actually on
+  // screen -- a collapsed, unrevealed sidebar keeps the current behavior.
+  if (!address_row || toolbar_->parent() != address_row ||
+      !address_row->IsDrawn()) {
+    return;
+  }
+  // The row must keep its height while its toolbar rides the edit host --
+  // otherwise the sidebar's layout closes the gap and the favorites jump up
+  // the instant the panel opens (user-hit 2026-08-19).
+  address_row->SetPreferredSize(gfx::Size(0, address_row->height()));
+  arc_field_edit_active_ = true;
+  UpdateArcAddressBarPlacement();
+  LayoutArcFieldEditHost();
+  // The caller focuses the field right after this returns; the layout must be
+  // synchronous so the focus (and the panel reading the field's bounds off
+  // the edit-state notification) sees the widened geometry, not the row's.
+  arc_field_edit_host_->DeprecatedLayoutImmediately();
+}
+
+void BrowserView::LayoutArcFieldEditHost() {
+  if (!arc_field_edit_active_ || !arc_field_edit_host_ ||
+      !vertical_tab_strip_region_view_) {
+    return;
+  }
+  views::View* const address_row =
+      vertical_tab_strip_region_view_->arc_address_row();
+  if (!address_row) {
+    return;
+  }
+  gfx::RectF row_f((gfx::SizeF(address_row->size())));
+  views::View::ConvertRectToTarget(address_row, this, &row_f);
+  arc_field_edit_host_->SetBoundsRect(
+      helium::ArcSidebarEditHostBounds(gfx::ToEnclosingRect(row_f)));
+  arc_field_edit_host_->SetVisible(true);
+}
+
+void BrowserView::EndArcSidebarFieldEdit() {
+  if (!arc_field_edit_active_) {
+    return;
+  }
+  // Order matters twice here: the flag drops first so the blur this may cause
+  // re-enters harmlessly, and focus leaves before the toolbar moves so the
+  // reparent never carries a focused subtree (which would dispatch Blur
+  // mid-move -- the reparent-then-focus rule, in reverse).
+  arc_field_edit_active_ = false;
+  if (LocationBarView* const location_bar =
+          toolbar_ ? toolbar_->location_bar_view() : nullptr) {
+    views::FocusManager* const focus_manager = location_bar->GetFocusManager();
+    if (focus_manager && focus_manager->GetFocusedView() &&
+        location_bar->Contains(focus_manager->GetFocusedView())) {
+      focus_manager->ClearFocus();
+    }
+  }
+  UpdateArcAddressBarPlacement();
+  if (arc_field_edit_host_) {
+    arc_field_edit_host_->SetVisible(false);
+  }
+  if (vertical_tab_strip_region_view_) {
+    if (views::View* const address_row =
+            vertical_tab_strip_region_view_->arc_address_row()) {
+      address_row->SetPreferredSize(std::nullopt);
+    }
+  }
+}
+
+void BrowserView::OnLocationBarBoundsChanged() {
+  // The edit host is placed from Layout()'s tail, which sees every ancestor
+  // move; nothing to do per-field-relayout.
+}
+
+void BrowserView::OnLocationBarEditStateChanged() {
+  if (!arc_field_edit_active_ || !toolbar_ || !toolbar_->location_bar_view()) {
+    return;
+  }
+  // Focus is the edit hand-off's lifetime, deliberately NOT
+  // IsArcFieldEditing(): blurred-with-pending-input keeps the panel on the
+  // docked band, but in the sidebar a click on the page must fold everything
+  // back -- the input survives in the omnibox model and the row (still
+  // showing it) travels home to the sidebar, where the floating card's own
+  // retraction hides it.
+  if (toolbar_->location_bar_view()->HasFocus() &&
+      toolbar_->location_bar_view()->IsDrawn()) {
+    return;
+  }
+  EndArcSidebarFieldEdit();
 }
 
