   // bottom is where the suggestions are, so it is never inset.
   int outset = 0;
 
+  // Extra growth on the right only, past `outset` -- zero on the band. The
+  // sidebar-hosted row (hidden address bar mode) is where it is non-zero: Arc's
+  // panel there shares the row's left and top edges and grows rightwards out
+  // over the page (measured 2026-08-18: panel 349.5pt wide off a 281pt
+  // sidebar, 81.5pt of overhang), because a ~200pt row cannot host a readable
+  // suggestion list and the only direction with room is right.
+  int right_extension = 0;
+
   // How far the panel reaches past the field's bottom edge while there is
   // nothing to suggest -- see kEmptyPanelBottomOutset. It belongs to PanelFor()
   // alone: alignment_insets() is what the suggestion list aligns itself to the
@@ -114,7 +122,7 @@ struct ArcOmniboxPanelMetrics {
   // taller -- the first suggestion row is worth more than the 18pt apron it
   // replaces, so the bottom edge never travels back up.
   gfx::Insets alignment_insets() const {
-    return gfx::Insets::TLBR(outset, outset, 0, outset);
+    return gfx::Insets::TLBR(outset, outset, 0, outset + right_extension);
   }
 
   // The panel rect for a given field rect, before the suggestions add height.
@@ -127,11 +135,21 @@ struct ArcOmniboxPanelMetrics {
       return gfx::Rect();
     }
     gfx::Rect panel(field);
-    panel.Inset(-gfx::Insets::TLBR(outset, outset, bottom_outset, outset));
+    panel.Inset(-gfx::Insets::TLBR(outset, outset, bottom_outset,
+                                   outset + right_extension));
     return panel;
   }
 };
 
+// The sidebar-row panel's fixed width. Arc's measures 349.5pt regardless of
+// where its (user-resizable) sidebar edge falls under it, which reads as "wide
+// enough for a suggestion row", not as a proportion of anything -- so it is a
+// constant here, and the overhang past the sidebar is whatever is left after
+// the field's own width. One sample (a 281pt sidebar) cannot distinguish
+// "fixed width" from "fixed overhang"; if a second measurement ever does,
+// this is the line to revisit.
+inline constexpr int kArcSidebarPanelWidth = 350;
+
 // `card_radius` is the content card's corner radius and `field_radius` the
 // address field's; both must come from the callers' existing concentric chain
 // (system window radius -> card -> field), never be written down a second time
@@ -180,6 +198,50 @@ inline ArcOmniboxPanelMetrics ComputeArc
   metrics.shadow_elevation = 35;
   metrics.shadow_light_key = 0.07;
   metrics.shadow_light_ambient = 0.04;
+  metrics.shadow_dark_key = 0.14;
+  metrics.shadow_dark_ambient = 0.09;
+  return metrics;
+}
+
+// Where the toolbar goes while the sidebar row's field is being edited: a
+// host sharing the row's top-left corner, widened to the panel's own width so
+// the field IS as wide as the panel it stands on ("what you see is what you
+// get" -- the user's words, 2026-08-18). The row cannot host this itself: its
+// layer clips at the sidebar's width, and a field painted wider than its
+// clipped ancestors simply is not there. Height stays the row's own, so the
+// hand-off moves no pixels the eye can anchor to.
+inline gfx::Rect ArcSidebarEditHostBounds(const gfx::Rect& row) {
+  if (row.IsEmpty()) {
+    return gfx::Rect();
+  }
+  return gfx::Rect(row.origin(),
+                   gfx::Size(kArcSidebarPanelWidth, row.height()));
+}
+
+// The sidebar-hosted row's panel (hidden address bar mode) -- Arc's shape,
+// measured 2026-08-18: the panel shares the row's left and top edges exactly
+// (no outset -- there is no band margin to grow into and Arc grows none), runs
+// kArcSidebarPanelWidth wide out over the page, and overhangs the bottom the
+// same way the band's panel does. Sharing the field's top-left corner means
+// sharing its arc: the panel radius IS the field radius, the same
+// one-corner-one-arc rule that pinned the band panel's radius to the card's.
+// The shadow is the band panel's -- one panel, two hosts.
+inline ArcOmniboxPanelMetrics ComputeArcSidebarRowPanel(bool enabled,
+                                                        int field_width,
+                                                        int field_radius) {
+  ArcOmniboxPanelMetrics metrics;
+  if (!enabled) {
+    return metrics;
+  }
+  metrics.enabled = true;
+  metrics.outset = 0;
+  metrics.right_extension = std::max(0, kArcSidebarPanelWidth - field_width);
+  metrics.bottom_outset = kEmptyPanelBottomOutset;
+  metrics.field_radius = std::max(0, field_radius);
+  metrics.panel_radius = metrics.field_radius;
+  metrics.shadow_elevation = 35;
+  metrics.shadow_light_key = 0.07;
+  metrics.shadow_light_ambient = 0.04;
   metrics.shadow_dark_key = 0.14;
   metrics.shadow_dark_ambient = 0.09;
   return metrics;
Index: src/chrome/browser/ui/helium/arc_omnibox_panel_unittest.cc
===================================================================
--- src.orig/chrome/browser/ui/helium/arc_omnibox_panel_unittest.cc
+++ src/chrome/browser/ui/helium/arc_omnibox_panel_unittest.cc
@@ -4,6 +4,8 @@
 
 #include "chrome/browser/ui/helium/arc_omnibox_panel.h"
 
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state.h"
+
 #include "testing/gtest/include/gtest/gtest.h"
 #include "ui/gfx/geometry/rect.h"
 
@@ -147,5 +149,119 @@ TEST(ArcOmniboxPanelTest, ShadowIsFullyS
   EXPECT_GT(metrics.shadow_dark_ambient, metrics.shadow_light_ambient);
 }
 
+// --- The sidebar-hosted row's panel (M3.9b, Arc-measured 2026-08-18) ---
+
+// The row as M3.9a leaves it in a 200pt sidebar: 12,44 origin, 142 wide,
+// 28 tall, radius the padded frame's 14.
+constexpr gfx::Rect kRowField(12, 44, 142, 28);
+constexpr int kRowFieldRadius = 14;
+
+ArcOmniboxPanelMetrics RowMetrics() {
+  return ComputeArcSidebarRowPanel(/*enabled=*/true, kRowField.width(),
+                                   kRowFieldRadius);
+}
+
+// Arc's sidebar panel shares the row's left and top edges exactly and grows
+// only rightwards and down. Any outset on those two edges would push the
+// panel off the sidebar's own margins.
+TEST(ArcOmniboxPanelTest, SidebarPanelSharesTheRowTopLeft) {
+  const gfx::Rect panel = RowMetrics().PanelFor(kRowField);
+  EXPECT_EQ(kRowField.x(), panel.x());
+  EXPECT_EQ(kRowField.y(), panel.y());
+  EXPECT_EQ(kRowField.bottom() + kEmptyPanelBottomOutset, panel.bottom());
+}
+
+// The panel is kArcSidebarPanelWidth wide regardless of the field's width --
+// "wide enough for a suggestion row" is a property of the content, not of
+// where the sidebar's edge happens to be.
+TEST(ArcOmniboxPanelTest, SidebarPanelHasTheFixedWidth) {
+  EXPECT_EQ(kArcSidebarPanelWidth, RowMetrics().PanelFor(kRowField).width());
+  // A field already wider than the panel keeps its own width rather than
+  // getting a negative extension.
+  const ArcOmniboxPanelMetrics wide = ComputeArcSidebarRowPanel(
+      /*enabled=*/true, kArcSidebarPanelWidth + 50, kRowFieldRadius);
+  EXPECT_EQ(0, wide.right_extension);
+}
+
+// Sharing the top-left corner means sharing its arc: one corner, one radius.
+TEST(ArcOmniboxPanelTest, SidebarPanelRadiusIsTheFieldRadius) {
+  const ArcOmniboxPanelMetrics metrics = RowMetrics();
+  EXPECT_EQ(kRowFieldRadius, metrics.field_radius);
+  EXPECT_EQ(metrics.field_radius, metrics.panel_radius);
+}
+
+// The popup aligns itself through the same insets the panel grows by, so the
+// suggestion list and the empty panel agree on every edge (the band panel's
+// own invariant, restated for the asymmetric shape).
+TEST(ArcOmniboxPanelTest, SidebarAlignmentMatchesPanelSides) {
+  const ArcOmniboxPanelMetrics metrics = RowMetrics();
+  const gfx::Insets insets = metrics.alignment_insets();
+  EXPECT_EQ(0, insets.left());
+  EXPECT_EQ(0, insets.top());
+  EXPECT_EQ(0, insets.bottom());
+  EXPECT_EQ(kArcSidebarPanelWidth - kRowField.width(), insets.right());
+  gfx::Rect aligned(kRowField);
+  aligned.Inset(-insets);
+  const gfx::Rect panel = metrics.PanelFor(kRowField);
+  EXPECT_EQ(panel.x(), aligned.x());
+  EXPECT_EQ(panel.y(), aligned.y());
+  EXPECT_EQ(panel.width(), aligned.width());
+}
+
+// The band's own factory must stay exactly where M3.5 pinned it: the new
+// right_extension is the sidebar's alone.
+TEST(ArcOmniboxPanelTest, BandPanelHasNoRightExtension) {
+  const ArcOmniboxPanelMetrics metrics = Metrics();
+  EXPECT_EQ(0, metrics.right_extension);
+  const gfx::Rect panel = metrics.PanelFor(kField);
+  EXPECT_EQ(kField.CenterPoint().x(), panel.CenterPoint().x());
+}
+
+// Disabled sidebar metrics are as loudly unusable as the band's.
+TEST(ArcOmniboxPanelTest, SidebarDisabledYieldsNothing) {
+  const ArcOmniboxPanelMetrics metrics = ComputeArcSidebarRowPanel(
+      /*enabled=*/false, kRowField.width(), kRowFieldRadius);
+  EXPECT_FALSE(metrics.enabled);
+  EXPECT_EQ(0, metrics.right_extension);
+  EXPECT_TRUE(metrics.PanelFor(kRowField).IsEmpty());
+}
+
+// The edit host shares the row's origin exactly and takes the panel's width:
+// the field standing in it IS the panel's top row, so any offset or width
+// delta is a visible seam.
+TEST(ArcOmniboxPanelTest, EditHostSharesOriginAtPanelWidth) {
+  const gfx::Rect host = ArcSidebarEditHostBounds(kRowField);
+  EXPECT_EQ(kRowField.origin(), host.origin());
+  EXPECT_EQ(kArcSidebarPanelWidth, host.width());
+  EXPECT_EQ(kRowField.height(), host.height());
+  EXPECT_TRUE(ArcSidebarEditHostBounds(gfx::Rect()).IsEmpty());
+}
+
+// With the field widened to the panel's width the sidebar metrics collapse to
+// "the panel IS the field plus its apron": zero extension, aligned popup.
+// This is the geometric statement of what-you-see-is-what-you-get.
+TEST(ArcOmniboxPanelTest, PanelEqualsFieldOnceFieldIsPanelWide) {
+  const ArcOmniboxPanelMetrics metrics = ComputeArcSidebarRowPanel(
+      /*enabled=*/true, kArcSidebarPanelWidth, kRowFieldRadius);
+  EXPECT_EQ(0, metrics.right_extension);
+  EXPECT_TRUE(metrics.alignment_insets().IsEmpty());
+  const gfx::Rect wide_field(kRowField.origin(),
+                             gfx::Size(kArcSidebarPanelWidth, kRowField.height()));
+  const gfx::Rect panel = metrics.PanelFor(wide_field);
+  EXPECT_EQ(wide_field.x(), panel.x());
+  EXPECT_EQ(wide_field.y(), panel.y());
+  EXPECT_EQ(wide_field.width(), panel.width());
+  EXPECT_EQ(wide_field.bottom() + kEmptyPanelBottomOutset, panel.bottom());
+}
+
+// The sidebar's default width, pinned with its derivation: 2x6 side padding
+// + ~76 caption exclusion + 6 buttons' worth (collapse + two of air + three
+// navigation) at 28 each. Bounded by the resize clamp [160, 400].
+TEST(ArcOmniboxPanelTest, SidebarDefaultWidthLeavesTopRowAir) {
+  EXPECT_EQ(256, tabs::kVerticalTabStripDefaultUncollapsedWidth);
+  EXPECT_GE(tabs::kVerticalTabStripDefaultUncollapsedWidth, 160);
+  EXPECT_LE(tabs::kVerticalTabStripDefaultUncollapsedWidth, 400);
+}
+
 }  // namespace
 }  // namespace helium
