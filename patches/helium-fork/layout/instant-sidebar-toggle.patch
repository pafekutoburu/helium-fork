-  constexpr int kExpandCollapseDurationMs = 250;
+  // helium-fork: the sidebar toggle lands in one frame instead of animating.
+  //
+  // Animating means relaying the page out every frame (~28 times per toggle,
+  // 57ms each on a heavy page even in an official build) -- that is what made
+  // the scrollbar jitter. And every in-between frame has the renderer lagging
+  // the layout: the page takes a beat to re-render at each new width, and
+  // until it catches up viz displays the old frame with a page-colored gutter
+  // strip beside it. One instant motion means one relayout and one catch-up,
+  // and the BrowserView toggle choreography hides that one entirely by
+  // holding the flip until the renderer's resized frame has activated (see
+  // BrowserView::MaybeHandleSidebarCollapseRequest). These motions are the
+  // substrate that choreography rides on: kExpand/kCollapse still fire, flip
+  // the layout state for one pass, and end.
+  constexpr int kExpandCollapseDurationMs = 0;
   constexpr gfx::Tween::Type kExpandCollapseTween =
