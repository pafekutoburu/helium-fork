--- src.orig/chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_impl.cc
+++ src/chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_impl.cc
@@ -908,8 +908,34 @@ BrowserViewTabbedLayoutImpl::CalculatePr
       }
 
       vertical_tab_strip_width = vertical_tab_strip_bounds.width();
+      // helium-fork: the toggle is instant (see tab_strip_animations.cc), but
+      // the animation machinery still reports a motion for a frame or two on
+      // its way to the end value, and measurement showed the contents picking
+      // up those in-between widths -- an extra relayout of the page per toggle
+      // and a frame of visible flicker. Inset by the width the sidebar is
+      // heading for instead, so the contents are laid out once, at the size
+      // they keep.
+      const bool sidebar_toggle_in_progress =
+          vertical_tab_strip_animation.current_motion ==
+              TabStripAnimations::kExpand ||
+          vertical_tab_strip_animation.current_motion ==
+              TabStripAnimations::kCollapse;
       if (!zen.floating_vertical_tab_strip) {
         int inset_amount = vertical_tab_strip_width;
+        if (sidebar_toggle_in_progress) {
+          const int target_width =
+              vertical_tab_strip_animation.current_motion ==
+                      TabStripAnimations::kCollapse
+                  ? VerticalTabStripRegionView::kCollapsedWidth
+                  : views().vertical_tab_strip_region_view->uncollapsed_width();
+          // A narrow window can leave less room than the target asks for; the
+          // width above is clamped the same way.
+          inset_amount = std::clamp(
+              target_width, VerticalTabStripRegionView::kCollapsedWidth,
+              std::max(VerticalTabStripRegionView::kCollapsedWidth,
+                       params.visual_client_area.width() -
