@@ -687,6 +687,22 @@ void VerticalTabStripRegionView::Request
   if (!tab_strip_view_) {
     return;
   }
+  // helium-fork: every runtime toggle (Cmd+S, toolbar button, View menu,
+  // drag-to-collapse) funnels through the BrowserView choreography, which
+  // sequences the slide and the atomic contents swap. It returns false when
+  // it does not apply (zen mode, non-vertical layout, ...), in which case the
+  // motion starts directly as before.
+  if (browser_view_ &&
+      browser_view_->MaybeHandleSidebarCollapseRequest(collapse)) {
+    return;
+  }
+  StartCollapseMotionNow(collapse);
+}
