 void BrowserView::AnimationEnded(const gfx::Animation* animation) {
   AnimationProgressed(animation);
+  // helium-fork: end of the hidden-sidebar toggle choreography. Only HIDE
+  // slides (the card gliding out over the already-swapped contents); its end
+  // returns ownership of the animation to the hover logic. The collapse
+  // notifications fired during the choreography were swallowed by the phase
+  // guard, so the hover monitor must be (un)installed here -- without this
+  // the edge reveal is dead after every toggle-hide.
+  if (animation == &zen_side_chrome_animation_ &&
+      sidebar_toggle_phase_ == SidebarTogglePhase::kSliding) {
+    sidebar_toggle_phase_ = SidebarTogglePhase::kIdle;
+    UpdateZenModeEventMonitor();
+  }
 }
 
