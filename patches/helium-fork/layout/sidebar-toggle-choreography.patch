+bool BrowserView::MaybeHandleSidebarCollapseRequest(bool collapse) {
+  // helium-fork: choreographs the hidden-sidebar toggle. Returns false to let
+  // the caller run the plain instant motion instead: zen mode keeps its own
+  // semantics, and non-vertical layouts, an uninitialized strip, or an
+  // invisible widget have nothing to choreograph.
+  if (zen_mode_enabled_ || !ShouldDrawVerticalTabStrip() ||
+      !vertical_tab_strip_region_view_ ||
+      !vertical_tab_strip_region_view_->GetTabStripView() || !GetWidget() ||
+      !GetWidget()->IsVisible()) {
+    return false;
+  }
+  if (sidebar_toggle_phase_ != SidebarTogglePhase::kIdle) {
+    // A toggle is already in flight (phases last <= ~200ms). Requests landing
+    // in that window necessarily aim at the same direction -- the controller
+    // state only flips when a toggle completes -- so treat them as
+    // already-in-progress.
+    return true;
+  }
+  // A hover grace timer from earlier could otherwise fire mid-choreography
+  // and drive the slide it no longer owns.
+  zen_cursor_exit_timer_.Stop();
+  if (collapse) {
+    // HIDE: flip the layout to floating-over-full-width contents under a viz
+    // hold -- the previous frame stays on glass until the renderer delivers
+    // the full-width frame, then chrome and contents swap in one activation
+    // -- and slide the card out over the new contents.
+    ArmContentsResizeHold();
+    zen_side_chrome_animation_.Reset(1);
+    vertical_tab_strip_region_view_->StartCollapseMotionNow(true);
+    DeprecatedLayoutImmediately();
+    DisarmContentsResizeHold();
+    sidebar_toggle_phase_ = SidebarTogglePhase::kSliding;
+    zen_side_chrome_animation_.Hide();
+  } else {
+    // SHOW: one atomic flip -- the docked sidebar and the resized contents
+    // land on glass in the same activation, with nothing sliding first. A
+    // slide-in was tried and rejected: it reads as a two-step stutter, and
+    // the card-to-docked restyle at the end is exactly the kind of extra
+    // motion this toggle is supposed to avoid. A hover-revealed card is
+    // simply absorbed by the same flip.
+    RunSidebarDockFlip();
+  }
+  return true;
+}
+
+void BrowserView::RunSidebarDockFlip() {
+  sidebar_toggle_phase_ = SidebarTogglePhase::kFlipping;
+  ArmContentsResizeHold();
+  vertical_tab_strip_region_view_->StartCollapseMotionNow(false);
+  DeprecatedLayoutImmediately();
+  DisarmContentsResizeHold();
+  sidebar_toggle_phase_ = SidebarTogglePhase::kIdle;
+  UpdateZenModeEventMonitor();
+}
+
+void BrowserView::ArmContentsResizeHold() {
+  if (!multi_contents_view_) {
+    return;
+  }
+  for (ContentsContainerView* pane :
+       multi_contents_view_->contents_container_views()) {
+    for (views::WebView* web_view :
+         {static_cast<views::WebView*>(pane->contents_view()),
+          pane->devtools_web_view()}) {
+      content::WebContents* contents =
+          web_view ? web_view->web_contents() : nullptr;
+      if (!contents) {
+        continue;
+      }
+      if (content::RenderWidgetHostView* rwhv =
+              contents->GetRenderWidgetHostView()) {
+        rwhv->SetForceSpecifiedDeadline(kSidebarToggleHoldFrames);
+        sidebar_hold_web_contents_.push_back(contents->GetWeakPtr());
+      }
+    }
+  }
+}
+
+void BrowserView::DisarmContentsResizeHold() {
+  // Clears exactly what was armed; a tab switched away mid-hold is still
+  // reachable through its WebContents.
+  for (auto& weak : sidebar_hold_web_contents_) {
+    if (content::WebContents* contents = weak.get()) {
+      if (content::RenderWidgetHostView* rwhv =
+              contents->GetRenderWidgetHostView()) {
+        rwhv->SetForceSpecifiedDeadline(std::nullopt);
+      }
+    }
+  }
+  sidebar_hold_web_contents_.clear();
+}
