+bool BrowserView::IsSidebarHiddenModeActive() const {
+  // helium-fork: outside zen mode, a collapsed vertical tab strip is fully
+  // hidden (Arc behavior) and reuses zen's floating reveal. Fullscreen is
+  // deliberately allowed: the zen branch disables itself there, so this one
+  // keeps Cmd+S and edge reveal working.
+  if (zen_mode_enabled_ || !GetIsNormalType() || !GetSupportsTabStrip() ||
+      !ShouldDrawVerticalTabStrip()) {
+    return false;
+  }
+  auto* controller = tabs::VerticalTabStripStateController::From(browser_);
+  return controller && controller->GetCollapseState() !=
+                           tabs::VerticalTabStripCollapseState::kExpanded;
+}
+
+void BrowserView::OnSidebarCollapseStateChanged(
+    tabs::VerticalTabStripCollapseState state) {
+  // helium-fork: keep the reveal ratio in step with the collapse state so the
+  // hidden strip conceals/reveals instantly with the toggle. In zen mode the
+  // reveal logic owns the animation; do not fight it.
+  if (zen_mode_enabled_) {
+    return;
+  }
+  if (state == tabs::VerticalTabStripCollapseState::kExpanded) {
+    zen_side_chrome_animation_.Reset(1);
+  } else {
+    zen_side_chrome_animation_.Reset(0);
+  }
+  InvalidateLayout();
+}
