+void ToolbarView::SetArcSidebarHosted(bool hosted) {
+  if (arc_sidebar_hosted_ == hosted) {
+    return;
+  }
+  arc_sidebar_hosted_ = hosted;
+  // helium-fork: the Zen row treatment. Inside the sidebar the row is the
+  // domain plus a single extensions-menu button: every pinned extension
+  // collapses into that button's panel, and the avatar and the app menu go
+  // away entirely -- Zen hides its three-dot menu on macOS too, because the
+  // native menu bar already carries everything in it (profiles included).
+  // Undone verbatim when the toolbar moves back to the band.
+  if (extensions_container_) {
+    extensions_container_->SetSuppressPinnedActions(hosted);
+  }
+  if (avatar_) {
+    avatar_->SetVisible(!hosted && show_avatar_button_.GetValue());
+  }
+  if (app_menu_button_) {
+    app_menu_button_->SetVisible(!hosted);
+  }
+  UpdateToolbarLayout();
+}
