+void BrowserView::UpdateArcAddressBarPlacement() {
+  // helium-fork: HeliumAddressBarMode::kHidden -- Arc's default shape. There is
+  // no band above the page; the address bar moves into the sidebar, under the
+  // top row.
+  //
+  // The whole ToolbarView moves, not just the omnibox. ToolbarView lays out its
+  // own children, so one reparent carries the omnibox and the extensions /
+  // profile / menu buttons along with it, right-aligned in the same row, and
+  // its flex layout drops what a 200pt sidebar cannot fit -- no second layout
+  // to write and no assumptions inside ToolbarView to break. Everything that
+  // skips the band when it is absent is already guarded by
+  // IsParentedTo(toolbar, top_container) in the layout, so the top container
+  // measures zero, stops counting as attached top chrome, and the contents card
+  // closes up on all four sides on its own.
+  if (!toolbar_ || !vertical_tab_strip_region_view_) {
+    return;
+  }
+  views::View* const address_row =
+      vertical_tab_strip_region_view_->arc_address_row();
+  if (!address_row) {
+    return;
+  }
+  auto* const layout_controller = HeliumLayoutStateController::From(browser_);
+  const bool wants_toolbar_in_sidebar =
+      layout_controller && !layout_controller->HasAddressBarBand() &&
+      ShouldDrawVerticalTabStrip() && GetIsNormalType();
+
+  if (wants_toolbar_in_sidebar) {
+    if (toolbar_->parent() == address_row) {
+      return;
+    }
+    address_row->AddChildView(toolbar_.get());
+  } else {
+    if (toolbar_->parent() == top_container_) {
+      return;
+    }
+    top_container_->AddChildViewAt(toolbar_.get(), 0);
+  }
+  // The toolbar keeps its CustomCornersBackground either way: the band's
+  // layout pass reaches for it by type to apply the page tint, and swapping it
+  // out here would leave that with nothing to configure. In the sidebar it
+  // paints kColorToolbar, which is the sidebar's own color, so it disappears.
+  toolbar_->SetArcSidebarHosted(wants_toolbar_in_sidebar);
+  toolbar_->UpdateToolbarLayout();
+  // helium-fork: the page tint is published on the toolbar as a cascading
+  // property, and everything under it -- button icons, the omnibox's own
+  // opaque field fill -- derives a contrasting foreground from it. Moving the
+  // toolbar changes which surface it is standing on, but nothing else asks for
+  // a re-sample: the only callers are the page-color observers. So without
+  // this the toolbar arrived in the white sidebar still carrying the last
+  // page's black, painting a black pill behind the domain and turning every
+  // button icon white-on-white. GetAddressBarBandTint() already answers
+  // nullopt once there is no band, so one unconditional call is the whole fix,
+  // and putting it here rather than at the mode-change callback covers the
+  // layout-change and initialization callers too.
+  UpdateAddressBarBandTint();
+  InvalidateLayout();
+}
