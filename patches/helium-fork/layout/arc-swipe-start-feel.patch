+void WorkspaceTabController::FlushDeferredBlankClose() {
+  if (deferred_blank_close_.empty()) {
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<WorkspaceTabController> self) {
+                       if (!self || self->defer_blank_close_ ||
+                           self->browser_window_->IsDeleteScheduled()) {
+                         return;
+                       }
+                       // Not the current space, nor one a slide still
+                       // shows (another deferred release left the views on
+                       // it; reviewer code r2) -- that one waits for its
+                       // own flush.
+                       const std::vector<std::string> spaces =
+                           std::exchange(self->deferred_blank_close_, {});
+                       for (const std::string& space : spaces) {
+                         if (space == self->shown_space_id()) {
+                           self->deferred_blank_close_.push_back(space);
+                         } else if (space != self->current_space_id_) {
+                           self->CloseAbandonedBlankTab(space);
+                         }
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
