+void SpaceCarousel::SwapToCommitted() {
+  if (!deferred_) {
+    return;
+  }
+  deferred_ = false;
+  live_slot_ = committed_slot_;
+  live_space_ = committed_space_;
+  // Its picture gives way to the real list.
+  slots_.erase(live_slot_);
+  helium_workspace::WorkspaceTabController* const controller =
+      delegate_->CarouselController();
+  if (controller) {
+    controller->SetViewSpaceOverride(std::string());
+  }
+  TabStripView* const strip = delegate_->CarouselStrip();
+  if (strip && strip->GetWidget()) {
+    // The switch's own re-filter, now that nothing moves -- Today lets go of
+    // the leaving row's card here (CarouselResyncViews).
+    delegate_->CarouselResyncViews(/*keep_state=*/false);
+    RestoreLiveViews(live_space_);
+  } else {
+    views_stale_ = true;
+  }
+  // Today lets go even when the resync skipped it (a drag in Today right
+  // now; reviewer final r1) -- EndCaptureActiveTab is a no-op otherwise.
+  delegate_->CarouselHoldShownActive(false);
+  if (controller) {
+    controller->FlushDeferredBlankClose();
+  }
+}
+
+void SpaceCarousel::ReconcileLive() {
+  if (!deferred_) {
+    return;
+  }
+  TabStripView* const strip = delegate_->CarouselStrip();
+  if (strip && strip->GetWidget()) {
+    // The views show the space left, laid out and scrolled as it was, its
+    // selected row wearing the card: photographed as they stand.
+    Slot picture;
+    picture.space_id = live_space_;
+    picture.layers = strip->CaptureListSnapshot();
+    for (auto& shadow : delegate_->CarouselCaptureRowShadows()) {
+      picture.layers.push_back(std::move(shadow));
+    }
+    picture_bottom_ = std::max(picture_bottom_, strip->height());
+    slots_[live_slot_] = std::move(picture);
+  }
+  SwapToCommitted();
+  if (active_) {
+    Apply();
+  }
+}
+
+void SpaceCarousel::EnsureLiveViews() {
+  if (!std::exchange(views_stale_, false)) {
+    return;
+  }
+  TabStripView* const strip = delegate_->CarouselStrip();
+  if (!strip || !strip->GetWidget()) {
+    views_stale_ = true;
+    return;
+  }
+  delegate_->CarouselResyncViews(/*keep_state=*/false);
+  if (!active_) {
+    RestoreLiveViews(live_space_);
+  }
+}
