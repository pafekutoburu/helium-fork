 }
 
 gfx::Insets OmniboxRowView::GetInsets() const {
-  return gfx::Insets::TLBR(2, 4, 0, 4);
+  // helium-fork r8.6: the Arc shell's list is `Dia:`'s, measured 2026-08-22 --
+  // a 36pt selected band inset 7.5 a side inside a 40pt pitch (upstream: 28 in
+  // a 30pt pitch, inset 4). The numbers live in helium/arc_composer.h because
+  // they are one measurement with the composer box's height: its icon column
+  // and this row's icon column have to be the same column, and that is what
+  // fixes the box's height (see the static_assert there).
+  //
+  // Unconditional, not composer-only: this shell has exactly one popup and it
+  // wears the same panel in all three hosts (band, sidebar row, composer), so a
+  // list that changed shape between them would be the thing that looks wrong.
+  return gfx::Insets::TLBR(helium::kArcComposerListRowGap,
+                           helium::kArcComposerListRowInset,
+                           helium::kArcComposerListRowGap,
+                           helium::kArcComposerListRowInset);
 }
 
