   mixer[kColorOmniboxComposeboxFaviconBackground] = {
       kColorOmniboxComposeboxChipBackground};
   mixer[kColorOmniboxForegroundDisabled] = {kColorOmniboxTextDimmed};
+
+  // helium-fork r8.6: the Arc shell's two measured greys. `Dia:` puts its
+  // resting placeholder AND the magnifier beside it at (152,153,153) on a
+  // (254,255,255) card, and its "Hold ⌘ to switch" row hint one step lighter
+  // again at (187,188,188) (both measured 2026-08-22 off the live window).
+  // r8.5 used kColorOmniboxTextDimmed here, which measures L71 on our card --
