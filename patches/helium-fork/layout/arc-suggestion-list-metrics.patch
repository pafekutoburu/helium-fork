+  // Dia ("示意文字的灰度也参考Dia", 2026-08-22).
+  //
+  // ⚠ Dark is UNMEASURED -- `Dia:` has only ever been captured light -- so it
+  // keeps upstream's dimmed id rather than an invented number.
+  mixer[kColorOmniboxArcComposerHint] = ui::SelectBasedOnDarkInput(
+      kColorOmniboxResultsBackground,
+      /*output_for_dark_input=*/kColorOmniboxTextDimmed,
+      /*output_for_light_input=*/helium::kArcComposerHintColor);
+  mixer[kColorOmniboxArcRowActionHint] = ui::SelectBasedOnDarkInput(
+      kColorOmniboxResultsBackground,
+      /*output_for_dark_input=*/kColorOmniboxTextDimmed,
+      /*output_for_light_input=*/helium::kArcComposerRowActionHintColor);
   mixer[kColorOmniboxComposeboxPrimaryAction] = ui::SelectBasedOnDarkInput(
       kColorOmniboxResultsBackground, gfx::kGoogleBlue200, gfx::kGoogleBlue600);
   mixer[kColorOmniboxComposeboxSubmitButtonBackground] = {
@@ -518,4 +538,40 @@ void AddOmniboxColorMixer(ui::ColorProvi
 
   // Apply specific baseline colors for the composebox submit button.
   ApplyComposeboxBaselineColors(mixer, key);
+
+  // helium-fork r8.6: and last, the two list colours the Arc shell reads off
+  // `Dia:` rather than off GM3 -- the user asked for the composer's list to be
+  // Dia's, item for item ("基本上，中央框的所有UI和交互可以一比一复刻dia",
+  // 2026-08-22). Both measured 2026-08-22 on a (254,255,255) card:
+  //
+  //   selected/hovered row   `Dia:` (225,226,227)  ours was L242 -- Dia's
+  //                          selection is twice the contrast of GM3's
+  //                          hover-on-subtle wash, and at a 40pt row pitch the
+  //                          weaker one stops reading as a selection at all.
+  //   suggestion URL         `Dia:` (100,105,116)  ours was kColorSysPrimary,
+  //                          i.e. blue. Dia writes the URL half of a row in
+  //                          grey and lets the title carry the row.
+  //
+  // Placed after every upstream pass on purpose: ApplyGM3OmniboxTextColor and
+  // ApplyOmniboxCR2023Colors both assign these, so anything earlier would be
+  // silently overwritten (this file assigns kColorOmniboxResultsUrl three times
+  // already).
+  //
+  // ⚠ Light only, again: `Dia:` has never been captured dark. In dark mode the
+  // recipes above stand, which is why this is a SelectBasedOnDarkInput rather
+  // than a flat assignment.
+  // ⚠ `+=`, not `=`: a recipe that names its own id would recurse. Chaining
+  // hands the previous result in as the transform's input, and
+  // ui::FromTransformInput() is how the dark branch says "keep it".
+  mixer[kColorOmniboxResultsBackgroundHovered] += ui::SelectBasedOnDarkInput(
+      kColorOmniboxResultsBackground,
+      /*output_for_dark_input=*/ui::FromTransformInput(),
+      /*output_for_light_input=*/helium::kArcListRowSelectedColor);
+  mixer[kColorOmniboxResultsBackgroundSelected] = {
+      kColorOmniboxResultsBackgroundHovered};
+  mixer[kColorOmniboxResultsUrl] += ui::SelectBasedOnDarkInput(
+      kColorOmniboxResultsBackground,
+      /*output_for_dark_input=*/ui::FromTransformInput(),
+      /*output_for_light_input=*/helium::kArcListUrlColor);
+  mixer[kColorOmniboxResultsUrlSelected] = {kColorOmniboxResultsUrl};
 }
