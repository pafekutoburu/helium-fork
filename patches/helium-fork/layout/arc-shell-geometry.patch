+
+int BrowserView::GetArcShellCaptionBandHeight() const {
+  // helium-fork: the height of the band the macOS window controls must be
+  // centered in. Zero means "not the Arc shell -- leave the system default".
+  //
+  // AppKit vertically centers the traffic lights in whatever titlebar height
+  // Chromium reports, and BrowserFrameViewMac::GetCaptionButtonBounds() hard
+  // codes the y that produces (its numbers are exactly
+  // (toolbar_height - button_height) / 2). The Arc shell then insets its top
+  // chrome by kContentCardInset, so the toolbar row -- and the sidebar top row
+  // laid out beside it -- ended up that much below the lights, while the
+  // lights stayed pinned to the window edge. Reporting a band that includes
+  // the inset on both sides puts them back on one center line, in every state,
+  // without anyone having to guess a magic offset.
+  if (!toolbar_ || !multi_contents_view_ ||
+      !multi_contents_view_->ShouldUseRoundedFrame() ||
+      !ShouldUseContentCardInsets()) {
+    return 0;
+  }
+  return toolbar_->GetMinimumSize().height() +
+         2 * MultiContentsView::kContentCardInset;
+}
+
+void BrowserView::UpdateCaptionButtonsOpacityForChromeState() {
+  auto* frame_view = GetFrameView();
+  if (!frame_view) {
+    return;
+  }
+  // helium-fork: the window controls are drawn over whatever chrome is under
+  // them, so they are visible while EITHER possible host is on screen:
+  //
+  //   * the sidebar's top row -- unless the sidebar is hidden, in which case
+  //     they fade in and out with the floating card. A right-aligned sidebar
+  //     never covers that corner, so it is not a host at all.
+  //   * the address bar band -- unless the mode has no band (kHidden), or zen
+  //     has it hidden, in which case they follow its reveal.
+  //
+  // Tying them to the sidebar alone left a window with a docked band and a
+  // collapsed sidebar showing no traffic lights whatsoever, which is both
+  // wrong and unclosable by mouse.
+  float sidebar_host = 0.0f;
+  if (!IsVerticalTabStripRightAligned()) {
+    sidebar_host =
+        IsSidebarHiddenModeActive() ? GetSideChromeRevealRatio() : 1.0f;
+  }
+  float band_host = 0.0f;
+  if (auto* const layout_controller =
+          HeliumLayoutStateController::From(browser_);
+      layout_controller && layout_controller->HasAddressBarBand()) {
+    band_host = IsZenModeEnabled() ? GetTopChromeRevealRatio() : 1.0f;
+  }
+  frame_view->SetCaptionButtonsOpacity(std::max(sidebar_host, band_host));
+}
