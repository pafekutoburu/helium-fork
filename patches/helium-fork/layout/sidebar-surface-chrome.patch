+      GetWidget() &&
+      helium::CanShowCardShadow(target->width(), target->height(), radius);
+  gfx::RectF rect;
+  if (shadow_visible) {
+    rect = gfx::RectF(gfx::SizeF(target->size()));
+    views::View::ConvertRectToTarget(target, shadow_parent, &rect);
+    rect.Offset(-scroll_view->CurrentOffset().x(),
+                -scroll_view->CurrentOffset().y());
+    // The region's layer never clips, so a row scrolled to the section's
+    // edge would cast outside the scroll area; hide instead (the row's own
+    // card is being clipped there anyway).
+    gfx::RectF scroll_rect(gfx::SizeF(scroll_view->size()));
+    views::View::ConvertRectToTarget(scroll_view, shadow_parent, &scroll_rect);
+    scroll_rect.Inset(-1.0f);
+    shadow_visible = scroll_rect.Contains(rect);
+  }
+  if (!shadow_visible) {
+    card_shadow_->SetVisible(false);
+    return;
+  }
+  card_shadow_->SetShadowCornerRadius(radius);
+  // The card rect, not the (outset) shadow rect: SetCardBounds() grows the
+  // view itself, and the edge test above must keep judging the row.
+  card_shadow_->SetCardBounds(gfx::ToEnclosingRect(rect));
+  card_shadow_->SetVisible(true);
 }
 
