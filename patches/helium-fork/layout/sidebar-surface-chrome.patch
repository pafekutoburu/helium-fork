+void WorkspaceSidebarView::UpdateCardShadow() {
+  if (!card_shadow_) {
+    return;
+  }
+  // The pinned section's own scroll view (this view's parent is its
+  // contents); independent of Today's.
+  views::ScrollView* const scroll_view =
+      parent() ? views::ScrollView::GetScrollViewForContents(parent())
+               : nullptr;
+  // Layer scrolling never touches view bounds, so no observer fires when the
+  // section scrolls under the row -- follow the offset directly.
+  if (scroll_view && !card_shadow_scroll_subscription_) {
+    card_shadow_scroll_subscription_ = scroll_view->AddContentsScrolledCallback(
+        base::BindRepeating(&WorkspaceSidebarView::UpdateCardShadow,
+                            base::Unretained(this)));
