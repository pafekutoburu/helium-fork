+void WorkspaceEntryView::PaintFavoriteAccent(gfx::Canvas* canvas,
+                                             const gfx::RectF& bounds,
+                                             float radius,
+                                             float stroke_width) const {
+  if (accent_.isNull() || bounds.IsEmpty()) {
+    return;
+  }
+  // helium-fork: `accent_` is the favicon boxed down to a few pixels. Scaling
+  // it back up with a smooth filter is the blur -- it reproduces both halves
+  // of what Arc's selected card actually shows: the warm-to-cool run that
+  // follows the icon's own colors left to right, and the chroma peaking on the
+  // icon's row and falling off toward the edges. A single dominant color gives
+  // neither.
+  const gfx::ImageSkiaRep& rep = accent_.GetRepresentation(1.0f);
+  if (rep.is_null() || rep.pixel_width() <= 0 || rep.pixel_height() <= 0) {
+    return;
+  }
+  SkMatrix matrix = SkMatrix::MakeRectToRect(
+      SkRect::MakeIWH(rep.pixel_width(), rep.pixel_height()),
+      gfx::RectFToSkRect(bounds), SkMatrix::kFill_ScaleToFit);
+  const sk_sp<cc::PaintShader> shader = gfx::CreateImageRepShader(
+      rep, SkTileMode::kClamp, SkTileMode::kClamp, matrix);
+  if (!shader) {
+    return;
+  }
+
+  // The wash is the raw field at a whisper; the ring samples the lifted copy
+  // (ring_accent_) at full opacity, so its brightness is set by the lightness
+  // floor rather than by what shows through from underneath.
+  cc::PaintFlags wash;
+  wash.setStyle(cc::PaintFlags::kFill_Style);
+  wash.setAntiAlias(true);
+  wash.setFilterQuality(cc::PaintFlags::FilterQuality::kHigh);
+  wash.setShader(shader);
+  wash.setAlphaf(helium::kFavoriteAccentFillAlpha);
+  canvas->DrawRoundRect(bounds, radius, wash);
+
+  const gfx::ImageSkiaRep& ring_rep = ring_accent_.GetRepresentation(1.0f);
+  if (ring_rep.is_null() || ring_rep.pixel_width() <= 0 ||
+      ring_rep.pixel_height() <= 0) {
+    return;
+  }
+  const sk_sp<cc::PaintShader> ring_shader = gfx::CreateImageRepShader(
+      ring_rep, SkTileMode::kClamp, SkTileMode::kClamp, matrix);
+  if (!ring_shader) {
+    return;
+  }
+  cc::PaintFlags ring;
+  ring.setStyle(cc::PaintFlags::kStroke_Style);
+  ring.setStrokeWidth(stroke_width);
+  ring.setAntiAlias(true);
+  ring.setFilterQuality(cc::PaintFlags::FilterQuality::kHigh);
+  ring.setShader(ring_shader);
+  ring.setAlphaf(helium::kFavoriteAccentStrokeAlpha);
+  gfx::RectF rect(bounds);
+  rect.Inset(stroke_width / 2.0f);
+  canvas->DrawRoundRect(rect, radius - stroke_width / 2.0f, ring);
+}
