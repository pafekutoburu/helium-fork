+#include "chrome/browser/ui/helium/arc_sidebar_surface.h"
+
+#include <algorithm>
+#include <iterator>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+// The three sidebars Arc was measured on (all 2026-08-19, active window).
+constexpr SkColor kDarkSidebar = SkColorSetRGB(0x74, 0x74, 0x74);   // L116
+constexpr SkColor kLightSidebar = SkColorSetRGB(0xF2, 0xF2, 0xF2);  // L242
+constexpr SkColor kGraySidebar = SkColorSetRGB(0xDE, 0xDE, 0xDE);   // L222
+
+int Luminance(SkColor color) {
+  return (SkColorGetR(color) + SkColorGetG(color) + SkColorGetB(color)) / 3;
+}
+
+// Arc 2026-08-19, three spaces: dark L116 -> L129 rest / L136 hovered, light
+// L242 -> L230, light L222 -> L212.5. One gray at one alpha has to hit all
+// three -- the contrast-color model fit only the dark space and shipped twice
+// as heavy on light themes (r2, user-reported). ⚠ Neither light space was
+// measured hovered, so only the dark hover value is pinned.
+TEST(ArcSidebarSurfaceTest, MatchesTheMeasuredArcValues) {
+  EXPECT_NEAR(129, Luminance(GetSidebarSurfaceColor(kDarkSidebar,
+                                                    /*hovered=*/false)),
+              1);
+  EXPECT_NEAR(136, Luminance(GetSidebarSurfaceColor(kDarkSidebar,
+                                                    /*hovered=*/true)),
+              1);
+  EXPECT_NEAR(230, Luminance(GetSidebarSurfaceColor(kLightSidebar,
+                                                    /*hovered=*/false)),
+              1);
+  EXPECT_NEAR(214, Luminance(GetSidebarSurfaceColor(kGraySidebar,
+                                                    /*hovered=*/false)),
+              2);
+}
+
+// The wash is a fixed mid-gray, so a light theme darkens where a dark one
+// lightens. A hard-coded white would make the light theme's capsule
+// invisible.
+TEST(ArcSidebarSurfaceTest, ALightSidebarDarkensInstead) {
+  for (const bool hovered : {false, true}) {
+    EXPECT_GT(Luminance(GetSidebarSurfaceColor(kDarkSidebar, hovered)),
+              Luminance(kDarkSidebar));
+    EXPECT_LT(Luminance(GetSidebarSurfaceColor(kLightSidebar, hovered)),
+              Luminance(kLightSidebar));
+  }
+}
+
+// Hover is always the stronger of the two, whichever direction the wash goes.
+TEST(ArcSidebarSurfaceTest, HoverIsAlwaysFartherFromTheSidebar) {
+  for (const SkColor sidebar : {kDarkSidebar, kLightSidebar, kGraySidebar}) {
+    const int base = Luminance(sidebar);
+    const int rest = Luminance(GetSidebarSurfaceColor(sidebar,
+                                                      /*hovered=*/false));
+    const int hovered = Luminance(GetSidebarSurfaceColor(sidebar,
+                                                         /*hovered=*/true));
+    EXPECT_GT(std::abs(hovered - base), std::abs(rest - base));
+  }
+}
+
+// Arc 2026-08-19, both of the user's spaces: dark sidebar L116 -> card L167,
+// light sidebar L242 -> card L247. Two very different steps, one rule.
+TEST(ArcSidebarSurfaceTest, TheSelectedCardMatchesTheMeasuredArcValues) {
+  EXPECT_NEAR(167, Luminance(GetSidebarSelectedSurfaceColor(kDarkSidebar)), 2);
+  EXPECT_NEAR(247, Luminance(GetSidebarSelectedSurfaceColor(kLightSidebar)), 2);
+}
+
+// The one that would have caught the light-theme bug: the selected card is lit
+// in *either* theme. Derived from the contrasting color it fits the dark
+// measurement and comes out darker than its neighbours on a light sidebar.
+TEST(ArcSidebarSurfaceTest, TheSelectedCardIsAlwaysLighter) {
+  for (const SkColor sidebar : {kDarkSidebar, kLightSidebar, kGraySidebar}) {
+    EXPECT_GT(Luminance(GetSidebarSelectedSurfaceColor(sidebar)),
+              Luminance(sidebar));
+  }
+}
+
+// ...and it is the odd one out: the unselected fills step toward the fixed
+// gray, so on a light sidebar they go the other way.
+TEST(ArcSidebarSurfaceTest, TheUnselectedFillsStepTowardTheGray) {
+  EXPECT_LT(Luminance(GetSidebarSurfaceColor(kLightSidebar,
+                                             /*hovered=*/false)),
+            Luminance(kLightSidebar));
+  EXPECT_GT(Luminance(GetSidebarSurfaceColor(kDarkSidebar,
+                                             /*hovered=*/false)),
+            Luminance(kDarkSidebar));
+}
+
+// The tween's endpoints have to be the two states exactly -- a capsule that
+// settles a shade off its resting color is a capsule that never stops looking
+// hovered.
+TEST(ArcSidebarSurfaceTest, TheTweenEndpointsAreTheTwoStates) {
+  for (const SkColor sidebar : {kDarkSidebar, kLightSidebar}) {
+    EXPECT_EQ(GetSidebarSurfaceColor(sidebar, /*hovered=*/false),
+              GetSidebarSurfaceColorAt(sidebar, 0.0));
+    EXPECT_EQ(GetSidebarSurfaceColor(sidebar, /*hovered=*/true),
+              GetSidebarSurfaceColorAt(sidebar, 1.0));
+    // Out-of-range values clamp rather than overshoot past either end.
+    EXPECT_EQ(GetSidebarSurfaceColorAt(sidebar, 0.0),
+              GetSidebarSurfaceColorAt(sidebar, -0.5));
+    EXPECT_EQ(GetSidebarSurfaceColorAt(sidebar, 1.0),
+              GetSidebarSurfaceColorAt(sidebar, 1.5));
+  }
+}
+
+// Halfway is between the endpoints, not darker than both: interpolating the
+// alpha rather than stacking two washes is what keeps it there.
+TEST(ArcSidebarSurfaceTest, TheTweenStaysBetweenItsEndpoints) {
+  const int rest = Luminance(GetSidebarSurfaceColor(kDarkSidebar,
+                                                    /*hovered=*/false));
+  const int hovered = Luminance(GetSidebarSurfaceColor(kDarkSidebar,
+                                                       /*hovered=*/true));
+  const int middle = Luminance(GetSidebarSurfaceColorAt(kDarkSidebar, 0.5));
+  EXPECT_GE(middle, rest);
+  EXPECT_LE(middle, hovered);
+}
+
+// The floating card (Dia's active-tab treatment, measured 2026-08-20): pure
+// white on any light sidebar -- including the fork's own white one -- and a
+// white lift on dark ones. ⚠ Dia's dark theme was not measurable, so only
+// the light value is a replication; the dark one is our standard lift.
+TEST(ArcSidebarSurfaceTest, TheFloatingCardIsPureWhiteOnLightAndLiftsOnDark) {
+  EXPECT_EQ(SK_ColorWHITE, GetSidebarFloatingCardColor(SK_ColorWHITE));
+  EXPECT_EQ(SK_ColorWHITE, GetSidebarFloatingCardColor(kLightSidebar));
+  EXPECT_EQ(SK_ColorWHITE, GetSidebarFloatingCardColor(kGraySidebar));
+  const SkColor dark = SkColorSetRGB(0x30, 0x30, 0x30);
+  EXPECT_GT(Luminance(GetSidebarFloatingCardColor(dark)), Luminance(dark));
+  EXPECT_LT(Luminance(GetSidebarFloatingCardColor(dark)), 255);
+}
+
+// The self-painted shadow pair (r5). The relations are the contract, the
+// exact values are acceptance-tunable against the Dia decay profile
+// (measured 2026-08-20, see arc_sidebar_surface.h).
+TEST(ArcSidebarSurfaceTest, TheCardShadowConstantsHoldTheirShape) {
+  static_assert(std::size(kSidebarCardShadowPasses) >= 2);
+  int max_reach = 0;
+  int max_offset = 0;
+  for (const SidebarCardShadowPass& pass : kSidebarCardShadowPasses) {
+    // Black at some alpha in both themes, dark heavier (a dark backdrop
+    // swallows the light values).
+    EXPECT_GT(pass.light_alpha, 0.0);
+    EXPECT_GT(pass.dark_alpha, pass.light_alpha);
+    EXPECT_GT(pass.sigma, 0.0);
+    // No pass may read directional on its own terms: offsets stay within
+    // Dia's "a point or two, maybe a drop" band.
+    EXPECT_GE(pass.offset_y, 0);
+    EXPECT_LE(pass.offset_y, 6);
+    // A pass's horizontal inset keeps its rect inside the card.
+    EXPECT_GE(pass.inset_h, 0);
+    max_reach = std::max(
+        max_reach, pass.offset_y + static_cast<int>(2.0 * pass.sigma));
+    max_offset = std::max(max_offset, pass.offset_y);
+  }
+  // The first pass is the all-sides hug: centered and full-rect.
+  EXPECT_EQ(0, kSidebarCardShadowPasses[0].offset_y);
+  EXPECT_EQ(0, kSidebarCardShadowPasses[0].inset_h);
+  // The horizontal outset is a hard budget: the row already sits 8pt from
+  // the sidebar edge (kVerticalTabStripHorizontalPadding), and one point
+  // more would paint shadow onto the content card.
+  EXPECT_EQ(8, kSidebarCardShadowOutsetH);
+  // The vertical outset must hold every pass's practical reach (offset +
+  // 2*sigma); anything less would visibly crop the fade.
+  EXPECT_GE(kSidebarCardShadowOutsetV, max_reach);
+}
+
+// The shadow's geometry floor: a full row (>=34pt at radius 12) carries it,
+// an entrance-animation sliver must not. Born as a ninepatch-DCHECK guard
+// under ui::Shadow (probe-hit 2026-08-20); kept as a pure aesthetic floor
+// now that the shadow is self-painted.
+TEST(ArcSidebarSurfaceTest, TheCardShadowHasAGeometryFloor) {
+  EXPECT_TRUE(CanShowCardShadow(240, 34, 12));
+  EXPECT_TRUE(CanShowCardShadow(240, 28, 12));
+  EXPECT_FALSE(CanShowCardShadow(240, 27, 12));
+  EXPECT_FALSE(CanShowCardShadow(240, 8, 12));
+  EXPECT_FALSE(CanShowCardShadow(20, 34, 12));
+}
+
+}  // namespace
+}  // namespace helium
