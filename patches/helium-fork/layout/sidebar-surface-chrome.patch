Index: src/chrome/browser/ui/helium/arc_favorite_accent.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_favorite_accent.h
@@ -0,0 +1,100 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_FAVORITE_ACCENT_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_FAVORITE_ACCENT_H_
+
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/color_utils.h"
+
+// helium-fork: the selected favorites card takes its color from its own
+// favicon rather than from a theme accent.
+//
+// What Arc actually does, measured 2026-08-19: it scales the favicon up to
+// fill the capsule, blurs it heavily, clips it to the rounded rect, and paints
+// it over the card -- then strokes the ring from the *same* blurred field.
+// Sampling the selected card column by column shows the fill's warm-to-cool
+// run lining up with the icon's own dots left to right (R-B +8.5 at 9% across,
+// +1.0 at 40%, -10.9 at 90%, against icon dots of orange/green/blue in that
+// order), and the chroma peaking on the icon's row and falling off toward the
+// top and bottom edges. A single dominant color cannot produce either of
+// those; a blurred copy produces both for free.
+//
+// So this file holds the decisions that are not "draw the image": how much of
+// it the wash gets, how the ring's stroke color is normalized, and when the
+// icon has no color worth taking.
+//
+// Header-only and free of //ui/views, so the thresholds are pinnable in the
+// lightweight test target.
+namespace helium {
+
+// How much of the blurred favicon the background wash shows, over the card's
+// own active fill. It has to stay a wash -- any stronger and the card stops
+// reading as a surface and starts reading as a thumbnail.
+inline constexpr float kFavoriteAccentFillAlpha = 0.12f;
+
+// The ring is opaque: Arc's measured stroke values are what the user sees
+// with nothing composited underneath (2026-08-19: an all-red favicon rings
+// pastel red (238,129,129), letterboxd rings warm-to-cool (200,165,133) /
+// (132,183,207)). The brightness comes from FavoriteRingColor() below, not
+// from letting the card show through.
+inline constexpr float kFavoriteAccentStrokeAlpha = 1.0f;
+
+// The ring's lightness floor. Arc's ring sits at HSL lightness 0.66-0.72
+// regardless of how dark the favicon is -- a mostly-black icon (letterboxd)
+// still rings in light pastels, while the hue and saturation stay the icon's
+// own. Ours drew the blurred field directly, so a dark icon made a dark ring
+// (user: "太暗了就不太好看", 2026-08-19). 0.70 is the middle of the measured
+// range.
+inline constexpr double kFavoriteRingLightness = 0.70;
+
+// The stroke color for one cell of the blurred field: same hue, same
+// saturation, lightness lifted to the floor. Already-light colors pass
+// through untouched -- the floor only lifts, it never darkens.
+//
+// Sanity against Arc (2026-08-19): saturated youtube red (231,53,46) comes
+// out (239,122,118) against Arc's measured (238,129,129); a dark warm brown
+// (90,60,40) comes out (208,173,149) against letterboxd's warm side
+// (200,165,133).
+inline SkColor FavoriteRingColor(SkColor field) {
+  const SkColor opaque = SkColorSetA(field, SK_AlphaOPAQUE);
+  color_utils::HSL hsl;
+  color_utils::SkColorToHSL(opaque, &hsl);
+  if (hsl.l >= kFavoriteRingLightness) {
+    return opaque;
+  }
+  hsl.l = kFavoriteRingLightness;
+  return color_utils::HSLToSkColor(hsl, SK_AlphaOPAQUE);
+}
+
+// An icon with no usable color falls back to the theme accent ring. This is
+// not a contrast fallback -- the band's rule against those (a fallback there
+// paints black pages gray) is about a surface the user is reading text on,
+// which this is not. It only answers "did the icon have a color at all".
+//
+// `mean` is the average of the downsampled icon, so a logo that is mostly
+// white with one colored glyph still averages to something faintly colored and
+// passes; a grayscale wordmark, the placeholder globe, and a fully transparent
+// icon do not.
+inline bool IsUsableFavoriteAccent(SkColor mean) {
+  // Below this the blurred wash is indistinguishable from the plain fill, and
+  // the ring reads as a dirty gray rather than as the site's color.
+  constexpr double kMinSaturation = 0.15;
+  // `mean`'s alpha is the icon's coverage of its own square, and most favicons
+  // are a glyph on transparent -- a centered disc covers 20%, a thin wordmark
+  // less. So this only has to reject an icon that is empty, not one that is
+  // sparse; at 0x40 it threw out the ordinary case (a red disc on transparent
+  // fell back to the theme ring, caught on the probe 2026-08-19).
+  constexpr SkAlpha kMinAlpha = 0x08;
+  if (SkColorGetA(mean) < kMinAlpha) {
+    return false;
+  }
+  color_utils::HSL hsl;
+  color_utils::SkColorToHSL(SkColorSetA(mean, SK_AlphaOPAQUE), &hsl);
+  return hsl.s >= kMinSaturation;
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_FAVORITE_ACCENT_H_
Index: src/chrome/browser/ui/helium/arc_favorite_accent_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_favorite_accent_unittest.cc
@@ -0,0 +1,91 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_favorite_accent.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+TEST(ArcFavoriteAccentTest, AColorfulIconCarriesTheAccent) {
+  // The favicon the selected card was measured against: orange, green and blue
+  // dots, averaging to something clearly colored.
+  EXPECT_TRUE(IsUsableFavoriteAccent(SkColorSetRGB(0xEF, 0x87, 0x33)));
+  EXPECT_TRUE(IsUsableFavoriteAccent(SkColorSetRGB(0x66, 0xDD, 0x67)));
+  EXPECT_TRUE(IsUsableFavoriteAccent(SkColorSetRGB(0x65, 0xBA, 0xEF)));
+}
+
+// A grayscale wordmark and the placeholder globe both average to gray. Tinting
+// the ring with those gives a dirty gray ring, which reads as a rendering bug
+// rather than as the site's color -- so they take the theme accent instead.
+TEST(ArcFavoriteAccentTest, AGrayIconFallsBackToTheThemeAccent) {
+  EXPECT_FALSE(IsUsableFavoriteAccent(SkColorSetRGB(0x80, 0x80, 0x80)));
+  EXPECT_FALSE(IsUsableFavoriteAccent(SkColorSetRGB(0x00, 0x00, 0x00)));
+  EXPECT_FALSE(IsUsableFavoriteAccent(SkColorSetRGB(0xFF, 0xFF, 0xFF)));
+  // Barely-there tint: below the threshold the wash is indistinguishable from
+  // the plain fill anyway.
+  EXPECT_FALSE(IsUsableFavoriteAccent(SkColorSetRGB(0x84, 0x80, 0x80)));
+}
+
+TEST(ArcFavoriteAccentTest, AnEmptyIconFallsBackToTheThemeAccent) {
+  EXPECT_FALSE(IsUsableFavoriteAccent(SK_ColorTRANSPARENT));
+  EXPECT_FALSE(IsUsableFavoriteAccent(SkColorSetARGB(0x04, 0xEF, 0x87, 0x33)));
+}
+
+// Sparse is not empty. A glyph on a transparent square is what a favicon
+// normally is -- a centered disc covers about a fifth of it -- and the gate
+// used to reject exactly that.
+TEST(ArcFavoriteAccentTest, ASparseIconStillCarriesTheAccent) {
+  EXPECT_TRUE(IsUsableFavoriteAccent(SkColorSetARGB(0x32, 0xDC, 0x28, 0x28)));
+  EXPECT_TRUE(IsUsableFavoriteAccent(SkColorSetARGB(0x14, 0xEF, 0x87, 0x33)));
+}
+
+// The ring is opaque and the fill stays a wash: the ring's brightness now
+// comes from the lightness floor, not from compositing against the card.
+TEST(ArcFavoriteAccentTest, TheRingIsFarStrongerThanTheWash) {
+  EXPECT_GT(kFavoriteAccentStrokeAlpha, kFavoriteAccentFillAlpha * 5.0f);
+  EXPECT_LE(kFavoriteAccentFillAlpha, 0.2f);
+  EXPECT_EQ(1.0f, kFavoriteAccentStrokeAlpha);
+}
+
+int Lightness255(SkColor color) {
+  color_utils::HSL hsl;
+  color_utils::SkColorToHSL(color, &hsl);
+  return static_cast<int>(hsl.l * 255.0 + 0.5);
+}
+
+// Arc 2026-08-19: the ring sits at HSL lightness 0.66-0.72 no matter how dark
+// the favicon is -- an all-red icon rings pastel (238,129,129), letterboxd's
+// near-black field rings (200,165,133)/(132,183,207). The floor lifts a
+// saturated youtube red into that band while keeping its hue.
+TEST(ArcFavoriteAccentTest, TheRingColorIsLiftedToTheArcBand) {
+  const SkColor lifted = FavoriteRingColor(SkColorSetRGB(231, 53, 46));
+  // Against Arc's measured (238,129,129), channel by channel.
+  EXPECT_NEAR(238, SkColorGetR(lifted), 12);
+  EXPECT_NEAR(129, SkColorGetG(lifted), 12);
+  EXPECT_NEAR(129, SkColorGetB(lifted), 12);
+  // Still red: the lift changes lightness only.
+  EXPECT_GT(SkColorGetR(lifted), SkColorGetG(lifted) + 60);
+}
+
+// A dark warm cell -- the letterboxd case that shipped as a near-black ring
+// (user 2026-08-19) -- comes out in the same light pastel band as Arc's warm
+// side (200,165,133).
+TEST(ArcFavoriteAccentTest, ADarkFieldStillRingsLight) {
+  const SkColor lifted = FavoriteRingColor(SkColorSetRGB(90, 60, 40));
+  EXPECT_NEAR(255.0 * kFavoriteRingLightness, Lightness255(lifted), 3);
+  // Warm stays warm.
+  EXPECT_GT(SkColorGetR(lifted), SkColorGetB(lifted) + 30);
+}
+
+// The floor only lifts. A field that is already light keeps its own
+// lightness -- darkening it would trade one wrong ring for another.
+TEST(ArcFavoriteAccentTest, AnAlreadyLightFieldIsUntouched) {
+  const SkColor light = SkColorSetRGB(240, 220, 200);
+  EXPECT_EQ(light, FavoriteRingColor(light));
+}
+
+}  // namespace
+}  // namespace helium
Index: src/chrome/browser/ui/helium/arc_sidebar_surface.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_sidebar_surface.h
@@ -0,0 +1,216 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_SIDEBAR_SURFACE_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_SIDEBAR_SURFACE_H_
+
+#include <algorithm>
+
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/color_utils.h"
+
+// helium-fork: the fill behind the sidebar's own capsules -- the address row
+// and each favorites card.
+//
+// These sit on the sidebar, which is the app-themed half of the window (the
+// "blue zone"), so unlike arc_band_colors.h nothing here takes a page color.
+// The one input is the sidebar's own surface and the answer is a translucent
+// mid-gray wash over it, which is why a light theme gets a slightly darker
+// capsule and a dark theme a slightly lighter one from the same two constants.
+//
+// Header-only and free of //ui/views so the constants can be pinned in the
+// lightweight test target.
+namespace helium {
+
+// The app surface: the base color of the whole "blue zone" -- the sidebar,
+// the window frame, the gutter around the content card -- in the default
+// light theme. Everything else in this header is a wash *over* this.
+//
+// Not pure white. Measured off the live Dia window 2026-08-20 (@2x, the
+// window's own layer via `screencapture -o -l<winid>`, so the desktop behind
+// it is excluded): a strictly neutral gray, RGB(225,225,225) at the top of
+// the sidebar easing to (233,233,233) at the bottom, mean #E4E4E4 = L228 --
+// the same L228 the r5 shadow calibration had already been normalizing
+// against. The user asked for it directly ("pure white is too harsh, and
+// nobody ships pure white any more", 2026-08-20).
+//
+// Dia also runs the sidebar at alpha ~0.93 over a blurred desktop (same
+// measurement: least squares over backdrop luminances 45..156 gives
+// 0.930, stable across blur radii 30..160). That half is r7's -- Helium
+// already carries the machinery (chrome/browser/ui/views/helium/
+// native_frame_materials*), it is just off by default and the Arc shell has
+// never run on the translucent path.
+//
+// Applied by the one recipe in chrome/browser/ui/color/
+// material_chrome_color_mixer.cc, and only for the default theme: a custom
+// theme or a user color still wins.
+inline constexpr SkColor kArcAppSurfaceLight = SkColorSetRGB(0xE4, 0xE4, 0xE4);
+
+// The fill for a sidebar capsule at rest and under the pointer.
+//
+// A fixed mid-gray at a fixed alpha, not the sidebar's contrasting color.
+// Three Arc measurements pin the model (all 2026-08-19, active window):
+// a dark space L116 -> L129 at rest (L136 hovered), a light space L242 ->
+// L230, and a second light space L222 -> L212.5. One gray at one alpha hits
+// all three (129.2 / 229.9 / 213.9); the contrasting-color model fit only
+// the dark one and came out twice as heavy on light themes -- which is
+// exactly what the user reported (r2 shipped it; corrected in r3).
+// The hovered alpha is fitted to the dark space's L136; neither light space
+// was measured hovered, so hover keeps the same one-model shape rather than
+// a second data point.
+//
+// Deliberately not GetBandFieldColor(): the band's field goes the other way
+// (0.10 at rest, 0.08 hovered) because there the row capsule takes the hover
+// over. Same shape, opposite intent -- merging them would make each surface's
+// measurements hostage to the other's.
+inline SkColor GetSidebarSurfaceColor(SkColor sidebar, bool hovered) {
+  // L182: solve the three resting measurements above for one overlay color;
+  // they agree on ~181.5 at alpha 0.20.
+  constexpr SkColor kWash = SkColorSetRGB(0xB6, 0xB6, 0xB6);
+  constexpr float kRestAlpha = 0.20f;
+  constexpr float kHoveredAlpha = 0.30f;
+  return color_utils::AlphaBlend(kWash, sidebar,
+                                 hovered ? kHoveredAlpha : kRestAlpha);
+}
+
+// The selected favorites card, before its favicon wash goes on top.
+//
+// White, not the gray wash: the selected card is *lit*, and Arc lights
+// it the same way in either theme. Measured 2026-08-19 on two of the user's
+// spaces -- a dark one (sidebar L116, card L167) and a light one (sidebar
+// L242, card L247) -- and both come out as white at 0.37/0.39. The dark theme
+// gets a big lift and the light one barely any, which is white saturating, not
+// two different rules.
+//
+// Deriving this from GetColorWithMaxContrast() instead fits the dark
+// measurement just as well and is wrong: on a light sidebar it steps toward
+// black, and the selected card comes out *darker* than its neighbours. Only
+// having both themes in hand tells the two models apart.
+//
+// Also deliberately not kColorTabBackgroundActiveFrameActive, which the tab
+// strip's mixer resolves to kColorToolbar -- exactly the sidebar's own color,
+// so the selected card's fill was invisible and the ring carried the whole
+// signal on its own.
+inline SkColor GetSidebarSelectedSurfaceColor(SkColor sidebar) {
+  constexpr float kSelectedAlpha = 0.37f;
+  return color_utils::AlphaBlend(SK_ColorWHITE, sidebar, kSelectedAlpha);
+}
+
+// The floating card -- the active tab row and the media strip, Dia's
+// treatment of "the tab you are on" (user 2026-08-20).
+//
+// Dia measured 2026-08-20 (@2x, light lavender theme): a pure-white capsule
+// -- body RGB(250,250,251) with a 0.5pt lighter rim we skip -- no hairline
+// anywhere, elevation carried entirely by a soft shadow. So: pure white on a
+// light sidebar. Dia's dark theme could not be measured without driving the
+// app (off-limits), so dark themes get the standard white lift instead --
+// same shape as every dark elevated surface, acceptance-tunable.
+inline SkColor GetSidebarFloatingCardColor(SkColor sidebar) {
+  return color_utils::IsDark(sidebar)
+             ? color_utils::AlphaBlend(SK_ColorWHITE, sidebar, 0.10f)
+             : SK_ColorWHITE;
+}
+
+// The card's shadow, consumed by HeliumCardShadowView (self-painted).
+//
+// Why self-painted and not ui::Shadow: the MD model welds offset.y and blur
+// to the elevation (key = (0,E) at blur 4E) and clamps E to
+// (min_dimension - 2 * corner_radius) / 4 -- a 34pt row at radius 12 caps at
+// E=2, i.e. a tight, downward `0 2px 4px` cast. Dia's look is the opposite:
+// a broad, near-centered halo. Measured 2026-08-20 off the user's Dia
+// screenshots (@2x, light lavender, bg L~228), delta below the card edge:
+//   1px +13 / 6px +12 / 12px +8 / 16px +6 / 28px +4   (still visible 14pt out)
+// above: 1px +11 / 16px +6 / 20px +3; sides decay within ~5pt. Offset is at
+// most (0,1-2). No two-gaussian sum reproduces that fat tail exactly; the
+// pair below is the closest fit and the acceptance knob is this block alone.
+//
+// Painted as a stack of blurred black round-rects (sigma in pt; a pass's
+// visible reach is roughly 3*sigma + offset). Dia's profile is
+// *anisotropic* -- the sides are done by ~5pt while the bottom carries to
+// 14pt -- which no isotropic gaussian can do alone, so the long passes pull
+// their rect *in* horizontally (inset_h): the bottom edge keeps the full
+// tail, the sides only see the tight hug. Dark themes keep black shadows at
+// doubled alpha (user 2026-08-20: no Dia dark-mode white glow; gray card +
+// black shadow).
+struct SidebarCardShadowPass {
+  int offset_y;
+  double sigma;
+  double light_alpha;
+  double dark_alpha;
+  // Horizontal inset of this pass's rect from the card's own edges.
+  int inset_h;
+};
+// Refit 2026-08-20 (second pass) against Dia and this build measured with
+// *one* instrument, same day, same 2x window screenshots -- the earlier
+// calibration compared numbers taken two different ways and so read the
+// gap backwards. Deltas below/above/beside the card edge, in device px,
+// against each side's own local backdrop:
+//   Dia below : 10.4 9.6 8.8 8.6 7.4 6.8 6.2 5.7 ... 3.2@28 1.6@40
+//   Dia above :  9.0 8.0 7.8 7.0 6.4 6.1 5.2 4.8 ... 2.6@28 1.0@40
+//   Dia beside:  9.0 9.0 8.0 8.0 8.0 6.5 6.0 5.5 ... 1.5@14
+// i.e. Dia is *near-symmetric* about the card, lighter at the contact line
+// than we were, and carries a long tail upward too. The old table was a
+// bottom-biased cast: heavier than Dia by ~3 in the first 8px below, and
+// short of it by ~2 in the 10-24px band above.
+//
+// The fit that lands all three curves within ~0.8 of Dia is one broad
+// near-centered halo carrying most of the alpha, a tight hug for the
+// contact read, and a small downward-biased pass for the bit of gravity.
+// The sides cannot be made to decay as fast as Dia's: a gaussian wide
+// enough for the vertical tail only *shifts* sideways under inset_h, it
+// does not steepen, so `beside` runs ~2 heavy past 10px. That residual is
+// the acceptance knob's known limit, not an oversight.
+inline constexpr SidebarCardShadowPass kSidebarCardShadowPasses[] = {
+    // hug: the contact line, and the only pass narrow enough to shape the
+    // sides.
+    {0, 4.5, 0.027, 0.054, 0},
+    // drift: the bit of gravity -- a downward-biased mid pass.
+    {5, 13.0, 0.018, 0.036, 3},
+    // halo: the broad near-centered fade that carries the look; inset so
+    // the sides stay as close to Dia-narrow as a gaussian allows.
+    {0, 15.0, 0.055, 0.110, 6},
+};
+
+// How far the shadow view's bounds extend past the card. Horizontal is
+// budgeted, not derived: the row already runs to within 8pt of the sidebar
+// edge (kVerticalTabStripHorizontalPadding), so 8 is every point available
+// before the shadow would paint onto the content card -- and Dia's own
+// sideways decay is done by ~7pt anyway. Vertical must swallow the longest
+// pass's practical reach (offset 0 + 2*sigma 15 = 30, offset 5 + 2*sigma 13
+// = 31; the tail beyond is sub-1% alpha).
+inline constexpr int kSidebarCardShadowOutsetH = 8;
+inline constexpr int kSidebarCardShadowOutsetV = 32;
+
+// Whether a card of this size may carry the shadow at all. Purely aesthetic
+// now (the self-painted shadow has no ninepatch DCHECK to trip, unlike the
+// ui::Shadow version this floor was born under, probe-hit 2026-08-20): a row
+// mid-entrance-animation is a sliver a few points tall, and a full-strength
+// halo around a sliver reads as a smudge. Keep the same floor: min edge >=
+// 2r + 4, the size below which the capsule's own silhouette collapses.
+inline constexpr bool CanShowCardShadow(int width, int height, int radius) {
+  return std::min(width, height) >= 2 * radius + 4;
+}
+
+// The same fill part-way through the hover tween. `progress` is the animation's
+// 0..1 value, so 0 is exactly the resting fill and 1 exactly the hovered one.
+//
+// Interpolating the alpha rather than cross-fading two painted capsules keeps
+// the row a single layer: two stacked washes would be visibly darker than
+// either endpoint at the halfway point.
+inline SkColor GetSidebarSurfaceColorAt(SkColor sidebar, double progress) {
+  const SkColor rest = GetSidebarSurfaceColor(sidebar, /*hovered=*/false);
+  const SkColor hovered = GetSidebarSurfaceColor(sidebar, /*hovered=*/true);
+  if (progress <= 0.0) {
+    return rest;
+  }
+  if (progress >= 1.0) {
+    return hovered;
+  }
+  return color_utils::AlphaBlend(hovered, rest,
+                                 static_cast<float>(progress));
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_SIDEBAR_SURFACE_H_
