+      int64_t sum_r = 0;
+      int64_t sum_g = 0;
+      int64_t sum_b = 0;
+      int64_t count = 0;
+      for (int y = y0; y < std::min(y1, source.height()); ++y) {
+        for (int x = x0; x < std::min(x1, source.width()); ++x) {
+          const SkColor color = source.getColor(x, y);
+          const int64_t a = SkColorGetA(color);
+          sum_a += a;
+          sum_r += SkColorGetR(color) * a;
+          sum_g += SkColorGetG(color) * a;
+          sum_b += SkColorGetB(color) * a;
+          ++count;
+        }
+      }
+      if (count == 0) {
+        continue;
+      }
+      total_a += sum_a;
+      total_r += sum_r;
+      total_g += sum_g;
+      total_b += sum_b;
+      if (sum_a == 0) {
+        continue;
+      }
+      const size_t index = cell_y * kAccentGrid + cell_x;
+      cells[index] = SkColorSetRGB(static_cast<uint8_t>(sum_r / sum_a),
+                                   static_cast<uint8_t>(sum_g / sum_a),
+                                   static_cast<uint8_t>(sum_b / sum_a));
+      coverage[index] = sum_a / count;
+      peak_coverage = std::max(peak_coverage, coverage[index]);
+    }
+  }
+
+  if (total_a == 0 || peak_coverage == 0) {
+    return SkBitmap();
+  }
+  const SkColor mean = SkColorSetARGB(
+      static_cast<uint8_t>(total_a /
+                           (source.width() * static_cast<int64_t>(
+                                                 source.height()))),
+      static_cast<uint8_t>(total_r / total_a),
+      static_cast<uint8_t>(total_g / total_a),
+      static_cast<uint8_t>(total_b / total_a));
+  if (!helium::IsUsableFavoriteAccent(mean)) {
+    return SkBitmap();
+  }
+  const SkColor opaque_mean = SkColorSetA(mean, SK_AlphaOPAQUE);
+  for (int cell_y = 0; cell_y < kAccentGrid; ++cell_y) {
+    for (int cell_x = 0; cell_x < kAccentGrid; ++cell_x) {
+      const size_t index = cell_y * kAccentGrid + cell_x;
+      const float weight =
+          static_cast<float>(coverage[index]) / peak_coverage;
+      *out.getAddr32(cell_x, cell_y) = SkPreMultiplyColor(SkColorSetA(
+          color_utils::AlphaBlend(cells[index], opaque_mean, weight),
+          SK_AlphaOPAQUE));
+    }
+  }
+  return out;
+}
