+void WorkspaceEntryView::UpdateAccentSource(const gfx::ImageSkia& favicon) {
+  // helium-fork: only the favorites grid wears the accent, but the update runs
+  // for every entry -- a pinned row promoted to a favorite must not have to
+  // wait for its next icon change to gain a color.
+  const gfx::ImageSkiaRep& rep = favicon.GetRepresentation(1.0f);
+  SkBitmap accent =
+      rep.is_null() ? SkBitmap() : BoxDownsampleForAccent(rep.GetBitmap());
+  accent_ = accent.drawsNothing()
+                ? gfx::ImageSkia()
+                : gfx::ImageSkia::CreateFromBitmap(accent, 1.0f);
+  // The ring's copy of the field: same hue and saturation per cell, lightness
+  // lifted to the floor. Doing it here rather than at paint time keeps the
+  // paint path a plain shader sample.
+  SkBitmap ring;
+  if (!accent.drawsNothing()) {
+    ring.allocN32Pixels(accent.width(), accent.height());
+    for (int y = 0; y < accent.height(); ++y) {
+      for (int x = 0; x < accent.width(); ++x) {
+        *ring.getAddr32(x, y) = SkPreMultiplyColor(
+            helium::FavoriteRingColor(accent.getColor(x, y)));
+      }
+    }
+  }
+  ring_accent_ = ring.drawsNothing()
+                     ? gfx::ImageSkia()
+                     : gfx::ImageSkia::CreateFromBitmap(ring, 1.0f);
+  SchedulePaint();
+}
