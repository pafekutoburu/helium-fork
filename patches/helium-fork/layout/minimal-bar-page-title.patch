--- /dev/null
+++ src/chrome/browser/ui/helium/arc_minimal_field_state_unittest.cc
@@ -0,0 +1,63 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_minimal_field_state.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+TEST(ArcMinimalFieldStateTest, RestShowsHostAndTitle) {
+  EXPECT_EQ(ArcFieldContent::kHostAndTitle,
+            DecideArcFieldContent(/*minimal=*/true,
+                                  /*focused_or_editing=*/false,
+                                  /*hovered=*/false, /*has_title=*/true));
+}
+
+TEST(ArcMinimalFieldStateTest, RestWithoutTitleShowsHostOnly) {
+  EXPECT_EQ(ArcFieldContent::kHostOnly,
+            DecideArcFieldContent(/*minimal=*/true,
+                                  /*focused_or_editing=*/false,
+                                  /*hovered=*/false, /*has_title=*/false));
+}
+
+// Dia (measured 2026-08-16): hover swaps the title for the real URL; the
+// title never shows while the pointer is in the field.
+TEST(ArcMinimalFieldStateTest, HoverSwapsToPathEvenWithTitle) {
+  EXPECT_EQ(ArcFieldContent::kHostAndPath,
+            DecideArcFieldContent(/*minimal=*/true,
+                                  /*focused_or_editing=*/false,
+                                  /*hovered=*/true, /*has_title=*/true));
+  EXPECT_EQ(ArcFieldContent::kHostAndPath,
+            DecideArcFieldContent(/*minimal=*/true,
+                                  /*focused_or_editing=*/false,
+                                  /*hovered=*/true, /*has_title=*/false));
+}
+
+TEST(ArcMinimalFieldStateTest, EditingWinsOverEverything) {
+  for (const bool hovered : {false, true}) {
+    for (const bool has_title : {false, true}) {
+      EXPECT_EQ(ArcFieldContent::kFullUrl,
+                DecideArcFieldContent(/*minimal=*/true,
+                                      /*focused_or_editing=*/true, hovered,
+                                      has_title));
+    }
+  }
+}
+
+TEST(ArcMinimalFieldStateTest, MinimalOffIsAlwaysFullUrl) {
+  for (const bool focused : {false, true}) {
+    for (const bool hovered : {false, true}) {
+      for (const bool has_title : {false, true}) {
+        EXPECT_EQ(ArcFieldContent::kFullUrl,
+                  DecideArcFieldContent(/*minimal=*/false, focused, hovered,
+                                        has_title));
+      }
+    }
+  }
+}
+
+}  // namespace
+}  // namespace helium
