+void LocationBarView::RefreshArcTitleLabel() {
+  if (!arc_title_label_) {
+    return;
+  }
+  std::u16string title;
+  if (content::WebContents* contents = GetWebContents()) {
+    if (content::NavigationEntry* entry =
+            contents->GetController().GetLastCommittedEntry()) {
+      // GetTitle() rather than GetTitleForDisplay(): the display helper falls
+      // back to the URL, and a URL after the slash is exactly what this label
+      // must never show.
+      title = entry->GetTitle();
+    }
+  }
+  const bool has_title =
+      !title.empty() && omnibox_view_ && !omnibox_view_->GetText().empty();
+  const bool show =
+      helium::DecideArcFieldContent(
+          ShouldMinimizeArcChrome(),
+          (omnibox_view_ && omnibox_view_->HasFocus()) ||
+              GetOmniboxController()->edit_model()->user_input_in_progress(),
+          /*hovered=*/false, has_title) ==
+      helium::ArcFieldContent::kHostAndTitle;
+  if (show == arc_title_label_->GetVisible() && title == arc_last_title_) {
+    return;
+  }
+  arc_last_title_ = title;
+  arc_title_label_->SetText(base::StrCat({u" / ", title}));
+  arc_title_label_->SetVisible(show);
+  InvalidateLayout();
+}
+
+void LocationBarView::TitleWasSet(content::NavigationEntry* entry) {
+  RefreshArcTitleLabel();
+}
