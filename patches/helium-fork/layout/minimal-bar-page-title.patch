--- src.orig/chrome/browser/ui/helium/arc_band_colors.h
+++ src/chrome/browser/ui/helium/arc_band_colors.h
@@ -121,6 +121,16 @@ inline BandTextColors GetBandTextColors(
                                                kDimmedTowardBackdrop)};
 }
 
+// The dimmed " / page title" the minimal field shows after the host at rest.
+// Dia's title gray sits much closer to the backdrop than the URL's path
+// dimming (measured on the real Dia 2026-08-16: title (176,176,177) on a
+// (252,252,254) backdrop, ~0.30 of the contrasting color).
+inline SkColor GetBandTitleColor(SkColor backdrop) {
+  constexpr float kTitleTowardBackdrop = 0.30f;
+  return color_utils::AlphaBlend(GetBandForegroundColor(backdrop), backdrop,
+                                 kTitleTowardBackdrop);
+}
+
 // The field's own fill on a tinted band -- a quiet wash of the contrasting
 // color rather than a theme color that assumes a toolbar background.
 //
Index: src/chrome/browser/ui/helium/arc_band_colors_unittest.cc
===================================================================
--- src.orig/chrome/browser/ui/helium/arc_band_colors_unittest.cc
+++ src/chrome/browser/ui/helium/arc_band_colors_unittest.cc
@@ -166,6 +166,22 @@ TEST(ResolveBandTintTest, StaysOnTheLast
                             kBlackPage, /*page_painted=*/true));
 }
 
+// The " / page title" gray must recede further than the URL's path dimming --
+// Dia's measured hierarchy (2026-08-16): host, then path, then title, each a
+// step closer to the backdrop.
+TEST(GetBandTitleColorTest, RecedesFurtherThanTheDimmedText) {
+  for (const SkColor backdrop :
+       {SK_ColorWHITE, SK_ColorBLACK, SkColorSetRGB(0xFC, 0xFC, 0xFE)}) {
+    const SkColor title = GetBandTitleColor(backdrop);
+    const SkColor dimmed = GetBandTextColors(backdrop).dimmed;
+    EXPECT_LT(color_utils::GetContrastRatio(title, backdrop),
+              color_utils::GetContrastRatio(dimmed, backdrop))
+        << " backdrop=" << backdrop;
+    // Still visible: not the backdrop itself.
+    EXPECT_NE(title, backdrop);
+  }
+}
+
 // Every foreground in the band is derived from this color, and deriving from a
 // translucent one is how invisible text happens.
 TEST(ResolveBandTintTest, OutputIsAlwaysOpaque) {
Index: src/chrome/browser/ui/helium/arc_minimal_field_state.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_minimal_field_state.h
@@ -0,0 +1,45 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_MINIMAL_FIELD_STATE_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_MINIMAL_FIELD_STATE_H_
+
+// helium-fork: what the Arc band's minimal address field shows, as one pure
+// decision (Dia parity, measured on the real Dia 2026-08-16). Dependency-free
+// so the minimal unit-test target can pin the whole table.
+namespace helium {
+
+enum class ArcFieldContent {
+  // Rest: trimmed host, then the page title dimmed after a slash.
+  kHostAndTitle,
+  // Rest without a usable title (none set yet, or nothing to show it for).
+  kHostOnly,
+  // Hovered: the real URL -- host plus path, path dimmed, no scheme. Dia
+  // swaps the title out the moment the pointer enters the field.
+  kHostAndPath,
+  // Editing (focused or input in progress), or minimal treatment off: the
+  // full formatted URL, upstream behavior.
+  kFullUrl,
+};
+
+// `has_title` means a real, non-empty page title AND a non-empty display
+// URL to hang it on (internal pages that show an empty omnibox never get a
+// dangling "/ title").
+inline constexpr ArcFieldContent DecideArcFieldContent(bool minimal,
+                                                       bool focused_or_editing,
+                                                       bool hovered,
+                                                       bool has_title) {
+  if (!minimal || focused_or_editing) {
+    return ArcFieldContent::kFullUrl;
+  }
+  if (hovered) {
+    return ArcFieldContent::kHostAndPath;
+  }
+  return has_title ? ArcFieldContent::kHostAndTitle
+                   : ArcFieldContent::kHostOnly;
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_MINIMAL_FIELD_STATE_H_
Index: src/chrome/browser/ui/helium/arc_minimal_field_state_unittest.cc
