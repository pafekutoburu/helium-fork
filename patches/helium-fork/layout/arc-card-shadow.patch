+// found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_card_layout.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace helium {
+namespace {
+
+// gtest prints a gfx::Rect through gfx::PrintTo, which rect.h says is defined
+// in //ui/gfx:test_support -- a dep this deliberately small target does not
+// take (see PROGRESS.md on why anything heavy is unbuildable here). Comparing
+// the strings keeps the failure output readable without it; rect.h recommends
+// ToString() for exactly this.
+#define EXPECT_RECT_EQ(a, b) EXPECT_EQ((a).ToString(), (b).ToString())
+
+// The measured baseline: a 1280x800 window with a 200pt docked sidebar, the
+// card inset by kContentCardInset and the band one toolbar tall.
+constexpr int kCardInset = 3;
+constexpr int kWindowRadius = 17;
+constexpr int kBandHeight = 34;
+constexpr gfx::Rect kClientArea(200, 0, 1080, 800);
+
+ArcCardLayout Layout(int band_height) {
+  return ComputeArcCardLayout(/*enabled=*/true, kClientArea, kCardInset,
+                              band_height, kWindowRadius);
+}
+
+// The invariant the zen reveal gave away: the page begins exactly where the
+// band ends. Nothing may be drawn between them -- a single pt of daylight is
+// the window background showing through the seam, which is what "两个红色线框
+// 组合起来一个假的一体化" was pointing at.
+TEST(ArcCardLayoutTest, PageBeginsWhereTheBandEnds) {
+  for (int band_height = 0; band_height <= kBandHeight; ++band_height) {
+    const ArcCardLayout layout = Layout(band_height);
+    SCOPED_TRACE(testing::Message() << "band_height=" << band_height);
+    if (band_height > 0) {
+      EXPECT_EQ(layout.band().bottom(), layout.contents().y());
+    } else {
+      EXPECT_EQ(layout.card.y(), layout.contents().y());
+    }
+  }
+}
+
+// The band and the page are one card, so they share both vertical edges. They
+// used to be derived independently, which is how they ended up 3pt apart.
+TEST(ArcCardLayoutTest, BandAndPageShareTheCardsVerticalEdges) {
+  for (int band_height = 1; band_height <= kBandHeight; ++band_height) {
+    const ArcCardLayout layout = Layout(band_height);
+    SCOPED_TRACE(testing::Message() << "band_height=" << band_height);
+    EXPECT_EQ(layout.card.x(), layout.band().x());
+    EXPECT_EQ(layout.card.x(), layout.contents().x());
+    EXPECT_EQ(layout.card.width(), layout.band().width());
+    EXPECT_EQ(layout.card.width(), layout.contents().width());
+  }
+}
+
+// The card is exactly its two parts -- no overlap to hide a seam with, and no
+// gap for one to open in.
+TEST(ArcCardLayoutTest, CardIsExactlyBandPlusPage) {
+  for (int band_height = 0; band_height <= kBandHeight; ++band_height) {
+    const ArcCardLayout layout = Layout(band_height);
+    SCOPED_TRACE(testing::Message() << "band_height=" << band_height);
+    gfx::Rect united = layout.band();
+    united.Union(layout.contents());
+    EXPECT_RECT_EQ(layout.card, united);
+    EXPECT_EQ(layout.card.height(),
+              layout.band().height() + layout.contents().height());
+  }
+}
+
+// The page gives up its top corners precisely while the band is drawing the
+// card's rounded top for it. Two answers to this question -- one from the band's
+// height, one from the reveal ratio -- is the defect this file exists to lock
+// out: below the ratio threshold the page kept its radius and its inset while
+// the band was already there.
+TEST(ArcCardLayoutTest, PageTopCornersAreSquareExactlyWhileTheBandIsThere) {
+  EXPECT_FALSE(Layout(0).band_occupies_card_top());
+  EXPECT_EQ(Layout(0).contents_top_corner_radius(), Layout(0).corner_radius);
+
+  for (int band_height = 1; band_height <= kBandHeight; ++band_height) {
+    const ArcCardLayout layout = Layout(band_height);
+    SCOPED_TRACE(testing::Message() << "band_height=" << band_height);
+    EXPECT_TRUE(layout.band_occupies_card_top());
+    EXPECT_EQ(layout.contents_top_corner_radius(), 0);
+  }
+}
+
+// The concentric chain: window 17 -> card 14. A second radius written down
+// anywhere is a corner that stops matching the window's when the OS changes it.
+TEST(ArcCardLayoutTest, CardRadiusIsConcentricWithTheWindow) {
+  EXPECT_EQ(Layout(kBandHeight).corner_radius, kWindowRadius - kCardInset);
+  // Pre-macOS-26 the system radius is smaller; the chain must still hold.
+  EXPECT_EQ(ComputeArcCardLayout(true, kClientArea, kCardInset, kBandHeight, 12)
+                .corner_radius,
+            12 - kCardInset);
+  // And it can never go negative on an inset wider than the radius.
+  EXPECT_EQ(ComputeArcCardLayout(true, kClientArea, 20, kBandHeight, 12)
+                .corner_radius,
+            0);
+}
+
+// The card keeps a uniform gap from the space it is placed in.
+TEST(ArcCardLayoutTest, CardIsInsetUniformlyFromTheClientArea) {
+  const ArcCardLayout layout = Layout(kBandHeight);
+  EXPECT_EQ(layout.card.x(), kClientArea.x() + kCardInset);
+  EXPECT_EQ(layout.card.y(), kClientArea.y() + kCardInset);
+  EXPECT_EQ(layout.card.right(), kClientArea.right() - kCardInset);
+  EXPECT_EQ(layout.card.bottom(), kClientArea.bottom() - kCardInset);
+}
+
+// A caller handing over a stale or animating height can move the split, but it
+// can never put the band outside the card.
+TEST(ArcCardLayoutTest, BandIsClampedIntoTheCard) {
+  const ArcCardLayout too_tall = Layout(kClientArea.height() * 2);
+  EXPECT_RECT_EQ(too_tall.band(), too_tall.card);
+  EXPECT_TRUE(too_tall.contents().IsEmpty());
+  EXPECT_TRUE(too_tall.card.Contains(too_tall.band()));
+
+  const ArcCardLayout negative = Layout(-10);
+  EXPECT_EQ(negative.band_height, 0);
+  EXPECT_FALSE(negative.band_occupies_card_top());
+}
+
+// Disabled means "there is no card" -- callers must fall back rather than read
+// an accidentally-plausible rect.
+TEST(ArcCardLayoutTest, DisabledYieldsNoCardAtAll) {
+  const ArcCardLayout layout = ComputeArcCardLayout(
+      /*enabled=*/false, kClientArea, kCardInset, kBandHeight, kWindowRadius);
+  EXPECT_FALSE(layout.enabled);
+  EXPECT_TRUE(layout.card.IsEmpty());
+  EXPECT_TRUE(layout.band().IsEmpty());
+  EXPECT_TRUE(layout.contents().IsEmpty());
+  EXPECT_FALSE(layout.band_occupies_card_top());
+  EXPECT_EQ(layout.corner_radius, 0);
+}
+
+}  // namespace
+}  // namespace helium
