+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/arc_card_outline_view.h"
+
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/views/frame/themed_background.h"
+#include "third_party/skia/include/core/SkPath.h"
+#include "third_party/skia/include/core/SkPathBuilder.h"
+#include "third_party/skia/include/core/SkRRect.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/skia_conversions.h"
+#include "ui/gfx/scoped_canvas.h"
+
+ArcCardOutlineView::ArcCardOutlineView(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  // Purely a silhouette: it covers the whole card, so it must be transparent to
+  // input, and its layer must not claim to be opaque out to its bounds (the
+  // corners are the only thing it paints).
+  SetCanProcessEventsWithinSubtree(false);
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+}
+
+ArcCardOutlineView::~ArcCardOutlineView() = default;
+
+void ArcCardOutlineView::SetCornerRadius(int corner_radius) {
+  if (corner_radius_ == corner_radius) {
+    return;
+  }
+  corner_radius_ = corner_radius;
+  SchedulePaint();
+}
+
+void ArcCardOutlineView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  // helium-fork: the wedges are painted in the window's plane color, resolved
+  // in OnPaint(). This view paints to its own layer, and nothing invalidates
+  // that layer when the theme changes -- so switching macOS to dark mode
+  // repainted the plane around the card but left the corners holding their
+  // light-mode raster, four white arcs on a dark window. Measured before this:
+  // plane (255,255,255) -> (30,32,32) while the corner stayed 255, and it
+  // stayed wrong indefinitely, not just for a frame.
+  SchedulePaint();
+}
+
+void ArcCardOutlineView::OnPaint(gfx::Canvas* canvas) {
+  if (corner_radius_ <= 0 || !browser_view_) {
+    return;
+  }
+
+  // The four corner wedges as one explicit path: the view's rect with the
+  // card's rounded rect punched out of it (even-odd).
+  //
+  // Explicit geometry, deliberately. The obvious version of this -- clip to
+  // everything outside the rounded rect, then let ThemedBackground fill it --
+  // does not survive rasterisation: ThemedBackground ends in DrawColor(), which
+  // is "fill the whole canvas, restricted to the clip", and a whole-canvas fill
+  // under a non-rectangular clip came out as a solid white band straight across
+  // the page ("网页中间为什么有一大块白色"). A DrawPath of the actual wedges has
+  // no such fast path to fall into.
+  const gfx::Rect local = GetLocalBounds();
+  const SkPath wedges =
+      SkPathBuilder()
+          .addRect(gfx::RectToSkRect(local))
+          .addRRect(SkRRect::MakeRectXY(gfx::RectToSkRect(local),
+                                        corner_radius_, corner_radius_))
+          .setFillType(SkPathFillType::kEvenOdd)
+          .detach();
+
+  // The color the plane around the card is painted in -- asked for through the
+  // same helper MultiContentsBackgroundView uses (kToolbarTheme), so the wedge
+  // and the margin next to it cannot drift apart.
+  const std::optional<SkColor> plane_color =
+      ThemedBackground::GetBackgroundColor(this, browser_view_);
+  if (plane_color) {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setColor(*plane_color);
+    canvas->DrawPath(wedges, flags);
+    return;
+  }
+
+  // No flat color to use means a custom theme image is in play. Clipping is
+  // safe here: that path tiles a bounded image rather than filling the canvas.
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  canvas->ClipPath(wedges, /*anti_alias=*/true);
+  ThemedBackground::PaintBackground(canvas, this, browser_view_);
+}
+
+BEGIN_METADATA(ArcCardOutlineView)
+END_METADATA
