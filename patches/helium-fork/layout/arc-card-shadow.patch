Index: src/chrome/browser/ui/helium/arc_card_layout.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_card_layout.h
@@ -0,0 +1,110 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_CARD_LAYOUT_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_CARD_LAYOUT_H_
+
+#include <algorithm>
+
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/rect.h"
+
+// helium-fork: the geometry of the Arc shell's card -- the address bar band and
+// the web page beneath it, which are one rounded rectangle inset from the
+// window.
+//
+// The band and the page are two sibling views laid out by two different
+// subsystems (this layout for the band, MultiContentsView for the page). For
+// five rework rounds their agreement rested on both of them applying the same
+// constant and on the band's bottom edge happening to cover the strip of window
+// background the contents container paints in its margin. Any state that was
+// not in the acceptance matrix gave that away -- most recently the zen reveal,
+// where a stale threshold left the page with its top inset and its rounded top
+// corners while the band was already sitting on top of them, showing a 3pt seam
+// of window background between the two.
+//
+// So the arithmetic lives here, once, and the invariants are assertions rather
+// than comments: see arc_card_layout_unittest.cc, and the DCHECK in
+// BrowserViewTabbedLayoutImpl that checks the callers actually feed it the
+// inputs it documents.
+//
+// Header-only and free of //ui/views so it can be linked into a lightweight
+// test target (see PROGRESS.md on why anything reaching TestingProfile cannot
+// be built in this tree).
+namespace helium {
+
+struct ArcCardLayout {
+  // False when the Arc card treatment does not apply (fullscreen, the rounded
+  // frame pref off, a non-normal window). Every rect is then empty and callers
+  // must fall back to the un-carded geometry rather than reading them.
+  bool enabled = false;
+
+  // The card: the band and the page together. Empty when `enabled` is false.
+  gfx::Rect card;
+
+  // How much of the card's top the band occupies. Zero means the band is not on
+  // screen and the page owns the whole card.
+  int band_height = 0;
+
+  // The card's corner radius, concentric with the window's own.
+  int corner_radius = 0;
+
+  // True when the band owns the card's top edge. This is the single answer to
+  // "is the top chrome attached": the page's top inset and its top corner
+  // radius both drop to zero exactly when this is true, and it must never be
+  // derived a second time from an animation ratio.
+  bool band_occupies_card_top() const { return band_height > 0; }
+
+  // The top `band_height` of the card. Empty when the band is not on screen.
+  gfx::Rect band() const {
+    if (!enabled || band_height <= 0) {
+      return gfx::Rect();
+    }
+    return gfx::Rect(card.x(), card.y(), card.width(), band_height);
+  }
+
+  // Everything below the band. Equals `card` when the band is not on screen.
+  gfx::Rect contents() const {
+    if (!enabled) {
+      return gfx::Rect();
+    }
+    return gfx::Rect(card.x(), card.y() + band_height, card.width(),
+                     card.height() - band_height);
+  }
+
+  // The page's top corners are square precisely while the band is drawing the
+  // card's rounded top for it.
+  int contents_top_corner_radius() const {
+    return band_occupies_card_top() ? 0 : corner_radius;
+  }
+};
+
+// `client_area` is the space the card is placed in, `card_inset` the uniform
+// gap it keeps from that space's edges, and `window_radius` the frame's own
+// corner radius -- the card's radius is concentric with it, so the two must be
+// derived from the same source and never both written down.
+//
+// `band_height` is clamped into the card, so a caller that hands over a stale
+// or animating height can distort the split but can never put the band outside
+// the card.
+inline ArcCardLayout ComputeArcCardLayout(bool enabled,
+                                          const gfx::Rect& client_area,
+                                          int card_inset,
+                                          int band_height,
+                                          int window_radius) {
+  ArcCardLayout layout;
+  if (!enabled) {
+    return layout;
+  }
+  layout.enabled = true;
+  layout.card = client_area;
+  layout.card.Inset(gfx::Insets(card_inset));
+  layout.band_height = std::clamp(band_height, 0, layout.card.height());
+  layout.corner_radius = std::max(0, window_radius - card_inset);
+  return layout;
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_CARD_LAYOUT_H_
