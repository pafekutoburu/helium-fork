+  //     wants the old pages back" -- and woke this space's first row on every
+  //     visit. It answers for the one page the window comes up on
+  //     (SessionRestore loads the session's selected tab) and nothing else.
+  if (tabs::TabInterface* const tab = FindTabToShowForSpace(space_id)) {
+    if (service_ &&
+        service_->GetSpaceForTab(tab->GetHandle()) == kGlobalSpaceId) {
+      return;  // the favorite stays active
+    }
