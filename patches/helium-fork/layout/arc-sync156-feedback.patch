--- src.orig/chrome/browser/ui/helium_workspace/workspace_close_landing_unittest.cc
+++ src/chrome/browser/ui/helium_workspace/workspace_close_landing_unittest.cc
@@ -32,5 +32,58 @@
   EXPECT_EQ(TodayRowToCloseBeforeBlank({}), std::nullopt);
 }
 
+// sync156 feedback (2026-11-08): the tab a space comes up on
+// (FindTabToShowForSpace -- ActivateSpaceTab and the carousel's pictures).
+constexpr SpaceLandingTab kOther{.of_space = false};
+constexpr SpaceLandingTab kAwake{.of_space = true};
+constexpr SpaceLandingTab kAsleepPage{.of_space = true, .asleep = true};
+constexpr SpaceLandingTab kAsleepBlank{
+    .of_space = true, .asleep = true, .blank = true};
+
+bool Is(const SpaceLanding& landing, SpaceLandingPick pick, int index = -1) {
+  return landing.pick == pick && landing.index == index;
+}
+
+TEST(WorkspaceSpaceLandingTest, AFavoritesTabStaysWhateverTheSpaceHas) {
+  EXPECT_TRUE(Is(PickSpaceLanding(true, 2, {kAwake, kAwake, kAwake}),
+                 SpaceLandingPick::kActive));
+  EXPECT_TRUE(Is(PickSpaceLanding(true, std::nullopt, {}),
+                 SpaceLandingPick::kActive));
+}
+
+TEST(WorkspaceSpaceLandingTest, TheTabTheSpaceWasOnComesBack) {
+  // Even past an awake tab earlier in the strip, and even asleep: it is the
+  // caller that checked it is still this window's, of the space, in the strip.
+  EXPECT_TRUE(Is(PickSpaceLanding(false, 2, {kAwake, kOther, kAsleepPage}),
+                 SpaceLandingPick::kTab, 2));
+}
+
+TEST(WorkspaceSpaceLandingTest, ElseItsFirstAwakeTabNotASleepingOne) {
+  EXPECT_TRUE(Is(PickSpaceLanding(false, std::nullopt,
+                                  {kOther, kAsleepPage, kAsleepBlank, kAwake,
+                                   kAwake}),
+                 SpaceLandingPick::kTab, 3));
+  // Another space's awake tab is not this one's.
+  EXPECT_TRUE(Is(PickSpaceLanding(false, std::nullopt, {kOther, kAwake}),
+                 SpaceLandingPick::kTab, 1));
+}
+
+TEST(WorkspaceSpaceLandingTest, ElseItsFirstSleepingBlankPage) {
+  EXPECT_TRUE(Is(PickSpaceLanding(false, std::nullopt,
+                                  {kAsleepPage, kAsleepBlank, kOther,
+                                   kAsleepBlank}),
+                 SpaceLandingPick::kTab, 1));
+}
+
+TEST(WorkspaceSpaceLandingTest, ElseNothing) {
+  EXPECT_TRUE(Is(PickSpaceLanding(false, std::nullopt, {}),
+                 SpaceLandingPick::kNone));
+  EXPECT_TRUE(Is(PickSpaceLanding(false, std::nullopt, {kOther, kOther}),
+                 SpaceLandingPick::kNone));
+  // A sleeping page that is not blank is not woken up for it.
+  EXPECT_TRUE(Is(PickSpaceLanding(false, std::nullopt, {kAsleepPage}),
+                 SpaceLandingPick::kNone));
+}
+
 }  // namespace
 }  // namespace helium_workspace
