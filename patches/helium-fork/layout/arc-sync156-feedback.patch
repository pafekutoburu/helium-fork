+namespace {
+
+// Every TabView under |root| (rows nest in groups and splits).
+void ForEachTabView(views::View* root,
+                    const base::RepeatingCallback<void(TabView*)>& visit) {
+  for (views::View* child : root->children()) {
+    if (auto* const tab_view = views::AsViewClass<TabView>(child)) {
+      visit.Run(tab_view);
+    }
+    ForEachTabView(child, visit);
+  }
+}
+
+}  // namespace
+
+void UnpinnedTabContainerView::BeginCaptureActiveTab(
+    const tabs::TabInterface* tab) {
+  if (!capturing_active_tab_) {
+    capturing_active_tab_ = true;
+    shadow_target_before_capture_.SetView(
+        card_shadow_tracker_ ? card_shadow_tracker_->target() : nullptr);
+  }
+  views::View* target = nullptr;
+  ForEachTabView(this, base::BindRepeating(
+                           [](const tabs::TabInterface* tab,
+                              views::View** target, TabView* view) {
+                             const bool selected =
+                                 tab && view->tab_interface() == tab;
+                             view->SetActiveForCapture(selected);
+                             if (selected) {
+                               *target = view;
+                             }
+                           },
+                           tab, &target));
+  SetCardShadowTarget(target);
+}
+
+void UnpinnedTabContainerView::EndCaptureActiveTab() {
+  if (!capturing_active_tab_) {
+    return;
+  }
+  capturing_active_tab_ = false;
+  ForEachTabView(this, base::BindRepeating([](TabView* view) {
+                   view->EndActiveForCapture();
+                 }));
+  SetCardShadowTarget(shadow_target_before_capture_.view());
+  shadow_target_before_capture_.SetView(nullptr);
+}
