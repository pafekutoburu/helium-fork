+std::vector<std::unique_ptr<HeliumViewSnapshotLayer>>
+VerticalTabStripRegionView::CarouselCaptureRowShadows() {
+  std::vector<std::unique_ptr<HeliumViewSnapshotLayer>> pictures;
+  if (!row_shadow_host_ || !row_shadow_host_->layer()) {
+    return pictures;
+  }
+  // The strip has just been laid out for the photographed space
+  // (CarouselFitStrip): the pinned shadow followed in the sidebar's layout,
+  // Today's is re-derived here. Both stand at their rows' landed places --
+  // the live list's offset is the region's per-frame transform, never their
+  // bounds -- so a picture of either rides its slot's transform like the
+  // list's own pictures (SpaceCarousel::Apply), clipped by the host as the
+  // live shadows are.
+  if (UnpinnedTabContainerView* const today = TodayDropContainer()) {
+    today->UpdateCardShadowNow();
+  }
+  const float scale = row_shadow_host_->layer()->device_scale_factor();
+  for (HeliumCardShadowView* const shadow :
+       {pinned_row_shadow_.get(), active_row_shadow_.get()}) {
+    if (!shadow || !shadow->GetVisible() || shadow->bounds().IsEmpty()) {
+      continue;
+    }
+    std::unique_ptr<HeliumViewSnapshotLayer> picture =
+        HeliumViewSnapshotLayer::Capture(shadow, shadow->GetLocalBounds(),
+                                         scale);
+    if (!picture) {
+      continue;
+    }
+    picture->layer()->SetBounds(shadow->bounds());
+    row_shadow_host_->layer()->Add(picture->layer());
+    pictures.push_back(std::move(picture));
+  }
+  return pictures;
+}
