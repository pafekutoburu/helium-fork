--- src.orig/chrome/browser/ui/helium_workspace/workspace_close_landing.h
+++ src/chrome/browser/ui/helium_workspace/workspace_close_landing.h
@@ -43,6 +43,67 @@
   return std::nullopt;
 }
 
+// helium-fork sync156 feedback (2026-11-08; unit-tested since the 2026-11-20
+// review): which tab a space shows when it comes up --
+// WorkspaceTabController::FindTabToShowForSpace, the tab ActivateSpaceTab
+// switches to and the one the space carousel's pictures paint as selected.
+// One entry per tab, in strip order.
+struct SpaceLandingTab {
+  // Of the space coming up: not a favorite's (global), not another space's,
+  // not untagged.
+  bool of_space = false;
+  // Asleep (discarded, or restored and never loaded): no path wakes a row on
+  // the user's behalf (3a-r1 / 3a-r8).
+  bool asleep = false;
+  // A blank new tab page (only read for a sleeping tab).
+  bool blank = false;
+};
+
+enum class SpaceLandingPick {
+  kActive,  // the window's active tab: a favorite's, it belongs to every space
+  kTab,     // the strip index in SpaceLanding::index
+  kNone,    // nothing to show: the caller makes a blank page
+};
+
+struct SpaceLanding {
+  SpaceLandingPick pick = SpaceLandingPick::kNone;
+  int index = -1;
+};
+
+// |active_is_global|: the window's active tab is a favorite's -- it simply
+// stays (Arc g8c). |remembered|: the strip index of the tab the space was on
+// when the window last left it, when that tab is still this window's, of the
+// space and in the strip. Otherwise the space's first awake tab in strip
+// order; else its first sleeping blank page (reused rather than a new one);
+// else none.
+inline SpaceLanding PickSpaceLanding(bool active_is_global,
+                                     std::optional<int> remembered,
+                                     const std::vector<SpaceLandingTab>& tabs) {
+  if (active_is_global) {
+    return {SpaceLandingPick::kActive, -1};
+  }
+  if (remembered) {
+    return {SpaceLandingPick::kTab, *remembered};
+  }
+  std::optional<int> sleeping_blank;
+  for (int i = 0; i < static_cast<int>(tabs.size()); ++i) {
+    if (!tabs[i].of_space) {
+      continue;
+    }
+    if (tabs[i].asleep) {
+      if (!sleeping_blank && tabs[i].blank) {
+        sleeping_blank = i;
+      }
+      continue;
+    }
+    return {SpaceLandingPick::kTab, i};
+  }
+  if (sleeping_blank) {
+    return {SpaceLandingPick::kTab, *sleeping_blank};
+  }
+  return {SpaceLandingPick::kNone, -1};
+}
+
 }  // namespace helium_workspace
 
 #endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_CLOSE_LANDING_H_
