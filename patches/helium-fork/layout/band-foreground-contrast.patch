Index: src/chrome/browser/ui/helium/arc_band_colors.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_band_colors.h
@@ -0,0 +1,140 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_BAND_COLORS_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_BAND_COLORS_H_
+
+#include <optional>
+
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/color_utils.h"
+
+// helium-fork: color derivations for the Arc shell's page-tinted address bar
+// band.
+//
+// Every one of these takes the surface the element is *drawn on* and derives
+// from it. That is the whole point of gathering them here: the band's tint and
+// the field's fill are two different surfaces that happen to agree at rest, and
+// deriving a foreground from the wrong one is invisible text. Keeping the
+// derivations in one place with one input makes the mistake impossible to
+// re-introduce silently -- see the tests in arc_band_colors_unittest.cc.
+//
+// Header-only and free of //ui/views so it can be linked into a lightweight
+// test target (see PROGRESS.md on why anything reaching TestingProfile cannot
+// be built in this tree).
+namespace helium {
+
+// The band's tint: which of the page's colors the band takes, and when it is
+// allowed to take it.
+//
+// `declared_theme_color` is the page's <meta theme-color>, `sampled_top_color`
+// the color actually rendered at the top of the viewport, `declared_background`
+// the document background, and `previous` the tint currently on screen.
+//
+// Order matters twice over:
+//
+//  * The sampled color wins, because it is the only source that reports what is
+//    actually on screen. Both declared colors lie, in opposite directions:
+//    <meta theme-color> is a hint about browser UI and need not equal the page
+//    (YouTube's dark theme declares #212121 over a #0f0f0f page, which read as
+//    "网页是纯黑的，但是顶部背景色是带些灰的"), and the document background lies
+//    about full-bleed dark headers on light documents (films.dance reports
+//    near-white while the strip the band abuts is black, because that black is
+//    an <img> and not a background-color). The band is the page's color, so it
+//    takes the page's pixels whenever they are known.
+//
+//    The two declared colors are what the band shows in the window between a
+//    new document's first frame and its first readback, so the closer one goes
+//    first: the document background is what the page paints behind everything,
+//    while the theme color is free to differ on purpose. Ordering them this way
+//    is what keeps YouTube from stepping #212121 -> #0f0f0f in view.
+//
+//    This ordering only holds because `sampled_top_color` is cleared on a
+//    cross-document navigation (see TopContainerView::DidFinishNavigation). A
+//    stale sample at the head of the ladder would paint the band in the
+//    *previous* page's color; behind the declared colors it was merely unused.
+//
+//  * `page_painted` gates the whole ladder. The declared colors arrive while
+//    the document is being parsed, which is *before* its first frame reaches
+//    the screen -- and Chromium goes on showing the previous page's pixels for
+//    that whole window. Reading them early turned the band black several
+//    hundred milliseconds before the dark page it belonged to appeared. The
+//    band is the page's color, so it may only change when the page does.
+inline std::optional<SkColor> ResolveBandTint(
+    std::optional<SkColor> declared_theme_color,
+    std::optional<SkColor> sampled_top_color,
+    std::optional<SkColor> declared_background,
+    std::optional<SkColor> previous,
+    bool page_painted) {
+  if (!page_painted) {
+    return previous;
+  }
+  std::optional<SkColor> page_color = sampled_top_color;
+  if (!page_color) {
+    page_color = declared_background;
+  }
+  if (!page_color) {
+    page_color = declared_theme_color;
+  }
+  if (!page_color) {
+    // Sticky: a fresh navigation resets the page's declared colors before it
+    // paints anything, and snapping to nullopt here flashed the band back to
+    // the default toolbar look on every reload.
+    return previous;
+  }
+  // The band is a solid surface: every foreground in it is derived from this
+  // color, and deriving from a translucent one is how invisible text happens.
+  return SkColorSetA(*page_color, SK_AlphaOPAQUE);
+}
+
+// The color a glyph on the band is drawn in: an icon's stroke, a chip's text.
+//
+// `backdrop` must be the opaque color the glyph is actually painted on top of,
+// which for anything inside the location bar field is
+// LocationBarView::GetFieldBackdropColor() and not the band's tint -- the two
+// agree at rest and diverge the moment the field is focused.
+//
+// This exists because the derivation was copied into four call sites and one of
+// them was missed: the trailing page action icons and the bookmark star kept
+// reading the theme's icon color, so on a dark site the URL went white while
+// they stayed dark grey and vanished into the band.
+inline SkColor GetBandForegroundColor(SkColor backdrop) {
+  return color_utils::GetColorWithMaxContrast(backdrop);
+}
+
+// The colors the omnibox paints the URL in.
+struct BandTextColors {
+  // The host, and every character while a search term is being typed.
+  SkColor emphasized;
+  // The scheme, path and query -- present but receding.
+  SkColor dimmed;
+};
+
+// `backdrop` must be the opaque color the text is actually painted on top of.
+inline BandTextColors GetBandTextColors(SkColor backdrop) {
+  // Dimming blends back toward the backdrop rather than picking a second theme
+  // color, which would assume a toolbar background that is not there.
+  constexpr float kDimmedTowardBackdrop = 0.62f;
+  const SkColor contrasting = GetBandForegroundColor(backdrop);
+  return {contrasting, color_utils::AlphaBlend(contrasting, backdrop,
+                                               kDimmedTowardBackdrop)};
+}
+
+// The field's own fill on a tinted band -- a quiet wash of the contrasting
+// color rather than a theme color that assumes a toolbar background.
+//
+// Measured references for the hover value: Dia lifts its field by about 8%,
+// Zen's --zen-toolbar-element-bg-hover is rgba(0,0,0,.08)/rgba(255,255,255,.1).
+// At 18% it read as a slab of a different color sitting on the band.
+inline SkColor GetBandFieldColor(SkColor tint, bool hovered) {
+  constexpr float kFieldAlpha = 0.10f;
+  constexpr float kFieldAlphaHovered = 0.08f;
+  return color_utils::AlphaBlend(color_utils::GetColorWithMaxContrast(tint),
+                                 tint,
+                                 hovered ? kFieldAlphaHovered : kFieldAlpha);
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_BAND_COLORS_H_
Index: src/chrome/browser/ui/helium/arc_band_colors_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_band_colors_unittest.cc
@@ -0,0 +1,182 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_band_colors.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+// The surfaces a URL can end up drawn on in the Arc shell. The first two are
+// the band itself (the field is transparent at rest); the last two are the
+// focused/editing field, which upstream deliberately swaps to the popup's
+// theme color so the field and the dropdown read as one surface.
+constexpr SkColor kBlackPage = SkColorSetRGB(0x00, 0x00, 0x00);
+constexpr SkColor kWhitePage = SkColorSetRGB(0xFF, 0xFF, 0xFF);
+constexpr SkColor kLightThemeField = SkColorSetRGB(0xFF, 0xFF, 0xFF);
+constexpr SkColor kDarkThemeField = SkColorSetRGB(0x1F, 0x1F, 0x1F);
+
+// WCAG AA for body text. The emphasized color is the host name -- the one
+// piece of the URL a user actually reads.
+constexpr float kMinTextContrast = 4.5f;
+// The dimmed run is scheme/path/query: supporting text, held to AA-large.
+constexpr float kMinDimmedContrast = 3.0f;
+
+class ArcBandColorsTest : public testing::TestWithParam<SkColor> {};
+
+// The invariant that a whole acceptance round was lost to: the foreground is
+// derived from the surface the text sits on, so it is legible on every surface
+// -- not just on the band. Deriving from the band while the field had been
+// swapped to the theme's near-white produced white-on-white.
+TEST_P(ArcBandColorsTest, TextStaysLegibleOnItsOwnBackdrop) {
+  const SkColor backdrop = GetParam();
+  const BandTextColors colors = GetBandTextColors(backdrop);
+
+  EXPECT_GE(color_utils::GetContrastRatio(colors.emphasized, backdrop),
+            kMinTextContrast);
+  EXPECT_GE(color_utils::GetContrastRatio(colors.dimmed, backdrop),
+            kMinDimmedContrast);
+}
+
+// The dimmed run has to actually read as dimmer, or the emphasis carries no
+// information -- blending it all the way to the contrasting color would pass
+// the contrast assertion above while losing the distinction.
+TEST_P(ArcBandColorsTest, DimmedRecedesFromEmphasized) {
+  const SkColor backdrop = GetParam();
+  const BandTextColors colors = GetBandTextColors(backdrop);
+
+  EXPECT_LT(color_utils::GetContrastRatio(colors.dimmed, backdrop),
+            color_utils::GetContrastRatio(colors.emphasized, backdrop));
+}
+
+INSTANTIATE_TEST_SUITE_P(AllBackdrops,
+                         ArcBandColorsTest,
+                         testing::Values(kBlackPage,
+                                         kWhitePage,
+                                         kLightThemeField,
+                                         kDarkThemeField));
+
+// An icon on the band is held to the same bar as the text next to it. The bug
+// this pins down shipped once: the trailing page action icons and the bookmark
+// star kept the theme's icon color while the URL beside them went white, so on
+// a dark site they were dark grey strokes on a black band.
+TEST_P(ArcBandColorsTest, IconStaysLegibleOnItsOwnBackdrop) {
+  const SkColor backdrop = GetParam();
+  EXPECT_GE(color_utils::GetContrastRatio(GetBandForegroundColor(backdrop),
+                                          backdrop),
+            kMinTextContrast);
+}
+
+// Icons and the emphasized run of the URL sit on the same surface and are read
+// as one row, so they have to be the same color. Keeping this as an assertion
+// is what stops a second derivation from being introduced next to the first.
+TEST_P(ArcBandColorsTest, IconAgreesWithEmphasizedText) {
+  const SkColor backdrop = GetParam();
+  EXPECT_EQ(GetBandForegroundColor(backdrop),
+            GetBandTextColors(backdrop).emphasized);
+}
+
+// The field's wash has to be visible enough to read as a field on hover and
+// quiet enough that the band still reads as one surface with the page. 18% was
+// rejected in testing as "a slab of a different color"; Dia and Zen both sit
+// near 8%.
+TEST(ArcBandFieldColorTest, HoverWashIsQuiet) {
+  for (const SkColor tint : {kBlackPage, kWhitePage}) {
+    const SkColor hovered = GetBandFieldColor(tint, /*hovered=*/true);
+    const float lift = color_utils::GetContrastRatio(hovered, tint);
+    // A 8% wash of the max-contrast color. Expressed as a contrast ratio so
+    // the bound holds for both a black and a white band.
+    EXPECT_GT(lift, 1.0f) << "the wash must be visible at all";
+    EXPECT_LT(lift, 1.6f) << "the wash must not read as a separate surface";
+  }
+}
+
+// At rest the field is not painted at all under the Arc shell, but the value is
+// still what the icon-label bubbles blend against, so it must stay on the same
+// side of the band as the hover value rather than flipping polarity.
+TEST(ArcBandFieldColorTest, RestAndHoverAgreeOnDirection) {
+  for (const SkColor tint : {kBlackPage, kWhitePage}) {
+    const SkColor rest = GetBandFieldColor(tint, /*hovered=*/false);
+    const SkColor hovered = GetBandFieldColor(tint, /*hovered=*/true);
+    const bool tint_is_dark = color_utils::IsDark(tint);
+    EXPECT_EQ(tint_is_dark, color_utils::GetRelativeLuminance(rest) >
+                                color_utils::GetRelativeLuminance(tint));
+    EXPECT_EQ(tint_is_dark, color_utils::GetRelativeLuminance(hovered) >
+                                color_utils::GetRelativeLuminance(tint));
+  }
+}
+
+// The band is the page's color, so it may only change when the page on screen
+// changes. The declared colors of a document arrive while it is being parsed --
+// several hundred milliseconds before its first frame reaches the screen, all
+// of which Chromium spends still showing the previous page. Reading them early
+// is what turned the address bar black on top of a page that had not loaded
+// yet.
+TEST(ResolveBandTintTest, HoldsPreviousUntilThePageHasPainted) {
+  EXPECT_EQ(kWhitePage,
+            ResolveBandTint(kBlackPage, kBlackPage, kBlackPage, kWhitePage,
+                            /*page_painted=*/false));
+  // Including the case where there is nothing to hold onto yet.
+  EXPECT_EQ(std::nullopt,
+            ResolveBandTint(kBlackPage, kBlackPage, kBlackPage, std::nullopt,
+                            /*page_painted=*/false));
+  // And the same inputs, once the page is up, do move the band.
+  EXPECT_EQ(kBlackPage,
+            ResolveBandTint(kBlackPage, kBlackPage, kBlackPage, kWhitePage,
+                            /*page_painted=*/true));
+}
+
+// The sample is the only source that reports what is actually on screen, so it
+// wins outright. Both declared colors are free to disagree with the page, in
+// opposite directions, and each has been caught doing it on a real site.
+TEST(ResolveBandTintTest, PrefersSampledThenDocumentThenDeclared) {
+  constexpr SkColor kSampled = SkColorSetRGB(0x11, 0x22, 0x33);
+  EXPECT_EQ(kSampled, ResolveBandTint(kBlackPage, kSampled, kWhitePage,
+                                      std::nullopt, /*page_painted=*/true));
+  EXPECT_EQ(kWhitePage, ResolveBandTint(kBlackPage, std::nullopt, kWhitePage,
+                                        std::nullopt, /*page_painted=*/true));
+  EXPECT_EQ(kBlackPage,
+            ResolveBandTint(kBlackPage, std::nullopt, std::nullopt,
+                            std::nullopt, /*page_painted=*/true));
+}
+
+// YouTube's dark theme declares theme-color #212121 over a page that renders
+// #0f0f0f, which the user saw as "网页是纯黑的，但是顶部背景色是带些灰的". Two
+// invariants come out of that one site: the sample beats the declaration, and
+// the pre-readback stand-in is the document background rather than the theme
+// color, so the band does not visibly step from one to the other.
+TEST(ResolveBandTintTest, DeclaredThemeColorNeverOverridesThePixels) {
+  constexpr SkColor kDeclared = SkColorSetRGB(0x21, 0x21, 0x21);
+  constexpr SkColor kRendered = SkColorSetRGB(0x0f, 0x0f, 0x0f);
+  EXPECT_EQ(kRendered, ResolveBandTint(kDeclared, kRendered, kRendered,
+                                       std::nullopt, /*page_painted=*/true));
+  // Before the first readback lands, the document background stands in -- and
+  // on this site it already equals the rendered color, so there is no step.
+  EXPECT_EQ(kRendered, ResolveBandTint(kDeclared, std::nullopt, kRendered,
+                                       std::nullopt, /*page_painted=*/true));
+}
+
+// A reload clears every declared color for a moment. Snapping to nullopt there
+// flashed the whole band back to the default toolbar look.
+TEST(ResolveBandTintTest, StaysOnTheLastColorWhenEverySourceIsEmpty) {
+  EXPECT_EQ(kBlackPage,
+            ResolveBandTint(std::nullopt, std::nullopt, std::nullopt,
+                            kBlackPage, /*page_painted=*/true));
+}
+
+// Every foreground in the band is derived from this color, and deriving from a
+// translucent one is how invisible text happens.
+TEST(ResolveBandTintTest, OutputIsAlwaysOpaque) {
+  constexpr SkColor kTranslucent = SkColorSetARGB(0x40, 0x20, 0x30, 0x40);
+  const std::optional<SkColor> tint =
+      ResolveBandTint(kTranslucent, std::nullopt, std::nullopt, std::nullopt,
+                      /*page_painted=*/true);
+  ASSERT_TRUE(tint.has_value());
+  EXPECT_EQ(SK_AlphaOPAQUE, SkColorGetA(*tint));
+  EXPECT_EQ(SkColorSetRGB(0x20, 0x30, 0x40), *tint);
+}
+
+}  // namespace
+}  // namespace helium
