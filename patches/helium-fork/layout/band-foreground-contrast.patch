+namespace {
+
+// helium-fork: a cascading background color that is a literal value rather
+// than a color id -- the Arc shell's band color comes from the page, not from
+// the browser theme.
+class LiteralCascadingColor : public views::CascadingProperty<SkColor> {
+ public:
+  explicit LiteralCascadingColor(SkColor color) : color_(color) {}
+  SkColor GetValue(const views::View* view) const override { return color_; }
+
+ private:
+  const SkColor color_;
+};
+
+}  // namespace
+
+void ToolbarView::SetBandTint(std::optional<SkColor> tint) {
+  // helium-fork: children read this through views::GetCascadingBackgroundColor
+  // and derive a contrasting foreground from it, which is what lets a black
+  // page produce a black band with light icons instead of a grey compromise.
+  band_tint_ = tint;
+  if (tint) {
+    views::SetCascadingProperty(
+        this, views::kCascadingBackgroundColor,
+        std::make_unique<LiteralCascadingColor>(*tint));
+  } else {
+    views::SetCascadingColorProviderColor(
+        this, views::kCascadingBackgroundColor, kColorToolbar);
+  }
+}
+
+// static
+std::optional<SkColor> ToolbarView::GetArcBandTintFor(const views::View* view) {
+  for (const views::View* ancestor = view; ancestor;
+       ancestor = ancestor->parent()) {
+    if (const auto* const toolbar = views::AsViewClass<ToolbarView>(ancestor)) {
+      return toolbar->band_tint();
+    }
+  }
+  // Buttons that have been reparented out of the toolbar -- the collapse and
+  // navigation controls, which live in the sidebar's top row -- are on the app
+  // surface, not the band, and keep the theme's colors.
+  return std::nullopt;
+}
