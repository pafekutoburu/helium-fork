+std::optional<SkColor> BrowserView::GetAddressBarBandTint() const {
+  // helium-fork: the published tint -- the one value every consumer reads.
+  //
+  // This deliberately does NOT recompute. The band's fill is resolved in the
+  // layout pass while the URL text, the field's wash and the toolbar icons are
+  // re-derived from ToolbarView's cached copy, which only UpdateAddressBarBand-
+  // Tint() writes. When this accessor recomputed, any layout triggered by
+  // something else -- and a navigation triggers one as soon as the URL text
+  // changes -- repainted the band in the new page's color without publishing
+  // it, leaving dark text on a black band until the next real publication
+  // ("域名因为黑色背景填充，文字看不到了"). One writer, one value, one frame.
+  return address_bar_band_tint_;
+}
+
+std::optional<SkColor> BrowserView::ComputeAddressBarBandTint() const {
+  // helium-fork: the address bar band belongs to the page, not to the app --
+  // the sidebar and the window frame keep the app's own theme, the band and
+  // the page below it move together.
+  //
+  // The ordering of the sources, and the rule that the band may only change
+  // when the page on screen changes, live in helium::ResolveBandTint().
+  //
+  // Deliberately unclamped: the band's own text and icons are re-derived from
+  // this color (see ToolbarButton::GetForegroundColor and the cascading
+  // background below), so a black page really does get a black band instead
+  // of a grey compromise.
+  if (!ShouldUseContentCardInsets()) {
+    return std::nullopt;
+  }
+  content::WebContents* const contents =
+      const_cast<BrowserView*>(this)->GetActiveWebContents();
+  if (!contents) {
+    return std::nullopt;
+  }
+  return helium::ResolveBandTint(
+      contents->GetThemeColor(),
+      top_container_ ? top_container_->sampled_page_top_color() : std::nullopt,
+      contents->GetBackgroundColor(), address_bar_band_tint_,
+      !top_container_ || top_container_->page_painted());
+}
+
+void BrowserView::UpdateAddressBarBandTint() {
+  const std::optional<SkColor> tint = ComputeAddressBarBandTint();
+  if (tint == address_bar_band_tint_) {
+    return;
+  }
+  address_bar_band_tint_ = tint;
+  if (toolbar_) {
+    toolbar_->SetBandTint(tint);
+  }
+  InvalidateLayout();
+  // The band's children cache their colors and only re-resolve on a theme
+  // change, so the tint has to announce itself as one. This fires per
+  // navigation or tab switch, which is the same cadence at which a web app's
+  // theme color repaints its window.
+  if (views::Widget* const widget = GetWidget()) {
+    widget->ThemeChanged();
+  }
+}
