+namespace band_prefs {
+namespace {
+
+PrefService* PrefsFor(content::BrowserContext* context) {
+  Profile* const profile = Profile::FromBrowserContext(context);
+  return profile ? profile->GetPrefs() : nullptr;
+}
+
+// Opaque origins ("null") would all share one entry, so a sandboxed document
+// could put every other one of them on the list.
+bool IsKeyable(const url::Origin& origin) {
+  return !origin.opaque();
+}
+
+}  // namespace
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  // Not synced: it is an observation about how this profile's browser rendered
+  // a page, not a setting the user made.
+  registry->RegisterDictionaryPref(kDeclaredUntrusted);
+}
+
+bool IsDeclaredUntrusted(content::BrowserContext* context,
+                         const url::Origin& origin) {
+  if (!context || !IsKeyable(origin)) {
+    return false;
+  }
+  PrefService* const prefs = PrefsFor(context);
+  if (!prefs) {
+    return false;
+  }
+  return prefs->GetDict(kDeclaredUntrusted).Find(origin.Serialize()) != nullptr;
+}
+
+void NoteDeclaredObservation(content::BrowserContext* context,
+                             const url::Origin& origin,
+                             bool untrusted) {
+  if (!context || !IsKeyable(origin)) {
+    return;
+  }
+  PrefService* const prefs = PrefsFor(context);
+  if (!prefs) {
+    return;
+  }
+  const std::string key = origin.Serialize();
+  if (!untrusted) {
+    // ⛔ An honest document does NOT clear the origin.
+    //
+    // The table is keyed by origin, and an origin serves many documents: a site
+    // whose front page hides a white document behind a full-bleed dark header
+    // (films.dance) usually has other pages where the declared colour is right.
+    // With "honest clears it" the flag flickered off on every such page and the
+    // flash came back -- measured, not reasoned: 7 of 10 entries still flashed
+    // in the after-fix batch because the probe's own previous page is served
+    // from the same origin (tasks/evidence/T044/a2_fx_bw_enter_*.log). The
+    // promise the user chose is "once per site per profile", so once is what it
+    // costs; the price of a wrong entry is the band being 1-3 frames later on
+    // that origin, which is the same price every held navigation pays.
+    return;
+  }
+  ScopedDictPrefUpdate update(prefs, kDeclaredUntrusted);
+  update->Set(key, base::Time::Now().InMillisecondsFSinceUnixEpoch());
+  if (update->size() <= kMaxDeclaredUntrustedOrigins) {
+    return;
+  }
+  // Full: drop the oldest observations until it fits. The timestamps exist for
+  // exactly this.
+  std::vector<std::pair<double, std::string>> by_age;
+  for (const auto entry : *update) {
+    by_age.emplace_back(entry.second.GetIfDouble().value_or(0.0), entry.first);
+  }
+  std::sort(by_age.begin(), by_age.end());
+  for (size_t i = 0;
+       i + kMaxDeclaredUntrustedOrigins < by_age.size() && i < by_age.size();
+       ++i) {
+    update->Remove(by_age[i].second);
+  }
+}
+
+}  // namespace band_prefs
+
 }  // namespace helium
