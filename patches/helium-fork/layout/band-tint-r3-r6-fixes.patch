@@ -145,6 +162,192 @@
                                  hovered ? kFieldAlphaHovered : kFieldAlpha);
 }
 
+// helium-fork T044: has this origin been caught declaring a colour it does not
+// render?
+//
+// `declared` is the colour the declared rungs above produced for a document's
+// first frame, `sampled` the first pixels that document actually put on screen.
+// Two ways to fail, both from the same complaint: the band flashing a colour
+// that is neither the page it came from nor the page it is going to.
+//
+//  * across the light/dark divide -- a white band over a black page is the
+//    shape the user filmed on films.dance -- with a small absolute difference
+//    required as well, so a mid-grey site that happens to straddle
+//    color_utils' luminance midpoint by one level is not recorded as a liar;
+//  * or simply visibly different, at the same threshold the frame-level ruler
+//    calls "a different colour" (T031 LEAVE_TOL = 20).
+inline constexpr int kDeclaredLieMinDistance = 4;
+inline constexpr int kDeclaredLieDistance = 20;
+
+inline int MaxChannelDistance(SkColor a, SkColor b);
+
+inline bool DeclaredLooksUntrustworthy(SkColor sampled, SkColor declared) {
+  const int distance = MaxChannelDistance(sampled, declared);
+  if (distance > kDeclaredLieDistance) {
+    return true;
+  }
+  return color_utils::IsDark(sampled) != color_utils::IsDark(declared) &&
+         distance > kDeclaredLieMinDistance;
+}
+
+// helium-fork T044: reading the page's top strip again while it stays at the
+// top of the document.
+//
+// The band's colour is the page's colour, and a page can repaint its top strip
+// without touching any of the colours it *declares* -- bilibili with the
+// BewlyBewly extension fades a full-bleed layer in 0.7-2.4 s after first paint
+// and the document background never changes, so nothing in content/public ever
+// tells the browser about it. The only way to see it is to read the pixels
+// again, on a timer, and the whole question is how to do that without the band
+// following scrolling (⛔ 带子取色三条 ②) or chasing a header video.
+//
+// The readback is 16 columns of the same 4 px strip rather than one averaged
+// pixel, because "did the whole strip change" is exactly what separates a page
+// that repainted itself from a nav item's hover background, a text selection or
+// a spinner in one corner. The mean of the columns is the colour; the columns
+// themselves are only ever used to answer that question.
+inline constexpr size_t kTopSampleColumns = 16;
+// Per-channel distance that counts as "a different colour" (entering) ...
+inline constexpr int kTopSampleChangeTolerance = 2;
+// ... and the tighter one that counts as "it has stopped moving" (confirming).
+// A 350 ms fade of 8 levels moves ~2.3 per 100 ms, so a confirmation pair taken
+// across it can never agree: the first pair that does is the fade's end, which
+// is what "渐变结束后再采一次" means without guessing the fade's length.
+inline constexpr int kTopSampleConfirmTolerance = 1;
+inline constexpr size_t kTopSampleMinMovedColumns = 12;
+// After this many unconfirmed samples in a row the strip is animating (a header
+// video), and the caller slows the confirmation down instead of reading back at
+// the fast cadence forever.
+inline constexpr int kTopSampleMaxUnconfirmed = 5;
+
+inline int MaxChannelDistance(SkColor a, SkColor b) {
+  const auto channel = [](int lhs, int rhs) { return lhs > rhs ? lhs - rhs : rhs - lhs; };
+  return std::max({channel(SkColorGetR(a), SkColorGetR(b)),
+                   channel(SkColorGetG(a), SkColorGetG(b)),
+                   channel(SkColorGetB(a), SkColorGetB(b))});
+}
+
+inline SkColor AverageOfColumns(base::span<const SkColor> columns) {
+  if (columns.empty()) {
+    return SK_ColorTRANSPARENT;
+  }
+  int r = 0, g = 0, b = 0;
+  for (SkColor c : columns) {
+    r += SkColorGetR(c);
+    g += SkColorGetG(c);
+    b += SkColorGetB(c);
+  }
+  const int n = static_cast<int>(columns.size());
+  return SkColorSetRGB((r + n / 2) / n, (g + n / 2) / n, (b + n / 2) / n);
+}
+
+inline size_t CountMovedColumns(base::span<const SkColor> before,
+                                base::span<const SkColor> after,
+                                int tolerance) {
+  if (before.size() != after.size()) {
+    return 0;
+  }
+  size_t moved = 0;
+  for (size_t i = 0; i < after.size(); ++i) {
+    if (MaxChannelDistance(before[i], after[i]) > tolerance) {
+      ++moved;
+    }
+  }
+  return moved;
+}
+
+// What survives between two readbacks. Parked on the tab, like every other
+// thing this fork has learned about a page.
+struct TopSampleState {
+  std::optional<SkColor> candidate;
+  int unconfirmed = 0;
+  bool animating = false;
+};
+
+enum class TopSampleVerdict {
+  kIgnore,   // nothing to do; the band keeps the colour it has
+  kConfirm,  // maybe a new colour -- read again shortly and see if it agrees
+  kAccept,   // this is the page's colour now
+};
+
+struct TopSampleDecision {
+  TopSampleVerdict verdict = TopSampleVerdict::kIgnore;
+  // The colour the columns average to, so the caller does not recompute it.
+  SkColor color = SK_ColorTRANSPARENT;
+  // True when the change could just as well be the page scrolling underneath a
+  // scroller the browser cannot see (html/body overflow:hidden with an inner
+  // div). The caller uses this to suppress polling for a while; ⛔ it must not
+  // be treated as "the page changed".
+  bool scroll_correlated = false;
+};
+
+// `accepted` is the colour the band currently shows from pixels (nullopt when
+// this document has never produced one), `accepted_columns` the strip as it
+// looked when that colour was taken, `previous_columns` the strip as the last
+// readback saw it (updated every readback -- it is the signature of the *last
+// sample*, not of the last accepted colour, which is what keeps a rejected
+// change from freezing every later one), `columns` what just came back.
+inline TopSampleDecision ClassifyTopSample(
+    std::optional<SkColor> accepted,
+    base::span<const SkColor> accepted_columns,
+    base::span<const SkColor> previous_columns,
+    base::span<const SkColor> columns,
+    bool scroll_input_since_previous,
+    TopSampleState& state) {
+  TopSampleDecision decision;
+  if (columns.empty()) {
+    return decision;  // a short readback; the caller drops it and re-arms.
+  }
+  decision.color = AverageOfColumns(columns);
+  if (!accepted) {
+    // Nothing to compare against: this is the document's first colour, and the
+    // page is entitled to it immediately (a band with no colour is the one
+    // thing worse than a late one).
+    state = TopSampleState();
+    decision.verdict = TopSampleVerdict::kAccept;
+    return decision;
+  }
+  if (MaxChannelDistance(decision.color, *accepted) <=
+      kTopSampleChangeTolerance) {
+    state = TopSampleState();
+    return decision;
+  }
+  // Whole strip, or one corner of it? Either baseline may answer yes: the last
+  // readback catches a step change, the accepted one catches a fade too slow to
+  // move a column between two readbacks.
+  const bool whole_strip =
+      CountMovedColumns(previous_columns, columns, kTopSampleChangeTolerance) >=
+          kTopSampleMinMovedColumns ||
+      CountMovedColumns(accepted_columns, columns, kTopSampleChangeTolerance) >=
+          kTopSampleMinMovedColumns;
+  if (!whole_strip) {
+    state.candidate.reset();
+    state.unconfirmed = 0;
+    return decision;
+  }
+  if (scroll_input_since_previous) {
+    // The user scrolled between the two readbacks and the root never left the
+    // top: either an inner scroller moved, or the page was rubber-banded. Both
+    // are "where the page is", not "what colour the page is".
+    state.candidate.reset();
+    state.unconfirmed = 0;
+    decision.scroll_correlated = true;
+    return decision;
+  }
+  if (state.candidate && MaxChannelDistance(decision.color, *state.candidate) <=
+                             kTopSampleConfirmTolerance) {
+    state = TopSampleState();
+    decision.verdict = TopSampleVerdict::kAccept;
+    return decision;
+  }
+  state.candidate = decision.color;
+  if (++state.unconfirmed >= kTopSampleMaxUnconfirmed) {
+    state.animating = true;
+  }
+  decision.verdict = TopSampleVerdict::kConfirm;
+  return decision;
+}
+
 }  // namespace helium
 
 #endif  // CHROME_BROWSER_UI_HELIUM_ARC_BAND_COLORS_H_
