+// ---------------------------------------------------------------------------
+// T044: reading the page's top strip again while the page stays at the top.
+//
+// Every one of these is a shape the band has actually been broken by, or that
+// the design review said would break it: a full-bleed overlay fading in
+// (bilibili), one nav item's hover background (a local change that must not
+// move the band), a header video (never settles), and a scroller the browser
+// cannot see (the band must not follow it).
+
+std::vector<SkColor> Strip(SkColor c, size_t n = kTopSampleColumns) {
+  return std::vector<SkColor>(n, c);
+}
+
+TEST(TopSampleTest, FirstColourOfADocumentIsTakenImmediately) {
+  TopSampleState state;
+  const std::vector<SkColor> columns = Strip(kWhitePage);
+  const TopSampleDecision d =
+      ClassifyTopSample(std::nullopt, {}, {}, columns,
+                        /*scroll_input_since_previous=*/false, state);
+  EXPECT_EQ(TopSampleVerdict::kAccept, d.verdict);
+  EXPECT_EQ(kWhitePage, d.color);
+}
+
+TEST(TopSampleTest, TheSameColourAgainIsIgnored) {
+  TopSampleState state;
+  const std::vector<SkColor> columns = Strip(SkColorSetRGB(0xFE, 0xFF, 0xFF));
+  const TopSampleDecision d = ClassifyTopSample(
+      kWhitePage, Strip(kWhitePage), Strip(kWhitePage), columns, false, state);
+  EXPECT_EQ(TopSampleVerdict::kIgnore, d.verdict);
+  EXPECT_FALSE(state.candidate.has_value());
+}
+
+// The bilibili shape: a full-bleed layer fades from white to (247,247,250) in
+// 350 ms. Mid-fade readbacks disagree with each other, so nothing is accepted
+// until the fade stops -- which is how the band lands on the final colour in
+// one step instead of stepping through the fade.
+TEST(TopSampleTest, AFullBleedChangeIsAcceptedOnlyOnceItStopsMoving) {
+  constexpr SkColor kMid = SkColorSetRGB(0xFB, 0xFB, 0xFC);
+  constexpr SkColor kFinal = SkColorSetRGB(0xF7, 0xF7, 0xFA);
+  TopSampleState state;
+  std::vector<SkColor> previous = Strip(kWhitePage);
+  TopSampleDecision d = ClassifyTopSample(kWhitePage, Strip(kWhitePage),
+                                          previous, Strip(kMid), false, state);
+  EXPECT_EQ(TopSampleVerdict::kConfirm, d.verdict);
+  previous = Strip(kMid);
+  d = ClassifyTopSample(kWhitePage, Strip(kWhitePage), previous, Strip(kFinal),
+                        false, state);
+  EXPECT_EQ(TopSampleVerdict::kConfirm, d.verdict);  // still moving
+  previous = Strip(kFinal);
+  d = ClassifyTopSample(kWhitePage, Strip(kWhitePage), previous, Strip(kFinal),
+                        false, state);
+  EXPECT_EQ(TopSampleVerdict::kAccept, d.verdict);
+  EXPECT_EQ(kFinal, d.color);
+}
+
+// A hover background on one nav item, a selection in the corner, a spinner:
+// the mean moves, the strip does not.
+TEST(TopSampleTest, ALocalChangeNeverMovesTheBand) {
+  std::vector<SkColor> columns = Strip(kWhitePage);
+  columns[0] = kBlackPage;
+  columns[1] = kBlackPage;
+  columns[2] = kBlackPage;
+  TopSampleState state;
+  const TopSampleDecision d = ClassifyTopSample(
+      kWhitePage, Strip(kWhitePage), Strip(kWhitePage), columns, false, state);
+  EXPECT_EQ(TopSampleVerdict::kIgnore, d.verdict);
+  EXPECT_GT(MaxChannelDistance(d.color, kWhitePage), kTopSampleChangeTolerance)
+      << "the mean really did move; it is the columns that must veto it";
+}
+
+// A fade slow enough that no single pair of readbacks moves a column still has
+// to be caught, or the band sits on a colour the page left behind.
+TEST(TopSampleTest, AFadeTooSlowToMoveAColumnPerReadbackIsStillCaught) {
+  constexpr SkColor kCrept = SkColorSetRGB(0xF8, 0xF8, 0xFB);
+  const std::vector<SkColor> previous = Strip(SkColorSetRGB(0xF9, 0xF9, 0xFC));
+  TopSampleState state;
+  TopSampleDecision d = ClassifyTopSample(kWhitePage, Strip(kWhitePage),
+                                          previous, Strip(kCrept), false, state);
+  EXPECT_EQ(TopSampleVerdict::kConfirm, d.verdict);
+  d = ClassifyTopSample(kWhitePage, Strip(kWhitePage), Strip(kCrept),
+                        Strip(kCrept), false, state);
+  EXPECT_EQ(TopSampleVerdict::kAccept, d.verdict);
+}
+
+// html/body overflow:hidden with an inner scroller: the root never leaves the
+// top, so is_scroll_offset_at_top cannot help. The only evidence is that the
+// user scrolled between the two readbacks.
+TEST(TopSampleTest, AChangeThatFollowsScrollInputIsRefusedAndReported) {
+  TopSampleState state;
+  const TopSampleDecision d =
+      ClassifyTopSample(kWhitePage, Strip(kWhitePage), Strip(kWhitePage),
+                        Strip(kBlackPage),
+                        /*scroll_input_since_previous=*/true, state);
+  EXPECT_EQ(TopSampleVerdict::kIgnore, d.verdict);
+  EXPECT_TRUE(d.scroll_correlated);
+  EXPECT_FALSE(state.candidate.has_value());
+}
+
+// A header video: consecutive readbacks never agree, so the band stays put and
+// the caller is told to stop confirming at the fast cadence.
+TEST(TopSampleTest, AStripThatNeverSettlesTurnsIntoTheAnimatingState) {
+  TopSampleState state;
+  std::vector<SkColor> previous = Strip(kWhitePage);
+  for (int i = 0; i < kTopSampleMaxUnconfirmed; ++i) {
+    const SkColor moving = SkColorSetRGB(0x10 + 0x20 * i, 0x40, 0x80);
+    const TopSampleDecision d = ClassifyTopSample(
+        kWhitePage, Strip(kWhitePage), previous, Strip(moving), false, state);
+    EXPECT_EQ(TopSampleVerdict::kConfirm, d.verdict);
+    previous = Strip(moving);
+  }
+  EXPECT_TRUE(state.animating);
+}
+
+TEST(TopSampleTest, AShortReadbackIsDroppedRatherThanCrashing) {
+  TopSampleState state;
+  const TopSampleDecision d = ClassifyTopSample(kWhitePage, Strip(kWhitePage),
+                                                Strip(kWhitePage), {}, false,
+                                                state);
+  EXPECT_EQ(TopSampleVerdict::kIgnore, d.verdict);
+}
+
+TEST(TopSampleTest, TheColourIsTheMeanOfTheColumns) {
+  std::vector<SkColor> columns = Strip(kWhitePage, 16);
+  for (size_t i = 0; i < 8; ++i) {
+    columns[i] = kBlackPage;
+  }
+  EXPECT_EQ(SkColorSetRGB(0x80, 0x80, 0x80), AverageOfColumns(columns));
+}
+
 }  // namespace
 }  // namespace helium
