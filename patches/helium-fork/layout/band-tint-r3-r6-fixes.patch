 namespace content {
+class BrowserContext;
 class WebContents;
 }
 
+namespace url {
+class Origin;
+}
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
 // helium-fork: the published address bar band tint, parked on the tab it
 // belongs to.
 //
@@ -36,6 +45,63 @@
 
 std::optional<SkColor> GetPublishedBandTint(content::WebContents* contents);
 
+// helium-fork T044 (H+): which origins have been caught declaring one colour
+// and rendering another.
+//
+// The band takes the page's own pixels, but they do not exist until the page
+// has been drawn, so the colour a navigation publishes *with* the first frame
+// can only be one the page declared. On most sites that is the right colour and
+// it is why the band lands in the same frame the page does. On the ones where
+// it is not -- a full-bleed dark header over a light document -- it is a white
+// flash between two black pages, which is what the user filmed.
+//
+// So the flash is paid once: the first visit to such an origin publishes the
+// declared colour, notices the pixels disagree, and writes the origin down;
+// every later navigation there holds the colour already on screen until the
+// real pixels arrive. Kept as a profile pref rather than in memory because "per
+// profile, once" is the promise; ⛔ nothing about it reaches the page.
+//
+// Once means once for the life of the profile (user, 2026-09-12): the table
+// outlives quitting the app, restarting it, and "clear browsing data" alike,
+// and the only visit allowed to flash is a site's genuine first one. ⛔ That is
+// why it is deliberately NOT wired into the browsing-data remover: what an
+// entry holds is not where this profile has been but how this browser rendered
