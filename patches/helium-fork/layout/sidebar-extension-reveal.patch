Index: src/chrome/browser/ui/helium/arc_toolbar_host.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_toolbar_host.h
@@ -0,0 +1,131 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_TOOLBAR_HOST_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_TOOLBAR_HOST_H_
+
+// helium-fork: where the ToolbarView lives. Three hosts, one answer.
+//
+// The toolbar moves between the band above the page, the sidebar's address row,
+// and a panel-width loan from that row while the field is edited. Encoding that
+// as separate booleans let the combinations drift: the row's height pin
+// outlived the edit it belonged to (an empty 34pt gap above the favorites), a
+// hook meant for the hidden mode gated on "the sidebar is collapsed" instead
+// and fired in the docked one, and a press that could never focus the omnibox
+// still moved the toolbar into the unclipped edit host, where it painted over
+// the page until the window closed (all three user-hit 2026-08-19).
+//
+// So the host is resolved here, as one total function over the inputs, and the
+// caller applies every consequence from the answer rather than patching the
+// deltas. A combination this file cannot produce is a combination the browser
+// cannot get into.
+namespace helium {
+
+enum class ArcToolbarHost {
+  // The address bar band above the page. The docked mode, and the fallback for
+  // every window that has no sidebar to offer.
+  kBand,
+  // The sidebar's address row (hidden address bar mode).
+  kSidebarRow,
+  // The row's loan to the edit panel: same origin, panel width, deliberately
+  // outside the row's clip so the field can be wider than the sidebar.
+  kEditHost,
+};
+
+// `sidebar_can_host` folds the structural conditions -- a vertical tab strip is
+// drawn, the window is a normal one, the row exists. `row_on_screen` is the
+// row's own IsDrawn(): the edit host borrows the row's geometry, so a row that
+// is not on screen (collapsed sidebar) has none to lend, and the loan must fall
+// back rather than strand the toolbar somewhere the sidebar cannot reclaim it.
+inline constexpr ArcToolbarHost ResolveArcToolbarHost(bool has_address_bar_band,
+                                                      bool sidebar_can_host,
+                                                      bool row_on_screen,
+                                                      bool edit_requested) {
+  if (has_address_bar_band || !sidebar_can_host) {
+    return ArcToolbarHost::kBand;
+  }
+  return (edit_requested && row_on_screen) ? ArcToolbarHost::kEditHost
+                                           : ArcToolbarHost::kSidebarRow;
+}
+
+// The row keeps its height only while its toolbar is away in the edit host --
+// otherwise the favorites below jump up the instant the panel opens. Every
+// other host releases the pin: an empty row that still declares a height is a
+// permanent gap, because an empty row is otherwise skipped by the layout
+// outright (zero preferred size).
+inline constexpr bool ArcRowHoldsItsHeight(ArcToolbarHost host) {
+  return host == ArcToolbarHost::kEditHost;
+}
+
+// Whether the toolbar is in the sidebar's world -- the row or the row's loan.
+//
+// This is the predicate for "the field is in the sidebar", and the one hooks
+// must use when they mean it. "The sidebar is collapsed" is NOT the same
+// question: it is true in the docked mode too, where the field is in the band
+// and the sidebar is empty.
+//
+// It also answers who owns the toolbar's visible flag. The tabbed layout sets
+// that flag only while the band hosts the toolbar (layout.AddChild takes a
+// visibility), so in the sidebar's hosts nobody manages it and the arriving
+// host has to reclaim it.
+inline constexpr bool ArcToolbarIsSidebarBound(ArcToolbarHost host) {
+  return host != ArcToolbarHost::kBand;
+}
+
+// Whether the sidebar row's extensions area is shown -- the pinned action
+// icons and the extensions menu button together, since the user reads them as
+// one group and Arc hides the whole group or none of it.
+//
+// `row_hovered` is the address row's own hover, re-derived from the actual
+// cursor position on every recompute rather than accumulated from events: on
+// macOS an exit that arrives while a bubble is opening is deferred and then
+// replayed at the *click* location, so a stored bit goes stale and the icons
+// never retract (user-hit 2026-08-19). ⚠ The row-only trigger is a deliberate
+// departure from Arc, not a copy of it: Arc reveals on the pointer entering
+// the sidebar *anywhere* -- measured 2026-08-19, the icons are up with the
+// pointer on a favorites card and on a tab row far below the address row.
+// The user tried that, found it too eager, and asked for the tighter rule
+// (2026-08-19). Do not "correct" this back to the sidebar-wide hover on the
+// grounds that Arc does it that way.
+//
+// `bubble_anchored` is "some transient UI is anchored in the extensions
+// area" -- the extensions menu, an extension popup, a pop-out, a context
+// menu. While one is open the area must stay up whether or not the pointer
+// is anywhere near the row (its anchor cannot vanish under it); the moment
+// it closes the answer falls back to the pointer.
+inline constexpr bool ShouldRevealSidebarExtensions(bool sidebar_hosted,
+                                                    bool auto_hide,
+                                                    bool row_hovered,
+                                                    bool bubble_anchored) {
+  // The band is upstream's business; nothing here applies to it.
+  if (!sidebar_hosted) {
+    return true;
+  }
+  return !auto_hide || row_hovered || bubble_anchored;
+}
+
+// Whether the extensions area occupies layout width. Distinct from the
+// opacity question above, and deliberately trailing it: while the area is
+// revealed -- or still fading out -- it keeps its width so the icons have
+// somewhere to fade; once the fade lands at zero the width goes too, and the
+// domain takes the whole row (the field's flex maximum is unbounded, so the
+// layout hands it the vacated space by itself).
+//
+// This is the r3 revision of r2's "the area keeps its width either way":
+// the user asked for the full domain at rest (2026-08-19), so the standing
+// invariant is now the narrower one -- the domain's *left edge* never moves,
+// and the tail is elided exactly while the icons are shown.
+inline constexpr bool ShouldReserveSidebarExtensionsSpace(
+    bool sidebar_hosted,
+    bool auto_hide,
+    bool revealed_or_fading) {
+  if (!sidebar_hosted) {
+    return true;
+  }
+  return !auto_hide || revealed_or_fading;
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_TOOLBAR_HOST_H_
Index: src/chrome/browser/ui/helium/arc_toolbar_host_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_toolbar_host_unittest.cc
@@ -0,0 +1,164 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_toolbar_host.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+TEST(ArcToolbarHostTest, TheBandKeepsTheToolbarWhenItExists) {
+  // The docked mode owns the toolbar no matter what the sidebar is doing --
+  // including mid-edit, which is how a mode switch reclaims it.
+  EXPECT_EQ(ArcToolbarHost::kBand,
+            ResolveArcToolbarHost(/*has_address_bar_band=*/true,
+                                  /*sidebar_can_host=*/true,
+                                  /*row_on_screen=*/true,
+                                  /*edit_requested=*/true));
+}
+
+TEST(ArcToolbarHostTest, NoSidebarToHostMeansTheBand) {
+  EXPECT_EQ(ArcToolbarHost::kBand,
+            ResolveArcToolbarHost(/*has_address_bar_band=*/false,
+                                  /*sidebar_can_host=*/false,
+                                  /*row_on_screen=*/true,
+                                  /*edit_requested=*/false));
+}
+
+TEST(ArcToolbarHostTest, TheRowHostsTheHiddenModeAtRest) {
+  EXPECT_EQ(ArcToolbarHost::kSidebarRow,
+            ResolveArcToolbarHost(/*has_address_bar_band=*/false,
+                                  /*sidebar_can_host=*/true,
+                                  /*row_on_screen=*/true,
+                                  /*edit_requested=*/false));
+}
+
+TEST(ArcToolbarHostTest, EditingBorrowsTheEditHost) {
+  EXPECT_EQ(ArcToolbarHost::kEditHost,
+            ResolveArcToolbarHost(/*has_address_bar_band=*/false,
+                                  /*sidebar_can_host=*/true,
+                                  /*row_on_screen=*/true,
+                                  /*edit_requested=*/true));
+}
+
+TEST(ArcToolbarHostTest, AnOffScreenRowHasNoGeometryToLend) {
+  // Collapsing the sidebar mid-edit: the loan falls back to the row rather
+  // than stranding the toolbar in a host the sidebar no longer covers, where
+  // it painted over the page and survived the collapse (user-hit 2026-08-19).
+  EXPECT_EQ(ArcToolbarHost::kSidebarRow,
+            ResolveArcToolbarHost(/*has_address_bar_band=*/false,
+                                  /*sidebar_can_host=*/true,
+                                  /*row_on_screen=*/false,
+                                  /*edit_requested=*/true));
+}
+
+TEST(ArcToolbarHostTest, EveryInputCombinationResolves) {
+  // Totality is the point of the function: 16 combinations, one host each, no
+  // pair of booleans left to contradict one another.
+  for (int bits = 0; bits < 16; ++bits) {
+    const bool band = bits & 1;
+    const bool can_host = bits & 2;
+    const bool on_screen = bits & 4;
+    const bool editing = bits & 8;
+    const ArcToolbarHost host =
+        ResolveArcToolbarHost(band, can_host, on_screen, editing);
+    if (band || !can_host) {
+      EXPECT_EQ(ArcToolbarHost::kBand, host) << "bits=" << bits;
+    } else if (editing && on_screen) {
+      EXPECT_EQ(ArcToolbarHost::kEditHost, host) << "bits=" << bits;
+    } else {
+      EXPECT_EQ(ArcToolbarHost::kSidebarRow, host) << "bits=" << bits;
+    }
+  }
+}
+
+TEST(ArcToolbarHostTest, OnlyTheEditHostPinsTheRowsHeight) {
+  // The pin is derived from the host, so no exit path can leave it behind --
+  // the empty 34pt gap above the favorites was a pin that outlived its edit.
+  EXPECT_TRUE(ArcRowHoldsItsHeight(ArcToolbarHost::kEditHost));
+  EXPECT_FALSE(ArcRowHoldsItsHeight(ArcToolbarHost::kSidebarRow));
+  EXPECT_FALSE(ArcRowHoldsItsHeight(ArcToolbarHost::kBand));
+}
+
+TEST(ArcToolbarHostTest, BothSidebarHostsAreSidebarBound) {
+  // The edit host is the row's loan, so anything asking "is the field in the
+  // sidebar" must answer yes for it too.
+  EXPECT_TRUE(ArcToolbarIsSidebarBound(ArcToolbarHost::kSidebarRow));
+  EXPECT_TRUE(ArcToolbarIsSidebarBound(ArcToolbarHost::kEditHost));
+  EXPECT_FALSE(ArcToolbarIsSidebarBound(ArcToolbarHost::kBand));
+}
+
+// Off by default, so the row the user approved keeps its icons. When on, the
+// area is gone at rest and back on the address row's own hover -- deliberately
+// tighter than Arc, which reveals on the whole sidebar.
+TEST(ArcToolbarHostTest, AutoHideOnlyAppliesInTheSidebar) {
+  for (const bool auto_hide : {false, true}) {
+    for (const bool hovered : {false, true}) {
+      for (const bool bubble : {false, true}) {
+        EXPECT_TRUE(ShouldRevealSidebarExtensions(/*sidebar_hosted=*/false,
+                                                auto_hide, hovered, bubble));
+      }
+    }
+  }
+}
+
+TEST(ArcToolbarHostTest, AutoHideOffKeepsTheIconsInTheRow) {
+  for (const bool hovered : {false, true}) {
+    for (const bool bubble : {false, true}) {
+      EXPECT_TRUE(ShouldRevealSidebarExtensions(/*sidebar_hosted=*/true,
+                                              /*auto_hide=*/false, hovered,
+                                              bubble));
+    }
+  }
+}
+
+TEST(ArcToolbarHostTest, AutoHideOnFollowsTheRowsHover) {
+  EXPECT_FALSE(ShouldRevealSidebarExtensions(/*sidebar_hosted=*/true,
+                                           /*auto_hide=*/true,
+                                           /*row_hovered=*/false,
+                                           /*bubble_anchored=*/false));
+  EXPECT_TRUE(ShouldRevealSidebarExtensions(/*sidebar_hosted=*/true,
+                                          /*auto_hide=*/true,
+                                          /*row_hovered=*/true,
+                                          /*bubble_anchored=*/false));
+}
+
+// A menu or popup anchored in the extensions area holds the icons up with the
+// pointer anywhere at all -- its anchor cannot vanish under it -- and the
+// moment it closes the answer falls back to the pointer. This is the fix for
+// the icons never retracting after an extensions-menu click (2026-08-19).
+TEST(ArcToolbarHostTest, AnAnchoredBubbleHoldsTheReveal) {
+  EXPECT_TRUE(ShouldRevealSidebarExtensions(/*sidebar_hosted=*/true,
+                                          /*auto_hide=*/true,
+                                          /*row_hovered=*/false,
+                                          /*bubble_anchored=*/true));
+  // Bubble gone, pointer elsewhere: retract.
+  EXPECT_FALSE(ShouldRevealSidebarExtensions(/*sidebar_hosted=*/true,
+                                           /*auto_hide=*/true,
+                                           /*row_hovered=*/false,
+                                           /*bubble_anchored=*/false));
+}
+
+// The width trails the reveal: reserved while shown or still fading, released
+// only once the fade lands, and never released at all outside the sidebar or
+// with auto-hide off. This is what lets the domain take the whole row at rest
+// (user 2026-08-19) without the tail ellipsis snapping mid-fade.
+TEST(ArcToolbarHostTest, TheAreasWidthTrailsItsFade) {
+  EXPECT_TRUE(ShouldReserveSidebarExtensionsSpace(/*sidebar_hosted=*/false,
+                                                /*auto_hide=*/true,
+                                                /*revealed_or_fading=*/false));
+  EXPECT_TRUE(ShouldReserveSidebarExtensionsSpace(/*sidebar_hosted=*/true,
+                                                /*auto_hide=*/false,
+                                                /*revealed_or_fading=*/false));
+  EXPECT_TRUE(ShouldReserveSidebarExtensionsSpace(/*sidebar_hosted=*/true,
+                                                /*auto_hide=*/true,
+                                                /*revealed_or_fading=*/true));
+  EXPECT_FALSE(ShouldReserveSidebarExtensionsSpace(/*sidebar_hosted=*/true,
+                                                 /*auto_hide=*/true,
+                                                 /*revealed_or_fading=*/false));
+}
+
+}  // namespace
+}  // namespace helium
