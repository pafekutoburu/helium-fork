 std::unique_ptr<views::View> PageInfoMainView::CreateBubbleHeaderView() {
-  return views::Builder<views::FlexLayoutView>()
+  // helium-fork: the header's quick actions -- install-PWA and bookmark moved
+  // here from the address field (the hidden mode's sidebar row has no width
+  // to spare, so its two page actions live next to the domain instead).
+  // Availability is evaluated once per bubble open; the bubble is short-lived
+  // and the actions close it anyway.
+  auto make_quick_action = [&](const gfx::VectorIcon& icon, int tooltip_id,
+                               base::RepeatingClosure callback) {
+    auto button = views::CreateVectorImageButtonWithNativeTheme(
+        std::move(callback), icon, 16);
+    button->SetTooltipText(l10n_util::GetStringUTF16(tooltip_id));
+    views::InstallCircleHighlightPathGenerator(button.get());
+    button->SetProperty(views::kCrossAxisAlignmentKey,
+                        views::LayoutAlignment::kCenter);
+    button->SetProperty(views::kMarginsKey, gfx::Insets::VH(0, 4));
+    return button;
+  };
+  std::unique_ptr<views::View> header = views::Builder<views::FlexLayoutView>()
       .SetInteriorMargin(gfx::Insets::VH(0, 20))
       .AddChildren(
           views::Builder<views::Label>(
@@ -701,6 +724,48 @@ std::unique_ptr<views::View> PageInfoMai
                                     button->GetInsets());
               })))
       .Build();
+  // Insert between the title (index 0) and the close button, in the order the
+  // field used to show them: install-PWA, then the star.
+  size_t index = 1;
+  if (ui_delegate_->CanInstallPwa()) {
+    header->AddChildViewAt(
+        make_quick_action(
+            features::IsRoundedIconsEnabled()
+                ? kInstallDesktopIcon
+                : kInstallDesktopChromeRefreshOldIcon,
+            IDS_OMNIBOX_PWA_INSTALL_ICON_LABEL,
+            base::BindRepeating(&PageInfoMainView::QuickInstallPwa,
+                                base::Unretained(this))),
+        index++);
+  }
+  if (ui_delegate_->CanBookmarkPage()) {
+    const bool starred = ui_delegate_->IsPageBookmarked();
+    header->AddChildViewAt(
+        make_quick_action(
+            starred ? (features::IsRoundedIconsEnabled()
+                           ? omnibox::kStarFilledIcon
+                           : omnibox::kStarActiveChromeRefreshOldIcon)
+                    : (features::IsRoundedIconsEnabled()
+                           ? omnibox::kStarIcon
+                           : omnibox::kStarChromeRefreshOldIcon),
+            starred ? IDS_TOOLTIP_STARRED : IDS_TOOLTIP_STAR,
+            base::BindRepeating(&PageInfoMainView::QuickBookmarkPage,
+                                base::Unretained(this))),
+        index++);
+  }
+  return header;
+}
+
+void PageInfoMainView::QuickBookmarkPage() {
+  // Post first, close second: the action outlives the bubble, `this` and the
+  // delegate do not.
+  ui_delegate_->BookmarkPage();
+  navigation_handler_->CloseBubble();
+}
+
+void PageInfoMainView::QuickInstallPwa() {
+  ui_delegate_->InstallPwa();
+  navigation_handler_->CloseBubble();
 }
 
