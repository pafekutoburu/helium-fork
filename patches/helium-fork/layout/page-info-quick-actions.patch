 Profile* ChromePageInfoUiDelegate::GetProfile() const {
   return Profile::FromBrowserContext(web_contents_->GetBrowserContext());
 }
+
+// helium-fork: header quick actions. The doers post free functions bound to a
+// WebContents WeakPtr: the caller closes the bubble immediately after, which
+// destroys this delegate, so nothing here may run the command synchronously
+// or bind `this`.
+namespace {
+
+void RunBookmarkPage(base::WeakPtr<content::WebContents> web_contents) {
+  if (!web_contents) {
+    return;
+  }
+  if (BrowserWindowInterface* const browser =
+          GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+              web_contents.get())) {
+    chrome::BookmarkCurrentTab(browser);
+  }
+}
+
+void RunInstallPwa(base::WeakPtr<content::WebContents> web_contents) {
+  if (!web_contents) {
+    return;
+  }
+  if (BrowserWindowInterface* const browser =
+          GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+              web_contents.get())) {
+    chrome::ExecuteCommand(browser, IDC_INSTALL_PWA);
+  }
+}
+
+}  // namespace
+
+bool ChromePageInfoUiDelegate::CanBookmarkPage() {
+  BrowserWindowInterface* const browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(web_contents_);
+  return browser && chrome::CanBookmarkCurrentTab(browser);
+}
+
+bool ChromePageInfoUiDelegate::IsPageBookmarked() {
+  bookmarks::BookmarkModel* const model =
+      BookmarkModelFactory::GetForBrowserContext(
+          web_contents_->GetBrowserContext());
+  return model && model->IsBookmarked(site_url_);
+}
+
+void ChromePageInfoUiDelegate::BookmarkPage() {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&RunBookmarkPage, web_contents_->GetWeakPtr()));
+}
+
+bool ChromePageInfoUiDelegate::CanInstallPwa() {
+  BrowserWindowInterface* const browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(web_contents_);
+  return browser && chrome::IsCommandEnabled(browser, IDC_INSTALL_PWA);
+}
+
+void ChromePageInfoUiDelegate::InstallPwa() {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&RunInstallPwa, web_contents_->GetWeakPtr()));
+}
