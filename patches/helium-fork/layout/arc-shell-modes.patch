+void ApplyArcShellLayoutPrefs(PrefService* profile_prefs) {
+  // helium-fork: the Arc shell is the only layout this fork ships. The other
+  // HeliumLayoutType values stay in the code (they keep the monthly upstream
+  // sync small) but nothing can reach them any more, so the pref is pinned
+  // rather than merely defaulted -- a stale profile would otherwise open in
+  // the classic layout with no way back.
+  if (profile_prefs->GetInitializationStatus() ==
+      PrefService::INITIALIZATION_STATUS_WAITING) {
+    // The store has not loaded; decide on a later launch.
+    return;
+  }
+
+  if (IsVerticalTabsFeatureEnabled() &&
+      profile_prefs->GetInteger(prefs::kHeliumLayout) !=
+          std::to_underlying(HeliumLayoutType::kVertical)) {
+    profile_prefs->SetInteger(prefs::kHeliumLayout,
+                              std::to_underlying(HeliumLayoutType::kVertical));
+  }
+
+  if (profile_prefs->GetBoolean(prefs::kHeliumArcShellMigrated)) {
+    return;
+  }
+  // One-time carry-over: a profile that had zen mode on keeps the
+  // auto-revealing address bar, which is what zen mode now means.
+  if (!profile_prefs->HasPrefPath(prefs::kHeliumAddressBarMode) &&
+      profile_prefs->GetBoolean(prefs::kHeliumZenMode)) {
+    profile_prefs->SetInteger(prefs::kHeliumAddressBarMode,
+                              std::to_underlying(HeliumAddressBarMode::kAuto));
+  }
+  profile_prefs->SetBoolean(prefs::kHeliumArcShellMigrated, true);
+}
