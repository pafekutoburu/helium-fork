 bool HeliumLayoutStateController::IsZenModeEnabled() const {
-  return pref_service_->GetBoolean(prefs::kHeliumZenMode);
+  // helium-fork: zen mode is the "address bar reveals on hover" form of the
+  // Arc shell. Everything downstream of this accessor is unchanged.
+  return GetAddressBarMode() == HeliumAddressBarMode::kAuto;
+}
+
+HeliumAddressBarMode HeliumLayoutStateController::GetAddressBarMode() const {
+  const int value = pref_service_->GetInteger(prefs::kHeliumAddressBarMode);
+  if (value < std::to_underlying(HeliumAddressBarMode::kDocked) ||
+      value > std::to_underlying(HeliumAddressBarMode::kMaxValue)) {
+    return HeliumAddressBarMode::kDocked;
+  }
+  return static_cast<HeliumAddressBarMode>(value);
+}
+
+bool HeliumLayoutStateController::HasAddressBarBand() const {
+  return GetAddressBarMode() != HeliumAddressBarMode::kHidden;
+}
+
+void HeliumLayoutStateController::SetAddressBarMode(
+    HeliumAddressBarMode mode) {
+  pref_service_->SetInteger(prefs::kHeliumAddressBarMode,
+                            std::to_underlying(mode));
 }
 
