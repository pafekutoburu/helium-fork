+// helium-fork: the Arc shell has a single layout (the sidebar) and three
+// forms, which differ only in how the address bar band behaves. The band is
+// the one piece of top chrome the shell still has, so this replaces the
+// old zen-mode boolean rather than sitting beside it.
+enum class HeliumAddressBarMode {
+  // The band is always visible above the contents.
+  kDocked = 0,
+  // No band at all; the address entry lives in the sidebar.
+  kHidden = 1,
+  // The band reveals on hover and hides again (what zen mode used to be).
+  kAuto = 2,
+  kMaxValue = kAuto,
+};
