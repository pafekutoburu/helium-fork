+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_BAND_TINT_STORE_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_BAND_TINT_STORE_H_
+
+#include <optional>
+
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace content {
+class WebContents;
+}
+
+// helium-fork: the published address bar band tint, parked on the tab it
+// belongs to.
+//
+// BrowserView::UpdateAddressBarBandTint() is the single writer of this color
+// and BrowserView::GetAddressBarBandTint() the natural reader, but the root
+// scrollbar needs it from GetRootScrollbarThemeColor() in
+// chrome_content_browser_client.cc -- a file that reaches
+// //chrome/browser/ui/browser.h and no further, and certainly not into
+// //chrome/browser/ui/views. Rather than pull views in there, or grow a second
+// copy of helium::ResolveBandTint()'s ladder (this fork has paid for
+// "one colour, two truths" more than once), the one writer parks its answer
+// where any layer can read it.
+//
+// Keyed on the WebContents rather than the window so a tab dragged into
+// another window keeps its colour, which is the same reason the *sampled*
+// colour lives there (see top_container_view.cc).
+namespace helium {
+
+void SetPublishedBandTint(content::WebContents* contents,
+                          std::optional<SkColor> tint);
+
+std::optional<SkColor> GetPublishedBandTint(content::WebContents* contents);
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_BAND_TINT_STORE_H_
