+  // helium-fork M4-r2: the sidebar's blank belongs to this menu too. The
+  // stretch under the new tab button already arrives as HTCAPTION, but the
+  // list above it has to answer HTCLIENT -- its rows tell a click from a drag
+  // -- so right-clicking between rows used to do nothing at all. Reaching this
+  // method already proves no row, entry, button or scrollbar claimed the
+  // press (a view with a ContextMenuController consumes it), which is exactly
+  // what "blank" means here, so the bounds test is the whole condition.
+  //
+  // ⛔ Which is also why neither TabStripView nor VerticalTabStripBottomContainer
+  // may install a ContextMenuController: whatever one of them showed would
+  // replace this menu rather than add to it. That is what M4-r1 did, and the
+  // user lost the whole window menu on the sidebar blank until M4-r2.
+  bool in_sidebar_blank = false;
+  if (browser_view_) {
+    if (VerticalTabStripRegionView* const sidebar =
+            browser_view_->vertical_tab_strip_region_view()) {
+      if (sidebar->GetVisible()) {
+        gfx::Point point_in_sidebar(p);
+        views::View::ConvertPointFromScreen(sidebar, &point_in_sidebar);
+        in_sidebar_blank = sidebar->HitTestPoint(point_in_sidebar);
+      }
+    }
+  }
