+++ src/chrome/browser/ui/helium_workspace/workspace_blank_tab.h
@@ -27,21 +27,32 @@ inline constexpr std::string_view kNewTa
 inline constexpr std::string_view kNewTabHost = "newtab";
 inline constexpr std::string_view kNewTabPageHost = "new-tab-page";
 
+// Whether |visible_url| is the browser's own new tab page, whatever the tab's
+// history. This is the *shape* question -- the UI asks it to decide that the
+// page gets the centred composer and the band no capsule -- and the page keeps
+// that shape however it was reached: opened fresh, returned to with Back, or
+// restored (helium-fork r8③-fix, user 2026-08-22: "new tab 不论在任何时候，它的
+// 样子都是带中央面板搜索框"; Dia's composer is page content and behaves the same).
+inline bool IsNewTabPageUrl(const GURL& visible_url) {
+  return visible_url.scheme() == kNewTabScheme &&
+         (visible_url.host() == kNewTabHost ||
+          visible_url.host() == kNewTabPageHost);
+}
+
 // Whether a tab is the browser's own new tab page with nothing behind it.
 //
 // This is the state a window is left in when closing its last tab hands the
 // user a fresh tab instead of taking the window away. Recognising that state
 // is what lets the *next* close actually close the window, so the rule reads
 // as "closing the last tab costs you nothing, closing the nothing costs you
-// the window".
+// the window". It is the *disposability* question, and the only one that may
+// look at history -- do not use it to decide how the page looks.
 //
 // |entry_count| is the tab's navigation entry count: zero while the new tab is
 // still pending, one once it commits. Anything above that means the user has
 // navigated, and the tab now holds something they could lose.
 inline bool IsBlankNewTabState(const GURL& visible_url, int entry_count) {
-  return entry_count <= 1 && visible_url.scheme() == kNewTabScheme &&
-         (visible_url.host() == kNewTabHost ||
-          visible_url.host() == kNewTabPageHost);
+  return entry_count <= 1 && IsNewTabPageUrl(visible_url);
 }
 
