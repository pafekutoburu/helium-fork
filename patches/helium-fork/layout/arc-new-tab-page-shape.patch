Index: src/chrome/browser/ui/helium_workspace/workspace_blank_tab_unittest.cc
===================================================================
--- src.orig/chrome/browser/ui/helium_workspace/workspace_blank_tab_unittest.cc
+++ src/chrome/browser/ui/helium_workspace/workspace_blank_tab_unittest.cc
@@ -51,5 +51,32 @@ TEST(WorkspaceBlankTabTest, MatchingHost
   EXPECT_FALSE(IsBlankNewTabState(GURL("https://newtab/"), 1));
 }
 
+// The shape question (helium-fork r8③-fix): the new tab page looks like the
+// new tab page however it was reached, so the URL predicate ignores history.
+TEST(WorkspaceBlankTabTest, NewTabPageUrlIsRecognisedOnBothHosts) {
+  EXPECT_TRUE(IsNewTabPageUrl(GURL("chrome://newtab/")));
+  EXPECT_TRUE(IsNewTabPageUrl(GURL("chrome://new-tab-page/")));
+}
+
+TEST(WorkspaceBlankTabTest, NewTabPageUrlIgnoresHistory) {
+  // The same URL that IsBlankNewTabState refuses with history behind it.
+  EXPECT_FALSE(IsBlankNewTabState(GURL("chrome://new-tab-page/"), 2));
+  EXPECT_TRUE(IsNewTabPageUrl(GURL("chrome://new-tab-page/")));
+}
+
+TEST(WorkspaceBlankTabTest, NewTabPageUrlRejectsOtherPages) {
+  EXPECT_FALSE(IsNewTabPageUrl(GURL("https://example.com/")));
+  EXPECT_FALSE(IsNewTabPageUrl(GURL("chrome://settings/")));
+  EXPECT_FALSE(IsNewTabPageUrl(GURL("https://newtab/")));
+  EXPECT_FALSE(IsNewTabPageUrl(GURL()));
+}
+
+// Disposability still requires an empty history: the two questions differ
+// exactly there.
+TEST(WorkspaceBlankTabTest, BlankStateIsNewTabPageUrlPlusEmptyHistory) {
+  EXPECT_TRUE(IsBlankNewTabState(GURL("chrome://newtab/"), 1));
+  EXPECT_FALSE(IsBlankNewTabState(GURL("chrome://newtab/"), 2));
+}
+
 }  // namespace
 }  // namespace helium_workspace
