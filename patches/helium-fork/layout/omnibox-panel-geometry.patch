Index: src/chrome/browser/ui/views/helium/arc_omnibox_panel_painter.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/views/helium/arc_omnibox_panel_painter.cc
@@ -0,0 +1,105 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/helium/arc_omnibox_panel_painter.h"
+
+#include <algorithm>
+#include <vector>
+
+#include "base/numerics/safe_conversions.h"
+#include "cc/paint/paint_flags.h"
+#include "third_party/skia/include/core/SkRRect.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/skia_conversions.h"
+#include "ui/gfx/scoped_canvas.h"
+#include "ui/gfx/shadow_value.h"
+#include "ui/gfx/skia_paint_util.h"
+
+namespace helium {
+
+namespace {
+
+SkColor BlackWithAlpha(double alpha) {
+  return SkColorSetARGB(base::ClampRound(255.0 * alpha), 0, 0, 0);
+}
+
+// The shadow's geometry. Only the elevation matters here -- the alphas change
+// how dark it is, never how far it reaches -- so this is shared by the two
+// callers that have to reserve room for it and by the painter itself.
+gfx::ShadowValues ShadowGeometry(const ArcOmniboxPanelMetrics& metrics) {
+  return gfx::ShadowValue::MakeMdShadowValues(metrics.shadow_elevation);
+}
+
+}  // namespace
+
+gfx::Insets ArcOmniboxPanelShadowInsets(
+    const ArcOmniboxPanelMetrics& metrics) {
+  if (!metrics.enabled) {
+    return gfx::Insets();
+  }
+  // GetMargin() is negative (it is meant for Rect::Inset to expand with), and
+  // callers here want the room as a positive number.
+  return gfx::Insets() - gfx::ShadowValue::GetMargin(ShadowGeometry(metrics));
+}
+
+void PaintArcOmniboxPanel(gfx::Canvas* canvas,
+                          const ArcOmniboxPanelMetrics& metrics,
+                          const gfx::Rect& panel,
+                          SkColor background,
+                          bool dark,
+                          std::optional<gfx::Rect> hole) {
+  if (!metrics.enabled || panel.IsEmpty()) {
+    return;
+  }
+
+  const gfx::ShadowValues shadows = gfx::ShadowValue::MakeMdShadowValues(
+      metrics.shadow_elevation,
+      BlackWithAlpha(dark ? metrics.shadow_dark_key : metrics.shadow_light_key),
+      BlackWithAlpha(dark ? metrics.shadow_dark_ambient
+                          : metrics.shadow_light_ambient));
+
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  flags.setColor(background);
+  flags.setLooper(gfx::CreateShadowDrawLooper(shadows));
+
+  gfx::ScopedCanvas scoped(canvas);
+  if (hole.has_value() && !hole->IsEmpty()) {
+    // Subtract the field so it shows through rather than being painted over.
+    // The shadow's own inner blur is subtracted with it, which is the point:
+    // the panel is one surface with the field in it, not a card sitting behind
+    // a second card.
+    //
+    // The rect drawn below is bounded by its own geometry, so this clip only
+    // ever removes -- it is not what keeps the paint inside the view. (See
+    // PROGRESS.md on ArcCardOutlineView's first version, where a canvas-wide
+    // DrawColor() leaned on a non-rectangular clip and painted a 478pt white
+    // band across the page.)
+    //
+    // The hole is cut 1dp inside the field, not on it. The field paints its own
+    // capsule, in the band's layer, one layer below this one -- and an
+    // antialiased clip on the exact same outline leaves the two layers sharing
+    // every edge pixel: the field covers it `a` and this fill covers it `1 - a`,
+    // so the pixel comes out (1 - a + a^2) white plus a(1 - a) of whatever is
+    // behind, up to a quarter of the band's colour. On a black page that is a
+    // grey hairline tracing the field's whole capsule 3pt inside the panel's
+    // edge -- "two stacked capsules", measured at 201/255 before this line.
+    // One dp in lands the seam on the field's own fully opaque white instead
+    // (editing pins the field to kColorOmniboxResultsBackground, the very
+    // colour this fill uses), and white over white has no edge. The field's
+    // contents start far further in than 1dp, so nothing of it is covered.
+    gfx::Rect inner(*hole);
+    inner.Inset(1);
+    canvas->sk_canvas()->clipRRect(
+        SkRRect::MakeRectXY(gfx::RectFToSkRect(gfx::RectF(inner)),
+                            std::max(0, metrics.field_radius - 1),
+                            std::max(0, metrics.field_radius - 1)),
+        SkClipOp::kDifference, /*doAntiAlias=*/true);
+  }
+  canvas->DrawRoundRect(panel, metrics.panel_radius, flags);
+}
+
+}  // namespace helium
