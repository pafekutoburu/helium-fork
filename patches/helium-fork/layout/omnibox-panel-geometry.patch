Index: src/chrome/browser/ui/helium/arc_omnibox_panel.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_omnibox_panel.h
@@ -0,0 +1,190 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_OMNIBOX_PANEL_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_OMNIBOX_PANEL_H_
+
+#include <algorithm>
+
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/rect.h"
+
+// helium-fork: the geometry of the Arc shell's edit-state panel -- the white
+// rounded card that the address field turns into when it is clicked, and that
+// the suggestion list grows downwards inside.
+//
+// Why a single source: the panel is drawn by two different owners in two
+// different widgets -- the omnibox popup's RoundedOmniboxResultsFrame when
+// there are suggestions, and ArcOmniboxPanelView (a BrowserView child, because
+// the band clips its own contents and the field can therefore not cast a
+// shadow) when the field is focused with nothing to suggest yet. The user must
+// not be able to tell which one is on screen, so the two must agree to the
+// pixel. Before this header they did not even agree with themselves: one panel
+// carried four different corner radii (field 11, the popup's cutout 8, its
+// background layer a hard-coded 12, its shadow border 16).
+//
+// Numbers measured on Dia 2026-08-16 (2x screenshots, converted to pt) and the
+// two places we cannot follow it, both recorded here because they are the first
+// things to revisit if the panel ever reads as "not floating enough":
+//
+//   * Dia's panel is its hover capsule inflated by 40.5pt on each side, sharing
+//     its centre exactly. We inflate by kHeliumBasePadding instead: our field
+//     starts 3pt from the card's left edge (the navigation buttons live in the
+//     sidebar, so we do not have Dia's 148pt of band to grow into), and 40pt
+//     would push the panel out over the sidebar -- off the window entirely once
+//     the sidebar is collapsed. Dia's panel never leaves its own card.
+//     The user's answer to that (2026-08-17) is kEmptyPanelBottomOutset below:
+//     spend the growth we cannot have sideways on height instead.
+//   * Dia's panel radius is 20. Ours is the card's radius, because inflating by
+//     only 3pt lands the panel's top-left corner exactly on the card's, and two
+//     different arcs meeting there is the "two rectangles pretending to be one"
+//     cue this whole shell exists to remove. The card's radius also keeps the
+//     panel concentric with the field: panel_radius - outset == field_radius.
+//
+// The root cause of both is that Dia's band is 54pt and ours is 34pt; there is
+// only 3pt of window margin above our card to grow into. Making the panel
+// Dia-proportioned starts with the band's height, not with this file.
+//
+// Header-only and free of //ui/views so it can be linked into the lightweight
+// test target (see PROGRESS.md on why anything reaching TestingProfile cannot
+// be built in this tree).
+namespace helium {
+
+// How far below the field the panel reaches while there is nothing to suggest
+// yet -- the "it popped out" cue, and the only reason the panel is visible as a
+// panel at all on a page whose colour the shadow cannot darken (a black page
+// takes no shadow, so before this the panel's bottom edge sat exactly on the
+// band's and there was nothing to see).
+//
+// Dia reaches 59pt past a 41.5pt band (1.42x the band's height; measured off
+// d_01_click.png: card top y=12, band bottom y=95, panel y=1..213, all 2x).
+// The proportional value for our 34pt band would be 48. We take 18: Dia fills
+// its overhang with a real row ("+ Add tabs or files / ... / mic / Go", its AI
+// attachment bar) and we have nothing to put there, so the rest of its 106pt is
+// content we do not have rather than margin we are missing.
+//
+// This is the dial to turn when the panel reads as too shy or too empty. It is
+// deliberately not a parameter of ComputeArcOmniboxPanel(): unlike the outset
+// and the radii, which must stay tied to the layout constants they are derived
+// from, this one answers only to the eye.
+inline constexpr int kEmptyPanelBottomOutset = 18;
+
+struct ArcOmniboxPanelMetrics {
+  // False when the Arc band treatment does not apply (popup windows, high
+  // contrast, no vertical tab strip, or the row hosted in the sidebar rather
+  // than the band). Every number is then zero and callers must keep upstream's
+  // own metrics rather than reading these.
+  bool enabled = false;
+
+  // How far the panel grows past the field on the left, right and top. The
+  // bottom is where the suggestions are, so it is never inset.
+  int outset = 0;
+
+  // How far the panel reaches past the field's bottom edge while there is
+  // nothing to suggest -- see kEmptyPanelBottomOutset. It belongs to PanelFor()
+  // alone: alignment_insets() is what the suggestion list aligns itself to the
+  // field with, and there the bottom is where the results start.
+  int bottom_outset = 0;
+
+  // The panel's own corner radius.
+  int panel_radius = 0;
+
+  // The field's radius, which is also the radius of the hole the panel leaves
+  // for it. These are the same number by construction: the field shows through
+  // that hole, so a mismatch is a visible double arc.
+  int field_radius = 0;
+
+  // ui::Shadow elevation and the black alphas it is tinted with, in the same
+  // shape ShadowFrameView::ShadowAlpha takes. Kept as plain doubles so this
+  // header stays free of //ui/views.
+  int shadow_elevation = 0;
+  double shadow_light_key = 0.0;
+  double shadow_light_ambient = 0.0;
+  double shadow_dark_key = 0.0;
+  double shadow_dark_ambient = 0.0;
+
+  // How the panel is placed around the field. This is the shape the omnibox
+  // popup's own alignment insets take, so it can be handed straight to
+  // Rect::Inset() with a minus sign.
+  //
+  // The bottom stays 0 on purpose, bottom_outset or not: this is the popup's
+  // geometry, and there the space below the field is the suggestion list. The
+  // overhang is the empty panel's alone, so typing can only ever make the panel
+  // taller -- the first suggestion row is worth more than the 18pt apron it
+  // replaces, so the bottom edge never travels back up.
+  gfx::Insets alignment_insets() const {
+    return gfx::Insets::TLBR(outset, outset, 0, outset);
+  }
+
+  // The panel rect for a given field rect, before the suggestions add height.
+  // Grows the field on three sides by `outset`, so the two share a horizontal
+  // centre -- Dia's one invariant that survives our narrower margins -- and
+  // past its bottom edge by `bottom_outset`, which is what lifts the panel off
+  // the band and onto the page.
+  gfx::Rect PanelFor(const gfx::Rect& field) const {
+    if (!enabled) {
+      return gfx::Rect();
+    }
+    gfx::Rect panel(field);
+    panel.Inset(-gfx::Insets::TLBR(outset, outset, bottom_outset, outset));
+    return panel;
+  }
+};
+
+// `card_radius` is the content card's corner radius and `field_radius` the
+// address field's; both must come from the callers' existing concentric chain
+// (system window radius -> card -> field), never be written down a second time
+// here. `outset` is the same kHeliumBasePadding the card and the field are
+// already spaced by -- passing it in rather than reading the layout constant
+// keeps this header dependency-free and the relationship assertable.
+inline ArcOmniboxPanelMetrics ComputeArcOmniboxPanel(bool enabled,
+                                                     int outset,
+                                                     int card_radius,
+                                                     int field_radius) {
+  ArcOmniboxPanelMetrics metrics;
+  if (!enabled) {
+    return metrics;
+  }
+  metrics.enabled = true;
+  metrics.outset = std::max(0, outset);
+  metrics.bottom_outset = kEmptyPanelBottomOutset;
+  metrics.field_radius = std::max(0, field_radius);
+  // Concentric with the field by construction rather than by coincidence: a
+  // caller that hands over a card radius which does not sit `outset` outside
+  // the field gets the concentric answer anyway, and the unit test pins that.
+  metrics.panel_radius = std::max(metrics.field_radius + metrics.outset,
+                                  std::max(0, card_radius));
+  // Dia's shadow, measured off dia_06_after_click_text.png with panelshadow.py
+  // and then matched by measuring ours the same way (both panels tall, so the
+  // two are comparable):
+  //
+  //           reach sideways   reach below   edge darkening side / below
+  //   Dia          70px            96px            5.5%  /  8.3%
+  //   ours         55px           113px            5.0%  /  8.4%
+  //
+  // Material Design's shape turns out to be close to Dia's: measured at
+  // elevation 20 the below/side density ratio came out 1.57 against Dia's 1.51,
+  // so only the two dials below need setting.
+  //
+  //   * reach is 2*elevation sideways and 3*elevation below, hence 35. It lands
+  //     tighter than Dia at the sides and longer underneath; moving the
+  //     elevation fixes one and spoils the other, so it stays between them.
+  //   * edge darkening is half the summed alpha and does not depend on the
+  //     blur, so 0.11 total buys Dia's 5.5%. MD's own defaults (0x3d key,
+  //     0x1f ambient = 0.36 total) are three times too heavy -- at elevation 20
+  //     with 0.14 total we measured 6.7% / 10.5%, visibly heavier than Dia.
+  //
+  // The dark-mode pair keeps the ratio to the light one that the content card's
+  // shadow uses (2.0x key, 2.35x ambient).
+  metrics.shadow_elevation = 35;
+  metrics.shadow_light_key = 0.07;
+  metrics.shadow_light_ambient = 0.04;
+  metrics.shadow_dark_key = 0.14;
+  metrics.shadow_dark_ambient = 0.09;
+  return metrics;
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_OMNIBOX_PANEL_H_
Index: src/chrome/browser/ui/helium/arc_omnibox_panel_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_omnibox_panel_unittest.cc
@@ -0,0 +1,151 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_omnibox_panel.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace helium {
+namespace {
+
+// The measured baseline: kHeliumBasePadding, the 17 -> 14 -> 11 concentric
+// chain, and the field as M3.4 leaves it (band x+3, band y+3, 28 tall,
+// spanning the band's middle).
+constexpr int kOutset = 3;
+constexpr int kCardRadius = 14;
+constexpr int kFieldRadius = 11;
+constexpr gfx::Rect kField(206, 6, 1000, 28);
+
+ArcOmniboxPanelMetrics Metrics() {
+  return ComputeArcOmniboxPanel(/*enabled=*/true, kOutset, kCardRadius,
+                                kFieldRadius);
+}
+
+// The invariant the four-radii mess gave away: the field shows through a hole
+// in the panel, so the hole's radius IS the field's radius. Anything else
+// paints two arcs one inside the other at every corner of the field.
+TEST(ArcOmniboxPanelTest, HoleRadiusIsTheFieldRadius) {
+  EXPECT_EQ(kFieldRadius, Metrics().field_radius);
+}
+
+// Concentric: stepping `outset` outwards from the field's arc has to land on
+// the panel's arc. This is the same relationship the window (17), the card (14)
+// and the field (11) already stand in, and it is why the panel's radius is the
+// card's rather than Dia's 20 -- see the header.
+TEST(ArcOmniboxPanelTest, PanelIsConcentricWithTheField) {
+  const ArcOmniboxPanelMetrics metrics = Metrics();
+  EXPECT_EQ(metrics.field_radius + metrics.outset, metrics.panel_radius);
+}
+
+// A caller that derives the card radius somewhere else and gets it wrong must
+// not be able to break concentricity -- it can only make the panel rounder.
+TEST(ArcOmniboxPanelTest, ConcentricitySurvivesAWrongCardRadius) {
+  for (int card_radius : {0, 5, 11, 14, 20, 40}) {
+    const ArcOmniboxPanelMetrics metrics =
+        ComputeArcOmniboxPanel(/*enabled=*/true, kOutset, card_radius,
+                               kFieldRadius);
+    SCOPED_TRACE(testing::Message() << "card_radius=" << card_radius);
+    EXPECT_GE(metrics.panel_radius, metrics.field_radius + metrics.outset);
+  }
+}
+
+// The alignment insets grow on three sides only: this is the geometry the
+// suggestion list aligns itself to the field with, and the space below the
+// field is the list. The empty panel's overhang deliberately does NOT show up
+// here -- if it did, every suggestion list would gain an 18pt gap under its
+// last row and the popup's bounds would stop matching the shipped build.
+TEST(ArcOmniboxPanelTest, AlignmentInsetsLeaveTheBottomAlone) {
+  const gfx::Insets insets = Metrics().alignment_insets();
+  EXPECT_EQ(kOutset, insets.top());
+  EXPECT_EQ(kOutset, insets.left());
+  EXPECT_EQ(kOutset, insets.right());
+  EXPECT_EQ(0, insets.bottom());
+  EXPECT_GT(Metrics().bottom_outset, 0);
+}
+
+// Dia's one geometric invariant that survives our narrower margins: the panel
+// and the field share a horizontal centre, and the panel contains the field.
+TEST(ArcOmniboxPanelTest, PanelSharesTheFieldsCentreAndContainsIt) {
+  const ArcOmniboxPanelMetrics metrics = Metrics();
+  const gfx::Rect panel = metrics.PanelFor(kField);
+  EXPECT_TRUE(panel.Contains(kField));
+  EXPECT_EQ(kField.CenterPoint().x(), panel.CenterPoint().x());
+  EXPECT_EQ(kField.x() - kOutset, panel.x());
+  EXPECT_EQ(kField.right() + kOutset, panel.right());
+  EXPECT_EQ(kField.y() - kOutset, panel.y());
+  EXPECT_EQ(kField.bottom() + metrics.bottom_outset, panel.bottom());
+}
+
+// The overhang is the whole point of M3.6: without it the panel's bottom edge
+// sits exactly on the band's, so on a page whose colour the shadow cannot
+// darken there is nothing at all to see and the panel reads as a second capsule
+// inside the address bar.
+TEST(ArcOmniboxPanelTest, PanelReachesPastTheFieldsBottom) {
+  const ArcOmniboxPanelMetrics metrics = Metrics();
+  EXPECT_EQ(kEmptyPanelBottomOutset, metrics.bottom_outset);
+  EXPECT_GT(metrics.bottom_outset, metrics.outset);
+  const gfx::Rect panel = metrics.PanelFor(kField);
+  EXPECT_EQ(kField.height() + kOutset + metrics.bottom_outset, panel.height());
+}
+
+// The overhang goes down and nowhere else. Anything that spent it sideways
+// would push the panel over the sidebar -- off the window once the sidebar is
+// collapsed -- which is the reason we are growing downwards in the first place.
+TEST(ArcOmniboxPanelTest, OverhangDoesNotMoveTheOtherThreeEdges) {
+  ArcOmniboxPanelMetrics no_overhang = Metrics();
+  no_overhang.bottom_outset = 0;
+  const gfx::Rect before = no_overhang.PanelFor(kField);
+  const gfx::Rect after = Metrics().PanelFor(kField);
+  EXPECT_EQ(before.x(), after.x());
+  EXPECT_EQ(before.y(), after.y());
+  EXPECT_EQ(before.width(), after.width());
+  EXPECT_EQ(before.bottom() + kEmptyPanelBottomOutset, after.bottom());
+}
+
+// The panel's top-left corner lands exactly on the card's, which is the whole
+// reason its radius is the card's. Written as the card's own arithmetic so a
+// change to kHeliumBasePadding cannot silently split the two apart.
+TEST(ArcOmniboxPanelTest, PanelTopLeftLandsOnTheCardTopLeft) {
+  constexpr gfx::Rect kCard(203, 3, 1074, 794);
+  const gfx::Rect panel = Metrics().PanelFor(kField);
+  EXPECT_EQ(kCard.x(), panel.x());
+  EXPECT_EQ(kCard.y(), panel.y());
+}
+
+// Disabled means "keep upstream's numbers", not "use zeroed-out ones": every
+// field has to read as obviously unusable so a caller that forgets to check
+// `enabled` fails loudly rather than drawing a radius-0 panel at the origin.
+TEST(ArcOmniboxPanelTest, DisabledYieldsNothing) {
+  const ArcOmniboxPanelMetrics metrics =
+      ComputeArcOmniboxPanel(/*enabled=*/false, kOutset, kCardRadius,
+                             kFieldRadius);
+  EXPECT_FALSE(metrics.enabled);
+  EXPECT_EQ(0, metrics.outset);
+  EXPECT_EQ(0, metrics.bottom_outset);
+  EXPECT_EQ(0, metrics.panel_radius);
+  EXPECT_EQ(0, metrics.field_radius);
+  EXPECT_EQ(0, metrics.shadow_elevation);
+  EXPECT_TRUE(metrics.PanelFor(kField).IsEmpty());
+  EXPECT_TRUE(metrics.alignment_insets().IsEmpty());
+}
+
+// The shadow is one material shared by the popup frame and the focus panel, so
+// both halves of it have to arrive together. A zero alpha with a non-zero
+// elevation is the failure mode that looks like "the shadow just did not turn
+// on" and costs a build cycle to spot.
+TEST(ArcOmniboxPanelTest, ShadowIsFullySpecifiedWhenEnabled) {
+  const ArcOmniboxPanelMetrics metrics = Metrics();
+  EXPECT_GT(metrics.shadow_elevation, 0);
+  EXPECT_GT(metrics.shadow_light_key, 0.0);
+  EXPECT_GT(metrics.shadow_light_ambient, 0.0);
+  EXPECT_GT(metrics.shadow_dark_key, 0.0);
+  EXPECT_GT(metrics.shadow_dark_ambient, 0.0);
+  // Dark mode is heavier than light, the way the content card's shadow is.
+  EXPECT_GT(metrics.shadow_dark_key, metrics.shadow_light_key);
+  EXPECT_GT(metrics.shadow_dark_ambient, metrics.shadow_light_ambient);
+}
+
+}  // namespace
+}  // namespace helium
