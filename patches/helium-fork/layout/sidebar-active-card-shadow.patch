+std::optional<UnpinnedTabContainerView::EntryDropSpot>
+UnpinnedTabContainerView::EntryDropSpotAt(const gfx::Point& loc) {
+  if (!collection_node_) {
+    return std::nullopt;
+  }
+  const helium_workspace::WorkspaceService* workspace_service =
+      GetWorkspaceService();
+  size_t row_position = 0;
+  for (auto& child_node : collection_node_->children()) {
+    views::View* const view = child_node->view();
+    // Entry tabs are drawn by the sidebar and laid out at no bounds here, so
+    // they are neither a landing spot nor a row to count.
+    if (!view || IsWorkspaceEntryTab(workspace_service, view)) {
+      continue;
+    }
+    if (loc.y() >= view->bounds().CenterPoint().y()) {
+      ++row_position;
+      continue;
+    }
+    // First row whose centre is below the pointer: land in front of it.
+    const std::optional<BrowserRootView::DropIndex> drop =
+        GetDragHandler().GetLinkDropIndexForNode(*child_node,
+                                                 DragPositionHint::kBefore);
+    if (!drop) {
+      return std::nullopt;
+    }
+    return EntryDropSpot{drop->index, row_position};
+  }
+  const std::optional<BrowserRootView::DropIndex> drop =
+      GetDragHandler().GetLinkDropIndexForNode(*collection_node_, std::nullopt);
+  if (!drop) {
+    return std::nullopt;
+  }
+  return EntryDropSpot{drop->index, row_position};
+}
