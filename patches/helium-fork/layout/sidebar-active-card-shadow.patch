+void UnpinnedTabContainerView::SetCardShadowFrame(
+    HeliumCardShadowView* card_shadow) {
+  if (card_shadow_ != card_shadow) {
+    card_shadow_ = card_shadow;
+    card_shadow_scroll_subscription_ = {};
+  }
