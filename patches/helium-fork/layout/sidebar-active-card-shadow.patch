+class UnpinnedTabContainerView::CardShadowTracker : public views::ViewObserver {
+ public:
+  explicit CardShadowTracker(UnpinnedTabContainerView* container)
+      : container_(container) {}
+  CardShadowTracker(const CardShadowTracker&) = delete;
+  CardShadowTracker& operator=(const CardShadowTracker&) = delete;
+  ~CardShadowTracker() override = default;
+
+  void SetTarget(views::View* target) {
+    if (target_ != target) {
+      observation_.Reset();
+      target_ = target;
+      if (target_) {
