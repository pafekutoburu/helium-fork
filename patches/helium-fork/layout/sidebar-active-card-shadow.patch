+
+void UnpinnedTabContainerView::UpdateCardShadow() {
+  if (!card_shadow_ || !card_shadow_tracker_) {
+    return;
+  }
+  views::ScrollView* const scroll_view = GetScrollViewForContainer();
+  // Layer scrolling never touches view bounds, so no observer fires when the
+  // list scrolls under the row -- follow the offset directly. Subscribed
+  // lazily: the container is not inside its scroll view yet when the region
+  // injects the shadow.
+  if (scroll_view && !card_shadow_scroll_subscription_) {
+    card_shadow_scroll_subscription_ = scroll_view->AddContentsScrolledCallback(
+        base::BindRepeating(&UnpinnedTabContainerView::UpdateCardShadow,
+                            base::Unretained(this)));
+  }
+  views::View* const shadow_parent = card_shadow_->parent();
+  views::View* const target = card_shadow_tracker_->target();
+  const int radius =
+      GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius);
+  bool shadow_visible =
+      target && target->GetVisible() && Contains(target) && shadow_parent &&
+      scroll_view &&
+      helium::CanShowCardShadow(target->width(), target->height(), radius);
+  // r5 hid the shadow for the whole drag; the user overruled that on
+  // 2026-08-20 -- the card keeps its shadow while it is carried. The drag
+  // handler parks the row's bounds and moves it by layer transform, which
+  // ConvertRectToTarget already folds in (View::GetTransformRelativeTo), so
+  // the only thing this needed was a transform observer on the tracker.
+  const bool dragging = shadow_visible && IsViewDragging(*target);
+  gfx::RectF rect;
+  if (shadow_visible) {
+    rect = gfx::RectF(gfx::SizeF(target->size()));
+    views::View::ConvertRectToTarget(target, shadow_parent, &rect);
+    rect.Offset(-scroll_view->CurrentOffset().x(),
+                -scroll_view->CurrentOffset().y());
+    // The region's layer never clips, so a row scrolled to the list's edge
+    // would cast outside the scroll area; hide instead (the row's own card
+    // is being clipped there anyway). A *dragged* row is exempt: it rides its
+    // own layer above the scroll view and is not clipped either, so clipping
+    // its shadow would be the odd one out.
+    if (!dragging) {
+      gfx::RectF scroll_rect(gfx::SizeF(scroll_view->size()));
+      views::View::ConvertRectToTarget(scroll_view, shadow_parent,
+                                       &scroll_rect);
+      scroll_rect.Inset(-1.0f);
+      shadow_visible = scroll_rect.Contains(rect);
+    }
+  }
+  if (!shadow_visible) {
+    card_shadow_->SetVisible(false);
+    return;
+  }
+  // The unified capsule radius; a split half's inset variant differs by a
+  // couple of points, invisible at these shadow alphas.
+  card_shadow_->SetShadowCornerRadius(radius);
+  // The card rect, not the (outset) shadow rect: SetCardBounds() grows the
+  // view itself, and the edge test above must keep judging the row.
+  card_shadow_->SetCardBounds(gfx::ToEnclosingRect(rect));
+  card_shadow_->SetVisible(true);
+}
+
 void UnpinnedTabContainerView::ResetCollectionNode() {
   collection_node_ = nullptr;
 }
