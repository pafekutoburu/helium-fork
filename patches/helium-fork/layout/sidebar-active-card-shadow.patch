+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_HELIUM_CARD_SHADOW_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_HELIUM_CARD_SHADOW_VIEW_H_
+
+#include <optional>
+
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/view.h"
+
+// helium-fork: the floating card's soft shadow -- a self-painted pair of
+// blurred round-rects (constants in arc_sidebar_surface.h), not a ui::Shadow.
+// The MD ninepatch model clamps its elevation to (min_dim - 2r)/4, which
+// pins a 34pt row at radius 12 to a tight directional cast; Dia's look is a
+// broad, near-centered halo that model cannot express at any parameter.
+//
+// Non-interactive. The view's bounds are the *card's* bounds outset by
+// kSidebarCardShadowOutset{H,V} -- callers hand over the card rect via
+// SetCardBounds() and never SetBoundsRect() directly. Because the bounds
+// overhang the card on every side, hosts that hit-test children for
+// window-caption purposes must skip this class explicitly
+// (SetCanProcessEventsWithinSubtree() stops events, not HitTestPoint()).
+class HeliumCardShadowView : public views::View {
+  METADATA_HEADER(HeliumCardShadowView, views::View)
+
+ public:
+  HeliumCardShadowView();
+  ~HeliumCardShadowView() override;
+
+  // Positions the shadow around `card_bounds` (in the parent's coordinates).
+  void SetCardBounds(const gfx::Rect& card_bounds);
+
+  // The fade knob, mirrored from the card it underlines: a sibling layer
+  // inherits neither the card's opacity animation nor its visibility.
+  void SetShadowOpacity(double opacity);
+
+  // The card's corner radius (the blurred silhouette follows it).
+  void SetShadowCornerRadius(int corner_radius);
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+  void OnThemeChanged() override;
+
+ private:
+  int corner_radius_ = 8;
+  std::optional<bool> was_dark_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_HELIUM_CARD_SHADOW_VIEW_H_
