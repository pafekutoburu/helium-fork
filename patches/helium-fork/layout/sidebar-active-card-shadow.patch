+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/helium_card_shadow_view.h"
+
+#include "base/numerics/safe_conversions.h"
+#include "cc/paint/draw_looper.h"
+#include "cc/paint/paint_canvas.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/helium/arc_sidebar_surface.h"
+#include "third_party/skia/include/core/SkClipOp.h"
+#include "third_party/skia/include/core/SkPoint.h"
+#include "third_party/skia/include/core/SkRRect.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_provider.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/geometry/insets_f.h"
+#include "ui/gfx/geometry/outsets.h"
+#include "ui/gfx/geometry/skia_conversions.h"
+
+BEGIN_METADATA(HeliumCardShadowView)
+END_METADATA
+
+HeliumCardShadowView::HeliumCardShadowView() {
+  SetCanProcessEventsWithinSubtree(false);
+  // A layer of its own: the host stacks it by child order (index 0 puts it
+  // beneath the tab strip's layer) and fades it via SetShadowOpacity.
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+}
+
+HeliumCardShadowView::~HeliumCardShadowView() = default;
+
+void HeliumCardShadowView::SetCardBounds(const gfx::Rect& card_bounds) {
+  gfx::Rect bounds = card_bounds;
+  bounds.Outset(gfx::Outsets::VH(helium::kSidebarCardShadowOutsetV,
+                                 helium::kSidebarCardShadowOutsetH));
+  SetBoundsRect(bounds);
+}
+
+void HeliumCardShadowView::SetShadowOpacity(double opacity) {
+  layer()->SetOpacity(static_cast<float>(opacity));
+}
+
+void HeliumCardShadowView::SetShadowCornerRadius(int corner_radius) {
+  if (corner_radius_ == corner_radius) {
+    return;
+  }
+  corner_radius_ = corner_radius;
+  SchedulePaint();
+}
+
+void HeliumCardShadowView::OnPaint(gfx::Canvas* canvas) {
+  const ui::ColorProvider* const provider = GetColorProvider();
+  const bool is_dark =
+      provider && color_utils::IsDark(provider->GetColor(kColorToolbar));
+
+  gfx::RectF card{gfx::SizeF(size())};
+  card.Inset(gfx::InsetsF::VH(helium::kSidebarCardShadowOutsetV,
+                              helium::kSidebarCardShadowOutsetH));
+  const SkScalar radius = SkIntToScalar(corner_radius_);
+  const SkRRect card_rrect =
+      SkRRect::MakeRectXY(gfx::RectFToSkRect(card), radius, radius);
+
+  // Only the ring paints: the blur bleeds inward too, and while the opaque
+  // card covers that at rest, the card's fade animations would let it show
+  // through -- carve the card's own silhouette out instead.
+  cc::PaintCanvas* const paint_canvas = canvas->sk_canvas();
+  cc::PaintCanvasAutoRestore restore(paint_canvas, /*save=*/true);
+  paint_canvas->clipRRect(card_rrect, SkClipOp::kDifference,
+                          /*do_anti_alias=*/true);
+
+  for (const helium::SidebarCardShadowPass& pass :
+       helium::kSidebarCardShadowPasses) {
+    const double alpha = is_dark ? pass.dark_alpha : pass.light_alpha;
+    gfx::RectF pass_rect = card;
+    pass_rect.Inset(gfx::InsetsF::VH(0, pass.inset_h));
+    const SkRRect pass_rrect =
+        SkRRect::MakeRectXY(gfx::RectFToSkRect(pass_rect), radius, radius);
+    cc::DrawLooperBuilder looper;
+    looper.AddShadow(
+        {0, SkIntToScalar(pass.offset_y)}, SkDoubleToScalar(pass.sigma),
+        SkColor4f::FromColor(SkColorSetA(
+            SK_ColorBLACK, base::ClampRound<U8CPU>(255.0 * alpha))),
+        cc::DrawLooper::kOverrideAlphaFlag);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SK_ColorTRANSPARENT);
+    flags.setLooper(looper.Detach());
+    paint_canvas->drawRRect(pass_rrect, flags);
+  }
+}
+
+void HeliumCardShadowView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  const ui::ColorProvider* const provider = GetColorProvider();
+  const bool is_dark =
+      provider && color_utils::IsDark(provider->GetColor(kColorToolbar));
+  if (was_dark_ != is_dark) {
+    was_dark_ = is_dark;
+    SchedulePaint();
+  }
+}
