+void UnpinnedTabContainerView::SetWorkspaceEntryDragActive(bool active) {
+  views::ScrollView* const scroll_view = GetScrollViewForContainer();
+  if (!scroll_view) {
+    return;
+  }
+  if (active) {
+    if (!saved_scrollbar_mode_) {
+      saved_scrollbar_mode_ = scroll_view->GetVerticalScrollBarMode();
+      saved_overflow_indicator_ = scroll_view->GetDrawOverflowIndicator();
+    }
+    scroll_view->SetVerticalScrollBarMode(
+        views::ScrollView::ScrollBarMode::kHiddenButEnabled);
+    // ⚠ Both, exactly like TabStripView::DisableOverflowVisuals(). Hiding
+    // only the scrollbar leaves the overflow *indicator* -- a light rule
+    // across Today -- which is what the user saw as "一条白线" once the
+    // scrollbar itself was suppressed (2026-08-25).
+    scroll_view->SetDrawOverflowIndicator(false);
+  } else if (saved_scrollbar_mode_) {
+    scroll_view->SetVerticalScrollBarMode(*saved_scrollbar_mode_);
+    if (saved_overflow_indicator_) {
+      scroll_view->SetDrawOverflowIndicator(*saved_overflow_indicator_);
+      saved_overflow_indicator_.reset();
+    }
+    saved_scrollbar_mode_.reset();
+  }
+}
