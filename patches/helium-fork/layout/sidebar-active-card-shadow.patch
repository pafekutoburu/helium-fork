+
+int UnpinnedTabContainerView::HandleWorkspaceEntryDragAt(
+    const gfx::Point& point_in_this) {
+  if (!workspace_drag_host_) {
+    return ui::DragDropTypes::DRAG_NONE;
+  }
+  // ⚠ Two different points. *Which row* is asked with y clamped into this
+  // container, because the region forwards the separator band above it and
+  // there is no row up there to be past. The *card* must get the real
+  // pointer: clamping that one too pinned the card to Today's top edge for
+  // the width of the band -- a jump and then ~110ms of not following the
+  // hand, which is the snag the crossing had (user 2026-08-25).
+  const gfx::Point point_for_index(point_in_this.x(),
+                                   std::max(0, point_in_this.y()));
+  // 轮3-r4: the row lookup happens before the sidebar's entry point, so it
+  // is handed over separately or it would fall outside the frame's handler
+  // total. No clock is read unless --helium-drag-perf armed the instrument.
+  const bool measuring = workspace_drag_host_->drag_perf_active();
+  const base::TimeTicks hit_start =
+      measuring ? base::TimeTicks::Now() : base::TimeTicks();
+  const std::optional<EntryDropSpot> spot = EntryDropSpotAt(point_for_index);
+  if (measuring) {
+    workspace_drag_host_->AddTodayHitSample(base::TimeTicks::Now() - hit_start);
+  }
+  const bool accepted = workspace_drag_host_->OnTodayDragUpdate(
+      *this, point_in_this,
+      spot ? std::optional<int>(spot->tab_index) : std::nullopt,
+      spot ? spot->row_position : 0u);
+  return accepted ? ui::DragDropTypes::DRAG_MOVE
+                  : ui::DragDropTypes::DRAG_NONE;
+}
