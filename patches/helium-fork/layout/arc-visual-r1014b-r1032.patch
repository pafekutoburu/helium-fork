+// r1026: see OmniboxArcList::provider_types.
+void DetachArcListProviders(
+    AutocompleteMatch& match,
+    std::vector<std::optional<AutocompleteProvider::Type>>& types) {
+  types.push_back(match.provider ? std::make_optional(match.provider->type())
+                                 : std::nullopt);
+  match.provider = nullptr;
+  for (AutocompleteMatch& duplicate : match.duplicate_matches) {
+    DetachArcListProviders(duplicate, types);
+  }
+}
+
+bool AttachArcListProviders(
+    AutocompleteMatch& match,
+    const std::vector<std::optional<AutocompleteProvider::Type>>& types,
+    size_t& next,
+    const AutocompleteController& autocomplete) {
+  if (next >= types.size()) {
+    return false;
+  }
+  const std::optional<AutocompleteProvider::Type> type = types[next++];
+  match.provider = nullptr;
+  if (type) {
+    for (const auto& candidate : autocomplete.providers()) {
+      if (candidate->type() == *type) {
+        match.provider = candidate.get();
+        break;
+      }
+    }
+    if (!match.provider) {
+      return false;
+    }
+  }
+  for (AutocompleteMatch& duplicate : match.duplicate_matches) {
+    if (!AttachArcListProviders(duplicate, types, next, autocomplete)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+std::unique_ptr<OmniboxArcList> OmniboxViewViews::CaptureArcList() const {
+  // Only the blank new tab's box: its list outlives a blur (r8.6) and the
+  // user expects it back; the Cmd+L boxes cancel on leaving (r1014-0).
+  if (!location_bar_view_ || !location_bar_view_->IsArcComposerNewTab()) {
+    return nullptr;
+  }
+  const OmniboxEditModel* const model = controller()->edit_model();
+  const AutocompleteController* const autocomplete =
+      controller()->autocomplete_controller();
+  // Keyword mode is left to the stock path: restoring the typed text would
+  // drop the keyword (SetUserText clears it), and the list was the keyword's.
+  if (!controller()->IsPopupOpen() || !model->user_input_in_progress() ||
+      autocomplete->result().empty() || model->is_keyword_selected()) {
+    return nullptr;
+  }
+  auto list = std::make_unique<OmniboxArcList>();
+  list->input = autocomplete->input();
+  for (const AutocompleteMatch& match : autocomplete->result()) {
+    if (!match.provider) {
+      return nullptr;
+    }
+    AutocompleteMatch copy(match);
+    DetachArcListProviders(copy, list->provider_types);
+    list->matches.push_back(std::move(copy));
+  }
+  list->groups = autocomplete->result().suggestion_groups_map();
+  list->selection = model->GetPopupSelection();
+  list->user_text = model->user_text();
+  list->display_text = GetText();
+  // Left by a press elsewhere (the sidebar), the field already blurred and
+  // parked its selection; that is the one the user made.
+  list->view_selection =
+      !HasFocus() && saved_selection_for_focus_change_.IsValid()
+          ? saved_selection_for_focus_change_
+          : GetSelectedRange();
+  return list;
+}
+
+bool OmniboxViewViews::HasPendingArcList() const {
+  content::WebContents* const contents = web_contents();
+  const auto* const state =
+      contents ? static_cast<const OmniboxState*>(
+                     contents->GetUserData(OmniboxTabHelper::kOmniboxStateKey))
+               : nullptr;
+  return state && state->arc_list;
+}
+
+void OmniboxViewViews::MaybeRestoreArcList(content::WebContents* contents) {
+  auto* const state =
+      contents ? static_cast<OmniboxState*>(
+                     contents->GetUserData(OmniboxTabHelper::kOmniboxStateKey))
+               : nullptr;
+  if (!state || !state->arc_list) {
+    return;
+  }
+  // One shot: whatever happens next, this tab's next leave saves afresh.
+  const std::unique_ptr<OmniboxArcList> list = std::move(state->arc_list);
+  OmniboxEditModel* const model = controller()->edit_model();
+  // The field has to be back in the tab's box, holding the draft the list
+  // was left with (RestoreState put back the text as displayed then).
+  if (!location_bar_view_ || !location_bar_view_->IsArcComposerNewTab() ||
+      !model->user_input_in_progress() || GetText() != list->display_text) {
+    return;
+  }
+  AutocompleteController* const autocomplete =
+      controller()->autocomplete_controller();
+  // Each match's provider -- and its duplicates' -- from this window's
+  // controller, by type.
+  ACMatches matches;
+  size_t next_type = 0;
+  for (const AutocompleteMatch& saved : list->matches) {
+    AutocompleteMatch match(saved);
+    if (!AttachArcListProviders(match, list->provider_types, next_type,
+                                *autocomplete)) {
+      return;
+    }
+    matches.push_back(std::move(match));
+  }
+  // 1. The text as typed -- the default line's inline autocompletion and an
+  //    arrowed-to line's temporary text are re-derived from the list below,
+  //    exactly as they were when it first came in (reviewer r1026 brief).
+  SetUserText(list->user_text, /*update_popup=*/false);
+  // 2. The list, without a query: it notifies as a fresh result whose default
+  //    match changed, so the default line's inline autocompletion is applied
+  //    the way a typed query's is.
+  autocomplete->RestoreArcResult(list->input, matches, list->groups);
+  // 3. The line the user had selected, if not the default one.
+  if (model->GetPopupSelection() != list->selection) {
+    model->SetPopupSelection(list->selection, /*reset_to_default=*/false,
+                             /*force_update_ui=*/true);
+  }
+  // 4. And the field's own selection, where the text came back the same.
+  if (GetText() == list->display_text &&
+      list->view_selection.GetMax() <= GetText().length()) {
+    SetSelectedRange(list->view_selection);
+  }
+}
