+// ⛔ r1022: where the composer's card shadow may be painted -- inside the
+// card, to its corners. `rect` is the spread's own edges as before: each side
+// at min(room, spread) -- the card's edge where the page leaves less than the
+// spread (r1014), inside the box's edge where the box overhangs the card (a
+// negative room, r1015). `card` is the card's outline itself, recovered from
+// the same signed rooms, with its top corners' radii: the painter clips to
+// both. The rect alone let the shadow into the sliver between the card's
+// rounded corner and its bounding rect -- the sidebar, the blue zone --
+// whenever the box's own arc did not happen to cover that corner (the user's
+// triangle, r1015, and again at r1021 once the box moved 11pt right). The
+// bottom is never the card's (both run on below).
+struct ArcPanelShadowClip {
+  gfx::Rect rect;
+  gfx::Rect card;
+  int top_left_radius = 0;
+  int top_right_radius = 0;
+};
+inline constexpr int kArcPanelShadowClipBelow = 8192;
+inline ArcPanelShadowClip ArcPanelShadowClipFor(
+    const gfx::Rect& panel,
+    const ArcOmniboxPanelMetrics& metrics,
+    int room_h,
+    int room_v) {
+  const int left = metrics.card_shadow_room_left;
+  const int right = metrics.card_shadow_room_right;
+  const int top = metrics.card_shadow_room_top;
+  const int clip_left = std::min(left, room_h);
+  const int clip_right = std::min(right, room_h);
+  const int clip_top = std::min(top, room_v);
+  ArcPanelShadowClip clip;
+  clip.rect = gfx::Rect(
+      panel.x() - clip_left, panel.y() - clip_top,
+      std::max(0, panel.width() + clip_left + clip_right),
+      std::max(0, panel.height() + clip_top + kArcPanelShadowClipBelow));
+  clip.card = gfx::Rect(
+      panel.x() - left, panel.y() - top,
+      std::max(0, panel.width() + left + right),
+      std::max(0, panel.height() + top + kArcPanelShadowClipBelow));
+  clip.top_left_radius = std::max(0, metrics.card_shadow_top_left_radius);
+  clip.top_right_radius = std::max(0, metrics.card_shadow_top_right_radius);
+  return clip;
+}
