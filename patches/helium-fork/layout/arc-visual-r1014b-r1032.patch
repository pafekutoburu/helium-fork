+
+void ArcComposerFooterView::OnPaint(gfx::Canvas* canvas) {
+  const helium::ArcComposerFooterLayout layout = ComputeLayout();
+  if (layout.send.IsEmpty()) {
+    return;
+  }
+  const ui::ColorProvider* const colors = GetColorProvider();
+  const SkColor background = colors->GetColor(kColorOmniboxResultsBackground);
+  const SkColor text = colors->GetColor(kColorOmniboxText);
+  const SkColor hover =
+      colors->GetColor(kColorOmniboxResultsBackgroundHovered);
+  const bool dark = color_utils::IsDark(background);
+
+  // r11: the chip's capsule is the hover, not an outline -- the candidates'
+  // hover grey at their radius, and the row's other hovers the same grey
+  // (CLAUDE.md: one hover colour in a row).
+  if (hovered_ == Part::kChip) {
+    canvas->DrawRoundRect(gfx::RectF(layout.chip),
+                          helium::kArcComposerFooterRadius, FillFlags(hover));
+  }
+  if (hovered_ == Part::kMic) {
+    canvas->DrawRoundRect(gfx::RectF(layout.mic),
+                          helium::kArcComposerFooterRadius, FillFlags(hover));
+  }
+  const gfx::PointF send_centre = gfx::RectF(layout.send).CenterPoint();
+  canvas->DrawCircle(
+      send_centre, layout.send.width() / 2.0f,
+      FillFlags(hovered_ == Part::kSend
+                    ? hover
+                    : InkFor(kSendFillInk, dark, text, background)));
+
+  const SkColor label_ink = InkFor(kLabelInk, dark, text, background);
+  const gfx::PointF plus(layout.plus);
+  const cc::PaintFlags plus_flags = [&] {
+    cc::PaintFlags flags = StrokeFlags(label_ink, kPlusStroke);
+    flags.setStrokeCap(cc::PaintFlags::kButt_Cap);
+    return flags;
+  }();
+  canvas->DrawLine(gfx::PointF(plus.x() - kPlusArm, plus.y()),
+                   gfx::PointF(plus.x() + kPlusArm, plus.y()), plus_flags);
+  canvas->DrawLine(gfx::PointF(plus.x(), plus.y() - kPlusArm),
+                   gfx::PointF(plus.x(), plus.y() + kPlusArm), plus_flags);
+
+  PaintMic(canvas, gfx::RectF(layout.mic).CenterPoint(),
+           InkFor(kMicInk, dark, text, background));
+  PaintArrow(canvas, send_centre, InkFor(kArrowInk, dark, text, background));
+}
+
+void ArcComposerFooterView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  const ui::ColorProvider* const colors = GetColorProvider();
+  const SkColor background = colors->GetColor(kColorOmniboxResultsBackground);
+  label_->SetEnabledColor(InkFor(kLabelInk, color_utils::IsDark(background),
+                                 colors->GetColor(kColorOmniboxText),
+                                 background));
+  SchedulePaint();
+}
