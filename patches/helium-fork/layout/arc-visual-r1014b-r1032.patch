+    // Last child of the panel: over the rows and the second row, under
+    // nothing; clipped by the panel's own rounded layer.
+    arc_occluder_shadow_ =
+        contents_host_->AddChildView(std::make_unique<ArcOccluderShadowView>());
+  }
+  arc_occluder_shadow_->SetBoundsRect(gfx::Rect(contents_host_->size()));
+  gfx::Rect card_in_panel = *card;
+  card_in_panel.Offset(-contents_host_->bounds().OffsetFromOrigin());
+  // The hole's own 1pt rim is opaque (TopBackgroundView strokes it in the
+  // panel's colour over the field's antialiased edge): only inside it does
+  // the browser window's shadow show through, so the rim takes this one --
+  // left out, it read as a white hairline across the card's shadow.
+  gfx::Rect hole;
+  if (top_background_->GetVisible()) {
+    hole = top_background_->bounds();
+    hole.Inset(1);
+  }
+  static_cast<ArcOccluderShadowView*>(arc_occluder_shadow_.get())
+      ->Set(card_in_panel, hole);
+  arc_occluder_shadow_->SetVisible(true);
