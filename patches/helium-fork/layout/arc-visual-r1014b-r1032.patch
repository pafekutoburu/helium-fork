+// helium-fork r1026: see ToolbarView::ShowArcNavStandIn(). A picture, not a
+// control: it takes no events (a press goes to the band beneath), and only
+// its width is ever animated.
+class ArcNavStandIn : public views::View {
+  METADATA_HEADER(ArcNavStandIn, views::View)
+
+ public:
+  ArcNavStandIn() {
+    SetCanProcessEventsWithinSubtree(false);
+    SetVisible(false);
+    // No trailing margin of its own: its width already carries the controls'
+    // run AND the gap after them, and the field drops its leading margin while
+    // it shows (ToolbarView::UpdateArcNavStandInMargin) -- so the field sits at
+    // exactly its right edge at every width, and where the band starts when
+    // it is gone (reviewer r1026 diff: with FlexLayout's collapsed margins
+    // between the two, the field jumped 3pt the moment it went). The leading
+    // side is set by Show() (r1027).
+    SetProperty(views::kMarginsKey, gfx::Insets());
+  }
+
+  void Show(const gfx::ImageSkia& image,
+            int natural_width,
+            const helium::ArcNavStandInPlacement& placement) {
+    image_ = image;
+    // r1027: what of the picture lay inside the band's interior margin (a
+    // maximized window's Fitts padding) is cut off; the rest is shown where
+    // it stood (helium::ArcNavStandInPlacementFor). Leading side only: the
+    // field's side stays the r1026 zero.
+    crop_ = std::clamp(placement.crop_leading, 0, std::max(0, natural_width));
+    natural_width_ = std::max(0, natural_width - crop_);
+    SetProperty(views::kMarginsKey,
+                gfx::Insets::TLBR(0, placement.margin_leading, 0, 0));
+    SetReveal(natural_width_);
+    // The margin does not invalidate the layout by itself.
+    PreferredSizeChanged();
+    SchedulePaint();
+  }
+  void SetReveal(int reveal_width) {
+    reveal_width = std::clamp(reveal_width, 0, natural_width_);
+    if (reveal_width == reveal_width_ && GetVisible() == (reveal_width > 0)) {
+      return;
+    }
+    reveal_width_ = reveal_width;
+    SetVisible(reveal_width_ > 0);
+    PreferredSizeChanged();
+  }
+  void Hide() {
+    image_ = gfx::ImageSkia();
+    natural_width_ = 0;
+    crop_ = 0;
+    SetProperty(views::kMarginsKey, gfx::Insets());
+    SetReveal(0);
+    PreferredSizeChanged();
+  }
+  bool shown() const { return natural_width_ > 0; }
+  int natural_width() const { return natural_width_; }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(reveal_width_, image_.height());
+  }
+  void OnPaint(gfx::Canvas* canvas) override {
+    if (image_.isNull()) {
+      return;
+    }
+    // Right-aligned: the controls are uncovered (or covered) by the card's
+    // edge moving over the band's leading end, and stand still meanwhile.
+    canvas->DrawImageInt(image_, width() - natural_width_ - crop_,
+                         (height() - image_.height()) / 2);
+  }
+
+ private:
+  gfx::ImageSkia image_;
+  int natural_width_ = 0;
+  int crop_ = 0;
+  int reveal_width_ = 0;
+};
+
