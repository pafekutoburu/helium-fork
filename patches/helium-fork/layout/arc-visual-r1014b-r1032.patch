+ArcComposerFooterView::Part ArcComposerFooterView::PartAt(
+    const gfx::Point& point) const {
+  const helium::ArcComposerFooterLayout layout = ComputeLayout();
+  if (layout.chip.Contains(point)) {
+    return Part::kChip;
+  }
+  if (layout.mic.Contains(point)) {
+    return Part::kMic;
+  }
+  if (layout.send.Contains(point)) {
+    return Part::kSend;
+  }
+  return Part::kNone;
+}
+
+void ArcComposerFooterView::SetHovered(Part part) {
+  if (hovered_ == part) {
+    return;
+  }
+  hovered_ = part;
+  SchedulePaint();
+}
