+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/style/typography.h"
+#include "ui/views/style/typography_provider.h"
+
+namespace {
+
+// The placeholders' inks. Light: `Dia:`'s own, measured 2026-10-11 off its
+// new tab (decisions「r1021 开工」) on a (254,255,255) card. Dark: `Dia:` was
+// never captured dark, so the same weight of the panel's text colour over its
+// background (推的) -- (255 - grey) / 255 of the light values.
+struct Ink {
+  SkColor light;
+  SkAlpha dark_alpha;
+};
+constexpr Ink kMicInk = {SkColorSetRGB(188, 188, 188), 67};
+// ⛔ r1023 (the user, 2026-10-11, mock-up B): the "+" and "Add tabs or files"
+// in the mic's grey (they were `Dia:`'s (120,120,120)) -- in all three boxes,
+// this being the one view.
+constexpr Ink kLabelInk = kMicInk;
+constexpr Ink kArrowInk = {SkColorSetRGB(179, 179, 179), 76};
+constexpr Ink kSendFillInk = {SkColorSetRGB(242, 243, 243), 13};
+
+// The glyphs, drawn rather than taken from the vector icons: Chromium's mic is
+// a filled one where `Dia:`'s is an outline, and its plus and arrow are a
+// different weight. Sizes are `Dia:`'s (decisions「r1021 开工」), in DIP.
+constexpr float kPlusArm = 5.0f;  // 10 x 10
+constexpr float kPlusStroke = 1.3f;
+constexpr float kMicStroke = 1.0f;
+constexpr float kArrowStroke = 1.5f;
+
+SkColor InkFor(const Ink& ink, bool dark, SkColor text, SkColor background) {
+  return dark ? color_utils::AlphaBlend(text, background, ink.dark_alpha)
+              : ink.light;
+}
+
+cc::PaintFlags StrokeFlags(SkColor color, float width) {
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kStroke_Style);
+  flags.setStrokeWidth(width);
+  flags.setStrokeCap(cc::PaintFlags::kRound_Cap);
+  flags.setStrokeJoin(cc::PaintFlags::kRound_Join);
+  flags.setColor(color);
+  return flags;
+}
+
+cc::PaintFlags FillFlags(SkColor color) {
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  flags.setColor(color);
+  return flags;
+}
+
+// `Dia:`'s mic, 11 x 15.5 round `centre`: a 6-wide capsule on top, an 11-wide
+// cradle under it, a stem and an 8-wide foot.
+void PaintMic(gfx::Canvas* canvas, const gfx::PointF& centre, SkColor color) {
+  const cc::PaintFlags flags = StrokeFlags(color, kMicStroke);
+  const float cx = centre.x();
+  const float top = centre.y() - 7.75f;
+  canvas->DrawRoundRect(gfx::RectF(cx - 2.5f, top + 0.5f, 5.0f, 8.5f), 2.5f,
+                        flags);
+  SkPathBuilder cradle;
+  cradle.moveTo(cx - 5.0f, top + 5.5f);
+  cradle.lineTo(cx - 5.0f, top + 7.0f);
+  cradle.arcTo(SkRect::MakeXYWH(cx - 5.0f, top + 2.0f, 10.0f, 10.0f), 180.0f,
+               -180.0f, /*forceMoveTo=*/false);
+  cradle.lineTo(cx + 5.0f, top + 5.5f);
+  canvas->DrawPath(cradle.detach(), flags);
+  canvas->DrawLine(gfx::PointF(cx, top + 12.0f), gfx::PointF(cx, top + 14.5f),
+                   flags);
+  canvas->DrawLine(gfx::PointF(cx - 3.75f, top + 14.5f),
+                   gfx::PointF(cx + 3.75f, top + 14.5f), flags);
+}
+
+// `Dia:`'s send arrow, 11 x 13 round `centre`.
+void PaintArrow(gfx::Canvas* canvas, const gfx::PointF& centre, SkColor color) {
+  const cc::PaintFlags flags = StrokeFlags(color, kArrowStroke);
+  const float cx = centre.x();
+  const float cy = centre.y();
+  canvas->DrawLine(gfx::PointF(cx, cy - 5.9f), gfx::PointF(cx, cy + 6.0f),
+                   flags);
+  SkPathBuilder head;
+  head.moveTo(cx - 5.1f, cy - 0.8f);
+  head.lineTo(cx, cy - 5.9f);
+  head.lineTo(cx + 5.1f, cy - 0.8f);
+  canvas->DrawPath(head.detach(), flags);
+}
+
+}  // namespace
