+    // frame on (IsArcSidebarPeeking) -- what a show Cmd+S does, less the
+    // collapse state's flip.
+    zen_cursor_exit_timer_.Stop();
+    arc_sidebar_peek_ = true;
+    BeginArcSidebarCover(/*hiding=*/false, /*peek=*/true);
+    return;
+  }
+  if (!arc_sidebar_peek_) {
+    return;
+  }
+  if (running) {
+    if (arc_sidebar_cover_target_ < 0.5) {
+      // Still coming out, and the pointer has left: round.
+      TurnArcSidebarCoverRound();
+    }
+    return;
+  }
+  // At rest: the cover back over the sidebar, as a hide Cmd+S's; the peek
+  // ends with it covered (FinishArcSidebarCover).
+  BeginArcSidebarCover(/*hiding=*/true, /*peek=*/true);
+}
+
+void BrowserView::CommitArcSidebarPeek() {
+  if (!arc_sidebar_peek_ || !vertical_tab_strip_region_view_) {
+    return;
+  }
+  arc_sidebar_peek_ = false;
+  // The docked state for good: the collapse state flips now. The layout has
+  // been the docked one since the peek began, so nothing on screen moves for
+  // it -- the collapse notification lands inside the phase (swallowed after
+  // the control hand-off, OnSidebarCollapseStateChanged) or, at rest, runs
+  // its ordinary course.
+  vertical_tab_strip_region_view_->StartCollapseMotionNow(false);
+  if (sidebar_toggle_phase_ == SidebarTogglePhase::kCovering) {
+    if (arc_sidebar_cover_target_ >= 0.5) {
+      // Retracting: back toward shown, from where it is.
+      TurnArcSidebarCoverRound();
+    }
+    // The running cover finishes as a show (FinishArcSidebarCover).
+    return;
+  }
+  // At rest: what a show's finish does, less the motion (idempotent with
+  // the collapse notification's own course).
+  zen_cursor_exit_timer_.Stop();
+  UpdateArcSidebarControlPlacement();
+  UpdateArcAddressBarPlacement();
+  UpdateZenModeEventMonitor();
+  UpdateCaptionButtonsOpacityForChromeState();
+  InvalidateLayout();
+}
