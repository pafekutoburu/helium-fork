+                   base::i18n::IsRTL() || !layout_manager_
+                       ? helium::ArcNavStandInPlacement()
+                       : helium::ArcNavStandInPlacementFor(
+                             lead_x, layout_manager_->interior_margin().left()));
+  }
+  UpdateArcNavStandInMargin();
+}
+
+void ToolbarView::SetArcNavStandInReveal(int reveal_width) {
+  if (auto* const stand_in = views::AsViewClass<ArcNavStandIn>(
+          arc_nav_stand_in_.get())) {
+    stand_in->SetReveal(reveal_width);
+  }
+  UpdateArcNavStandInMargin();
+}
+
+void ToolbarView::HideArcNavStandIn() {
+  if (auto* const stand_in = views::AsViewClass<ArcNavStandIn>(
+          arc_nav_stand_in_.get())) {
+    stand_in->Hide();
+  }
+  UpdateArcNavStandInMargin();
+}
+
+void ToolbarView::UpdateArcNavStandInMargin() {
+  // While the stand-in shows, its width ends where the field starts (it was
+  // measured up to the field), so the field takes no leading margin of its
+  // own; otherwise the band's usual one (UpdateToolbarLayout()).
+  if (!location_bar_view_ || location_bar_view_->parent() != this ||
+      arc_sidebar_hosted_) {
+    return;
+  }
+  const gfx::Insets* const margins =
+      location_bar_view_->GetProperty(views::kMarginsKey);
+  if (!margins) {
+    return;
+  }
+  const bool showing = arc_nav_stand_in_ && arc_nav_stand_in_->GetVisible();
+  if (showing && margins->left() != 0) {
+    arc_nav_stand_in_field_margin_ = margins->left();
+    location_bar_view_->SetProperty(
+        views::kMarginsKey,
+        gfx::Insets::TLBR(margins->top(), 0, margins->bottom(),
+                          margins->right()));
+  } else if (!showing && margins->left() == 0 &&
+             arc_nav_stand_in_field_margin_ > 0) {
+    location_bar_view_->SetProperty(
+        views::kMarginsKey,
+        gfx::Insets::TLBR(margins->top(), arc_nav_stand_in_field_margin_,
+                          margins->bottom(), margins->right()));
+    arc_nav_stand_in_field_margin_ = 0;
+  } else {
+    return;
+  }
+  InvalidateLayout();
+}
+
+bool ToolbarView::IsArcNavStandInShown() const {
+  const auto* const stand_in =
+      views::AsViewClass<ArcNavStandIn>(arc_nav_stand_in_.get());
+  return stand_in && stand_in->shown();
+}
+
+int ToolbarView::GetArcNavStandInNaturalWidth() const {
+  const auto* const stand_in =
+      views::AsViewClass<ArcNavStandIn>(arc_nav_stand_in_.get());
+  return stand_in ? stand_in->natural_width() : 0;
+}
