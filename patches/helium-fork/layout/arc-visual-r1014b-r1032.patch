+  void SetDressOpacity(float opacity) {
+    opacity_ = std::clamp(opacity, 0.0f, 1.0f);
+    shadow_->SetShadowOpacity(opacity_);
+    SchedulePaint();
+  }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override {
+    if (opacity_ <= 0.0f) {
