+void BrowserView::BeginArcSidebarCover(bool hiding, bool peek) {
+  // The card that is already out when Cmd+S shows the sidebar stays on top:
+  // it only changes its dress (the docked look, every element where it is --
+  // VerticalTabStripRegionView::SetArcDockOffsetForLayout) while the page's
+  // edge slides under it to the docked line. Every other cover has the
+  // sidebar under the page, being covered or uncovered. (r1030: a peek is
+  // never over a card -- the hidden mode's reveal is the peek itself.)
+  const bool card_out = !peek && !hiding && IsSidebarHiddenModeActive() &&
+                        GetSideChromeRevealRatio() > 0.0f;
+  if (card_out) {
+    // The card where it is on screen now: a slide that has just ended (the
+    // wait in MaybeHandleSidebarCollapseRequest) has only asked for the
+    // layout that puts it at rest (reviewer r1027 diff).
+    DeprecatedLayoutImmediately();
+  }
+  if (vertical_tab_strip_region_view_) {
+    // A drag of the resize grip under way ends here (reviewer r1027 diff r1).
+    vertical_tab_strip_region_view_->EndResizeForCover();
+  }
+  sidebar_toggle_phase_ = SidebarTogglePhase::kCovering;
+  // ⛔ r1031: the page is not waited for while the cover runs (a stale frame
+  // is stretched to the card instead); a cover that lands at once (reduce
+  // motion, StartArcSidebarCoverSpring) keeps upstream's policy.
+  arc_cover_resize_mode_disarm_timer_.Stop();
