+  const gfx::Rect min_box = ArcComposerSplitBounds(minimum);
+  EXPECT_EQ(kArcComposerSplitTopClear,
+            ArcComposerLogoBounds(min_box).y() - minimum.y());
+  EXPECT_EQ(kArcComposerShadowRoom, minimum.bottom() - min_box.bottom());
+
+  // The lower half: its bottom fixed, its top the divider coming down.
+  previous_y = -1;
+  for (int h = 900; h >= kArcComposerSplitMinHeight; --h) {
