+  EXPECT_EQ(kArcComposerWidth, wide_box.width());
+  EXPECT_EQ(kArcComposerShadowRoom, wide_box.x() - wide_card.x());
+  EXPECT_EQ(kArcComposerShadowRoom, wide_card.right() - wide_box.right());
+  const gfx::Rect narrowest(536, 44, kArcComposerSplitMinWidth, 852);
+  const gfx::Rect narrow_box = ArcComposerSplitBounds(narrowest);
+  EXPECT_EQ(kArcComposerMinWidth, narrow_box.width());
+  EXPECT_EQ(kArcComposerMinSideMargin, narrow_box.x() - narrowest.x());
+  EXPECT_EQ(kArcComposerMinSideMargin, narrowest.right() - narrow_box.right());
+  // A full-height half: the card's own line, 128 above it.
+  EXPECT_EQ(wide_card.y() + wide_card.height() / 2 - kArcComposerTopAboveCentre,
+            wide_box.y());
+
+  // Stacked, the upper half: its top fixed, its bottom the divider. From a
+  // tall card down to the minimum the box moves by at most one point per
+  // point of divider (half speed, rounding), never the other way, and from
+  // where the mark's clearance reaches 32 it stays put.
+  int previous_y = -1;
+  for (int h = 900; h >= kArcComposerSplitMinHeight; --h) {
+    const gfx::Rect upper(272, 46, 924, h);
+    const gfx::Rect box = ArcComposerSplitBounds(upper);
