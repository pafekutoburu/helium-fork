+// r1032: the state a command aims a critically damped spring from -- |from|
+// launched toward |target| at L = |launch| × ω × the distance left. 0 is a
+// start from rest (the carousel's); for 0..1 a spring launched from rest
+// never passes |target| (1 is a pure exponential ease-out; 0.5 and up leave
+// at top speed). Already heading for |target|, its speed is topped up to L.
+// Still heading away -- a turn -- it keeps its speed while that is over
+// kSpringLaunchKeepsMomentum × L and turns by itself (r1027: "就像 iOS 的打开、
+// 收起 App 动画一样"); below that the launch fades in as the speed away fades
+// out, so a turn in the settle tail leaves like a fresh start and a card
+// still visibly moving is never sent back within one frame.
+inline constexpr double kSpringLaunchKeepsMomentum = 0.3;
+
+inline SpringState LaunchCriticalSpring(SpringState from,
+                                        double target,
+                                        double omega,
+                                        double launch) {
+  const double toward = target >= from.x ? 1.0 : -1.0;
+  const double push = launch * omega * std::abs(target - from.x);
+  const double speed = from.v * toward;
+  if (speed >= 0.0) {
+    from.v = toward * std::max(speed, push);
+  } else if (push > 0.0) {
+    from.v += toward * push *
+              std::clamp(1.0 + speed / (kSpringLaunchKeepsMomentum * push),
+                         0.0, 1.0);
+  }
+  return from;
+}
