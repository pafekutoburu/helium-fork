+// r1032: Cmd+S's cover leaves at speed (the user: "前半段启动的时候太慢了……慢半拍")
+// -- a tenth of the way one 120 Hz frame in, where r1027's spring from rest
+// had gone 2% -- half-way at ~42ms, never past the end, settled on a 290pt
+// sidebar inside ~0.31s.
+TEST(ArcFloatingSidebarTest, CoverSpringLeavesAtSpeed) {
+  const SpringState launched = LaunchCriticalSpring(
+      {0.0, 0.0}, 1.0, kArcSidebarCoverOmega, kArcSidebarCoverLaunch);
+  EXPECT_GE(StepCriticalSpring(launched, 1.0, kArcSidebarCoverOmega,
+                               1.0 / 120.0)
+                .x,
+            0.09);
+  double half = 0.0;
+  double highest = 0.0;
+  for (double t = 0.0; t < 1.0; t += 1.0 / 1000.0) {
+    const double x =
+        StepCriticalSpring(launched, 1.0, kArcSidebarCoverOmega, t).x;
+    if (half == 0.0 && x >= 0.5) {
+      half = t;
+    }
+    highest = std::max(highest, x);
+  }
+  EXPECT_GT(half, 0.035);
+  EXPECT_LT(half, 0.048);
+  EXPECT_LE(highest, 1.0);
+  double t = 0.0;
+  while (!SpringSettled(StepCriticalSpring(launched, 1.0,
+                                           kArcSidebarCoverOmega, t),
+                        1.0, /*unit_points=*/290.0)) {
+    t += 1.0 / 120.0;
+    ASSERT_LT(t, 1.0);
+  }
+  EXPECT_GT(t, 0.25);
+  EXPECT_LT(t, 0.35);
+}
+
+// r1027 (the user: "侧边栏在收起展开的任何位置都可以被打断"): a second Cmd+S
+// re-aims the spring from the state reached -- the edge never jumps, and
+// while it still runs the other way it keeps its speed: decelerates, turns,
+// comes back. r1032: the turn is a command too -- once the card has all
+// but arrived it leaves like a fresh start instead of creeping back.
+TEST(ArcFloatingSidebarTest, CoverSpringTurnsRoundWithoutAJump) {
+  const SpringState launched = LaunchCriticalSpring(
+      {0.0, 0.0}, 1.0, kArcSidebarCoverOmega, kArcSidebarCoverLaunch);
+  for (double at : {0.008, 0.02, 0.04, 0.08, 0.13, 0.2, 0.3}) {
+    SCOPED_TRACE(testing::Message() << "turned at " << at << "s");
+    const SpringState reached =
+        StepCriticalSpring(launched, 1.0, kArcSidebarCoverOmega, at);
+    ASSERT_GE(reached.v, 0.0);
+    const SpringState turn = LaunchCriticalSpring(
+        reached, 0.0, kArcSidebarCoverOmega, kArcSidebarCoverLaunch);
+    EXPECT_DOUBLE_EQ(reached.x, turn.x);
+    const SpringState first =
+        StepCriticalSpring(turn, 0.0, kArcSidebarCoverOmega, 0.0);
+    EXPECT_DOUBLE_EQ(turn.x, first.x);
+    if (at <= 0.08) {
+      // Still running the other way: r1027's momentum, untouched.
+      EXPECT_DOUBLE_EQ(reached.v, turn.v);
+    }
+    if (at >= 0.2) {
+      // All but arrived: one 120 Hz frame later it has gone 8% of the
+      // way back, like a fresh start.
+      EXPECT_LE(StepCriticalSpring(turn, 0.0, kArcSidebarCoverOmega,
+                                   1.0 / 120.0)
+                    .x,
+                turn.x * 0.92);
+    }
+    double lowest = turn.x;
+    double highest = turn.x;
+    for (double t = 0.0; t < 1.0; t += 1.0 / 240.0) {
+      const SpringState s =
+          StepCriticalSpring(turn, 0.0, kArcSidebarCoverOmega, t);
+      lowest = std::min(lowest, s.x);
+      highest = std::max(highest, s.x);
+    }
+    // Carries on a little past the turn at most, never past the far end,
+    // and never undershoots the end it is going back to.
+    EXPECT_LE(highest, 1.0);
+    EXPECT_GE(lowest, -1e-6);
+  }
+  // A second turn, any time after the first, stays inside the two ends too.
+  for (double first_at = 0.008; first_at < 0.3; first_at += 0.012) {
+    const SpringState turn = LaunchCriticalSpring(
+        StepCriticalSpring(launched, 1.0, kArcSidebarCoverOmega, first_at),
+        0.0, kArcSidebarCoverOmega, kArcSidebarCoverLaunch);
+    for (double then = 0.008; then < 0.2; then += 0.012) {
+      const SpringState again = LaunchCriticalSpring(
+          StepCriticalSpring(turn, 0.0, kArcSidebarCoverOmega, then), 1.0,
+          kArcSidebarCoverOmega, kArcSidebarCoverLaunch);
+      for (double t = 0.0; t < 0.6; t += 1.0 / 240.0) {
+        const double x =
+            StepCriticalSpring(again, 1.0, kArcSidebarCoverOmega, t).x;
+        ASSERT_LE(x, 1.0 + 1e-9) << first_at << " / " << then;
+        ASSERT_GE(x, -1e-9) << first_at << " / " << then;
+      }
+    }
+  }
+}
