+// The floating card's dress on `background` -- every corner at `radius`, the
+// rim (M3.9d / r1009 / r1010), the native-material fill -- or, with `floating`
+// false, the docked sidebar's (square, no rim, no fill under glass). One
+// recipe for the region itself (SetZenModeFloatingStyleForLayout) and for the
+// dress it keeps on while Cmd+S docks a floating card (r1027), so the two
+// cannot drift apart: the dress's first frame has to be the card.
+void ApplyFloatingCardDress(CustomCornersBackground& background,
+                            bool floating,
+                            int radius) {
+  CustomCornersBackground::Corners corners;
+  CustomCornersBackground::Outline outline;
+  if (floating) {
+    CustomCornersBackground::Corner rounded_corner;
+    rounded_corner.type = CustomCornersBackground::CornerType::kRounded;
+    rounded_corner.radius = radius;
+    corners[CornerOrientation::kTopLeading] = rounded_corner;
+    corners[CornerOrientation::kTopTrailing] = rounded_corner;
+    corners[CornerOrientation::kBottomLeading] = rounded_corner;
+    corners[CornerOrientation::kBottomTrailing] = rounded_corner;
+  }
+  // helium-fork M3.9d / r1009: a 1pt line round the floating card
+  // (kColorArcFloatingSidebarRim) -- since r1009 a dark one on the light
+  // theme, because the halo darkens the page beside the card to the card's
+  // own grey and the edge was gone (user 2026-10-08). The why and the alphas
+  // are in helium/arc_sidebar_surface.h; the switch is in
+  // helium/arc_floating_sidebar.h.
+  if (floating && helium::kFloatingSidebarRimEnabled) {
+    outline.color = {.color = kColorArcFloatingSidebarRim, .opacity = 1.0f};
+    outline.top = outline.leading = outline.bottom = outline.trailing = true;
+    // r1010: one device pixel on the light theme -- the 1pt dark line read
+    // too heavy there (user 2026-10-08); dark keeps its 1pt.
+    outline.hairline_on_light = true;
+  }
+  background.SetCorners(corners);
+  background.SetOutline(outline);
+  background.SetPaintWithNativeFrameMaterials(floating);
