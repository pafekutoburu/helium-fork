+void ToolbarView::ShowArcNavStandIn(const gfx::ImageSkia& image,
+                                    int natural_width,
+                                    int lead_x) {
+  if (auto* const stand_in = views::AsViewClass<ArcNavStandIn>(
+          arc_nav_stand_in_.get())) {
