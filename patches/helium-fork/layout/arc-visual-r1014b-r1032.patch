+    SCOPED_TRACE(testing::Message() << "upper h=" << h);
+    EXPECT_TRUE(upper.Contains(box));
+    EXPECT_EQ(100, box.height());
+    EXPECT_GE(logo.y() - upper.y(), kArcComposerSplitTopClear);
+    EXPECT_GE(upper.bottom() - box.bottom(), kArcComposerShadowRoom);
+    EXPECT_TRUE(ArcComposerLogoFits(upper, box));
+    if (previous_y >= 0) {
+      EXPECT_LE(box.y(), previous_y);
+      EXPECT_LE(previous_y - box.y(), 1);
+    }
+    previous_y = box.y();
+    if (h <= 2 * (kArcComposerTopAboveCentre + kArcComposerSplitBoxTop)) {
