+void BrowserView::StepArcSidebarCover() {
+  if (sidebar_toggle_phase_ != SidebarTogglePhase::kCovering) {
+    return;
+  }
+  arc_sidebar_cover_watchdog_.Start(
+      FROM_HERE, kArcSidebarCoverWatchdog,
+      base::BindOnce(&BrowserView::OnArcSidebarCoverStalled,
+                     base::Unretained(this)));
+  const double now = GetArcSidebarCoverClockSeconds();
+  if (arc_sidebar_cover_cap_first_step_) {
+    arc_sidebar_cover_cap_first_step_ = false;
+    arc_sidebar_cover_origin_seconds_ =
+        helium::CapFirstStepOrigin(arc_sidebar_cover_origin_seconds_, now);
+  }
+  const helium::SpringState state = helium::StepCriticalSpring(
+      arc_sidebar_cover_origin_, arc_sidebar_cover_target_,
+      helium::kArcSidebarCoverOmega,
+      std::max(0.0, now - arc_sidebar_cover_origin_seconds_));
+  // The edge travels the sidebar's width: that is the unit the settle
+  // thresholds (points) are read in.
+  const double unit =
+      vertical_tab_strip_region_view_
+          ? std::max(1, vertical_tab_strip_region_view_->width())
+          : 1.0;
+  if (helium::SpringSettled(state, arc_sidebar_cover_target_, unit)) {
+    arc_sidebar_cover_value_ = arc_sidebar_cover_target_;
+    OnArcSidebarCoverFrame();
+    FinishArcSidebarCover();
+    return;
+  }
+  arc_sidebar_cover_value_ = std::clamp(state.x, 0.0, 1.0);
+  OnArcSidebarCoverFrame();
+}
