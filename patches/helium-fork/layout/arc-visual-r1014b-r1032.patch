+    }
+    if (opacity_ >= 1.0f) {
+      views::View::OnPaint(canvas);
+      return;
+    }
+    canvas->SaveLayerAlpha(base::ClampRound<uint8_t>(opacity_ * 255.0f));
+    views::View::OnPaint(canvas);
+    canvas->Restore();
+  }
+
+ private:
+  raw_ptr<HeliumCardShadowView> shadow_ = nullptr;
+  float opacity_ = 1.0f;
