+void OmniboxPopupViewViews::SetArcOccluder(
+    const std::optional<gfx::Rect>& card_in_screen) {
+  if (arc_occluder_ == card_in_screen) {
+    return;
+  }
+  arc_occluder_ = card_in_screen;
+  ApplyArcOccluder();
+}
+
+void OmniboxPopupViewViews::ApplyArcOccluder() {
+  if (!widget_) {
+    return;
   }
+  const gfx::Rect popup = widget_->GetWindowBoundsInScreen();
+  std::optional<gfx::Rect> card = arc_occluder_;
+  if (card && !card->Intersects(popup)) {
+    card.reset();
+  }
+  if (auto* const frame = views::AsViewClass<RoundedOmniboxResultsFrame>(
+          widget_->GetContentsView())) {
+    std::optional<gfx::Rect> local = card;
+    if (local) {
+      local->Offset(-popup.OffsetFromOrigin());
+    }
+    frame->SetArcOccluder(local);
+  }
+  UpdateArcPassThrough();
+}
+
+void OmniboxPopupViewViews::UpdateArcPassThrough() {
+  if (!widget_) {
+    return;
+  }
+  const bool through =
+      arc_occluder_ &&
+      arc_occluder_->Contains(
+          display::Screen::Get()->GetCursorScreenPoint());
+  if (through == arc_occluder_passthrough_) {
+    return;
+  }
+  arc_occluder_passthrough_ = through;
+#if BUILDFLAG(IS_MAC)
+  helium::SetWidgetIgnoresMouseEvents(widget_.get(), through);
+#endif
 }
 
