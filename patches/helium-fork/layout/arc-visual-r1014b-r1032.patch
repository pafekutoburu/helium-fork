+  int crop_leading = 0;
+};
+
+inline constexpr ArcNavStandInPlacement ArcNavStandInPlacementFor(
+    int lead_x,
+    int interior_margin_leading) {
+  lead_x = lead_x < 0 ? 0 : lead_x;
+  if (lead_x >= interior_margin_leading) {
+    return {lead_x, 0};
+  }
+  return {0, interior_margin_leading - lead_x};
+}
+
 }  // namespace helium
 
