+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_ARC_COMPOSER_STILL_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_ARC_COMPOSER_STILL_VIEW_H_
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/view.h"
+
+class ArcComposerFooterView;
+class LocationBarView;
+
+// helium-fork r1023: the blank new tab's mark and resting search box, drawn
+// still, over the half of a split view that does not have the focus.
+//
+// The real box holds the window's one address field (ArcComposerHostView),
+// so it can only ever stand on the active half; the blank tab's page itself
+// is white. The user (2026-10-11, on a recording): "当焦点不在搜索框的 new tab
+// 时，它是空白的，这个也是需要修改的" -- so the other half, when it is a blank
+// tab too, shows the same box at rest: the same card and shadow
+// (helium::PaintArcOmniboxPanel), the magnifier and the placeholder in the
+// hint grey, the attachment bar (a third ArcComposerFooterView), and the mark
+// above -- placed in that half's card by the same functions as the real one
+// (helium::ArcComposerSplitBounds, ArcComposerLogoBounds), so the two read
+// the same. No caret, no hover, no input: the whole view is transparent to
+// events, so a click falls through to the page beneath and upstream
+// activates that half (MultiContentsView::OnWebContentsFocused), which brings
+// the real box over. ⛔ r1024 (the user, 2026-10-13): where that half's
+// omnibox holds typed text, the text, in the field's own colour -- "失焦之后，
+// 仍然显示用户最后操作时的样子" (r1023 had the placeholder there, 推的).
+class ArcComposerStillView : public views::View {
+  METADATA_HEADER(ArcComposerStillView, views::View)
+
+ public:
+  ArcComposerStillView();
+  ArcComposerStillView(const ArcComposerStillView&) = delete;
+  ArcComposerStillView& operator=(const ArcComposerStillView&) = delete;
+  ~ArcComposerStillView() override;
+
+  // Places the still box in `card`, the inactive half's page card in the
+  // parent's coordinates, and reads from `field` (the window's one address
+  // field, wherever it is) what it says and where its text sits. `draft` is
+  // what the half's own omnibox holds (empty: the placeholder). Repaints only
+  // when one of those changed.
+  void Update(const gfx::Rect& card,
+              LocationBarView* field,
+              const std::u16string& draft);
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+  void OnThemeChanged() override;
+
+ private:
+  // This view's own coordinates: the box, and the placeholder's text rect.
+  gfx::Rect box_;
+  gfx::Rect text_;
+  std::u16string placeholder_;
+  std::u16string draft_;
+  raw_ptr<ArcComposerFooterView> footer_ = nullptr;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_ARC_COMPOSER_STILL_VIEW_H_
