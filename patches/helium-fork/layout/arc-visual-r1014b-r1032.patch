+bool MultiContentsView::IsArcBlankHalf(int index) const {
+  ContentsWebView* const view =
+      contents_container_views_[index]->contents_view();
+  return browser_view_ && view &&
+         browser_view_->IsArcComposerPage(view->web_contents());
+}
+
+bool MultiContentsView::NeedsArcMinSize(int index) const {
+  if (IsArcBlankHalf(index)) {
+    return true;
+  }
+  content::WebContents* const contents =
+      contents_container_views_[index]->contents_view()->web_contents();
+  return contents &&
+         std::ranges::any_of(arc_min_holders_, [contents](const auto& held) {
+           return held.get() == contents;
+         });
+}
+
+std::pair<int, int> MultiContentsView::GetArcMinViewSizes(int total) const {
+  const int extent =
+      GetSplitLayout() == split_tabs::SplitTabLayout::kSideBySide
+          ? helium::kArcComposerSplitMinWidth
+          : helium::kArcComposerSplitMinHeight;
+  int start = NeedsArcMinSize(0) ? extent : 0;
+  int end = NeedsArcMinSize(1) ? extent : 0;
+  const int sum = start + end;
+  if (sum > 0 && sum > total) {
+    // Two blank tabs in a window too small for both boxes: each gives way in
+    // proportion, and the two never ask for more than there is.
+    const int room = std::max(0, total);
+    start = room * start / sum;
+    end = room * end / sum;
+  }
+  return {start, end};
+}
+
+void MultiContentsView::MaybeInvalidateForArcBlankChange() {
+  if (!IsInSplitView()) {
+    return;
+  }
+  if (IsArcBlankHalf(0) != arc_blank_halves_[0] ||
+      IsArcBlankHalf(1) != arc_blank_halves_[1]) {
+    InvalidateLayout();
+  }
+}
