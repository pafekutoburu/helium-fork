+
+views::View::Views BrowserView::GetChildrenInZOrder() {
+  Views order = views::ClientView::GetChildrenInZOrder();
+  // ⛔ r1026: the two books -- while Cmd+S covers or uncovers it, the sidebar
+  // (and its glass backdrop) is the lower one: right above the window's own
+  // background, under everything of the page's (the band, the card, its
+  // shadow, the blank tab's box and mark, infobars). The box is the page's
+  // here, so the r1024 "box under the floating sidebar" order does not apply.
+  if (arc_sidebar_under_contents_) {
+    auto at = std::ranges::find(order, main_background_region_.get());
+    at = at == order.end() ? order.begin() : std::next(at);
+    for (views::View* const view :
+         {static_cast<views::View*>(vertical_tab_strip_background_blur_backdrop_),
+          static_cast<views::View*>(vertical_tab_strip_region_view_)}) {
+      const auto it = std::ranges::find(order, view);
+      if (!view || it == order.end()) {
+        continue;
+      }
+      const size_t at_index = std::distance(order.begin(), at);
+      const size_t it_index = std::distance(order.begin(), it);
+      order.erase(it);
+      at = order.begin() + (it_index < at_index ? at_index - 1 : at_index);
+      at = std::next(order.insert(at, view));
+    }
+    return order;
+  }
+  // The first thing the floating sidebar brings over the page: its glass
+  // backdrop where there is one, else the sidebar itself.
+  views::View* const floor =
+      vertical_tab_strip_background_blur_backdrop_
+          ? static_cast<views::View*>(
+                vertical_tab_strip_background_blur_backdrop_)
+          : static_cast<views::View*>(vertical_tab_strip_region_view_);
+  if (!arc_composer_under_sidebar_ || !floor ||
+      !std::ranges::contains(order, floor)) {
+    return order;
+  }
+  // The box's card, its field, its mark -- in that order (the panel cuts no
+  // hole under the field) -- each moved to just under the floor. This is the
+  // paint, layer and hit-test order; children() (focus, accessibility) and
+  // the indexes cached from it stay as they are.
+  for (views::View* const view :
+       {static_cast<views::View*>(arc_omnibox_panel_),
+        static_cast<views::View*>(arc_composer_host_),
+        static_cast<views::View*>(arc_composer_logo_)}) {
+    const auto it = std::ranges::find(order, view);
+    if (!view || it == order.end()) {
+      continue;
+    }
+    order.erase(it);
+    order.insert(std::ranges::find(order, floor), view);
+  }
+  return order;
+}
