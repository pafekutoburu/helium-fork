+gfx::ImageSkia BrowserView::CaptureArcToolbarControls(int* natural_width,
+                                                      int* lead_x) {
+  // The four controls as they stand in the band now -- one picture of their
+  // run, on nothing (each button painted on its own, so no band colour is
+  // baked in: the page under the band can change while the picture stands).
+  *natural_width = 0;
+  *lead_x = 0;
+  const ui::Compositor* const compositor =
+      GetWidget() ? GetWidget()->GetCompositor() : nullptr;
+  if (!toolbar_ || !compositor) {
+    return gfx::ImageSkia();
+  }
+  std::vector<views::View*> controls;
+  for (views::View* const control :
+       {static_cast<views::View*>(toolbar_->vertical_tabs_collapse_button()),
+        static_cast<views::View*>(toolbar_->back_button()),
+        static_cast<views::View*>(toolbar_->forward_button()),
+        static_cast<views::View*>(toolbar_->reload_button())}) {
+    if (control && control->parent() == toolbar_ && control->GetVisible() &&
+        !control->bounds().IsEmpty()) {
+      controls.push_back(control);
+    }
+  }
+  if (controls.empty()) {
+    return gfx::ImageSkia();
+  }
+  const float scale = compositor->device_scale_factor();
+  const int first_x = controls.front()->x();
+  // r1027: where the run starts is the stand-in's to keep too -- a maximized
+  // window's collapse button eats the band's interior margin with its Fitts
+  // padding (helium::ArcNavStandInPlacementFor).
+  *lead_x = first_x;
+  const int run_width = controls.back()->bounds().right() - first_x;
+  // The stand-in's width runs on to where the field starts: the gap after
+  // the controls is its own too (ToolbarView::UpdateArcNavStandInMargin).
+  views::View* const field = toolbar_->location_bar_view();
+  *natural_width = field && field->parent() == toolbar_ &&
+                           field->x() > controls.back()->bounds().right()
+                       ? field->x() - first_x
+                       : run_width;
+  int height = 0;
+  for (views::View* const control : controls) {
+    height = std::max(height, control->height());
+  }
+  if (run_width <= 0 || height <= 0) {
+    *natural_width = 0;
+    return gfx::ImageSkia();
+  }
+  gfx::Canvas canvas(gfx::Size(run_width, height), scale,
+                     /*is_opaque=*/false);
+  for (views::View* const control : controls) {
+    const gfx::ImageSkia part = HeliumViewSnapshotLayer::CaptureImage(
+        control, control->GetLocalBounds(), scale);
+    if (!part.isNull()) {
+      canvas.DrawImageInt(part, control->x() - first_x,
+                          (height - part.height()) / 2);
+    }
+  }
+  return gfx::ImageSkia::CreateFromBitmap(canvas.GetBitmap(), scale);
+}
+
+void BrowserView::UpdateArcNavStandInForCover() {
+  if (!toolbar_ || !toolbar_->IsArcNavStandInShown() ||
+      !vertical_tab_strip_region_view_) {
+    return;
+  }
+  // How far the page's card has come over the docked sidebar: the stand-in
+  // is uncovered by exactly that much (and stands still while it is).
+  const std::optional<double> cover = GetArcSidebarCoverRatio();
+  const int covered = base::ClampRound(
+      vertical_tab_strip_region_view_->width() * cover.value_or(1.0));
+  toolbar_->SetArcNavStandInReveal(
+      std::min(covered, toolbar_->GetArcNavStandInNaturalWidth()));
+}
