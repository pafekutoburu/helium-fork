+  gfx::Rect cut = *card;
+  cut.Intersect(all);
+  auto keep = std::make_unique<ui::Layer::ShapeRects>();
+  for (const gfx::Rect& band :
+       {gfx::Rect(0, 0, all.width(), cut.y()),
+        gfx::Rect(0, cut.bottom(), all.width(), all.bottom() - cut.bottom()),
+        gfx::Rect(0, cut.y(), cut.x(), cut.height()),
+        gfx::Rect(cut.right(), cut.y(), all.right() - cut.right(),
+                  cut.height())}) {
+    if (!band.IsEmpty()) {
+      keep->push_back(band);
+    }
+  }
+  if (keep->empty()) {
+    // Wholly under the card: keep a point outside, i.e. nothing.
+    keep->push_back(gfx::Rect(all.right(), all.bottom(), 1, 1));
+  }
+  layer()->SetAlphaShape(std::move(keep));
