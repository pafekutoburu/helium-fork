+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/helium/widget_mouse_events.h"
+
+#include "components/remote_cocoa/common/native_widget_ns_window.mojom.h"
+#include "ui/views/cocoa/native_widget_mac_ns_window_host.h"
+#include "ui/views/widget/widget.h"
+
+namespace helium {
+
+void SetWidgetIgnoresMouseEvents(views::Widget* widget, bool ignores) {
+  if (!widget) {
+    return;
+  }
+  views::NativeWidgetMacNSWindowHost* const host =
+      views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+          widget->GetNativeWindow());
+  if (remote_cocoa::mojom::NativeWidgetNSWindow* const window =
+          host ? host->GetNSWindowMojo() : nullptr) {
+    window->SetIgnoresMouseEvents(ignores);
+  }
+}
+
+}  // namespace helium
