+      multi_contents_view_) {
+    const int card_gap = multi_contents_view_->ShouldUseRoundedFrame()
+                             ? MultiContentsView::kContentCardInset
+                             : 0;
+    line = IsVerticalTabStripRightAligned()
+               ? vertical_tab_strip_region_view_->x() - card_gap
+               : vertical_tab_strip_region_view_->bounds().right() + card_gap;
+  }
+  const bool right_aligned = IsVerticalTabStripRightAligned();
+  const float radius =
+      multi_contents_view_ && multi_contents_view_->ShouldUseRoundedFrame()
+          ? static_cast<float>(GetLayoutConstant(
+                LayoutConstant::kVerticalTabCornerRadius))
+          : 0.f;
+  const bool band_on_screen = top_container_ && top_container_->GetVisible() &&
+                              top_container_->height() > 0;
+  struct Part {
+    raw_ptr<views::View> view;
+    bool top_corner;
+    bool bottom_corner;
+  };
+  std::vector<Part> parts;
+  if (line) {
+    parts = {{top_container_.get(), true, false},
+             {infobar_container_.get(), false, false},
+             {multi_contents_view_.get(), !band_on_screen, true},
+             {arc_composer_still_.get(), false, false}};
+    // The box views are the page's only as the blank tab's box: grown out of
+    // the sidebar's row (kRow) or hung over the band (kBand) they are the
+    // sidebar's edit surfaces, and stay whole (reviewer r1027 brief).
+    if (GetArcComposerPlacement() == helium::ArcComposerPlacement::kNewTab) {
+      parts.push_back({arc_omnibox_panel_.get(), false, false});
+      parts.push_back({arc_composer_host_.get(), false, false});
+      parts.push_back({arc_composer_logo_.get(), false, false});
+    }
+    std::erase_if(parts, [](const Part& part) { return !part.view; });
+  }
+  // Whatever was clipped and is no longer a part (the cover is over, or the
+  // box stopped being the page's): as it was.
+  for (auto it = arc_cover_clip_saved_radii_.begin();
+       it != arc_cover_clip_saved_radii_.end();) {
+    views::View* const view = it->first;
+    const bool still = std::ranges::any_of(
+        parts, [view](const Part& part) { return part.view == view; });
+    if (still) {
+      ++it;
+      continue;
+    }
+    if (view->layer()) {
+      view->layer()->SetClipRect(gfx::Rect());
+      view->layer()->SetRoundedCornerRadius(it->second);
+    }
+    const auto made = std::ranges::find(arc_cover_clip_made_layers_, view);
+    if (made != arc_cover_clip_made_layers_.end()) {
+      // Lent for the cover -- unless the band's card clip has since taken it
+      // over (the rounded frame turned on meanwhile; SetArcCardClipEnabled
+      // keeps a layer it finds), which would lose its clip for good (reviewer
+      // r1027 diff).
+      auto* const band = views::AsViewClass<TopContainerView>(view);
+      if (!band || !band->IsArcCardClipEnabled()) {
+        view->DestroyLayer();
+      }
+      arc_cover_clip_made_layers_.erase(made);
+    }
+    it = arc_cover_clip_saved_radii_.erase(it);
+  }
+  for (const Part& part : parts) {
+    views::View* const view = part.view;
+    if (!view->layer()) {
+      // The contents have no layer of their own (their panes' do), nor has
+      // the band with the rounded frame off; one for the cover's length
+      // clips all of theirs.
+      view->SetPaintToLayer();
+      view->layer()->SetFillsBoundsOpaquely(false);
+      arc_cover_clip_made_layers_.push_back(view);
+    }
+    ui::Layer* const layer = view->layer();
+    auto saved = std::ranges::find_if(
+        arc_cover_clip_saved_radii_,
+        [view](const auto& entry) { return entry.first == view; });
+    if (saved == arc_cover_clip_saved_radii_.end()) {
+      arc_cover_clip_saved_radii_.emplace_back(view,
+                                               layer->rounded_corner_radii());
+      saved = std::prev(arc_cover_clip_saved_radii_.end());
+    }
+    // The part of the view on the page's side of the line, in its own
+    // coordinates (the views above are BrowserView's direct children).
+    gfx::Rect keep(view->size());
+    if (right_aligned) {
+      keep.set_width(std::clamp(*line - view->x(), 0, view->width()));
+    } else {
+      const int cut = std::clamp(*line - view->x(), 0, view->width());
+      keep.Inset(gfx::Insets::TLBR(0, cut, 0, 0));
+    }
+    const bool cutting = keep.width() < view->width();
+    if (cutting && keep.IsEmpty()) {
+      // Wholly on the sidebar's side: an empty clip rect means "no clip" to
+      // cc (cc::Layer::EffectiveClipRect), so the clip is a sliver just past
+      // the view instead, which keeps nothing (reviewer r1027 diff: a blank
+      // tab's logo left of the line in a narrow split showed through whole).
+      keep = right_aligned ? gfx::Rect(-1, 0, 1, std::max(1, view->height()))
+                           : gfx::Rect(view->width(), 0, 1,
+                                       std::max(1, view->height()));
+    }
+    layer->SetClipRect(cutting ? keep : gfx::Rect());
+    // The card's corner where the line cuts it; the far side keeps what the
+    // view had, and so does all of it while the line misses it.
+    gfx::RoundedCornersF radii = saved->second;
+    if (cutting && radius > 0.f && (part.top_corner || part.bottom_corner)) {
+      const float top = part.top_corner ? radius : 0.f;
+      const float bottom = part.bottom_corner ? radius : 0.f;
+      if (right_aligned) {
+        radii.set_upper_right(top);
+        radii.set_lower_right(bottom);
+      } else {
+        radii.set_upper_left(top);
+        radii.set_lower_left(bottom);
+      }
+    }
+    if (layer->rounded_corner_radii() != radii) {
+      layer->SetRoundedCornerRadius(radii);
+    }
+  }
+}
