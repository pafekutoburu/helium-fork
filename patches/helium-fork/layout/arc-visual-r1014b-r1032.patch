Index: src/chrome/browser/ui/helium/arc_card_layout_unittest.cc
===================================================================
--- src.orig/chrome/browser/ui/helium/arc_card_layout_unittest.cc
+++ src/chrome/browser/ui/helium/arc_card_layout_unittest.cc
@@ -150,5 +150,31 @@
   EXPECT_EQ(12, ArcConcentricInnerRadius(12, -3));
 }
 
+// r1024 (the user, 2026-10-13): the band's capsule 1 bigger on every side,
+// "地址胶囊的左、上距红区边缘5个像素" -- and nothing it holds moves: the band
+// stays 42, the contents keep r1023's 6 / 30, the capsule is concentric with
+// the card (7), the icons' hover washes inside it keep 4 (3 in now), and the
+// trailing 28pt buttons keep 7 from the card's top and right.
+TEST(ArcCardLayoutTest, BandCapsuleGrowsRoundContentsThatStayPut) {
+  constexpr int kCardRadius = 12;
+  constexpr int kButton = 28;
+  EXPECT_EQ(5, kArcBandFieldInset);
+  EXPECT_EQ(32, kArcBandFieldHeight);
+  EXPECT_EQ(42, kArcBandFieldInset + kArcBandFieldHeight + kArcBandFieldInset);
+  EXPECT_EQ(6, kArcBandFieldInset + kArcBandCapsuleOutset);
+  EXPECT_EQ(30, kArcBandFieldContentHeight);
+  EXPECT_EQ(7, kCardRadius - kArcBandFieldInset);
+  // The chip's wash: 2pt of upstream padding plus the capsule's 1.
+  EXPECT_EQ(4, ArcConcentricInnerRadius(kCardRadius - kArcBandFieldInset,
+                                        2 + kArcBandCapsuleOutset));
+  EXPECT_EQ(7, kArcBandFieldInset + (kArcBandFieldHeight - kButton) / 2);
+  const gfx::Rect capsule(265, 9, 800, kArcBandFieldHeight);
+  EXPECT_EQ(gfx::Rect(266, 10, 798, kArcBandFieldContentHeight).ToString(),
+            ArcBandFieldContentBounds(capsule).ToString());
+  // Same centre line: the band's field and what it holds.
+  EXPECT_EQ(capsule.CenterPoint().y(),
+            ArcBandFieldContentBounds(capsule).CenterPoint().y());
+}
+
 }  // namespace
 }  // namespace helium
