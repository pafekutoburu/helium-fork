+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_ARC_COMPOSER_FOOTER_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_ARC_COMPOSER_FOOTER_VIEW_H_
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/helium/arc_composer.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+namespace views {
+class Label;
+}
+
+// helium-fork r1021: the second row of the composer's box -- "+ Add tabs or
+// files", the mic and the send button, `Dia:`'s attachment bar drawn as
+// placeholders. The user (2026-10-11, r10): "第2行就按照Dia浏览器一样，加上第2
+// 行的功能按钮，但我们现在只是把按钮画上占位（以后这块儿的功能是要开发上的）";
+// r11: the chip has no outline at rest, only a hover capsule. Nothing here does
+// anything yet: a press on a button is swallowed, elsewhere it is a press on
+// the panel.
+//
+// Two instances, one class. ArcComposerHostView carries one in the resting
+// box's second row; RoundedOmniboxResultsFrame carries one under the
+// suggestion list (helium::ArcOmniboxPanelMetrics::footer_height), `Dia:`'s
+// shape. The popup's card covers the host's row whenever it is up, so exactly
+// one is on screen in any frame -- and the host's never steps aside for the
+// popup: the model's open/closed answer flips a frame before or after the
+// popup's pixels (r8.6b), so stepping aside on it would leave a frame with
+// neither. Both lay out from helium::ArcComposerFooterLayoutFor() with the same
+// column, so the two are the same pixels.
+class ArcComposerFooterView : public views::View {
+  METADATA_HEADER(ArcComposerFooterView, views::View)
+
+ public:
+  ArcComposerFooterView();
+  ArcComposerFooterView(const ArcComposerFooterView&) = delete;
+  ArcComposerFooterView& operator=(const ArcComposerFooterView&) = delete;
+  ~ArcComposerFooterView() override;
+
+  // The magnifier's column in this view's x: the "+" stands under it, as the
+  // suggestions' icons do.
+  void SetColumn(int column_x);
+
+  // Drops a hover the view can no longer see end -- the popup covering it,
+  // the box changing places.
+  void ClearHover();
+
+  // views::View:
+  void Layout(PassKey) override;
+  void OnPaint(gfx::Canvas* canvas) override;
+  void OnThemeChanged() override;
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  void OnMouseEntered(const ui::MouseEvent& event) override;
+  void OnMouseMoved(const ui::MouseEvent& event) override;
+  void OnMouseExited(const ui::MouseEvent& event) override;
+
+ private:
+  enum class Part { kNone, kChip, kMic, kSend };
+
+  helium::ArcComposerFooterLayout ComputeLayout() const;
+  Part PartAt(const gfx::Point& point) const;
+  void SetHovered(Part part);
+
+  int column_x_ = helium::kArcComposerGlyphMargin;
+  Part hovered_ = Part::kNone;
+  raw_ptr<views::Label> label_ = nullptr;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_ARC_COMPOSER_FOOTER_VIEW_H_
