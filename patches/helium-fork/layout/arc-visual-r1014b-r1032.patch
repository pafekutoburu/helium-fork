+ArcComposerFooterView::ArcComposerFooterView() {
+  // Placeholders: nothing for assistive technology to announce or reach.
+  GetViewAccessibility().SetIsIgnored(true);
+  auto label = std::make_unique<views::Label>(u"Add tabs or files");
+  label->SetFontList(views::TypographyProvider::Get().GetFont(
+      CONTEXT_OMNIBOX_PRIMARY, views::style::STYLE_PRIMARY));
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetAutoColorReadabilityEnabled(false);
+  // Both hosts paint into a non-opaque layer (the host's, the popup's).
+  label->SetSkipSubpixelRenderingOpacityCheck(true);
