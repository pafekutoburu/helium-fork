+    if (x < r.x() || x > r.right() || y < r.y() || y > r.bottom()) {
+      return false;
+    }
+    const auto in_arc = [&](double cx, double cy, int radius) {
+      return (x - cx) * (x - cx) + (y - cy) * (y - cy) <=
+             static_cast<double>(radius) * radius;
+    };
+    if (tl > 0 && x < r.x() + tl && y < r.y() + tl) {
+      return in_arc(r.x() + tl, r.y() + tl, tl);
+    }
+    if (tr > 0 && x > r.right() - tr && y < r.y() + tr) {
+      return in_arc(r.right() - tr, r.y() + tr, tr);
