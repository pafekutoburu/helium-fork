+void BrowserView::UpdateArcCoverPageClip() {
+  // ⛔ r1027: while a floating card docks (IsArcSidebarCoverOverPage) the
+  // page slides out from under the sidebar to the docked line; nothing of it
+  // may show left of that line, or the sidebar's glass -- what the card's
+  // dress fades into -- shows the page instead. Each of the page's own
+  // layers is clipped there: the band, infobars, the contents (all panes),
+  // the blank tab's box. The card's corner on the line is cc's: a layer's
+  // rounded corners apply to its effective clip rect (cc::Layer::
+  // EffectiveClipRect, MaskFilterInfo in property_tree_builder.cc).
+  std::optional<int> line;
