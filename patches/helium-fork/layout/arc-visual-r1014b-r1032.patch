@@ -0,0 +1,160 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/arc_composer_still_view.h"
+
+#include <algorithm>
+#include <memory>
+#include <optional>
+
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/helium/arc_composer.h"
+#include "chrome/browser/ui/helium/arc_omnibox_panel.h"
+#include "chrome/browser/ui/layout_constants.h"
+#include "chrome/browser/ui/views/helium/arc_composer_footer_view.h"
+#include "chrome/browser/ui/views/helium/arc_omnibox_panel_painter.h"
+#include "chrome/browser/ui/views/location_bar/location_bar_view.h"
+#include "components/omnibox/browser/autocomplete_match.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_provider.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/paint_vector_icon.h"
+#include "ui/views/accessibility/view_accessibility.h"
+
+ArcComposerStillView::ArcComposerStillView() {
+  // A click here is a click on the half's page beneath: upstream activates
+  // the half, and the real box comes over (see the header).
+  SetCanProcessEventsWithinSubtree(false);
+  // A layer of its own, as the real box and the mark have: a view without one
+  // paints into its parent's layer, which composites beneath the web
+  // contents' (BrowserView, arc_composer_logo_).
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  // A picture, not a control: nothing in it can be reached.
+  GetViewAccessibility().SetIsLeaf(true);
+  GetViewAccessibility().SetIsIgnored(true);
+  SetVisible(false);
+  footer_ = AddChildView(std::make_unique<ArcComposerFooterView>());
+}
+
+ArcComposerStillView::~ArcComposerStillView() = default;
+
+void ArcComposerStillView::Update(const gfx::Rect& card,
+                                  LocationBarView* field,
+                                  const std::u16string& draft) {
+  const gfx::Rect placed = helium::ArcComposerSplitBounds(card);
+  if (placed.IsEmpty() || !field) {
+    if (GetVisible()) {
+      SetVisible(false);
+    }
+    return;
+  }
+  const gfx::Rect box = placed - card.OffsetFromOrigin();
+  const gfx::Rect field_rect = helium::ArcComposerFieldBounds(box);
+  // Where the real field's text sat the last time it was laid out in the
+  // blank tab's box -- the textfield's display rect, where Textfield draws
+  // its placeholder -- as insets from the field, so this box's own width
+  // decides the text's (and its elision) as it would the real one's. Before
+  // the field has ever been laid out there (a split restored with this half
+  // already behind): the list's text column after the glyph, the row's full
+  // height.
+  gfx::Rect text = field_rect;
+  if (const std::optional<gfx::Insets>& insets =
+          field->arc_composer_text_insets()) {
+    text.Inset(*insets);
+  } else {
+    text.Inset(gfx::Insets::TLBR(
+        0,
+        helium::kArcComposerFieldGlyphCentre -
+            helium::kArcComposerIconSize / 2 +
+            helium::kArcComposerListTextInset -
+            helium::kArcComposerListIconInset,
+        0, 0));
+  }
+  const std::u16string placeholder = field->GetArcRestingPlaceholderText();
+  const bool repaint = !GetVisible() || box != box_ || text != text_ ||
+                       placeholder != placeholder_ || draft != draft_;
+  box_ = box;
+  text_ = text;
+  placeholder_ = placeholder;
+  draft_ = draft;
+  SetBoundsRect(card);
+  const int first_row = helium::ArcComposerFirstRowHeight(box, field_rect);
+  footer_->SetBoundsRect(gfx::Rect(box.x(), box.y() + first_row, box.width(),
+                                   std::max(0, box.height() - first_row)));
+  footer_->SetColumn(helium::kArcComposerGlyphMargin);
+  SetVisible(true);
+  if (repaint) {
+    SchedulePaint();
+  }
+}
+
+void ArcComposerStillView::OnPaint(gfx::Canvas* canvas) {
+  if (box_.IsEmpty()) {
+    return;
+  }
+  const ui::ColorProvider* const colors = GetColorProvider();
+  const SkColor background = colors->GetColor(kColorOmniboxResultsBackground);
+  const gfx::Rect field = helium::ArcComposerFieldBounds(box_);
+
+  // The card and its shadow: the resting box's own painter and metrics
+  // (ArcOmniboxPanelView, LocationBarView::GetArcOmniboxPanelMetrics), the
+  // half's card as the page its shadow may spread into.
+  const helium::ArcOmniboxPanelMetrics metrics =
+      helium::ComputeArcComposerPanel(
+          /*enabled=*/true, box_, field,
+          GetLayoutConstant(LayoutConstant::kVerticalTabFavoriteCornerRadius),
+          helium::kArcComposerRadius,
+          helium::ArcComposerSideRoomsFor(GetLocalBounds(), box_),
+          helium::ArcComposerFooterHeight(box_, field),
+          helium::ArcComposerListMetrics(0, 0));
+  helium::PaintArcOmniboxPanel(
+      canvas, metrics, box_, background,
+      color_utils::IsDark(colors->GetColor(kColorToolbar)),
+      /*hole=*/gfx::Rect(), /*page=*/background, /*resting_height=*/0);
+
+  // The magnifier and the placeholder, the hint grey both -- the glyph the
+  // resting box's field shows (OmniboxView::GetIcon with nothing typed: the
+  // what-you-typed search icon), and the placeholder drawn as Textfield draws
+  // it (Textfield::PaintTextAndCursor).
+  const SkColor hint = colors->GetColor(kColorOmniboxArcComposerHint);
+  AutocompleteMatch search;
+  search.type = AutocompleteMatchType::SEARCH_WHAT_YOU_TYPED;
+  canvas->DrawImageInt(
+      gfx::CreateVectorIcon(search.GetVectorIcon(/*is_bookmark=*/false),
+                            helium::kArcComposerIconSize, hint),
+      box_.x() + helium::kArcComposerGlyphMargin -
+          helium::kArcComposerIconSize / 2,
+      box_.y() + helium::kArcComposerGlyphMargin -
+          helium::kArcComposerIconSize / 2);
+  // r1024: the half's draft where there is one, in the field's own text
+  // colour (the glyph stays the hint grey, as in the real box with text).
+  canvas->DrawStringRectWithFlags(
+      draft_.empty() ? placeholder_ : draft_,
+      LocationBarView::GetArcComposerNewTabFontList(),
+      draft_.empty() ? hint : colors->GetColor(kColorOmniboxText), text_,
+      gfx::Canvas::TEXT_ALIGN_LEFT | gfx::Canvas::NO_SUBPIXEL_RENDERING);
+
+  // The mark, where it fits in the card (helium::ArcComposerLogoFits).
+  if (helium::ArcComposerLogoFits(GetLocalBounds(), box_)) {
+    const gfx::Rect logo = helium::ArcComposerLogoBounds(box_);
+    canvas->DrawImageInt(
+        gfx::CreateVectorIcon(kChromeProductHollowIcon,
+                              helium::kArcComposerLogoSize,
+                              helium::kArcComposerLogoColor),
+        logo.x(), logo.y());
+  }
+}
+
+void ArcComposerStillView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  // A layer of its own: nothing re-rasters it on a theme change.
+  SchedulePaint();
+}
+
+BEGIN_METADATA(ArcComposerStillView)
+END_METADATA
