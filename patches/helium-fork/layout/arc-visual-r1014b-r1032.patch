+void BrowserView::UpdateArcPopupOccluder() {
+  LocationBarView* const location_bar = GetLocationBarView();
+  if (!location_bar) {
+    return;
+  }
+  // The blank new tab's box is under the floating card (UpdateArcComposer-
+  // ZOrder); its suggestion list is a window of its own and cannot be. While
+  // the card is out, the list is told where it is and gets out of its way
+  // (OmniboxPopupViewViews::SetArcOccluder). The Cmd+L boxes stand over the
+  // card, and so do their lists.
+  // ⛔ r1026: and while Cmd+S turns an out card into the docked sidebar --
+  // the sidebar stays over the page (BeginArcSidebarCover) while the page's
+  // edge slides under it, and the list, re-placed with the box every frame,
+  // would otherwise come back over the sidebar the moment the collapse state
+  // flips (reviewer r1026 brief).
+  // r1030: and never for a peek -- its cover has the page over the sidebar
+  // (the page's box, and so its list, is over the sidebar then), and at
+  // rest the sidebar stands beside the page, not over it (reviewer r1030
+  // diff: the ratio is 1 then, as for an out card). Only the floating card
+  // (zen's now) and a cover that keeps a card over the page occlude.
+  const bool sidebar_over_page =
+      (IsSidebarHiddenModeActive() && GetSideChromeRevealRatio() > 0.f &&
+       !arc_sidebar_peek_) ||
+      (sidebar_toggle_phase_ == SidebarTogglePhase::kCovering &&
+       !arc_sidebar_under_contents_);
+  const bool list_is_the_blank_tabs =
+      GetArcComposerPlacement() == helium::ArcComposerPlacement::kNewTab &&
+      vertical_tab_strip_region_view_ &&
+      vertical_tab_strip_region_view_->GetVisible();
+  std::optional<gfx::Rect> card;
+  if (list_is_the_blank_tabs && sidebar_over_page) {
+    card = vertical_tab_strip_region_view_->GetBoundsInScreen();
+  }
+  // While the card is out, the pointer over the list's window has to reach
+  // the card's hover logic too (OnEvent): the window monitor only hears this
+  // window, and the list lets the pointer through to it only over the card
+  // (reviewer r1025 brief: a list that ignored the pointer altogether stayed
+  // dead under it for as long as the card's 82pt leeway kept the card out).
+  // r1030: and for every leg of a peek, occluder or none -- the pointer in
+  // the list's window past the sidebar's band must still retract it, and
+  // back over the sidebar turn the retract round (reviewer r1030 brief).
+  const bool watch = list_is_the_blank_tabs && (card || arc_sidebar_peek_);
+  if (watch && !arc_popup_event_monitor_ && GetWidget()) {
+    arc_popup_event_monitor_ = views::EventMonitor::CreateApplicationMonitor(
+        this, GetWidget()->GetNativeWindow(),
+        {ui::EventType::kMouseMoved, ui::EventType::kMouseExited});
+  } else if (!watch) {
+    arc_popup_event_monitor_.reset();
+  }
+  location_bar->SetArcPopupOccluder(card);
+}
