+void BrowserView::UpdateArcComposerZOrder() {
+  // helium-fork r1024 (the user, 2026-10-13): "鼠标焦点在左侧这个窗口时，用鼠
+  // 标呼出侧边栏时，搜索框会压在侧边栏上". The blank new tab's box is part of
+  // the page, and the floating sidebar slides over the page; the Cmd+L boxes
+  // are edit surfaces grown out of the sidebar's row or hung over the band,
+  // and stay on top. Restacking is a layer walk, so only on a change.
+  const bool under =
+      GetArcComposerPlacement() == helium::ArcComposerPlacement::kNewTab;
+  if (under == arc_composer_under_sidebar_) {
+    return;
+  }
+  arc_composer_under_sidebar_ = under;
+  ReorderLayers();
