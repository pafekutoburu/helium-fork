@@ -0,0 +1,133 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/arc_omnibox_panel_view.h"
+
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/omnibox/omnibox_controller.h"
+#include "chrome/browser/ui/views/helium/arc_omnibox_panel_painter.h"
+#include "chrome/browser/ui/views/location_bar/location_bar_view.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_provider.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/geometry/rect_conversions.h"
+#include "ui/gfx/geometry/rect_f.h"
+
+ArcOmniboxPanelView::ArcOmniboxPanelView() {
+  // It covers the band's margins and the top of the page, so it must be
+  // invisible to input; and it needs its own layer to composite above the
+  // band's and the contents', both of which are layers themselves (a view
+  // without one paints into the shared parent layer, which is *below* them
+  // whatever the child order says).
+  SetCanProcessEventsWithinSubtree(false);
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  SetVisible(false);
+}
+
+ArcOmniboxPanelView::~ArcOmniboxPanelView() = default;
+
+void ArcOmniboxPanelView::SetLocationBar(LocationBarView* location_bar) {
+  if (location_bar_ == location_bar) {
+    return;
+  }
+  location_bar_observation_.Reset();
+  location_bar_ = location_bar;
+  if (!location_bar_) {
+    // Detaching happens during BrowserView's destruction; touching visibility
+    // there would relayout a half-torn-down tree for nothing.
+    return;
+  }
+  location_bar_observation_.Observe(location_bar_.get());
+  UpdateFromField();
+}
+
+void ArcOmniboxPanelView::UpdateFromField() {
+  const auto hide = [this]() {
+    if (GetVisible()) {
+      SetVisible(false);
+    }
+  };
+
+  if (!location_bar_ || !parent()) {
+    hide();
+    return;
+  }
+
+  const helium::ArcOmniboxPanelMetrics metrics =
+      location_bar_->GetArcOmniboxPanelMetrics();
+  // Editing, and nothing to suggest yet. Once the popup is up it draws the very
+  // same panel around the very same field, and two of them would double the
+  // shadow.
+  if (!metrics.enabled || !location_bar_->GetVisible() ||
+      !location_bar_->IsArcFieldEditing() ||
+      location_bar_->GetOmniboxController()->IsPopupOpen()) {
+    hide();
+    return;
+  }
+
+  gfx::RectF field_f(location_bar_->GetLocalBounds());
+  views::View::ConvertRectToTarget(location_bar_, parent(), &field_f);
+  const gfx::Rect field = gfx::ToEnclosingRect(field_f);
+  const gfx::Rect panel = metrics.PanelFor(field);
+  if (panel.IsEmpty()) {
+    hide();
+    return;
+  }
+
+  // The view is the panel plus the room its shadow spreads into. Anything
+  // painted outside a layer-backed view's bounds is clipped away, and the
+  // shadow is the whole point.
+  gfx::Rect view_bounds = panel;
+  view_bounds.Inset(-helium::ArcOmniboxPanelShadowInsets(metrics));
+
+  const gfx::Rect panel_in_view = panel - view_bounds.OffsetFromOrigin();
+  const gfx::Rect field_in_view = field - view_bounds.OffsetFromOrigin();
+  // BrowserView::Layout() calls this on every pass, so repainting has to be
+  // conditional -- otherwise a window resize with the field focused would
+  // re-raster this layer once per layout for nothing.
+  const bool repaint = panel_in_view != panel_in_view_ ||
+                       field_in_view != field_in_view_ || !GetVisible();
+  metrics_ = metrics;
+  panel_in_view_ = panel_in_view;
+  field_in_view_ = field_in_view;
+  SetBoundsRect(view_bounds);
+  SetVisible(true);
+  if (repaint) {
+    SchedulePaint();
+  }
+}
+
+void ArcOmniboxPanelView::OnPaint(gfx::Canvas* canvas) {
+  if (!metrics_.enabled || panel_in_view_.IsEmpty()) {
+    return;
+  }
+  const auto* const color_provider = GetColorProvider();
+  helium::PaintArcOmniboxPanel(
+      canvas, metrics_, panel_in_view_,
+      color_provider->GetColor(kColorOmniboxResultsBackground),
+      color_utils::IsDark(color_provider->GetColor(kColorToolbar)),
+      field_in_view_);
+}
+
+void ArcOmniboxPanelView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  // Same reason ArcCardOutlineView repaints here: this view owns a layer, and
+  // nothing invalidates a layer's raster on a theme change, so the panel would
+  // keep its light-mode white on a dark window.
+  SchedulePaint();
+}
+
+void ArcOmniboxPanelView::OnLocationBarBoundsChanged() {
+  UpdateFromField();
+}
+
+void ArcOmniboxPanelView::OnLocationBarEditStateChanged() {
+  UpdateFromField();
+}
+
+BEGIN_METADATA(ArcOmniboxPanelView)
+END_METADATA
