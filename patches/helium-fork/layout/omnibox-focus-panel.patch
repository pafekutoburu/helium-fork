@@ -0,0 +1,80 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_ARC_OMNIBOX_PANEL_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_ARC_OMNIBOX_PANEL_VIEW_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/ui/helium/arc_omnibox_panel.h"
+#include "chrome/browser/ui/location_bar/location_bar.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/view.h"
+
+class LocationBarView;
+
+// helium-fork: the Arc shell's edit-state panel while the suggestion popup is
+// closed -- i.e. from the moment the field is clicked until there is something
+// to suggest. Dia's panel appears on the click, not on the first keystroke.
+//
+// Why this cannot be the field's own painting: the band clips its contents
+// (TopContainerView::SetArcCardClipEnabled), so nothing inside it can cast a
+// shadow onto the page below. And why it is not the suggestion popup opened
+// early: that popup's open/closed state is read in a dozen places in
+// OmniboxEditModel -- Enter, the arrow keys, the icon, the metrics -- and none
+// of them should change for a purely visual effect.
+//
+// So the panel is a BrowserView child, ordered after the card's shadow so its
+// layer composites above both the band and the page, and it paints the panel
+// *around* the field with the field's own rounded rect clipped out. The field
+// keeps painting itself, in the band, exactly as before.
+//
+// The popup takes over the instant it opens, at the same rect with the same
+// radius and the same shadow (both come from helium::ArcOmniboxPanelMetrics and
+// both are drawn by helium::PaintArcOmniboxPanel), so the handover is
+// invisible: the panel simply grows downwards.
+class ArcOmniboxPanelView : public views::View, public LocationBar::Observer {
+  METADATA_HEADER(ArcOmniboxPanelView, views::View)
+
+ public:
+  ArcOmniboxPanelView();
+  ArcOmniboxPanelView(const ArcOmniboxPanelView&) = delete;
+  ArcOmniboxPanelView& operator=(const ArcOmniboxPanelView&) = delete;
+  ~ArcOmniboxPanelView() override;
+
+  // Attaches to the field. Separate from the constructor because BrowserView
+  // creates this view in its own constructor -- child order is load-bearing --
+  // while ToolbarView::Init(), which is what builds the field, does not run
+  // until AddedToWidget().
+  void SetLocationBar(LocationBarView* location_bar);
+
+  // Recomputes visibility and bounds from the field's current state. Cheap and
+  // idempotent, and the only writer of either -- the layout deliberately does
+  // not place this view, because the field's width is settled by the toolbar's
+  // FlexLayout well after BrowserViewTabbedLayoutImpl has run.
+  void UpdateFromField();
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+  void OnThemeChanged() override;
+
+  // LocationBar::Observer:
+  void OnLocationBarBoundsChanged() override;
+  void OnLocationBarEditStateChanged() override;
+
+ private:
+  // The panel and the field's hole in it, both in this view's coordinates.
+  // This view is the panel plus the room its shadow needs, so neither is at
+  // the origin.
+  gfx::Rect panel_in_view_;
+  gfx::Rect field_in_view_;
+  helium::ArcOmniboxPanelMetrics metrics_;
+
+  raw_ptr<LocationBarView> location_bar_ = nullptr;
+  base::ScopedObservation<LocationBar, LocationBar::Observer>
+      location_bar_observation_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_ARC_OMNIBOX_PANEL_VIEW_H_
