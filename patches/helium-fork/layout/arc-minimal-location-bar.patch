+bool LocationBarView::ShouldMinimizeArcChrome() const {
+  // helium-fork: the Dia/Zen field treatment -- at rest nothing but the
+  // domain. Skipped for popup windows and under high-contrast preferences
+  // (a hidden field boundary is an accessibility regression there).
+  if (is_popup_mode_ || !browser_ || !browser_->is_type_normal()) {
+    return false;
+  }
+  // View::GetNativeTheme() DCHECKs without a widget (ui/views/view.cc), and
+  // this is reached from GetBorderRadius() in the constructor, before the
+  // field has one. Nothing is painted yet at that point, so answering "no" is
+  // both safe and correct; the first real layout asks again.
+  if (!GetWidget()) {
+    return false;
+  }
+  if (GetNativeTheme()->preferred_contrast() ==
+      ui::NativeTheme::PreferredContrast::kMore) {
+    return false;
+  }
+  auto* const controller =
+      tabs::VerticalTabStripStateController::From(browser_);
+  return controller && controller->ShouldDisplayVerticalTabs();
+}
+
+bool LocationBarView::IsArcChromeRevealed() const {
+  return hover_animation_.IsShowing() ||
+         hover_animation_.GetCurrentValue() > 0.0 ||
+         (omnibox_view_ && omnibox_view_->HasFocus()) ||
+         GetOmniboxController()->edit_model()->user_input_in_progress();
+}
+
+bool LocationBarView::ComputeArcMinimalRest() const {
+  return ShouldMinimizeArcChrome() && !IsArcChromeRevealed();
+}
+
+void LocationBarView::UpdateArcMinimalDecorations() {
+  // helium-fork: compare against what Layout() last applied rather than
+  // invalidating unconditionally.
+  //
+  // The hover tween decides this state and keeps running for 200ms after the
+  // pointer leaves, so the single invalidation at mouse-exit still computed
+  // "revealed" -- and nothing invalidated again when the tween reached zero,
+  // because AnimationProgressed only repaints. The revealed icons then sat
+  // there until some unrelated relayout swept them up: "鼠标移走之后，icon 就该
+  // 消失的，但现在没有，且网页往下滚动之后，这些 icon 又消失了". Calling this
+  // from the animation callbacks as well makes the flip land on the frame it
+  // actually happens, and the equality check keeps that to one relayout rather
+  // than one per animation frame.
+  if (!ShouldMinimizeArcChrome() ||
+      ComputeArcMinimalRest() == arc_minimal_rest_) {
+    return;
+  }
+  InvalidateLayout();
+}
+
+double LocationBarView::GetArcRevealAmount() const {
+  if (!ShouldMinimizeArcChrome()) {
+    return 1.0;
+  }
+  // Focus and in-progress input are deliberate acts, and upstream snaps the
+  // field's background for them rather than transitioning (OnOmniboxFocused
+  // resets the tween). The decorations snap with it.
+  if ((omnibox_view_ && omnibox_view_->HasFocus()) ||
+      GetOmniboxController()->edit_model()->user_input_in_progress()) {
+    return 1.0;
+  }
+  return hover_animation_.GetCurrentValue();
+}
+
+namespace {
+
+// helium-fork: a Label painting with subpixel anti-aliasing DCHECKs unless it
+// can find an opaque background or an opaque layer above it (Label::PaintText).
+// The reveal fade gives the decoration containers a non-opaque layer, so the
+// labels inside them -- page action chips expand into one at any time -- have
+// to waive that check, exactly as the icon-label crossfade strategy does.
+void WaiveSubpixelOpacityCheck(views::View* view) {
+  if (auto* const label = views::AsViewClass<views::Label>(view)) {
+    label->SetSkipSubpixelRenderingOpacityCheck(true);
+  }
+  for (views::View* child : view->children()) {
+    WaiveSubpixelOpacityCheck(child);
+  }
+}
+
+}  // namespace
+
+void LocationBarView::UpdateArcRevealOpacity() {
+  // helium-fork: the field's wash and the trailing icons are two halves of one
+  // reveal, and they used to read the same animation on two different curves --
+  // the wash tweened over 200ms while the icons rode a boolean that only
+  // flipped once the tween reached exactly zero. Leaving the field, the
+  // background faded out and the icons stayed at full strength behind it for
+  // the whole animation before popping ("背景色先消失，图标后消失"). Driving
+  // their opacity from the same value is what makes them one thing.
+  views::View* const containers[2] = {page_action_icon_container_,
+                                      page_action_container_};
+  const bool minimize = ShouldMinimizeArcChrome();
+  const float amount = static_cast<float>(GetArcRevealAmount());
+  for (size_t i = 0; i < std::size(containers); ++i) {
+    views::View* const container = containers[i];
+    if (!container) {
+      continue;
+    }
+    if (!minimize) {
+      if (arc_reveal_layer_owned_[i]) {
+        container->DestroyLayer();
+        arc_reveal_layer_owned_[i] = false;
+      } else if (container->layer()) {
+        container->layer()->SetOpacity(1.0f);
+      }
+      continue;
+    }
+    if (!container->layer()) {
+      container->SetPaintToLayer();
+      container->layer()->SetFillsBoundsOpaquely(false);
+      arc_reveal_layer_owned_[i] = true;
+    }
+    WaiveSubpixelOpacityCheck(container);
+    container->layer()->SetOpacity(amount);
+  }
+}
