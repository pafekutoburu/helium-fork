Index: src/chrome/browser/ui/helium/arc_loading_glow.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_loading_glow.h
@@ -0,0 +1,472 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_LOADING_GLOW_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_LOADING_GLOW_H_
+
+#include <algorithm>
+#include <cmath>
+#include <optional>
+
+#include "base/time/time.h"
+
+// helium-fork: the address field's loading glow -- Dia's, copied. The user
+// (2026-10-05): 「它的设计是有一个光线的散射蔓延到整个URL区域，包括遇到加载
+// 较慢时，它的忽明忽暗的设计。这个地方就完全参考Dia来设计。」 It replaces
+// both upstream's location-bar progress line (Helium 0.18) and our own M3.8
+// line along the contents' top edge, which together drew two bars per load.
+//
+// Timing is `Dia:` read off the user's two recordings of letterboxd.com
+// (Desktop 03.39.55 slow / 03.40.39 normal, 60fps, 2026-10-05) and re-checked
+// on lossless captures (2026-10-08); the shape is the lossless captures' --
+// see the Shape section and progress/decisions.md 「r1009」 (「Dia 加载光带」
+// for r1005's original fit).
+//
+// The glow, as Dia draws it, inside the field's rounded rect: one blue whose
+// intensity falls off with the distance to the progress line along the field's
+// bottom edge -- strong enough at the very bottom to clip into a bright cyan
+// line, a faint scatter up the field and ahead of the head -- fading out
+// behind the head over ~34 field heights; while loading, every 1.5s a white
+// sheen sweeps left to right through it (the 「忽明忽暗」); the head follows real
+// load progress with a 250ms ease-out per update, the glow fades in over
+// ~160ms when a load starts, and once loading stops the head finishes at the
+// far end and the glow fades out in ~330ms. Ours adds two things Dia does not
+// do (r1010, the Along the field section): the glow fades in from the field's
+// leading edge, and in the sidebar row its fade behind the head is measured
+// in the row's width.
+//
+// Kept free of //ui/views and //content so the unit tests can reach it.
+namespace helium {
+
+// --- Timing (Dia, 2026-10-05) ----------------------------------------------
+
+// The head's response to each progress update: 50% of the way in ~50ms, 90%
+// in ~125ms, settled by ~250ms -- a cubic ease-out over 250ms (three jumps
+// read: 10% -> 30% -> 100%, and the normal load's 24% -> 100% which is several
+// updates chained, each retargeting from wherever the head was).
+inline constexpr base::TimeDelta kLoadingGlowProgressEase =
+    base::Milliseconds(250);
+
+// Where a fresh load starts its head: Chromium reports 0.1 as the very first
+// progress (and Dia's front lands on ~10% of the field before the first real
+// update), so the head heads there straight away.
+inline constexpr double kLoadingGlowInitialProgress = 0.1;
+
+// Alpha 0 -> 1 when a load starts (cubic ease-out). The pixel a few points in
+// from the field's left edge reads 52 / 68 / 82 / 96% of its settled value at
+// 16 / 50 / 83 / 133ms after the glow first shows.
+inline constexpr base::TimeDelta kLoadingGlowFadeIn = base::Milliseconds(160);
+
+// Alpha 1 -> 0 once loading has stopped and the head has reached the far end:
+// remaining = (1 - t)^2.5 over 330ms (both recordings: half gone at ~70ms,
+// a quarter left at ~145ms, a tenth at ~210ms, nothing at ~280ms).
+inline constexpr base::TimeDelta kLoadingGlowFadeOut = base::Milliseconds(330);
+inline constexpr double kLoadingGlowFadeOutExponent = 2.5;
+
+// The sheen. Period 1.5s exactly (four peaks at 5.517 / 7.017 / 8.517 /
+// 10.033s on one pixel). Its centre crosses the field's left edge 0.45s into
+// every cycle (cycles count from the moment the glow appeared) and travels
+// 1.8 field widths per second (0.55s across the 1585-unit field); its profile is
+// a gaussian 0.315 field widths at half maximum, mixing the glow's colour
+// towards white at the centre -- by 0.38 (r1009 lossless: 0.39 of every body
+// row's darkness taken off at the peak, the same over a white and a dark page,
+// so a colour mix, not an alpha cut; r1005's 0.30 was the compressed video's).
+// The period / timing / width / speed re-read on the lossless capture agree
+// (1.49-1.51s apart; sigma ~300px and ~3600-4200px/s in Dia's ~2180px field).
+inline constexpr base::TimeDelta kLoadingGlowShinePeriod =
+    base::Milliseconds(1500);
+inline constexpr base::TimeDelta kLoadingGlowShineCross =
+    base::Milliseconds(450);
+inline constexpr double kLoadingGlowShineSpeed = 1.8;   // field widths / s
+inline constexpr double kLoadingGlowShineFwhm = 0.315;  // field widths
+inline constexpr double kLoadingGlowShineStrength = 0.38;
+// Past this many sigmas the sheen changes nothing a display can show (the
+// mix there is under 0.5%).
+inline constexpr double kLoadingGlowShineReachSigmas = 3.0;
+
+// --- Shape (Dia, re-measured losslessly 2026-10-08) --------------------------
+//
+// ⛔ r1009 replaces r1005's row table, teal drift, line ramp, run-outs and haze
+// (fitted off compressed video, at a px/pt the 10-07 calibration later showed
+// was wrong). The user on r1008, 2026-10-07: 「Dia浏览器的进度条底部线条本体…比我
+// 们的更实/清晰，在进度条往前走的时候，前后线条的虚实/饱和度/对比度关系，Dia处理得更
+// 细致」, and asked for Dia's native effect. Dia's own shader is not read (its
+// terms forbid decompiling); it was filmed instead: ScreenCaptureKit window
+// capture of Dia, lossless, 2x, sRGB and Display P3, while the USER opened a
+// slow test page in it, once white and once #14181c. One frame over two
+// backgrounds gives alpha and colour per pixel; they come out source-over
+// (per-channel alphas agree to 0.003), and the whole glow is one function of
+// one number, the intensity I:
+//
+//   I = K * (dist / H)^-P * R                      H: the field's height
+//   output (premultiplied, sRGB-encoded) = (min(C * I, 1), min(I, 1))
+//
+// * dist is the distance from the pixel to the progress line -- the segment
+//   along the field's bottom edge from its leading edge to the head: straight
+//   down behind the head, radially past it. So what reads as a haze ahead is
+//   the same falloff, not a second layer (0.107 at 44px, 0.046 at 184, 0.016
+//   at 1084 ahead of the head, each within 0.01 of the formula);
+// * R fades the glow behind the head, linearly in the distance behind it and
+//   the same wherever the head is (heads at 507 and 722 read alike at equal
+//   distances behind them);
+// * one colour C. The bright cyan bottom pixel row is that same blue pushed
+//   past 1 -- blue clips first, then green (Dia's P3 capture reads (150,252,253)
+//   there, which is sRGB (110,255,255)); every row above it is C itself;
+// * the sheen mixes C towards white BEFORE the multiply, so the body lightens
+//   by its strength and the clipped row whitens further.
+// Read off a 30pt field at 2x, rows up from the bottom edge: 1 (clipped), 0.854,
+// 0.623, 0.510, 0.439, 0.389, ... 0.094 at the top. Nothing special happens at
+// Dia's field's leading edge: the rows run to it and the capsule clips them.
+// (r1010: ours multiplies I by a start fade there, and the sidebar row
+// measures R in its width -- the Along the field section below.)
+
+// C, sRGB-encoded: Dia's Display P3 (91,157,194).
+inline constexpr float kLoadingGlowColorR = 64.6f / 255.0f;
+inline constexpr float kLoadingGlowColorG = 159.1f / 255.0f;
+inline constexpr float kLoadingGlowColorB = 197.9f / 255.0f;
+
+// K: the intensity one field height from the line. P: its falloff.
+inline constexpr double kLoadingGlowIntensity = 0.0934;
+inline constexpr double kLoadingGlowFalloff = 0.6;
+
+// R behind the head: clamp(start - behind / length) -- full for the first
+// ~0.9 field heights, gone ~34 field heights back on the band (1004pt in Dia's
+// 30pt field: 616px behind its head it reads 0.72, 116px 0.97).
+inline constexpr double kLoadingGlowRampStart = 1.028;
+inline constexpr double kLoadingGlowRampLength = 33.5;  // field heights
+
+// --- Along the field (r1010, ours rather than Dia's) -------------------------
+//
+// User 2026-10-08 on r1009, the band: 「地址栏胶囊左下角进度条起点加一点点淡入，我看
+// 一下效果。」 -- and on the sidebar row: 「进度条变得很短之后，没有地址栏常驻模式的
+// 时候进度条细腻的效果。比如进度条的颜色和亮度的强度取决于线段的距离…还有进度条的
+// 起点也没有淡入的效果，完全是硬切的。…虽然距离变短了，但是出来的效果要保持一致。」
+
+// The start: the glow fades in over its first field height from the field's
+// leading edge (smoothstep), so the line no longer starts at full strength in
+// the capsule's bottom corner. ⚠ Not Dia's -- Dia's rows run to the capsule's
+// left end and its continuous corner clips them (r1009).
+inline constexpr double kLoadingGlowStartFade = 1.0;  // field heights
+
+// ...from half strength, not from nothing. r1011, the user on r1010's fade
+// from 0 (2026-10-08): "淡入的效果有点太过了，感觉加载条出现的时候，地址栏胶囊的
+// 左侧被掐掉了一段一样，主要是因为加载条本体消失了一小段之后，它散射出来的光也消失
+// 了…可以它淡入不是0开始，从30%或50%开始试一下，或者就是把淡入的那一小段再缩短
+// 一点。" The fade scales the whole glow, so from 0 the body went with the line
+// and the capsule's left end read as missing; at half strength the body still
+// fills the corner while the line starts soft (its bottom row, ~1.65 at full,
+// no longer clips). r1011 took 0.5, the lighter of the user's two; r1012 (user
+// 2026-10-08 on it): "加载域名的进度条，左端再收回来一点点，应该就差不多了" --
+// read as a little more fade, 0.4. ⛔ Wrong way round: r1013 (the user on
+// r1012, same day): "我上一次说的地址栏进度条收一点的意思是，往100%亮度的方向再
+// 走一点……在50%的基础上再往上走，试试65%的亮度" -- "收回来" was the fade
+// pulled back toward full strength. r1013 r2 (the user on 0.65, same day):
+// "光带起点改为55%" -- a little dimmer than 0.65, a little brighter than
+// r1011's 0.5. The bottom line starts below full alpha in the corner (the unit
+// test holds it there).
+inline constexpr double kLoadingGlowStartFadeFloor = 0.55;
+
+// Dia's field in the lossless capture (2180 x 60 px at 2x).
+inline constexpr double kLoadingGlowDiaFieldWidth = 1090.0;
+inline constexpr double kLoadingGlowDiaFieldHeight = 30.0;
+
+// The sidebar row's fade behind the head: the share of the capsule's width
+// that Dia's ramp is of its own field's (33.5 x 30 / 1090 = 0.92), so a ~300pt
+// capsule dims along its length -- and over the load -- the way the ~1000pt
+// band does. Its 33.5 field heights (~1140pt) left the row at 0.77 or better
+// end to end: one brightness, one saturation, the bottom line clipped bright
+// all the way to the corner. The band keeps Dia's measured length.
+inline constexpr double kLoadingGlowRowRampShare =
+    kLoadingGlowRampLength * kLoadingGlowDiaFieldHeight /
+    kLoadingGlowDiaFieldWidth;  // field widths
+
+// The lengths a field measures the glow along: its height (the vertical
+// falloff, the start fade), how far behind the head it has faded out, and how
+// far from the leading edge it takes to fade in -- all DIPs.
+struct LoadingGlowSpan {
+  double height = 0.0;
+  double ramp = 0.0;
+  double fade = 0.0;
+};
+
+// The band's field (and the composer's, which never shows it): Dia's.
+inline LoadingGlowSpan LoadingGlowBandSpan(double height) {
+  return {height, kLoadingGlowRampLength * height,
+          kLoadingGlowStartFade * height};
+}
+
+// The sidebar row's capsule (hidden address bar mode).
+inline LoadingGlowSpan LoadingGlowRowSpan(double width, double height) {
+  return {height, kLoadingGlowRowRampShare * width,
+          kLoadingGlowStartFade * height};
+}
+
+// The start fade at `x` from the field's leading edge.
+inline double LoadingGlowStartFadeAt(double x, double fade) {
+  if (fade <= 0.0) {
+    return 1.0;
+  }
+  const double t = std::clamp(x / fade, 0.0, 1.0);
+  return kLoadingGlowStartFadeFloor +
+         (1.0 - kLoadingGlowStartFadeFloor) * t * t * (3.0 - 2.0 * t);
+}
+
+// The intensity at `x` along the field from its leading edge and `above`
+// points above its bottom edge, the head at `head`. Both are to a pixel's
+// centre; `above` never under half a device pixel.
+inline double LoadingGlowIntensityAt(double x,
+                                     double head,
+                                     double above,
+                                     const LoadingGlowSpan& span) {
+  const double behind = head - x;
+  const double dist = behind >= 0.0 ? above : std::hypot(behind, above);
+  const double ramp =
+      behind > 0.0 && span.ramp > 0.0
+          ? std::clamp(kLoadingGlowRampStart - behind / span.ramp, 0.0, 1.0)
+          : 1.0;
+  return kLoadingGlowIntensity *
+         std::pow(dist / span.height, -kLoadingGlowFalloff) * ramp *
+         LoadingGlowStartFadeAt(x, span.fade);
+}
+
+// The glow there, premultiplied and sRGB-encoded, its colour first mixed
+// `shine` of the way to white (the sheen; 0 outside it).
+struct LoadingGlowPremul {
+  float r = 0.0f;
+  float g = 0.0f;
+  float b = 0.0f;
+  float a = 0.0f;
+};
+inline LoadingGlowPremul LoadingGlowAt(double x,
+                                       double head,
+                                       double above,
+                                       const LoadingGlowSpan& span,
+                                       double shine) {
+  const double i = LoadingGlowIntensityAt(x, head, above, span);
+  const auto channel = [&](float c) {
+    return static_cast<float>(std::min((c + (1.0 - c) * shine) * i, 1.0));
+  };
+  return {channel(kLoadingGlowColorR), channel(kLoadingGlowColorG),
+          channel(kLoadingGlowColorB), static_cast<float>(std::min(i, 1.0))};
+}
+
+// The same per pixel on the GPU, for cc::PaintShader::MakeSkSLCommand. Its
+// coordinates are the field's own, in DIPs; the colour maths is in sRGB
+// encoding exactly as LoadingGlowAt() does it (where Dia's clip happens), and
+// only the result is handed to the destination's working space -- whichever
+// it is (sRGB, Display P3, linear). ⚠ Not for untagged surfaces: there Skia's
+// colour-space intrinsics do nothing and the output would be the linear
+// values (too dark); cc always rasters into a tagged space. (r1009 first
+// tried detecting untagged surfaces by probing toLinearSrgb(0.5); a linear
+// working space answers the same, reviewer r1009 diff r0.) Uniforms:
+//   u_size        the field, DIPs
+//   u_head        the head's x, DIPs
+//   u_min_above   half a device pixel, DIPs
+//   u_color       C (rgb, sRGB-encoded)
+//   u_k, u_p, u_ramp_start   the constants above
+//   u_ramp_length, u_fade    LoadingGlowSpan's ramp and fade, DIPs
+//   u_fade_floor  kLoadingGlowStartFadeFloor
+//   u_shine_center, u_shine_width (sigma), u_shine_k   the sheen, DIPs
+inline constexpr char kLoadingGlowSkSL[] = R"(
+uniform float2 u_size;
+uniform float u_head;
+uniform float u_min_above;
+uniform float4 u_color;
+uniform float u_k;
+uniform float u_p;
+uniform float u_ramp_start;
+uniform float u_ramp_length;
+uniform float u_fade;
+uniform float u_fade_floor;
+uniform float u_shine_center;
+uniform float u_shine_width;
+uniform float u_shine_k;
+
+float Decode(float c) {
+  return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4);
+}
+
+half4 main(float2 p) {
+  float h = u_size.y;
+  float above = max(h - p.y, u_min_above);
+  float behind = u_head - p.x;
+  float dist = behind >= 0.0 ? above : length(float2(behind, above));
+  float ramp = behind > 0.0 && u_ramp_length > 0.0
+      ? clamp(u_ramp_start - behind / u_ramp_length, 0.0, 1.0)
+      : 1.0;
+  float i = u_k * pow(dist / h, -u_p) * ramp;
+  if (u_fade > 0.0) {
+    i *= mix(u_fade_floor, 1.0, smoothstep(0.0, u_fade, p.x));
+  }
+  float a = min(i, 1.0);
+  if (a <= 0.0) {
+    return half4(0.0);
+  }
+  float3 c = u_color.rgb;
+  if (u_shine_k > 0.0) {
+    float dx = (p.x - u_shine_center) / u_shine_width;
+    c = mix(c, float3(1.0), u_shine_k * exp(-0.5 * dx * dx));
+  }
+  float3 color = min(c * i, float3(1.0)) / a;
+  half3 working =
+      fromLinearSrgb(half3(Decode(color.r), Decode(color.g), Decode(color.b)));
+  return half4(working * half(a), half(a));
+}
+)";
+
+// Where the sheen's centre is, in field widths from the left edge, `elapsed`
+// after the glow appeared -- or nothing while it is too far off either side to
+// change a pixel.
+inline std::optional<double> LoadingGlowShineCenter(base::TimeDelta elapsed) {
+  if (elapsed.is_negative()) {
+    return std::nullopt;
+  }
+  const double sigma = kLoadingGlowShineFwhm / 2.3548;
+  const double reach = kLoadingGlowShineReachSigmas * sigma;
+  const base::TimeDelta in_cycle = elapsed % kLoadingGlowShinePeriod;
+  const double center =
+      (in_cycle - kLoadingGlowShineCross).InSecondsF() * kLoadingGlowShineSpeed;
+  if (center < -reach || center > 1.0 + reach) {
+    return std::nullopt;
+  }
+  return center;
+}
+
+inline double LoadingGlowEaseOutCubic(double t) {
+  const double r = 1.0 - std::clamp(t, 0.0, 1.0);
+  return 1.0 - r * r * r;
+}
+
+// The glow's state machine. The view feeds it the watched tab's events and
+// asks for a Frame on every animation step; nothing here touches a clock.
+class ArcLoadingGlowModel {
+ public:
+  struct Frame {
+    bool visible = false;
+    // Head position, 0..1 of the field's width.
+    double head = 0.0;
+    // Whole-glow alpha (fade in / out).
+    double opacity = 0.0;
+    // The sheen's centre in field widths, when it is on the field.
+    std::optional<double> shine_center;
+  };
+
+  // A load began: the head starts at the field's left edge and heads for the
+  // first progress; the glow fades in; the sheen's cycle starts now. A new
+  // load restarts all of it, mid-animation or not -- the newest owns the glow.
+  void Start(base::TimeTicks now) {
+    state_ = State::kLoading;
+    start_ = now;
+    reveal_ = now;
+    from_ = 0.0;
+    target_ = kLoadingGlowInitialProgress;
+    ease_start_ = now;
+  }
+
+  // Show a load already in flight (the watched tab changed): at its progress,
+  // already faded in -- the tab did not just start loading.
+  void Resume(double progress, base::TimeTicks now) {
+    state_ = State::kLoading;
+    start_ = now - kLoadingGlowFadeIn;
+    reveal_ = start_;
+    from_ = target_ =
+        std::clamp(std::max(progress, kLoadingGlowInitialProgress), 0.0, 1.0);
+    ease_start_ = now;
+  }
+
+  // Load progress only ever moves the head forwards: progress can go back
+  // (a new subframe grows the denominator), a glow that retreats reads as the
+  // page unloading.
+  void Progress(double progress, base::TimeTicks now) {
+    if (state_ != State::kLoading) {
+      return;
+    }
+    progress = std::clamp(progress, 0.0, 1.0);
+    if (progress <= target_) {
+      return;
+    }
+    Retarget(progress, now);
+  }
+
+  // Loading stopped: the head finishes its run to the far end, then the glow
+  // fades.
+  void Stop(base::TimeTicks now) {
+    if (state_ != State::kLoading) {
+      return;
+    }
+    state_ = State::kFinishing;
+    if (target_ < 1.0) {
+      Retarget(1.0, now);
+    }
+  }
+
+  void Hide() { state_ = State::kIdle; }
+
+  // The glow comes back into view mid-load -- the field stopped being edited,
+  // or the new tab page's box handed it back to the band: it fades in again
+  // rather than appearing at full strength.
+  void Reveal(base::TimeTicks now) { reveal_ = now; }
+
+  bool active() const { return state_ != State::kIdle; }
+  // Still loading -- not finishing its run or fading out.
+  bool loading() const { return state_ == State::kLoading; }
+
+  // The glow at `now`. Advances finishing -> fading -> idle as their times
+  // run out, so it is called once per frame, with non-decreasing `now`.
+  Frame Tick(base::TimeTicks now) {
+    Frame frame;
+    if (state_ == State::kIdle) {
+      return frame;
+    }
+    frame.head = HeadAt(now);
+    if (state_ == State::kFinishing && HeadSettled(now)) {
+      state_ = State::kFading;
+      fade_start_ = now;
+    }
+    frame.visible = true;
+    frame.opacity =
+        LoadingGlowEaseOutCubic((now - reveal_) / kLoadingGlowFadeIn);
+    if (state_ == State::kFading) {
+      const double t =
+          std::clamp((now - fade_start_) / kLoadingGlowFadeOut, 0.0, 1.0);
+      frame.opacity *= std::pow(1.0 - t, kLoadingGlowFadeOutExponent);
+      if (t >= 1.0) {
+        state_ = State::kIdle;
+        return Frame();
+      }
+    }
+    frame.shine_center = LoadingGlowShineCenter(now - start_);
+    return frame;
+  }
+
+ private:
+  enum class State { kIdle, kLoading, kFinishing, kFading };
+
+  double HeadAt(base::TimeTicks now) const {
+    const double t = (now - ease_start_) / kLoadingGlowProgressEase;
+    return from_ + (target_ - from_) * LoadingGlowEaseOutCubic(t);
+  }
+
+  bool HeadSettled(base::TimeTicks now) const {
+    return now - ease_start_ >= kLoadingGlowProgressEase;
+  }
+
+  void Retarget(double target, base::TimeTicks now) {
+    from_ = HeadAt(now);
+    target_ = target;
+    ease_start_ = now;
+  }
+
+  State state_ = State::kIdle;
+  base::TimeTicks start_;
+  base::TimeTicks reveal_;
+  base::TimeTicks ease_start_;
+  base::TimeTicks fade_start_;
+  double from_ = 0.0;
+  double target_ = 0.0;
+};
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_LOADING_GLOW_H_
