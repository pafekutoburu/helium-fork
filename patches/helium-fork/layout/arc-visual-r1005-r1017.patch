+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_HELIUM_CARD_SHADOW_PAINTER_H_
+#define CHROME_BROWSER_UI_VIEWS_HELIUM_CARD_SHADOW_PAINTER_H_
+
+#include "base/containers/span.h"
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/helium/arc_sidebar_surface.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/geometry/rect.h"
+
+class SkPath;
+
+namespace gfx {
+class Canvas;
+}
+
+namespace helium {
+
+// helium-fork r1008: every card shadow in the shell, computed on the CPU per
+// device pixel and dithered (helium/arc_card_shadow_field.h on why: Skia's GPU
+// blur downsamples any sigma over 4 device px into an 8-bit texture -- stair-
+// stepped contours -- and nothing dithered its 8-bit rings; the user saw both
+// on the new tab page's box, 「仔细看，有断层」, and asked for the same on the
+// sidebar's cards, 2026-10-07).
+//
+// The images are cut by the card's size so that resizing reuses them: a card
+// wide enough for a straight middle gets a left end, a tile of the middle that
+// repeats (the middle does not depend on x) and the left end mirrored; one
+// tall enough is cut the same way top / middle / bottom; a small one is drawn
+// whole. Cached by everything they depend on, sizes excluded where a middle
+// absorbs them.
+struct CardShadowParams {
+  // The card, in the canvas's coordinates (DIP). The shadow is painted around
+  // it and never inside it.
+  gfx::Rect card;
+  int radius = 0;
+  // A silhouette that is not the round rect (the space icon picker's card
+  // with its tail), in the canvas's coordinates; `card` is then its bounds.
+  raw_ptr<const SkPath> silhouette = nullptr;
+  // How far past the card the shadow may spread (DIP), and the outermost
+  // points of that room across which it eases to zero.
+  int room_h = 0;
+  int room_v = 0;
+  int fade_h = 0;
+  int fade_v = 0;
+  base::span<const SidebarCardShadowPass> passes;
+  // Blur and inset across narrowed by this much (the composer's short room).
+  double across = 1.0;
+  bool dark = false;
+  // What the shadow falls on: the dither's step makes about one display level
+  // of it (ShadowFieldDitherStep).
+  SkColor backdrop = SK_ColorWHITE;
+  // The composer's suggestion popup only: the top `resting_height` of the card
+  // is the resting box, whose shadow the browser window keeps casting -- paint
+  // only what the rest of the card adds, on the dither's complementary
+  // thresholds (see PaintArcOmniboxPanel).
+  int resting_height = 0;
+};
+
+void PaintCardShadow(gfx::Canvas* canvas, const CardShadowParams& params);
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_VIEWS_HELIUM_CARD_SHADOW_PAINTER_H_
