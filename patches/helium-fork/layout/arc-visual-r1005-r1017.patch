+// two side rooms and clips each edge to its own; a centred box gets two equal
+// side rooms, the single value above, and a top room the page's height. The
+// bottom is never crossed.
+struct ArcComposerSideRooms {
+  int left = 0;
+  int right = 0;
+  int top = 0;
