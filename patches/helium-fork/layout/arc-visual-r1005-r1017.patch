--- src.orig/chrome/browser/ui/helium/arc_band_colors_unittest.cc
+++ src/chrome/browser/ui/helium/arc_band_colors_unittest.cc
@@ -110,6 +110,55 @@
   }
 }
 
+// r1013: an icon's hover wash stands the same distance off every page -- the
+// complaint was a dark page in a light app, where the theme's wash was a few
+// levels of grey on black ("不管什么样的背景，都要能特别清晰地看到icon的背景胶囊").
+// Greys, saturated colours and the two field colours; the least alpha that
+// reaches the contrast, in the contrasting direction.
+TEST(ArcBandIconWashTest, ReachesItsContrastOnAnyBackdrop) {
+  std::vector<SkColor> backdrops = {kLightThemeField, kDarkThemeField};
+  backdrops.push_back(SkColorSetRGB(0xEB, 0x0C, 0xC3));  // reviewer r1013
+  for (int v = 0; v <= 255; v += 5) {
+    backdrops.push_back(SkColorSetRGB(v, v, v));
+    backdrops.push_back(SkColorSetRGB(v, 0, 0));
+    backdrops.push_back(SkColorSetRGB(0, v / 2, v));
+    backdrops.push_back(SkColorSetRGB(255 - v, 255, v));
+  }
+  for (const SkColor backdrop : backdrops) {
+    for (const bool pressed : {false, true}) {
+      const SkColor wash = GetBandIconWashColor(backdrop, pressed);
+      const SkColor ink = SkColorSetA(wash, SK_AlphaOPAQUE);
+      const float alpha = SkColorGetA(wash) / 255.0f;
+      const float contrast = color_utils::GetContrastRatio(
+          color_utils::AlphaBlend(ink, backdrop,
+                                  static_cast<SkAlpha>(SkColorGetA(wash))),
+          backdrop);
+      const float want =
+          pressed ? kBandIconPressedContrast : kBandIconHoverContrast;
+      // Exactly, in the alpha it is painted at (reviewer r1013: a 0.01
+      // allowance hid #EB0CC3 pressed at 1.647).
+      EXPECT_GE(contrast, want) << std::hex << backdrop;
+      EXPECT_LE(contrast, want + 0.06f) << std::hex << backdrop;
+      EXPECT_GT(alpha, 0.0f) << std::hex << backdrop;
+      EXPECT_EQ(ink, color_utils::GetColorWithMaxContrast(backdrop))
+          << std::hex << backdrop;
+    }
+  }
+}
+
+// The wash on a black page is light and on a white page dark -- whatever the
+// app's own theme -- and pressing reads stronger than hovering.
+TEST(ArcBandIconWashTest, FollowsThePageNotTheTheme) {
+  EXPECT_FALSE(color_utils::IsDark(SkColorSetA(
+      GetBandIconWashColor(kBlackPage, /*pressed=*/false), SK_AlphaOPAQUE)));
+  EXPECT_TRUE(color_utils::IsDark(SkColorSetA(
+      GetBandIconWashColor(kWhitePage, /*pressed=*/false), SK_AlphaOPAQUE)));
+  for (const SkColor page : {kBlackPage, kWhitePage}) {
+    EXPECT_GT(SkColorGetA(GetBandIconWashColor(page, /*pressed=*/true)),
+              SkColorGetA(GetBandIconWashColor(page, /*pressed=*/false)));
+  }
+}
+
