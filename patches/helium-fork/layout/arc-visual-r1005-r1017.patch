+#ifndef CHROME_BROWSER_UI_VIEWS_LOCATION_BAR_ARC_LOCATION_BAR_GLOW_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_LOCATION_BAR_ARC_LOCATION_BAR_GLOW_VIEW_H_
+
+#include "chrome/browser/ui/helium/arc_loading_glow.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "third_party/skia/include/core/SkRefCnt.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/gfx/animation/linear_animation.h"
+#include "ui/views/animation/animation_delegate_views.h"
+#include "ui/views/view.h"
+
+class PrefService;
+
+namespace cc {
+class PaintCanvas;
+class PaintShader;
+}
+
+struct SkRect;
+
+// helium-fork: the address field's loading glow, Dia's (the model, every
+// number and where they come from: helium/arc_loading_glow.h). It takes the
+// place of upstream's LocationBarProgressView inside LocationBarView -- same
+// two calls, same pref (helium.browser.show_progress_bar), same "not while the
+// field is being edited" -- and paints differently: the whole field lit from
+// its bottom edge rather than a line along it.
+//
+// No layer of its own, and the location bar's first child: it paints into the
+// field before the text and the icons do, so the URL reads on top of the glow
+// as it does in Dia (a layered child would always composite above them).
+//
+// r1007: except in the sidebar row (the hidden address bar mode), where the
+// glow fills the row's whole capsule -- the field and the extension icons
+// alike -- and the row's toolbar paints it, right after the capsule and under
+// both (PaintIntoRow). This view keeps the model, the tab and the clock there,
+// and paints nothing of its own.
+class ArcLocationBarGlowView : public views::View,
+                               public content::WebContentsObserver,
+                               public views::AnimationDelegateViews {
+  METADATA_HEADER(ArcLocationBarGlowView, views::View)
+
+ public:
+  explicit ArcLocationBarGlowView(PrefService* pref_service);
+  ArcLocationBarGlowView(const ArcLocationBarGlowView&) = delete;
+  ArcLocationBarGlowView& operator=(const ArcLocationBarGlowView&) = delete;
+  ~ArcLocationBarGlowView() override;
+
+  // Follows the location bar's tab: a load in flight shows at its progress.
+  void SetWebContents(content::WebContents* contents);
+  // The glow stays off while the field is focused -- it is then an edit field
+  // under the edit panel, not the page's address.
+  void SetLocationBarFocused(bool focused);
+
+  // The sidebar row's toolbar: the glow across `capsule` (its local bounds),
+  // clipped to `radius`. Nothing unless this field is sidebar-hosted.
+  void PaintIntoRow(gfx::Canvas* canvas,
+                    const gfx::Rect& capsule,
+                    float radius) const;
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+  void VisibilityChanged(views::View* starting_from, bool is_visible) override;
+  // The location bar moves between hosts (band, sidebar row, the new tab
+  // page's composer); a load in flight carries on in the new one.
+  void AddedToWidget() override;
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override;
+
+ private:
+  bool IsEnabled() const;
+  void SyncFromWebContents();
+  // Steps the model to now, repaints, and keeps the frame clock running
+  // exactly while the model has something on screen.
+  void Step();
+
+  // The field's corner radius: whatever LocationBarView draws its capsule
+  // with (9 on the Arc band since r1007, the stock pill elsewhere).
+  float GetFieldRadius() const;
+
+  // Whether the field rides in the sidebar row, where its toolbar fills the
+  // whole capsule with the glow instead of the field (PaintIntoRow).
+  bool InRow() const;
+
+  // The current frame across `field`, clipped to `radius`: one SkSL shader
+  // (helium::kLoadingGlowSkSL) over the field, `device_scale` device pixels
+  // to the DIP (the bottom pixel row is a device pixel, as in Dia).
+  void PaintGlow(cc::PaintCanvas* canvas,
+                 const SkRect& field,
+                 float radius,
+                 float device_scale) const;
+
+  // content::WebContentsObserver:
+  void DidStartNavigation(
+      content::NavigationHandle* navigation_handle) override;
+  void LoadProgressChanged(double progress) override;
+  void DidStopLoading() override;
+  void WebContentsDestroyed() override;
+
+  // gfx::AnimationDelegate (via AnimationDelegateViews):
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+  helium::ArcLoadingGlowModel model_;
+  helium::ArcLoadingGlowModel::Frame frame_;
+  // Only a frame clock: its value is never read, Step() asks the model.
+  gfx::LinearAnimation clock_;
+  PrefChangeRegistrar pref_change_registrar_;
+  bool location_bar_focused_ = false;
+  // Whether the last Step() put the glow on screen.
+  bool shown_ = false;
+  // The compiled shader, reused frame to frame (only its uniforms change).
+  mutable sk_sp<cc::PaintShader> shader_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_LOCATION_BAR_ARC_LOCATION_BAR_GLOW_VIEW_H_
