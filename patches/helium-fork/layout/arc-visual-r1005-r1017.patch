+  EXPECT_NEAR(1.0 - after / before, kLoadingGlowShineStrength, 1e-6);
+  EXPECT_NEAR(kLoadingGlowShineStrength, 0.39, 0.02);
+  // The clipped bottom row whitens further than the body (Dia: R 135 -> 215).
+  const LoadingGlowPremul row = DiaAt(150.0, Above(0));
+  const LoadingGlowPremul lit =
