+// helium-fork r1014: where the composer holds the field, if anywhere. The
+// blank new tab's centred box (r8.3) was the composer's only placement; now
+// Cmd+L and a click on the band's capsule open the same box over the band
+// (the user, 2026-10-08: "把 Command + L 的 UI 直接复用空白页的搜索框"), and in
+// the hidden address bar mode it grows from the sidebar's row (r1014b).
+enum class ArcComposerPlacement {
+  // The field stays in its chrome host -- the band or the sidebar row.
+  kNone,
+  // The blank new tab's centred box.
+  kNewTab,
+  // The box over the band's capsule slot, hung from the window's top edge.
+  kBand,
+  // The box grown from the sidebar's address row (r1014b: resolved here,
+  // placed later; until then the row keeps its own edit panel).
+  kRow,
+};
+
+// One total function, like ResolveArcToolbarHost above. The blank new tab
+// outranks an edit (⛔ 08-22: "new tab 只要打开界面就是固定的，不被任何操作所影响"),
+// so a request made on a page is simply forgotten the moment a blank new tab
+// takes the field -- the caller reconciles its flag from the answer, as it does
+// for the sidebar's edit hand-off. `edit_requested` is BrowserView's flag,
+// `field_in_band` the layout's (the docked mode has a band): both facts that
+// stay true across the reparent, unlike "which view holds it this instant".
+inline constexpr ArcComposerPlacement ResolveArcComposerPlacement(
+    bool shell_hosts_field,
+    bool blank_new_tab,
+    bool edit_requested,
+    bool field_in_band) {
+  if (!shell_hosts_field) {
+    return ArcComposerPlacement::kNone;
+  }
+  if (blank_new_tab) {
+    return ArcComposerPlacement::kNewTab;
+  }
+  if (!edit_requested) {
+    return ArcComposerPlacement::kNone;
+  }
+  return field_in_band ? ArcComposerPlacement::kBand
+                       : ArcComposerPlacement::kRow;
+}
