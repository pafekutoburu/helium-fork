+TEST(ArcLoadingGlowModelTest, IdleUntilALoadStarts) {
+  ArcLoadingGlowModel model;
+  EXPECT_FALSE(model.active());
+  EXPECT_FALSE(model.Tick(kT0).visible);
+}
+
+TEST(ArcLoadingGlowModelTest, StartGrowsFromTheLeftEdgeAndFadesIn) {
+  ArcLoadingGlowModel model;
+  model.Start(kT0);
+  const Frame first = model.Tick(kT0);
+  EXPECT_TRUE(first.visible);
+  EXPECT_EQ(first.head, 0.0);
+  EXPECT_EQ(first.opacity, 0.0);
+  // Dia: the front sits on ~10% of the field by ~250ms, fully faded in.
+  const Frame later = model.Tick(kT0 + base::Milliseconds(300));
+  EXPECT_NEAR(later.head, kLoadingGlowInitialProgress, 1e-9);
+  EXPECT_NEAR(later.opacity, 1.0, 1e-9);
+}
+
+TEST(ArcLoadingGlowModelTest, HeadEasesToEachUpdate) {
+  ArcLoadingGlowModel model;
+  model.Start(kT0);
+  model.Tick(kT0 + base::Milliseconds(400));
+  const base::TimeTicks t1 = kT0 + base::Milliseconds(400);
+  model.Progress(0.3, t1);
+  // Half the way in ~50ms, 90% in ~125ms (Dia's 10% -> 30% jump).
+  const double half = model.Tick(t1 + base::Milliseconds(52)).head;
+  const double most = model.Tick(t1 + base::Milliseconds(134)).head;
+  EXPECT_NEAR((half - 0.1) / 0.2, 0.5, 0.05);
+  EXPECT_NEAR((most - 0.1) / 0.2, 0.9, 0.03);
+  EXPECT_NEAR(model.Tick(t1 + base::Milliseconds(250)).head, 0.3, 1e-9);
+}
+
+TEST(ArcLoadingGlowModelTest, RetargetStartsFromWhereTheHeadIs) {
+  ArcLoadingGlowModel model;
+  model.Start(kT0);
+  model.Progress(0.5, kT0);
+  const base::TimeTicks mid = kT0 + base::Milliseconds(60);
+  const double at_mid = model.Tick(mid).head;
+  model.Progress(0.8, mid);
+  // No jump on the retarget: the next frame continues from where it was.
+  EXPECT_NEAR(model.Tick(mid).head, at_mid, 1e-9);
+  EXPECT_GT(model.Tick(mid + base::Milliseconds(16)).head, at_mid);
+}
+
+TEST(ArcLoadingGlowModelTest, ProgressIsARatchet) {
+  ArcLoadingGlowModel model;
+  model.Start(kT0);
+  model.Progress(0.6, kT0);
+  model.Tick(kT0 + base::Seconds(1));
+  model.Progress(0.3, kT0 + base::Seconds(1));
+  EXPECT_NEAR(model.Tick(kT0 + base::Seconds(2)).head, 0.6, 1e-9);
+}
+
+TEST(ArcLoadingGlowModelTest, StopRunsTheHeadOutThenFades) {
+  ArcLoadingGlowModel model;
+  model.Start(kT0);
+  model.Progress(0.4, kT0);
+  const base::TimeTicks stop = kT0 + base::Seconds(1);
+  model.Tick(stop);
+  model.Stop(stop);
+  // The head finishes its run first, still fully lit.
+  const Frame running = model.Tick(stop + base::Milliseconds(100));
+  EXPECT_GT(running.head, 0.4);
+  EXPECT_LT(running.head, 1.0);
+  EXPECT_NEAR(running.opacity, 1.0, 1e-9);
+  const base::TimeTicks arrived = stop + base::Milliseconds(250);
+  const Frame at_end = model.Tick(arrived);
+  EXPECT_NEAR(at_end.head, 1.0, 1e-9);
+  // Then (1 - t)^2.5 over 330ms: half gone at ~70ms, a tenth left at ~210.
+  EXPECT_NEAR(model.Tick(arrived + base::Milliseconds(70)).opacity, 0.55, 0.03);
+  EXPECT_NEAR(model.Tick(arrived + base::Milliseconds(210)).opacity, 0.08,
+              0.02);
+  EXPECT_FALSE(model.Tick(arrived + base::Milliseconds(331)).visible);
+  EXPECT_FALSE(model.active());
+}
+
+TEST(ArcLoadingGlowModelTest, StopAtTheEndFadesStraightAway) {
+  ArcLoadingGlowModel model;
+  model.Start(kT0);
+  model.Progress(1.0, kT0);
+  // Dia's slow load: the glow sat full width for seconds while still
+  // loading -- reaching the end is not finishing.
+  EXPECT_NEAR(model.Tick(kT0 + base::Seconds(5)).opacity, 1.0, 1e-9);
+  model.Stop(kT0 + base::Seconds(5));
+  model.Tick(kT0 + base::Seconds(5));
+  EXPECT_LT(
+      model.Tick(kT0 + base::Seconds(5) + base::Milliseconds(100)).opacity,
+      0.5);
+}
+
+TEST(ArcLoadingGlowModelTest, ANewLoadRestartsTheGlow) {
+  ArcLoadingGlowModel model;
+  model.Start(kT0);
+  model.Progress(0.9, kT0);
+  model.Tick(kT0 + base::Seconds(1));
+  model.Start(kT0 + base::Seconds(1));
+  EXPECT_EQ(model.Tick(kT0 + base::Seconds(1)).head, 0.0);
+}
+
+TEST(ArcLoadingGlowModelTest, ResumeShowsALoadInFlightAsItIs) {
+  ArcLoadingGlowModel model;
+  model.Resume(0.55, kT0);
+  const Frame frame = model.Tick(kT0);
+  EXPECT_NEAR(frame.head, 0.55, 1e-9);
+  EXPECT_NEAR(frame.opacity, 1.0, 1e-9);
+}
+
+TEST(ArcLoadingGlowModelTest, RevealFadesBackIn) {
+  ArcLoadingGlowModel model;
+  model.Start(kT0);
+  model.Progress(0.5, kT0);
+  const base::TimeTicks back = kT0 + base::Seconds(2);
+  model.Reveal(back);
+  const Frame frame = model.Tick(back);
+  EXPECT_EQ(frame.opacity, 0.0);
+  EXPECT_NEAR(frame.head, 0.5, 1e-9);
+  EXPECT_NEAR(model.Tick(back + kLoadingGlowFadeIn).opacity, 1.0, 1e-9);
+}
