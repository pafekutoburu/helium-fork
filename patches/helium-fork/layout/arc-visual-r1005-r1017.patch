+bool BrowserView::CanHostArcComposerEdit() const {
+  // The composer host is this view's child; the toolbar has to be in the same
+  // widget for the field to move between them (the immersive fullscreen
+  // overlay keeps the toolbar in its own widget -- there the band keeps its
+  // own edit panel, the one deliberate fallback).
+  return toolbar_ && arc_composer_host_ && multi_contents_view_ &&
+         toolbar_->GetWidget() && toolbar_->GetWidget() == GetWidget();
+}
+
+bool BrowserView::BeginArcComposerEdit() {
+  if (!CanHostArcComposerEdit() || !toolbar_->location_bar_view()) {
+    return false;
+  }
+  arc_composer_edit_requested_ = true;
+  UpdateArcComposerHost();
+  // The funnel reconciles the flag; if it could not run at all (re-entered,
+  // torn down) the request must not outlive this call either.
+  if (!toolbar_->IsLocationBarInComposer()) {
+    arc_composer_edit_requested_ = false;
+  }
+  return toolbar_->IsLocationBarInComposer();
+}
+
+void BrowserView::EndArcComposerEdit() {
+  if (!arc_composer_edit_requested_) {
+    return;
+  }
+  arc_composer_edit_requested_ = false;
+  UpdateArcComposerHost();
+}
+
+helium::ArcComposerPlacement BrowserView::GetArcComposerPlacement() const {
+  return arc_composer_host_ && toolbar_ && toolbar_->IsLocationBarInComposer()
+             ? arc_composer_host_->placement()
+             : helium::ArcComposerPlacement::kNone;
+}
+
+gfx::Rect BrowserView::ComputeArcComposerBandBox() const {
+  if (!toolbar_ || !top_container_ || toolbar_->parent() != top_container_) {
+    return gfx::Rect();
+  }
+  gfx::RectF slot_f(toolbar_->GetArcFieldSlot());
+  views::View::ConvertRectToTarget(toolbar_, this, &slot_f);
+  gfx::RectF band_f((gfx::SizeF(top_container_->size())));
+  views::View::ConvertRectToTarget(top_container_, this, &band_f);
+  return helium::ArcComposerBandBounds(gfx::ToEnclosingRect(band_f),
+                                       gfx::ToEnclosingRect(slot_f),
+                                       MultiContentsView::kContentCardInset);
+}
+
+void BrowserView::RecoverArcComposerEdit() {
+  if (!arc_composer_edit_requested_) {
+    return;
+  }
+  if (LocationBarView* const location_bar =
+          toolbar_ ? toolbar_->location_bar_view() : nullptr) {
+    location_bar->EndArcFieldEditing();
+  }
+  EndArcComposerEdit();
+}
