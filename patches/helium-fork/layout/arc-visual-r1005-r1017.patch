+#include "chrome/browser/ui/views/frame/helium_card_nine_patch_shadow_view.h"
+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+#include "base/numerics/safe_conversions.h"
+#include "cc/paint/paint_canvas.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "third_party/skia/include/core/SkClipOp.h"
+#include "third_party/skia/include/core/SkRRect.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_provider.h"
+#include "ui/compositor/layer.h"
+#include "ui/compositor/layer_nine_patch.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/gfx/geometry/skia_conversions.h"
+#include "ui/gfx/image/canvas_image_source.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/skia_paint_util.h"
+
+namespace {
+
+// The blur sigma gfx::CreateShadowDrawLooper() turns a shadow value into
+// (ui/gfx/skia_paint_util.cc: RadiusToSigma(blur / 2)).
+double SigmaFor(const gfx::ShadowValue& value) {
+  const double radius = value.blur() / 2.0;
+  return radius > 0 ? 0.288675 * radius + 0.5 : 0.0;
+}
+
+SkColor BlackWithAlpha(double alpha) {
+  return SkColorSetARGB(base::ClampRound<U8CPU>(255.0 * alpha), 0, 0, 0);
+}
+
+// The nine-patch image: the card's rounded rect, `reach` from the image's
+// edges, its shadows drawn around it and the rect itself left clear.
+class CardShadowImageSource : public gfx::CanvasImageSource {
+ public:
+  CardShadowImageSource(gfx::ShadowValues values,
+                        const gfx::Insets& reach,
+                        int radius)
+      : gfx::CanvasImageSource(gfx::Size(reach.width() + 2 * radius + 1,
+                                         reach.height() + 2 * radius + 1)),
+        values_(std::move(values)),
+        reach_(reach),
+        radius_(radius) {}
+
+  // gfx::CanvasImageSource:
+  void Draw(gfx::Canvas* canvas) override {
+    gfx::Rect content(size());
+    content.Inset(reach_);
+    const SkRRect rrect =
+        SkRRect::MakeRectXY(gfx::RectToSkRect(content), radius_, radius_);
+    canvas->sk_canvas()->clipRRect(rrect, SkClipOp::kDifference,
+                                   /*do_anti_alias=*/true);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SK_ColorTRANSPARENT);
+    flags.setLooper(gfx::CreateShadowDrawLooper(values_));
+    canvas->sk_canvas()->drawRRect(rrect, flags);
+  }
+
+ private:
+  const gfx::ShadowValues values_;
+  const gfx::Insets reach_;
+  const int radius_;
+};
+
+}  // namespace
+
+HeliumCardNinePatchShadowView::HeliumCardNinePatchShadowView(int elevation,
+                                                             ShadowAlpha alpha)
+    : elevation_(elevation), alpha_(alpha) {
+  SetCanProcessEventsWithinSubtree(false);
+}
+
+HeliumCardNinePatchShadowView::~HeliumCardNinePatchShadowView() = default;
+
+// static
+gfx::Insets HeliumCardNinePatchShadowView::GetReach(
+    const gfx::ShadowValues& values) {
+  int top = 0;
+  int left = 0;
+  int bottom = 0;
+  int right = 0;
+  for (const gfx::ShadowValue& value : values) {
+    const double extent = 3.0 * SigmaFor(value);
+    top = std::max(top, base::ClampCeil(extent - value.y()));
+    bottom = std::max(bottom, base::ClampCeil(extent + value.y()));
+    left = std::max(left, base::ClampCeil(extent - value.x()));
+    right = std::max(right, base::ClampCeil(extent + value.x()));
+  }
+  return gfx::Insets::TLBR(top, left, bottom, right);
+}
+
+void HeliumCardNinePatchShadowView::SetShadowVisible(bool visible) {
+  if (visible == !!shadow_layer_) {
+    return;
+  }
+  if (!visible) {
+    observation_.Reset();
+    RemoveLayerFromRegions(shadow_layer_.get());
+    shadow_layer_.reset();
+    DestroyLayer();
+    was_dark_.reset();
+    return;
+  }
+  if (!layer()) {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+  }
+  shadow_layer_ = std::make_unique<ui::LayerNinePatch>();
+  shadow_layer_->SetName("HeliumCardNinePatchShadow");
+  shadow_layer_->SetFillsBoundsOpaquely(false);
+  AddLayerToRegion(shadow_layer_.get(), views::LayerRegion::kBelow);
+  observation_.Observe(this);
+  UpdateImage();
+}
+
+void HeliumCardNinePatchShadowView::SetShadowCornerRadius(int corner_radius) {
+  if (corner_radius_ == corner_radius) {
+    return;
+  }
+  corner_radius_ = corner_radius;
+  UpdateImage();
+}
+
+void HeliumCardNinePatchShadowView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  if (shadow_layer_ && was_dark_ != IsDark()) {
+    UpdateImage();
+  }
+}
+
+void HeliumCardNinePatchShadowView::OnViewLayerBoundsSet(
+    views::View* observed_view) {
+  UpdateLayerBounds();
+}
+
+bool HeliumCardNinePatchShadowView::IsDark() const {
+  const ui::ColorProvider* const provider = GetColorProvider();
+  return provider && color_utils::IsDark(provider->GetColor(kColorToolbar));
+}
+
+gfx::ShadowValues HeliumCardNinePatchShadowView::Values(bool dark) const {
+  return gfx::ShadowValue::MakeMdShadowValues(
+      elevation_, BlackWithAlpha(dark ? alpha_.dark_key : alpha_.light_key),
+      BlackWithAlpha(dark ? alpha_.dark_ambient : alpha_.light_ambient));
+}
+
+void HeliumCardNinePatchShadowView::UpdateImage() {
+  if (!shadow_layer_ || !GetColorProvider()) {
+    return;
+  }
+  const bool dark = IsDark();
+  was_dark_ = dark;
+  gfx::ShadowValues values = Values(dark);
+  reach_ = GetReach(values);
+  const int radius = std::max(0, corner_radius_);
+  auto source = std::make_unique<CardShadowImageSource>(std::move(values),
+                                                        reach_, radius);
+  const gfx::Size image_size = source->size();
+  shadow_layer_->UpdateNinePatchLayerImage(
+      gfx::ImageSkia(std::move(source), image_size));
+  // The grid, as ui::Shadow lays it: the corners and edges are the shadow
+  // plus the card's corner, the centre is the one clear pixel.
+  const gfx::Insets aperture_insets = reach_ + gfx::Insets(radius);
+  gfx::Rect aperture(image_size);
+  aperture.Inset(aperture_insets);
+  shadow_layer_->UpdateNinePatchLayerAperture(aperture);
+  shadow_layer_->UpdateNinePatchLayerBorder(
+      gfx::Rect(aperture_insets.left(), aperture_insets.top(),
+                aperture_insets.width(), aperture_insets.height()));
+  UpdateLayerBounds();
+}
+
+void HeliumCardNinePatchShadowView::UpdateLayerBounds() {
+  if (!shadow_layer_ || !layer()) {
+    return;
+  }
+  const gfx::Rect content = layer()->bounds();
+  const int radius = std::max(0, corner_radius_);
+  if (content.width() < 2 * radius + 1 || content.height() < 2 * radius + 1) {
+    shadow_layer_->SetBounds(gfx::Rect());
+    return;
+  }
+  gfx::Rect bounds = content;
+  bounds.Inset(-reach_);
+  shadow_layer_->SetBounds(bounds);
+  // Nothing under the card needs filling: it is opaque.
+  gfx::Rect occlusion(bounds.size());
+  occlusion.Inset(reach_ + gfx::Insets(radius));
+  shadow_layer_->UpdateNinePatchOcclusion(occlusion);
+}
+
+BEGIN_METADATA(HeliumCardNinePatchShadowView)
+END_METADATA
