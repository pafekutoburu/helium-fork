+#include "chrome/browser/ui/helium/arc_card_shadow_field.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <tuple>
+#include <utility>
+#include <vector>
+
+#include "chrome/browser/ui/helium/arc_composer.h"
+#include "chrome/browser/ui/helium/arc_sidebar_surface.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+// The blurred coverage by brute force: the round rect sampled on a fine grid
+// and convolved with the Gaussian directly.
+double BruteCoverage(const ShadowFieldBox& box,
+                     double sigma_x,
+                     double sigma_y,
+                     double x,
+                     double y) {
+  constexpr double kStep = 0.25;
+  const double r = box.radius;
+  double total = 0;
+  for (double v = box.y0 + kStep / 2; v < box.y1; v += kStep) {
+    for (double u = box.x0 + kStep / 2; u < box.x1; u += kStep) {
+      // Outside the corner arcs?
+      const double cx = std::clamp(u, box.x0 + r, box.x1 - r);
+      const double cy = std::clamp(v, box.y0 + r, box.y1 - r);
+      if ((u - cx) * (u - cx) + (v - cy) * (v - cy) > r * r) {
+        continue;
+      }
+      const double dx = (x - u) / sigma_x;
+      const double dy = (y - v) / sigma_y;
+      total += std::exp(-0.5 * (dx * dx + dy * dy));
+    }
+  }
+  return total * kStep * kStep / (2 * M_PI * sigma_x * sigma_y);
+}
+
+double FieldAt(const ShadowFieldBox& box,
+               double sigma_x,
+               double sigma_y,
+               int x,
+               int y) {
+  std::vector<float> out;
+  ShadowFieldCoverage(box, sigma_x, sigma_y, x, 1, y, 1, &out);
+  return out[0];
+}
+
+// The strips reproduce the blurred round rect: at the corner, beside it,
+// above it and inside, for the composer's tightest and widest passes at 2x.
+TEST(ArcCardShadowFieldTest, CoverageMatchesBruteForce) {
+  const ShadowFieldBox box{.x0 = 100, .y0 = 100, .x1 = 400, .y1 = 214,
+                           .radius = 40};
+  for (const auto [sx, sy] : {std::pair{12.0, 12.0}, std::pair{48.0, 48.0},
+                              std::pair{12.0, 30.0}}) {
+    for (const auto [x, y] : {std::pair{80, 80}, std::pair{100, 100},
+                              std::pair{110, 108}, std::pair{60, 157},
+                              std::pair{250, 70}, std::pair{250, 240},
+                              std::pair{90, 230}, std::pair{250, 157}}) {
+      SCOPED_TRACE(testing::Message() << "sigma " << sx << "," << sy << " at "
+                                      << x << "," << y);
+      EXPECT_NEAR(FieldAt(box, sx, sy, x, y),
+                  BruteCoverage(box, sx, sy, x + 0.5, y + 0.5), 1.5e-3);
+    }
+  }
+}
+
+// A square-cornered rect is exactly the product of two erf differences.
+TEST(ArcCardShadowFieldTest, SharpRectIsSeparable) {
+  const ShadowFieldBox box{.x0 = 20, .y0 = 30, .x1 = 220, .y1 = 90,
+                           .radius = 0};
+  for (int x : {0, 20, 60, 230}) {
+    for (int y : {0, 31, 60, 120}) {
+      const double want = ShadowFieldSpan(20, 220, x + 0.5, 9.0) *
+                          ShadowFieldSpan(30, 90, y + 0.5, 14.0);
+      EXPECT_NEAR(FieldAt(box, 9.0, 14.0, x, y), want, 1e-6);
+    }
+  }
+}
+
+// Every pass is symmetric about the card's centre line -- what lets the
+// painter mirror the left end for the right.
+TEST(ArcCardShadowFieldTest, SymmetricAboutTheCentreLine) {
+  const ShadowFieldBox box{.x0 = 50, .y0 = 50, .x1 = 350, .y1 = 164,
+                           .radius = 40};
+  const std::vector<ShadowFieldPass> passes =
+      ComposerShadowFieldPasses(2.0, 1.0, /*dark=*/false);
+  std::vector<float> field;
+  ShadowFieldTransmittance(box, passes, 0, 400, 0, 214, &field);
+  for (int y : {10, 50, 100, 170, 200}) {
+    for (int x : {0, 30, 49, 120}) {
+      EXPECT_NEAR(field[y * 400 + x], field[y * 400 + (399 - x)], 1e-6);
+    }
+  }
+}
+
+// Past the end reach every column is the middle profile, which is what lets
+// the painter tile the middle from one column.
+TEST(ArcCardShadowFieldTest, MiddleIsTheOneColumnProfile) {
+  const std::vector<ShadowFieldPass> passes =
+      ComposerShadowFieldPasses(2.0, 1.0, /*dark=*/false);
+  const ShadowFieldBox box{.x0 = 112, .y0 = 112, .x1 = 1414, .y1 = 226,
+                           .radius = 40};
+  const int reach =
+      static_cast<int>(std::ceil(box.x0 + ShadowFieldEndReach(box, passes)));
+  std::vector<float> columns;
+  ShadowFieldTransmittance(box, passes, reach, 4, 0, 338, &columns);
+  std::vector<float> middle;
+  ShadowFieldMiddleTransmittance(box, passes, 0, 338, &middle);
+  for (int y = 0; y < 338; ++y) {
+    for (int i = 0; i < 4; ++i) {
+      EXPECT_NEAR(columns[y * 4 + i], middle[y], 1e-5) << "y=" << y;
+    }
+  }
+}
+
+// The popup's part over the box's: composited source-over, the two give the
+// whole card's shadow, and the part is never negative. Above the box the
+// taller card adds next to nothing -- the box's shadow there is unchanged.
+TEST(ArcCardShadowFieldTest, DifferentialCompositesToTheWholeCard) {
+  const std::vector<ShadowFieldPass> passes =
+      ComposerShadowFieldPasses(2.0, 1.0, /*dark=*/false);
+  const ShadowFieldBox card{.x0 = 112, .y0 = 112, .x1 = 900, .y1 = 600,
+                            .radius = 40};
+  ShadowFieldBox box = card;
+  box.y1 = card.y0 + 114;
+  std::vector<float> whole;
+  std::vector<float> under;
+  ShadowFieldTransmittance(card, passes, 0, 400, 0, 712, &whole);
+  ShadowFieldTransmittance(box, passes, 0, 400, 0, 712, &under);
+  for (size_t p = 0; p < whole.size(); ++p) {
+    const float part = ShadowFieldDifferential(whole[p], under[p]);
+    ASSERT_GE(part, 0.0f);
+    const float box_alpha = 1.0f - under[p];
+    EXPECT_NEAR(box_alpha + part * (1.0f - box_alpha), 1.0f - whole[p], 1e-5);
+  }
+  // Straight above the box, mid-width: the taller card's halo tail adds under
+  // a quarter of a level -- what a taller card's shadow is, dithered to a few
+  // dots.
+  for (int y = 0; y < 112; ++y) {
+    EXPECT_LT(
+        ShadowFieldDifferential(whole[y * 400 + 399], under[y * 400 + 399]),
+        0.25f / 255);
+  }
+}
+
+// The look the user approved at r1007 stays: at the box's side and below it,
+// the light alphas darken a white page by the levels measured then (13 beside,
+// 20 below, off the GPU's approximation) give or take two.
+TEST(ArcCardShadowFieldTest, ComposerDepthIsTheApprovedOne) {
+  const std::vector<ShadowFieldPass> passes =
+      ComposerShadowFieldPasses(2.0, 1.0, /*dark=*/false);
+  // A 651x57pt box at 2x in a 56pt room.
+  const ShadowFieldBox box{.x0 = 112, .y0 = 112, .x1 = 1414, .y1 = 226,
+                           .radius = 40};
+  std::vector<float> beside;
+  ShadowFieldTransmittance(box, passes, 111, 1, 169, 1, &beside);
+  std::vector<float> below;
+  ShadowFieldTransmittance(box, passes, 763, 1, 226, 1, &below);
+  EXPECT_NEAR((1 - beside[0]) * 255, 14, 2);
+  EXPECT_NEAR((1 - below[0]) * 255, 20, 2);
+  // And at the edge of the room it is a fraction of a level before the fade.
+  std::vector<float> far;
+  ShadowFieldTransmittance(box, passes, 0, 1, 169, 1, &far);
+  EXPECT_LT((1 - far[0]) * 255, 0.25);
+}
+
+// The dither: zero stays zero (no dots past the shadow's end), its 8x8 mean is
+// the true value, and on a dark page it steps in multiples of the level that
+// page can show.
+TEST(ArcCardShadowFieldTest, DitherKeepsTheMeanAndZero) {
+  for (int y = 0; y < 8; ++y) {
+    for (int x = 0; x < 8; ++x) {
+      EXPECT_EQ(ShadowFieldDither(0.0, x, y, 1), 0);
+      EXPECT_EQ(ShadowFieldDither(0.0, x, y, 7), 0);
+    }
+  }
+  for (double levels : {0.1, 0.5, 3.3, 12.75, 19.9}) {
+    for (int step : {1, 7}) {
+      double sum = 0;
+      for (int y = 0; y < 8; ++y) {
+        for (int x = 0; x < 8; ++x) {
+          const int q = ShadowFieldDither(levels / 255.0, x, y, step);
+          EXPECT_EQ(q % step, 0);
+          sum += q;
+        }
+      }
+      SCOPED_TRACE(testing::Message() << levels << " levels, step " << step);
+      EXPECT_NEAR(sum / 64, levels, step / 64.0 + 1e-9);
+    }
+  }
+  // White and near-white pages dither in single levels, dark ones in several.
+  EXPECT_EQ(ShadowFieldDitherStep(SK_ColorWHITE), 1);
+  EXPECT_EQ(ShadowFieldDitherStep(SkColorSetRGB(248, 247, 247)), 1);
+  EXPECT_EQ(ShadowFieldDitherStep(SkColorSetRGB(32, 33, 36)), 7);
+  EXPECT_EQ(ShadowFieldDitherStep(SK_ColorBLACK), 16);
+}
+
+// A shape given as a coverage raster (the icon picker's card with its tail)
+// becomes strips that blur like the analytic shape: here a round rect
+// rasterised with 16x16 supersampling, against the strips of the same rect.
+TEST(ArcCardShadowFieldTest, CoverageRasterBlursLikeTheShape) {
+  const ShadowFieldBox box{.x0 = 20.3, .y0 = 30.6, .x1 = 140.7, .y1 = 98.2,
+                           .radius = 18};
+  constexpr int kW = 160;
+  constexpr int kH = 130;
+  std::vector<uint8_t> raster(kW * kH);
+  for (int j = 0; j < kH; ++j) {
+    for (int i = 0; i < kW; ++i) {
+      int inside = 0;
+      for (int sy = 0; sy < 16; ++sy) {
+        for (int sx = 0; sx < 16; ++sx) {
+          const double x = i + (sx + 0.5) / 16;
+          const double y = j + (sy + 0.5) / 16;
+          const double cx = std::clamp(x, box.x0 + box.radius, box.x1 - box.radius);
+          const double cy = std::clamp(y, box.y0 + box.radius, box.y1 - box.radius);
+          inside += x >= box.x0 && x < box.x1 && y >= box.y0 && y < box.y1 &&
+                    (x - cx) * (x - cx) + (y - cy) * (y - cy) <=
+                        box.radius * box.radius;
+        }
+      }
+      raster[j * kW + i] = static_cast<uint8_t>(std::lround(inside * 255.0 / 256));
+    }
+  }
+  const std::vector<ShadowFieldStrip> strips =
+      ShadowFieldStripsFromCoverage(raster.data(), kW, kH, kW, 0, 0);
+  // The straight middle is one strip, not 31 rows of it.
+  EXPECT_LT(strips.size(), 2u * 20 + 4);
+  // At 4px -- narrower than any pass at 2x (the tightest is 9px) -- the
+  // raster's pixel-level shape still shows a little; at real sigmas it does
+  // not. Either way, times a pass's alpha, under a fifth of a level.
+  for (const auto [sx, sy, tolerance] :
+       {std::tuple{4.0, 4.0, 0.03f}, std::tuple{9.0, 15.0, 0.01f}}) {
+    std::vector<float> from_raster;
+    std::vector<float> analytic;
+    ShadowFieldStripsCoverage(strips, sx, sy, 0, kW, 0, kH, &from_raster);
+    ShadowFieldCoverage(box, sx, sy, 0, kW, 0, kH, &analytic);
+    float worst = 0;
+    for (size_t p = 0; p < analytic.size(); ++p) {
+      worst = std::max(worst, std::abs(from_raster[p] - analytic[p]));
+    }
+    SCOPED_TRACE(testing::Message() << "sigma " << sx << "," << sy);
+    EXPECT_LT(worst, tolerance);
+  }
+  // A pass of a silhouette: moved down and squeezed about its middle.
+  const std::vector<ShadowFieldStrip> moved =
+      ShadowFieldStripsMoved(strips, 80.5, 0.5, 3.0);
+  ASSERT_EQ(moved.size(), strips.size());
+  EXPECT_DOUBLE_EQ(moved[0].v0, strips[0].v0 + 3.0);
+  EXPECT_DOUBLE_EQ(moved[0].u0, 80.5 + (strips[0].u0 - 80.5) * 0.5);
+}
+
+// The box's side margin is the shadow's room, so the two cannot drift.
+TEST(ArcCardShadowFieldTest, TheBoxKeepsTheShadowsRoom) {
+  EXPECT_EQ(kArcComposerShadowRoom, kComposerCardShadowSpec.outset_h);
+}
+
