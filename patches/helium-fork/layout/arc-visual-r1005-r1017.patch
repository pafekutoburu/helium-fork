+TEST(ArcLoadingGlowShapeTest, SheenMixesTheColourNotTheAlpha) {
+  const LoadingGlowPremul plain = DiaAt(100.0, Above(20));
+  const LoadingGlowPremul shone =
+      DiaAt(100.0, Above(20), kLoadingGlowShineStrength);
+  EXPECT_EQ(plain.a, shone.a);
+  // Dia: 0.39 of a body row's darkness over white taken off at the sheen's
