+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_HELIUM_CARD_NINE_PATCH_SHADOW_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_HELIUM_CARD_NINE_PATCH_SHADOW_VIEW_H_
+
+#include <memory>
+#include <optional>
+
+#include "base/scoped_observation.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/shadow_value.h"
+#include "ui/views/view.h"
+#include "ui/views/view_observer.h"
+
+namespace ui {
+class LayerNinePatch;
+}
+
+// helium-fork: the content card's shadow. The same Material elevation
+// ShadowFrameView draws (key + ambient, MakeMdShadowValues), the same cheap
+// nine-patch layer under the card -- but the nine-patch reaches as far as the
+// blur does. ui::Shadow sizes both its image and its layer by
+// gfx::ShadowValue::GetMargin(), half the blur, which for a small elevation
+// stops short of the gaussian: at elevation 1 the band above the card ended
+// one point out while still 5 levels dark (L226 on an L231 sidebar), a hard
+// hairline along the card's top (user 2026-10-05: 「…有阴影/投影的卡片背景，
+// 都要处理好，处理得很细腻」). Here the margin is three sigmas past each
+// shadow's own edge, where it is under a quarter of a level.
+//
+// The view itself is the card's rectangle (it paints nothing); the nine-patch
+// lives in the region below its layer, as views::ViewShadow places
+// ui::Shadow's.
+class HeliumCardNinePatchShadowView : public views::View,
+                                      public views::ViewObserver {
+  METADATA_HEADER(HeliumCardNinePatchShadowView, views::View)
+
+ public:
+  // Alphas of the key and ambient shadows, light and dark theme.
+  struct ShadowAlpha {
+    double light_key;
+    double light_ambient;
+    double dark_key;
+    double dark_ambient;
+  };
+
+  HeliumCardNinePatchShadowView(int elevation, ShadowAlpha alpha);
+  HeliumCardNinePatchShadowView(const HeliumCardNinePatchShadowView&) = delete;
+  HeliumCardNinePatchShadowView& operator=(
+      const HeliumCardNinePatchShadowView&) = delete;
+  ~HeliumCardNinePatchShadowView() override;
+
+  // ShadowFrameView's two knobs, which this replaces for the card.
+  void SetShadowVisible(bool visible);
+  void SetShadowCornerRadius(int corner_radius);
+
+  // How far past the card each side of the shadow is drawn: three sigmas
+  // beyond where each shadow's own blurred edge sits.
+  static gfx::Insets GetReach(const gfx::ShadowValues& values);
+
+  // views::View:
+  void OnThemeChanged() override;
+
+ private:
+  // views::ViewObserver:
+  void OnViewLayerBoundsSet(views::View* observed_view) override;
+
+  bool IsDark() const;
+  gfx::ShadowValues Values(bool dark) const;
+  void UpdateImage();
+  void UpdateLayerBounds();
+
+  const int elevation_;
+  const ShadowAlpha alpha_;
+  int corner_radius_ = 0;
+  std::optional<bool> was_dark_;
+  gfx::Insets reach_;
+  std::unique_ptr<ui::LayerNinePatch> shadow_layer_;
+  base::ScopedObservation<views::View, views::ViewObserver> observation_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_HELIUM_CARD_NINE_PATCH_SHADOW_VIEW_H_
