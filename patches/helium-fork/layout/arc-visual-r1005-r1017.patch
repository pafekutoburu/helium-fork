+// r1010: ours, not Dia's -- the glow fades in from the field's leading edge
+// over one field height, smoothly at both ends, and leaves the rest alone.
+// r1011: from half strength, not from nothing ("淡入的效果有点太过了…可以它淡入
+// 不是0开始，从30%或50%开始试一下"); r1012: 0.4, the wrong way; r1013: 0.65
+// ("在50%的基础上再往上走，试试65%的亮度"), then 0.55 ("光带起点改为55%").
+TEST(ArcLoadingGlowShapeTest, StartFadesInOverOneFieldHeight) {
+  EXPECT_EQ(0.55, kLoadingGlowStartFadeFloor);
+  const LoadingGlowSpan span = LoadingGlowBandSpan(kField);
+  EXPECT_EQ(kField, span.fade);
+  const double head = 200.0;
+  const double full = LoadingGlowIntensityAt(100.0, head, Above(5), span);
+  const auto at = [&](double x) {
+    // Taken out the ramp's share, which changes with x as well.
+    LoadingGlowSpan no_fade = span;
+    no_fade.fade = 0.0;
+    return LoadingGlowIntensityAt(x, head, Above(5), span) /
+           LoadingGlowIntensityAt(x, head, Above(5), no_fade);
+  };
+  EXPECT_NEAR(at(0.0), kLoadingGlowStartFadeFloor, 1e-9);
+  EXPECT_NEAR(at(kField / 2),
+              kLoadingGlowStartFadeFloor + (1 - kLoadingGlowStartFadeFloor) / 2,
+              1e-9);
+  EXPECT_NEAR(at(kField), 1.0, 1e-9);
+  EXPECT_NEAR(at(3 * kField), 1.0, 1e-9);
+  // Flat out of the corner, at the floor.
+  EXPECT_NEAR(at(1.0), kLoadingGlowStartFadeFloor, 0.01);
+  EXPECT_GT(full, 0.0);
+  // The body still fills the capsule's end: a row of it at the very start is
+  // the floor's share of what it is a field height in, not gone (r1010 had it
+  // at 0 -- the "掐掉了一段" the user saw).
+  EXPECT_GT(LoadingGlowAt(0.25, head, Above(10), span, 0.0).a,
+            0.35f * LoadingGlowAt(kField, head, Above(10), span, 0.0).a);
+  // The clipped bottom line still comes back only some way in -- it does not
+  // start at full strength in the capsule's corner (r1013: 0.92 at 4.5pt from
+  // 0.65, less from 0.55). The body above it fades in as well.
+  EXPECT_LT(LoadingGlowAt(4.5, head, Above(0), span, 0.0).a, 1.0f);
+  EXPECT_EQ(LoadingGlowAt(2 * kField, head, Above(0), span, 0.0).a, 1.0f);
+  EXPECT_LT(LoadingGlowAt(0.25, head, Above(10), span, 0.0).a,
+            LoadingGlowAt(kField, head, Above(10), span, 0.0).a);
+}
+
+// r1010: the sidebar row's capsule fades behind the head over the same share
+// of its width as Dia's field does -- so its glow dims along its length and
+// over the load the way the band's does, the distance shorter, the effect the
+// same ("虽然距离变短了，但是出来的效果要保持一致"). The band keeps Dia's own.
+TEST(ArcLoadingGlowShapeTest, RowFadesOverItsWidthAsDiasFieldDoes) {
+  EXPECT_EQ(kLoadingGlowRampLength * kField, LoadingGlowBandSpan(kField).ramp);
+  EXPECT_NEAR(kLoadingGlowRowRampShare, 0.922, 0.001);
+  const double dia_w = kLoadingGlowDiaFieldWidth;
+  const LoadingGlowSpan dia = LoadingGlowBandSpan(kField);
+  for (double row_w : {220.0, 300.0, 388.0}) {
+    SCOPED_TRACE(testing::Message() << "row " << row_w);
+    const LoadingGlowSpan row = LoadingGlowRowSpan(row_w, 34.0);
+    for (double share : {0.1, 0.4, 0.8}) {
+      // The same fraction of the way back, the same fade: compare the ramp
+      // alone, at a height where the two fields' vertical profiles agree.
+      const double r_row =
+          LoadingGlowIntensityAt(2000.0 - share * row_w, 2000.0, 17.0, row) /
+          LoadingGlowIntensityAt(2000.0, 2000.0, 17.0, row);
+      const double r_dia =
+          LoadingGlowIntensityAt(2000.0 - share * dia_w, 2000.0, 15.0, dia) /
+          LoadingGlowIntensityAt(2000.0, 2000.0, 15.0, dia);
+      EXPECT_NEAR(r_row, r_dia, 1e-9);
+    }
+  }
+  // r1009's row (33.5 of its 34pt heights) stayed at 0.77+ across a 300pt
+  // capsule; now the far end is nearly out.
+  const LoadingGlowSpan row = LoadingGlowRowSpan(300.0, 34.0);
+  EXPECT_LT(LoadingGlowIntensityAt(2000.0 - 270.0, 2000.0, 17.0, row) /
+                LoadingGlowIntensityAt(2000.0, 2000.0, 17.0, row),
+            0.15);
+}
+
+// The GPU path is the same function: run the SkSL on Skia's CPU backend into
+// float surfaces tagged sRGB, Display P3 and linear sRGB, and compare each
+// pixel with the reference colour drawn by Skia itself into the same space --
+// so the shader's hand-over to the working space is Skia's own conversion.
+TEST(ArcLoadingGlowShapeTest, ShaderIsTheSameFunction) {
+  auto [effect, error] =
+      SkRuntimeEffect::MakeForShader(SkString(kLoadingGlowSkSL));
+  ASSERT_TRUE(effect) << error.c_str();
+  constexpr int kW = 120;
+  constexpr int kH = 30;  // a 15pt field at 2x: one device pixel = 0.5
+  constexpr float kScale = 2.0f;
+  const float head = 40.0f;
+  const float shine_center = 20.0f;
+  const float shine_width = 10.0f;
+  // Both spans: the band's (the start fade across the first 15pt) and the
+  // row's, whose ramp is short enough to show across 60pt.
+  const LoadingGlowSpan spans[] = {
+      LoadingGlowBandSpan(kH / kScale),
+      LoadingGlowRowSpan(kW / kScale, kH / kScale)};
+  const sk_sp<SkColorSpace> spaces[] = {
+      SkColorSpace::MakeSRGB(),
+      SkColorSpace::MakeRGB(SkNamedTransferFn::kSRGB, SkNamedGamut::kDisplayP3),
+      SkColorSpace::MakeSRGBLinear()};
+  const char* const kNames[] = {"sRGB", "Display P3", "linear sRGB"};
+  for (size_t n = 0; n < std::size(spaces) * std::size(spans); ++n) {
+    const size_t s = n % std::size(spaces);
+    const LoadingGlowSpan& span = spans[n / std::size(spaces)];
+    SCOPED_TRACE(testing::Message()
+                 << kNames[s] << (n < std::size(spaces) ? " band" : " row"));
+    SkRuntimeShaderBuilder builder(effect);
+    builder.uniform("u_size") = SkV2{kW / kScale, kH / kScale};
+    builder.uniform("u_head") = head;
+    builder.uniform("u_min_above") = 0.5f / kScale;
+    builder.uniform("u_color") =
+        SkV4{kLoadingGlowColorR, kLoadingGlowColorG, kLoadingGlowColorB, 1.0f};
+    builder.uniform("u_k") = static_cast<float>(kLoadingGlowIntensity);
+    builder.uniform("u_p") = static_cast<float>(kLoadingGlowFalloff);
+    builder.uniform("u_ramp_start") =
+        static_cast<float>(kLoadingGlowRampStart);
+    builder.uniform("u_ramp_length") = static_cast<float>(span.ramp);
+    builder.uniform("u_fade") = static_cast<float>(span.fade);
+    builder.uniform("u_fade_floor") =
+        static_cast<float>(kLoadingGlowStartFadeFloor);
+    builder.uniform("u_shine_center") = shine_center;
+    builder.uniform("u_shine_width") = shine_width;
+    builder.uniform("u_shine_k") =
+        static_cast<float>(kLoadingGlowShineStrength);
+    const SkImageInfo info = SkImageInfo::Make(
+        kW, kH, kRGBA_F32_SkColorType, kPremul_SkAlphaType, spaces[s]);
+    SkBitmap glow;
+    glow.allocPixels(info);
+    glow.eraseColor(SK_ColorTRANSPARENT);
+    {
+      SkCanvas canvas(glow);
+      canvas.scale(kScale, kScale);
+      SkPaint paint;
+      paint.setShader(builder.makeShader());
+      canvas.drawRect(SkRect::MakeWH(kW / kScale, kH / kScale), paint);
+    }
+    // The reference, one pixel at a time: LoadingGlowAt()'s colour,
+    // unpremultiplied sRGB, drawn by Skia into the same space.
+    SkBitmap want;
+    want.allocPixels(info);
+    want.eraseColor(SK_ColorTRANSPARENT);
+    SkCanvas want_canvas(want);
+    for (int y = 0; y < kH; ++y) {
+      for (int x = 0; x < kW; ++x) {
+        const float px = (x + 0.5f) / kScale;
+        const float above = kH / kScale - (y + 0.5f) / kScale;
+        const double dx = (px - shine_center) / shine_width;
+        const LoadingGlowPremul g =
+            LoadingGlowAt(px, head, above, span,
+                          kLoadingGlowShineStrength * std::exp(-0.5 * dx * dx));
+        if (g.a <= 0.0f) {
+          continue;
+        }
+        SkPaint paint;
+        paint.setBlendMode(SkBlendMode::kSrc);
+        paint.setColor4f({g.r / g.a, g.g / g.a, g.b / g.a, g.a},
+                         SkColorSpace::MakeSRGB().get());
+        want_canvas.drawRect(SkRect::MakeXYWH(x, y, 1, 1), paint);
+      }
+    }
+    double worst = 0.0;
+    for (int y = 0; y < kH; ++y) {
+      for (int x = 0; x < kW; ++x) {
+        const float* got = static_cast<const float*>(glow.getAddr(x, y));
+        const float* ref = static_cast<const float*>(want.getAddr(x, y));
+        for (int c = 0; c < 4; ++c) {
+          worst = std::max(worst, static_cast<double>(std::abs(got[c] - ref[c])));
+        }
+      }
+    }
+    // Half-precision colour conversion in the shader: within a level.
+    EXPECT_LE(worst * 255.0, 1.0);
+  }
+}
+
+}  // namespace
+}  // namespace helium
