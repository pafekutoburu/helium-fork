Index: src/chrome/browser/ui/helium/arc_card_shadow_field.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_card_shadow_field.h
@@ -0,0 +1,436 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_CARD_SHADOW_FIELD_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_CARD_SHADOW_FIELD_H_
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "chrome/browser/ui/helium/arc_sidebar_surface.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+// helium-fork r1008: the new tab composer's shadow, computed on the CPU at
+// full device resolution instead of blurred on the GPU.
+//
+// The user, 2026-10-07, after three rounds on this shadow: 「新标签页中间的搜索
+// 框阴影，仔细看，有断层的情况……要非常细腻的阴影的效果。这次一定要完全解决好」.
+// The faults were two artefacts of the GPU blur, both measured off the r1007
+// Rel build (contrast x12 / x25 on tasks/evidence/r1007/composer-r5-w1100):
+//  * stair-stepped contours round the box's ends, 8-16 device px a step:
+//    Skia's GPU Gaussian downsamples any sigma over 4 device px into an 8-bit
+//    texture and scales it back up bilinearly (GrBlurUtils.cpp, kMaxSigma) --
+//    the composer's widest pass is sigma 24pt = 48px at 2x, so it was blurred
+//    at a twelfth of the resolution;
+//  * 8-bit rings: a 13-20 level shadow spread over 70-90px has one flat ring
+//    per level, and nothing dithered them.
+// So the field is evaluated analytically here -- every pass is a Gaussian blur
+// of a round rect, which is exactly separable strip by strip -- and quantised
+// with an ordered dither whose step is one level of the page underneath.
+//
+// Kept free of //ui/views and Skia's drawing types so the unit tests can reach
+// it; the painter (views/helium/arc_omnibox_panel_painter.cc) turns its output
+// into images.
+namespace helium {
+
+// The standard normal CDF.
+inline double ShadowFieldPhi(double t) {
+  return 0.5 * std::erfc(-t * 0.70710678118654752440);
+}
+
+// One blurred round-rect pass, in device pixels.
+struct ShadowFieldPass {
+  double offset_y = 0;  // the pass's rect moved down by this much
+  double inset_x = 0;   // and pulled in by this much at each side
+  double sigma_x = 0;
+  double sigma_y = 0;
+  double alpha = 0;
+};
+
+// A round rect, in the field's own device-pixel coordinates.
+struct ShadowFieldBox {
+  double x0 = 0;
+  double y0 = 0;
+  double x1 = 0;
+  double y1 = 0;
+  double radius = 0;
+};
+
+// A horizontal strip of a round rect: the rect is the central band plus the
+// rows of its two corner zones, each zone cut into strips no taller than
+// `max_strip` with the arc's width at the strip's middle. Blurring is linear,
+// so the rect's blurred coverage is the sum of its strips', and a strip's is
+// separable: [Phi((u1-x)/sx) - Phi((u0-x)/sx)] * [Phi((v1-y)/sy) -
+// Phi((v0-y)/sy)].
+struct ShadowFieldStrip {
+  double u0 = 0;
+  double u1 = 0;
+  double v0 = 0;
+  double v1 = 0;
+};
+
+inline std::vector<ShadowFieldStrip> ShadowFieldStrips(const ShadowFieldBox& box,
+                                                       double max_strip) {
+  std::vector<ShadowFieldStrip> strips;
+  if (box.x1 <= box.x0 || box.y1 <= box.y0) {
+    return strips;
+  }
+  const double r = std::clamp(
+      box.radius, 0.0, std::min(box.x1 - box.x0, box.y1 - box.y0) / 2.0);
+  if (box.y1 - r > box.y0 + r) {
+    strips.push_back({box.x0, box.x1, box.y0 + r, box.y1 - r});
+  }
+  if (r <= 0) {
+    return strips;
+  }
+  const int n = std::max(1, static_cast<int>(std::ceil(r / std::max(max_strip,
+                                                                    0.25))));
+  const double h = r / n;
+  for (int k = 0; k < n; ++k) {
+    // Strip k of the top zone counts down from the zone's bottom edge (the
+    // arc's widest point), so k = n - 1 is the sliver at the very top.
+    const double mid = (k + 0.5) * h;  // up from the zone's bottom edge
+    const double d = r - std::sqrt(std::max(0.0, r * r - mid * mid));
+    const double u0 = box.x0 + d;
+    const double u1 = box.x1 - d;
+    strips.push_back({u0, u1, box.y0 + r - (k + 1) * h, box.y0 + r - k * h});
+    strips.push_back({u0, u1, box.y1 - r + k * h, box.y1 - r + (k + 1) * h});
+  }
+  return strips;
+}
+
+// The blur's one-dimensional factor for [a, b] at pixel centre `c`.
+inline double ShadowFieldSpan(double a, double b, double c, double sigma) {
+  if (sigma <= 1e-6) {
+    return (c >= a && c < b) ? 1.0 : 0.0;
+  }
+  return ShadowFieldPhi((b - c) / sigma) - ShadowFieldPhi((a - c) / sigma);
+}
+
+// The blurred coverage, 0..1, of a shape given as strips under a (sigma_x,
+// sigma_y) Gaussian at the pixel centres (x_begin + i + 0.5, y_begin + j + 0.5)
+// for i < width, j < height, row-major.
+inline void ShadowFieldStripsCoverage(
+    const std::vector<ShadowFieldStrip>& strips,
+    double sigma_x,
+    double sigma_y,
+    int x_begin,
+    int width,
+    int y_begin,
+    int height,
+    std::vector<float>* out) {
+  out->assign(static_cast<size_t>(std::max(0, width)) *
+                  static_cast<size_t>(std::max(0, height)),
+              0.0f);
+  if (width <= 0 || height <= 0) {
+    return;
+  }
+  const size_t count = strips.size();
+  std::vector<float> xs(count * width);
+  std::vector<float> ys(count * height);
+  for (size_t k = 0; k < count; ++k) {
+    for (int i = 0; i < width; ++i) {
+      xs[k * width + i] = static_cast<float>(ShadowFieldSpan(
+          strips[k].u0, strips[k].u1, x_begin + i + 0.5, sigma_x));
+    }
+    for (int j = 0; j < height; ++j) {
+      ys[k * height + j] = static_cast<float>(ShadowFieldSpan(
+          strips[k].v0, strips[k].v1, y_begin + j + 0.5, sigma_y));
+    }
+  }
+  for (int j = 0; j < height; ++j) {
+    float* const row = out->data() + static_cast<size_t>(j) * width;
+    for (size_t k = 0; k < count; ++k) {
+      const float y_factor = ys[k * height + j];
+      if (y_factor < 1e-8f) {
+        continue;
+      }
+      const float* const x_factor = xs.data() + k * width;
+      for (int i = 0; i < width; ++i) {
+        row[i] += y_factor * x_factor[i];
+      }
+    }
+  }
+}
+
+// The same for a round rect. Strips are cut to a quarter of the narrower
+// sigma: the blur smooths anything finer, and the midpoint error at that size
+// is a few tenths of a per cent of the corner's own contribution.
+inline void ShadowFieldCoverage(const ShadowFieldBox& box,
+                                double sigma_x,
+                                double sigma_y,
+                                int x_begin,
+                                int width,
+                                int y_begin,
+                                int height,
+                                std::vector<float>* out) {
+  ShadowFieldStripsCoverage(
+      ShadowFieldStrips(box, std::max(1.0, std::min(sigma_x, sigma_y) / 4.0)),
+      sigma_x, sigma_y, x_begin, width, y_begin, height, out);
+}
+
+// A shape that is not a round rect -- the space icon picker's card with its
+// tail -- from its antialiased coverage raster (8-bit, `row_bytes` apart,
+// pixel (0, 0) at (`x_origin`, `y_origin`) in field coordinates). Every run of
+// covered pixels in a row is a span: the run's fullest pixel says how much of
+// the row's height the shape covers there (an edge row of a straight top is
+// all 40%), and the end pixels' coverage, relative to that, says where across
+// them the shape stops. Rows with the same full-height spans (to a hundredth
+// of a pixel) merge into one strip -- a card's straight middle is one strip
+// however tall it is. Blurred at any sigma above a pixel, this is the shape.
+inline std::vector<ShadowFieldStrip> ShadowFieldStripsFromCoverage(
+    const uint8_t* coverage,
+    int width,
+    int height,
+    size_t row_bytes,
+    double x_origin,
+    double y_origin) {
+  std::vector<ShadowFieldStrip> strips;
+  std::vector<std::pair<double, double>> previous;  // last full-height row
+  std::vector<size_t> open;  // strips[] index of each of `previous`'s spans
+  for (int j = 0; j < height; ++j) {
+    const uint8_t* const row = coverage + static_cast<size_t>(j) * row_bytes;
+    std::vector<std::pair<double, double>> spans;
+    std::vector<double> heights;
+    for (int i = 0; i < width;) {
+      if (!row[i]) {
+        ++i;
+        continue;
+      }
+      const int a = i;
+      uint8_t fullest = 0;
+      while (i < width && row[i]) {
+        fullest = std::max(fullest, row[i]);
+        ++i;
+      }
+      const int b = i - 1;
+      const double full = fullest;
+      double u0;
+      double u1;
+      if (a == b) {
+        u0 = a;
+        u1 = a + 1.0;
+      } else {
+        u0 = a + 1.0 - row[a] / full;
+        u1 = b + row[b] / full;
+      }
+      spans.emplace_back(x_origin + u0, x_origin + u1);
+      heights.push_back(full / 255.0);
+    }
+    const bool full_row =
+        !spans.empty() && std::all_of(heights.begin(), heights.end(),
+                                      [](double h) { return h >= 1.0; });
+    bool same = full_row && spans.size() == previous.size();
+    for (size_t k = 0; same && k < spans.size(); ++k) {
+      same = std::abs(spans[k].first - previous[k].first) < 0.01 &&
+             std::abs(spans[k].second - previous[k].second) < 0.01;
+    }
+    const double v = y_origin + j;
+    if (same) {
+      for (size_t k = 0; k < spans.size(); ++k) {
+        strips[open[k]].v1 = v + 1;
+      }
+      continue;
+    }
+    open.clear();
+    for (size_t k = 0; k < spans.size(); ++k) {
+      // A partly covered row: its share of the height, about the row's middle
+      // (the blur cannot tell where within a pixel it sits).
+      const double half = heights[k] / 2;
+      open.push_back(strips.size());
+      strips.push_back({spans[k].first, spans[k].second, v + 0.5 - half,
+                        v + 0.5 + half});
+    }
+    previous = full_row ? std::move(spans)
+                        : std::vector<std::pair<double, double>>();
+  }
+  return strips;
+}
+
+// A strip list moved down by `dy` and squeezed horizontally about `centre_x`
+// by `scale` -- a pass of a shape that is not a round rect (the round rect's
+// own passes pull its sides in instead, keeping the corner radius).
+inline std::vector<ShadowFieldStrip> ShadowFieldStripsMoved(
+    const std::vector<ShadowFieldStrip>& strips,
+    double centre_x,
+    double scale,
+    double dy) {
+  std::vector<ShadowFieldStrip> out;
+  out.reserve(strips.size());
+  for (const ShadowFieldStrip& strip : strips) {
+    out.push_back({centre_x + (strip.u0 - centre_x) * scale,
+                   centre_x + (strip.u1 - centre_x) * scale, strip.v0 + dy,
+                   strip.v1 + dy});
+  }
+  return out;
+}
+
+// What is left of the light after every pass, prod(1 - alpha_p * S_p), over
+// the same pixels: the passes are black and stack source-over, so the shadow's
+// alpha is one minus this. (Kept as the product so the popup's differential
+// below is a single division.)
+inline void ShadowFieldTransmittance(const ShadowFieldBox& card,
+                                     base::span<const ShadowFieldPass> passes,
+                                     int x_begin,
+                                     int width,
+                                     int y_begin,
+                                     int height,
+                                     std::vector<float>* out) {
+  out->assign(static_cast<size_t>(std::max(0, width)) *
+                  static_cast<size_t>(std::max(0, height)),
+              1.0f);
+  std::vector<float> coverage;
+  for (const ShadowFieldPass& pass : passes) {
+    if (pass.alpha <= 0) {
+      continue;
+    }
+    ShadowFieldBox rect = card;
+    rect.x0 += pass.inset_x;
+    rect.x1 -= pass.inset_x;
+    rect.y0 += pass.offset_y;
+    rect.y1 += pass.offset_y;
+    ShadowFieldCoverage(rect, pass.sigma_x, pass.sigma_y, x_begin, width,
+                        y_begin, height, &coverage);
+    const float alpha = static_cast<float>(pass.alpha);
+    for (size_t p = 0; p < out->size(); ++p) {
+      (*out)[p] *= 1.0f - alpha * coverage[p];
+    }
+  }
+}
+
+// The same, far from both ends of a card wide enough to have a straight middle:
+// there no column sees either end, every strip covers the column fully, and
+// what is left is the rect's own vertical extent -- the exact profile of the
+// middle, one value per row.
+inline void ShadowFieldMiddleTransmittance(
+    const ShadowFieldBox& card,
+    base::span<const ShadowFieldPass> passes,
+    int y_begin,
+    int height,
+    std::vector<float>* out) {
+  out->assign(static_cast<size_t>(std::max(0, height)), 1.0f);
+  for (const ShadowFieldPass& pass : passes) {
+    if (pass.alpha <= 0) {
+      continue;
+    }
+    for (int j = 0; j < height; ++j) {
+      const double coverage =
+          ShadowFieldSpan(card.y0 + pass.offset_y, card.y1 + pass.offset_y,
+                          y_begin + j + 0.5, pass.sigma_y);
+      (*out)[j] *= static_cast<float>(1.0 - pass.alpha * coverage);
+    }
+  }
+}
+
+// How far in from a card's left edge the field still depends on x: past this
+// every pass has covered the column to within 1e-5, so the middle profile
+// above holds to that precision.
+inline double ShadowFieldEndReach(const ShadowFieldBox& card,
+                                  base::span<const ShadowFieldPass> passes) {
+  double reach = 0;
+  for (const ShadowFieldPass& pass : passes) {
+    reach = std::max(reach, pass.inset_x + 4.5 * pass.sigma_x);
+  }
+  return reach + std::max(0.0, card.radius);
+}
+
+// The shadow a second surface adds over a first one already casting
+// `under` (transmittance), so that the two composited source-over give
+// `whole`: 1 - whole / under. It is never negative where the whole card
+// contains the part the first surface casts for -- a blurred superset covers
+// at least as much -- so clamping only absorbs float rounding.
+inline float ShadowFieldDifferential(float whole, float under) {
+  if (under <= 0.0f) {
+    return 0.0f;
+  }
+  return std::clamp(1.0f - whole / under, 0.0f, 1.0f);
+}
+
+// The edge fade (arc_sidebar_surface.h's smoothstep) at a pixel centre `c` of
+// a room `extent` pixels long, faded over `fade` pixels at both ends.
+inline double ShadowFieldEdgeFade(double c, double extent, double fade) {
+  return CardShadowEdgeFade(std::min(c, extent - c), fade);
+}
+
+// --- Dither ------------------------------------------------------------------
+
+// The 8x8 Bayer matrix: an ordered dither whose pattern repeats every 8 pixels
+// and whose thresholds are spread as evenly as an 8x8 grid allows, so a flat
+// fraction of a level comes out as the finest dot pattern there is.
+inline constexpr uint8_t kShadowFieldBayer8[64] = {
+    0,  32, 8,  40, 2,  34, 10, 42, 48, 16, 56, 24, 50, 18, 58, 26,
+    12, 44, 4,  36, 14, 46, 6,  38, 60, 28, 52, 20, 62, 30, 54, 22,
+    3,  35, 11, 43, 1,  33, 9,  41, 51, 19, 59, 27, 49, 17, 57, 25,
+    15, 47, 7,  39, 13, 45, 5,  37, 63, 31, 55, 23, 61, 29, 53, 21};
+
+// The shadow's alpha step, in levels of 255, that darkens `page` by about one
+// display level: black at alpha a over a channel c leaves c * (1 - a), so one
+// level of the brightest channel is 255 / c levels of alpha. A white page
+// gets 1; a dark one several, or its dither would be finer than the display
+// can show and the rings would come back.
+inline int ShadowFieldDitherStep(SkColor page) {
+  const int brightest = std::max(
+      {SkColorGetR(page), SkColorGetG(page), SkColorGetB(page), 1u});
+  return std::clamp(static_cast<int>(std::lround(255.0 / brightest)), 1, 16);
+}
+
+// `alpha` (0..1) at pixel (x, y) as an 8-bit alpha in multiples of `step`:
+// the ordered dither keeps the 8x8 average at the true value, and zero stays
+// exactly zero (no stray dots past the shadow's end).
+//
+// `complement` reads the matrix upside down (threshold 1 - t). For a layer
+// composited over another dithered with the same pixel grid -- the popup's
+// differential over the resting box (reviewer r1008 brief) -- the two then
+// round up on disjoint thresholds wherever their fractions fit in one level,
+// so together they are a single dither of the sum: each pixel within one step
+// of the true composite, not two (both rounding up at the same pixel).
+inline uint8_t ShadowFieldDither(double alpha,
+                                 int x,
+                                 int y,
+                                 int step,
+                                 bool complement = false) {
+  step = std::max(step, 1);
+  const int index = kShadowFieldBayer8[(y & 7) * 8 + (x & 7)];
+  const double threshold = ((complement ? 63 - index : index) + 0.5) / 64.0;
+  const double levels = std::max(alpha, 0.0) * 255.0 / step;
+  const int q = static_cast<int>(std::floor(levels + threshold)) * step;
+  return static_cast<uint8_t>(std::clamp(q, 0, 255));
+}
+
+// --- Passes in device pixels ----------------------------------------------
+
+// A pass table (arc_sidebar_surface.h) in device pixels: `scale` pixels per
+// point, `across` the sideways narrowing for a short room (blur and inset
+// across, never down -- ComposerCardShadowScale), dark or light alphas.
+inline std::vector<ShadowFieldPass> ShadowFieldPassesFor(
+    base::span<const SidebarCardShadowPass> table,
+    double scale,
+    double across,
+    bool dark) {
+  std::vector<ShadowFieldPass> passes;
+  for (const SidebarCardShadowPass& pass : table) {
+    passes.push_back({.offset_y = pass.offset_y * scale,
+                      .inset_x = pass.inset_h * across * scale,
+                      .sigma_x = pass.sigma * across * scale,
+                      .sigma_y = pass.sigma * scale,
+                      .alpha = dark ? pass.dark_alpha : pass.light_alpha});
+  }
+  return passes;
+}
+
+// The composer's (kComposerCardShadowPasses).
+inline std::vector<ShadowFieldPass> ComposerShadowFieldPasses(double scale,
+                                                              double across,
+                                                              bool dark) {
+  return ShadowFieldPassesFor(kComposerCardShadowSpec.passes, scale, across,
+                              dark);
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_CARD_SHADOW_FIELD_H_
