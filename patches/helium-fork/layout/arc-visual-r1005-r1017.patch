+// less still when the window is so narrow that the box's kArcComposerMinWidth
+// floor wins -- down to nothing when the box is as wide as the card.
+inline int ArcComposerSideRoom(const gfx::Rect& card, const gfx::Rect& box) {
+  if (card.IsEmpty() || box.IsEmpty()) {
