+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/helium/card_shadow_painter.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "base/notreached.h"
+#include "cc/paint/paint_canvas.h"
+#include "cc/paint/paint_flags.h"
+#include "cc/paint/paint_image.h"
+#include "cc/paint/paint_shader.h"
+#include "chrome/browser/ui/helium/arc_card_shadow_field.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkCanvas.h"
+#include "third_party/skia/include/core/SkClipOp.h"
+#include "third_party/skia/include/core/SkMatrix.h"
+#include "third_party/skia/include/core/SkPaint.h"
+#include "third_party/skia/include/core/SkPath.h"
+#include "third_party/skia/include/core/SkRRect.h"
+#include "third_party/skia/include/core/SkSamplingOptions.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/skia_conversions.h"
+#include "ui/gfx/scoped_canvas.h"
+
+namespace helium {
+
+namespace {
+
+// A middle tile's repeat: a multiple of the dither's 8 so its pattern runs on
+// unbroken across the repeats.
+constexpr int kTile = 64;
+// An edge put out of reach (a piece that must not depend on the card's real
+// width or height is computed with that edge here).
+constexpr double kFar = 1e6;
+// The resting composer box, the popup at the row counts typing moves between,
+// a dozen sidebar cards, a theme or scale change.
+constexpr size_t kCacheSize = 24;
+
+// Where a piece sits along one axis: the start (left / top), the middle that
+// a tile repeats across, the end (bottom; the right side is the left
+// mirrored), or the whole axis when the card is too small for a middle.
+enum class Part { kStart, kMiddle, kEnd, kWhole };
+
+// The room cut up, device pixels.
+struct Layout {
+  int room_w = 0;
+  int room_h = 0;
+  bool hmid = false;
+  bool vmid = false;
+  int lw = 0;  // the left end's width (with a horizontal middle)
+  int th = 0;  // the top's height (with a vertical middle)
+  int bh = 0;  // the bottom's height (with a vertical middle)
+};
+
+// Everything the images depend on, device pixels.
+struct Key {
+  float scale = 0;
+  const SidebarCardShadowPass* passes = nullptr;
+  size_t pass_count = 0;
+  int across_permille = 1000;
+  bool dark = false;
+  int step = 1;
+  int radius = 0;
+  int room_h = 0;
+  int room_v = 0;
+  int fade_h = 0;
+  int fade_v = 0;
+  int card_w = 0;  // 0 when a horizontal middle absorbs it
+  int card_h = 0;  // 0 when a vertical middle absorbs it
+  int box_h = 0;   // the composer popup's resting box; 0 otherwise
+  uint64_t silhouette = 0;  // the shape's strips hashed; 0 for the round rect
+
+  bool operator==(const Key&) const = default;
+};
+
+struct Piece {
+  Part h = Part::kWhole;
+  Part v = Part::kWhole;
+  cc::PaintImage image;
+};
+
+struct Images {
+  Key key;
+  std::vector<Piece> pieces;
+};
+
+// The field's inputs, device pixels.
+struct Field {
+  std::vector<ShadowFieldPass> passes;
+  int radius = 0;
+  int room_h = 0;
+  int room_v = 0;
+  double fade_h = 0;
+  double fade_v = 0;
+  int box_h = 0;  // > 0: the composer popup's differential
+  // A silhouette, as strips in room pixels; empty for the round rect.
+  std::vector<ShadowFieldStrip> shape;
+  double shape_centre_x = 0;
+  double shape_width = 0;
+};
+
+// What is left of the light after every pass, over [x0, x0 + w) x [y0, y0 + h).
+void Transmittance(const Field& f,
+                   const ShadowFieldBox& card,
+                   int x0,
+                   int w,
+                   int y0,
+                   int h,
+                   std::vector<float>* out) {
+  if (f.shape.empty()) {
+    ShadowFieldTransmittance(card, f.passes, x0, w, y0, h, out);
+    return;
+  }
+  // The silhouette's passes pull its sides in by squeezing it about its
+  // middle (a path has no sides to inset), as the GPU version did.
+  out->assign(static_cast<size_t>(w) * h, 1.0f);
+  std::vector<float> coverage;
+  for (const ShadowFieldPass& pass : f.passes) {
+    if (pass.alpha <= 0) {
+      continue;
+    }
+    const double squeeze =
+        f.shape_width > 2 * pass.inset_x
+            ? (f.shape_width - 2 * pass.inset_x) / f.shape_width
+            : 1.0;
+    ShadowFieldStripsCoverage(
+        ShadowFieldStripsMoved(f.shape, f.shape_centre_x, squeeze,
+                               pass.offset_y),
+        pass.sigma_x, pass.sigma_y, x0, w, y0, h, &coverage);
+    const float alpha = static_cast<float>(pass.alpha);
+    for (size_t p = 0; p < out->size(); ++p) {
+      (*out)[p] *= 1.0f - alpha * coverage[p];
+    }
+  }
+}
+
+// The shadow's alpha over [x0, x0 + w) x [y0, y0 + h) for `card` in a room
+// spanning [rx0, rx1) x [ry0, ry1) (an open side is kFar away), with the edge
+// fade; for the composer popup, only what the card adds over its resting box
+// (whose top is the card's) -- `with_box` false where the box is out of reach.
+std::vector<float> Alpha(const Field& f,
+                         const ShadowFieldBox& card,
+                         bool with_box,
+                         int x0,
+                         int w,
+                         int y0,
+                         int h,
+                         double rx0,
+                         double rx1,
+                         double ry0,
+                         double ry1) {
+  std::vector<float> card_t;
+  Transmittance(f, card, x0, w, y0, h, &card_t);
+  const bool differential = f.box_h > 0 && with_box;
+  std::vector<float> box_t;
+  if (differential) {
+    ShadowFieldBox box = card;
+    box.y1 = card.y0 + f.box_h;
+    Transmittance(f, box, x0, w, y0, h, &box_t);
+  }
+  std::vector<float> alpha(card_t.size());
+  for (int j = 0; j < h; ++j) {
+    const double fade_y =
+        ShadowFieldEdgeFade(y0 + j + 0.5 - ry0, ry1 - ry0, f.fade_v);
+    for (int i = 0; i < w; ++i) {
+      const size_t p = static_cast<size_t>(j) * w + i;
+      const double fade =
+          fade_y * ShadowFieldEdgeFade(x0 + i + 0.5 - rx0, rx1 - rx0, f.fade_h);
+      const float a_card = static_cast<float>(fade) * (1.0f - card_t[p]);
+      if (!differential) {
+        alpha[p] = a_card;
+        continue;
+      }
+      const float a_box = static_cast<float>(fade) * (1.0f - box_t[p]);
+      alpha[p] = ShadowFieldDifferential(1.0f - a_card, 1.0f - a_box);
+    }
+  }
+  return alpha;
+}
+
+// `alpha` (w x h) as a premultiplied black image, dithered with the matrix
+// phased at (`x_phase`, `y_phase`) -- the room pixel the image's (0, 0) lands
+// on, so two layers drawn over each other at the same place agree on it.
+cc::PaintImage DitheredImage(const std::vector<float>& alpha,
+                             int w,
+                             int h,
+                             int x_phase,
+                             int y_phase,
+                             int step,
+                             bool complement) {
+  SkBitmap bitmap;
+  bitmap.allocN32Pixels(w, h, /*isOpaque=*/false);
+  for (int j = 0; j < h; ++j) {
+    for (int i = 0; i < w; ++i) {
+      const uint8_t a = ShadowFieldDither(alpha[static_cast<size_t>(j) * w + i],
+                                          x_phase + i, y_phase + j, step,
+                                          complement);
+      *bitmap.getAddr32(i, j) = SkPreMultiplyARGB(a, 0, 0, 0);
+    }
+  }
+  bitmap.setImmutable();
+  return cc::PaintImage::CreateFromBitmap(std::move(bitmap));
+}
+
+// One axis's parts for a layout.
+std::vector<Part> Parts(bool middle, bool vertical) {
+  if (!middle) {
+    return {Part::kWhole};
+  }
+  return vertical ? std::vector<Part>{Part::kStart, Part::kMiddle, Part::kEnd}
+                  : std::vector<Part>{Part::kStart, Part::kMiddle};
+}
+
+Images BuildImages(const Key& key,
+                   const Field& f,
+                   const Layout& layout,
+                   int card_w,
+                   int card_h) {
+  Images images;
+  images.key = key;
+  const bool complement = f.box_h > 0;
+  for (Part hp : Parts(layout.hmid, /*vertical=*/false)) {
+    for (Part vp : Parts(layout.vmid, /*vertical=*/true)) {
+      if (hp == Part::kMiddle && vp == Part::kMiddle) {
+        continue;  // inside the card
+      }
+      // The card, the room and the region to compute, in this piece's frame.
+      ShadowFieldBox card{.x0 = static_cast<double>(f.room_h),
+                          .y0 = static_cast<double>(f.room_v),
+                          .x1 = static_cast<double>(f.room_h + card_w),
+                          .y1 = static_cast<double>(f.room_v + card_h),
+                          .radius = static_cast<double>(f.radius)};
+      double rx0 = 0;
+      double rx1 = layout.room_w;
+      double ry0 = 0;
+      double ry1 = layout.room_h;
+      int x0 = 0;
+      int w = layout.room_w;
+      int y0 = 0;
+      int h = layout.room_h;
+      int x_phase = 0;
+      int y_phase = 0;
+      switch (hp) {
+        case Part::kStart:
+          card.x1 = kFar;
+          rx1 = kFar;
+          w = layout.lw;
+          break;
+        case Part::kMiddle:
+          // One column, x out of reach both ways: the middle's profile.
+          card.x0 = -kFar;
+          card.x1 = kFar;
+          rx0 = -kFar;
+          rx1 = kFar;
+          w = 1;
+          x_phase = layout.lw;
+          break;
+        default:
+          break;
+      }
+      switch (vp) {
+        case Part::kStart:
+          card.y1 = kFar;
+          ry1 = kFar;
+          h = layout.th;
+          break;
+        case Part::kMiddle:
+          card.y0 = -kFar;
+          card.y1 = kFar;
+          ry0 = -kFar;
+          ry1 = kFar;
+          h = 1;
+          y_phase = layout.th;
+          break;
+        case Part::kEnd:
+          // Its own frame: the card's bottom edge bh - room_v down, its top
+          // out of reach; the dither phased from the piece's own top (the
+          // resting box is never this far down, see the layout).
+          card.y0 = -kFar;
+          card.y1 = layout.bh - f.room_v;
+          ry0 = -kFar;
+          ry1 = layout.bh;
+          h = layout.bh;
+          break;
+        default:
+          break;
+      }
+      const bool with_box = vp == Part::kStart || vp == Part::kWhole;
+      std::vector<float> alpha =
+          Alpha(f, card, with_box, x0, w, y0, h, rx0, rx1, ry0, ry1);
+      // A middle is one column / row of the field: repeated into a tile.
+      int iw = w;
+      int ih = h;
+      if (hp == Part::kMiddle) {
+        std::vector<float> tile(static_cast<size_t>(kTile) * h);
+        for (int j = 0; j < h; ++j) {
+          std::fill_n(tile.begin() + static_cast<size_t>(j) * kTile, kTile,
+                      alpha[j]);
+        }
+        alpha = std::move(tile);
+        iw = kTile;
+      } else if (vp == Part::kMiddle) {
+        std::vector<float> tile(static_cast<size_t>(w) * kTile);
+        for (int j = 0; j < kTile; ++j) {
+          std::copy_n(alpha.begin(), w,
+                      tile.begin() + static_cast<size_t>(j) * w);
+        }
+        alpha = std::move(tile);
+        ih = kTile;
+      }
+      images.pieces.push_back(
+          {hp, vp,
+           DitheredImage(alpha, iw, ih, x_phase, y_phase, key.step,
+                         complement)});
+    }
+  }
+  return images;
+}
+
+const Images& ImagesFor(const Key& key,
+                        const Field& field,
+                        const Layout& layout,
+                        int card_w,
+                        int card_h) {
+  static base::NoDestructor<std::vector<Images>> cache;
+  for (auto it = cache->begin(); it != cache->end(); ++it) {
+    if (it->key == key) {
+      std::rotate(cache->begin(), it, it + 1);
+      return cache->front();
+    }
+  }
+  cache->insert(cache->begin(),
+                BuildImages(key, field, layout, card_w, card_h));
+  if (cache->size() > kCacheSize) {
+    cache->pop_back();
+  }
+  return cache->front();
+}
+
+// [start, start + size) of a part along an axis of the current layout.
+std::pair<int, int> Extent(Part part, bool vertical, const Layout& layout) {
+  const int whole = vertical ? layout.room_h : layout.room_w;
+  const int start_size = vertical ? layout.th : layout.lw;
+  const int end_size = vertical ? layout.bh : layout.lw;
+  switch (part) {
+    case Part::kStart:
+      return {0, start_size};
+    case Part::kMiddle:
+      return {start_size, whole - start_size - end_size};
+    case Part::kEnd:
+      return {whole - end_size, end_size};
+    case Part::kWhole:
+      return {0, whole};
+  }
+  NOTREACHED();
+}
+
+void DrawPiece(cc::PaintCanvas* canvas,
+               const Piece& piece,
+               const Layout& layout,
+               SkScalar left,
+               SkScalar top) {
+  const auto [x, w] = Extent(piece.h, /*vertical=*/false, layout);
+  const auto [y, h] = Extent(piece.v, /*vertical=*/true, layout);
+  if (w <= 0 || h <= 0) {
+    return;
+  }
+  const SkSamplingOptions nearest(SkFilterMode::kNearest);
+  if (piece.h != Part::kMiddle && piece.v != Part::kMiddle) {
+    canvas->drawImage(piece.image, left + x, top + y, nearest, nullptr);
+    return;
+  }
+  const SkMatrix origin = SkMatrix::Translate(left + x, top + y);
+  cc::PaintFlags flags;
+  flags.setFilterQuality(cc::PaintFlags::FilterQuality::kNone);
+  flags.setShader(cc::PaintShader::MakeImage(
+      piece.image,
+      piece.h == Part::kMiddle ? SkTileMode::kRepeat : SkTileMode::kClamp,
+      piece.v == Part::kMiddle ? SkTileMode::kRepeat : SkTileMode::kClamp,
+      &origin));
+  canvas->drawRect(SkRect::MakeXYWH(left + x, top + y, w, h), flags);
+}
+
+uint64_t HashStrips(const std::vector<ShadowFieldStrip>& strips) {
+  uint64_t hash = 1469598103934665603ull;  // FNV-1a over quantised ends
+  const auto mix = [&hash](double v) {
+    const int64_t q = std::llround(v * 64.0);
+    for (int b = 0; b < 8; ++b) {
+      hash ^= static_cast<uint64_t>((q >> (8 * b)) & 0xff);
+      hash *= 1099511628211ull;
+    }
+  };
+  for (const ShadowFieldStrip& s : strips) {
+    mix(s.u0);
+    mix(s.u1);
+    mix(s.v0);
+    mix(s.v1);
+  }
+  return hash | 1;  // never 0, which means "round rect"
+}
+
+}  // namespace
+
+void PaintCardShadow(gfx::Canvas* canvas, const CardShadowParams& params) {
+  if (params.card.IsEmpty() || params.passes.empty()) {
+    return;
+  }
+  cc::PaintCanvas* const paint_canvas = canvas->sk_canvas();
+  cc::PaintCanvasAutoRestore restore(paint_canvas, /*save=*/true);
+  // Nothing inside the card: it is opaque, and a shadow that bleeds inward
+  // shows through the moment anything fades.
+  if (params.silhouette) {
+    paint_canvas->clipPath(*params.silhouette, SkClipOp::kDifference,
+                           /*do_anti_alias=*/true);
+  } else {
+    const SkScalar r = SkIntToScalar(params.radius);
+    paint_canvas->clipRRect(
+        SkRRect::MakeRectXY(gfx::RectFToSkRect(gfx::RectF(params.card)), r, r),
+        SkClipOp::kDifference, /*do_anti_alias=*/true);
+  }
+
+  // Device pixels from here on, so the dither lands one value per pixel.
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  const float scale = canvas->UndoDeviceScaleFactor();
+  const auto px = [scale](double dip) {
+    return static_cast<int>(std::lround(dip * scale));
+  };
+  const int card_x = px(params.card.x());
+  const int card_y = px(params.card.y());
+  const int card_w = px(params.card.right()) - card_x;
+  const int card_h = px(params.card.bottom()) - card_y;
+  if (card_w <= 0 || card_h <= 0) {
+    return;
+  }
+
+  Field field;
+  field.radius = px(params.radius);
+  field.room_h = px(params.room_h);
+  field.room_v = px(params.room_v);
+  field.fade_h = px(std::min(params.fade_h, params.room_h));
+  field.fade_v = px(std::min(params.fade_v, params.room_v));
+  field.passes =
+      ShadowFieldPassesFor(params.passes, scale, params.across, params.dark);
+  if (params.resting_height > 0 &&
+      params.resting_height < params.card.height()) {
+    field.box_h = std::min(px(params.resting_height), card_h);
+  }
+
+  Layout layout;
+  layout.room_w = card_w + 2 * field.room_h;
+  layout.room_h = card_h + 2 * field.room_v;
+  const SkScalar left = card_x - field.room_h;
+  const SkScalar top = card_y - field.room_v;
+
+  Key key;
+  key.scale = scale;
+  key.passes = params.passes.data();
+  key.pass_count = params.passes.size();
+  key.across_permille = static_cast<int>(std::lround(params.across * 1000.0));
+  key.dark = params.dark;
+  key.step = ShadowFieldDitherStep(params.backdrop);
+  key.radius = field.radius;
+  key.room_h = field.room_h;
+  key.room_v = field.room_v;
+  key.fade_h = static_cast<int>(field.fade_h);
+  key.fade_v = static_cast<int>(field.fade_v);
+  key.box_h = field.box_h;
+
+  if (params.silhouette) {
+    // The path's coverage, rasterised in room pixels, as strips.
+    SkBitmap mask;
+    mask.allocPixels(SkImageInfo::MakeA8(layout.room_w, layout.room_h));
+    mask.eraseColor(SK_ColorTRANSPARENT);
+    SkCanvas mask_canvas(mask, SkSurfaceProps{});
+    mask_canvas.translate(-left, -top);
+    mask_canvas.scale(scale, scale);
+    SkPaint fill;
+    fill.setAntiAlias(true);
+    mask_canvas.drawPath(*params.silhouette, fill);
+    field.shape = ShadowFieldStripsFromCoverage(
+        static_cast<const uint8_t*>(mask.getPixels()), layout.room_w,
+        layout.room_h, mask.rowBytes(), 0, 0);
+    const SkRect bounds = params.silhouette->getBounds();
+    field.shape_centre_x = bounds.centerX() * scale - left;
+    field.shape_width = bounds.width() * scale;
+    key.silhouette = HashStrips(field.shape);
+    key.card_w = card_w;
+    key.card_h = card_h;
+  } else {
+    // How far in from the card's edges the field still depends on x / y:
+    // past it every pass has covered the column / row to within 1e-5.
+    const double reach_x = ShadowFieldEndReach(
+        {.radius = static_cast<double>(field.radius)}, field.passes);
+    double reach_y = 0;
+    for (const ShadowFieldPass& pass : field.passes) {
+      reach_y =
+          std::max(reach_y, std::abs(pass.offset_y) + 4.5 * pass.sigma_y);
+    }
+    reach_y += field.radius;
+    layout.lw = field.room_h + static_cast<int>(std::ceil(reach_x)) + 1;
+    layout.hmid = layout.room_w >= 2 * layout.lw + kTile;
+    // The top reaches past the resting box (the popup's differential is only
+    // x/y-independent once the box is out of reach too).
+    layout.th = field.room_v + field.box_h +
+                static_cast<int>(std::ceil(reach_y)) + 1;
+    layout.bh = field.room_v + static_cast<int>(std::ceil(reach_y)) + 1;
+    layout.vmid = layout.room_h >= layout.th + layout.bh + kTile;
+    key.card_w = layout.hmid ? 0 : card_w;
+    key.card_h = layout.vmid ? 0 : card_h;
+  }
+
+  const Images& images = ImagesFor(key, field, layout, card_w, card_h);
+  for (const Piece& piece : images.pieces) {
+    DrawPiece(paint_canvas, piece, layout, left, top);
+  }
+  if (layout.hmid) {
+    // The right side: the left one mirrored about the room's right edge.
+    cc::PaintCanvasAutoRestore mirror(paint_canvas, /*save=*/true);
+    paint_canvas->translate(left + layout.room_w, top);
+    paint_canvas->scale(-1, 1);
+    for (const Piece& piece : images.pieces) {
+      if (piece.h == Part::kStart) {
+        DrawPiece(paint_canvas, piece, layout, 0, 0);
+      }
+    }
+  }
+}
+
+}  // namespace helium
