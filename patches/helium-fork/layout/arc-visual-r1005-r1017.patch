+void LocationBarView::RequestDeferredArcComposerEdit(bool require_focus) {
+  if (arc_composer_edit_deferred_ || !ToolbarView::IsArcBandHostedFor(this) ||
+      !CanArcComposerHostEdit()) {
+    return;
+  }
+  arc_composer_edit_deferred_ = true;
