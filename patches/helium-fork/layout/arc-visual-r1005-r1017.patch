+TEST(ArcLoadingGlowModelTest, LoadingEndsWithStop) {
+  ArcLoadingGlowModel model;
+  EXPECT_FALSE(model.loading());
+  model.Start(kT0);
+  EXPECT_TRUE(model.loading());
+  model.Stop(kT0 + base::Seconds(1));
+  // Finishing and fading are not loading: a glow that was out of sight then
