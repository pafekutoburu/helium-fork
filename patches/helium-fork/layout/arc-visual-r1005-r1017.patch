@@ -0,0 +1,282 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/location_bar/arc_location_bar_glow_view.h"
+
+#include <algorithm>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/i18n/rtl.h"
+#include "cc/paint/paint_canvas.h"
+#include "cc/paint/paint_flags.h"
+#include "cc/paint/paint_shader.h"
+#include "chrome/browser/ui/views/location_bar/location_bar_view.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_view.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/skia/include/core/SkRRect.h"
+#include "third_party/skia/include/core/SkString.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/skia_conversions.h"
+#include "ui/gfx/scoped_canvas.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/view_utils.h"
+#include "url/gurl.h"
+
+ArcLocationBarGlowView::ArcLocationBarGlowView(PrefService* pref_service)
+    : AnimationDelegateViews(this),
+      clock_(base::Hours(1), gfx::LinearAnimation::kDefaultFrameRate, this) {
+  SetCanProcessEventsWithinSubtree(false);
+  SetFlipCanvasOnPaintForRTLUI(true);
+  GetViewAccessibility().SetIsIgnored(true);
+  pref_change_registrar_.Init(pref_service);
+  pref_change_registrar_.Add(
+      prefs::kHeliumShowProgressBar,
+      base::BindRepeating(&ArcLocationBarGlowView::SyncFromWebContents,
+                          base::Unretained(this)));
+}
+
+ArcLocationBarGlowView::~ArcLocationBarGlowView() = default;
+
+void ArcLocationBarGlowView::SetWebContents(content::WebContents* contents) {
+  if (contents == web_contents()) {
+    return;
+  }
+  Observe(contents);
+  SyncFromWebContents();
+}
+
+void ArcLocationBarGlowView::SetLocationBarFocused(bool focused) {
+  if (location_bar_focused_ == focused) {
+    return;
+  }
+  location_bar_focused_ = focused;
+  Step();
+}
+
+bool ArcLocationBarGlowView::IsEnabled() const {
+  return pref_change_registrar_.prefs()->GetBoolean(
+      prefs::kHeliumShowProgressBar);
+}
+
+void ArcLocationBarGlowView::SyncFromWebContents() {
+  content::WebContents* contents = web_contents();
+  if (IsEnabled() && contents && contents->ShouldShowLoadingUI() &&
+      contents->GetVisibleURL().SchemeIsHTTPOrHTTPS()) {
+    model_.Resume(contents->GetLoadProgress(), base::TimeTicks::Now());
+  } else {
+    model_.Hide();
+  }
+  Step();
+}
+
+void ArcLocationBarGlowView::Step() {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  const auto* bar = views::AsViewClass<LocationBarView>(parent());
+  // The composer (the new tab page's centred box) borrows this field while
+  // it is focused for typing; a load it starts shows once the field is back
+  // on the band.
+  const bool allowed = IsEnabled() && !location_bar_focused_ && IsDrawn() &&
+                       !(bar && bar->IsArcComposerHosted());
+  if (allowed && !shown_ && model_.active()) {
+    // A load that ended while the glow was out of sight (the field was being
+    // edited, say) is over: coming back must not replay its finish and fade
+    // (reviewer r1005 r0). Only a load still under way fades back in.
+    if (model_.loading()) {
+      model_.Reveal(now);
+    } else {
+      model_.Hide();
+    }
+  }
+  frame_ = model_.Tick(now);
+  shown_ = allowed && frame_.visible;
+  SchedulePaint();
+  if (InRow()) {
+    if (auto* const row = views::AsViewClass<ToolbarView>(parent()->parent())) {
+      row->SchedulePaint();
+    }
+  }
+  if (shown_) {
+    if (!clock_.is_animating()) {
+      clock_.Start();
+    }
+  } else if (clock_.is_animating()) {
+    clock_.Stop();
+  }
+}
+
+float ArcLocationBarGlowView::GetFieldRadius() const {
+  if (const auto* bar = views::AsViewClass<LocationBarView>(parent())) {
+    return std::min<float>(bar->GetBorderRadius(), height() / 2.0f);
+  }
+  return height() / 2.0f;
+}
+
+bool ArcLocationBarGlowView::InRow() const {
+  const auto* const bar = views::AsViewClass<LocationBarView>(parent());
+  return bar && ToolbarView::IsArcSidebarHostedFor(bar) &&
+         views::IsViewClass<ToolbarView>(bar->parent());
+}
+
+void ArcLocationBarGlowView::OnPaint(gfx::Canvas* canvas) {
+  if (InRow()) {
+    return;  // The row's toolbar paints it across its capsule (PaintIntoRow).
+  }
+  PaintGlow(canvas->sk_canvas(), gfx::RectToSkRect(GetLocalBounds()),
+            GetFieldRadius(), canvas->image_scale());
+}
+
+void ArcLocationBarGlowView::PaintIntoRow(gfx::Canvas* canvas,
+                                          const gfx::Rect& capsule,
+                                          float radius) const {
+  if (!InRow()) {
+    return;
+  }
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  // This view's own canvas is mirrored for RTL (SetFlipCanvasOnPaintForRTLUI);
+  // the toolbar's is not, so the glow is mirrored here to grow from the
+  // leading edge all the same.
+  if (base::i18n::IsRTL()) {
+    canvas->Translate(gfx::Vector2d(2 * capsule.x() + capsule.width(), 0));
+    canvas->Scale(-1, 1);
+  }
+  PaintGlow(canvas->sk_canvas(), gfx::RectToSkRect(capsule), radius,
+            canvas->image_scale());
+}
+
+void ArcLocationBarGlowView::PaintGlow(cc::PaintCanvas* canvas,
+                                       const SkRect& field,
+                                       float radius,
+                                       float device_scale) const {
+  if (!shown_ || field.isEmpty()) {
+    return;
+  }
+  const float opacity =
+      static_cast<float>(std::clamp(frame_.opacity, 0.0, 1.0));
+  if (opacity <= 0.0f) {
+    return;
+  }
+  const float w = field.width();
+  const float h = field.height();
+  // r1010: the row capsule measures the fade behind the head in its own width,
+  // the band in Dia's field heights; both fade in from the leading edge.
+  const helium::LoadingGlowSpan span = InRow()
+                                           ? helium::LoadingGlowRowSpan(w, h)
+                                           : helium::LoadingGlowBandSpan(h);
+  // r1009: Dia's glow is one function of the distance to the progress line
+  // (helium/arc_loading_glow.h), so one shader draws all of it -- body, the
+  // clipped bright bottom row, the scatter ahead of the head and the sheen.
+  std::vector<cc::PaintShader::FloatUniform> floats = {
+      {.name = SkString("u_head"), .value = static_cast<float>(frame_.head * w)},
+      {.name = SkString("u_min_above"),
+       .value = 0.5f / std::max(device_scale, 1.0f)},
+      {.name = SkString("u_k"),
+       .value = static_cast<float>(helium::kLoadingGlowIntensity)},
+      {.name = SkString("u_p"),
+       .value = static_cast<float>(helium::kLoadingGlowFalloff)},
+      {.name = SkString("u_ramp_start"),
+       .value = static_cast<float>(helium::kLoadingGlowRampStart)},
+      {.name = SkString("u_ramp_length"),
+       .value = static_cast<float>(span.ramp)},
+      {.name = SkString("u_fade"), .value = static_cast<float>(span.fade)},
+      {.name = SkString("u_fade_floor"),
+       .value = static_cast<float>(helium::kLoadingGlowStartFadeFloor)},
+      {.name = SkString("u_shine_center"),
+       .value = static_cast<float>(frame_.shine_center.value_or(0.0) * w)},
+      {.name = SkString("u_shine_width"),
+       .value = static_cast<float>(helium::kLoadingGlowShineFwhm / 2.3548 * w)},
+      {.name = SkString("u_shine_k"),
+       .value = frame_.shine_center
+                    ? static_cast<float>(helium::kLoadingGlowShineStrength)
+                    : 0.0f},
+  };
+  std::vector<cc::PaintShader::Float2Uniform> float2s = {
+      {.name = SkString("u_size"), .value = SkV2{w, h}}};
+  std::vector<cc::PaintShader::Float4Uniform> float4s = {
+      {.name = SkString("u_color"),
+       .value = SkV4{helium::kLoadingGlowColorR, helium::kLoadingGlowColorG,
+                     helium::kLoadingGlowColorB, 1.0f}}};
+  sk_sp<cc::PaintShader> shader = cc::PaintShader::MakeSkSLCommand(
+      helium::kLoadingGlowSkSL, std::move(floats), std::move(float2s),
+      std::move(float4s), {}, shader_);
+  if (!shader) {
+    return;  // MakeSkSLCommand has logged why.
+  }
+  shader_ = shader;
+
+  cc::PaintCanvasAutoRestore restore(canvas, /*save=*/true);
+  canvas->clipRRect(SkRRect::MakeRectXY(field, radius, radius),
+                    /*do_anti_alias=*/true);
+  // The fades act on the glow as a unit.
+  canvas->saveLayerAlphaf(field, opacity);
+  canvas->translate(field.x(), field.y());
+  cc::PaintFlags flags;
+  flags.setShader(std::move(shader));
+  canvas->drawRect(SkRect::MakeWH(w, h), flags);
+  canvas->restore();
+}
+
+void ArcLocationBarGlowView::VisibilityChanged(views::View* starting_from,
+                                               bool is_visible) {
+  views::View::VisibilityChanged(starting_from, is_visible);
+  Step();
+}
+
+void ArcLocationBarGlowView::AddedToWidget() {
+  Step();
+}
+
+void ArcLocationBarGlowView::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  // Moving between hosts inside one widget (the composer handing the field
+  // back to the band) shows up here, not in AddedToWidget().
+  Step();
+}
+
+void ArcLocationBarGlowView::DidStartNavigation(
+    content::NavigationHandle* navigation_handle) {
+  if (!navigation_handle->IsInPrimaryMainFrame() ||
+      navigation_handle->IsSameDocument()) {
+    return;
+  }
+  if (!IsEnabled() || !navigation_handle->GetURL().SchemeIsHTTPOrHTTPS()) {
+    model_.Hide();
+  } else {
+    model_.Start(base::TimeTicks::Now());
+  }
+  Step();
+}
+
+void ArcLocationBarGlowView::LoadProgressChanged(double progress) {
+  model_.Progress(progress, base::TimeTicks::Now());
+  Step();
+}
+
+void ArcLocationBarGlowView::DidStopLoading() {
+  model_.Stop(base::TimeTicks::Now());
+  Step();
+}
+
+void ArcLocationBarGlowView::WebContentsDestroyed() {
+  model_.Hide();
+  Step();
+}
+
+void ArcLocationBarGlowView::AnimationProgressed(
+    const gfx::Animation* animation) {
+  Step();
+}
+
+void ArcLocationBarGlowView::AnimationEnded(const gfx::Animation* animation) {
+  // The clock ran its full hour on one load; keep it going while that load
+  // still has a glow up.
+  Step();
+}
+
+BEGIN_METADATA(ArcLocationBarGlowView)
+END_METADATA
