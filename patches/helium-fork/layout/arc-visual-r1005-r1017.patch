+// The shape, against Dia's lossless capture (2026-10-08, 30pt field at 2x,
+// alpha solved from a white and a #14181c page): pixel row k up from the
+// bottom edge sits (k + 0.5) / 2 pt above it.
+constexpr double kField = 30.0;
+double Above(int row) {
+  return (row + 0.5) / 2.0;
+}
+
+// The band's glow `behind` points behind a head far enough along that neither
+// end of the field is in reach -- the readings were taken mid-field.
+constexpr double kHead = 2000.0;
+LoadingGlowPremul DiaAt(double behind, double above, double shine = 0.0) {
+  return LoadingGlowAt(kHead - behind, kHead, above,
+                       LoadingGlowBandSpan(kField), shine);
+}
+
+TEST(ArcLoadingGlowShapeTest, RowsMatchDiaJustBehindTheHead) {
+  // Dia, 16px behind its head: row 1..5, 10, 25, 59.
+  const struct {
+    int row;
+    double alpha;
+  } kDia[] = {{1, 0.854}, {2, 0.623}, {3, 0.510}, {4, 0.439}, {5, 0.389},
+              {10, 0.263}, {25, 0.157}, {59, 0.094}};
+  for (const auto& dia : kDia) {
+    SCOPED_TRACE(testing::Message() << "row " << dia.row);
+    EXPECT_NEAR(DiaAt(8.0, Above(dia.row)).a, dia.alpha,
+                0.012);
+  }
+  // The bottom row is opaque, its colour C pushed past 1 and clipped: sRGB
+  // (110,255,255) in Dia's capture.
+  const LoadingGlowPremul bottom = DiaAt(8.0, Above(0));
+  EXPECT_EQ(bottom.a, 1.0f);
+  EXPECT_NEAR(bottom.r * 255.0, 109.6, 3.0);
+  EXPECT_EQ(bottom.g, 1.0f);
+  EXPECT_EQ(bottom.b, 1.0f);
+  // Every row above it is C itself.
+  const LoadingGlowPremul row1 = DiaAt(8.0, Above(1));
+  EXPECT_NEAR(row1.g / row1.a, kLoadingGlowColorG, 1e-6);
+}
+
+TEST(ArcLoadingGlowShapeTest, FadesBehindTheHeadAsDia) {
+  // Row 1, Dia: 0.846 / 0.786 / 0.705 / 0.616 at 66 / 216 / 416 / 616px
+  // behind the head.
+  const struct {
+    double behind_px;
+    double alpha;
+  } kDia[] = {{66, 0.846}, {216, 0.786}, {416, 0.705}, {616, 0.616}};
+  for (const auto& dia : kDia) {
+    SCOPED_TRACE(testing::Message() << dia.behind_px << "px behind");
+    EXPECT_NEAR(DiaAt(dia.behind_px / 2.0, Above(1)).a, dia.alpha, 0.01);
+  }
+  // Gone about 34 field heights back, never negative.
+  EXPECT_EQ(DiaAt(40.0 * kField, Above(1)).a, 0.0f);
+}
+
+TEST(ArcLoadingGlowShapeTest, AheadOfTheHeadIsTheSameFalloff) {
