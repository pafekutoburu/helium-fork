+TEST(ArcLoadingGlowModelTest, SheenSweepsEveryPeriod) {
+  // Off before its first pass, then crossing the left edge 0.45s in and the
+  // whole field in ~0.55s, then again a period later.
+  EXPECT_FALSE(LoadingGlowShineCenter(base::Milliseconds(100)).has_value());
+  EXPECT_NEAR(*LoadingGlowShineCenter(base::Milliseconds(450)), 0.0, 1e-9);
+  EXPECT_NEAR(*LoadingGlowShineCenter(base::Milliseconds(1000)), 0.99, 1e-9);
+  EXPECT_NEAR(*LoadingGlowShineCenter(base::Milliseconds(1950)), 0.0, 1e-9);
