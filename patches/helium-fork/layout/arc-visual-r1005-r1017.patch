+TEST(ArcComposerTest, BandBoxKeepsTheFieldWhereItRests) {
+  // The card's top strip 4pt inside the window; the field kHeliumBasePadding
+  // (3) inside the card's corner, kArcBandFieldHeight tall, ending before the
+  // trailing buttons (our window at 1200pt wide, the default sidebar).
+  const gfx::Rect band(244, 4, 956, 36);
+  const gfx::Rect slot(247, 7, 820, kArcBandFieldHeight);
+  const gfx::Rect box = ArcComposerBandBounds(band, slot, 4);
+  // r1016: two rows of 44 -- the field's, and an empty second one under it
+  // ("变成双行，其他都不变", the user 2026-10-09). Was 44.
+  EXPECT_EQ(gfx::Rect(231, 0, 836, 88).ToString(), box.ToString());
+  EXPECT_EQ(2, kArcComposerBandRows);
+  EXPECT_EQ(44, ArcComposerBandRowHeight(box));
+  EXPECT_EQ(44, ArcComposerBandFooterHeight(box));
+  EXPECT_EQ(ArcComposerBandRowHeight(box) + ArcComposerBandFooterHeight(box),
+            box.height());
+  EXPECT_EQ(slot.right(), box.right());
+  // The field, placed back into that box, is the slot again.
+  EXPECT_EQ(slot.ToString(), ArcComposerBandFieldBounds(box).ToString());
+  // Centred in the FIRST row: as far from that row's foot as from the box's
+  // top (centred in the whole box it would sit on the seam between the rows).
+  EXPECT_EQ(slot.y() - box.y(),
+            box.y() + ArcComposerBandRowHeight(box) - slot.bottom());
+  EXPECT_LE(slot.bottom(), box.y() + ArcComposerBandRowHeight(box));
+  // And its leading glyph stands in the suggestion list's icon column (the
+  // same 6pt LocationBarView + LocationIconView put in front of it as on the
+  // new tab page, LeadingIconLandsInTheListsColumn).
+  EXPECT_EQ(kArcComposerListIconInset,
+            ArcComposerBandFieldBounds(box).x() +
+                kArcComposerFieldLeadingIconOffset - box.x());
+  // Which puts the box 13pt left of the card: over the 4pt gap and 9pt of the
+  // sidebar ("cmd + L 会盖住侧边栏一部分没关系", the user 2026-10-09).
+  EXPECT_EQ(-13, box.x() - band.x());
+  // The height follows the field, not the new tab page's box.
+  EXPECT_NE(kArcComposerFieldHeight, box.height());
+  EXPECT_TRUE(ArcComposerBandBounds(gfx::Rect(), slot, 4).IsEmpty());
+  EXPECT_TRUE(ArcComposerBandBounds(band, gfx::Rect(), 4).IsEmpty());
+  EXPECT_TRUE(ArcComposerBandFieldBounds(gfx::Rect()).IsEmpty());
+}
+
+// The box's rounded corner has to cover the card's: the shadow is clipped to
+// the card's rect (ArcComposerSideRoomsFor, the painter), so any of the card's
+// corner left outside the box's arc would show the shadow in the notch the
+// user saw. 13pt left and 4pt above, the box's arc centre is (7, 16) inside
+// the card's corner and that corner point is well within the radius.
+TEST(ArcComposerTest, BandBoxCoversTheCardsCorner) {
+  const gfx::Rect band(244, 4, 956, 36);
+  const gfx::Rect slot(247, 7, 820, kArcBandFieldHeight);
+  const gfx::Rect box = ArcComposerBandBounds(band, slot, 4);
+  const int cx = box.x() + kArcComposerRadius;
+  const int cy = box.y() + kArcComposerRadius;
+  const int dx = band.x() - cx;
+  const int dy = band.y() - cy;
+  EXPECT_LT(dx * dx + dy * dy, kArcComposerRadius * kArcComposerRadius);
+}
+
+// r1015: the rooms are signed and the top counts. The band box overhangs the
+// card by 13 on the left and 4 on the top, and that is what the painter clips
+// to -- a room below zero moves the clip inside the box's edge, to the card's.
+TEST(ArcComposerTest, SideRoomsAreCountedPerSideAndSigned) {
+  const gfx::Rect card(244, 4, 956, 800);
+  const ArcComposerSideRooms band =
+      ArcComposerSideRoomsFor(card, gfx::Rect(231, 0, 836, 44));
+  EXPECT_EQ(-13, band.left);
+  EXPECT_EQ(133, band.right);
+  EXPECT_EQ(-4, band.top);
+  const ArcComposerSideRooms mirrored =
+      ArcComposerSideRoomsFor(card, gfx::Rect(274, 0, 1000, 57));
+  EXPECT_EQ(30, mirrored.left);
+  EXPECT_EQ(-74, mirrored.right);
+  const ArcComposerSideRooms inside =
+      ArcComposerSideRoomsFor(card, gfx::Rect(264, 10, 900, 57));
+  EXPECT_EQ(20, inside.left);
+  EXPECT_EQ(36, inside.right);
+  EXPECT_EQ(6, inside.top);
+  EXPECT_EQ(0, ArcComposerSideRoomsFor(gfx::Rect(), card).left);
+  // The new tab page's centred box: both sides the single value, and the top
+  // a third of the page.
+  const gfx::Rect wide(0, 0, 1200, 900);
+  const gfx::Rect box = ArcComposerBounds(wide, 900);
+  const ArcComposerSideRooms centred = ArcComposerSideRoomsFor(wide, box);
+  EXPECT_EQ(ArcComposerSideRoom(wide, box),
+            std::min(centred.left, centred.right));
+  EXPECT_EQ(box.y(), centred.top);
+  // An odd surplus leaves the two a point apart.
+  EXPECT_LE(std::abs(centred.left - centred.right), 1);
+}
+
 }  // namespace helium
