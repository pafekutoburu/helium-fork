--- src.orig/chrome/browser/ui/helium/arc_band_colors.h
+++ src/chrome/browser/ui/helium/arc_band_colors.h
@@ -162,6 +162,47 @@
                                  hovered ? kFieldAlphaHovered : kFieldAlpha);
 }
 
+// helium-fork r1013: the wash behind an icon on the band while the pointer is
+// on it, and the stronger one while it is pressed -- the contrasting colour
+// over `backdrop`, at whatever alpha it takes to stand that far off it.
+//
+// The theme's ink drop colours assume the theme's toolbar, so on a dark page in
+// a light app they were a few levels of grey on black: "地址栏右侧的图标在暗色
+// 网页中，鼠标悬停到这些图标上，背景胶囊特别不明显……不管什么样的背景，都要能
+// 特别清晰地看到icon的背景胶囊" (user 2026-10-08). A fixed alpha cannot keep
+// that promise either -- what reads on white is mush on a mid grey -- so the
+// strength is a contrast to reach (the WCAG ratio color_utils measures), not an
+// amount of ink. 1.40 is a ΔL* of 9-16 across pages -- 13 on white, 15 on
+// black; the theme's hover was 1.17 on white and next to nothing on black.
+//
+// `backdrop` must be the opaque colour the icon is painted on: the band's tint
+// for the toolbar's buttons, LocationBarView::GetFieldBackdropColor() for the
+// field's own icons. Returns the colour with the alpha to paint it at.
+inline constexpr float kBandIconHoverContrast = 1.40f;
+inline constexpr float kBandIconPressedContrast = 1.65f;
+
+inline SkColor GetBandIconWashColor(SkColor backdrop, bool pressed) {
+  backdrop = SkColorSetA(backdrop, SK_AlphaOPAQUE);
+  const SkColor ink = color_utils::GetColorWithMaxContrast(backdrop);
+  const float want =
+      pressed ? kBandIconPressedContrast : kBandIconHoverContrast;
+  // The least alpha whose blend reaches the contrast, tried in the 1/255 steps
+  // it is painted in. Not a bisection on a float: AlphaBlend rounds every
+  // channel, so the contrast is not strictly monotonic in the alpha, and an
+  // alpha rounded up after the search could land under the target (reviewer
+  // r1013: #EB0CC3 pressed, 79/255 gave 1.647). At most 256 tries, once per
+  // highlight.
+  for (int alpha = 0; alpha <= SK_AlphaOPAQUE; ++alpha) {
+    if (color_utils::GetContrastRatio(
+            color_utils::AlphaBlend(ink, backdrop,
+                                    static_cast<SkAlpha>(alpha)),
+            backdrop) >= want) {
+      return SkColorSetA(ink, static_cast<U8CPU>(alpha));
+    }
+  }
+  return ink;
+}
+
