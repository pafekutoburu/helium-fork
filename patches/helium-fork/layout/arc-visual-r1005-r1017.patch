+// the edge fade only ever meets what is already under a level -- and, where
+// the page leaves less room beside it, is drawn smaller rather than cut.
+TEST(ArcSidebarSurfaceTest, ComposerShadowFadesOutInsideItsRoom) {
+  // Darkening (levels of 255) `d` points outside a long edge of the box, for
+  // the light alphas: beside it, or below it (the passes' offsets push down).
+  const auto darkening = [](double d, bool below) {
+    double total = 0;
+    for (const SidebarCardShadowPass& pass : kComposerCardShadowPasses) {
+      const double e = below ? d - pass.offset_y : d + pass.inset_h;
+      total += pass.light_alpha * 255 * 0.5 *
+               std::erfc(e / (pass.sigma * std::sqrt(2.0)));
+    }
+    return total;
+  };
+  // Darker than the rows' shadow at the edge, as asked.
+  EXPECT_GT(darkening(0, false), 14);
+  EXPECT_GT(darkening(0, true), 19);
+  // Where the edge fade begins, less than a level is left to ease off.
+  const CardShadowSpec& spec = kComposerCardShadowSpec;
+  EXPECT_LT(darkening(spec.outset_h - spec.fade_h, false), 0.3);
+  EXPECT_LT(darkening(spec.outset_v - spec.fade_v, true), 1.0);
+  EXPECT_LE(kComposerCardShadowFullRoomH, spec.outset_h - spec.fade_h);
