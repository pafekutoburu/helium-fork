+
+void LocationBarView::ResumeArcComposerEdit(bool require_focus) {
+  arc_composer_edit_deferred_ = false;
+  // Re-checked, not assumed: the press or focus that asked may have been
+  // overtaken -- by deactivation (EndArcFieldEditing cleared the focus, and a
+  // move now would reopen the panel in a background window; macOS has no
+  // inactive-window gate in FocusManager, reviewer r1014 brief r1), by a
+  // blank new tab taking the field, by a mode switch, by the window closing.
+  views::Widget* const widget = GetWidget();
+  if (!widget || widget->IsClosed() || !widget->IsActive() || !omnibox_view_ ||
+      !ToolbarView::IsArcBandHostedFor(this) || !CanArcComposerHostEdit()) {
+    return;
+  }
+  if (require_focus && !omnibox_view_->HasFocus()) {
+    return;
+  }
+  FocusLocation(/*is_user_initiated=*/true, /*clear_focus_if_failed=*/false);
+}
