Index: src/chrome/browser/ui/color/material_chrome_color_mixer.cc
===================================================================
--- src.orig/chrome/browser/ui/color/material_chrome_color_mixer.cc
+++ src/chrome/browser/ui/color/material_chrome_color_mixer.cc
@@ -7,10 +7,12 @@
 #include "base/feature_list.h"
 #include "chrome/browser/ui/color/chrome_color_id.h"
 #include "chrome/browser/ui/color/chrome_color_provider_utils.h"
+#include "chrome/browser/ui/helium/arc_sidebar_surface.h"
 #include "chrome/browser/ui/ui_features.h"
 #include "chrome/grit/theme_resources.h"
 #include "components/compose/buildflags.h"
 #include "ui/color/color_id.h"
+#include "ui/color/color_provider_key.h"
 #include "ui/color/color_mixer.h"
 #include "ui/color/color_provider.h"
 #include "ui/color/color_recipe.h"
@@ -533,8 +535,29 @@ void AddMaterialChromeColorMixer(ui::Col
   }
 
   // Toolbar colors.
-  mixer[kColorToolbar] = {dark_mode ? ui::kColorFrameActive
-                                    : ui::kColorSysBase};
+  // helium-fork: kColorToolbar is the app surface -- the "blue zone" base
+  // that paints the sidebar, the window frame and the gutter around the
+  // content card (BrowserFrameViewMac::OnPaint, the region view's
+  // CustomCornersBackground, BrowserView::FrameColorsChanged), and the input
+  // every wash in chrome/browser/ui/helium/arc_sidebar_surface.h blends
+  // over. Upstream's light baseline is kColorSysBase == pure white; the user
+  // asked for Dia's slightly-gray surface instead (2026-08-20), measured at
+  // #E4E4E4. Only the *unthemed* light appearance is overridden: an extension
+  // theme or any picked/autogenerated/policy color keeps the upstream recipe
+  // and still wins.
+  //
+  // The discriminator is `user_color`, not `user_color_source` -- that field
+  // defaults to kAccent and the browser window's key does not always carry
+  // ThemeService's answer for it, so gating on kBaseline silently disabled
+  // this on a *default* profile (probe-hit 2026-08-20). `user_color` is only
+  // ever set when there really is one (theme_service.cc GetColorProviderKey).
+  const bool use_helium_app_surface =
+      !dark_mode && !key.custom_theme && !key.user_color.has_value();
+  mixer[kColorToolbar] = {
+      dark_mode ? ui::ColorTransform(ui::kColorFrameActive)
+                : (use_helium_app_surface
+                       ? ui::ColorTransform(helium::kArcAppSurfaceLight)
+                       : ui::ColorTransform(ui::kColorSysBase))};
   mixer[kColorToolbarButtonBackgroundHighlightedDefault] = {
       ui::kColorSysStateHoverOnSubtle};
   mixer[kColorToolbarButtonBorder] = {ui::kColorSysOutline};
Index: src/chrome/browser/ui/profiles/profile_colors_util.cc
===================================================================
--- src.orig/chrome/browser/ui/profiles/profile_colors_util.cc
+++ src/chrome/browser/ui/profiles/profile_colors_util.cc
@@ -162,8 +162,25 @@ ProfileThemeColors GetProfileThemeColors
 ProfileThemeColors GetCurrentProfileThemeColors(
     const ui::ColorProvider& color_provider,
     const ThemeService& theme_service) {
+  // helium-fork: Helium 0.20 (#2692) sets the light frame of a built-in theme
+  // to kColorSysBase (white) to match its toolbar
+  // (material_chrome_color_mixer.cc, after the
+  // ShouldApplyChromeMaterialOverrides() guard: no custom theme, normal
+  // contrast). The profile colours are derived from the frame -- the toolbar
+  // avatar's placeholder ring is the highlight's lightness - 0.5, the profile
+  // menu and picker use the rest -- so on 156 the ring went from 154's 105 to
+  // 128. Where that override applies, take the colour it replaced,
+  // kColorSysHeader; a custom theme (ThemeService::GetColorProviderKey's
+  // custom_theme) and high contrast keep kColorFrameActive. Dark mode is not
+  // overridden: there both ids are kColorSysHeader.
+  const bool helium_frame_override =
+      (theme_service.UsingDeviceTheme() || !theme_service.GetThemeSupplier()) &&
+      ui::NativeTheme::GetInstanceForNativeUi()->preferred_contrast() !=
+          ui::NativeTheme::PreferredContrast::kMore;
   return GetProfileThemeColorsFromHighlightColor(
-      color_provider, color_provider.GetColor(ui::kColorFrameActive),
+      color_provider,
+      color_provider.GetColor(helium_frame_override ? ui::kColorSysHeader
+                                                    : ui::kColorFrameActive),
       theme_service.GetUserColor().value_or(SK_ColorTRANSPARENT));
 }
 
