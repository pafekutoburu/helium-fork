@@ -478,8 +480,29 @@ void AddMaterialChromeColorMixer(ui::Col
       ui::kColorSysOnSurfaceSubtle};
 
   // Toolbar colors.
-  mixer[kColorToolbar] = {dark_mode ? ui::kColorFrameActive
-                                    : ui::kColorSysBase};
+  // helium-fork: kColorToolbar is the app surface -- the "blue zone" base
+  // that paints the sidebar, the window frame and the gutter around the
+  // content card (BrowserFrameViewMac::OnPaint, the region view's
+  // CustomCornersBackground, BrowserView::FrameColorsChanged), and the input
+  // every wash in chrome/browser/ui/helium/arc_sidebar_surface.h blends
+  // over. Upstream's light baseline is kColorSysBase == pure white; the user
+  // asked for Dia's slightly-gray surface instead (2026-08-20), measured at
+  // #E4E4E4. Only the *unthemed* light appearance is overridden: an extension
+  // theme or any picked/autogenerated/policy color keeps the upstream recipe
+  // and still wins.
+  //
+  // The discriminator is `user_color`, not `user_color_source` -- that field
+  // defaults to kAccent and the browser window's key does not always carry
+  // ThemeService's answer for it, so gating on kBaseline silently disabled
+  // this on a *default* profile (probe-hit 2026-08-20). `user_color` is only
+  // ever set when there really is one (theme_service.cc GetColorProviderKey).
+  const bool use_helium_app_surface =
+      !dark_mode && !key.custom_theme && !key.user_color.has_value();
+  mixer[kColorToolbar] = {
+      dark_mode ? ui::ColorTransform(ui::kColorFrameActive)
+                : (use_helium_app_surface
+                       ? ui::ColorTransform(helium::kArcAppSurfaceLight)
+                       : ui::ColorTransform(ui::kColorSysBase))};
   mixer[kColorToolbarButtonBackgroundHighlightedDefault] = {
       ui::kColorSysStateHoverOnSubtle};
   mixer[kColorToolbarButtonBorder] = {ui::kColorSysOutline};
