+// helium-fork M6 轮3 3c: points a *restored* (never-loaded) tab's committed
+// entry at |url| without waking it. Extracted from SendRestoredTabHome so
+// Edit Pinned Page > Edit... can reuse it (Arc g26: the open tab follows the
+// edit -- and a sleeping one must follow without loading).
+void RepointRestoredEntry(content::NavigationEntry* nav,
+                          content::WebContents* contents,
+                          const GURL& url,
+                          const std::u16string& title) {
+  std::unique_ptr<content::NavigationEntryRestoreContext> restore_context =
+      content::NavigationEntryRestoreContext::Create();
+  // First, and everything else after it: SetPageState rebuilds the entry's
+  // FrameNavigationEntry from the state's own URL, referrer, method and
+  // redirect chain, clobbering whatever was set before it. The state has to
+  // be replaced at all because it is what the next session save writes out,
+  // and ContentSerializedNavigationBuilder::ToNavigationEntry lets it clobber
+  // the URL on the way back in -- leaving the old one there would resurrect
+  // it exactly one restart later.
+  nav->SetPageState(blink::PageState::CreateFromURL(url),
+                    restore_context.get());
+  nav->SetURL(url);
+  nav->SetVirtualURL(url);
+  // A direct navigation's chain is [url]; SetPageState leaves it empty. The
+  // at-home test falls back to the chain's first element and the chain is
+  // persisted with the entry, so give it the shape a navigation straight to
+  // this URL would have left behind.
+  nav->SetRedirectChain({url});
+  nav->SetTitle(title);
+  nav->SetOriginalRequestURL(GURL());
+  nav->SetTransitionType(ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+
+  // The icon the restore asked for is the old page's, and its reply is still
+  // in flight against the URL just changed (ContentFaviconDriver::
+  // OnFaviconUpdated DCHECKs the two match). Asking again cancels that one.
+  if (favicon::FaviconDriver* const driver =
+          favicon::ContentFaviconDriver::FromWebContents(contents)) {
+    driver->FetchFavicon(url, /*is_same_document=*/false);
+  }
+}
