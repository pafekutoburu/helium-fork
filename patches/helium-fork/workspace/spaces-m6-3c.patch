+void WorkspaceTabController::RepointEntryTab(const std::string& entry_id,
+                                             const GURL& url) {
+  if (!service_ || !url.is_valid()) {
+    return;
+  }
+  const WorkspaceEntry* const entry = service_->FindEntryById(entry_id);
+  tabs::TabInterface* const tab =
+      service_->FindTabForEntryInWindow(entry_id, browser_window_).Get();
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!entry || !contents) {
+    return;  // nothing open here: the row simply points somewhere else now
+  }
+  content::NavigationController& controller = contents->GetController();
+  // 3c (Arc g26): a live tab goes to the new page. A sleeping one is
+  // rewritten in place -- ⛔ nothing here may wake or load a sleeping tab
+  // (3a-r8), and its page still arrives on the click that opens it.
+  if (helium_workspace::IsSleepingTab(contents)) {
+    content::NavigationEntry* const nav = controller.GetLastCommittedEntry();
+    if (nav && !nav->IsInitialEntry()) {
+      RepointRestoredEntry(nav, contents, url, entry->title);
+    }
+    return;
+  }
+  controller.LoadURL(url, content::Referrer(),
+                     ui::PAGE_TRANSITION_AUTO_BOOKMARK, std::string());
+}
