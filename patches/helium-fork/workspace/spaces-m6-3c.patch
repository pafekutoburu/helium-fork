+TEST_F(WorkspaceServiceTest, TurnSpaceBackIntoFolderPutsEverythingBack) {
+  const std::string before = service_->AddEntry(
+      WorkspaceEntry::Section::kPinned, GURL("https://x.example/"), u"X");
+  const std::string folder = service_->AddFolder(u"Research", kDefaultSpaceId);
+  const std::string a = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://a.example/"), u"A");
+  const std::string b = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://b.example/"), u"B");
+  const std::string after = service_->AddEntry(
+      WorkspaceEntry::Section::kPinned, GURL("https://y.example/"), u"Y");
+  ASSERT_TRUE(service_->MoveEntryToFolder(a, folder, 0));
+  ASSERT_TRUE(service_->MoveEntryToFolder(b, folder, 1));
+  auto tab = MakeTab("https://b.example/", window_a());
+  service_->BindTab(tab->GetHandle(), b, /*guessed=*/false);
+  const WorkspaceEntry snapshot = *service_->FindEntryById(folder);
+
+  const std::string space =
+      service_->TurnFolderIntoSpace(folder, kDefaultSpaceId);
+  ASSERT_FALSE(space.empty());
+
+  EXPECT_TRUE(service_->TurnSpaceBackIntoFolder(space, snapshot,
+                                                kDefaultSpaceId, {a, b}));
+  // The folder is back between its old neighbours, its children inside it in
+  // their order, and the binding never moved.
+  EXPECT_THAT(PinnedShape(*service_),
+              ElementsAre(before, folder, folder + "/" + a, folder + "/" + b,
+                          after));
+  const WorkspaceEntry* const back = service_->FindEntryById(folder);
+  ASSERT_TRUE(back);
+  EXPECT_TRUE(back->is_folder());
+  EXPECT_EQ(u"Research", back->title);
+  EXPECT_EQ(folder, service_->FindEntryById(a)->folder_id);
+  EXPECT_EQ(folder, service_->FindEntryById(b)->folder_id);
+  EXPECT_EQ(kDefaultSpaceId, service_->FindEntryById(a)->space_id);
+  EXPECT_EQ(b, service_->FindEntryIdForTab(tab->GetHandle()));
+  // The space it made is empty now, so removing it closes over nothing.
+  EXPECT_THAT(PinnedShapeIn(*service_, space), ElementsAre());
+  EXPECT_TRUE(service_->RemoveSpace(space).has_value());
+  EXPECT_THAT(PinnedShape(*service_),
+              ElementsAre(before, folder, folder + "/" + a, folder + "/" + b,
+                          after));
+}
+
+TEST_F(WorkspaceServiceTest, TurnSpaceBackIntoFolderRefusesATakenId) {
+  const std::string folder = service_->AddFolder(u"Research", kDefaultSpaceId);
+  const std::string a = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://a.example/"), u"A");
+  ASSERT_TRUE(service_->MoveEntryToFolder(a, folder, 0));
+  const WorkspaceEntry snapshot = *service_->FindEntryById(folder);
+  const std::string space =
+      service_->TurnFolderIntoSpace(folder, kDefaultSpaceId);
+  ASSERT_FALSE(space.empty());
+  // A folder of the same id is back (a stale bar, a second undo): refuse.
+  EXPECT_TRUE(service_->TurnSpaceBackIntoFolder(space, snapshot,
