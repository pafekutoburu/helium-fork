+bool WorkspaceService::TurnSpaceBackIntoFolder(
+    const std::string& space_id,
+    const WorkspaceEntry& folder,
+    const std::string& original_space_id,
+    const std::vector<std::string>& children) {
+  if (!folder.is_folder() || !FindSpaceById(space_id) ||
+      !FindSpaceById(original_space_id) || FindEntryById(folder.id)) {
+    return false;
+  }
+  // Only the rows the conversion took, still where it left them, and never a
+  // folder: whatever else the space has gained in the meantime is the user's
+  // and stays (reviewer diff r0 G2). Their order in the space is the order
+  // they had inside the folder.
+  const std::set<std::string> wanted(children.begin(), children.end());
+  int child_position = 0;
+  for (WorkspaceEntry& entry : entries_) {
+    if (entry.section == WorkspaceEntry::Section::kPinned &&
+        entry.space_id == space_id && !entry.is_folder() &&
+        wanted.contains(entry.id)) {
+      entry.space_id = original_space_id;
+      entry.folder_id = folder.id;
+      entry.position = child_position++;
+    }
+  }
+  // The folder goes back to its old slot. RenumberScopes() closed the hole
+  // when it left, so reopen it first -- everything from that slot on shifts
+  // back down one -- and let SortEntries() place the folder (and, behind it,
+  // its children, which sort by their folder's position) by number.
+  for (WorkspaceEntry& entry : entries_) {
+    if (entry.section == WorkspaceEntry::Section::kPinned &&
+        entry.space_id == original_space_id && entry.folder_id.empty() &&
+        entry.position >= folder.position) {
+      ++entry.position;
+    }
+  }
+  WorkspaceEntry restored = folder;
+  restored.space_id = original_space_id;
+  restored.folder_id.clear();
+  entries_.push_back(std::move(restored));
+  SortEntries();
+  RenumberScopes();
+  PersistToPrefs();
+  NotifyChanged();
+  return true;
+}
