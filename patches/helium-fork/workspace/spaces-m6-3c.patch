+void WorkspaceTabController::UndoLastTurnFolderIntoSpace() {
+  if (!service_ || !turn_undo_folder_) {
+    return;
+  }
+  const WorkspaceEntry folder = *turn_undo_folder_;
+  const std::string space_id = turn_undo_space_id_;
+  const std::string origin = turn_undo_origin_space_id_;
+  const std::vector<std::string> children = turn_undo_children_;
+  const std::vector<tabs::TabHandle> tabs = turn_undo_tabs_;
+  turn_undo_folder_.reset();
+  turn_undo_space_id_.clear();
+  turn_undo_origin_space_id_.clear();
+  turn_undo_children_.clear();
+  turn_undo_tabs_.clear();
+  // 1. The rows go home first: they never left the model, so their bindings
+  //    (keyed by entry id) ride along untouched.
+  if (!service_->TurnSpaceBackIntoFolder(space_id, folder, origin, children)) {
+    return;  // the space or the folder's id is someone else's now
+  }
+  // 2. Then the tags, before the space goes -- RemoveSpace() erases every
+  //    tag naming it, and these tabs must keep pointing at |origin|.
+  for (tabs::TabHandle handle : tabs) {
+    if (!handle.Get()) {
