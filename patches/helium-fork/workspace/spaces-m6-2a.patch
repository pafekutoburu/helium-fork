@@ -316,6 +316,106 @@
                                  static_cast<float>(progress));
 }
 
+// helium-fork 2026-09-05 (user M6 轮2 2a-r1 #11): the same recipes as
+// translucent overlays, for the native frame material.
+//
+// Under the glass the sidebar has no colour of its own: kColorToolbar is
+// what the theme *would* paint, the pixels are the desktop through the
+// material (r7: the sidebar transmits its backdrop). A capsule pre-blended
+// over kColorToolbar then lands wherever that arithmetic says, not one step
+// off what is actually behind it -- measured 2026-09-05 on the user's
+// screenshot: a favorites card at 216-219 on a 218-220 sidebar, i.e.
+// invisible, while Dia's card sits 9 levels under its glass. Painting the
+// overlay itself (its colour at its alpha) composites over the real
+// backdrop, so the step is the same on any wallpaper.
+//
+// Each function returns the colour-with-alpha that, composited over
+// `sidebar`, reproduces the opaque recipe above to the level (the tests pin
+// that), and composited over anything else keeps the recipe's step.
+//
+// The composition of two overlays (white at `white_alpha` over the gray
+// wash at `wash_alpha`) is one overlay: alpha = 1 - (1-a1)(1-a2), colour =
+// the alpha-weighted mix. Written out so the hovered card is still one
+// layer (the tween's rule above).
+inline SkColor ComposeOverlays(SkColor top, float top_alpha,
+                               SkColor bottom, float bottom_alpha) {
+  const float alpha = 1.0f - (1.0f - top_alpha) * (1.0f - bottom_alpha);
+  if (alpha <= 0.0f) {
+    return SK_ColorTRANSPARENT;
+  }
+  const float bottom_weight = (1.0f - top_alpha) * bottom_alpha / alpha;
+  const float top_weight = top_alpha / alpha;
+  auto mix = [&](int t, int b) {
+    return static_cast<U8CPU>(std::clamp(
+        static_cast<int>(t * top_weight + b * bottom_weight + 0.5f), 0, 255));
+  };
+  return SkColorSetARGB(static_cast<U8CPU>(alpha * 255.0f + 0.5f),
+                        mix(SkColorGetR(top), SkColorGetR(bottom)),
+                        mix(SkColorGetG(top), SkColorGetG(bottom)),
+                        mix(SkColorGetB(top), SkColorGetB(bottom)));
+}
+
+// A favorites card / the address row: the gray wash at rest, white lifted
+// off that wash when hovered (GetSidebarSurfaceColor's two recipes).
+inline SkColor GetSidebarSurfaceOverlay(SkColor sidebar, bool hovered) {
+  constexpr SkColor kWash = SkColorSetRGB(0xB6, 0xB6, 0xB6);
+  constexpr float kRestAlpha = 0.20f;
+  if (!hovered) {
+    return SkColorSetA(kWash, static_cast<U8CPU>(kRestAlpha * 255.0f + 0.5f));
+  }
+  return ComposeOverlays(SK_ColorWHITE,
+                         color_utils::IsDark(sidebar)
+                             ? kSidebarCardHoverWhiteAlphaDark
+                             : kSidebarCardHoverWhiteAlphaLight,
+                         kWash, kRestAlpha);
+}
+
+// The same part-way through the hover tween (GetSidebarSurfaceColorAt).
+inline SkColor GetSidebarSurfaceOverlayAt(SkColor sidebar, double progress) {
+  const SkColor rest = GetSidebarSurfaceOverlay(sidebar, /*hovered=*/false);
+  const SkColor hovered = GetSidebarSurfaceOverlay(sidebar, /*hovered=*/true);
+  if (progress <= 0.0) {
+    return rest;
+  }
+  if (progress >= 1.0) {
+    return hovered;
+  }
+  // Interpolate colour and alpha in premultiplied space -- the same lerp the
+  // opaque tween runs, minus the backdrop.
+  const float t = static_cast<float>(progress);
+  const float a0 = SkColorGetA(rest) / 255.0f;
+  const float a1 = SkColorGetA(hovered) / 255.0f;
+  const float alpha = a0 + (a1 - a0) * t;
+  if (alpha <= 0.0f) {
+    return SK_ColorTRANSPARENT;
+  }
+  auto lerp = [&](U8CPU c0, U8CPU c1) {
+    const float p = c0 * a0 * (1.0f - t) + c1 * a1 * t;
+    return static_cast<U8CPU>(std::clamp(static_cast<int>(p / alpha + 0.5f), 0, 255));
+  };
+  return SkColorSetARGB(static_cast<U8CPU>(alpha * 255.0f + 0.5f),
+                        lerp(SkColorGetR(rest), SkColorGetR(hovered)),
+                        lerp(SkColorGetG(rest), SkColorGetG(hovered)),
+                        lerp(SkColorGetB(rest), SkColorGetB(hovered)));
+}
+
+// A row with no resting fill, hovered (GetSidebarHoverSurfaceColor).
+inline SkColor GetSidebarHoverSurfaceOverlay(SkColor sidebar) {
+  return SkColorSetA(SK_ColorWHITE,
+                     static_cast<U8CPU>((color_utils::IsDark(sidebar)
+                                             ? kSidebarHoverWhiteAlphaDark
+                                             : kSidebarHoverWhiteAlphaLight) *
+                                            255.0f +
+                                        0.5f));
+}
+
+// The selected favorites card (GetSidebarSelectedSurfaceColor).
+inline SkColor GetSidebarSelectedSurfaceOverlay() {
+  constexpr float kSelectedAlpha = 0.37f;
+  return SkColorSetA(SK_ColorWHITE,
+                     static_cast<U8CPU>(kSelectedAlpha * 255.0f + 0.5f));
+}
+
 // helium-fork M3.10-r1: how the sidebar's own states move.
 //
 // Two motions, both measured off the user's Dia recordings 2026-08-23 by
Index: src/chrome/browser/ui/helium/arc_sidebar_surface_unittest.cc
===================================================================
--- src.orig/chrome/browser/ui/helium/arc_sidebar_surface_unittest.cc
+++ src/chrome/browser/ui/helium/arc_sidebar_surface_unittest.cc
@@ -242,4 +242,57 @@
 }
 
 }  // namespace
+
+// 2026-09-05: the translucent overlays used under the native frame material
+// reproduce the opaque recipes to the level once composited over the same
+// sidebar -- so a theme without the glass and one with it paint the same
+// capsule -- and keep their step over any other backdrop.
+namespace {
+SkColor Over(SkColor overlay, SkColor backdrop) {
+  return color_utils::AlphaBlend(SkColorSetA(overlay, SK_AlphaOPAQUE),
+                                 backdrop, SkColorGetA(overlay) / 255.0f);
+}
+}  // namespace
+
+TEST(ArcSidebarSurfaceTest, TheOverlaysReproduceTheOpaqueRecipes) {
+  for (SkColor sidebar : {kLightSidebar, kDarkSidebar}) {
+    for (bool hovered : {false, true}) {
+      EXPECT_NEAR(Luminance(GetSidebarSurfaceColor(sidebar, hovered)),
+                  Luminance(Over(GetSidebarSurfaceOverlay(sidebar, hovered),
+                                 sidebar)),
+                  1)
+          << "sidebar " << sidebar << " hovered " << hovered;
+    }
+    EXPECT_NEAR(Luminance(GetSidebarHoverSurfaceColor(sidebar)),
+                Luminance(Over(GetSidebarHoverSurfaceOverlay(sidebar), sidebar)),
+                1);
+    EXPECT_NEAR(Luminance(GetSidebarSelectedSurfaceColor(sidebar)),
+                Luminance(Over(GetSidebarSelectedSurfaceOverlay(), sidebar)), 1);
+    for (double progress : {0.0, 0.25, 0.5, 0.75, 1.0}) {
+      EXPECT_NEAR(Luminance(GetSidebarSurfaceColorAt(sidebar, progress)),
+                  Luminance(Over(GetSidebarSurfaceOverlayAt(sidebar, progress),
+                                 sidebar)),
+                  2)
+          << "progress " << progress;
+    }
+  }
+}
+
+TEST(ArcSidebarSurfaceTest, TheOverlaysKeepTheirStepOnAnyBackdrop) {
+  // The user's glass showed (218,220,221) with a card at (216,219,220):
+  // the opaque recipe had landed within two levels. The overlay steps
+  // nine down (Dia: nine), and still steps on a darker desktop.
+  const SkColor glass = SkColorSetRGB(218, 220, 221);
+  EXPECT_LE(Luminance(Over(GetSidebarSurfaceOverlay(kLightSidebar, false),
+                           glass)),
+            Luminance(glass) - 6);
+  const SkColor dark_glass = SkColorSetRGB(90, 96, 110);
+  EXPECT_GE(Luminance(Over(GetSidebarSurfaceOverlay(kLightSidebar, false),
+                           dark_glass)),
+            Luminance(dark_glass) + 6);
+  EXPECT_GE(Luminance(Over(GetSidebarHoverSurfaceOverlay(kLightSidebar),
+                           dark_glass)),
+            Luminance(dark_glass) + 40);
+}
+
 }  // namespace helium
