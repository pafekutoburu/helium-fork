+// One half of the "Emoji | Icon" control: the pill is painted by the
+// picker underneath, the selected half paints its blue over it.
+class HeliumSpaceIconPickerView::SegmentButton : public views::Button {
+  METADATA_HEADER(SegmentButton, views::Button)
+
+ public:
+  SegmentButton(PressedCallback callback, const std::u16string& label)
+      : views::Button(std::move(callback)), label_(label) {
+    SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+    GetViewAccessibility().SetRole(ax::mojom::Role::kTab);
+    GetViewAccessibility().SetName(label);
+    font_ = gfx::FontList().DeriveWithSizeDelta(
+        kSegmentFontSize - gfx::FontList().GetFontSize());
+  }
+
+  void SetSelected(bool selected) {
+    if (selected_ == selected) {
+      return;
+    }
+    selected_ = selected;
+    GetViewAccessibility().SetIsSelected(selected);
+    SchedulePaint();
+  }
+
+  // views::Button:
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    SkColor text = colors->GetColor(ui::kColorLabelForeground);
+    if (selected_) {
+      cc::PaintFlags fill;
+      fill.setStyle(cc::PaintFlags::kFill_Style);
+      fill.setAntiAlias(true);
+      fill.setColor(SkColorSetRGB(helium::kSpaceIconPickerSelectedR,
+                                  helium::kSpaceIconPickerSelectedG,
+                                  helium::kSpaceIconPickerSelectedB));
+      canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()),
+                            helium::kSpaceIconPickerRadius, fill);
+      text = SK_ColorWHITE;
+    }
+    canvas->DrawStringRectWithFlags(label_, font_, text, GetLocalBounds(),
+                                    gfx::Canvas::TEXT_ALIGN_CENTER);
+  }
+
+ private:
+  const std::u16string label_;
+  gfx::FontList font_;
+  bool selected_ = false;
+};
