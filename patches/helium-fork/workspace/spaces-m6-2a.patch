+  }
+  if (const HeliumSessionTabExtraData* const extra =
+          HeliumSessionTabExtraData::FromWebContents(contents)) {
+    const auto it = extra->entries().find(kEntryExtraDataKey);
+    if (it != extra->entries().end() && it->second == value) {
+      return;  // already on record, and BuildCommandsForTab re-emits it
