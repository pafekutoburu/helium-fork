+std::vector<const EmojiEntry*> SearchEmoji(std::string_view query) {
+  const std::string needle = base::ToLowerASCII(
+      base::TrimWhitespaceASCII(query, base::TRIM_ALL));
+  std::vector<const EmojiEntry*> out;
+  for (const EmojiEntry& entry : kEmojiTable) {
