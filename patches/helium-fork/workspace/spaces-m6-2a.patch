+#include "chrome/browser/ui/helium_workspace/workspace_space.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium_workspace {
+namespace {
+
+TEST(WorkspaceSpaceIconNamesTest, ArcsFiftySixUniqueNames) {
+  const base::span<const SpaceIconName> names = SpaceIconNames();
+  EXPECT_EQ(56u, names.size());  // Arc: 8 columns x 7 rows
+  std::set<std::string> seen;
+  for (const SpaceIconName& entry : names) {
+    ASSERT_NE(nullptr, entry.name);
+    ASSERT_NE(nullptr, entry.keywords);
+    EXPECT_NE(std::string(), entry.name);
+    EXPECT_NE(std::string(), entry.keywords);
+    EXPECT_TRUE(seen.insert(entry.name).second) << entry.name;
+    // Names are stable identifiers: lower-case ASCII, no separators that
+    // would read oddly after the "vi:" prefix.
+    for (char c : std::string(entry.name)) {
+      EXPECT_TRUE((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')) << entry.name;
+    }
+  }
+}
+
+TEST(WorkspaceSpaceIconNamesTest, NamesRoundTripThroughTheRef) {
+  for (const SpaceIconName& entry : SpaceIconNames()) {
+    const std::string ref = MakeVectorIconRef(entry.name);
+    EXPECT_TRUE(IsVectorIconRef(ref));
+    EXPECT_EQ(entry.name, VectorIconRefName(ref));
+    EXPECT_TRUE(IsKnownSpaceIconName(VectorIconRefName(ref)));
+  }
+  EXPECT_FALSE(IsKnownSpaceIconName("nope"));
+  EXPECT_FALSE(IsKnownSpaceIconName(""));
+}
+
+}  // namespace
+}  // namespace helium_workspace
