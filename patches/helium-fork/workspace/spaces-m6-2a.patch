+  if (!is_playback_in_progress_ || is_paused_ || !IsPlayerRemoteAvailable()) {
+    return;
+  }
+  OnSuspend(player_id_, /*triggered_by_user=*/true);
+}
+
+void MediaSessionController::RequestResumeOutsideSession() {
+  if (!is_playback_in_progress_ || !is_paused_ || !IsPlayerRemoteAvailable()) {
+    return;
+  }
+  OnResume(player_id_, /*triggered_by_user=*/true);
+}
+
+// helium-fork 2a-r7: the two entry points above are ours and are driven from
+// the browser UI, unlike OnSuspend/OnResume, which the session itself also
+// walks -- so the guard belongs here and *not* there (a guard on the shared
+// path would silently swallow an unmuted pause). Both of them reach
+// GetMediaPlayerRemote(), which is a flat_map::at(): a controller can outlive
+// its remote, since MediaWebContentsObserver::RenderFrameDeleted erases the
+// remotes first, broadcasts MediaDestroyed, and only then erases the
+// controllers. No repro; this is the same check OnSetVolumeMultiplier makes.
+bool MediaSessionController::IsPlayerRemoteAvailable() const {
+  return web_contents_->media_web_contents_observer()
+      ->IsMediaPlayerRemoteAvailable(id_);
+}
