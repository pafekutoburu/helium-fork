+bool WorkspaceTabController::RestoreEntryBindingFromSession(
+    tabs::TabInterface* tab) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  const WorkspaceTabRestoreData* const restored =
+      contents ? WorkspaceTabRestoreData::FromWebContents(contents) : nullptr;
+  // Not consumed here: TagInsertedTab, later in the same notification, still
+  // needs the space out of it and is the one that drops it.
+  if (!restored || !restored->has_entry_record()) {
+    return false;  // old session data, or an arrival with no record at all
+  }
+  // An entry that has been deleted since, or one that already has a tab in
+  // this window, leaves the tab as a Today tab -- and still as one nobody
+  // guesses at.
+  const WorkspaceEntry* const entry =
+      restored->entry_id().empty() ? nullptr
+                                   : service_->FindEntryById(restored->entry_id());
+  // 2a-r6-r2: a record that is only a same-origin guess (pass B's, from some
+  // earlier run) binds the row exactly the same way -- the sidebar must look
+  // the way the user left it -- but is never acted on: no rewrite, and the
+  // mark stays until the tab is at home.
+  const bool guessed = restored->entry_is_guess();
+  if (entry && service_->FindTabForEntryInWindow(entry->id, browser_window_) ==
+                   tabs::TabHandle::Null()) {
+    // Rewritten first, bound second, so the sidebar's first read of the row
+    // (SyncBindings -> PushLiveState) already sees the pinned page.
+    if (restored->from_session_restore() && !guessed) {
+      SendRestoredTabHome(tab, *entry);
+    }
+    // T004-r3: this is where the session record puts the mark back into the
+    // binding, which from here on is the only place it lives. A tab restored
+    // at the entry's own URL settles it at once -- EntryRecordForTab below
+    // does that (and drops the mark from the binding too).
+    BindTabToEntry(tab, entry->id, guessed);
+  }
+  // The record is this window's now. Written straight onto the tab rather
+  // than posted, because AdoptTabsInWindow -- already queued when this
+  // window was built -- reads it to decide whom it may guess at. Unbound
+  // (the entry is gone, or already has a tab here) reads back as the "Today"
+  // sentinel, which is what keeps it out of the guessing passes.
+  WriteTabEntryRecord(tab, EntryRecordForTab(tab, service_));
+  return true;
+}
+
+void WorkspaceTabController::SendRestoredTabHome(tabs::TabInterface* tab,
+                                                 const WorkspaceEntry& entry) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents || !entry.url.is_valid()) {
+    return;
+  }
+  content::NavigationController& controller = contents->GetController();
+  content::NavigationEntry* const nav = controller.GetLastCommittedEntry();
+  // Restored, and its page has not arrived yet: asleep (the usual case --
+  // nothing loads at startup), or, under "continue where you left off", the
+  // one tab whose restore load is already in flight -- LoadIfNecessary makes
+  // the restored entry itself the pending one, which no other tab in a
+  // window this young can be. A live tab is off limits: one dragged in from
+  // another window arrives with history too, and mid-session drift is the
+  // row's "/" state, whose way home is the user's click on the favicon
+  // (M3.10). (Not WebContents::GetLastCommittedURL(): that reads the last
+  // committed *entry*, so a tab with no renderer at all still answers with
+  // the page it was restored at.)
+  if (!nav || nav->IsInitialEntry() ||
+      (!helium_workspace::IsSleepingTab(contents) &&
+       controller.GetPendingEntry() != nav)) {
+    return;
+  }
+  if (helium_workspace::IsAtPinnedUrl(nav->GetURL(), entry.url,
+                                      nav->GetRedirectChain())) {
+    return;  // never left home; restored exactly as it was left
+  }
+
+  // helium-fork 2a-r6 (user 2026-09-06 #2a; Arc measured the same day,
+  // decisions「M6 轮2 2a-r6」): a restart discards the drift. Arc identifies a
+  // pinned or favorite item by the URL it was pinned at -- wherever the tab
+  // wandered lives only in that session, and after a relaunch the row wears
+  // the archived title and opens the original URL (Arc: a pinned youtube.com
+  // left on /watch?v=... came back as "YouTube" and opened youtube.com, still
+  // unloaded). Today rows keep their exact URL: their identity *is* their own
+  // URL.
+  //
+  // 2a-r6-r1: which is why the only caller is RestoreEntryBindingFromSession,
+  // and only for a tab the *session* named this entry's. Nothing is rewritten
+  // on the strength of a same-origin guess: guessing is how a Today tab left
+  // on site/article came back as site/, its page reachable only from history
+  // (reviewer T006, 2026-09-06). 2a-r6-r2: "named this entry's" means a
+  // record without kEntryExtraDataGuessPrefix -- a guess that was written
+  // down is still a guess, however many restarts it has survived.
+  //
+  // The tab is not woken. The restored entry is edited in place and the page
+  // still arrives on the click that activates it (LoadIfNecessary reads the
+  // entry we just rewrote). The pre-quit page is dropped rather than pushed
+  // onto the back stack, as in Arc; it is still in history.
+  std::unique_ptr<content::NavigationEntryRestoreContext> restore_context =
+      content::NavigationEntryRestoreContext::Create();
+  // First, and everything else after it: SetPageState rebuilds the entry's
+  // FrameNavigationEntry from the state's own URL, referrer, method and
+  // redirect chain, clobbering whatever was set before it. The state has to
+  // be replaced at all because it is what the next session save writes out,
+  // and ContentSerializedNavigationBuilder::ToNavigationEntry lets it clobber
+  // the URL on the way back in -- leaving the drifted one there would
+  // resurrect the drift exactly one restart later.
+  nav->SetPageState(blink::PageState::CreateFromURL(entry.url),
+                    restore_context.get());
+  nav->SetURL(entry.url);
+  nav->SetVirtualURL(entry.url);
+  // A direct navigation's chain is [url]; SetPageState leaves it empty. The
+  // at-home test falls back to the chain's first element and the chain is
+  // persisted with the entry, so give it the shape a navigation straight to
+  // the pinned URL would have left behind.
+  nav->SetRedirectChain({entry.url});
+  nav->SetTitle(entry.title);
+  nav->SetOriginalRequestURL(GURL());
+  nav->SetTransitionType(ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+
+  // The icon SessionRestoreDelegate::RestoreTabs asked for is the drifted
+  // page's, and its reply is still in flight against the URL we just
+  // changed (ContentFaviconDriver::OnFaviconUpdated DCHECKs the two match).
+  // Asking again cancels that one and looks up the pinned page instead.
+  if (favicon::FaviconDriver* const driver =
+          favicon::ContentFaviconDriver::FromWebContents(contents)) {
+    driver->FetchFavicon(entry.url, /*is_same_document=*/false);
+  }
+
+  if (!helium_workspace::IsSleepingTab(contents)) {
+    // "Continue where you left off" shows its window's last active tab, and
+    // showing it started the load of the old page before this task ran
+    // (SetActive -> LoadIfNecessary). Reissue it against the pinned URL: the
+    // in-flight request is dropped when this one starts, so the tab loads
+    // one page, the right one.
+    controller.LoadURL(entry.url, content::Referrer(),
+                       ui::PAGE_TRANSITION_AUTO_BOOKMARK, std::string());
+  }
+}
