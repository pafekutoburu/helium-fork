--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/workspace_emoji_table_unittest.cc
@@ -0,0 +1,77 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_emoji_table.h"
+
+#include <string_view>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium_workspace {
+namespace {
+
+constexpr std::string_view kGrinningFace = "\xF0\x9F\x98\x80";  // 😀 U+1F600
+constexpr std::string_view kBeamingFace = "\xF0\x9F\x98\x81";   // 😁 U+1F601
+
+bool Contains(const std::vector<const EmojiEntry*>& hits,
+              std::string_view utf8) {
+  for (const EmojiEntry* e : hits) {
+    if (utf8 == e->utf8) {
+      return true;
+    }
+  }
+  return false;
+}
+
+TEST(WorkspaceEmojiTableTest, TableIsLargeAndWellFormed) {
+  const base::span<const EmojiEntry> table = EmojiTable();
+  EXPECT_GT(table.size(), 1500u);
+  EmojiGroup last = EmojiGroup::kSmileysAndPeople;
+  for (const EmojiEntry& e : table) {
+    EXPECT_NE(std::string_view(), e.utf8);
+    EXPECT_NE(std::string_view(), e.keywords);
+    EXPECT_LT(static_cast<int>(e.group), static_cast<int>(EmojiGroup::kCount));
+    // Contiguous by group, in enum order.
+    EXPECT_GE(static_cast<int>(e.group), static_cast<int>(last));
+    last = e.group;
+  }
+}
+
+TEST(WorkspaceEmojiTableTest, GroupsStartWhereTheySay) {
+  const base::span<const EmojiEntry> table = EmojiTable();
+  EXPECT_EQ(0u, EmojiGroupStart(EmojiGroup::kSmileysAndPeople));
+  size_t previous = 0;
+  for (int g = 0; g < static_cast<int>(EmojiGroup::kCount); ++g) {
+    const EmojiGroup group = static_cast<EmojiGroup>(g);
+    const size_t start = EmojiGroupStart(group);
+    ASSERT_LT(start, table.size());
+    EXPECT_GE(start, previous);
+    EXPECT_EQ(group, table[start].group);
+    if (start > 0) {
+      EXPECT_NE(group, table[start - 1].group);
+    }
+    previous = start;
+  }
+}
+
+TEST(WorkspaceEmojiTableTest, FirstEntryIsGrinningFace) {
+  EXPECT_EQ(kGrinningFace, EmojiTable()[0].utf8);
+}
+
+TEST(WorkspaceEmojiTableTest, SearchMatchesKeywordsCaseInsensitively) {
+  const std::vector<const EmojiEntry*> hits = SearchEmoji("grin");
+  EXPECT_FALSE(hits.empty());
+  EXPECT_TRUE(Contains(hits, kBeamingFace));
+  EXPECT_EQ(hits.size(), SearchEmoji("GRIN").size());
+  EXPECT_EQ(hits.size(), SearchEmoji("  grin ").size());
+  EXPECT_TRUE(SearchEmoji("zzzzqqqq").empty());
+}
+
+TEST(WorkspaceEmojiTableTest, EmptyQueryIsTheWholeTable) {
+  EXPECT_EQ(EmojiTable().size(), SearchEmoji("").size());
+  EXPECT_EQ(EmojiTable().size(), SearchEmoji("   ").size());
+}
+
+}  // namespace
+}  // namespace helium_workspace
