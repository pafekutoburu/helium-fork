+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_space_form.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+// Arc's own sidebar: 257.5pt wide, the sheet from its top row's bottom (31)
+// to the bar's slot top minus the 8pt gap (1042 - 8 = 1034).
+constexpr gfx::Size kArcSheet(257, 1003);
+
+TEST(ArcSpaceFormTest, ColumnsMatchArc) {
+  const SpaceFormLayout l = ComputeSpaceFormLayout(kArcSheet);
+  // Input row and button share Arc's x 15 to 245.5 (231 wide).
+  EXPECT_EQ(15, l.input_row.x());
+  EXPECT_EQ(kArcSheet.width() - 30, l.input_row.width());
+  EXPECT_EQ(l.input_row.x(), l.create_button.x());
+  EXPECT_EQ(l.input_row.width(), l.create_button.width());
+  // The row is the button's height (user 2026-09-05 #2), 38.
+  EXPECT_EQ(38, l.input_row.height());
+  EXPECT_EQ(l.create_button.height(), l.input_row.height());
+  // The icon button is 18 square, centred, and as far from the row's left
+  // edge as from its top: (38 - 18) / 2 = 10 on all three closed sides.
+  EXPECT_EQ(l.input_row.x() + 10, l.icon_button.x());
+  EXPECT_EQ(18, l.icon_button.width());
+  EXPECT_EQ(l.input_row.CenterPoint().y(), l.icon_button.CenterPoint().y());
+  EXPECT_EQ(l.icon_button.y() - l.input_row.y(), l.icon_button.x() - l.input_row.x());
+  // The name field starts 8 clear of the button and ends inside the row.
+  EXPECT_EQ(l.icon_button.right() + 8, l.name_field.x());
+  EXPECT_LE(l.name_field.right(), l.input_row.right());
+  // Illustration centred.
+  EXPECT_EQ(kArcSheet.width() / 2, l.illustration.CenterPoint().x());
+}
+
+TEST(ArcSpaceFormTest, RowsStackTopDownAndButtonsPinToBottom) {
+  const SpaceFormLayout l = ComputeSpaceFormLayout(kArcSheet);
+  EXPECT_LT(l.illustration.bottom(), l.title.y());
+  EXPECT_LT(l.title.bottom(), l.subtitle.y());
+  EXPECT_LT(l.subtitle.bottom(), l.input_row.y());
+  EXPECT_LT(l.input_row.bottom(), l.create_button.y());
+  EXPECT_LT(l.create_button.bottom(), l.cancel.y());
+  EXPECT_EQ(kArcSheet.height() - 44, l.create_button.bottom());
+  EXPECT_LE(l.cancel.bottom(), kArcSheet.height());
+  // Arc: the input row's top is 207 below the sheet's top.
+  EXPECT_EQ(207, l.input_row.y());
+}
+
+TEST(ArcSpaceFormTest, TallerSheetOnlyGrowsTheMiddle) {
+  const SpaceFormLayout a = ComputeSpaceFormLayout(kArcSheet);
+  const SpaceFormLayout b =
+      ComputeSpaceFormLayout(gfx::Size(kArcSheet.width(), kArcSheet.height() + 200));
+  // (gfx::Rect has no PrintTo in this lightweight target: compare strings.)
+  EXPECT_EQ(a.input_row.ToString(), b.input_row.ToString());
+  EXPECT_EQ(a.title.ToString(), b.title.ToString());
+  EXPECT_EQ(a.create_button.y() + 200, b.create_button.y());
+  EXPECT_EQ(a.cancel.y() + 200, b.cancel.y());
+}
+
+TEST(ArcSpaceFormTest, NarrowSheetNeverGoesNegative) {
+  const SpaceFormLayout l = ComputeSpaceFormLayout(gfx::Size(20, 100));
+  EXPECT_GE(l.input_row.width(), 0);
+  EXPECT_GE(l.name_field.width(), 0);
+  EXPECT_GE(l.create_button.width(), 0);
+}
+
+TEST(ArcSpaceFormTest, CreateEnabledOnlyWithAName) {
+  EXPECT_FALSE(SpaceFormCreateEnabled(u""));
+  EXPECT_FALSE(SpaceFormCreateEnabled(u"   "));
+  EXPECT_TRUE(SpaceFormCreateEnabled(u"1"));
+  EXPECT_TRUE(SpaceFormCreateEnabled(u" a "));
+}
+
+}  // namespace
+}  // namespace helium
