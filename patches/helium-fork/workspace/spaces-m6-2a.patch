+// helium-fork M6 轮2: Arc's "Emoji | Icon" popover for a space's icon
+// (decisions.md 「M6 轮2」§3 g19–g21 and 「M6 轮2 2a-r1」§3, geometry in
+// helium/arc_space_icon_picker.h). One picker serves three anchors: the
+// space head row's icon and the Create a Space form's dashed button (the
+// card below them, tail up) and the bottom bar's space icon (the card above
+// it, tail down -- Arc, user recording 2026-09-05). A BrowserView child for
+// the same reason as the "⌄" menu: it is wider than the sidebar and runs
+// out over the page, and every layer between the sidebar and the window
+// masks to bounds. Places itself; the layout never touches it.
+//
+// Shape: a card with a small tail at the anchor, an Emoji | Icon segmented
+// control (plus a trash button when the space has an icon), and per tab:
+// Emoji = a search field (focused on open), one grid *page* per category
+// (2a-r3, user 2026-09-05: Frequently Used first -- blank until something
+// has been used, and where the picker always opens -- then Arc's eight
+// groups; the category bar switches pages, a search shows its hits flat);
+// Icon = a grid of monochrome icons. Picking anything closes the picker
+// and reports it; Escape and any press outside close it and report that
+// instead. No open/close tween (the sidebar's two animations rule).
+//
+// ⛔ The focus never leaves the picker while it is up: hiding the focused
+// search field advanced the focus into the page and lit the page's
+// :focus-visible ring (user 2026-09-05, "网页红框"). Each tab focuses its
+// own content *before* the other tab's is hidden.
+class HeliumSpaceIconPickerView : public views::View,
+                                  public views::TextfieldController,
+                                  public ui::EventObserver {
+  METADATA_HEADER(HeliumSpaceIconPickerView, views::View)
+
+ public:
+  // |icon| is the picked space icon: an emoji, a "vi:<name>" reference, or
+  // "" for the trash (remove the icon).
+  using PickedCallback = base::RepeatingCallback<void(const std::string& icon)>;
+
+  // |prefs| keeps the Frequently Used group (may be null: no such group).
+  explicit HeliumSpaceIconPickerView(PrefService* prefs);
+  HeliumSpaceIconPickerView(const HeliumSpaceIconPickerView&) = delete;
+  HeliumSpaceIconPickerView& operator=(const HeliumSpaceIconPickerView&) =
+      delete;
+  ~HeliumSpaceIconPickerView() override;
+
+  // The parent-owned shadow this card drives (a sibling layer inherits
+  // neither opacity nor visibility -- the "⌄" menu's contract).
+  void SetShadowFrame(HeliumCardShadowView* shadow);
+
+  // Opens for a space whose icon is |current_icon|. |anchor_in_parent| is
+  // the icon slot the tail points at; |body_edge_in_parent| is where the
+  // card's top lands (kBelowAnchor) or its bottom (kAboveAnchor);
+  // |left_in_parent| the sidebar's left edge (the card sits
+  // kSpaceIconPickerLeftInset right of it); all in the parent's
+  // coordinates. |on_closed| runs when the picker goes without a pick
+  // (Escape, a press outside).
+  void Show(const gfx::Rect& anchor_in_parent,
+            helium::SpaceIconPickerPlacement placement,
+            int body_edge_in_parent,
+            int left_in_parent,
+            const std::string& current_icon,
+            PickedCallback on_picked,
+            base::RepeatingClosure on_closed);
+  void Hide();
+  bool IsShowing() const { return shown_; }
+
+  // Whether |screen_point| is on the card (the region's caption test asks).
+  bool ContainsScreenPoint(const gfx::Point& screen_point) const;
+
+  // views::View:
+  void Layout(PassKey) override;
+  void OnPaint(gfx::Canvas* canvas) override;
+  void OnThemeChanged() override;
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override;
+  void VisibilityChanged(views::View* starting_from, bool is_visible) override;
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override;
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override;
+
+ private:
+  class SegmentButton;
+  class SquareImageButton;
+  enum class Tab { kEmoji, kIcon };
