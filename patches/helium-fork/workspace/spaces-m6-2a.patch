+void HeliumSpaceIconPickerView::Show(const gfx::Rect& anchor_in_parent,
+                                     helium::SpaceIconPickerPlacement placement,
+                                     int body_edge_in_parent,
+                                     int left_in_parent,
+                                     const std::string& current_icon,
+                                     PickedCallback on_picked,
+                                     base::RepeatingClosure on_closed) {
+  anchor_in_parent_ = anchor_in_parent;
+  placement_ = placement;
+  body_edge_in_parent_ = body_edge_in_parent;
+  left_in_parent_ = left_in_parent;
+  current_icon_ = current_icon;
+  on_picked_ = std::move(on_picked);
+  on_closed_ = std::move(on_closed);
+  recent_ = ReadRecent();
+  // 2a-r3: the picker opens on the Frequently Used page every time, blank
+  // the first time (user 2026-09-05 #2).
+  page_ = 0;
+  // Arc: the trash only when there is an icon to remove; the tab that
+  // holds the current icon opens.
+  trash_->SetVisible(!current_icon_.empty());
+  search_->SetText(std::u16string());
+  clear_search_->SetVisible(false);
+  // Visible first: SetTab hands the focus to the tab's content, and a view
+  // that is not drawn yet refuses it.
+  if (!shown_) {
+    SetShown(true);
+  } else {
+    UpdateBounds();
+  }
+  DeprecatedLayoutImmediately();
+  RebuildEmojiGlyphs();
+  SetTab(helium_workspace::IsVectorIconRef(current_icon_) ? Tab::kIcon
+                                                          : Tab::kEmoji);
+}
+
+void HeliumSpaceIconPickerView::Hide() {
+  if (shown_) {
+    SetShown(false);
+  }
+}
