+bool WorkspaceEntryView::PreferStoredFavicon(tabs::TabInterface* tab) const {
+  // 2a-r3: a bound tab on the pinned site draws the entry's stored 32px icon
+  // whenever the entry has one. It is the same site's icon, kept by the
+  // controller (written back from the tab on the site, upgraded from the
+  // page's larger candidates when the tab's own is a scaled-up 16 --
+  // WorkspaceTabController::CaptureFavicon), and drawing the one picture
+  // while the tab is open and after it closes is what keeps the row from
+  // changing sharpness between the two (user 2026-09-05 #1; Dia and Arc draw
+  // their per-item 32px cache the same way). Only a tab that has left the
+  // site shows its own live icon, and only an entry with nothing stored at
+  // 32 shows the tab's while on it. 2a-r2's version compared reps instead
+  // and never fired: every tab image has a 2x rep, fabricated or not.
+  if (helium_workspace::WorkspaceFaviconPngWidth(favicon_png_) <
+      helium_workspace::kWorkspaceFaviconPixels) {
+    return false;
+  }
+  return helium_workspace::IsTabOnPinnedSite(tab, url_);
