+void HeliumSpaceCreateFormView::Layout(PassKey) {
+  const helium::SpaceFormLayout l = helium::ComputeSpaceFormLayout(size());
+  title_->SetBoundsRect(l.title);
+  subtitle_->SetBoundsRect(l.subtitle);
+  icon_button_->SetBoundsRect(l.icon_button);
+  // The row's own height, not the Textfield's control height (42 for a
+  // 15pt font): the field must stay inside the capsule it sits in. The
+  // text is centred by the field itself.
+  name_->SetBoundsRect(l.name_field);
+  create_->SetBoundsRect(l.create_button);
+  cancel_->SetBoundsRect(l.cancel);
+}
+
+void HeliumSpaceCreateFormView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  const helium::SpaceFormLayout l = helium::ComputeSpaceFormLayout(size());
+  const SkColor sidebar = colors->GetColor(kColorToolbar);
+
+  // The illustration: three white cards fanned out (Arc's stacked-cards
+  // picture, 65×42, approximated -- decisions 「M6 轮2」§4).
+  {
+    const gfx::RectF box(l.illustration);
+    const float card_w = box.width() * 0.48f;
+    const float card_h = box.height() * 0.92f;
+    const gfx::PointF centre = box.CenterPoint();
+    const float angles[] = {-14.0f, 14.0f, 0.0f};
+    for (float angle : angles) {
+      canvas->Save();
+      gfx::Transform t;
+      t.Translate(centre.x(), centre.y());
+      t.Rotate(angle);
+      t.Translate(-centre.x(), -centre.y());
+      canvas->Transform(t);
+      const gfx::RectF card(centre.x() - card_w / 2, box.y() + (box.height() - card_h) / 2,
+                            card_w, card_h);
+      cc::PaintFlags shadow;
+      shadow.setStyle(cc::PaintFlags::kFill_Style);
+      shadow.setAntiAlias(true);
+      shadow.setColor(SkColorSetA(SK_ColorBLACK, 0x22));
+      gfx::RectF shadow_rect = card;
+      shadow_rect.Offset(0, 1.5f);
+      canvas->DrawRoundRect(shadow_rect, 4.0f, shadow);
+      cc::PaintFlags fill;
+      fill.setStyle(cc::PaintFlags::kFill_Style);
+      fill.setAntiAlias(true);
+      fill.setColor(SK_ColorWHITE);
+      canvas->DrawRoundRect(card, 4.0f, fill);
+      cc::PaintFlags inner;
+      inner.setStyle(cc::PaintFlags::kFill_Style);
+      inner.setAntiAlias(true);
+      inner.setColor(SkColorSetRGB(0x9A, 0x9E, 0xA6));
+      gfx::RectF screen = card;
+      screen.Inset(gfx::InsetsF::TLBR(card_h * 0.22f, card_w * 0.18f,
+                                      card_h * 0.30f, card_w * 0.18f));
+      canvas->DrawRoundRect(screen, 2.0f, inner);
+      canvas->Restore();
+    }
+  }
+
+  // The input row: a white, inset field (user 2026-09-05 #2 "白色的输入框
+  // 凹陷下去的感觉"; Arc g18 paints the row far lighter than its sidebar,
+  // (228,230,243) on (183,189,223)). The picker's search field recipe: white
+  // (a small white lift in a dark theme) under a hairline, one radius.
+  // ⚠ Whether Arc adds an inner shadow was not measured -- the g18 frames
+  // are gone; decisions 「M6 轮2 2a-r1」§4 asks for a fresh recording.
+  const bool dark = color_utils::IsDark(sidebar);
+  cc::PaintFlags row;
+  row.setStyle(cc::PaintFlags::kFill_Style);
+  row.setAntiAlias(true);
+  row.setColor(dark ? color_utils::AlphaBlend(SK_ColorWHITE, sidebar, 0.08f)
+                    : SK_ColorWHITE);
+  canvas->DrawRoundRect(gfx::RectF(l.input_row), helium::kSpaceFormCornerRadius,
+                        row);
+  gfx::RectF row_line(l.input_row);
+  row_line.Inset(0.5f);
+  cc::PaintFlags hair;
+  hair.setStyle(cc::PaintFlags::kStroke_Style);
+  hair.setStrokeWidth(1.0f);
+  hair.setAntiAlias(true);
+  hair.setColor(SkColorSetA(SK_ColorBLACK, 0x1F));
+  canvas->DrawRoundRect(row_line, helium::kSpaceFormCornerRadius - 0.5f, hair);
+}
+
+void HeliumSpaceCreateFormView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  title_->SetEnabledColor(colors->GetColor(ui::kColorLabelForeground));
+  subtitle_->SetEnabledColor(colors->GetColor(ui::kColorLabelForeground));
+  SchedulePaint();
+}
+
+bool HeliumSpaceCreateFormView::AcceleratorPressed(
+    const ui::Accelerator& accelerator) {
+  if (accelerator.key_code() == ui::VKEY_ESCAPE) {
+    on_cancel_.Run();
+    return true;
+  }
+  return false;
+}
+
+bool HeliumSpaceCreateFormView::OnKeyPressed(const ui::KeyEvent& event) {
+  if (event.key_code() == ui::VKEY_ESCAPE) {
+    on_cancel_.Run();
+    return true;
+  }
+  if (event.key_code() == ui::VKEY_RETURN) {
+    OnCreatePressed();
+    return true;
+  }
+  return false;
+}
+
+void HeliumSpaceCreateFormView::AddedToWidget() {
+  views::View::AddedToWidget();
+  // Escape cancels wherever the focus is (the field handles its own).
+  AddAccelerator(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE));
+  // The caret is in the name field from the first frame (user 2026-09-05).
+  FocusNameField();
+}
+
+void HeliumSpaceCreateFormView::ContentsChanged(
+    views::Textfield* sender,
+    const std::u16string& new_contents) {
+  UpdateCreateEnabled();
+}
+
+bool HeliumSpaceCreateFormView::HandleKeyEvent(views::Textfield* sender,
+                                               const ui::KeyEvent& key_event) {
+  if (key_event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  if (key_event.key_code() == ui::VKEY_RETURN) {
+    OnCreatePressed();
+    return true;
+  }
+  if (key_event.key_code() == ui::VKEY_ESCAPE) {
+    on_cancel_.Run();
+    return true;
+  }
+  return false;
+}
+
+void HeliumSpaceCreateFormView::OnIconPressed() {
+  on_pick_icon_.Run(icon_button_, icon_);
+}
+
+void HeliumSpaceCreateFormView::OnCreatePressed() {
+  const std::u16string name(name_->GetText());
+  if (!helium::SpaceFormCreateEnabled(name)) {
+    return;
+  }
+  on_create_.Run(name, icon_);
+}
+
+void HeliumSpaceCreateFormView::UpdateCreateEnabled() {
+  create_->SetEnabled(
+      helium::SpaceFormCreateEnabled(std::u16string(name_->GetText())));
+  create_->SchedulePaint();
+}
+
+BEGIN_METADATA(HeliumSpaceCreateFormView)
+END_METADATA
