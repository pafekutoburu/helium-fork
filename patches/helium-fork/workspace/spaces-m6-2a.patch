+// helium-fork M6 轮2: Arc's "Create a Space" form (decisions.md 「M6 轮2」§3
+// g18/g20, geometry in helium/arc_space_form.h). Arc puts it in place of
+// the whole sidebar below the top row; here it is the sheet the region
+// shows in that slot (VerticalTabStripRegionView::ShowSidebarSheet).
+//
+// Top to bottom: the stacked-cards illustration, "Create a Space", the
+// two-line subtitle, the input row (a dashed "+" button that opens the icon
+// picker, the name field), then -- pinned to the bottom -- the blue Create
+// Space button (grey until the first character) and the Cancel text.
+// Enter creates, Escape cancels, both through the framework's own focus
+// system. Arc's Profile and Theme rows are not here (v2.0 rulings).
+class HeliumSpaceCreateFormView : public views::View,
+                                  public views::TextfieldController {
+  METADATA_HEADER(HeliumSpaceCreateFormView, views::View)
+
+ public:
+  using CreateCallback =
+      base::RepeatingCallback<void(const std::u16string& name,
+                                   const std::string& icon)>;
+  // |anchor| is the dashed button (the picker's tail points at it).
+  using PickIconCallback = base::RepeatingCallback<void(views::View* anchor,
+                                                        const std::string& icon)>;
+
+  HeliumSpaceCreateFormView(CreateCallback on_create,
+                            base::RepeatingClosure on_cancel,
+                            PickIconCallback on_pick_icon);
+  HeliumSpaceCreateFormView(const HeliumSpaceCreateFormView&) = delete;
+  HeliumSpaceCreateFormView& operator=(const HeliumSpaceCreateFormView&) =
+      delete;
+  ~HeliumSpaceCreateFormView() override;
+
+  // The picker's answer: an emoji, a "vi:" reference, or "" (removed).
+  void SetIcon(const std::string& icon);
+  const std::string& icon() const { return icon_; }
+
+  // Puts the caret in the name field.
+  void FocusNameField();
+
+  // views::View:
+  void Layout(PassKey) override;
+  void OnPaint(gfx::Canvas* canvas) override;
+  void OnThemeChanged() override;
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override;
+  bool OnKeyPressed(const ui::KeyEvent& event) override;
+  void AddedToWidget() override;
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override;
+
+ private:
+  class IconButton;
+  class CreateButton;
+
+  void OnIconPressed();
+  void OnCreatePressed();
+  void UpdateCreateEnabled();
+
+  const CreateCallback on_create_;
+  const base::RepeatingClosure on_cancel_;
+  const PickIconCallback on_pick_icon_;
+  std::string icon_;
+
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<views::Label> subtitle_ = nullptr;
+  raw_ptr<IconButton> icon_button_ = nullptr;
+  raw_ptr<views::Textfield> name_ = nullptr;
+  raw_ptr<CreateButton> create_ = nullptr;
+  raw_ptr<views::LabelButton> cancel_ = nullptr;
+};
+
