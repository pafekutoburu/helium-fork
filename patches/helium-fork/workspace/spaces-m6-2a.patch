+bool HeliumSpaceIconPickerView::ContainsScreenPoint(
+    const gfx::Point& screen_point) const {
+  return shown_ && GetBoundsInScreen().Contains(screen_point);
+}
+
+void HeliumSpaceIconPickerView::SetShown(bool shown) {
+  shown_ = shown;
+  if (shown) {
+    SetVisible(true);
+    UpdateBounds();
+    AddAccelerator(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE));
+    if (views::Widget* widget = GetWidget()) {
+      event_monitor_ = views::EventMonitor::CreateWindowMonitor(
+          this, widget->GetNativeWindow(),
+          {ui::EventType::kMousePressed, ui::EventType::kTouchPressed});
+    }
+    if (shadow_frame_) {
+      shadow_frame_->SetVisible(true);
+      shadow_frame_->SetShadowOpacity(1.0);
+    }
+  } else {
+    ResetAccelerators();
+    event_monitor_.reset();
+    on_picked_.Reset();
+    // Cleared, never advanced: advancing is what lands on the page (see the
+    // class comment). Whoever opened the picker puts the focus back where
+    // it belongs through |on_closed| (the form: its name field).
+    if (views::FocusManager* focus = GetFocusManager();
+        focus && Contains(focus->GetFocusedView())) {
+      focus->ClearFocus();
+    }
+    SetVisible(false);
+    if (shadow_frame_) {
+      shadow_frame_->SetVisible(false);
+    }
+    base::RepeatingClosure closed = std::move(on_closed_);
+    on_closed_.Reset();
+    if (closed) {
+      closed.Run();
+    }
+  }
+}
