+
+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_COMMON_WORKSPACE_SPACE_MENU_MODEL_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_COMMON_WORKSPACE_SPACE_MENU_MODEL_H_
+
+#include "base/functional/callback.h"
+#include "ui/menus/simple_menu_model.h"
+
+// The space menu's commands (M6-r1; Arc 轮0 g3 f_00650/f_01050 and g10
+// f_00540: the head row's "···", its right-click and the bottom icon's
+// right-click are one and the same menu). Local commands: the caller
+// executes them, they are never in the browser command table -- the entry
+// and folder menus' pattern. Listed in Arc's order.
+enum class WorkspaceSpaceMenuCommand {
+  kChangeIcon = 1,  // Change Space Icon…  (M6 轮2 2a)
+  kRename,          // Rename Space…
+  kNewFolder,       // New Folder
+  kManageSpaces,    // Manage Spaces…     (M6 轮2 2b)
+  kDelete,          // Delete Space
+};
+
+// One model class for every host of the space menu, so the head row and the
+// bottom bar cannot drift apart (they each carried a copy until M6 轮2).
+// The delegate hands the command back through |on_command|.
+class WorkspaceSpaceMenuModel : public ui::SimpleMenuModel,
+                                public ui::SimpleMenuModel::Delegate {
+ public:
+  using CommandCallback =
+      base::RepeatingCallback<void(WorkspaceSpaceMenuCommand)>;
+
+  explicit WorkspaceSpaceMenuModel(CommandCallback on_command);
+  WorkspaceSpaceMenuModel(const WorkspaceSpaceMenuModel&) = delete;
+  WorkspaceSpaceMenuModel& operator=(const WorkspaceSpaceMenuModel&) = delete;
+  ~WorkspaceSpaceMenuModel() override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  const CommandCallback on_command_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_WORKSPACE_SPACE_MENU_MODEL_H_
