+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_EMOJI_TABLE_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_EMOJI_TABLE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+
+namespace helium_workspace {
+
+// The space icon picker's Emoji tab (M6 轮2). Data = Chromium's own emoji
+// list (chrome/browser/resources/skills/emoji_data.ts, shipped in the mac
+// build but only as TypeScript), turned into a C++ table once by
+// tools/gen_emoji_table.py -- mac has no native picker with a callback
+// ([NSApp orderFrontCharacterPalette:] only inserts into a text field).
+//
+// Groups follow Arc's category bar (轮0 g2c f_00555: 😊 ☀ ☕ 🏅 🚌 🎁 ♡ ⚑),
+// with Smileys and People merged into the first. The table is contiguous
+// by group in this order.
+enum class EmojiGroup : uint8_t {
+  kSmileysAndPeople,
+  kAnimalsAndNature,
+  kFoodAndDrink,
+  kActivities,
+  kTravelAndPlaces,
+  kObjects,
+  kSymbols,
+  kFlags,
+  kCount,
+};
+
+struct EmojiEntry {
+  const char* utf8;      // the emoji, one base sequence, no skin tone
+  const char* keywords;  // lower-case ASCII search words, space separated
+  EmojiGroup group;
+};
+
+// Every base emoji, grouped as above.
+base::span<const EmojiEntry> EmojiTable();
+
+// Index into EmojiTable() of the first entry of |group|.
+size_t EmojiGroupStart(EmojiGroup group);
+
+// Entries whose keywords contain |query| (ASCII case-insensitive, outer
+// whitespace ignored); the whole table for an empty query.
+std::vector<const EmojiEntry*> SearchEmoji(std::string_view query);
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_EMOJI_TABLE_H_
