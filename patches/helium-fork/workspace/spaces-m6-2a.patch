+// The dashed "+" square (Arc g18: 18×18, dashed hairline, a "+" inside);
+// once an icon is chosen it shows that instead, no dashes (g20 f_01260).
+class HeliumSpaceCreateFormView::IconButton : public views::Button {
+  METADATA_HEADER(IconButton, views::Button)
+
+ public:
+  explicit IconButton(PressedCallback callback)
+      : views::Button(std::move(callback)) {
+    SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+    GetViewAccessibility().SetRole(ax::mojom::Role::kButton);
+    GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_FORM_ICON_BUTTON));
+    SetTooltipText(
+        l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_FORM_ICON_BUTTON));
+    emoji_font_ = gfx::FontList().DeriveWithSizeDelta(
+        kIconGlyphSize - 3 - gfx::FontList().GetFontSize());
+  }
+
+  void SetIcon(const std::string& icon) {
+    icon_ = icon;
+    SchedulePaint();
+  }
+
+  // views::Button:
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    const SkColor fg = colors->GetColor(ui::kColorLabelForegroundSecondary);
+    const gfx::Rect bounds = GetLocalBounds();
+    if (icon_.empty()) {
+      // Dashed square, radius the shell's one (a 12 radius on an 18 square
+      // is a capsule -- the user's rule has no size exception).
+      cc::PaintFlags dashed;
+      dashed.setStyle(cc::PaintFlags::kStroke_Style);
+      dashed.setStrokeWidth(1.0f);
+      dashed.setAntiAlias(true);
+      dashed.setColor(fg);
+      const float intervals[] = {2.5f, 2.0f};
+      dashed.setPathEffect(cc::PathEffect::MakeDash(intervals, 2, 0.0f));
+      gfx::RectF inset(bounds);
+      inset.Inset(0.5f);
+      canvas->DrawRoundRect(inset, helium::kSpaceFormCornerRadius - 0.5f, dashed);
+      const gfx::ImageSkia plus =
+          gfx::CreateVectorIcon(SpaceFormPlusIcon(), 10, fg);
+      canvas->DrawImageInt(plus, (bounds.width() - plus.width()) / 2,
+                           (bounds.height() - plus.height()) / 2);
+      return;
+    }
+    if (helium_workspace::IsVectorIconRef(icon_)) {
+      if (const gfx::VectorIcon* icon =
+              FindSpaceVectorIcon(helium_workspace::VectorIconRefName(icon_))) {
+        const gfx::ImageSkia image =
+            gfx::CreateVectorIcon(*icon, kIconGlyphSize, fg);
+        canvas->DrawImageInt(image, (bounds.width() - image.width()) / 2,
+                             (bounds.height() - image.height()) / 2);
+      }
+      return;
+    }
+    canvas->DrawStringRectWithFlags(
+        base::UTF8ToUTF16(icon_), emoji_font_,
+        colors->GetColor(ui::kColorLabelForeground), bounds,
+        gfx::Canvas::TEXT_ALIGN_CENTER);
+  }
+
+ private:
+  std::string icon_;
+  gfx::FontList emoji_font_;
+};
