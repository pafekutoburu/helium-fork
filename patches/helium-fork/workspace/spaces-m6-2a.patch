--- /dev/null
+++ src/chrome/browser/ui/helium/arc_space_form.h
@@ -0,0 +1,140 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_SPACE_FORM_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_SPACE_FORM_H_
+
+#include <algorithm>
+
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+// helium-fork M6 轮2: the "Create a Space" form -- Arc's, measured on the
+// spot 2026-09-04 (decisions.md 「M6 轮2」§3 g18, 2x px / 2; Arc sidebar
+// 257.5pt wide, its top row ending at y 31). Arc replaces the whole sidebar
+// below the top row with this form: address row, favorites, head row, list
+// and New Tab all go; the traffic lights and ←/→/⟳ stay, and the bottom
+// space bar stays but changes shape (workspace_space_bar_view.h). We do the
+// same as a "sheet" the region shows in place of those children.
+//
+// Numbers are offsets from the sheet's own top (Arc's y minus 31) and from
+// its bottom (the sheet ends where the space bar's slot begins, 8pt above
+// it -- kBottomContainerGap -- which is why the bottom insets below are
+// Arc's distance to the bar's slot minus that 8).
+//
+// Header-only and free of //ui/views on purpose, like every other arc_*.h:
+// asserted in helium_workspace_unittests.
+namespace helium {
+
+// Every rounded rect in the shell is 12 (user rule 2026-09-03; Arc's rows
+// and button are ~5). Literal, this header stays free of //ui/views.
+inline constexpr int kSpaceFormCornerRadius = 12;
+
+// Arc: the input row and the button run x 15–245.5 in a 257.5 sidebar.
+inline constexpr int kSpaceFormSideInset = 15;
+// The stacked-cards illustration: 65×42, top at Arc y 81.
+inline constexpr int kSpaceFormIllustrationTop = 50;
+inline constexpr int kSpaceFormIllustrationWidth = 65;
+inline constexpr int kSpaceFormIllustrationHeight = 42;
+// "Create a Space": cap height 13pt (≈18pt bold), cap top at Arc y 143.5.
+inline constexpr int kSpaceFormTitleFontSize = 18;
+inline constexpr int kSpaceFormTitleTop = 108;
+inline constexpr int kSpaceFormTitleHeight = 24;
+// Two subtitle lines (≈14pt), 17pt apart, cap tops at Arc y 174.5 / 191.5.
+inline constexpr int kSpaceFormSubtitleFontSize = 14;
+inline constexpr int kSpaceFormSubtitleTop = 140;
+inline constexpr int kSpaceFormSubtitleLineHeight = 17;
+inline constexpr int kSpaceFormSubtitleLines = 2;
+// The input row: Arc y 238–271.5, i.e. 34 tall -- ours is the Create
+// button's 38 (user 2026-09-05 #2: the row and the button share one size).
+inline constexpr int kSpaceFormInputTop = 207;
+inline constexpr int kSpaceFormInputHeight = 38;
+// The dashed "+" icon button inside it: 18×18, vertically centred, and as
+// far in from the row's left as it is from its top and bottom (Arc 7 in a
+// 34 row; the user's equal-margins rule for a capsule on a capsule's edge,
+// 2026-09-03). The placeholder keeps Arc's 8 clear of the button.
+inline constexpr int kSpaceFormIconButtonSize = 18;
+inline constexpr int kSpaceFormIconButtonInset =
+    (kSpaceFormInputHeight - kSpaceFormIconButtonSize) / 2;
+inline constexpr int kSpaceFormNameFieldX =
+    kSpaceFormIconButtonInset + kSpaceFormIconButtonSize + 8;
+inline constexpr int kSpaceFormNameFieldTrailingInset = 8;
+inline constexpr int kSpaceFormPlaceholderFontSize = 15;
+// "Create Space": 38 tall, its bottom 52.5 above the bar's slot top (Arc
+// 989.5 vs 1042), so 44.5 above the sheet's bottom.
+inline constexpr int kSpaceFormCreateHeight = 38;
+inline constexpr int kSpaceFormCreateBottomInset = 44;
+inline constexpr int kSpaceFormCreateFontSize = 13;
+// "Cancel": plain 12pt text, its cap top 16 below the button's bottom.
+inline constexpr int kSpaceFormCancelGap = 12;
+inline constexpr int kSpaceFormCancelHeight = 20;
+inline constexpr int kSpaceFormCancelFontSize = 12;
+
+// Arc's Create Space button: (32,42,254) enabled; disabled it is the same
+// blue at ~0.45 over the sidebar, its label white at ~0.5.
+inline constexpr unsigned kSpaceFormCreateR = 32;
+inline constexpr unsigned kSpaceFormCreateG = 42;
+inline constexpr unsigned kSpaceFormCreateB = 254;
+inline constexpr float kSpaceFormCreateDisabledAlpha = 0.45f;
+inline constexpr float kSpaceFormCreateDisabledTextAlpha = 0.5f;
+
+// The form's rectangles for a sheet of |size|. Everything is centred or
+// side-inset; the stretch between the input row and the button is what
+// absorbs the sheet's height (Arc: empty space).
+struct SpaceFormLayout {
+  gfx::Rect illustration;
+  gfx::Rect title;
+  gfx::Rect subtitle;
+  gfx::Rect input_row;
+  gfx::Rect icon_button;
+  gfx::Rect name_field;
+  gfx::Rect create_button;
+  gfx::Rect cancel;
+};
+
+inline SpaceFormLayout ComputeSpaceFormLayout(const gfx::Size& size) {
+  SpaceFormLayout out;
+  const int w = std::max(size.width(), 0);
+  const int h = std::max(size.height(), 0);
+  out.illustration =
+      gfx::Rect((w - kSpaceFormIllustrationWidth) / 2, kSpaceFormIllustrationTop,
+                kSpaceFormIllustrationWidth, kSpaceFormIllustrationHeight);
+  out.title = gfx::Rect(0, kSpaceFormTitleTop, w, kSpaceFormTitleHeight);
+  out.subtitle = gfx::Rect(0, kSpaceFormSubtitleTop, w,
+                           kSpaceFormSubtitleLines * kSpaceFormSubtitleLineHeight);
+  const int inner_w = std::max(w - 2 * kSpaceFormSideInset, 0);
+  out.input_row = gfx::Rect(kSpaceFormSideInset, kSpaceFormInputTop, inner_w,
+                            kSpaceFormInputHeight);
+  out.icon_button = gfx::Rect(
+      out.input_row.x() + kSpaceFormIconButtonInset,
+      out.input_row.y() + (kSpaceFormInputHeight - kSpaceFormIconButtonSize) / 2,
+      kSpaceFormIconButtonSize, kSpaceFormIconButtonSize);
+  out.name_field = gfx::Rect(
+      out.input_row.x() + kSpaceFormNameFieldX, out.input_row.y(),
+      std::max(inner_w - kSpaceFormNameFieldX - kSpaceFormNameFieldTrailingInset,
+               0),
+      kSpaceFormInputHeight);
+  const int create_bottom = h - kSpaceFormCreateBottomInset;
+  out.create_button =
+      gfx::Rect(kSpaceFormSideInset, create_bottom - kSpaceFormCreateHeight,
+                inner_w, kSpaceFormCreateHeight);
+  out.cancel = gfx::Rect(0, create_bottom + kSpaceFormCancelGap, w,
+                         kSpaceFormCancelHeight);
+  return out;
+}
+
+// Whether "Create Space" is enabled for |name| (Arc: grey until the first
+// character; whitespace alone does not count).
+inline bool SpaceFormCreateEnabled(std::u16string_view name) {
+  for (char16_t c : name) {
+    if (c != u' ' && c != u'\t' && c != u'\n' && c != u'\r') {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_SPACE_FORM_H_
