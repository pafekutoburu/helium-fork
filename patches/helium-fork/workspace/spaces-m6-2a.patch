+// helium-fork M6 轮2 2a-r2: the space icon picker's glyph buttons -- the
+// category bar, the trash, the search field's two glyphs -- drawn with the
+// system's symbol font. Arc's category bar is that font's outline glyphs
+// (14pt, 2026-09-04 g19); ours were vector icons authored on a 24 grid and
+// drawn at 16, whose thin rings landed between pixels at 2x and came out
+// uneven (user 2026-09-05 #3 "线条断断续续"). The system rasterises its own
+// symbols, hinted, at any size.
+namespace helium {
+
+// |name| is an SF Symbol name ("face.smiling"). The glyph is rasterised at
+// |point_size| in the regular weight, boxed to whole points and tinted
+// |color|, with a rep per supported scale. Null when the symbol does not
+// exist on this system (or off macOS) -- callers keep a vector icon for that.
+#if BUILDFLAG(IS_MAC)
+gfx::ImageSkia CreateSFSymbolImage(std::string_view name,
+                                   double point_size,
+                                   SkColor color);
+#else
+inline gfx::ImageSkia CreateSFSymbolImage(std::string_view name,
+                                          double point_size,
+                                          SkColor color) {
+  return gfx::ImageSkia();
+}
+#endif
+
+}  // namespace helium
