+// An icon button with the bar's hover square instead of an ink drop (the
+// trash, the search's clear button, the category bar). Its glyph is the
+// system's symbol |symbol| where that exists (helium_sf_symbol_image.h),
+// else the vector |icon|.
+class HeliumSpaceIconPickerView::SquareImageButton : public views::ImageButton {
+  METADATA_HEADER(SquareImageButton, views::ImageButton)
+
+ public:
+  SquareImageButton(PressedCallback callback,
+                    std::string_view symbol,
+                    const gfx::VectorIcon& icon,
+                    int size,
+                    const std::u16string& name)
+      : views::ImageButton(std::move(callback)),
+        symbol_(symbol),
+        icon_(&icon),
+        size_(size) {
+    views::ConfigureVectorImageButton(this);
+    views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::OFF);
+    SetHasInkDropActionOnClick(false);
+    SetTooltipText(name);
+    GetViewAccessibility().SetName(name);
+  }
+
+  // 2a-r3: the category bar marks the page on show with the same square a
+  // hover paints (our ruling -- Arc's bar has no selected state we
+  // measured).
+  void SetSelected(bool selected) {
+    if (selected_ == selected) {
+      return;
+    }
+    selected_ = selected;
+    GetViewAccessibility().SetIsSelected(selected);
+    SchedulePaint();
+  }
+
+  // views::ImageButton:
+  void OnThemeChanged() override {
+    views::ImageButton::OnThemeChanged();
+    const ui::ColorProvider* cp = GetColorProvider();
+    const gfx::ImageSkia normal = helium::CreateSFSymbolImage(
+        symbol_, size_, cp->GetColor(ui::kColorIcon));
+    if (!normal.isNull()) {
+      const gfx::ImageSkia hovered = helium::CreateSFSymbolImage(
+          symbol_, size_, cp->GetColor(ui::kColorIconHovered));
+      SetImageModel(STATE_NORMAL, ui::ImageModel::FromImageSkia(normal));
+      SetImageModel(STATE_HOVERED, ui::ImageModel::FromImageSkia(hovered));
+      SetImageModel(STATE_PRESSED, ui::ImageModel::FromImageSkia(hovered));
+      SetImageModel(STATE_DISABLED,
+                    ui::ImageModel::FromImageSkia(helium::CreateSFSymbolImage(
+                        symbol_, size_, cp->GetColor(ui::kColorIconDisabled))));
+      return;
+    }
+    views::SetImageFromVectorIconWithColor(
+        this, *icon_, size_,
+        {cp->GetColor(ui::kColorIcon), cp->GetColor(ui::kColorIconDisabled),
+         ui::kColorIconHovered});
+  }
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    views::ImageButton::OnPaintBackground(canvas);
+    if (!selected_ && GetState() != STATE_HOVERED &&
+        GetState() != STATE_PRESSED) {
+      return;
+    }
+    const ui::ColorProvider* colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    cc::PaintFlags fill;
+    fill.setStyle(cc::PaintFlags::kFill_Style);
+    fill.setAntiAlias(true);
+    fill.setColor(TintOverCard(CardColor(colors),
+                               helium::kSpaceIconPickerSquareAlphaLight,
+                               helium::kSpaceIconPickerSquareAlphaDark));
+    canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()),
+                          helium::kSpaceIconPickerRadius, fill);
+  }
+
+ private:
+  const std::string symbol_;
+  const raw_ptr<const gfx::VectorIcon> icon_;
+  const int size_;
+  bool selected_ = false;
+};
