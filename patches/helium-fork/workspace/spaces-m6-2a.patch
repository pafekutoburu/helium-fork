+
+void VerticalTabStripRegionView::ShowSpaceCreateForm() {
+  if (create_form_) {
+    return;
+  }
+  auto form = std::make_unique<HeliumSpaceCreateFormView>(
+      base::BindRepeating(&VerticalTabStripRegionView::OnCreateFormCreate,
+                          base::Unretained(this)),
+      base::BindRepeating(&VerticalTabStripRegionView::OnCreateFormCancel,
+                          base::Unretained(this)),
+      base::BindRepeating(&VerticalTabStripRegionView::OnCreateFormPickIcon,
+                          base::Unretained(this)));
+  create_form_ = form.get();
+  ShowSidebarSheet(std::move(form));
+}
+
+void VerticalTabStripRegionView::ShowSidebarSheet(
+    std::unique_ptr<views::View> sheet) {
+  CloseSidebarSheet();
+  // Right after the address row, before the tab strip: the flex layout
+  // runs children in order, and the sheet takes all the height the hidden
+  // lists and New Tab button would have (kUnbounded, the bottom container's
+  // spec). By the row's own index, not a literal: the shadow hosts are
+  // inserted at 0 after the top row and push everything down (probe-hit
+  // 2026-09-04: a literal 2 put the sheet above the top row). No horizontal
+  // margin: the form's own 15pt inset is Arc's, from the sidebar's edge.
+  const size_t index =
+      arc_address_row_ ? GetIndexOf(arc_address_row_).value() + 1 : 0;
+  sheet_ = AddChildViewAt(std::move(sheet), index);
+  sheet_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kPreferred,
+                               views::MaximumFlexSizeRule::kUnbounded));
+  ApplySheetVisibility(/*sheet_shown=*/true);
+  InvalidateLayout();
+}
+
+void VerticalTabStripRegionView::CloseSidebarSheet() {
+  if (!sheet_) {
+    return;
+  }
+  if (BrowserView* const view = browser_view()) {
+    view->HideHeliumSpaceIconPicker();
+  }
+  views::View* const sheet = sheet_;
+  sheet_ = nullptr;
+  create_form_ = nullptr;
+  RemoveChildViewT(sheet);
+  ApplySheetVisibility(/*sheet_shown=*/false);
+  InvalidateLayout();
+}
+
+void VerticalTabStripRegionView::ApplySheetVisibility(bool sheet_shown) {
+  // Arc g18: everything below the top row goes -- the address row, the
+  // favorites, the head row, the lists, New Tab -- and the bar changes
+  // shape. SetVisible rather than a cover: an invisible child is neither
+  // laid out nor moved, so the two animating containers see no bounds
+  // change on the way back and start no tween (M6-r2: the Today
+  // container's InvalidateLayout *is* an animation); snap to be sure.
+  const bool shown = !sheet_shown;
+  if (arc_address_row_) {
+    arc_address_row_->SetVisible(shown);
+  }
+  if (TabStripView* const strip = tab_strip_view()) {
+    strip->SetVisible(shown);
+  }
+  if (bottom_button_container_) {
+    bottom_button_container_->SetVisible(shown);
+  }
+  if (row_shadow_host_) {
+    row_shadow_host_->SetVisible(shown);
+  }
+  if (undo_bar_ && sheet_shown) {
+    undo_bar_->Dismiss();
+  }
+  if (space_bar_) {
+    space_bar_->SetFormMode(sheet_shown);
+  }
+  UpdateMediaStripVisibility();
+  if (shown && tab_strip_view()) {
+    if (PinnedTabContainerView* const pinned =
+            tab_strip_view()->GetPinnedTabsContainer()) {
+      pinned->SnapLayoutToTarget();
+    }
+    if (UnpinnedTabContainerView* const unpinned =
+            tab_strip_view()->GetUnpinnedTabsContainer()) {
+      unpinned->SnapLayoutToTarget();
+    }
+  }
+}
+
+void VerticalTabStripRegionView::OnCreateFormCreate(const std::u16string& name,
+                                                    const std::string& icon) {
+  // ⛔ Copies first: both arguments are references into the form
+  // (OnCreatePressed passes its icon_ member straight through), and closing
+  // the sheet destroys the form. Reading |icon| after CloseSidebarSheet()
+  // was the 2026-09-05 crash (std::length_error out of AddSpace's
+  // `space.icon = icon`, twice on the user's machine; the probe never picked
+  // an icon, so its freed empty string still read as empty).
+  const std::u16string name_copy = name;
+  const std::string icon_copy = icon;
+  // Close first so the carousel finds the lists back in place; the switch
+  // then slides the new space in (Arc g20: instant landing for us, the fold
+  // animation is round 4).
+  CloseSidebarSheet();
+  if (helium_workspace::WorkspaceTabController* const controller =
+          helium_workspace::WorkspaceTabController::From(
+              browser_view()->browser())) {
+    controller->CreateSpaceFromForm(name_copy, icon_copy);
+  }
