+  EXPECT_FALSE(IsOnPinnedSite(GURL("https://classical.music.apple.com:8443/us"), pinned));
+  EXPECT_FALSE(IsOnPinnedSite(GURL(), pinned));
+  EXPECT_FALSE(IsOnPinnedSite(pinned, GURL()));
+  // Being at home implies being on the site, never the other way round.
+  EXPECT_TRUE(IsAtPinnedUrl(pinned, pinned, {}));
