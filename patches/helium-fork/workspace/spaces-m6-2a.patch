+
+void VerticalTabStripRegionView::OnCreateFormPickIcon(views::View* anchor,
+                                                      const std::string& icon) {
+  BrowserView* const view = browser_view();
+  if (!view || !anchor) {
+    return;
+  }
+  const gfx::Rect anchor_in_view =
+      views::View::ConvertRectToTarget(anchor, view, anchor->GetLocalBounds());
+  const gfx::Rect region_in_view =
+      views::View::ConvertRectToTarget(this, view, GetLocalBounds());
+  // Arc g20: the card's top 5 below the input row, whose bottom is half the
+  // row-minus-button height under the button centred in it.
+  const int row_bottom =
+      anchor_in_view.bottom() +
+      (helium::kSpaceFormInputHeight - helium::kSpaceFormIconButtonSize) / 2;
+  view->ShowHeliumSpaceIconPicker(
+      anchor_in_view, helium::SpaceIconPickerPlacement::kBelowAnchor,
+      row_bottom + helium::kSpaceIconPickerGapBelowFormRow, region_in_view.x(),
+      icon,
+      base::BindRepeating(&VerticalTabStripRegionView::OnCreateFormIconPicked,
+                          sheet_weak_factory_.GetWeakPtr()),
+      base::BindRepeating(&VerticalTabStripRegionView::OnCreateFormPickerClosed,
+                          sheet_weak_factory_.GetWeakPtr()));
+}
+
+void VerticalTabStripRegionView::OnCreateFormPickerClosed() {
+  // Dismissed without a pick (Escape, a press elsewhere): the caret goes
+  // back to the name field all the same.
+  if (create_form_) {
+    create_form_->FocusNameField();
+  }
+}
+
+void VerticalTabStripRegionView::OnCreateFormIconPicked(const std::string& icon) {
+  if (create_form_) {
+    create_form_->SetIcon(icon);
+    // The picker cleared the focus on its way out; typing continues in the
+    // name field (user 2026-09-05: the caret lives there while the form is
+    // up).
+    create_form_->FocusNameField();
+  }
+}
