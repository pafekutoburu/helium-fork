+SkColor CardColor(const ui::ColorProvider* colors) {
+  return helium::GetSidebarFloatingCardColor(colors->GetColor(kColorToolbar));
+}
+
+// The contrast tint the hover squares and the segmented control's pill
+// wear over the card.
+SkColor TintOverCard(SkColor card, float light_alpha, float dark_alpha) {
+  const bool dark = color_utils::IsDark(card);
+  return color_utils::AlphaBlend(dark ? SK_ColorWHITE : SK_ColorBLACK, card,
+                                 dark ? dark_alpha : light_alpha);
+}
