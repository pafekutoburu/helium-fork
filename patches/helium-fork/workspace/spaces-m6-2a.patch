+      l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_FORM_TITLE)));
+  title_->SetFontList(FontOfSize(helium::kSpaceFormTitleFontSize,
+                                 gfx::Font::Weight::BOLD));
+  title_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  title_->SetAutoColorReadabilityEnabled(false);
+
+  subtitle_ = AddChildView(std::make_unique<views::Label>(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_FORM_SUBTITLE)));
+  subtitle_->SetFontList(FontOfSize(helium::kSpaceFormSubtitleFontSize,
+                                    gfx::Font::Weight::NORMAL));
+  subtitle_->SetMultiLine(true);
+  subtitle_->SetMaxLines(helium::kSpaceFormSubtitleLines);
+  subtitle_->SetLineHeight(helium::kSpaceFormSubtitleLineHeight);
+  subtitle_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  subtitle_->SetAutoColorReadabilityEnabled(false);
+
+  icon_button_ = AddChildView(std::make_unique<IconButton>(
+      base::BindRepeating(&HeliumSpaceCreateFormView::OnIconPressed,
+                          base::Unretained(this))));
+
+  auto name = std::make_unique<views::Textfield>();
+  name->set_controller(this);
+  name->SetBorder(nullptr);
+  name->SetBackgroundEnabled(false);
+  // ⛔ 152's Textfield installs an ink-drop hover (kColorTextfieldHover) of
+  // its own; on this borderless field it painted a darker block the size
+  // of the field's 42pt control height, taller than the row it sits in
+  // (user 2026-09-05 #2). Off, and the field is laid out at the row's
+  // height below.
+  name->RemoveHoverEffect();
+  name->SetPlaceholderText(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_FORM_NAME_PLACEHOLDER));
+  name->SetFontList(FontOfSize(helium::kSpaceFormPlaceholderFontSize,
+                               gfx::Font::Weight::NORMAL));
+  name->SetTextColorId(ui::kColorLabelForeground);
+  name->SetPlaceholderTextColorId(ui::kColorTextfieldForegroundPlaceholder);
+  // ⛔ A focusable view with no accessible name aborts under DCHECKs.
+  name->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_FORM_NAME_PLACEHOLDER));
+  name_ = AddChildView(std::move(name));
+
+  create_ = AddChildView(std::make_unique<CreateButton>(
+      base::BindRepeating(&HeliumSpaceCreateFormView::OnCreatePressed,
+                          base::Unretained(this))));
+  create_->SetEnabled(false);
+
+  cancel_ = AddChildView(std::make_unique<CancelButton>(base::BindRepeating(
+      [](HeliumSpaceCreateFormView* form) { form->on_cancel_.Run(); },
