 namespace helium_workspace {
 
+// helium-fork 2a-r2: the raster a sidebar row wants for its favicon -- 16 dip
+// at 2x, one source pixel per Retina pixel. Dia's and Arc's sidebars keep
+// their own icon caches, and every file in them is a 32×32 PNG (2026-09-05,
+// 197/197 and 2940/2949); that is where their sharpness comes from. An icon
+// with less is stretched; the controller fetches a bigger one for it.
+inline constexpr int kWorkspaceFaviconPixels = 2 * gfx::kFaviconSize;
+
+// The pixel width a PNG's header declares (IHDR is always first), 0 for
+// anything that is not a PNG. Cheap enough to ask on every icon change.
+inline int WorkspaceFaviconPngWidth(const std::string& png) {
+  static constexpr unsigned char kSignature[] = {0x89, 'P', 'N', 'G',
+                                                 0x0D, 0x0A, 0x1A, 0x0A};
+  if (png.size() < 24 || std::memcmp(png.data(), kSignature, 8) != 0) {
+    return 0;
+  }
+  const auto* bytes = reinterpret_cast<const unsigned char*>(png.data());
+  return (static_cast<int>(bytes[16]) << 24) |
+         (static_cast<int>(bytes[17]) << 16) |
+         (static_cast<int>(bytes[18]) << 8) | static_cast<int>(bytes[19]);
+}
