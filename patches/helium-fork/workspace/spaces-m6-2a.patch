+  const int target = kWorkspaceFaviconPixels;
+  if (bitmap.width() == bitmap.height()) {
+    return skia::ImageOperations::Resize(
+        bitmap, skia::ImageOperations::RESIZE_BEST, target, target);
+  }
+  const float scale =
+      static_cast<float>(target) / std::max(bitmap.width(), bitmap.height());
+  const int w = std::max(1, static_cast<int>(std::lround(bitmap.width() * scale)));
+  const int h = std::max(1, static_cast<int>(std::lround(bitmap.height() * scale)));
+  const SkBitmap fitted = skia::ImageOperations::Resize(
+      bitmap, skia::ImageOperations::RESIZE_BEST, w, h);
+  SkBitmap square;
+  square.allocN32Pixels(target, target, /*isOpaque=*/false);
+  square.eraseColor(SK_ColorTRANSPARENT);
+  SkCanvas canvas(square);
+  canvas.drawImage(fitted.asImage(), (target - w) / 2.0f, (target - h) / 2.0f);
+  return square;
