+void WorkspaceTabController::MaybeFetchLargeFavicon(
+    tabs::TabInterface* tab,
+    const std::string& entry_id) {
+  content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return;
+  }
+  const GURL page_url = contents->GetLastCommittedURL();
+  if (!page_url.is_valid() || !page_url.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  const std::pair<std::string, GURL> key(entry_id, page_url);
+  if (large_favicon_tried_.contains(key) ||
+      large_favicon_fetches_.contains(entry_id)) {
+    return;
+  }
+  large_favicon_tried_.insert(key);
+
+  // The page's candidates, most likely to hold a good 32px first: declared
+  // sizes of 32 or more, smallest first (a declared 32 is exactly the icon
+  // wanted; a bigger one downsamples well); then touch icons, which are
+  // 180 or so and undeclared; then favicons of undeclared size (an .ico
+  // often carries a 32 frame); and the root /favicon.ico last. Candidates
+  // declared smaller than 32 cannot help and are skipped.
+  struct Ranked {
+    GURL url;
+    int order;
+    int declared;
+  };
+  std::vector<Ranked> ranked;
+  for (const blink::mojom::FaviconURLPtr& candidate :
+       contents->GetFaviconURLs()) {
+    if (!candidate || !candidate->icon_url.is_valid()) {
+      continue;
+    }
+    int declared = 0;
+    for (const gfx::Size& size : candidate->icon_sizes) {
+      declared = std::max(declared, std::max(size.width(), size.height()));
+    }
+    if (!candidate->icon_sizes.empty()) {
+      if (declared < kWorkspaceFaviconPixels) {
+        continue;
+      }
+      ranked.push_back({candidate->icon_url, 0, declared});
+      continue;
+    }
+    const bool touch =
+        candidate->icon_type == blink::mojom::FaviconIconType::kTouchIcon ||
+        candidate->icon_type ==
+            blink::mojom::FaviconIconType::kTouchPrecomposedIcon;
+    ranked.push_back({candidate->icon_url, touch ? 1 : 2, 0});
+  }
+  std::stable_sort(ranked.begin(), ranked.end(),
+                   [](const Ranked& a, const Ranked& b) {
+                     return a.order != b.order ? a.order < b.order
+                                               : a.declared < b.declared;
+                   });
+  LargeFaviconFetch fetch;
+  fetch.tab = tab->GetHandle();
+  fetch.page_url = page_url;
+  const auto listed = [&fetch](const GURL& url) {
+    return std::find(fetch.candidates.begin(), fetch.candidates.end(), url) !=
+           fetch.candidates.end();
+  };
+  for (const Ranked& candidate : ranked) {
+    if (!listed(candidate.url)) {
+      fetch.candidates.push_back(candidate.url);
+    }
+  }
+  const GURL root_icon = page_url.GetWithEmptyPath().Resolve("/favicon.ico");
+  if (root_icon.is_valid() && !listed(root_icon)) {
+    fetch.candidates.push_back(root_icon);
+  }
+  if (fetch.candidates.size() > kMaxLargeFaviconCandidates) {
+    fetch.candidates.resize(kMaxLargeFaviconCandidates);
+  }
+  large_favicon_fetches_[entry_id] = std::move(fetch);
+  DownloadNextLargeFaviconCandidate(entry_id);
+}
+
+void WorkspaceTabController::DownloadNextLargeFaviconCandidate(
+    const std::string& entry_id) {
+  const auto it = large_favicon_fetches_.find(entry_id);
+  if (it == large_favicon_fetches_.end()) {
+    return;
+  }
+  LargeFaviconFetch& fetch = it->second;
+  tabs::TabInterface* tab = fetch.tab.Get();
+  content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+  if (!contents || contents->GetLastCommittedURL() != fetch.page_url ||
+      fetch.next >= fetch.candidates.size()) {
+    large_favicon_fetches_.erase(it);
+    return;
+  }
+  const GURL url = fetch.candidates[fetch.next++];
+  // is_favicon: fetched like the favicon handler fetches, without
+  // credentials. The preferred size only matters to an SVG, which renders
+  // at it; a raster comes back as all its frames up to the cap.
+  contents->DownloadImage(
+      url, /*is_favicon=*/true,
+      gfx::Size(kWorkspaceFaviconPixels, kWorkspaceFaviconPixels),
+      kMaxLargeFaviconDownloadPx, /*bypass_cache=*/false,
+      base::BindOnce(&WorkspaceTabController::OnLargeFaviconDownloaded,
+                     weak_factory_.GetWeakPtr(), entry_id));
+}
+
+void WorkspaceTabController::OnLargeFaviconDownloaded(
+    const std::string& entry_id,
+    int id,
+    int http_status_code,
+    const GURL& image_url,
+    const std::vector<SkBitmap>& bitmaps,
+    const std::vector<gfx::Size>& sizes) {
+  const auto it = large_favicon_fetches_.find(entry_id);
+  if (it == large_favicon_fetches_.end()) {
+    return;
+  }
+  // The smallest frame that is at least 32 on its shorter edge.
+  const SkBitmap* pick = nullptr;
+  for (const SkBitmap& bitmap : bitmaps) {
+    if (bitmap.drawsNothing()) {
+      continue;
