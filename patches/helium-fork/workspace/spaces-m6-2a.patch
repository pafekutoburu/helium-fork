+
+// helium-fork 2a-r5: two states of a tab that the tab strip, the Ctrl+Tab
+// switcher and the close command decide by. Next to workspace_blank_tab.h's
+// "blank new tab" -- kept apart from it because that header is content-free
+// on purpose (it is unit tested without //content).
+namespace helium_workspace {
+
+// A tab with no page behind it: restored by session restore and never loaded
+// (its NavigationController still "needs reload"), or discarded since. In the
+// sidebar it is a row -- title, icon, space -- and nothing else; activating
+// it is what loads it (Browser::ActiveTabChanged -> LoadIfNecessary), so the
+// strip's own choices (Ctrl+Tab's list, the tab to land on after a close)
+// leave it alone (user 2026-09-06 #4: 「没有后台，点击要重新加载」).
+inline bool IsSleepingTab(content::WebContents* contents) {
+  return contents && (contents->GetController().NeedsReload() ||
+                      contents->WasDiscarded());
+}
+
+// tab_strip_model.cc's reading of "blank new tab", on a WebContents: the
+// *visible* URL (the virtual one, set while the tab is still pending) and
+// the entry count.
+inline bool IsBlankNewTabContents(content::WebContents* contents) {
+  return contents && IsBlankNewTabState(contents->GetVisibleURL(),
+                                        contents->GetController().GetEntryCount());
+}
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_TAB_STATE_H_
