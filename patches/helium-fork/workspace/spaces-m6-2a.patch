+HeliumGlyphGridView::HeliumGlyphGridView(int columns,
+                                         int cell,
+                                         int glyph_size,
+                                         const std::u16string& name,
+                                         PickedCallback on_picked)
+    : columns_(columns),
+      cell_(cell),
+      glyph_size_(glyph_size),
+      on_picked_(std::move(on_picked)) {
+  // The emoji is text: the system's colour emoji font answers through the
+  // usual fallback, same as the head row's Label.
+  emoji_font_ = gfx::FontList().DeriveWithSizeDelta(
+      glyph_size_ - gfx::FontList().GetFontSize());
+  // Focusable so the picker can park the focus here while the Icon tab is
+  // up (the Emoji tab parks it in the search field). ⛔ A focusable view
+  // with no accessible name aborts under DCHECKs.
+  SetFocusBehavior(FocusBehavior::ALWAYS);
+  GetViewAccessibility().SetRole(ax::mojom::Role::kGroup);
+  GetViewAccessibility().SetName(name);
