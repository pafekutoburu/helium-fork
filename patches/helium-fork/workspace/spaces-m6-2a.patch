+
+HeliumGlyphGridView::~HeliumGlyphGridView() = default;
+
+void HeliumGlyphGridView::SetGlyphs(std::vector<Glyph> glyphs) {
+  glyphs_ = std::move(glyphs);
+  selected_index_.reset();
+  hovered_index_.reset();
+  pressed_index_.reset();
+  PreferredSizeChanged();
+  SchedulePaint();
+}
+
+void HeliumGlyphGridView::SetSelectedIndex(std::optional<size_t> index) {
+  if (index && *index >= glyphs_.size()) {
+    index.reset();
+  }
+  if (selected_index_ == index) {
+    return;
+  }
+  selected_index_ = index;
+  SchedulePaint();
+}
+
+gfx::Rect HeliumGlyphGridView::CellBounds(size_t index) const {
+  return helium::GlyphGridCell(static_cast<int>(index), columns_, cell_);
+}
+
+gfx::Size HeliumGlyphGridView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return gfx::Size(columns_ * cell_,
+                   helium::GlyphGridHeight(static_cast<int>(glyphs_.size()),
+                                           columns_, cell_));
+}
+
+void HeliumGlyphGridView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors || glyphs_.empty()) {
+    return;
+  }
+  const SkColor card = helium::GetSidebarFloatingCardColor(
+      colors->GetColor(kColorToolbar));
+  const bool dark = color_utils::IsDark(card);
+  const SkColor square = color_utils::AlphaBlend(
+      dark ? SK_ColorWHITE : SK_ColorBLACK, card,
+      dark ? helium::kSpaceIconPickerSquareAlphaDark
+           : helium::kSpaceIconPickerSquareAlphaLight);
+  const SkColor icon_color = colors->GetColor(ui::kColorLabelForegroundSecondary);
+  // Only the rows the canvas can see: the grid may be 1700 cells tall.
+  gfx::Rect clip;
+  if (!canvas->GetClipBounds(&clip)) {
+    clip = GetLocalBounds();
+  }
+  const int first_row = std::max(0, clip.y() / cell_);
+  const int last_row = std::max(0, (clip.bottom() - 1) / cell_);
+  cc::PaintFlags fill;
+  fill.setStyle(cc::PaintFlags::kFill_Style);
+  fill.setAntiAlias(true);
+  fill.setColor(square);
+  for (int row = first_row; row <= last_row; ++row) {
+    for (int col = 0; col < columns_; ++col) {
+      const size_t index = static_cast<size_t>(row * columns_ + col);
+      if (index >= glyphs_.size()) {
+        return;
+      }
+      const gfx::Rect bounds = CellBounds(index);
+      const Glyph& glyph = glyphs_[index];
+      // An empty cell (the padding after the recent group) is just a gap.
+      if (!glyph.icon && glyph.emoji.empty()) {
+        continue;
+      }
+      if (selected_index_ == index || hovered_index_ == index) {
+        canvas->DrawRoundRect(gfx::RectF(bounds),
+                              helium::kSpaceIconPickerRadius, fill);
+      }
+      if (glyph.icon) {
+        const gfx::ImageSkia image =
+            gfx::CreateVectorIcon(*glyph.icon, glyph_size_, icon_color);
+        canvas->DrawImageInt(image, bounds.x() + (cell_ - image.width()) / 2,
+                             bounds.y() + (cell_ - image.height()) / 2);
+      } else if (!glyph.emoji.empty()) {
+        canvas->DrawStringRectWithFlags(
+            base::UTF8ToUTF16(glyph.emoji), emoji_font_,
+            colors->GetColor(ui::kColorLabelForeground), bounds,
+            gfx::Canvas::TEXT_ALIGN_CENTER);
+      }
+    }
+  }
+}
+
+std::optional<size_t> HeliumGlyphGridView::IndexAt(
+    const gfx::Point& point) const {
+  const std::optional<int> index = helium::GlyphGridIndexAt(
+      point, static_cast<int>(glyphs_.size()), columns_, cell_);
+  if (!index) {
+    return std::nullopt;
+  }
+  return static_cast<size_t>(*index);
+}
+
+void HeliumGlyphGridView::SetHoveredIndex(std::optional<size_t> index) {
+  if (hovered_index_ == index) {
+    return;
+  }
+  hovered_index_ = index;
+  SchedulePaint();
+}
+
+void HeliumGlyphGridView::OnMouseMoved(const ui::MouseEvent& event) {
+  SetHoveredIndex(IndexAt(event.location()));
+}
+
+void HeliumGlyphGridView::OnMouseExited(const ui::MouseEvent& event) {
+  SetHoveredIndex(std::nullopt);
+}
+
+bool HeliumGlyphGridView::OnMousePressed(const ui::MouseEvent& event) {
+  if (!event.IsOnlyLeftMouseButton()) {
+    return false;
+  }
+  pressed_index_ = IndexAt(event.location());
+  return pressed_index_.has_value();
+}
+
+void HeliumGlyphGridView::OnMouseReleased(const ui::MouseEvent& event) {
+  const std::optional<size_t> pressed = pressed_index_;
+  pressed_index_.reset();
+  if (!pressed || !event.IsOnlyLeftMouseButton()) {
+    return;
+  }
+  if (IndexAt(event.location()) == pressed) {
+    on_picked_.Run(*pressed);
+  }
+}
+
+std::u16string HeliumGlyphGridView::GetRenderedTooltipText(const gfx::Point& p) const {
+  const std::optional<size_t> index = IndexAt(p);
+  return index ? glyphs_[*index].accessible_name : std::u16string();
+}
