@@ -0,0 +1,65 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/helium_sf_symbol_image.h"
+
+#import <AppKit/AppKit.h>
+
+#include <cmath>
+
+#include "base/strings/sys_string_conversions.h"
+#include "ui/gfx/image/image_skia_operations.h"
+#include "ui/gfx/image/image_skia_util_mac.h"
+
+namespace helium {
+
+gfx::ImageSkia CreateSFSymbolImage(std::string_view name,
+                                   double point_size,
+                                   SkColor color) {
+  NSImage* symbol =
+      [NSImage imageWithSystemSymbolName:base::SysUTF8ToNSString(name)
+                accessibilityDescription:nil];
+  if (!symbol) {
+    return gfx::ImageSkia();
+  }
+  NSImageSymbolConfiguration* configuration = [NSImageSymbolConfiguration
+      configurationWithPointSize:point_size
+                          weight:NSFontWeightRegular
+                           scale:NSImageSymbolScaleMedium];
+  NSImage* configured = [symbol imageWithSymbolConfiguration:configuration];
+  if (!configured) {
+    return gfx::ImageSkia();
+  }
+  // A symbol's natural box is fractional (17.3 × 15.6 for a 16pt face);
+  // rasterising that straight into an ImageSkia would round the box and
+  // stretch the glyph by the remainder. Draw it, unscaled and centred, into
+  // a box of whole points instead.
+  const NSSize natural = configured.size;
+  if (natural.width <= 0 || natural.height <= 0) {
+    return gfx::ImageSkia();
+  }
+  const NSSize boxed = NSMakeSize(std::ceil(natural.width),
+                                  std::ceil(natural.height));
+  NSImage* boxed_image = [NSImage
+       imageWithSize:boxed
+             flipped:NO
+      drawingHandler:^BOOL(NSRect destination) {
+        [configured drawInRect:NSMakeRect((boxed.width - natural.width) / 2,
+                                          (boxed.height - natural.height) / 2,
+                                          natural.width, natural.height)
+                      fromRect:NSZeroRect
+                     operation:NSCompositingOperationSourceOver
+                      fraction:1.0];
+        return YES;
+      }];
+  // Drawn as-is the template is black on transparent; the colour mask keeps
+  // its alpha and paints |color| through it.
+  const gfx::ImageSkia glyph = gfx::ImageSkiaFromNSImage(boxed_image);
+  if (glyph.isNull()) {
+    return gfx::ImageSkia();
+  }
+  return gfx::ImageSkiaOperations::CreateColorMask(glyph, color);
+}
+
+}  // namespace helium
