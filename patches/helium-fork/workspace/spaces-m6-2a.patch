+namespace helium {
+namespace {
+
+TEST(ArcSpaceIconPickerTest, GridHeightAndIndex) {
+  EXPECT_EQ(0, GlyphGridHeight(0, 7, 33));
+  EXPECT_EQ(33, GlyphGridHeight(7, 7, 33));
+  EXPECT_EQ(66, GlyphGridHeight(8, 7, 33));
+  // The Icon tab: 56 icons, 8 columns of 40 -> 7 rows.
+  EXPECT_EQ(7 * 40, GlyphGridHeight(56, 8, 40));
+  EXPECT_EQ(0, GlyphGridIndexAt(gfx::Point(0, 0), 56, 8, 40).value());
+  EXPECT_EQ(7, GlyphGridIndexAt(gfx::Point(7 * 40 + 39, 0), 56, 8, 40).value());
+  EXPECT_EQ(8, GlyphGridIndexAt(gfx::Point(0, 40), 56, 8, 40).value());
+  EXPECT_FALSE(GlyphGridIndexAt(gfx::Point(8 * 40, 0), 56, 8, 40));
+  EXPECT_FALSE(GlyphGridIndexAt(gfx::Point(0, 7 * 40), 56, 8, 40));
+  EXPECT_FALSE(GlyphGridIndexAt(gfx::Point(-1, 0), 56, 8, 40));
+  EXPECT_EQ(gfx::Rect(40, 40, 40, 40).ToString(), GlyphGridCell(9, 8, 40).ToString());
+}
+
+TEST(ArcSpaceIconPickerTest, EmojiGridFitsTheCard) {
+  // 8 columns of 40 from x 11 end at 331, leaving the scrollbar's room at
+  // the right edge (Arc: 242 of 272, scrollbar from 254).
+  EXPECT_LE(kSpaceIconPickerGridLeft +
+                kSpaceIconPickerEmojiColumns * kSpaceIconPickerEmojiCell,
+            kSpaceIconPickerWidth - 24);
+  // The category bar's nine cells of 36 span 324 of the 360.
+  EXPECT_LE(kSpaceIconPickerCategoryCells * kSpaceIconPickerCategoryCell,
+            kSpaceIconPickerWidth);
+  // The Icon tab's 7 rows end above the card's bottom.
+  EXPECT_LE(kSpaceIconPickerIconGridTop +
+                kSpaceIconPickerIconRows * kSpaceIconPickerIconCell,
+            kSpaceIconPickerHeight);
+  // The emoji viewport sits between the search field and the separator,
+  // and shows at least five full rows (Arc: 4.4 of its 33).
+  EXPECT_GT(kSpaceIconPickerEmojiGridTop,
+            kSpaceIconPickerSearchTop + kSpaceIconPickerSearchHeight);
+  EXPECT_LT(kSpaceIconPickerEmojiGridTop, kSpaceIconPickerSeparatorY);
+  // 2a-r3: exactly five rows between the search field and the separator,
+  // the field and the control the same height, ten apart.
+  EXPECT_EQ(kSpaceIconPickerSeparatorY - kSpaceIconPickerEmojiGridTop,
+            5 * kSpaceIconPickerEmojiCell);
+  EXPECT_EQ(kSpaceIconPickerSegmentHeight, kSpaceIconPickerSearchHeight);
+  EXPECT_EQ(kSpaceIconPickerSegmentTop + kSpaceIconPickerSegmentHeight + 10,
+            kSpaceIconPickerSearchTop);
+  EXPECT_EQ(kSpaceIconPickerSearchTop + kSpaceIconPickerSearchHeight + 10,
+            kSpaceIconPickerEmojiGridTop);
+  // The Icon grid sits centred under the control, at least its cell's
+  // margin off the card's bottom.
+  EXPECT_GE(kSpaceIconPickerHeight - kSpaceIconPickerIconGridTop -
+                kSpaceIconPickerIconRows * kSpaceIconPickerIconCell,
+            5);
+  // The recent group is whole rows.
+  EXPECT_EQ(0, kSpaceIconPickerRecentMax % kSpaceIconPickerEmojiColumns);
+}
+
+TEST(ArcSpaceIconPickerTest, BoundsStayInsideTheParent) {
+  const gfx::Size parent(1200, 900);
+  // Under the head row: left 13, top 242 -> as is.
+  // (gfx::Rect has no PrintTo in this lightweight target: compare strings.)
+  EXPECT_EQ(gfx::Rect(13, 242, 360, 340).ToString(),
+            SpaceIconPickerBounds(13, 242, parent).ToString());
+  // Too low: slides up to the bottom edge.
+  EXPECT_EQ(gfx::Rect(13, 900 - 340, 360, 340).ToString(),
+            SpaceIconPickerBounds(13, 800, parent).ToString());
+  // A parent narrower than the card: the card shrinks to it.
+  EXPECT_EQ(gfx::Rect(0, 0, 200, 340).ToString(),
+            SpaceIconPickerBounds(13, 0, gfx::Size(200, 900)).ToString());
+  // Above the bottom bar: the bottom lands where asked...
+  EXPECT_EQ(gfx::Rect(13, 850 - 340, 360, 340).ToString(),
+            SpaceIconPickerBoundsAbove(13, 850, parent).ToString());
+  // ...unless that runs off the top, then it slides down.
+  EXPECT_EQ(gfx::Rect(13, 0, 360, 340).ToString(),
+            SpaceIconPickerBoundsAbove(13, 100, parent).ToString());
+}
+
+TEST(ArcSpaceIconPickerTest, TheTailTipFollowsTheAnchor) {
+  const gfx::Rect card(13, 242, 360, 340);
+  // The form's dashed button (centre x 31) and the head row's emoji (25.75)
+  // both land inside the card's left corner: the tip goes right there.
+  EXPECT_EQ(31, SpaceIconPickerTailTipX(31, card));
+  EXPECT_EQ(26, SpaceIconPickerTailTipX(26, card));
+  // Only the base must stay on the card.
+  EXPECT_EQ(13 + 12, SpaceIconPickerTailTipX(0, card));
+  EXPECT_EQ(373 - 12, SpaceIconPickerTailTipX(1000, card));
+}
+
+TEST(ArcSpaceIconPickerTest, TailSidesEndOnTheEdgeOrTangentToTheCorner) {
+  const gfx::RectF card(0, 0, 360, 340);
+  const float radius = kSpaceIconPickerRadius;
+  const float half = kSpaceIconPickerTailBase / 2.0f;
+  const float clearance = SpaceIconPickerTailFootClearance();
+  // A tip well inside: both sides end on the straight top edge.
+  {
+    const gfx::PointF tip(180, -kSpaceIconPickerTailHeight);
+    const SpaceIconPickerTailSide left = SpaceIconPickerTailSideEnd(
+        tip, card, radius, half, /*right=*/false, clearance);
+    const SpaceIconPickerTailSide right = SpaceIconPickerTailSideEnd(
+        tip, card, radius, half, /*right=*/true, clearance);
+    EXPECT_FALSE(left.corner_angle_deg.has_value());
+    EXPECT_FALSE(right.corner_angle_deg.has_value());
+    EXPECT_FLOAT_EQ(180 - half, left.end.x());
+    EXPECT_FLOAT_EQ(180 + half, right.end.x());
+    EXPECT_FLOAT_EQ(0, left.end.y());
+  }
+  // 2a-r3: the form's "+" (34 in from the sidebar, kSpaceIconPickerLeftInset
+  // in from the card): both feet, fillets included, on the straight edge --
+  // the corner untouched, the two top corners alike (user 2026-09-05 #2).
+  {
+    const float tip_x = 15 + 10 + 9 - kSpaceIconPickerLeftInset;
+    const gfx::PointF tip(tip_x, -kSpaceIconPickerTailHeight);
+    const SpaceIconPickerTailSide left = SpaceIconPickerTailSideEnd(
+        tip, card, radius, half, /*right=*/false, clearance);
+    EXPECT_FALSE(left.corner_angle_deg.has_value());
+    // Four points of plain edge between the fillet and the corner's arc.
+    EXPECT_GE(left.end.x() - clearance, radius + 4);
+    EXPECT_GT(clearance, 0);
+    EXPECT_LT(clearance, kSpaceIconPickerTailFootRadius);
+  }
+  // The head row's emoji (25 in from the sidebar, 17 from the card) and a
+  // tip nearer still: the left base would cross the corner, so that side
+  // is the tangent to the corner's arc -- on the circle, perpendicular to
+  // the radius, in the top-left quarter -- and the right side is still
+  // the plain base.
+  for (const float tip_x : {25.0f - kSpaceIconPickerLeftInset, 13.0f}) {
+    const gfx::PointF tip(tip_x, -kSpaceIconPickerTailHeight);
+    const SpaceIconPickerTailSide left = SpaceIconPickerTailSideEnd(
+        tip, card, radius, half, /*right=*/false, clearance);
+    ASSERT_TRUE(left.corner_angle_deg.has_value());
+    EXPECT_GT(*left.corner_angle_deg, 180);
+    EXPECT_LT(*left.corner_angle_deg, 270);
+    const gfx::PointF centre(radius, radius);
+    EXPECT_NEAR(radius, (left.end - centre).Length(), 0.01f);
+    const gfx::Vector2dF along = left.end - tip;
+    const gfx::Vector2dF spoke = left.end - centre;
+    EXPECT_NEAR(0, along.x() * spoke.x() + along.y() * spoke.y(), 0.05f);
+    // The tangent never reaches past the card's left edge.
+    EXPECT_GE(left.end.x(), 0);
+    const SpaceIconPickerTailSide right = SpaceIconPickerTailSideEnd(
+        tip, card, radius, half, /*right=*/true, clearance);
+    EXPECT_FALSE(right.corner_angle_deg.has_value());
+    EXPECT_FLOAT_EQ(tip_x + half, right.end.x());
+  }
+  // Mirror image on the right corner.
+  {
+    const gfx::PointF tip(360 - 21, -kSpaceIconPickerTailHeight);
+    const SpaceIconPickerTailSide right = SpaceIconPickerTailSideEnd(
+        tip, card, radius, half, /*right=*/true, clearance);
+    ASSERT_TRUE(right.corner_angle_deg.has_value());
+    EXPECT_GT(*right.corner_angle_deg, 270);
+    EXPECT_LT(*right.corner_angle_deg, 360);
+    const gfx::PointF centre(360 - radius, radius);
+    EXPECT_NEAR(radius, (right.end - centre).Length(), 0.01f);
+    EXPECT_LE(right.end.x(), 360);
+  }
+}
+
+TEST(ArcSpaceIconPickerTest, PillCentresWithOrWithoutTheTrash) {
+  // With the trash: pill (2a-r3: two 75 segments, 32 tall like the search
+  // field), a 19 gap and the 32 trash square make a 201 group; Arc centres
+  // it a little right of the card, we centre it. Without the trash the
+  // pill centres by itself.
+  const int pill = 2 * kSpaceIconPickerSegmentWidth;
+  const int group = pill + kSpaceIconPickerTrashGap + kSpaceIconPickerTrashSlot;
+  EXPECT_EQ(2 * 75 + 19 + 32, group);
+  EXPECT_EQ(kSpaceIconPickerSegmentHeight, kSpaceIconPickerTrashSlot);
+  EXPECT_LT(group, kSpaceIconPickerWidth);
+}
+
+}  // namespace
+}  // namespace helium
