+      browser_view ? browser_view->vertical_tab_strip_region_view() : nullptr;
+  if (!anchor || !region || !service_) {
+    return;
+  }
+  const gfx::Rect anchor_in_view = views::View::ConvertRectToTarget(
+      anchor, browser_view, anchor->GetLocalBounds());
+  const gfx::Rect region_in_view = views::View::ConvertRectToTarget(
+      region, browser_view, region->GetLocalBounds());
+  const helium_workspace::WorkspaceSpace* space =
+      service_->FindSpaceById(space_id);
+  browser_view->ShowHeliumSpaceIconPicker(
+      anchor_in_view, helium::SpaceIconPickerPlacement::kAboveAnchor,
+      anchor_in_view.y() - helium::kSpaceIconPickerGapAboveBarSlot,
+      region_in_view.x(), space ? space->icon : std::string(),
+      base::BindRepeating(&WorkspaceSpaceBarView::OnSpaceIconPicked,
+                          weak_factory_.GetWeakPtr(), space_id),
+      base::DoNothing());
+}
+
+void WorkspaceSpaceBarView::OnSpaceIconPicked(const std::string& space_id,
+                                              const std::string& icon) {
+  if (service_) {
+    service_->SetSpaceIcon(space_id, icon);
   }
 }
 
