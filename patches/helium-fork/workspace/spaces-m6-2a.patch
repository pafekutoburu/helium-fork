+void WorkspaceSidebarView::StartSpaceIconPick(const std::string& space_id) {
+  pending_icon_pick_space_id_ = space_id;
+  RefreshCurrentSpaceId();
+  OpenSpaceIconPicker(/*attempt=*/0);
+}
+
+void WorkspaceSidebarView::OpenSpaceIconPicker(int attempt) {
+  if (pending_icon_pick_space_id_.empty() || !space_head_row_ || !service_) {
+    return;
+  }
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(GetBrowserWindow());
+  if (!browser_view) {
+    return;
+  }
+  VerticalTabStripRegionView* const region =
+      browser_view->vertical_tab_strip_region_view();
+  // The head row must already show the space and the carousel must have
+  // landed: ConvertRectToTarget folds the slide transform in (M6-r4), so a
+  // picker anchored mid-slide lands a sidebar-width off. Try again a few
+  // frames later (the slide is 180ms).
+  const bool ready = region && !region->IsListSliding() &&
+                     space_head_row_->GetVisible() &&
+                     space_head_row_->space_id() == pending_icon_pick_space_id_;
+  if (!ready) {
+    if (attempt < 20) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&WorkspaceSidebarView::OpenSpaceIconPicker,
+                         weak_factory_.GetWeakPtr(), attempt + 1),
+          base::Milliseconds(40));
+    } else {
+      pending_icon_pick_space_id_.clear();
+    }
+    return;
+  }
+  const std::string space_id = pending_icon_pick_space_id_;
+  pending_icon_pick_space_id_.clear();
+  const helium_workspace::WorkspaceSpace* space =
+      service_->FindSpaceById(space_id);
+  const std::string current = space ? space->icon : std::string();
+  const gfx::Rect anchor = views::View::ConvertRectToTarget(
+      space_head_row_, browser_view, space_head_row_->IconSlotBounds());
+  const gfx::Rect row = views::View::ConvertRectToTarget(
+      space_head_row_, browser_view, space_head_row_->GetLocalBounds());
+  const gfx::Rect region_bounds = views::View::ConvertRectToTarget(
+      region, browser_view, region->GetLocalBounds());
+  // Arc g21b: the card's top 17 below the row's bottom, the tail at the
+  // emoji; the card's left 13 in from the sidebar's edge.
+  browser_view->ShowHeliumSpaceIconPicker(
+      anchor, helium::SpaceIconPickerPlacement::kBelowAnchor,
+      row.bottom() + helium::kSpaceIconPickerGapBelowHeadRow, region_bounds.x(),
+      current,
+      base::BindRepeating(&WorkspaceSidebarView::OnSpaceIconPicked,
+                          weak_factory_.GetWeakPtr(), space_id),
+      base::DoNothing());
+}
+
+void WorkspaceSidebarView::OnSpaceIconPicked(const std::string& space_id,
+                                             const std::string& icon) {
+  if (service_) {
+    service_->SetSpaceIcon(space_id, icon);
+  }
+}
