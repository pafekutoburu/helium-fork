+gfx::Rect HeliumSpaceIconPickerView::CardBounds() const {
+  gfx::Rect card = GetLocalBounds();
+  const bool below = placement_ == helium::SpaceIconPickerPlacement::kBelowAnchor;
+  card.Inset(gfx::Insets::TLBR(below ? helium::kSpaceIconPickerTailHeight : 0, 0,
+                               below ? 0 : helium::kSpaceIconPickerTailHeight,
+                               0));
+  return card;
+}
+
+void HeliumSpaceIconPickerView::UpdateBounds() {
+  if (!parent()) {
+    return;
+  }
+  const bool below = placement_ == helium::SpaceIconPickerPlacement::kBelowAnchor;
+  const int left = left_in_parent_ + helium::kSpaceIconPickerLeftInset;
+  const gfx::Rect card =
+      below ? helium::SpaceIconPickerBounds(left, body_edge_in_parent_,
+                                            parent()->size())
+            : helium::SpaceIconPickerBoundsAbove(left, body_edge_in_parent_,
+                                                 parent()->size());
+  // This view is the card plus the tail's strip on the anchor's side.
+  gfx::Rect bounds = card;
+  bounds.Inset(gfx::Insets::TLBR(below ? -helium::kSpaceIconPickerTailHeight : 0,
+                                 0,
+                                 below ? 0 : -helium::kSpaceIconPickerTailHeight,
+                                 0));
+  SetBoundsRect(bounds);
+  if (shadow_frame_) {
+    // The whole silhouette, tail included, casts (and is cut out of) the
+    // shadow: this view's box and its outline in this view's coordinates.
+    shadow_frame_->SetCardSilhouette(bounds, BuildSilhouette());
+  }
+}
+
+SkPath HeliumSpaceIconPickerView::BuildSilhouette() const {
+  const gfx::Rect card_rect = CardBounds();
+  const gfx::RectF card(card_rect);
+  const bool below = placement_ == helium::SpaceIconPickerPlacement::kBelowAnchor;
+  // Built in a frame where the tail rises from the card's top edge; the
+  // bottom bar's tail is that frame flipped about the card's middle.
+  gfx::Rect anchor = anchor_in_parent_;
+  anchor.Offset(-x(), -y());
+  const gfx::PointF tip(
+      static_cast<float>(
+          helium::SpaceIconPickerTailTipX(anchor.CenterPoint().x(), card_rect)),
+      card.y() - helium::kSpaceIconPickerTailHeight);
+  const float radius = helium::kSpaceIconPickerRadius;
+  const float half = helium::kSpaceIconPickerTailBase / 2.0f;
+  const float clearance = helium::SpaceIconPickerTailFootClearance();
+  const helium::SpaceIconPickerTailSide left = helium::SpaceIconPickerTailSideEnd(
+      tip, card, radius, half, /*right=*/false, clearance);
+  const helium::SpaceIconPickerTailSide right = helium::SpaceIconPickerTailSideEnd(
+      tip, card, radius, half, /*right=*/true, clearance);
+  const float d = 2 * radius;
+  const SkRect top_left = SkRect::MakeXYWH(card.x(), card.y(), d, d);
+  const SkRect top_right = SkRect::MakeXYWH(card.right() - d, card.y(), d, d);
+  const SkRect bottom_right =
+      SkRect::MakeXYWH(card.right() - d, card.bottom() - d, d, d);
+  const SkRect bottom_left = SkRect::MakeXYWH(card.x(), card.bottom() - d, d, d);
+  const SkPoint tip_pt = gfx::PointFToSkPoint(tip);
+  const SkPoint left_pt = gfx::PointFToSkPoint(left.end);
+  const SkPoint right_pt = gfx::PointFToSkPoint(right.end);
+  const SkPoint top_right_start{card.right() - radius, card.y()};
+
+  // Clockwise from the top of the left edge: round the top-left corner (all
+  // of it, or only as far as the tail's tangent), up the tail's left side,
+  // round its tip, down its right side into the top edge, round the
+  // top-right corner, and the three plain sides home. 2a-r3: the tip and
+  // the two feet are arcs -- arcTo(p1, p2, r) is Skia's fillet between the
+  // line to p1 and the line on to p2 -- so the tail is one smooth line
+  // (user 2026-09-05 #2: a foot that met the edge in a fold "很不舒服"). A
+  // side that ends on a corner arc is already tangent to it and gets no
+  // fillet of its own.
+  SkPathBuilder outline;
+  outline.moveTo(card.x(), card.y() + radius);
+  if (left.corner_angle_deg) {
+    outline.arcTo(top_left, 180, *left.corner_angle_deg - 180, false);
+    outline.arcTo(tip_pt, right_pt, helium::kSpaceIconPickerTailTipRadius);
+  } else {
+    outline.arcTo(top_left, 180, 90, false);
+    outline.arcTo(left_pt, tip_pt, helium::kSpaceIconPickerTailFootRadius);
+    outline.arcTo(tip_pt, right_pt, helium::kSpaceIconPickerTailTipRadius);
+  }
+  if (right.corner_angle_deg) {
+    outline.lineTo(right_pt);
+    outline.arcTo(top_right, *right.corner_angle_deg,
+                  360.0f - *right.corner_angle_deg, false);
+  } else {
+    outline.arcTo(right_pt, top_right_start,
+                  helium::kSpaceIconPickerTailFootRadius);
+    outline.lineTo(top_right_start);
+    outline.arcTo(top_right, 270, 90, false);
+  }
+  outline.lineTo(card.right(), card.bottom() - radius);
+  outline.arcTo(bottom_right, 0, 90, false);
+  outline.lineTo(card.x() + radius, card.bottom());
+  outline.arcTo(bottom_left, 90, 90, false);
+  outline.close();
+  const SkPath path = outline.detach();
+  if (below) {
+    return path;
+  }
+  SkMatrix flip = SkMatrix::Scale(1, -1);
+  flip.postTranslate(0, card.y() + card.bottom());
+  return path.makeTransform(flip);
+}
+
+void HeliumSpaceIconPickerView::Layout(PassKey) {
+  const gfx::Rect card = CardBounds();
+  // The segmented control, and the trash 19 right of it when shown.
+  const int pill_w = 2 * helium::kSpaceIconPickerSegmentWidth;
+  const int group_w = pill_w + helium::kSpaceIconPickerTrashGap +
+                      helium::kSpaceIconPickerTrashSlot;
+  const int pill_x = card.x() + (card.width() -
+                                 (trash_->GetVisible() ? group_w : pill_w)) /
+                                    2;
+  const int pill_y = card.y() + helium::kSpaceIconPickerSegmentTop;
+  emoji_segment_->SetBounds(pill_x, pill_y, helium::kSpaceIconPickerSegmentWidth,
+                            helium::kSpaceIconPickerSegmentHeight);
+  icon_segment_->SetBounds(pill_x + helium::kSpaceIconPickerSegmentWidth, pill_y,
+                           helium::kSpaceIconPickerSegmentWidth,
+                           helium::kSpaceIconPickerSegmentHeight);
+  trash_->SetBounds(pill_x + pill_w + helium::kSpaceIconPickerTrashGap, pill_y,
+                    helium::kSpaceIconPickerTrashSlot,
+                    helium::kSpaceIconPickerSegmentHeight);
+
+  // Emoji tab: search field, viewport, category bar.
+  const gfx::Rect field(card.x() + helium::kSpaceIconPickerSearchInset,
+                        card.y() + helium::kSpaceIconPickerSearchTop,
+                        card.width() - 2 * helium::kSpaceIconPickerSearchInset,
+                        helium::kSpaceIconPickerSearchHeight);
+  const int glyph = helium::kSpaceIconPickerSearchIconSize;
+  search_icon_->SetBounds(field.x() + helium::kSpaceIconPickerSearchIconInset,
+                          field.y() + (field.height() - glyph) / 2, glyph, glyph);
+  clear_search_->SetBounds(field.right() - helium::kSpaceIconPickerSearchIconInset -
+                               helium::kSpaceIconPickerSearchHeight,
+                           field.y(), helium::kSpaceIconPickerSearchHeight,
+                           field.height());
+  const int text_x = search_icon_->bounds().right() + 6;
+  const int text_right =
+      clear_search_->GetVisible() ? clear_search_->x() : field.right() - 8;
+  search_->SetBounds(text_x, field.y(), std::max(text_right - text_x, 0),
+                     field.height());
+  const int grid_w =
+      helium::kSpaceIconPickerEmojiColumns * helium::kSpaceIconPickerEmojiCell;
+  scroll_->SetBounds(card.x() + helium::kSpaceIconPickerGridLeft,
+                     card.y() + helium::kSpaceIconPickerEmojiGridTop,
+                     card.width() - helium::kSpaceIconPickerGridLeft,
+                     helium::kSpaceIconPickerSeparatorY -
+                         helium::kSpaceIconPickerEmojiGridTop);
+  emoji_grid_->SetSize(gfx::Size(grid_w, emoji_grid_->GetPreferredSize().height()));
+  // The category bar: Frequently Used, then the groups, centred as a group.
+  std::vector<views::View*> cats;
+  cats.push_back(recent_button_);
+  for (SquareImageButton* button : category_buttons_) {
+    cats.push_back(button);
+  }
+  const int cat_w =
+      static_cast<int>(cats.size()) * helium::kSpaceIconPickerCategoryCell;
+  const int cat_x = card.x() + (card.width() - cat_w) / 2;
+  const int cat_top = card.y() + helium::kSpaceIconPickerSeparatorY + 1;
+  const int cat_h = card.bottom() - cat_top;
+  for (size_t i = 0; i < cats.size(); ++i) {
+    cats[i]->SetBounds(
+        cat_x + static_cast<int>(i) * helium::kSpaceIconPickerCategoryCell,
+        cat_top + (cat_h - helium::kSpaceIconPickerCategoryCell) / 2,
+        helium::kSpaceIconPickerCategoryCell, helium::kSpaceIconPickerCategoryCell);
+  }
+
+  // Icon tab: the 8×7 grid.
+  const int icon_w =
+      helium::kSpaceIconPickerIconColumns * helium::kSpaceIconPickerIconCell;
+  icon_scroll_->SetBounds(card.x() + (card.width() - icon_w) / 2,
+                          card.y() + helium::kSpaceIconPickerIconGridTop, icon_w,
+                          helium::kSpaceIconPickerIconRows *
+                              helium::kSpaceIconPickerIconCell);
+  icon_grid_->SetSize(gfx::Size(icon_w, icon_grid_->GetPreferredSize().height()));
+}
+
+void HeliumSpaceIconPickerView::OnPaint(gfx::Canvas* canvas) {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  const SkColor card_color = CardColor(colors);
+  const gfx::Rect card_rect = CardBounds();
+  const gfx::RectF card(card_rect);
+  // The card and its tail are ONE outline, drawn as such (BuildSilhouette:
+  // the tail's sides run into the card's edge, or become the tangent of a
+  // corner they would otherwise cross). 2a-r1 unioned a rounded rect with
+  // a triangle whose base lay half a point inside the top edge; over the
+  // corner that base poked out past the arc as a ledge, and the seam showed
+  // ("拼贴的痕迹", user 2026-09-05 #3).
+  const SkPath path = BuildSilhouette();
+  cc::PaintFlags fill;
+  fill.setStyle(cc::PaintFlags::kFill_Style);
+  fill.setAntiAlias(true);
+  fill.setColor(card_color);
+  canvas->DrawPath(path, fill);
+  {
+    // The hairline: a 2pt stroke along the outline, clipped to the
+    // silhouette, so exactly the inner point of it shows -- the same
+    // weight everywhere. A 1pt stroke centred on the edge lost its outer
+    // half to this view's bounds on the three plain sides and kept it on
+    // the tail's side, which read as a line that came and went round the
+    // card ("线条出现又消失", user 2026-09-05 #3).
+    gfx::ScopedCanvas scoped(canvas);
+    canvas->ClipPath(path, /*do_anti_alias=*/true);
+    cc::PaintFlags line;
+    line.setStyle(cc::PaintFlags::kStroke_Style);
+    line.setStrokeWidth(2.0f);
+    line.setAntiAlias(true);
+    line.setColor(SkColorSetA(
+        SK_ColorBLACK,
+        static_cast<U8CPU>(helium::kSidebarMenuBorderAlpha * 255)));
+    canvas->DrawPath(path, line);
+  }
+
+  // The segmented control's pill under its two halves.
+  cc::PaintFlags pill;
+  pill.setStyle(cc::PaintFlags::kFill_Style);
+  pill.setAntiAlias(true);
+  pill.setColor(TintOverCard(card_color, helium::kSpaceIconPickerPillAlphaLight,
+                             helium::kSpaceIconPickerPillAlphaDark));
+  gfx::Rect pill_rect = emoji_segment_->bounds();
+  pill_rect.Union(icon_segment_->bounds());
+  canvas->DrawRoundRect(gfx::RectF(pill_rect), helium::kSpaceIconPickerRadius,
+                        pill);
+
+  if (tab_ == Tab::kEmoji) {
+    // The search field's pill: a near-white capsule with a hairline.
+    const bool dark = color_utils::IsDark(card_color);
+    gfx::RectF field(card.x() + helium::kSpaceIconPickerSearchInset,
+                     card.y() + helium::kSpaceIconPickerSearchTop,
+                     card.width() - 2 * helium::kSpaceIconPickerSearchInset,
+                     helium::kSpaceIconPickerSearchHeight);
+    cc::PaintFlags field_fill;
+    field_fill.setStyle(cc::PaintFlags::kFill_Style);
+    field_fill.setAntiAlias(true);
+    field_fill.setColor(dark ? color_utils::AlphaBlend(SK_ColorWHITE, card_color, 0.08f)
+                             : SK_ColorWHITE);
+    canvas->DrawRoundRect(field, helium::kSpaceIconPickerRadius, field_fill);
+    gfx::RectF field_line = field;
+    field_line.Inset(0.5f);
+    cc::PaintFlags hair;
+    hair.setStyle(cc::PaintFlags::kStroke_Style);
+    hair.setStrokeWidth(1.0f);
+    hair.setAntiAlias(true);
+    hair.setColor(SkColorSetA(SK_ColorBLACK, 0x1F));
+    canvas->DrawRoundRect(field_line, helium::kSpaceIconPickerRadius - 0.5f,
+                          hair);
+    // The separator above the category bar: one physical pixel at the
+    // card outline's own weight (Arc: 1px, black at ~0.25 on its card,
+    // user screenshot 2026-09-05 06:46). 2a-r2's 1pt at 0.20 was two
+    // pixels on a 2x screen and darker than every other line in the window
+    // ("特别粗的横线", user 2026-09-05 #2). Half a pixel down so the line
+    // lands on one pixel row instead of straddling two.
+    const float separator_y = card.y() + helium::kSpaceIconPickerSeparatorY +
+                              0.5f / canvas->image_scale();
+    canvas->Draw1pxLine(
+        gfx::PointF(card.x() + helium::kSpaceIconPickerGridLeft, separator_y),
+        gfx::PointF(card.right() - helium::kSpaceIconPickerGridLeft,
+                    separator_y),
+        SkColorSetA(SK_ColorBLACK, static_cast<U8CPU>(
+                                       helium::kSidebarMenuBorderAlpha * 255)));
+  }
+  views::View::OnPaint(canvas);
+}
+
+void HeliumSpaceIconPickerView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (colors) {
+    const gfx::ImageSkia symbol = helium::CreateSFSymbolImage(
+        kSpaceIconPickerSearchSymbol, helium::kSpaceIconPickerSearchIconSize,
+        colors->GetColor(ui::kColorIconSecondary));
+    search_icon_->SetImage(
+        symbol.isNull()
+            ? ui::ImageModel::FromVectorIcon(
+                  vector_icons::kSearchIcon, ui::kColorIconSecondary,
+                  helium::kSpaceIconPickerSearchIconSize)
+            : ui::ImageModel::FromImageSkia(symbol));
+  }
+  SchedulePaint();  // a layer's raster does not follow the theme by itself
+}
+
+bool HeliumSpaceIconPickerView::AcceleratorPressed(
+    const ui::Accelerator& accelerator) {
+  Hide();
+  return true;
+}
+
+void HeliumSpaceIconPickerView::VisibilityChanged(views::View* starting_from,
+                                                  bool is_visible) {
+  if (!is_visible && shown_) {
+    // Hidden from above: drop the dismissal hooks.
+    shown_ = false;
+    ResetAccelerators();
+    event_monitor_.reset();
+    on_picked_.Reset();
+    if (shadow_frame_) {
+      shadow_frame_->SetVisible(false);
+    }
+  }
+}
+
+void HeliumSpaceIconPickerView::ContentsChanged(
+    views::Textfield* sender,
+    const std::u16string& new_contents) {
+  clear_search_->SetVisible(!new_contents.empty());
+  RebuildEmojiGlyphs();
+  DeprecatedLayoutImmediately();
+}
+
+bool HeliumSpaceIconPickerView::HandleKeyEvent(views::Textfield* sender,
+                                               const ui::KeyEvent& key_event) {
+  if (key_event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  if (key_event.key_code() == ui::VKEY_ESCAPE) {
+    Hide();
+    return true;
+  }
+  if (key_event.key_code() == ui::VKEY_RETURN && !emoji_indices_.empty() &&
+      !std::u16string(search_->GetText()).empty()) {
+    // Return picks the first hit.
+    OnEmojiPicked(0);
+    return true;
+  }
+  return false;
+}
+
+void HeliumSpaceIconPickerView::OnEvent(const ui::Event& event) {
+  if (!shown_ || !event_monitor_) {
+    return;
+  }
+  // A press on the card is a child's; on the anchor it is the anchor's own
+  // toggle; anything else closes.
+  const gfx::Point screen_point = event_monitor_->GetLastMouseLocation();
+  if (ContainsScreenPoint(screen_point)) {
+    return;
+  }
+  if (parent()) {
+    gfx::Rect anchor_in_screen = anchor_in_parent_;
+    views::View::ConvertRectToScreen(parent(), &anchor_in_screen);
+    if (anchor_in_screen.Contains(screen_point)) {
+      return;
+    }
+  }
+  Hide();
+}
+
+void HeliumSpaceIconPickerView::SetTab(Tab tab) {
+  tab_ = tab;
+  const bool emoji = tab == Tab::kEmoji;
+  emoji_segment_->SetSelected(emoji);
+  icon_segment_->SetSelected(!emoji);
+  // ⛔ Show the incoming tab and give it the focus BEFORE hiding the other:
+  // hiding a focused view advances the focus, and the next stop after this
+  // card is the page (user 2026-09-05: the page's red focus ring).
+  if (emoji) {
+    search_icon_->SetVisible(true);
+    search_->SetVisible(true);
+    scroll_->SetVisible(true);
+    if (shown_) {
+      search_->RequestFocus();
+    }
+  } else {
+    icon_scroll_->SetVisible(true);
+    if (shown_) {
+      icon_grid_->RequestFocus();
+    }
+  }
+  search_icon_->SetVisible(emoji);
+  search_->SetVisible(emoji);
+  clear_search_->SetVisible(emoji && !std::u16string(search_->GetText()).empty());
+  scroll_->SetVisible(emoji);
+  recent_button_->SetVisible(emoji);
+  for (SquareImageButton* button : category_buttons_) {
+    button->SetVisible(emoji);
+  }
+  icon_scroll_->SetVisible(!emoji);
+  if (!emoji) {
+    // The Icon tab: mark the current vector icon, if any.
+    std::optional<size_t> selected;
+    const std::string_view name =
+        helium_workspace::VectorIconRefName(current_icon_);
+    const base::span<const helium_workspace::SpaceIconName> names =
+        helium_workspace::SpaceIconNames();
+    for (size_t i = 0; i < names.size(); ++i) {
+      if (name == names[i].name) {
+        selected = i;
+      }
+    }
+    icon_grid_->SetSelectedIndex(selected);
+  }
+  DeprecatedLayoutImmediately();
+  SchedulePaint();
+}
+
+void HeliumSpaceIconPickerView::RebuildEmojiGlyphs() {
+  const base::span<const helium_workspace::EmojiEntry> table =
+      helium_workspace::EmojiTable();
+  const std::u16string query(search_->GetText());
+  std::vector<HeliumGlyphGridView::Glyph> glyphs;
+  emoji_indices_.clear();
+  if (!query.empty()) {
+    for (const helium_workspace::EmojiEntry* entry :
+         helium_workspace::SearchEmoji(base::UTF16ToUTF8(query))) {
+      emoji_indices_.push_back(static_cast<size_t>(entry - table.data()));
+    }
+  } else if (page_ == 0) {
+    // Frequently Used: each recent that is still in the table (a table
+    // rebuilt without it just drops it). Blank until there is one.
+    for (const std::string& recent : recent_) {
+      for (size_t i = 0; i < table.size(); ++i) {
+        if (recent == table[i].utf8) {
+          emoji_indices_.push_back(i);
+          break;
+        }
+      }
+    }
+  } else {
+    // One group: the table is contiguous by group in EmojiGroup order.
+    const int groups =
+        static_cast<int>(helium_workspace::EmojiGroup::kCount);
+    const int group = std::clamp(page_ - 1, 0, groups - 1);
+    const size_t start = helium_workspace::EmojiGroupStart(
+        static_cast<helium_workspace::EmojiGroup>(group));
+    const size_t end =
+        group + 1 < groups
+            ? helium_workspace::EmojiGroupStart(
+                  static_cast<helium_workspace::EmojiGroup>(group + 1))
+            : table.size();
+    for (size_t i = start; i < end; ++i) {
+      emoji_indices_.push_back(i);
+    }
+  }
+  glyphs.reserve(emoji_indices_.size());
+  std::optional<size_t> selected;
+  for (size_t k = 0; k < emoji_indices_.size(); ++k) {
+    const helium_workspace::EmojiEntry& entry = table[emoji_indices_[k]];
+    HeliumGlyphGridView::Glyph glyph;
+    glyph.emoji = entry.utf8;
+    glyph.accessible_name = base::UTF8ToUTF16(entry.keywords);
+    // The current emoji's cell, when it is on this page.
+    if (!selected && !current_icon_.empty() && current_icon_ == entry.utf8) {
+      selected = k;
+    }
+    glyphs.push_back(std::move(glyph));
+  }
+  emoji_grid_->SetGlyphs(std::move(glyphs));
+  emoji_grid_->SetSelectedIndex(selected);
+  UpdateCategoryBar();
+  emoji_grid_->SetSize(gfx::Size(
+      helium::kSpaceIconPickerEmojiColumns * helium::kSpaceIconPickerEmojiCell,
+      emoji_grid_->GetPreferredSize().height()));
+  // Every page starts at its top; the current emoji, when on it, is
+  // brought into view (Arc scrolls its one long list to that row -- g19 /
+  // g21 -- a page has no distance to scroll).
+  emoji_grid_->ScrollRectToVisible(gfx::Rect(0, 0, 1, 1));
+  if (selected) {
+    emoji_grid_->ScrollRectToVisible(emoji_grid_->CellBounds(*selected));
+  }
+}
+
+void HeliumSpaceIconPickerView::SetPage(int page) {
+  page_ = page;
+  if (!std::u16string(search_->GetText()).empty()) {
+    OnClearSearch();  // rebuilds on the new page
+    return;
+  }
+  RebuildEmojiGlyphs();
+  DeprecatedLayoutImmediately();
+}
+
+void HeliumSpaceIconPickerView::UpdateCategoryBar() {
+  const bool paged = std::u16string(search_->GetText()).empty();
+  recent_button_->SetSelected(paged && page_ == 0);
+  for (size_t i = 0; i < category_buttons_.size(); ++i) {
+    category_buttons_[i]->SetSelected(paged &&
+                                      page_ == static_cast<int>(i) + 1);
+  }
+}
+
+void HeliumSpaceIconPickerView::RebuildIconGlyphs() {
+  std::vector<HeliumGlyphGridView::Glyph> glyphs;
+  for (const helium_workspace::SpaceIconName& name :
+       helium_workspace::SpaceIconNames()) {
+    HeliumGlyphGridView::Glyph glyph;
+    glyph.icon = FindSpaceVectorIcon(name.name);
+    glyph.accessible_name = base::UTF8ToUTF16(name.keywords);
+    glyphs.push_back(std::move(glyph));
+  }
+  icon_grid_->SetGlyphs(std::move(glyphs));
+}
+
+void HeliumSpaceIconPickerView::OnEmojiPicked(size_t index) {
+  if (index >= emoji_indices_.size()) {
+    return;
+  }
+  Finish(helium_workspace::EmojiTable()[emoji_indices_[index]].utf8);
+}
+
+void HeliumSpaceIconPickerView::OnIconPicked(size_t index) {
+  const base::span<const helium_workspace::SpaceIconName> names =
+      helium_workspace::SpaceIconNames();
+  if (index >= names.size()) {
+    return;
+  }
+  Finish(helium_workspace::MakeVectorIconRef(names[index].name));
+}
+
+void HeliumSpaceIconPickerView::OnTrashPressed() {
+  Finish(std::string());
+}
+
+void HeliumSpaceIconPickerView::OnClearSearch() {
+  search_->SetText(std::u16string());
+  ContentsChanged(search_, std::u16string());
+  search_->RequestFocus();
+}
+
+void HeliumSpaceIconPickerView::OnRecentPressed() {
+  SetPage(0);
+}
+
+void HeliumSpaceIconPickerView::OnCategoryPressed(int group) {
+  SetPage(group + 1);
+}
+
+void HeliumSpaceIconPickerView::Finish(const std::string& icon) {
+  if (!icon.empty() && !helium_workspace::IsVectorIconRef(icon)) {
+    RecordRecent(icon);
+  }
+  // A pick is not a dismissal: the picked callback is the one that runs.
+  on_closed_.Reset();
+  // Hide first, then report: the callback may re-lay out the sidebar and
+  // must not find the picker still up (M6-r2's weak-pointer rule: never
+  // invalidate, just close).
+  PickedCallback callback = std::move(on_picked_);
+  Hide();
+  if (callback) {
+    callback.Run(icon);
+  }
+}
+
+std::vector<std::string> HeliumSpaceIconPickerView::ReadRecent() const {
+  std::vector<std::string> recent;
+  if (!prefs_) {
+    return recent;
+  }
+  for (const base::Value& value :
+       prefs_->GetList(helium_workspace::prefs::kWorkspaceRecentEmoji)) {
+    if (value.is_string() && !value.GetString().empty()) {
+      recent.push_back(value.GetString());
+    }
+    if (recent.size() >= static_cast<size_t>(helium::kSpaceIconPickerRecentMax)) {
+      break;
+    }
+  }
+  return recent;
+}
+
+void HeliumSpaceIconPickerView::RecordRecent(const std::string& emoji) {
+  if (!prefs_) {
+    return;
+  }
+  // Newest first, no duplicates, capped.
+  std::vector<std::string> recent = ReadRecent();
+  std::erase(recent, emoji);
+  recent.insert(recent.begin(), emoji);
+  if (recent.size() > static_cast<size_t>(helium::kSpaceIconPickerRecentMax)) {
+    recent.resize(helium::kSpaceIconPickerRecentMax);
+  }
+  ScopedListPrefUpdate update(prefs_,
+                              helium_workspace::prefs::kWorkspaceRecentEmoji);
+  update->clear();
+  for (const std::string& entry : recent) {
+    update->Append(entry);
+  }
+}
