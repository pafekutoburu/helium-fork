+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_SPACE_ICON_PICKER_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_SPACE_ICON_PICKER_H_
+
+#include <algorithm>
+#include <cmath>
+#include <optional>
+
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/size.h"
+
+// helium-fork M6 轮2: the space icon picker -- Arc's "Emoji | Icon" popover,
+// measured on the spot 2026-09-04 (decisions.md 「M6 轮2」§3 g19/g20/g21,
+// 2x px / 2) and again 2026-09-05 off the user's recording of the bottom
+// bar's Change Space Icon… (decisions 「M6 轮2 2a-r1」§3). One popover for
+// three anchors: the head row's icon, the Create a Space form's dashed
+// button (both below the anchor, tail up) and the bottom bar's space icon
+// (above it, tail down). Numbers are offsets from the popover's own
+// top-left unless said otherwise.
+//
+// 2a-r1 (user 2026-09-05): the card is bigger than Arc's 272 square and
+// its emoji bigger than Arc's 20 -- the user asked for both, up to the
+// 373pt of their screenshot, and for a "Frequently Used" group in front of
+// Arc's eight. The proportions are Arc's, scaled.
+//
+// Header-only and free of //ui/views on purpose, like every other arc_*.h:
+// asserted in helium_workspace_unittests.
+namespace helium {
+
+// The card: Arc 272 × 271.5, corner radius 20 -- ours 360 × 340 (user
+// 2026-09-05), radius the shell's one, 12 (user rule 2026-09-03).
+inline constexpr int kSpaceIconPickerWidth = 360;
+inline constexpr int kSpaceIconPickerHeight = 340;
+inline constexpr int kSpaceIconPickerRadius = 12;
+// The tail pointing at the anchor: 10 tall on a 25 base (Arc x 14.5 to
+// 39.5 under the head row's emoji; 24 wide / 10 tall under the bottom bar's
+// icon, 2026-09-05 v3 f_045). Its tip is the anchor's centre x.
+inline constexpr int kSpaceIconPickerTailHeight = 10;
+inline constexpr int kSpaceIconPickerTailBase = 25;
+// 2a-r3: the tail is one smooth line (user 2026-09-05 #2 "全统一成圆润的
+// 曲线"): a rounded tip, and each foot flowing into the top edge through a
+// concave fillet rather than a fold. A foot that would land on a corner arc
+// takes the tangent into that arc instead (SpaceIconPickerTailSideEnd).
+inline constexpr float kSpaceIconPickerTailTipRadius = 2.0f;
+inline constexpr float kSpaceIconPickerTailFootRadius = 4.0f;
+// The card's left edge: 4 in from the sidebar's left edge whatever the
+// anchor -- the gap every card in the shell keeps from an edge (the content
+// card's and the floating sidebar's 4, M6-r5). Arc has 13, and its tail
+// then lands on the card's top-left corner; the user read that as the two
+// top corners not matching ("失去平衡感", 2026-09-05 #2). At 4 the form's
+// "+" (34 in from the sidebar) puts both feet, fillets included, on the
+// straight edge with 4pt of plain edge left between the fillet and the
+// corner's arc, so the two top corners are the same shape -- pinned by
+// the unit test through SpaceIconPickerTailFootClearance (at 8 the fillet
+// ended 0.1 from the arc and the two still read as one curve). The head
+// row's emoji (25 in) still reaches the corner and gets the tangent there.
+inline constexpr int kSpaceIconPickerLeftInset = 4;
+// Where the card lands next to its anchor. Under the head row Arc puts its
+// top 17 below the row's bottom (the tail in between, its tip 8.5 under the
+// emoji); under the form's input row only 5 (the tail overlaps the row's
+// bottom edge). Above the bottom bar (2026-09-05 v3 f_045) the card's
+// bottom is 21.5 above the icon glyph's top; a 14pt glyph centred in the
+// bar's 32pt slot puts that 12 above the slot's top -- the 10pt tail and a
+// 2pt gap.
+inline constexpr int kSpaceIconPickerGapBelowHeadRow = 17;
+inline constexpr int kSpaceIconPickerGapBelowFormRow = 5;
+inline constexpr int kSpaceIconPickerGapAboveBarSlot = 12;
+
+// Which side of the anchor the card is on. Below: the tail rises from the
+// card's top edge to the anchor. Above: it drops from the bottom edge.
+enum class SpaceIconPickerPlacement { kBelowAnchor, kAboveAnchor };
+
+// The "Emoji | Icon" segmented control: Arc's is a 24-tall pill of two
+// 57-wide segments on its 272 card; ours is scaled by the card ratio
+// (360/272 = 1.32) to 32 × 75, the same height as the search field under it
+// (Arc keeps those two equal) -- 2a-r3, user 2026-09-05 #2: the 24s on the
+// bigger card read as too small and out of step with the 40 cells. The
+// selected half is blue (0,116,248) with white text; corners the shell's
+// 12, not the pill's half-height. The trash sits 19 right of the pill in a
+// 32 square; the pill-plus-trash group is centred on the card, and without
+// an icon there is no trash and the pill centres by itself (Arc: the pill
+// moves 15 right).
+inline constexpr int kSpaceIconPickerSegmentTop = 13;
+inline constexpr int kSpaceIconPickerSegmentHeight = 32;
+inline constexpr int kSpaceIconPickerSegmentWidth = 75;
+inline constexpr int kSpaceIconPickerTrashGap = 19;
+inline constexpr int kSpaceIconPickerTrashSlot = 32;
+inline constexpr unsigned kSpaceIconPickerSelectedR = 0;
+inline constexpr unsigned kSpaceIconPickerSelectedG = 116;
+inline constexpr unsigned kSpaceIconPickerSelectedB = 248;
+
+// The hover / selected square behind a cell (Arc: a lighter square on its
+// frosted card in the dark space, a greyer one on the light card) and the
+// segmented control's pill: a contrast tint over the card, not a fixed
+// colour.
+inline constexpr float kSpaceIconPickerSquareAlphaLight = 0.08f;
+inline constexpr float kSpaceIconPickerSquareAlphaDark = 0.14f;
+inline constexpr float kSpaceIconPickerPillAlphaLight = 0.10f;
+inline constexpr float kSpaceIconPickerPillAlphaDark = 0.16f;
+
+// The search field (Emoji tab): Arc x 24–275 in the sidebar (11 in from the
+// card's edges), 23.5 tall; ours 32 (the card ratio, and the control's
+// height -- user 2026-09-05 #2 "搜索框太矮"), 10 under the control, its
+// glyph 18 (Arc 14, scaled).
+inline constexpr int kSpaceIconPickerSearchTop = 55;
+inline constexpr int kSpaceIconPickerSearchHeight = 32;
+inline constexpr int kSpaceIconPickerSearchInset = 11;
+inline constexpr int kSpaceIconPickerSearchIconSize = 18;
+inline constexpr int kSpaceIconPickerSearchIconInset = 9;
+inline constexpr int kSpaceIconPickerSearchFontSize = 15;
+
+// The emoji grid: Arc 7 columns of 33 square cells with ~20pt glyphs; ours
+// 8 columns of 40 with 24pt glyphs (user 2026-09-05), 10 under the search
+// field and exactly five rows tall (200) down to the separator 43 above
+// the card's bottom (Arc 471 of 514.5); the scrollbar at the right edge.
+//
+// 2a-r3 (user 2026-09-05 #2): one *page* per category rather than Arc's
+// single scrolling list -- page 0 is Frequently Used (shown blank until
+// something has been used; the picker always opens on it), pages 1–8 the
+// groups in Arc's order; a category button switches pages, and each page
+// scrolls by itself. A search lays its hits out flat on one page.
+inline constexpr int kSpaceIconPickerEmojiColumns = 8;
+inline constexpr int kSpaceIconPickerEmojiCell = 40;
+inline constexpr int kSpaceIconPickerEmojiGlyph = 24;
+inline constexpr int kSpaceIconPickerGridLeft = 11;
+inline constexpr int kSpaceIconPickerEmojiGridTop = 97;
+inline constexpr int kSpaceIconPickerCategoryBarHeight = 43;
+inline constexpr int kSpaceIconPickerSeparatorY =
+    kSpaceIconPickerHeight - kSpaceIconPickerCategoryBarHeight;
+// The category bar: Arc's eight groups in 31 cells with ~14pt outline
+// glyphs; ours nine (Frequently Used first, user 2026-09-05) in 36 cells
+// with 16pt glyphs. The current page's button wears the hover square (our
+// ruling; Arc's bar has no selected state we measured).
+inline constexpr int kSpaceIconPickerCategoryCells = 9;
+inline constexpr int kSpaceIconPickerCategoryCell = 36;
+inline constexpr int kSpaceIconPickerCategoryGlyph = 16;
+// How many recently used emoji the first page keeps: three rows.
+inline constexpr int kSpaceIconPickerRecentMax = 3 * kSpaceIconPickerEmojiColumns;
+
+// The Icon tab: 8 columns × 7 rows of square cells (56 icons), Arc 31 with
+// ~12pt glyphs, ours 40 with 16; centred in what the control leaves (Arc:
+// from y 47, 290 − 243); no search field, no category bar.
+inline constexpr int kSpaceIconPickerIconColumns = 8;
+inline constexpr int kSpaceIconPickerIconRows = 7;
+inline constexpr int kSpaceIconPickerIconCell = 40;
+inline constexpr int kSpaceIconPickerIconGlyph = 16;
+inline constexpr int kSpaceIconPickerIconGridTop =
+    kSpaceIconPickerSegmentTop + kSpaceIconPickerSegmentHeight +
+    (kSpaceIconPickerHeight - kSpaceIconPickerSegmentTop -
+     kSpaceIconPickerSegmentHeight -
+     kSpaceIconPickerIconRows * kSpaceIconPickerIconCell) /
+        2;
+
+// The grid's height for |count| items in |columns| columns of |cell|.
+inline constexpr int GlyphGridHeight(int count, int columns, int cell) {
+  if (count <= 0 || columns <= 0) {
+    return 0;
+  }
+  return ((count + columns - 1) / columns) * cell;
+}
+
+// The item under |point| in such a grid, or none.
+inline std::optional<int> GlyphGridIndexAt(const gfx::Point& point,
+                                           int count,
+                                           int columns,
+                                           int cell) {
+  if (count <= 0 || columns <= 0 || cell <= 0 || point.x() < 0 ||
+      point.y() < 0 || point.x() >= columns * cell) {
+    return std::nullopt;
+  }
+  const int index = (point.y() / cell) * columns + point.x() / cell;
+  if (index >= count) {
+    return std::nullopt;
+  }
+  return index;
+}
+
+// The cell rect of item |index|.
+inline gfx::Rect GlyphGridCell(int index, int columns, int cell) {
+  return gfx::Rect((index % columns) * cell, (index / columns) * cell, cell,
+                   cell);
+}
+
+// The card's bounds in the parent for a card whose top should land at
+// |body_top| and left at |left| (the sidebar's left edge + inset), kept
+// inside |parent|: a card that would run off the bottom slides up, one
+// that would run off the right slides left.
+inline gfx::Rect SpaceIconPickerBounds(int left,
+                                       int body_top,
+                                       const gfx::Size& parent) {
+  const int width = std::min(kSpaceIconPickerWidth, std::max(parent.width(), 0));
+  const int height =
+      std::min(kSpaceIconPickerHeight, std::max(parent.height(), 0));
+  const int x = std::clamp(left, 0, std::max(parent.width() - width, 0));
+  const int y = std::clamp(body_top, 0, std::max(parent.height() - height, 0));
+  return gfx::Rect(x, y, width, height);
+}
+
+// The same for a card whose *bottom* should land at |body_bottom| (the
+// bottom bar's anchor): a card that would run off the top slides down.
+inline gfx::Rect SpaceIconPickerBoundsAbove(int left,
+                                            int body_bottom,
+                                            const gfx::Size& parent) {
+  const int height =
+      std::min(kSpaceIconPickerHeight, std::max(parent.height(), 0));
+  return SpaceIconPickerBounds(left, body_bottom - height, parent);
+}
+
+// The tail's tip x for an anchor centred at |anchor_center_x|, in the same
+// coordinates as |card|: the anchor's centre, kept far enough inside the
+// card's edges for the whole base to sit on the card. Not held clear of
+// the corner radius -- Arc's tail base starts 1.5 in from the card's edge
+// (g19 x 14.5 on a card at 13) and the two are drawn as one silhouette.
+inline int SpaceIconPickerTailTipX(int anchor_center_x, const gfx::Rect& card) {
+  const int lo = card.x() + kSpaceIconPickerTailBase / 2;
+  const int hi = card.right() - kSpaceIconPickerTailBase / 2;
+  return std::clamp(anchor_center_x, lo, std::max(lo, hi));
+}
+
+// How far along the edge a foot's fillet reaches past the foot itself:
+// r·tan(θ/2) for a side climbing at θ above the edge. A foot needs that
+// much between itself and a corner arc to stay off the arc.
+inline float SpaceIconPickerTailFootClearance() {
+  const float theta =
+      std::atan2(static_cast<float>(kSpaceIconPickerTailHeight),
+                 kSpaceIconPickerTailBase / 2.0f);
+  return kSpaceIconPickerTailFootRadius * std::tan(theta / 2);
+}
+
+// One side of the tail, in a frame where the tail rises from the card's TOP
+// edge (the bottom bar's tail is this frame flipped about the card's middle).
+// |end| is where the side meets the card's outline. On the straight part of
+// the edge that is the nominal base point, |half_base| out from the tip's x
+// (the foot's fillet, |foot_clearance| wide, is the caller's to draw and
+// must fit on the straight part too). Over a rounded corner the side is
+// instead the tangent from the tip to that corner's arc, ending where it
+// touches, so the tail flows into the corner as one line. A base laid
+// straight across the arc left a sliver of itself sticking out past the
+// curve, and a side extended down through the corner overhangs the card's
+// edge for the anchors we have (radius 12): user 2026-09-05 #3 "拼贴的痕迹
+// …肯定是一个整体". Arc's own treatment of a tail over its corner was not
+// captured (g19/g21b frames gone) -- ours.
+struct SpaceIconPickerTailSide {
+  gfx::PointF end;
+  // Set when |end| lies on a corner arc: the arc's angle there in Skia's
+  // degrees (0 at 3 o'clock, clockwise on screen), so the outline can run
+  // the corner up to it. Left corner 180–270, right corner 270–360.
+  std::optional<float> corner_angle_deg;
+};
+
+inline SpaceIconPickerTailSide SpaceIconPickerTailSideEnd(
+    const gfx::PointF& tip,
+    const gfx::RectF& card,
+    float radius,
+    float half_base,
+    bool right,
+    float foot_clearance) {
+  const float nominal_x = right ? tip.x() + half_base : tip.x() - half_base;
+  const float outer_x =
+      right ? nominal_x + foot_clearance : nominal_x - foot_clearance;
+  if (outer_x >= card.x() + radius && outer_x <= card.right() - radius) {
+    return {gfx::PointF(nominal_x, card.y()), std::nullopt};
+  }
+  const gfx::PointF centre(right ? card.right() - radius : card.x() + radius,
+                           card.y() + radius);
+  const float dx = tip.x() - centre.x();
+  const float dy = tip.y() - centre.y();
+  const float distance = std::hypot(dx, dy);
+  if (distance <= radius) {  // a tip inside the corner circle: no tangent
+    return {gfx::PointF(nominal_x, card.y()), std::nullopt};
+  }
+  constexpr float kPi = 3.14159265358979f;
+  const float phi = std::atan2(dy, dx);
+  const float alpha = std::acos(radius / distance);
+  float theta = right ? phi + alpha : phi - alpha;
+  while (theta < 0) {
+    theta += 2 * kPi;
+  }
+  while (theta >= 2 * kPi) {
+    theta -= 2 * kPi;
+  }
+  // Keep to the quarter that is part of the outline.
+  const float lo = right ? 1.5f * kPi : kPi;
+  theta = std::clamp(theta, lo, lo + kPi / 2);
+  return {gfx::PointF(centre.x() + radius * std::cos(theta),
+                      centre.y() + radius * std::sin(theta)),
+          theta * 180.0f / kPi};
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_SPACE_ICON_PICKER_H_
