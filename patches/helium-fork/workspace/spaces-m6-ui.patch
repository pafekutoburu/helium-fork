+void VerticalTabStripRegionView::OnCurrentSpaceChangedForToday() {
+  // The Today rows of the space being left get a zero rect, the new space's
+  // get theirs back; nothing in the view tree changes, so somebody has to
+  // relayout (same shape as the bindings observer's, drag guard included).
+  // M6-r2: snapped, not invalidated -- InvalidateLayout() let the container's
+  // animating layout manager tween the change (rows fading in, the height
+  // and New Tab settling upward) inside the horizontal slide below; Arc's
+  // list arrives already laid out (user 2026-09-03 recording, item 4).
+  if (UnpinnedTabContainerView* const today = TodayDropContainer();
+      today && !today->IsDragging()) {
+    today->SnapLayoutToTarget();
+  }
+  // M6-r1: the switch slides the list region in (Arc 2026-09-03: the head
+  // row, pinned rows, folders, Today and New Tab move as one; favorites,
+  // the address row and the bottom bar stay). The controller says which
+  // way; 0 is a landing (startup, restore) and does not animate.
+  // M6-r3: the New Tab button rides along. It lives in the bottom
+  // container, outside the strip, so it gets a layer of its own for the
+  // slide (its label's subpixel text goes greyscale for those 180ms: a
+  // non-opaque layer cannot carry LCD text, label.cc). Set up before the
+  // strip starts so the first frame's transform reaches it too.
+  if (TabStripView* const strip = tab_strip_view()) {
+    if (const auto* controller = helium_workspace::WorkspaceTabController::From(
+            browser_view()->browser())) {
+      const int direction = controller->last_switch_direction();
+      VerticalNewTabButton* const button =
+          bottom_button_container_ ? bottom_button_container_->new_tab_button()
+                                   : nullptr;
+      if (direction != 0 && button && button->GetVisible()) {
+        button->SetSlideLayerActive(true);
+        new_tab_slide_layer_ = true;
+      }
+      strip->SetSlideCallbacks(
+          base::BindRepeating(&VerticalTabStripRegionView::OnListSlideProgress,
+                              base::Unretained(this)),
+          base::BindRepeating(&VerticalTabStripRegionView::OnListSlideEnded,
+                              base::Unretained(this)));
+      strip->SlideListRegion(direction);
+    }
+  }
+}
+
+void VerticalTabStripRegionView::OnCurrentSpaceWillChange(int direction) {
+  TabStripView* const strip = tab_strip_view();
+  if (!strip || direction == 0 || !GetWidget() || !layer()) {
+    return;
+  }
+  strip->CaptureListSnapshot();
+  new_tab_snapshot_.reset();
+  VerticalNewTabButton* const button =
+      bottom_button_container_ ? bottom_button_container_->new_tab_button()
+                               : nullptr;
+  if (button && button->GetVisible() && !button->size().IsEmpty()) {
+    // The container clips: the button leaves and arrives through the
+    // sidebar's edges, not over the page (the region's layer never clips).
+    if (!bottom_button_container_->layer()) {
+      bottom_button_container_->SetPaintToLayer();
+      bottom_button_container_->layer()->SetFillsBoundsOpaquely(false);
+      bottom_button_container_->layer()->SetMasksToBounds(true);
+      bottom_container_slide_layer_ = true;
+    }
+    new_tab_snapshot_ = HeliumViewSnapshotLayer::Capture(
+        button, button->GetLocalBounds(), layer()->device_scale_factor());
+    if (new_tab_snapshot_) {
+      gfx::RectF bounds(gfx::SizeF(button->size()));
+      views::View::ConvertRectToTarget(button, bottom_button_container_,
+                                       &bounds);
+      new_tab_snapshot_->layer()->SetBounds(gfx::ToEnclosingRect(bounds));
+      bottom_button_container_->layer()->Add(new_tab_snapshot_->layer());
+    }
+  }
+  // M6-r4: the leaving list's card shadow goes with it (r3 hid it for the
+  // slide, which the user read as a blink: 2026-09-03 recording, shadow
+  // zone 211 -> 222 -> 211 over 7 frames). Snapshotted like the list, into
+  // the host's masking layer at its landed (untransformed) bounds;
+  // OnListSlideProgress drives it out at dx_old. The live shadow stays
+  // live: the containers re-aim it at the arriving list's active row on
+  // the first layout, and it rides the same transform in.
+  leaving_shadow_snapshots_.clear();
+  if (row_shadow_host_ && row_shadow_host_->layer()) {
+    for (HeliumCardShadowView* shadow :
+         {pinned_row_shadow_.get(), active_row_shadow_.get()}) {
+      if (!shadow || !shadow->GetVisible() || shadow->size().IsEmpty()) {
+        continue;
+      }
+      std::unique_ptr<HeliumViewSnapshotLayer> snapshot =
+          HeliumViewSnapshotLayer::Capture(shadow, shadow->GetLocalBounds(),
+                                           layer()->device_scale_factor());
+      if (!snapshot) {
+        continue;
+      }
+      snapshot->layer()->SetBounds(shadow->bounds());
+      row_shadow_host_->layer()->Add(snapshot->layer());
+      leaving_shadow_snapshots_.push_back(std::move(snapshot));
+    }
+  }
+}
+
+void VerticalTabStripRegionView::OnListSlideProgress(float dx_live,
+                                                     float dx_old) {
+  VerticalNewTabButton* const button =
+      bottom_button_container_ ? bottom_button_container_->new_tab_button()
+                               : nullptr;
+  if (button && button->layer() && new_tab_slide_layer_) {
+    button->layer()->SetTransform(
+        gfx::Transform::MakeTranslation(dx_live, 0.0f));
+  }
+  if (new_tab_snapshot_) {
+    new_tab_snapshot_->layer()->SetTransform(
+        gfx::Transform::MakeTranslation(dx_old, 0.0f));
+  }
+  // M6-r4: the row shadows ride with their lists.
+  const gfx::Transform live = gfx::Transform::MakeTranslation(dx_live, 0.0f);
+  for (HeliumCardShadowView* shadow :
+       {pinned_row_shadow_.get(), active_row_shadow_.get()}) {
+    if (shadow && shadow->layer()) {
+      shadow->layer()->SetTransform(live);
+    }
+  }
+  const gfx::Transform old = gfx::Transform::MakeTranslation(dx_old, 0.0f);
+  for (auto& snapshot : leaving_shadow_snapshots_) {
+    snapshot->layer()->SetTransform(old);
+  }
+}
+
+void VerticalTabStripRegionView::OnListSlideEnded() {
+  new_tab_snapshot_.reset();
+  leaving_shadow_snapshots_.clear();
+  for (HeliumCardShadowView* shadow :
+       {pinned_row_shadow_.get(), active_row_shadow_.get()}) {
+    if (shadow && shadow->layer()) {
+      shadow->layer()->SetTransform(gfx::Transform());
+    }
+  }
+  VerticalNewTabButton* const button =
+      bottom_button_container_ ? bottom_button_container_->new_tab_button()
+                               : nullptr;
+  if (button && new_tab_slide_layer_) {
+    button->SetSlideLayerActive(false);
+  }
+  new_tab_slide_layer_ = false;
+  if (bottom_container_slide_layer_ && bottom_button_container_ &&
+      bottom_button_container_->layer()) {
+    bottom_button_container_->DestroyLayer();
+  }
+  bottom_container_slide_layer_ = false;
+  // The card shadow: both containers re-derive it in their Layout.
+  if (WorkspaceSidebarView* const sidebar = WorkspaceDragSidebar()) {
+    sidebar->InvalidateLayout();
+  }
+  if (UnpinnedTabContainerView* const today = TodayDropContainer()) {
+    today->InvalidateLayout();
+  }
+}
