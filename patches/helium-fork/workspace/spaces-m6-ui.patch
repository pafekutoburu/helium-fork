+  // Same command as the window menu's New Folder: lands at the end of the
+  // current space and goes straight into rename.
+  if (auto* controller =
+          helium_workspace::WorkspaceTabController::From(GetBrowserWindow())) {
+    controller->NewFolderFromMenu();
+  }
+}
+
+void WorkspaceSidebarView::OnSpaceDeleteRequested(
+    const std::string& space_id) {
+  // The controller owns the confirmation and the delete (the bottom bar's
+  // icons ask it the same way).
+  if (auto* controller =
+          helium_workspace::WorkspaceTabController::From(GetBrowserWindow())) {
+    controller->RequestDeleteSpace(space_id);
+  }
+}
+
+void WorkspaceSidebarView::StartSpaceRename(const std::string& space_id) {
+  RefreshCurrentSpaceId();
+  if (space_head_row_ && space_head_row_->GetVisible() &&
+      space_head_row_->space_id() == space_id) {
+    space_head_row_->StartRename();
+    return;
+  }
+  pending_rename_space_id_ = space_id;
+  SyncSpaceHead();
+}
+
+void WorkspaceSidebarView::SyncSpaceHead() {
+  if (!service_ || !space_head_row_) {
+    return;
+  }
+  const helium_workspace::WorkspaceSpace* space =
+      current_space_id_.empty() ? nullptr
+                                : service_->FindSpaceById(current_space_id_);
+  space_head_row_->SetVisible(space != nullptr);
+  if (!space) {
+    return;
+  }
+  space_head_row_->SetSpace(*space);
+  if (pending_rename_space_id_ == space->id) {
+    pending_rename_space_id_.clear();
+    space_head_row_->StartRename();
+  }
+}
+
+void WorkspaceSidebarView::OnWorkspaceSpacesChanged() {
+  // Every space mutation also fires OnWorkspaceEntriesChanged (the entries'
+  // order is keyed on the space order), and SyncEntryViews syncs the head;
+  // this is only here so a name/icon edit shows without waiting for it.
+  SyncSpaceHead();
+}
+
+void WorkspaceSidebarView::OnCurrentSpaceChanged() {
+  // ⛔ Both blends' size guards compare entry counts, which two spaces can
+  // share; drop the snapshots outright rather than lerp unrelated rows.
+  if (folder_animation_.is_animating()) {
+    folder_animation_.End();
+    folder_fade_animation_.End();
+  }
+  animating_folder_id_.clear();
+  animating_space_ = false;
+  folder_prev_layout_valid_ = false;
+  drag_prev_layout_valid_ = false;
+  // Per-window, per-space runtime state of the rows that are leaving.
+  surfaced_entry_ids_.clear();
+  drop_surfaced_entry_id_.clear();
+  SyncEntryViews();
+  PreferredSizeChanged();
+  InvalidateLayout();
+  // M6-r4: land the container's animating layout manager on the new
+  // height now. Left to itself it tweens our bounds to the new list's over
+  // 200ms while View::Paint clips the rows past the trailing bounds, so a
+  // space with more rows than the one left had its last row(s) wiped in
+  // over ~5 frames of the carousel (user 2026-09-03 recording, item 1;
+  // same mechanism as M3.10-r2's, same cure as Today's in r2).
+  if (auto* const container =
+          views::AsViewClass<PinnedTabContainerView>(parent());
+      container && !container->IsDragging()) {
+    container->SnapLayoutToTarget();
+  }
+  // Rows just moved under a pointer that did not.
+  ScheduleHoverResync();
+}
