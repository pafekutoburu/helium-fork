+
+class BrowserWindowInterface;
+class HeliumCardShadowView;
+
+namespace views {
+class EventMonitor;
+}  // namespace views
+
+// helium-fork M6: the panel the sidebar's bottom "⌄" opens -- Dia's shape
+// (user 2026-09-02, measured off their screenshot: helium/arc_sidebar_menu.h)
+// with our four rows: New Space / Downloads › / History › / Bookmarks ›.
+// The user merged "new space" and the toolbar's downloads button into this
+// menu and asked for History and Bookmarks here the way Dia has them.
+//
+// M6-r1 (user recording 2026-09-03, decisions "M6-r1" §4): the three "›"
+// rows open a submenu on HOVER -- Dia's panel is a small browsing window in
+// its own right, so the recent history, the bookmark folders (nested) and
+// the recent downloads are one hover away. A submenu is the same card,
+// placed against its parent's right edge with their bottoms aligned; a
+// folder row inside opens the next level the same way. Hovering another
+// row of the panel swaps the submenu; hovering New Space closes it.
+// Clicking a leaf runs it and closes everything.
+//
+// A BrowserView child, like ArcOmniboxPanelView and for the same reason: the
+// panel is wider than the sidebar and runs out over the page, and every
+// layer between the sidebar's bottom and the window masks to bounds. It
+// places itself off the anchor the region hands it (the "⌄"'s bounds in
+// BrowserView coordinates); BrowserViewLayout never touches it. The
+// submenus are BrowserView children too (added and removed by this view,
+// each with a shadow sibling underneath), for the same clipping reason.
+//
+// Opens and closes the way the media panel does: one 200ms tween drives
+// the height (growing upward from a bottom edge pinned above the anchor)
+// and the layer opacity together. Dismissal -- which the hover-driven media
+// panel never needed -- is Escape (an accelerator registered only while
+// shown) and any mouse press outside the panel, its submenus and its anchor
+// (a window event monitor, also only while shown). The rows are leaf
+// buttons; the panel itself owns no ContextMenuController.
+class HeliumSidebarMenuView : public views::View,
+                              public views::AnimationDelegateViews,
+                              public ui::EventObserver,
+                              public HeliumSidebarSubmenuView::Delegate {
+  METADATA_HEADER(HeliumSidebarMenuView, views::View)
+
+ public:
+  explicit HeliumSidebarMenuView(BrowserWindowInterface* browser);
+  HeliumSidebarMenuView(const HeliumSidebarMenuView&) = delete;
+  HeliumSidebarMenuView& operator=(const HeliumSidebarMenuView&) = delete;
+  ~HeliumSidebarMenuView() override;
+
+  // The region-owned shadow this panel drives (a sibling layer inherits
+  // neither opacity nor visibility, so it is driven by hand -- the media
+  // panel's contract).
+  void SetShadowFrame(HeliumCardShadowView* shadow);
+
+  // |anchor_in_parent| is the "⌄"'s 32pt slot in the parent's coordinates.
+  void Toggle(const gfx::Rect& anchor_in_parent);
+  void Show(const gfx::Rect& anchor_in_parent);
+  void Hide();
+  bool IsShowing() const { return shown_; }
+
+  // Whether |screen_point| is on the panel or any open submenu (the
+  // region's caption test asks, so a click there is never a window drag).
+  bool ContainsScreenPoint(const gfx::Point& screen_point) const;
+
+  // views::View:
+  void Layout(PassKey) override;
+  void OnPaint(gfx::Canvas* canvas) override;
+  void OnThemeChanged() override;
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override;
+  void VisibilityChanged(views::View* starting_from, bool is_visible) override;
+
+  // views::AnimationDelegateViews:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override;
+
+  // HeliumSidebarSubmenuView::Delegate:
+  void OnSubmenuRowHovered(HeliumSidebarSubmenuView* menu,
+                           size_t index) override;
+  void OnSubmenuRowActivated() override;
+
+ private:
+  enum class Action { kNewSpace, kDownloads, kHistory, kBookmarks };
+  struct SubmenuLevel {
+    raw_ptr<HeliumSidebarSubmenuView> view = nullptr;
+    raw_ptr<HeliumCardShadowView> shadow = nullptr;
+    // The row of the level above (or of the panel) that opened this one.
+    size_t parent_row = 0;
+  };
+
+  void Run(Action action);
+  void OnRowHovered(Action action);
+  int ExpandedHeight() const;
+  // Re-derives bounds (and the shadow) from the anchor at the tween's value.
+  void UpdateBounds();
+  void SetShown(bool shown);
+
+  // Submenus: |depth| 0 hangs off this panel, deeper ones off the level
+  // above. Opening a level closes everything at that depth and below.
+  void OpenSubmenu(int depth,
+                   std::vector<HeliumSidebarMenuItem> items,
+                   size_t parent_row = 0);
+  void CloseSubmenusFrom(int depth);
+  void PositionSubmenus();
+  // The history query lands here; opens the submenu if History is still
+  // the hovered row.
+  void OnHistoryItems(std::vector<HeliumSidebarMenuItem> items);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<HeliumCardShadowView> shadow_frame_ = nullptr;
+  std::vector<raw_ptr<HeliumSidebarMenuRowView>> rows_;
+  std::vector<Action> row_actions_;
+  gfx::Rect anchor_in_parent_;
+  bool shown_ = false;
+  gfx::SlideAnimation open_animation_{this};
+  std::unique_ptr<views::EventMonitor> event_monitor_;
+
+  std::unique_ptr<HeliumSidebarMenuData> data_;
+  std::vector<SubmenuLevel> submenus_;
+  // The panel row whose submenu is open or being fetched.
+  std::optional<Action> submenu_action_;
+  base::WeakPtrFactory<HeliumSidebarMenuView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_HELIUM_SIDEBAR_MENU_VIEW_H_
