+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/vertical_tab_strip_region_view.h"
+#include "chrome/browser/ui/views/tabs/common/workspace_sidebar_view.h"
+
+namespace {
+
+// Arc g1 f_00300 (2x px / 2): the current space's square is 32x32 with a
+// ≈7pt radius; the emoji glyph is 13-14pt tall; the icon-less dot is 8pt.
+// M6-r3: was Arc's 7; the user's rule (2026-09-03) is one radius for every
+// rounded rect in the shell, the capsules' 12.
+constexpr int kSquareRadius = 12;
+constexpr int kEmojiFontSize = 13;
+constexpr int kDotSize = 8;
+constexpr int kMenuGlyphSize = 16;
+// The download indicator: a small dot at the "⌄"'s top-right corner.
+constexpr int kDownloadDotSize = 6;
+
+// The icon's menu (M6-r1), the head row's list: executed here, never in
+// the browser command table.
+enum SpaceBarMenuCommand {
+  kRenameSpace = 1,
+  kNewFolder,
+  kDeleteSpace,
+};
+
+// One model per menu: the delegate hands the command back to the bar with
+// the space it was opened for.
+class SpaceMenuModel : public ui::SimpleMenuModel,
+                       public ui::SimpleMenuModel::Delegate {
+ public:
+  SpaceMenuModel(base::RepeatingCallback<void(int)> on_command)
+      : ui::SimpleMenuModel(this), on_command_(std::move(on_command)) {
+    AddItemWithStringId(kRenameSpace, IDS_HELIUM_WS_SPACE_MENU_RENAME);
+    AddSeparator(ui::NORMAL_SEPARATOR);
+    AddItemWithStringId(kNewFolder, IDS_HELIUM_WS_NEW_FOLDER);
+    AddSeparator(ui::NORMAL_SEPARATOR);
+    AddItemWithStringId(kDeleteSpace, IDS_HELIUM_WS_SPACE_MENU_DELETE);
+  }
+  ~SpaceMenuModel() override = default;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override {
+    on_command_.Run(command_id);
+  }
+
+ private:
+  const base::RepeatingCallback<void(int)> on_command_;
+};
+
+}  // namespace
+
+// One space's icon. A leaf: it may carry its own menu one day, the bar may
+// not. Paints the current-space square behind the emoji (or the dot), and
+// desaturates itself through a layer filter when it is not current.
+class WorkspaceSpaceBarView::SpaceButton : public views::Button,
+                                           public views::ContextMenuController {
+  METADATA_HEADER(SpaceButton, views::Button)
+
+ public:
+  using ContextMenuCallback = base::RepeatingCallback<
+      void(const std::string&, const gfx::Point&, ui::mojom::MenuSourceType)>;
+
+  SpaceButton(PressedCallback callback, ContextMenuCallback on_context_menu)
+      : views::Button(std::move(callback)),
+        on_context_menu_(std::move(on_context_menu)) {
+    // A leaf: its right-click is the space menu (M6-r1). Nothing is taken
+    // from the bar or the sidebar blank (M4-r2).
+    set_context_menu_controller(this);
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    // Born non-current: the filter has to be on from the start, SetCurrent
+    // only flips it on a change.
+    layer()->SetLayerGrayscale(1.0f);
+    emoji_ = AddChildView(std::make_unique<views::Label>());
+    emoji_->SetCanProcessEventsWithinSubtree(false);
+    emoji_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    emoji_->SetAutoColorReadabilityEnabled(false);
+    // A label on a layered view must not draw subpixel text (Label DCHECKs
+    // it -- helium_undo_bar_view.cc).
+    emoji_->SetSubpixelRenderingEnabled(false);
+    emoji_->SetFontList(emoji_->font_list().DeriveWithSizeDelta(
+        kEmojiFontSize - emoji_->font_list().GetFontSize()));
+    GetViewAccessibility().SetRole(ax::mojom::Role::kButton);
+    // Named at construction: a focusable view with no name aborts under
+    // DCHECKs the first time it is painted. SetSpace() names it properly.
+    GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_HELIUM_WS_NEW_SPACE_DEFAULT_NAME));
+  }
+
+  void SetSpace(const helium_workspace::WorkspaceSpace& space, size_t index) {
+    space_id_ = space.id;
+    icon_ = space.icon;
+    emoji_->SetText(base::UTF8ToUTF16(icon_));
+    emoji_->SetVisible(!icon_.empty());
+    // Arc g8c f_01153: "AI  ⌃2" -- the name and its Control+number.
+    const std::u16string tooltip = l10n_util::GetStringFUTF16(
+        IDS_HELIUM_WS_SPACE_TOOLTIP, space.name,
+        base::NumberToString16(static_cast<int>(index + 1)));
+    SetTooltipText(tooltip);
+    GetViewAccessibility().SetName(space.name.empty() ? tooltip : space.name);
+    InvalidateLayout();
+    SchedulePaint();
+  }
+
+  void SetCurrent(bool current) {
+    if (current_ == current) {
+      return;
+    }
+    current_ = current;
+    // Arc: non-current icons are fully desaturated and not dimmed (their
+    // luminance matches the current one's, measured across g1's frames).
+    layer()->SetLayerGrayscale(current_ ? 0.0f : 1.0f);
+    SchedulePaint();
+  }
+
+  const std::string& space_id() const { return space_id_; }
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override {
+    on_context_menu_.Run(space_id_, point, source_type);
+  }
+
+  // views::View:
+  void Layout(PassKey) override { emoji_->SetBoundsRect(GetLocalBounds()); }
+
+  // Button::OnPaint is final; the background pass paints under the emoji
+  // label, which is where the square belongs anyway.
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    const SkColor sidebar = colors->GetColor(kColorToolbar);
+    if (current_) {
+      cc::PaintFlags fill;
+      fill.setStyle(cc::PaintFlags::kFill_Style);
+      fill.setAntiAlias(true);
+      fill.setColor(helium::GetSidebarCurrentSpaceSurfaceColor(sidebar));
+      canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), kSquareRadius, fill);
+    }
+    if (icon_.empty()) {
+      cc::PaintFlags dot;
+      dot.setStyle(cc::PaintFlags::kFill_Style);
+      dot.setAntiAlias(true);
+      dot.setColor(colors->GetColor(ui::kColorLabelForegroundSecondary));
+      canvas->DrawCircle(gfx::PointF(GetLocalBounds().CenterPoint()),
+                         kDotSize / 2.0f, dot);
+    }
+  }
+
+ private:
+  const ContextMenuCallback on_context_menu_;
+  std::string space_id_;
+  std::string icon_;
+  bool current_ = false;
+  raw_ptr<views::Label> emoji_ = nullptr;
+};
+
+BEGIN_METADATA(WorkspaceSpaceBarView, SpaceButton)
+END_METADATA
+
+WorkspaceSpaceBarView::WorkspaceSpaceBarView(
+    BrowserWindowInterface* browser,
+    base::RepeatingClosure on_menu_pressed,
+    base::RepeatingClosure on_current_space_changed,
+    base::RepeatingCallback<void(int)> on_current_space_will_change)
+    : browser_(browser),
+      on_menu_pressed_(std::move(on_menu_pressed)),
+      on_current_space_changed_(std::move(on_current_space_changed)),
+      on_current_space_will_change_(std::move(on_current_space_will_change)) {
+  auto menu_button = views::CreateVectorImageButtonWithNativeTheme(
+      base::BindRepeating(
+          [](WorkspaceSpaceBarView* bar) { bar->on_menu_pressed_.Run(); },
+          base::Unretained(this)),
+      vector_icons::kKeyboardArrowDownIcon, kMenuGlyphSize);
+  menu_button->SetTooltipText(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WS_SIDEBAR_MENU_BUTTON));
+  menu_button->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WS_SIDEBAR_MENU_BUTTON));
+  menu_button_ = AddChildView(std::move(menu_button));
+}
+
+WorkspaceSpaceBarView::~WorkspaceSpaceBarView() = default;
+
+views::View* WorkspaceSpaceBarView::menu_button() const {
+  return menu_button_;
+}
+
+void WorkspaceSpaceBarView::SetDownloadIndicator(bool shown) {
+  if (download_indicator_ == shown) {
+    return;
+  }
+  download_indicator_ = shown;
+  SchedulePaint();
+}
+
+gfx::Size WorkspaceSpaceBarView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  // Width comes from the sidebar; the region's flex spec is
+  // preferred/preferred, so the height is taken from the bottom container's
+  // slack and nothing above moves (same contract as the undo bar).
+  return gfx::Size(0, kIconSlot);
+}
+
+void WorkspaceSpaceBarView::Layout(PassKey) {
+  // The icons sit at a 32pt pitch (Arc's squares touch edge to edge) as a
+  // group centred on the bar (Arc 2026-09-03: four icons at x 102/134/166/
+  // 200 in a 300pt sidebar, group centre 151 -- the Library button and the
+  // "+" sit at the two ends, the spaces between them are centred); the "⌄"
+  // right-aligned in its own 32pt slot. A group too wide to centre without
+  // running into the "⌄" packs left instead, and a sidebar too narrow for
+  // all of them (the 42pt collapsed width) shows what fits -- the current
+  // space first, see Rebuild.
+  const int menu_x = std::max(0, width() - kIconSlot);
+  menu_button_->SetBounds(menu_x, 0, kIconSlot, kIconSlot);
+  const int group_width = static_cast<int>(buttons_.size()) * kIconSlot;
+  int x = std::max(0, std::min((width() - group_width) / 2,
+                               menu_x - group_width));
+  for (SpaceButton* button : buttons_) {
+    const bool fits = x + kIconSlot <= menu_x;
+    button->SetVisible(fits);
+    if (fits) {
+      button->SetBounds(x, 0, kIconSlot, kIconSlot);
+    }
+    x += kIconSlot;
+  }
+}
+
+void WorkspaceSpaceBarView::AddedToWidget() {
+  views::View::AddedToWidget();
+  service_ = helium_workspace::WorkspaceServiceFactory::GetForProfile(
+      browser_->GetProfile());
+  controller_ = helium_workspace::WorkspaceTabController::From(browser_);
+  if (service_) {
+    service_observation_.Observe(service_);
+  }
+  if (controller_) {
+    controller_observation_.Observe(controller_);
+  }
+  Rebuild();
+}
+
+void WorkspaceSpaceBarView::RemovedFromWidget() {
+  controller_observation_.Reset();
+  service_observation_.Reset();
+  controller_ = nullptr;
+  service_ = nullptr;
+  views::View::RemovedFromWidget();
+}
+
+void WorkspaceSpaceBarView::OnWorkspaceSpacesChanged() {
+  Rebuild();
+}
+
+void WorkspaceSpaceBarView::OnCurrentSpaceChanged() {
+  UpdateCurrent();
+  on_current_space_changed_.Run();
+}
+
+void WorkspaceSpaceBarView::OnCurrentSpaceWillChange(int direction) {
+  on_current_space_will_change_.Run(direction);
+}
+
+void WorkspaceSpaceBarView::Rebuild() {
+  for (SpaceButton* button : buttons_) {
+    RemoveChildViewT(button);
+  }
+  buttons_.clear();
+  if (!service_) {
+    return;
+  }
+  const std::vector<helium_workspace::WorkspaceSpace>& spaces =
+      service_->spaces();
+  for (size_t i = 0; i < spaces.size(); ++i) {
+    auto* button = AddChildView(std::make_unique<SpaceButton>(
+        base::BindRepeating(&WorkspaceSpaceBarView::OnSpacePressed,
+                            base::Unretained(this), spaces[i].id),
+        base::BindRepeating(&WorkspaceSpaceBarView::ShowSpaceMenu,
+                            base::Unretained(this))));
+    button->SetSpace(spaces[i], i);
+    buttons_.push_back(button);
+  }
+  UpdateCurrent();
+  InvalidateLayout();
+}
+
+void WorkspaceSpaceBarView::UpdateCurrent() {
+  const std::string current =
+      controller_ ? controller_->current_space_id() : std::string();
+  for (SpaceButton* button : buttons_) {
+    button->SetCurrent(button->space_id() == current);
+  }
+}
+
+void WorkspaceSpaceBarView::OnSpacePressed(const std::string& space_id) {
+  if (controller_) {
+    controller_->SwitchToSpace(space_id);
+  }
+}
+
+void WorkspaceSpaceBarView::ShowSpaceMenu(const std::string& space_id,
+                                          const gfx::Point& point,
+                                          ui::mojom::MenuSourceType source_type) {
+  space_menu_model_ = std::make_unique<SpaceMenuModel>(
+      base::BindRepeating(&WorkspaceSpaceBarView::RunSpaceMenuCommand,
+                          base::Unretained(this), space_id));
+  space_menu_runner_ = std::make_unique<views::MenuRunner>(
+      space_menu_model_.get(),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+  space_menu_runner_->RunMenuAt(GetWidget(), nullptr,
+                                gfx::Rect(point, gfx::Size()),
+                                views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void WorkspaceSpaceBarView::RunSpaceMenuCommand(const std::string& space_id,
+                                                int command_id) {
+  if (!controller_) {
+    return;
+  }
+  switch (command_id) {
+    case kRenameSpace:
+    case kNewFolder: {
+      // Both act on the current space's head row / list: switch first (a
+      // no-op when it already is), like NewSpaceFromMenu.
+      controller_->SwitchToSpace(space_id);
+      if (command_id == kNewFolder) {
+        controller_->NewFolderFromMenu();
+        break;
+      }
+      if (BrowserView* const browser_view =
+              BrowserView::GetBrowserViewForBrowser(browser_)) {
+        if (VerticalTabStripRegionView* const region =
+                browser_view->vertical_tab_strip_region_view()) {
+          if (WorkspaceSidebarView* const sidebar =
+                  region->WorkspaceDragSidebar()) {
+            sidebar->StartSpaceRename(space_id);
+          }
+        }
+      }
+      break;
+    }
+    case kDeleteSpace:
+      controller_->RequestDeleteSpace(space_id);
+      break;
+  }
+}
+
+void WorkspaceSpaceBarView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  if (!download_indicator_ || !menu_button_) {
+    return;
+  }
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  cc::PaintFlags dot;
+  dot.setStyle(cc::PaintFlags::kFill_Style);
+  dot.setAntiAlias(true);
+  dot.setColor(colors->GetColor(ui::kColorAccent));
+  const gfx::Rect slot = menu_button_->bounds();
+  canvas->DrawCircle(
+      gfx::PointF(slot.right() - kDownloadDotSize, slot.y() + kDownloadDotSize),
+      kDownloadDotSize / 2.0f, dot);
+}
+
+BEGIN_METADATA(WorkspaceSpaceBarView)
+END_METADATA
