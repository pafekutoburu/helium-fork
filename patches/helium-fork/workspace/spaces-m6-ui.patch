+void WorkspaceFoldChevronView::SetProgress(double progress) {
+  if (progress_ == progress) {
+    return;
+  }
+  progress_ = progress;
+  SchedulePaint();
+}
+
+void WorkspaceFoldChevronView::OnPaint(gfx::Canvas* canvas) {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  const gfx::ImageSkia icon =
+      ui::ImageModel::FromVectorIcon(vector_icons::kKeyboardArrowRightFlippableIcon,
+                                     ui::kColorLabelForegroundSecondary, kSize)
+          .Rasterize(colors);
+  gfx::ScopedCanvas scoped(canvas);
+  canvas->Translate(gfx::Vector2d(width() / 2, height() / 2));
+  canvas->sk_canvas()->rotate(90.0f * (1.0f - progress_));
+  canvas->DrawImageInt(icon, -icon.width() / 2, -icon.height() / 2);
+}
+
