+// ---- HeliumViewSnapshotLayer (M6-r3) ----
+
+namespace {
+
+// View::Paint stops at descendants that paint to their own layer (the
+// compositor draws those); a snapshot wants them too. Walk the subtree and
+// paint each layered node as a root at its offset -- its own layered
+// descendants come from the recursion. (The New Tab button's label is one:
+// TabStripControlButton::SetText gives it a layer.)
+void PaintLayeredDescendants(views::View* view,
+                             const ui::PaintContext& context,
+                             const gfx::Vector2d& offset) {
+  for (views::View* child : view->children()) {
+    if (!child->GetVisible()) {
+      continue;
+    }
+    const gfx::Vector2d child_offset =
+        offset + child->bounds().OffsetFromOrigin();
+    if (child->layer()) {
+      const ui::PaintContext child_context(context, child_offset);
+      child->Paint(
+          views::PaintInfo::CreateRootPaintInfo(child_context, child->size()));
+    }
+    PaintLayeredDescendants(child, context, child_offset);
+  }
+}
+
+}  // namespace
+
+// static
+std::unique_ptr<HeliumViewSnapshotLayer> HeliumViewSnapshotLayer::Capture(
+    views::View* view,
+    const gfx::Rect& visible_rect,
+    float scale) {
+  if (!view || visible_rect.IsEmpty() || scale <= 0.0f) {
+    return nullptr;
+  }
+  SkBitmap bitmap;
+  {
+    // The painter rasters its recording into |bitmap| when it goes out of
+    // scope (button_drag_utils.cc does the same). Painting the view shifted
+    // by -origin is what clips it to |visible_rect|.
+    ui::CanvasPainter painter(&bitmap, visible_rect.size(), scale,
+                              SK_ColorTRANSPARENT, /*is_pixel_canvas=*/true);
+    const ui::PaintContext context(painter.context(),
+                                   -visible_rect.OffsetFromOrigin());
+    view->Paint(views::PaintInfo::CreateRootPaintInfo(context, view->size()));
+    PaintLayeredDescendants(view, context, gfx::Vector2d());
+  }
+  return base::WrapUnique(new HeliumViewSnapshotLayer(
+      gfx::ImageSkia::CreateFromBitmap(bitmap, scale), visible_rect.size()));
+}
+
+HeliumViewSnapshotLayer::HeliumViewSnapshotLayer(gfx::ImageSkia image,
+                                                 const gfx::Size& size)
+    : image_(std::move(image)),
+      layer_(std::make_unique<ui::LayerTextured>()) {
+  layer_->SetFillsBoundsOpaquely(false);
+  layer_->set_delegate(this);
+  layer_->SetBounds(gfx::Rect(size));
+}
+
+HeliumViewSnapshotLayer::~HeliumViewSnapshotLayer() {
+  layer_->set_delegate(nullptr);
+}
+
+void HeliumViewSnapshotLayer::OnPaintLayer(const ui::PaintContext& context) {
+  ui::PaintRecorder recorder(context, layer_->size());
+  recorder.canvas()->DrawImageInt(image_, 0, 0);
+}
