+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/helium_sidebar_submenu_view.h"
+
+#include <algorithm>
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/helium/arc_sidebar_menu.h"
+#include "chrome/browser/ui/helium/arc_sidebar_surface.h"
+#include "chrome/browser/ui/layout_constants.h"
+#include "chrome/grit/generated_resources.h"
+#include "ui/accessibility/ax_enums.mojom.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_provider.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/image_view.h"
+#include "ui/views/controls/label.h"
+
+namespace {
+
+// The hover capsule inside a row keeps the same 8pt edge system as the
+// sidebar's own rows.
+constexpr int kRowCapsuleInset = 8;
+// A favicon is drawn at 16 and a vector glyph at 14; both centred on the
+// panel's icon column (x17 + 7 = x24).
+constexpr int kFaviconSize = 16;
+constexpr int kChevronSize = 16;
+
+}  // namespace
+
+// ---- HeliumSidebarMenuRowView ----
+
+HeliumSidebarMenuRowView::HeliumSidebarMenuRowView(PressedCallback callback,
+                                                   ui::ImageModel icon,
+                                                   const std::u16string& text,
+                                                   bool has_submenu)
+    : views::Button(std::move(callback)) {
+  icon_ = AddChildView(std::make_unique<views::ImageView>());
+  icon_->SetCanProcessEventsWithinSubtree(false);
+  icon_->SetImage(icon);
+  icon_->SetImageSize(gfx::Size(kFaviconSize, kFaviconSize));
+  label_ = AddChildView(std::make_unique<views::Label>(text));
+  label_->SetCanProcessEventsWithinSubtree(false);
+  label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label_->SetElideBehavior(gfx::ELIDE_TAIL);
+  label_->SetAutoColorReadabilityEnabled(false);
+  // ⛔ The panel owns a layer that spends the fade at partial opacity;
+  // subpixel text there is a DCHECK (helium_undo_bar_view.cc).
+  label_->SetSubpixelRenderingEnabled(false);
+  if (has_submenu) {
+    chevron_ = AddChildView(std::make_unique<views::ImageView>());
+    chevron_->SetCanProcessEventsWithinSubtree(false);
+    chevron_->SetImage(ui::ImageModel::FromVectorIcon(
+        kKeyboardArrowRightIcon, ui::kColorLabelForegroundSecondary,
+        kChevronSize));
+  }
+  GetViewAccessibility().SetRole(ax::mojom::Role::kMenuItem);
+  GetViewAccessibility().SetName(text);
+  SetTooltipText(std::u16string());
+}
+
+HeliumSidebarMenuRowView::~HeliumSidebarMenuRowView() = default;
+
+void HeliumSidebarMenuRowView::SetHoverCallback(
+    base::RepeatingClosure callback) {
+  hover_callback_ = std::move(callback);
+}
+
+void HeliumSidebarMenuRowView::SetIcon(ui::ImageModel icon) {
+  icon_->SetImage(icon);
+}
+
+void HeliumSidebarMenuRowView::SetRowEnabled(bool enabled) {
+  row_enabled_ = enabled;
+  SetEnabled(enabled);
+  UpdateLabelColor();
+}
+
+void HeliumSidebarMenuRowView::Layout(PassKey) {
+  icon_->SetBounds(helium::kSidebarMenuIconX + helium::kSidebarMenuIconSize / 2 -
+                       kFaviconSize / 2,
+                   (height() - kFaviconSize) / 2, kFaviconSize, kFaviconSize);
+  int right = width() - kRowCapsuleInset;
+  if (chevron_) {
+    chevron_->SetBounds(right - kChevronSize, (height() - kChevronSize) / 2,
+                        kChevronSize, kChevronSize);
+    right = chevron_->x() - 4;
+  }
+  const int label_height = label_->GetPreferredSize().height();
+  label_->SetBounds(helium::kSidebarMenuTextX, (height() - label_height) / 2,
+                    std::max(0, right - helium::kSidebarMenuTextX),
+                    label_height);
+}
+
+void HeliumSidebarMenuRowView::OnPaintBackground(gfx::Canvas* canvas) {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors || !row_enabled_ || GetState() != STATE_HOVERED) {
+    return;
+  }
+  // Instant, like every sidebar hover (Dia has no tween).
+  cc::PaintFlags fill;
+  fill.setStyle(cc::PaintFlags::kFill_Style);
+  fill.setAntiAlias(true);
+  fill.setColor(
+      helium::GetSidebarHoverSurfaceColor(colors->GetColor(kColorToolbar)));
+  gfx::Rect capsule = GetLocalBounds();
+  capsule.Inset(gfx::Insets::VH(0, kRowCapsuleInset));
+  canvas->DrawRoundRect(
+      gfx::RectF(capsule),
+      GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius), fill);
+}
+
+void HeliumSidebarMenuRowView::OnThemeChanged() {
+  views::Button::OnThemeChanged();
+  UpdateLabelColor();
+}
+
+void HeliumSidebarMenuRowView::UpdateLabelColor() {
+  if (const ui::ColorProvider* colors = GetColorProvider()) {
+    label_->SetEnabledColor(colors->GetColor(
+        row_enabled_ ? kColorTabForegroundActiveFrameActive
+                     : ui::kColorLabelForegroundDisabled));
+  }
+}
+
+void HeliumSidebarMenuRowView::StateChanged(ButtonState old_state) {
+  views::Button::StateChanged(old_state);
+  SchedulePaint();
+  if (GetState() == STATE_HOVERED && old_state != STATE_HOVERED &&
+      hover_callback_) {
+    hover_callback_.Run();
+  }
+}
+
+BEGIN_METADATA(HeliumSidebarMenuRowView)
+END_METADATA
+
+// ---- HeliumSidebarSubmenuView ----
+
+HeliumSidebarSubmenuView::HeliumSidebarSubmenuView(
+    Delegate* delegate,
+    HeliumSidebarMenuData* data,
+    std::vector<HeliumSidebarMenuItem> items,
+    int depth)
+    : delegate_(delegate), data_(data), items_(std::move(items)), depth_(depth) {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  if (items_.empty()) {
+    // Dia: an empty folder shows "Empty", greyed.
+    auto* row = AddChildView(std::make_unique<HeliumSidebarMenuRowView>(
+        views::Button::PressedCallback(), ui::ImageModel(),
+        l10n_util::GetStringUTF16(IDS_HELIUM_WS_MENU_EMPTY),
+        /*has_submenu=*/false));
+    row->SetRowEnabled(false);
+    rows_.push_back(row);
+    return;
+  }
+  for (size_t i = 0; i < items_.size(); ++i) {
+    const HeliumSidebarMenuItem& item = items_[i];
+    auto* row = AddChildView(std::make_unique<HeliumSidebarMenuRowView>(
+        base::BindRepeating(&HeliumSidebarSubmenuView::OnRowPressed,
+                            base::Unretained(this), i),
+        item.icon, item.title, !item.children.is_null()));
+    row->SetHoverCallback(base::BindRepeating(
+        &HeliumSidebarSubmenuView::OnRowHovered, base::Unretained(this), i));
+    if (!item.enabled) {
+      row->SetRowEnabled(false);
+    }
+    rows_.push_back(row);
+    if (item.favicon_page_url.is_valid()) {
+      data_->LoadFavicon(item.favicon_page_url,
+                         base::BindOnce(&HeliumSidebarSubmenuView::OnIconLoaded,
+                                        weak_factory_.GetWeakPtr(), i));
+    } else if (!item.file_icon_path.empty()) {
+      data_->LoadFileIcon(item.file_icon_path,
+                          base::BindOnce(&HeliumSidebarSubmenuView::OnIconLoaded,
+                                         weak_factory_.GetWeakPtr(), i));
+    }
+  }
+}
+
+HeliumSidebarSubmenuView::~HeliumSidebarSubmenuView() = default;
+
+int HeliumSidebarSubmenuView::ExpandedHeight() const {
+  int separators = 0;
+  for (const HeliumSidebarMenuItem& item : items_) {
+    if (item.separator_before) {
+      ++separators;
+    }
+  }
+  return 2 * helium::kSidebarMenuVerticalInset +
+         static_cast<int>(rows_.size()) * helium::kSidebarMenuRowHeight +
+         separators * (helium::kSidebarMenuSeparatorHeight +
+                       2 * helium::kSidebarMenuVerticalInset);
+}
+
+void HeliumSidebarSubmenuView::Layout(PassKey) {
+  separator_ys_.clear();
+  int y = helium::kSidebarMenuVerticalInset;
+  for (size_t i = 0; i < rows_.size(); ++i) {
+    if (i < items_.size() && items_[i].separator_before) {
+      y += helium::kSidebarMenuVerticalInset;
+      separator_ys_.push_back(y);
+      y += helium::kSidebarMenuSeparatorHeight + helium::kSidebarMenuVerticalInset;
+    }
+    rows_[i]->SetBounds(0, y, width(), helium::kSidebarMenuRowHeight);
+    y += helium::kSidebarMenuRowHeight;
+  }
+}
+
+void HeliumSidebarSubmenuView::OnPaint(gfx::Canvas* canvas) {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  // The panel's card: fill, Dia's hairline, the separators.
+  const SkColor sidebar = colors->GetColor(kColorToolbar);
+  const gfx::RectF panel(GetLocalBounds());
+  cc::PaintFlags fill;
+  fill.setStyle(cc::PaintFlags::kFill_Style);
+  fill.setAntiAlias(true);
+  fill.setColor(helium::GetSidebarFloatingCardColor(sidebar));
+  canvas->DrawRoundRect(panel, helium::kSidebarMenuRadius, fill);
+  cc::PaintFlags line;
+  line.setStyle(cc::PaintFlags::kStroke_Style);
+  line.setStrokeWidth(1.0f);
+  line.setAntiAlias(true);
+  line.setColor(SkColorSetA(
+      SK_ColorBLACK, static_cast<U8CPU>(helium::kSidebarMenuBorderAlpha * 255)));
+  gfx::RectF inset = panel;
+  inset.Inset(0.5f);
+  canvas->DrawRoundRect(inset, helium::kSidebarMenuRadius - 0.5f, line);
+  cc::PaintFlags separator;
+  separator.setStyle(cc::PaintFlags::kFill_Style);
+  separator.setColor(SkColorSetA(
+      SK_ColorBLACK,
+      static_cast<U8CPU>(helium::kSidebarMenuSeparatorAlpha * 255)));
+  for (int y : separator_ys_) {
+    canvas->DrawRect(gfx::RectF(kRowCapsuleInset, y,
+                                std::max(0, width() - 2 * kRowCapsuleInset),
+                                helium::kSidebarMenuSeparatorHeight),
+                     separator);
+  }
+  views::View::OnPaint(canvas);
+}
+
+void HeliumSidebarSubmenuView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  SchedulePaint();  // a layer's raster does not follow the theme by itself
+}
+
+void HeliumSidebarSubmenuView::OnRowHovered(size_t index) {
+  delegate_->OnSubmenuRowHovered(this, index);
+}
+
+void HeliumSidebarSubmenuView::OnRowPressed(size_t index) {
+  if (index >= items_.size()) {
+    return;
+  }
+  const HeliumSidebarMenuItem& item = items_[index];
+  if (!item.children.is_null()) {
+    // A folder opens on hover; a click on it is not a leaf activation.
+    delegate_->OnSubmenuRowHovered(this, index);
+    return;
+  }
+  // The delegate closes the panel first (and with it this view), so the
+  // activation runs on a copy.
+  base::RepeatingClosure activate = item.activate;
+  delegate_->OnSubmenuRowActivated();
+  if (activate) {
+    activate.Run();
+  }
+}
+
+void HeliumSidebarSubmenuView::OnIconLoaded(size_t index, ui::ImageModel icon) {
+  if (index < rows_.size()) {
+    rows_[index]->SetIcon(icon);
+  }
+}
+
+BEGIN_METADATA(HeliumSidebarSubmenuView)
+END_METADATA
