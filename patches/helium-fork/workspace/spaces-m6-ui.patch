+
+  // In the icon slot, shown only under the pointer (Arc 2026-09-03).
+  chevron_ = AddChildView(std::make_unique<WorkspaceFoldChevronView>());
+  chevron_->SetVisible(false);
+
+  auto editor = std::make_unique<SpaceRenameField>(this);
+  editor->set_controller(this);
+  editor->SetVisible(false);
+  editor->SetBorder(nullptr);
+  editor->SetBackgroundEnabled(false);
+  // ⛔ A focusable view with no accessible name aborts under DCHECKs the
+  // moment it becomes visible (RunAccessibilityPaintChecks).
+  editor->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_MENU_RENAME));
+  editor_ = AddChildView(std::move(editor));
+
+  // The "···" leaf: the only child that may own a menu.
+  auto menu_button = views::CreateVectorImageButtonWithNativeTheme(
+      base::BindRepeating(&WorkspaceSpaceHeadRowView::ShowMenu,
+                          base::Unretained(this)),
+      kMoreVertIcon, kHeadRowMenuButtonSize);
+  menu_button->SetTooltipText(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_MENU_BUTTON));
+  menu_button->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_MENU_BUTTON));
+  menu_button->SetVisible(false);
+  menu_button_ = AddChildView(std::move(menu_button));
+
+  // The row is a leaf (like a folder row): its right-click is the space
+  // menu, and it takes nothing away from the sidebar's blank (M4-r2).
+  set_context_menu_controller(this);
+
+  GetViewAccessibility().SetRole(ax::mojom::Role::kButton);
+  GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WS_NEW_SPACE_DEFAULT_NAME));
+}
+
+WorkspaceSpaceHeadRowView::~WorkspaceSpaceHeadRowView() = default;
+
+void WorkspaceSpaceHeadRowView::SetSpace(
+    const helium_workspace::WorkspaceSpace& space) {
+  const bool space_changed = space_id_ != space.id;
+  space_id_ = space.id;
+  const bool collapsed_changed = collapsed_ != space.collapsed;
+  collapsed_ = space.collapsed;
+  if (collapsed_changed || space_changed) {
+    // Snap when the state arrives from the model without a running tween
+    // (load, a switch, another window); the sidebar overrides this per
+    // frame while its fold animation drives.
+    SetCollapsedProgress(collapsed_ ? 1.0 : 0.0);
+  }
+  if (icon_ != space.icon || space_changed) {
+    icon_ = space.icon;
+    icon_label_->SetText(base::UTF8ToUTF16(icon_));
+    UpdateIconSlot();
+    SchedulePaint();  // the dot
+  }
+  if (name_ != space.name || space_changed) {
+    name_ = space.name;
+    if (!editing_) {
+      title_->SetText(name_);
+    }
+    // A nameless space still needs a non-empty accessible name.
+    GetViewAccessibility().SetName(
+        name_.empty()
+            ? l10n_util::GetStringUTF16(IDS_HELIUM_WS_NEW_SPACE_DEFAULT_NAME)
+            : name_);
+    DeprecatedLayoutImmediately();
+  }
+}
+
+void WorkspaceSpaceHeadRowView::SetCollapsedProgress(double collapsed) {
+  chevron_->SetProgress(collapsed);
+}
+
+void WorkspaceSpaceHeadRowView::StartRename() {
+  if (editing_) {
+    return;
+  }
+  editing_ = true;
+  editor_->SetText(name_);
+  editor_->SetVisible(true);
+  title_->SetVisible(false);
+  UpdateIconSlot();
+  DeprecatedLayoutImmediately();
+  editor_->RequestFocus();
+  editor_->SelectAll(/*reversed=*/false);
+}
+
+int WorkspaceSpaceHeadRowView::RowHeight() const {
+  return GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+}
+
+gfx::Size WorkspaceSpaceHeadRowView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  const int width =
+      available_size.width().is_bounded()
+          ? available_size.width().value()
+          : GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth);
+  return gfx::Size(width, RowHeight());
+}
+
+void WorkspaceSpaceHeadRowView::Layout(PassKey) {
+  // The emoji / dot and the chevron share the icon slot; UpdateIconSlot
+  // decides which one is visible.
+  const gfx::Rect icon_slot(kHeadRowIconLeadingInset,
+                            (height() - kHeadRowIconSize) / 2, kHeadRowIconSize,
+                            kHeadRowIconSize);
+  icon_label_->SetBoundsRect(icon_slot);
+  chevron_->SetBounds(
+      icon_slot.x() + (kHeadRowIconSize - WorkspaceFoldChevronView::kSize) / 2,
+      (height() - WorkspaceFoldChevronView::kSize) / 2,
+      WorkspaceFoldChevronView::kSize, WorkspaceFoldChevronView::kSize);
+  // The name takes only what it needs; what it may take stops short of the
+  // "···" and the trailing inset.
+  const gfx::Size title_size = title_->GetPreferredSize();
+  const int title_max =
+      std::max(0, width() - kHeadRowTitleX - kHeadRowInnerSpacing -
+                      kHeadRowMenuButtonSize - kHeadRowTrailingInset);
+  const int title_width = std::min(title_size.width(), title_max);
+  title_->SetBounds(kHeadRowTitleX, (height() - title_size.height()) / 2,
+                    title_width, title_size.height());
+  menu_button_->SetBounds(
+      width() - kHeadRowTrailingInset - kHeadRowMenuButtonSize,
+      (height() - kHeadRowMenuButtonSize) / 2, kHeadRowMenuButtonSize,
+      kHeadRowMenuButtonSize);
+  const int editor_height = editor_->GetPreferredSize().height();
+  editor_->SetBounds(kHeadRowTitleX, (height() - editor_height) / 2, title_max,
+                     editor_height);
+}
+
+void WorkspaceSpaceHeadRowView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  if (hovered_ || editing_) {
+    // The row capsule, same fill and radius as a hovered pinned row; instant
+    // like every other sidebar hover (Dia has no tween).
+    cc::PaintFlags fill;
+    fill.setStyle(cc::PaintFlags::kFill_Style);
+    fill.setAntiAlias(true);
+    fill.setColor(
+        helium::GetSidebarHoverSurfaceColor(colors->GetColor(kColorToolbar)));
+    canvas->DrawRoundRect(
+        gfx::RectF(GetLocalBounds()),
+        GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius), fill);
+  }
+  if (icon_.empty() && !chevron_->GetVisible()) {
+    // No emoji: the grey dot, centred in the icon slot (the chevron takes
+    // the slot under the pointer).
+    cc::PaintFlags dot;
+    dot.setStyle(cc::PaintFlags::kFill_Style);
+    dot.setAntiAlias(true);
+    dot.setColor(colors->GetColor(ui::kColorLabelForegroundSecondary));
+    const gfx::Rect slot = icon_label_->bounds();
+    canvas->DrawCircle(gfx::PointF(slot.CenterPoint()), kHeadRowDotSize / 2.0f,
+                       dot);
+  }
+}
+
+void WorkspaceSpaceHeadRowView::OnMouseEntered(const ui::MouseEvent& event) {
+  hovered_ = true;
+  UpdateMenuButtonVisibility();
+  UpdateIconSlot();
+  SchedulePaint();
+}
+
+void WorkspaceSpaceHeadRowView::OnMouseExited(const ui::MouseEvent& event) {
+  // Moving onto the "···" child is an exit for this view but not for the
+  // pointer; keep the capsule while the cursor is anywhere on the row.
+  hovered_ = IsMouseHovered();
+  UpdateMenuButtonVisibility();
+  UpdateIconSlot();
+  SchedulePaint();
+}
+
+bool WorkspaceSpaceHeadRowView::OnMousePressed(const ui::MouseEvent& event) {
+  return event.IsOnlyLeftMouseButton();
+}
+
+void WorkspaceSpaceHeadRowView::OnMouseReleased(const ui::MouseEvent& event) {
+  if (editing_) {
+    return;  // a click inside the row while editing is the field's business
+  }
+  if (!event.IsOnlyLeftMouseButton() || !HitTestPoint(event.location())) {
+    return;
+  }
+  // Arc: the name renames in place, everything else folds (g4c f_00730 /
+  // g4 "⌄ 123").
+  if (title_->GetVisible() && title_->bounds().Contains(event.location())) {
+    StartRename();
+    return;
+  }
+  delegate_->OnSpaceToggled(space_id_);
+}
+
+void WorkspaceSpaceHeadRowView::ShowMenu() {
+  RunMenu(menu_button_->GetBoundsInScreen(), views::MenuRunner::HAS_MNEMONICS,
+          ui::mojom::MenuSourceType::kMouse);
+}
+
+void WorkspaceSpaceHeadRowView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  RunMenu(gfx::Rect(point, gfx::Size()),
+          views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU,
+          source_type);
+}
+
+void WorkspaceSpaceHeadRowView::RunMenu(const gfx::Rect& anchor,
+                                        int run_types,
+                                        ui::mojom::MenuSourceType source_type) {
+  // Arc 轮0 g3's order, with the items we have: Rename Space… | New Folder |
+  // Delete Space (Change Space Icon… / Manage Spaces… are round 2).
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_model_->AddItemWithStringId(kRenameSpace, IDS_HELIUM_WS_SPACE_MENU_RENAME);
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItemWithStringId(kNewFolder, IDS_HELIUM_WS_NEW_FOLDER);
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItemWithStringId(kDeleteSpace, IDS_HELIUM_WS_SPACE_MENU_DELETE);
+  menu_runner_ =
+      std::make_unique<views::MenuRunner>(menu_model_.get(), run_types);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, anchor,
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void WorkspaceSpaceHeadRowView::ExecuteCommand(int command_id,
+                                               int event_flags) {
+  switch (command_id) {
+    case kRenameSpace:
+      StartRename();
+      break;
+    case kNewFolder:
+      delegate_->OnSpaceNewFolderRequested(space_id_);
+      break;
+    case kDeleteSpace:
+      delegate_->OnSpaceDeleteRequested(space_id_);
+      break;
+  }
+}
+
+bool WorkspaceSpaceHeadRowView::HandleKeyEvent(views::Textfield* sender,
+                                               const ui::KeyEvent& key_event) {
+  if (key_event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  if (key_event.key_code() == ui::VKEY_RETURN) {
+    CommitRename();
+    GetFocusManager()->ClearFocus();
+    return true;
+  }
+  if (key_event.key_code() == ui::VKEY_ESCAPE) {
+    CancelRename();
+    GetFocusManager()->ClearFocus();
+    return true;
+  }
+  return false;
+}
+
+void WorkspaceSpaceHeadRowView::OnRenameFieldBlurred() {
+  if (editing_) {
+    CommitRename();
+  }
+}
+
+void WorkspaceSpaceHeadRowView::CommitRename() {
+  if (!editing_) {
+    return;
+  }
+  std::u16string text(editor_->GetText());
+  EndRename();
+  // An emptied name keeps the old one.
+  if (!text.empty() && text != name_) {
+    delegate_->OnSpaceRenamed(space_id_, text);
+  }
+}
+
+void WorkspaceSpaceHeadRowView::CancelRename() {
+  if (!editing_) {
+    return;
+  }
+  EndRename();
+}
+
+void WorkspaceSpaceHeadRowView::EndRename() {
+  editing_ = false;
+  editor_->SetVisible(false);
+  title_->SetText(name_);
+  title_->SetVisible(true);
+  if (!IsMouseHovered()) {
+    hovered_ = false;
+  }
+  UpdateMenuButtonVisibility();
+  UpdateIconSlot();
+  DeprecatedLayoutImmediately();
+  SchedulePaint();
+}
+
+void WorkspaceSpaceHeadRowView::ClearHover() {
+  if (hovered_) {
+    hovered_ = false;
+    UpdateMenuButtonVisibility();
+    UpdateIconSlot();
+    SchedulePaint();
+  }
+}
+
+void WorkspaceSpaceHeadRowView::UpdateMenuButtonVisibility() {
+  // Arc g2c f_01860 / g4c f_00469: the "···" exists only under the pointer.
+  menu_button_->SetVisible(hovered_ && !editing_);
+}
+
+void WorkspaceSpaceHeadRowView::UpdateIconSlot() {
+  // Arc 2026-09-03: hovered, the emoji's slot shows the fold chevron.
+  const bool chevron = hovered_ || editing_;
+  chevron_->SetVisible(chevron);
+  icon_label_->SetVisible(!chevron && !icon_.empty());
+  SchedulePaint();  // the dot follows the same rule in OnPaint
+}
+
+BEGIN_METADATA(WorkspaceSpaceHeadRowView)
+END_METADATA
