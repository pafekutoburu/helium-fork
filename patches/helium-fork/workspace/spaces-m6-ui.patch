+namespace views {
+class ImageButton;
+class Label;
+class MenuRunner;
+class Textfield;
+}  // namespace views
+
+class WorkspaceFoldChevronView;
+
+// The current space's head row at the top of the sidebar's pinned list
+// (M6; Arc 轮0 g2c/g4c, re-measured 2026-09-03): emoji + name, and on hover
+// the emoji's slot turns into the fold chevron, "···" appears at the right
+// end and the row wears the hover capsule. The retired WorkspaceSpaceHeader
+// (M3.10's single pseudo-folder) come back with the folder row's newer
+// parts grafted on:
+//
+//  - the chevron folds the WHOLE pinned list of the space, not one folder
+//    (Arc g4 "⌄ 123"); the sidebar drives it with the same 150ms tween. It
+//    lives IN the icon slot and only under the pointer (M6-r1: Arc
+//    `Arc_hover_emoji_row.png` vs `Arc_active_row.png` -- at rest the slot
+//    shows the emoji, hovered it shows "⌄" in the same place);
+//  - the icon slot otherwise holds the space's emoji, or an 8pt grey dot
+//    for a space with none (Arc g1 f_00300, the bottom bar's rule applied
+//    to the row);
+//  - clicking the name renames in place (Arc: 点名进原位改名); the field is
+//    the folder row's -- name selected, Enter commits, Escape reverts, blur
+//    commits, all through the framework's own focus system;
+//  - "···" is a leaf ImageButton with the space menu, and the same menu is
+//    the row's own right-click (M6-r1, user 2026-09-03; Arc 轮0 g3: the head
+//    row's right-click is the space menu). The row is a leaf like a folder
+//    row -- it owns its own ContextMenuController and takes nothing from
+//    the sidebar's blank, which stays the window menu's (M4-r2). Rename
+//    Space… / New Folder / Delete Space; Change Space Icon… and Manage
+//    Spaces… are round 2.
+class WorkspaceSpaceHeadRowView : public views::View,
+                                  public views::ContextMenuController,
+                                  public ui::SimpleMenuModel::Delegate,
+                                  public views::TextfieldController {
+  METADATA_HEADER(WorkspaceSpaceHeadRowView, views::View)
+
+ public:
+  class Delegate {
+   public:
+    virtual void OnSpaceToggled(const std::string& space_id) = 0;
+    virtual void OnSpaceRenamed(const std::string& space_id,
+                                const std::u16string& name) = 0;
+    virtual void OnSpaceNewFolderRequested(const std::string& space_id) = 0;
+    // The menu's Delete Space: the delegate confirms and deletes.
+    virtual void OnSpaceDeleteRequested(const std::string& space_id) = 0;
+
+   protected:
+    virtual ~Delegate() = default;
+  };
+
+  explicit WorkspaceSpaceHeadRowView(Delegate* delegate);
+  WorkspaceSpaceHeadRowView(const WorkspaceSpaceHeadRowView&) = delete;
+  WorkspaceSpaceHeadRowView& operator=(const WorkspaceSpaceHeadRowView&) =
+      delete;
+  ~WorkspaceSpaceHeadRowView() override;
+
+  // Pushes the space's persistent state. Cheap when nothing changed.
+  void SetSpace(const helium_workspace::WorkspaceSpace& space);
+
+  // 0 open, 1 closed -- the fold tween's own value (see the folder row).
+  void SetCollapsedProgress(double collapsed);
+
+  // Swaps the name for a field with the whole name selected. No-op while
+  // already editing.
+  void StartRename();
+
+  // M3.11-r1 family: clears, never sets.
+  void ClearHover();
+  bool renaming() const { return editing_; }
+
+  const std::string& space_id() const { return space_id_; }
+  int RowHeight() const;
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void Layout(PassKey) override;
+  void OnPaint(gfx::Canvas* canvas) override;
+  void OnMouseEntered(const ui::MouseEvent& event) override;
+  void OnMouseExited(const ui::MouseEvent& event) override;
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  void OnMouseReleased(const ui::MouseEvent& event) override;
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+  // views::TextfieldController:
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& key_event) override;
+
+  // Called by the field when it loses focus; commits unless a cancel or an
+  // earlier commit already ended the edit.
+  void OnRenameFieldBlurred();
+
+ private:
+  void ShowMenu();
+  // Builds the space menu and runs it at |anchor| (screen coordinates).
+  void RunMenu(const gfx::Rect& anchor,
+               int run_types,
+               ui::mojom::MenuSourceType source_type);
+  void CommitRename();
+  void CancelRename();
+  void EndRename();
+  void UpdateMenuButtonVisibility();
+  // The icon slot shows the emoji / dot at rest and the chevron under the
+  // pointer (or while editing, so the fold stays reachable).
+  void UpdateIconSlot();
+
+  const raw_ptr<Delegate> delegate_;
+  std::string space_id_;
+  std::u16string name_;
+  std::string icon_;
+  bool collapsed_ = false;
+  bool hovered_ = false;
+  bool editing_ = false;
+
+  raw_ptr<views::Label> icon_label_ = nullptr;
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<WorkspaceFoldChevronView> chevron_ = nullptr;
+  raw_ptr<views::Textfield> editor_ = nullptr;
+  raw_ptr<views::ImageButton> menu_button_ = nullptr;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};
+
