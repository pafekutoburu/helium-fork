+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_HELIUM_SIDEBAR_MENU_DATA_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_HELIUM_SIDEBAR_MENU_DATA_H_
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/cancelable_task_tracker.h"
+#include "ui/base/models/image_model.h"
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+
+// helium-fork M6-r1: one row of a sidebar menu submenu (Dia's History › /
+// Bookmarks › panels, the user's recording of 2026-09-03; Downloads › is
+// ours on the same pattern). A row is a leaf (|activate|) or a folder
+// (|children| builds the next level when the row is hovered). Icons that
+// take a round trip -- a page's favicon, a file's icon -- arrive later
+// through HeliumSidebarMenuData::LoadFavicon / LoadFileIcon, keyed by the
+// two fields below; |icon| is what the row shows meanwhile.
+struct HeliumSidebarMenuItem {
+  HeliumSidebarMenuItem();
+  HeliumSidebarMenuItem(const HeliumSidebarMenuItem&);
+  HeliumSidebarMenuItem& operator=(const HeliumSidebarMenuItem&);
+  ~HeliumSidebarMenuItem();
+
+  ui::ImageModel icon;
+  std::u16string title;
+  bool enabled = true;
+  // A separator above this row (Dia: the one above "Show All History").
+  bool separator_before = false;
+  base::RepeatingClosure activate;
+  base::RepeatingCallback<std::vector<HeliumSidebarMenuItem>()> children;
+  GURL favicon_page_url;
+  base::FilePath file_icon_path;
+};
+
+// The data behind the submenus: history, bookmarks and downloads of the
+// window's profile, plus the async icon loads. Owned by the panel; every
+// pending request is cancelled with it (or by CancelAll() when the panel
+// closes).
+class HeliumSidebarMenuData {
+ public:
+  using Items = std::vector<HeliumSidebarMenuItem>;
+  using ItemsCallback = base::OnceCallback<void(Items)>;
+  using IconCallback = base::OnceCallback<void(ui::ImageModel)>;
+
+  // The most recent entries Dia lists, and where a list is capped.
+  static constexpr int kRecentHistoryCount = 8;
+  static constexpr int kRecentDownloadCount = 8;
+
+  explicit HeliumSidebarMenuData(BrowserWindowInterface* browser);
+  HeliumSidebarMenuData(const HeliumSidebarMenuData&) = delete;
+  HeliumSidebarMenuData& operator=(const HeliumSidebarMenuData&) = delete;
+  ~HeliumSidebarMenuData();
+
+  // History ›: the kRecentHistoryCount most recent pages (favicon + title,
+  // click opens a tab) | Show All History. Asynchronous; the callback is
+  // dropped if the object goes away first.
+  void FetchHistoryItems(ItemsCallback callback);
+  // Bookmarks ›: Manage Bookmarks / Bookmarks Bar › / Other Bookmarks › (and
+  // the mobile folder when it has anything). Folders open one more level.
+  Items BookmarkItems();
+  // Downloads ›: the kRecentDownloadCount most recent downloads (file icon +
+  // name, click opens a finished file) | Show All Downloads.
+  Items DownloadItems();
+
+  void LoadFavicon(const GURL& page_url, IconCallback callback);
+  void LoadFileIcon(const base::FilePath& path, IconCallback callback);
+  void CancelAll();
+
+ private:
+  Items BookmarkChildren(int64_t folder_node_id);
+  void OpenUrl(const GURL& url);
+  void OpenDownload(uint32_t download_id);
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  base::CancelableTaskTracker tracker_;
+  base::WeakPtrFactory<HeliumSidebarMenuData> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_HELIUM_SIDEBAR_MENU_DATA_H_
