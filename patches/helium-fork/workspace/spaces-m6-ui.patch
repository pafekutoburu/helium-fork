+HeliumSidebarMenuItem::HeliumSidebarMenuItem() = default;
+HeliumSidebarMenuItem::HeliumSidebarMenuItem(const HeliumSidebarMenuItem&) =
+    default;
+HeliumSidebarMenuItem& HeliumSidebarMenuItem::operator=(
+    const HeliumSidebarMenuItem&) = default;
+HeliumSidebarMenuItem::~HeliumSidebarMenuItem() = default;
+
+HeliumSidebarMenuData::HeliumSidebarMenuData(BrowserWindowInterface* browser)
+    : browser_(browser) {}
+
+HeliumSidebarMenuData::~HeliumSidebarMenuData() = default;
+
+void HeliumSidebarMenuData::CancelAll() {
+  // Only the requests in flight (the history query, the icon loads): they
+  // all run through the tracker. ⛔ Not the weak pointers -- every row's
+  // activate closure is bound to one, and the panel calls this from Hide()
+  // *before* the clicked row's closure runs, so invalidating them here made
+  // every click in a submenu a silent no-op (user 2026-09-03, item 2).
+  tracker_.TryCancelAll();
+}
+
+void HeliumSidebarMenuData::OpenUrl(const GURL& url) {
+  // A new foreground tab at the end of the strip; the workspace controller
+  // tags it to the current space on insert, like any other new tab.
+  chrome::AddTabAt(browser_, url, /*index=*/-1, /*foreground=*/true);
+}
+
+// ---- History ----
+
+void HeliumSidebarMenuData::FetchHistoryItems(ItemsCallback callback) {
+  history::HistoryService* const history =
+      HistoryServiceFactory::GetForProfile(browser_->GetProfile(),
+                                           ServiceAccessType::EXPLICIT_ACCESS);
+  if (!history) {
+    std::move(callback).Run(Items());
+    return;
+  }
+  history::QueryOptions options;
+  options.max_count = kRecentHistoryCount;
+  options.duplicate_policy = history::QueryOptions::REMOVE_ALL_DUPLICATES;
+  history->QueryHistory(
+      std::u16string(), options,
+      base::BindOnce(
+          [](base::WeakPtr<HeliumSidebarMenuData> self, ItemsCallback callback,
+             history::QueryResults results) {
+            if (!self) {
+              return;
+            }
+            Items items;
+            for (const history::URLResult& result : results) {
+              HeliumSidebarMenuItem item;
+              item.icon = favicon::GetDefaultFaviconModel();
+              item.title = result.title().empty()
+                               ? base::UTF8ToUTF16(result.url().spec())
+                               : result.title();
+              item.favicon_page_url = result.url();
+              item.activate = base::BindRepeating(
+                  &HeliumSidebarMenuData::OpenUrl, self, result.url());
+              items.push_back(std::move(item));
+            }
+            HeliumSidebarMenuItem all;
+            all.icon = MenuGlyph(kHistoryOldIcon);
+            all.title =
+                l10n_util::GetStringUTF16(IDS_HELIUM_WS_MENU_SHOW_ALL_HISTORY);
+            all.separator_before = !items.empty();
+            all.activate = base::BindRepeating(
+                [](base::WeakPtr<HeliumSidebarMenuData> self) {
+                  if (self) {
+                    chrome::ShowHistory(self->browser_);
+                  }
+                },
+                self);
+            items.push_back(std::move(all));
+            std::move(callback).Run(std::move(items));
+          },
+          weak_factory_.GetWeakPtr(), std::move(callback)),
+      &tracker_);
+}
+
+void HeliumSidebarMenuData::LoadFavicon(const GURL& page_url,
+                                        IconCallback callback) {
+  favicon::FaviconService* const favicons =
+      FaviconServiceFactory::GetForProfile(browser_->GetProfile(),
+                                           ServiceAccessType::EXPLICIT_ACCESS);
+  if (!favicons) {
+    return;
+  }
+  favicons->GetFaviconImageForPageURL(
+      page_url,
+      base::BindOnce(
+          [](IconCallback callback,
+             const favicon_base::FaviconImageResult& result) {
+            if (!result.image.IsEmpty()) {
+              std::move(callback).Run(
+                  ui::ImageModel::FromImage(result.image));
+            }
+          },
+          std::move(callback)),
+      &tracker_);
+}
+
+// ---- Bookmarks ----
+
+HeliumSidebarMenuData::Items HeliumSidebarMenuData::BookmarkItems() {
+  Items items;
+  HeliumSidebarMenuItem manage;
+  manage.icon = MenuGlyph(kBookmarksListsMenuOldIcon);
+  manage.title = l10n_util::GetStringUTF16(IDS_HELIUM_WS_MENU_MANAGE_BOOKMARKS);
+  manage.activate = base::BindRepeating(
+      [](base::WeakPtr<HeliumSidebarMenuData> self) {
+        if (self) {
+          chrome::ShowBookmarkManager(self->browser_);
+        }
+      },
+      weak_factory_.GetWeakPtr());
+  items.push_back(std::move(manage));
+
+  bookmarks::BookmarkModel* const model =
+      BookmarkModelFactory::GetForBrowserContext(browser_->GetProfile());
+  if (!model || !model->loaded()) {
+    return items;
+  }
+  const auto add_folder = [&](const bookmarks::BookmarkNode* node) {
+    if (!node) {
+      return;
+    }
+    HeliumSidebarMenuItem folder;
+    folder.icon = chrome::GetBookmarkFolderIcon(
+        chrome::BookmarkFolderIconType::kNormal,
+        ui::kColorLabelForegroundSecondary);
+    folder.title = node->GetTitle();
+    folder.children =
+        base::BindRepeating(&HeliumSidebarMenuData::BookmarkChildren,
+                            base::Unretained(this), node->id());
+    items.push_back(std::move(folder));
+  };
+  // Dia: Bookmarks Bar › / Other Bookmarks ›. The mobile folder only when
+  // it holds something.
+  add_folder(model->bookmark_bar_node());
+  add_folder(model->other_node());
+  if (model->mobile_node() && !model->mobile_node()->children().empty()) {
+    add_folder(model->mobile_node());
+  }
+  return items;
+}
+
+HeliumSidebarMenuData::Items HeliumSidebarMenuData::BookmarkChildren(
+    int64_t folder_node_id) {
+  Items items;
+  bookmarks::BookmarkModel* const model =
+      BookmarkModelFactory::GetForBrowserContext(browser_->GetProfile());
+  if (!model || !model->loaded()) {
+    return items;
+  }
+  const bookmarks::BookmarkNode* const folder =
+      bookmarks::GetBookmarkNodeByID(model, folder_node_id);
+  if (!folder) {
+    return items;
+  }
+  for (const auto& child : folder->children()) {
+    HeliumSidebarMenuItem item;
+    item.title = BookmarkTitle(child.get());
+    if (child->is_folder()) {
+      item.icon = chrome::GetBookmarkFolderIcon(
+          chrome::BookmarkFolderIconType::kNormal,
+          ui::kColorLabelForegroundSecondary);
+      item.children =
+          base::BindRepeating(&HeliumSidebarMenuData::BookmarkChildren,
+                              base::Unretained(this), child->id());
+    } else {
+      // The model's cached favicon, if it has one (asking also starts the
+      // load for next time); the page's from the favicon service otherwise.
+      const gfx::Image& cached = model->GetFavicon(child.get());
+      item.icon = cached.IsEmpty() ? favicon::GetDefaultFaviconModel()
+                                   : ui::ImageModel::FromImage(cached);
+      if (cached.IsEmpty()) {
+        item.favicon_page_url = child->url();
+      }
+      item.activate = base::BindRepeating(&HeliumSidebarMenuData::OpenUrl,
+                                          weak_factory_.GetWeakPtr(),
+                                          child->url());
+    }
+    items.push_back(std::move(item));
+  }
+  return items;
+}
+
+// ---- Downloads ----
+
+HeliumSidebarMenuData::Items HeliumSidebarMenuData::DownloadItems() {
+  Items items;
+  content::DownloadManager* const manager =
+      browser_->GetProfile()->GetDownloadManager();
+  if (manager) {
+    std::vector<raw_ptr<download::DownloadItem, VectorExperimental>> all;
+    manager->GetAllDownloads(&all);
+    std::erase_if(all, [](download::DownloadItem* item) {
+      return !item || item->IsTemporary() || item->IsTransient() ||
+             item->GetTargetFilePath().empty();
+    });
+    // Newest first.
+    std::ranges::sort(all, [](download::DownloadItem* a,
+                              download::DownloadItem* b) {
+      return a->GetStartTime() > b->GetStartTime();
+    });
+    for (size_t i = 0; i < all.size() && i < kRecentDownloadCount; ++i) {
+      download::DownloadItem* const download = all[i];
+      HeliumSidebarMenuItem item;
+      item.icon = MenuGlyph(vector_icons::kFileDownloadOldIcon);
+      item.title = download->GetFileNameToReportUser().LossyDisplayName();
+      item.file_icon_path = download->GetTargetFilePath();
+      item.activate = base::BindRepeating(&HeliumSidebarMenuData::OpenDownload,
+                                          weak_factory_.GetWeakPtr(),
+                                          download->GetId());
+      items.push_back(std::move(item));
+    }
+  }
+  HeliumSidebarMenuItem all;
+  all.icon = MenuGlyph(kDownloadMenuOldIcon);
+  all.title = l10n_util::GetStringUTF16(IDS_HELIUM_WS_MENU_SHOW_ALL_DOWNLOADS);
+  all.separator_before = !items.empty();
+  all.activate = base::BindRepeating(
+      [](base::WeakPtr<HeliumSidebarMenuData> self) {
+        if (self) {
+          chrome::ShowDownloads(self->browser_);
+        }
+      },
+      weak_factory_.GetWeakPtr());
+  items.push_back(std::move(all));
+  return items;
+}
+
+void HeliumSidebarMenuData::OpenDownload(uint32_t download_id) {
+  content::DownloadManager* const manager =
+      browser_->GetProfile()->GetDownloadManager();
+  download::DownloadItem* const download =
+      manager ? manager->GetDownload(download_id) : nullptr;
+  if (download && download->GetState() == download::DownloadItem::COMPLETE) {
+    download->OpenDownload();
+    return;
+  }
+  // Still running, cancelled, or gone: the page has the whole story.
+  chrome::ShowDownloads(browser_);
+}
+
+void HeliumSidebarMenuData::LoadFileIcon(const base::FilePath& path,
+                                         IconCallback callback) {
+  IconManager* const icons = g_browser_process->icon_manager();
+  if (!icons) {
+    return;
+  }
+  icons->LoadIcon(
+      path, IconLoader::SMALL, /*scale=*/1.0f,
+      base::BindOnce(
+          [](IconCallback callback, gfx::Image image) {
+            if (!image.IsEmpty()) {
+              std::move(callback).Run(ui::ImageModel::FromImage(image));
+            }
+          },
+          std::move(callback)),
+      &tracker_);
+}
