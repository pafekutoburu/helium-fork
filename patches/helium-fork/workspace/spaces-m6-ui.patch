+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_HELIUM_SIDEBAR_SUBMENU_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_HELIUM_SIDEBAR_SUBMENU_VIEW_H_
+
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/views/frame/helium_sidebar_menu_data.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/views/controls/button/button.h"
+#include "ui/views/view.h"
+
+namespace views {
+class ImageView;
+class Label;
+}  // namespace views
+
+// helium-fork M6-r1: one row of the sidebar menu or of one of its submenus:
+// icon (x17, a 14pt glyph or a 16pt favicon) + label (x42) + an optional
+// "›" at the right end for a row that opens a submenu. The hover capsule is
+// the sidebar row's; hovering is reported to the owner, which is how the
+// submenus open (Dia: hover, not click).
+class HeliumSidebarMenuRowView : public views::Button {
+  METADATA_HEADER(HeliumSidebarMenuRowView, views::Button)
+
+ public:
+  HeliumSidebarMenuRowView(PressedCallback callback,
+                           ui::ImageModel icon,
+                           const std::u16string& text,
+                           bool has_submenu);
+  HeliumSidebarMenuRowView(const HeliumSidebarMenuRowView&) = delete;
+  HeliumSidebarMenuRowView& operator=(const HeliumSidebarMenuRowView&) = delete;
+  ~HeliumSidebarMenuRowView() override;
+
+  // Runs when the pointer arrives on the row (once per arrival).
+  void SetHoverCallback(base::RepeatingClosure callback);
+  void SetIcon(ui::ImageModel icon);
+  // A disabled row ("Empty"): greyed, no capsule, no click.
+  void SetRowEnabled(bool enabled);
+
+  // views::View:
+  void Layout(PassKey) override;
+  void OnPaintBackground(gfx::Canvas* canvas) override;
+  void OnThemeChanged() override;
+  void StateChanged(ButtonState old_state) override;
+
+ private:
+  void UpdateLabelColor();
+
+  raw_ptr<views::ImageView> icon_ = nullptr;
+  raw_ptr<views::Label> label_ = nullptr;
+  raw_ptr<views::ImageView> chevron_ = nullptr;
+  bool row_enabled_ = true;
+  base::RepeatingClosure hover_callback_;
+};
+
+// One submenu level of the sidebar menu (Dia's History › / Bookmarks ›
+// panels, user recording 2026-09-03): the same card as the panel -- 333
+// wide, 18pt corners, hairline, 37pt rows -- placed by the panel to the
+// right of its parent with their bottoms aligned. Rows come from
+// HeliumSidebarMenuItems; a row with children reports its hover so the
+// panel can open the next level, a leaf reports its click so the panel can
+// close everything. Async icons are fetched through the data object and
+// land on the row when they arrive.
+class HeliumSidebarSubmenuView : public views::View {
+  METADATA_HEADER(HeliumSidebarSubmenuView, views::View)
+
+ public:
+  class Delegate {
+   public:
+    // The pointer arrived on row |index| of |menu|.
+    virtual void OnSubmenuRowHovered(HeliumSidebarSubmenuView* menu,
+                                     size_t index) = 0;
+    // A leaf row was clicked (its own activate already ran).
+    virtual void OnSubmenuRowActivated() = 0;
+
+   protected:
+    virtual ~Delegate() = default;
+  };
+
+  HeliumSidebarSubmenuView(Delegate* delegate,
+                           HeliumSidebarMenuData* data,
+                           std::vector<HeliumSidebarMenuItem> items,
+                           int depth);
+  HeliumSidebarSubmenuView(const HeliumSidebarSubmenuView&) = delete;
+  HeliumSidebarSubmenuView& operator=(const HeliumSidebarSubmenuView&) = delete;
+  ~HeliumSidebarSubmenuView() override;
+
+  int depth() const { return depth_; }
+  const std::vector<HeliumSidebarMenuItem>& items() const { return items_; }
+  // The card's natural height for its rows and separators.
+  int ExpandedHeight() const;
+
+  // views::View:
+  void Layout(PassKey) override;
+  void OnPaint(gfx::Canvas* canvas) override;
+  void OnThemeChanged() override;
+
+ private:
+  void OnRowHovered(size_t index);
+  void OnRowPressed(size_t index);
+  void OnIconLoaded(size_t index, ui::ImageModel icon);
+
+  const raw_ptr<Delegate> delegate_;
+  const raw_ptr<HeliumSidebarMenuData> data_;
+  const std::vector<HeliumSidebarMenuItem> items_;
+  const int depth_;
+  std::vector<raw_ptr<HeliumSidebarMenuRowView>> rows_;
+  // y of each separator, for OnPaint (laid out with the rows).
+  std::vector<int> separator_ys_;
+  base::WeakPtrFactory<HeliumSidebarSubmenuView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_HELIUM_SIDEBAR_SUBMENU_VIEW_H_
