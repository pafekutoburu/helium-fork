+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_HELIUM_SIDEBAR_MENU_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_HELIUM_SIDEBAR_MENU_VIEW_H_
+
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/views/frame/helium_sidebar_menu_data.h"
