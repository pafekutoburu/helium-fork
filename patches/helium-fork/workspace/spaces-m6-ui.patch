+// The submenus' vector glyphs use the panel's secondary colour.
+ui::ImageModel MenuGlyph(const gfx::VectorIcon& icon) {
+  return ui::ImageModel::FromVectorIcon(icon, ui::kColorLabelForegroundSecondary,
+                                        14);
+}
+
+// A bookmark's title, or its URL when it has none.
+std::u16string BookmarkTitle(const bookmarks::BookmarkNode* node) {
+  if (!node->GetTitle().empty()) {
+    return node->GetTitle();
+  }
+  return base::UTF8ToUTF16(node->url().spec());
+}
