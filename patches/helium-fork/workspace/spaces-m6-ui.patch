+  slide_ended_callback_ = std::move(ended);
+}
+
+void TabStripView::CaptureListSnapshot() {
+  DropSlideSnapshots();
+  if (!layer() || width() <= 0) {
+    return;
+  }
+  const float scale = layer()->device_scale_factor();
+  const auto add = [&](views::View* view, const gfx::Rect& visible_in_view,
+                       const gfx::Rect& bounds_in_strip) {
+    std::unique_ptr<HeliumViewSnapshotLayer> snapshot =
+        HeliumViewSnapshotLayer::Capture(view, visible_in_view, scale);
+    if (!snapshot) {
+      return;
+    }
+    snapshot->layer()->SetBounds(bounds_in_strip);
+    layer()->Add(snapshot->layer());
+    slide_snapshots_.push_back(std::move(snapshot));
+  };
+  // The scrollers' contents, through the part of them that is on screen
+  // (GetVisibleRect is in contents coordinates); the snapshot sits where
+  // the viewport is.
+  for (views::ScrollView* scroll_view :
+       {pinned_tabs_scroll_view_.get(), unpinned_tabs_scroll_view_.get()}) {
+    if (!scroll_view || !scroll_view->GetVisible() || !scroll_view->contents()) {
+      continue;
+    }
+    const gfx::Rect visible = scroll_view->GetVisibleRect();
+    add(scroll_view->contents(), visible,
+        gfx::Rect(scroll_view->origin(), visible.size()));
+  }
+  if (tabs_separator_ && tabs_separator_->GetVisible()) {
+    add(tabs_separator_, tabs_separator_->GetLocalBounds(),
+        tabs_separator_->bounds());
+  }
+}
+
+void TabStripView::DropSlideSnapshots() {
+  // A layer leaves its parent in its destructor.
+  slide_snapshots_.clear();
+}
+
+void TabStripView::SlideListRegion(int direction) {
+  if (direction == 0 || width() <= 0) {
+    // A landing (startup, restore): nothing moves, and whatever was
+    // snapshotted for a carousel is not wanted.
+    DropSlideSnapshots();
+    if (slide_ended_callback_) {
+      slide_ended_callback_.Run();
+    }
+    return;
+  }
+  slide_direction_ = direction > 0 ? 1 : -1;
+  // A switch mid-slide restarts from the edge: the list that was arriving
+  // has just been replaced anyway.
+  slide_animation_.Reset(0.0);
+  ApplySlideTransform(0.0);
+  slide_animation_.Show();
+}
+
+void TabStripView::ApplySlideTransform(double progress) {
+  // One strip: the leaving list is a strip width behind the arriving one.
+  const float dx_live =
+      static_cast<float>((1.0 - progress) * slide_direction_ * width());
+  const float dx_old = dx_live - static_cast<float>(slide_direction_ * width());
+  slide_dx_live_ = dx_live;
+  const gfx::Transform live = gfx::Transform::MakeTranslation(dx_live, 0.0f);
+  for (views::View* view : {static_cast<views::View*>(pinned_tabs_scroll_view_),
+                            static_cast<views::View*>(tabs_separator_),
+                            static_cast<views::View*>(unpinned_tabs_scroll_view_)}) {
+    if (view && view->layer()) {
+      view->layer()->SetTransform(live);
+    }
+  }
+  const gfx::Transform old = gfx::Transform::MakeTranslation(dx_old, 0.0f);
+  for (auto& snapshot : slide_snapshots_) {
+    snapshot->layer()->SetTransform(old);
+  }
+  if (slide_progress_callback_) {
+    slide_progress_callback_.Run(dx_live, dx_old);
+  }
+}
+
+void TabStripView::AnimationProgressed(const gfx::Animation* animation) {
+  if (animation == &slide_animation_) {
+    ApplySlideTransform(slide_animation_.GetCurrentValue());
+  }
+}
+
+void TabStripView::AnimationEnded(const gfx::Animation* animation) {
+  if (animation == &slide_animation_) {
+    ApplySlideTransform(1.0);
+    DropSlideSnapshots();
+    if (slide_ended_callback_) {
+      slide_ended_callback_.Run();
+    }
+  }
+}
