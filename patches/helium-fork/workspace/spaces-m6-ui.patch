+
+#include "chrome/browser/ui/views/frame/helium_sidebar_menu_view.h"
+
+#include <algorithm>
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/chrome_pages.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/helium/arc_sidebar_menu.h"
+#include "chrome/browser/ui/helium/arc_sidebar_surface.h"
+#include "chrome/browser/ui/helium_workspace/workspace_tab_controller.h"
+#include "chrome/browser/ui/views/download/bubble/download_toolbar_ui_controller.h"
+#include "chrome/browser/ui/views/frame/helium_card_shadow_view.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/vector_icons/vector_icons.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_provider.h"
+#include "ui/compositor/layer.h"
+#include "ui/events/event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/views/event_monitor.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+// The hover capsule inside a row keeps the same 8pt edge system as the
+// sidebar's own rows; the separator runs between the capsules' edges.
+constexpr int kRowCapsuleInset = 8;
+
+}  // namespace
+
+HeliumSidebarMenuView::HeliumSidebarMenuView(BrowserWindowInterface* browser)
+    : views::AnimationDelegateViews(this),
+      browser_(browser),
+      data_(std::make_unique<HeliumSidebarMenuData>(browser)) {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  layer()->SetOpacity(0.0f);
+  SetVisible(false);
+  open_animation_.SetSlideDuration(helium::kSidebarMenuDuration);
+
+  // The icons are the app menu's (app_menu_model.cc); this build has rounded
+  // icons off, so the "Old" glyphs are what the rest of the browser shows.
+  const auto add_row = [&](Action action, const gfx::VectorIcon& icon,
+                           int string_id, bool has_submenu) {
+    auto* row = AddChildView(std::make_unique<HeliumSidebarMenuRowView>(
+        base::BindRepeating(&HeliumSidebarMenuView::Run, base::Unretained(this),
+                            action),
+        ui::ImageModel::FromVectorIcon(icon, ui::kColorLabelForegroundSecondary,
+                                       helium::kSidebarMenuIconSize),
+        l10n_util::GetStringUTF16(string_id), has_submenu));
+    row->SetHoverCallback(base::BindRepeating(
+        &HeliumSidebarMenuView::OnRowHovered, base::Unretained(this), action));
+    rows_.push_back(row);
+    row_actions_.push_back(action);
+  };
+  add_row(Action::kNewSpace, vector_icons::kAddOldIcon, IDS_HELIUM_WS_NEW_SPACE,
+          /*has_submenu=*/false);
+  add_row(Action::kDownloads, kDownloadMenuOldIcon, IDS_HELIUM_WS_MENU_DOWNLOADS,
+          /*has_submenu=*/true);
+  add_row(Action::kHistory, kHistoryOldIcon, IDS_HELIUM_WS_MENU_HISTORY,
+          /*has_submenu=*/true);
+  add_row(Action::kBookmarks, kBookmarksListsMenuOldIcon,
+          IDS_HELIUM_WS_MENU_BOOKMARKS, /*has_submenu=*/true);
+}
+
+HeliumSidebarMenuView::~HeliumSidebarMenuView() {
+  // The submenus are the parent's children; take them with us.
+  CloseSubmenusFrom(0);
+}
+
+void HeliumSidebarMenuView::SetShadowFrame(HeliumCardShadowView* shadow) {
+  shadow_frame_ = shadow;
+  if (shadow_frame_) {
+    shadow_frame_->SetShadowCornerRadius(helium::kSidebarMenuRadius);
+    shadow_frame_->SetVisible(false);
+  }
+}
+
+void HeliumSidebarMenuView::Toggle(const gfx::Rect& anchor_in_parent) {
+  if (shown_) {
+    Hide();
+  } else {
+    Show(anchor_in_parent);
+  }
+}
+
+void HeliumSidebarMenuView::Show(const gfx::Rect& anchor_in_parent) {
+  anchor_in_parent_ = anchor_in_parent;
+  if (shown_) {
+    UpdateBounds();
+    return;
+  }
+  SetShown(true);
+}
+
+void HeliumSidebarMenuView::Hide() {
+  if (shown_) {
+    SetShown(false);
+  }
+}
+
+bool HeliumSidebarMenuView::ContainsScreenPoint(
+    const gfx::Point& screen_point) const {
+  if (!shown_) {
+    return false;
+  }
+  if (GetBoundsInScreen().Contains(screen_point)) {
+    return true;
+  }
+  for (const SubmenuLevel& level : submenus_) {
+    if (level.view && level.view->GetBoundsInScreen().Contains(screen_point)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void HeliumSidebarMenuView::SetShown(bool shown) {
+  shown_ = shown;
+  if (shown) {
+    SetVisible(true);
+    UpdateBounds();
+    // Escape and the outside click, both only while up -- an accelerator
+    // that lived on this view permanently would swallow every Escape.
+    AddAccelerator(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE));
+    if (views::Widget* widget = GetWidget()) {
+      event_monitor_ = views::EventMonitor::CreateWindowMonitor(
+          this, widget->GetNativeWindow(),
+          {ui::EventType::kMousePressed, ui::EventType::kTouchPressed});
+    }
+    open_animation_.Show();
+  } else {
+    ResetAccelerators();
+    event_monitor_.reset();
+    // The submenus go at once; only the panel fades.
+    CloseSubmenusFrom(0);
+    submenu_action_.reset();
+    data_->CancelAll();
+    open_animation_.Hide();
+  }
+}
+
+int HeliumSidebarMenuView::ExpandedHeight() const {
+  // Two groups: New Space | Downloads / History / Bookmarks.
+  return helium::SidebarMenuHeight(static_cast<int>(rows_.size()), 2);
+}
+
+void HeliumSidebarMenuView::UpdateBounds() {
+  if (!parent()) {
+    return;
+  }
+  const gfx::Rect bounds = helium::SidebarMenuBounds(
+      anchor_in_parent_, parent()->size(), ExpandedHeight(),
+      open_animation_.GetCurrentValue());
+  SetBoundsRect(bounds);
+  const float progress = static_cast<float>(open_animation_.GetCurrentValue());
+  layer()->SetOpacity(progress);
+  if (shadow_frame_) {
+    const bool shadow_visible =
+        progress > 0.0f && helium::CanShowCardShadow(bounds.width(),
+                                                     bounds.height(),
+                                                     helium::kSidebarMenuRadius);
+    shadow_frame_->SetVisible(shadow_visible);
+    shadow_frame_->SetShadowOpacity(progress);
+    shadow_frame_->SetCardBounds(bounds);
+  }
+  PositionSubmenus();
+}
+
+void HeliumSidebarMenuView::Layout(PassKey) {
+  // Rows from the top inset down; the panel's height is animated, so rows
+  // that do not fit yet are simply clipped by the layer's bounds.
+  int y = helium::kSidebarMenuVerticalInset;
+  for (size_t i = 0; i < rows_.size(); ++i) {
+    if (i == 1) {
+      // The separator between the two groups.
+      y += helium::kSidebarMenuVerticalInset + helium::kSidebarMenuSeparatorHeight +
+           helium::kSidebarMenuVerticalInset;
+    }
+    rows_[i]->SetBounds(0, y, width(), helium::kSidebarMenuRowHeight);
+    y += helium::kSidebarMenuRowHeight;
+  }
+}
+
+void HeliumSidebarMenuView::OnPaint(gfx::Canvas* canvas) {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  const SkColor sidebar = colors->GetColor(kColorToolbar);
+  const gfx::RectF panel(GetLocalBounds());
+  cc::PaintFlags fill;
+  fill.setStyle(cc::PaintFlags::kFill_Style);
+  fill.setAntiAlias(true);
+  fill.setColor(helium::GetSidebarFloatingCardColor(sidebar));
+  canvas->DrawRoundRect(panel, helium::kSidebarMenuRadius, fill);
+  // Dia's hairline, half a pixel inside so it is not clipped.
+  cc::PaintFlags line;
+  line.setStyle(cc::PaintFlags::kStroke_Style);
+  line.setStrokeWidth(1.0f);
+  line.setAntiAlias(true);
+  line.setColor(SkColorSetA(SK_ColorBLACK,
+                            static_cast<U8CPU>(helium::kSidebarMenuBorderAlpha * 255)));
+  gfx::RectF inset = panel;
+  inset.Inset(0.5f);
+  canvas->DrawRoundRect(inset, helium::kSidebarMenuRadius - 0.5f, line);
+  // The separator under the first group.
+  if (rows_.size() > 1) {
+    const int y = rows_[0]->bounds().bottom() + helium::kSidebarMenuVerticalInset;
+    cc::PaintFlags separator;
+    separator.setStyle(cc::PaintFlags::kFill_Style);
+    separator.setColor(SkColorSetA(
+        SK_ColorBLACK,
+        static_cast<U8CPU>(helium::kSidebarMenuSeparatorAlpha * 255)));
+    canvas->DrawRect(gfx::RectF(kRowCapsuleInset, y,
+                                std::max(0, width() - 2 * kRowCapsuleInset),
+                                helium::kSidebarMenuSeparatorHeight),
+                     separator);
+  }
+  views::View::OnPaint(canvas);
+}
+
+void HeliumSidebarMenuView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  SchedulePaint();  // a layer's raster does not follow the theme by itself
+}
+
+bool HeliumSidebarMenuView::AcceleratorPressed(
+    const ui::Accelerator& accelerator) {
+  Hide();
+  return true;
+}
+
+void HeliumSidebarMenuView::VisibilityChanged(views::View* starting_from,
+                                              bool is_visible) {
+  if (!is_visible && shown_) {
+    // Hidden from above (the sidebar folded away, the window changed
+    // shape): drop the dismissal hooks without animating.
+    shown_ = false;
+    ResetAccelerators();
+    event_monitor_.reset();
+    CloseSubmenusFrom(0);
+    submenu_action_.reset();
+    data_->CancelAll();
+    open_animation_.Reset(0.0);
+    layer()->SetOpacity(0.0f);
+    if (shadow_frame_) {
+      shadow_frame_->SetVisible(false);
+    }
+  }
+}
+
+void HeliumSidebarMenuView::AnimationProgressed(const gfx::Animation* animation) {
+  UpdateBounds();
+}
+
+void HeliumSidebarMenuView::AnimationEnded(const gfx::Animation* animation) {
+  UpdateBounds();
+  if (!shown_) {
+    SetVisible(false);
+    if (shadow_frame_) {
+      shadow_frame_->SetVisible(false);
+    }
+  }
+}
+
+void HeliumSidebarMenuView::OnEvent(const ui::Event& event) {
+  if (!shown_ || !event_monitor_) {
+    return;
+  }
+  // A press on the panel or a submenu is a row's; a press on the anchor is
+  // the "⌄"'s own toggle (letting it through here would close and reopen).
+  // Anything else closes.
+  const gfx::Point screen_point = event_monitor_->GetLastMouseLocation();
+  if (ContainsScreenPoint(screen_point)) {
+    return;
+  }
+  if (parent()) {
+    gfx::Rect anchor_in_screen = anchor_in_parent_;
+    views::View::ConvertRectToScreen(parent(), &anchor_in_screen);
+    if (anchor_in_screen.Contains(screen_point)) {
+      return;
+    }
+  }
+  Hide();
+}
+
+void HeliumSidebarMenuView::Run(Action action) {
+  Hide();
+  switch (action) {
+    case Action::kNewSpace:
+      if (auto* controller =
+              helium_workspace::WorkspaceTabController::From(browser_)) {
+        controller->NewSpaceFromMenu();
+      }
+      break;
+    case Action::kDownloads:
+      // The bubble, anchored to the "⌄" (DownloadToolbarUIController M6).
+      if (auto* downloads = DownloadToolbarUIController::From(browser_)) {
+        downloads->InvokeUI();
+      } else {
+        chrome::ShowDownloads(browser_);
+      }
+      break;
+    case Action::kHistory:
+      chrome::ShowHistory(browser_);
+      break;
+    case Action::kBookmarks:
+      chrome::ShowBookmarkManager(browser_);
+      break;
+  }
+}
+
+// ---- Submenus (M6-r1) ----
+
+void HeliumSidebarMenuView::OnRowHovered(Action action) {
+  if (!shown_ || submenu_action_ == action) {
+    return;  // already open (or on its way) for this row
+  }
+  submenu_action_ = action;
+  CloseSubmenusFrom(0);
+  data_->CancelAll();
+  switch (action) {
+    case Action::kNewSpace:
+      submenu_action_.reset();
+      break;
+    case Action::kDownloads:
+      OpenSubmenu(0, data_->DownloadItems());
+      break;
+    case Action::kHistory:
+      // Asynchronous: OnHistoryItems opens it if History is still hovered.
+      data_->FetchHistoryItems(base::BindOnce(
+          &HeliumSidebarMenuView::OnHistoryItems, weak_factory_.GetWeakPtr()));
+      break;
+    case Action::kBookmarks:
+      OpenSubmenu(0, data_->BookmarkItems());
+      break;
+  }
+}
+
+void HeliumSidebarMenuView::OnHistoryItems(
+    std::vector<HeliumSidebarMenuItem> items) {
+  if (shown_ && submenu_action_ == Action::kHistory) {
+    OpenSubmenu(0, std::move(items));
+  }
+}
+
+void HeliumSidebarMenuView::OnSubmenuRowHovered(HeliumSidebarSubmenuView* menu,
+                                                size_t index) {
+  if (!shown_ || index >= menu->items().size()) {
+    return;
+  }
+  const HeliumSidebarMenuItem& item = menu->items()[index];
+  const int next_depth = menu->depth() + 1;
+  if (item.children.is_null()) {
+    // A leaf: whatever was open below this level goes.
+    CloseSubmenusFrom(next_depth);
+    return;
+  }
+  // The same folder again (the pointer came back from its submenu): keep
+  // what is open.
+  if (static_cast<int>(submenus_.size()) > next_depth &&
+      submenus_[next_depth].parent_row == index) {
+    return;
+  }
+  OpenSubmenu(next_depth, item.children.Run(), index);
+}
+
+void HeliumSidebarMenuView::OnSubmenuRowActivated() {
+  Hide();
+}
+
+void HeliumSidebarMenuView::OpenSubmenu(
+    int depth,
+    std::vector<HeliumSidebarMenuItem> items,
+    size_t parent_row) {
+  if (!parent() || depth < 0 ||
+      depth > static_cast<int>(submenus_.size())) {
+    return;
+  }
+  CloseSubmenusFrom(depth);
+  // Shadow below, card above, both right after this panel (and the levels
+  // before) in the parent's child order so they composite over the page
+  // and under nothing of ours.
+  SubmenuLevel level;
+  level.parent_row = parent_row;
+  auto shadow = std::make_unique<HeliumCardShadowView>();
+  shadow->SetShadowCornerRadius(helium::kSidebarMenuRadius);
+  level.shadow = parent()->AddChildView(std::move(shadow));
+  level.view = parent()->AddChildView(std::make_unique<HeliumSidebarSubmenuView>(
+      this, data_.get(), std::move(items), depth));
+  submenus_.push_back(level);
+  PositionSubmenus();
+}
+
+void HeliumSidebarMenuView::CloseSubmenusFrom(int depth) {
+  while (static_cast<int>(submenus_.size()) > std::max(depth, 0)) {
+    SubmenuLevel level = submenus_.back();
+    submenus_.pop_back();
+    if (parent()) {
+      if (level.view) {
+        parent()->RemoveChildViewT(level.view.get());
+      }
+      if (level.shadow) {
+        parent()->RemoveChildViewT(level.shadow.get());
+      }
+    }
+  }
+}
+
+void HeliumSidebarMenuView::PositionSubmenus() {
+  if (!parent()) {
+    return;
+  }
+  // Dia: each level against its parent's right edge, bottoms aligned; a
+  // level that would leave the window slides back left over its parent.
+  gfx::Rect previous = bounds();
+  const int parent_width = parent()->width();
+  for (SubmenuLevel& level : submenus_) {
+    if (!level.view) {
+      continue;
+    }
+    const int width = std::min(helium::kSidebarMenuWidth, std::max(parent_width, 0));
+    const int height = std::min(level.view->ExpandedHeight(),
+                                std::max(previous.bottom(), 0));
+    int x = previous.right();
+    x = std::clamp(x, 0, std::max(parent_width - width, 0));
+    const gfx::Rect rect(x, previous.bottom() - height, width, height);
+    level.view->SetBoundsRect(rect);
+    level.view->layer()->SetOpacity(layer()->opacity());
+    if (level.shadow) {
+      const bool shadow_visible = helium::CanShowCardShadow(
+          rect.width(), rect.height(), helium::kSidebarMenuRadius);
+      level.shadow->SetVisible(shadow_visible);
+      level.shadow->SetShadowOpacity(layer()->opacity());
+      level.shadow->SetCardBounds(rect);
+    }
+    previous = rect;
+  }
+}
+
+BEGIN_METADATA(HeliumSidebarMenuView)
+END_METADATA
