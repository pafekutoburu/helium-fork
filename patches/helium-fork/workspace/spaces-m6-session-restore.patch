@@ -0,0 +1,69 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_CRASH_AUTO_RESTORE_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_CRASH_AUTO_RESTORE_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/supports_user_data.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+
+class Profile;
+
+namespace helium_workspace {
+
+// helium-fork T027: the per-profile half of the post-crash auto-restore --
+// the pref counter, the health timer and the backup of the session file that
+// is about to be restored. The decision itself lives in
+// crash_auto_restore_policy.h (dependency-free, unit tested).
+//
+// One instance per original profile, held as user data on the Profile so the
+// timer dies with it.
+class CrashAutoRestore : public base::SupportsUserData::Data {
+ public:
+  CrashAutoRestore(const CrashAutoRestore&) = delete;
+  CrashAutoRestore& operator=(const CrashAutoRestore&) = delete;
+  ~CrashAutoRestore() override;
+
+  // Called once per profile launch from StartupBrowserCreatorImpl, *before*
+  // the browser-open behaviour is decided. Always arms the health timer (a run
+  // that stays up clears the loop counter, whether or not it restored
+  // anything); returns true when this launch should restore the previous
+  // session even though the last exit was a crash. Backs the session file up
+  // and writes the counter as part of returning true.
+  // `is_post_crash_launch` is the caller's own answer (HasPendingUncleanExit):
+  // it also covers "this profile already has a browser open" and the upstream
+  // --hide-crash-restore-bubble switch, neither of which the policy can see.
+  // The health timer is armed regardless of it; only the side effects (counter,
+  // backup, "this launch auto-restored") are gated on it.
+  static bool OnStartupShouldAutoRestore(Profile* profile,
+                                         bool is_post_crash_launch);
+
+  // True when this launch took the auto-restore branch. Note the semantics:
+  // "took the branch", not "got tabs back" -- an empty or unusable session
+  // makes SessionRestore return null, and the crash bubble must stay away in
+  // that case too, otherwise its CrashedLock blocks the explicit ack and the
+  // crashed state stays sticky.
+  static bool DidAutoRestoreThisLaunch(Profile* profile);
+
+  static void SetHealthyAfterForTesting(base::TimeDelta healthy_after);
+
+ private:
+  explicit CrashAutoRestore(Profile* profile);
+
+  static CrashAutoRestore* GetOrCreate(Profile* profile);
+
+  void StartHealthTimer();
+  void OnRunIsHealthy();
+
+  const raw_ptr<Profile> profile_;
+  bool decided_ = false;
+  bool did_auto_restore_ = false;
+  base::OneShotTimer health_timer_;
+};
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_CRASH_AUTO_RESTORE_H_
