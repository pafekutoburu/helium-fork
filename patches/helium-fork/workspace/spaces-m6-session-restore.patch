--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/crash_auto_restore_policy.h
@@ -0,0 +1,72 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_CRASH_AUTO_RESTORE_POLICY_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_CRASH_AUTO_RESTORE_POLICY_H_
+
+#include "base/time/time.h"
+
+// helium-fork T027: when may a post-crash launch restore the previous session
+// by itself?
+//
+// Upstream never restores after a crash (StartupBrowserCreatorImpl::
+// DetermineBrowserOpenBehavior) and waits for the user to acknowledge the crash
+// bubble; until that ack SessionService keeps saving disabled, so the run after
+// a crash writes nothing at all. In this fork the sidebar's Today section *is*
+// the session, so that rule costs the user their whole sidebar, and the fork
+// has already decided that every startup restores without asking (2a-r5).
+//
+// The protection upstream bought with that rule -- a crash loop must not
+// overwrite the last good session file -- is kept here by a counter: the first
+// post-crash launch restores, a second one in a row does not. A run that stays
+// up for `healthy_after` is considered healthy and clears the counter, so an
+// occasional crash never degrades into "empty window forever" (the deciding
+// point: this build can also crash *on exit*, so a clean exit is not something
+// the counter may depend on).
+//
+// This header is deliberately dependency-free (base only) so the decision can
+// be unit tested in helium_workspace_unittests.
+namespace helium_workspace {
+
+// Mirrors the three states of ExitType (chrome/browser/sessions/
+// exit_type_service.h) without depending on it.
+enum class CrashRestoreExitType {
+  kClean,
+  kCrashed,
+  kForcedShutdown,
+};
+
+// How long a run has to stay up before it counts as healthy.
+inline constexpr base::TimeDelta kDefaultHealthyAfter = base::Seconds(60);
+
+// The counter value written when the auto-restore branch is taken.
+inline constexpr int kCountAfterAutoRestore = 1;
+
+// The whole decision: only a crashed previous exit qualifies, and only while
+// the loop counter is clear. `kForcedShutdown` (system shutdown / logout) is
+// not a crash -- it must neither restore through this path nor touch the
+// counter.
+inline bool ShouldAutoRestoreAfterCrash(CrashRestoreExitType last_exit,
+                                        int auto_restore_count) {
+  return last_exit == CrashRestoreExitType::kCrashed && auto_restore_count <= 0;
+}
+
+// A clean previous exit clears the counter right away; anything else leaves it
+// to the health timer.
+inline bool ShouldResetCountAtStartup(CrashRestoreExitType last_exit,
+                                      int auto_restore_count) {
+  return last_exit == CrashRestoreExitType::kClean && auto_restore_count != 0;
+}
+
+// A run that has been up this long is healthy: whatever crashed before, it was
+// not a crash loop.
+inline bool ShouldResetCountAfterUptime(base::TimeDelta uptime,
+                                        base::TimeDelta healthy_after,
+                                        int auto_restore_count) {
+  return auto_restore_count != 0 && uptime >= healthy_after;
+}
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_CRASH_AUTO_RESTORE_POLICY_H_
