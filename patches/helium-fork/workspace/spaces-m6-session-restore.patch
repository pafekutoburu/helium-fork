+
+#include "chrome/browser/ui/helium_workspace/crash_auto_restore.h"
+
+#include <utility>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/memory/ptr_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/exit_type_service.h"
+#include "chrome/browser/ui/helium_workspace/crash_auto_restore_policy.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/sessions/core/command_storage_backend.h"
+#include "components/sessions/core/command_storage_manager.h"
+
+namespace helium_workspace {
+
+namespace {
+
+constexpr char kUserDataKey[] = "helium_workspace::CrashAutoRestore";
+
+// Not `Session_*` and not `Tabs_*`: CommandStorageBackend only enumerates its
+// own prefixes (GetSessionFilesSortedByReverseTimestamp), and deletes only what
+// it enumerated (DeleteLastSessionFiles, run at every startup), so a backup
+// under this name survives.
+constexpr base::FilePath::CharType kBackupPrefix[] =
+    FILE_PATH_LITERAL("HeliumCrashBackup_");
+
+base::TimeDelta g_healthy_after = kDefaultHealthyAfter;
+
+CrashRestoreExitType ToPolicyExitType(ExitType exit_type) {
+  switch (exit_type) {
+    case ExitType::kClean:
+      return CrashRestoreExitType::kClean;
+    case ExitType::kCrashed:
+      return CrashRestoreExitType::kCrashed;
+    case ExitType::kForcedShutdown:
+      return CrashRestoreExitType::kForcedShutdown;
+  }
+}
+
+// Copies the session file that this launch is about to restore from. It has to
+// happen before the crash is acknowledged: acking re-enables saving, this run
+// writes a newer file, and at the *next* startup CommandStorageBackend deletes
+// every session file except the newest usable one -- which is how a partial
+// restore can make the good file disappear for good.
+//
+// `decided_at` is the moment the auto-restore branch was taken, on the UI
+// thread. The lookup ignores anything newer, so it cannot end up copying the
+// session file this run wrote after the crash was acknowledged -- backing up
+// the post-restore state instead of the pre-crash one is exactly the failure
+// the backup exists to prevent (r2 code review, Minor 4). Pinning by timestamp
+// rather than resolving the path on the UI thread keeps startup free of file
+// I/O (base::ScopedAllowBlocking is friend-only, and this is a DCHECK build).
+void BackupUsableSessionFileOnBackgroundThread(base::FilePath profile_path,
+                                               base::Time decided_at) {
+  const base::FilePath src =
+      sessions::CommandStorageBackend::GetUnencryptedFileUsableForLastSession(
+          profile_path,
+          sessions::CommandStorageManager::SessionType::kSessionRestore,
+          decided_at);
+  if (src.empty()) {
+    return;
+  }
+  const base::FilePath dir = src.DirName();
+  base::FilePath::StringType name(kBackupPrefix);
+  name += base::NumberToString(
+      base::Time::Now().ToDeltaSinceWindowsEpoch().InMicroseconds());
+  const base::FilePath dst = dir.Append(name);
+  if (!base::CopyFile(src, dst)) {
+    return;
+  }
+  // Keep exactly one backup: the user only ever wants the newest one, and this
+  // directory is otherwise pruned by Chromium itself.
+  base::FilePath::StringType pattern(kBackupPrefix);
+  pattern += FILE_PATH_LITERAL("*");
+  base::FileEnumerator old_backups(dir, /*recursive=*/false,
+                                   base::FileEnumerator::FILES, pattern);
+  for (base::FilePath path = old_backups.Next(); !path.empty();
+       path = old_backups.Next()) {
+    if (path != dst) {
+      base::DeleteFile(path);
+    }
+  }
+}
+
+}  // namespace
+
+CrashAutoRestore::CrashAutoRestore(Profile* profile) : profile_(profile) {}
+
+CrashAutoRestore::~CrashAutoRestore() = default;
+
+// static
+CrashAutoRestore* CrashAutoRestore::GetOrCreate(Profile* profile) {
+  auto* existing =
+      static_cast<CrashAutoRestore*>(profile->GetUserData(&kUserDataKey));
+  if (existing) {
+    return existing;
+  }
+  auto owned = base::WrapUnique(new CrashAutoRestore(profile));
+  CrashAutoRestore* raw = owned.get();
+  profile->SetUserData(&kUserDataKey, std::move(owned));
+  return raw;
+}
+
+// static
+bool CrashAutoRestore::OnStartupShouldAutoRestore(Profile* profile,
+                                                  bool is_post_crash_launch) {
+  if (!profile) {
+    return false;
+  }
+  Profile* original = profile->GetOriginalProfile();
+  CrashAutoRestore* self = GetOrCreate(original);
+  if (self->decided_) {
+    return self->did_auto_restore_;
+  }
+  self->decided_ = true;
+
+  PrefService* prefs = original->GetPrefs();
+  // Read the exit type through ExitTypeService, never through
+  // prefs::kSessionExitType: the service rewrites that pref to "Crashed" in its
+  // own constructor, so the pref no longer describes the previous run.
+  const CrashRestoreExitType last_exit =
+      ToPolicyExitType(ExitTypeService::GetLastSessionExitType(original));
+  int count = prefs->GetInteger(prefs::kHeliumCrashAutoRestoreCount);
+  if (ShouldResetCountAtStartup(last_exit, count)) {
+    prefs->SetInteger(prefs::kHeliumCrashAutoRestoreCount, 0);
+    prefs->CommitPendingWrite();
+    count = 0;
+  }
+
+  // Every launch arms the timer, not just the ones that restore: this build can
+  // crash on the way out, so a clean exit is not something the loop guard may
+  // wait for. A run that simply stays up long enough is proof enough that we
+  // are not in a crash loop.
+  self->StartHealthTimer();
+
+  // Everything below is a side effect of *taking* the auto-restore branch, so
+  // it may only happen when this launch actually takes it. `is_post_crash_launch`
+  // carries the two conditions the policy cannot see -- the profile has not
+  // been launched with a browser open yet, and the upstream
+  // --hide-crash-restore-bubble switch is absent (HasPendingUncleanExit). With
+  // that switch the browser neither restores nor acknowledges anything, so
+  // burning the one allowed automatic restore would be wrong (r2 code review,
+  // Minor 3).
+  if (!is_post_crash_launch ||
+      !ShouldAutoRestoreAfterCrash(last_exit, count)) {
+    return false;
+  }
+
+  // Write the counter *before* the restore starts, and force it out to disk:
+  // PrefService commits on a delay, and the case this guard exists for is
+  // precisely "crashes again a few seconds from now".
+  prefs->SetInteger(prefs::kHeliumCrashAutoRestoreCount, kCountAfterAutoRestore);
+  prefs->CommitPendingWrite();
+
+  // Pin *which* file is meant here, at the moment the branch is taken: the copy
+  // itself runs on the pool, but it may only consider files that already
+  // existed now (see BackupUsableSessionFileOnBackgroundThread).
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&BackupUsableSessionFileOnBackgroundThread,
+                     original->GetPath(), base::Time::Now()));
+
+  self->did_auto_restore_ = true;
+  return true;
+}
+
+// static
+bool CrashAutoRestore::DidAutoRestoreThisLaunch(Profile* profile) {
+  if (!profile) {
+    return false;
+  }
+  auto* self = static_cast<CrashAutoRestore*>(
+      profile->GetOriginalProfile()->GetUserData(&kUserDataKey));
+  return self && self->did_auto_restore_;
+}
+
+// static
+void CrashAutoRestore::SetHealthyAfterForTesting(base::TimeDelta healthy_after) {
+  g_healthy_after = healthy_after;
+}
+
+void CrashAutoRestore::StartHealthTimer() {
+  health_timer_.Start(FROM_HERE, g_healthy_after,
+                      base::BindOnce(&CrashAutoRestore::OnRunIsHealthy,
+                                     base::Unretained(this)));
+}
+
+void CrashAutoRestore::OnRunIsHealthy() {
+  PrefService* prefs = profile_->GetPrefs();
+  const int count = prefs->GetInteger(prefs::kHeliumCrashAutoRestoreCount);
+  if (!ShouldResetCountAfterUptime(g_healthy_after, g_healthy_after, count)) {
+    return;
+  }
+  prefs->SetInteger(prefs::kHeliumCrashAutoRestoreCount, 0);
+  prefs->CommitPendingWrite();
+}
