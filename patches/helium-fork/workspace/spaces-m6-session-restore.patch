===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/crash_auto_restore_policy_unittest.cc
@@ -0,0 +1,64 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/crash_auto_restore_policy.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium_workspace {
+namespace {
+
+using ExitT = CrashRestoreExitType;
+
+TEST(CrashAutoRestorePolicyTest, OnlyACrashedExitRestores) {
+  EXPECT_TRUE(ShouldAutoRestoreAfterCrash(ExitT::kCrashed, 0));
+  EXPECT_FALSE(ShouldAutoRestoreAfterCrash(ExitT::kClean, 0));
+  // A system shutdown / logout is not a crash: no restore through this path.
+  EXPECT_FALSE(ShouldAutoRestoreAfterCrash(ExitT::kForcedShutdown, 0));
+}
+
+TEST(CrashAutoRestorePolicyTest, CounterIsTheLoopGuard) {
+  // First post-crash launch restores; a second one in a row does not, so the
+  // last good session file survives a crash loop.
+  EXPECT_TRUE(ShouldAutoRestoreAfterCrash(ExitT::kCrashed, 0));
+  EXPECT_FALSE(ShouldAutoRestoreAfterCrash(ExitT::kCrashed, 1));
+  EXPECT_FALSE(ShouldAutoRestoreAfterCrash(ExitT::kCrashed, 2));
+  // A negative value (corrupt pref) must behave like zero, not like "blocked".
+  EXPECT_TRUE(ShouldAutoRestoreAfterCrash(ExitT::kCrashed, -1));
+}
+
+TEST(CrashAutoRestorePolicyTest, CleanExitClearsTheCounterAtStartup) {
+  EXPECT_TRUE(ShouldResetCountAtStartup(ExitT::kClean, 1));
+  EXPECT_FALSE(ShouldResetCountAtStartup(ExitT::kClean, 0));
+  EXPECT_FALSE(ShouldResetCountAtStartup(ExitT::kCrashed, 1));
+  // Forced shutdown leaves the counter alone -- it says nothing about whether
+  // the previous run was healthy.
+  EXPECT_FALSE(ShouldResetCountAtStartup(ExitT::kForcedShutdown, 1));
+}
+
+TEST(CrashAutoRestorePolicyTest, AHealthyRunClearsTheCounter) {
+  const base::TimeDelta healthy = kDefaultHealthyAfter;
+  EXPECT_FALSE(ShouldResetCountAfterUptime(healthy - base::Seconds(1), healthy, 1));
+  EXPECT_TRUE(ShouldResetCountAfterUptime(healthy, healthy, 1));
+  EXPECT_TRUE(ShouldResetCountAfterUptime(healthy + base::Hours(2), healthy, 1));
+  // Nothing to do when the counter is already clear.
+  EXPECT_FALSE(ShouldResetCountAfterUptime(healthy + base::Hours(2), healthy, 0));
+}
+
+TEST(CrashAutoRestorePolicyTest, HealthyAfterIsAParameter) {
+  // The duration is injected so the timer can be exercised without waiting a
+  // real minute.
+  const base::TimeDelta healthy = base::Milliseconds(10);
+  EXPECT_FALSE(ShouldResetCountAfterUptime(base::Milliseconds(9), healthy, 1));
+  EXPECT_TRUE(ShouldResetCountAfterUptime(base::Milliseconds(10), healthy, 1));
+}
+
+TEST(CrashAutoRestorePolicyTest, CountWrittenWhenTheBranchIsTaken) {
+  EXPECT_EQ(1, kCountAfterAutoRestore);
+  EXPECT_FALSE(
+      ShouldAutoRestoreAfterCrash(ExitT::kCrashed, kCountAfterAutoRestore));
+}
+
+}  // namespace
+}  // namespace helium_workspace
