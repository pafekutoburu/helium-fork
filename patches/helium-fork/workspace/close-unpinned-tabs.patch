+namespace {
+
+// The id of TabRestoreService's most recent entry, or InvalidValue() when it
+// has none. Undo rewinds to whatever this was before the command ran.
+SessionID RestoreWatermark(sessions::TabRestoreService* service) {
+  if (!service || service->entries().empty()) {
+    return SessionID::InvalidValue();
+  }
+  return service->entries().front()->id;
+}
+
+}  // namespace
+
+void WorkspaceTabController::CloseUnpinnedTabs() {
+  WorkspaceService* const service = service_;
+  if (!service) {
+    return;
+  }
+  // SampleWindow() reads the whole strip, entry tabs included -- the plan
+  // functions need every tab to reason about emptying the window.
+  const ArchivePlan plan =
+      PlanCloseUnpinned(SampleWindow(browser_window_, *service));
+  if (plan.to_close.empty()) {
+    // A window holding nothing but sidebar entries. Do nothing at all: no
+    // toast, no stray new tab.
+    return;
+  }
+
+  // Taken before anything closes. Closing tabs one at a time files one
+  // TabRestoreService entry each, so the reopen-closed-tab accelerator would
+  // have to be pressed once per tab; this watermark is what lets one Undo
+  // put the whole gesture back.
+  undo_watermark_ = RestoreWatermark(
+      TabRestoreServiceFactory::GetForProfile(browser_window_->GetProfile()));
+
+  ExecuteArchivePlan(browser_window_, plan);
+
+  // The offer to put them back goes at the bottom of the sidebar, where the
+  // tabs were (user 2026-08-26). It reads its own count from
+  // TabRestoreService rather than being told one, so tabs that close
+  // asynchronously are included as they land.
+  if (BrowserView* const browser_view =
+          BrowserView::GetBrowserViewForBrowser(browser_window_)) {
+    if (VerticalTabStripRegionView* const region =
+            browser_view->vertical_tab_strip_region_view()) {
+      region->ShowUndoBarForWatermark(undo_watermark_);
+    }
+  }
+}
+
+void WorkspaceTabController::UndoLastCloseUnpinnedTabs() {
+  sessions::TabRestoreService* const service =
+      TabRestoreServiceFactory::GetForProfile(browser_window_->GetProfile());
+  if (!service) {
+    return;
+  }
+  const SessionID watermark = undo_watermark_;
+  undo_watermark_ = SessionID::InvalidValue();
+
+  // chrome::RestoreTab is what the reopen-closed-tab accelerator runs,
+  // including its handling of a service that has not finished loading.
+  // Rewind until the most recent entry is the one that was most recent
+  // before the command ran.
+  while (RestoreWatermark(service) != watermark) {
+    const size_t before = service->entries().size();
+    chrome::RestoreTab(browser_window_);
+    if (service->entries().size() >= before) {
+      // Nothing was consumed -- the service may still be loading, or the
+      // entry could not be restored. Stop rather than spin.
+      break;
+    }
+  }
+}
