+#include "ui/views/view.h"
+
+class BrowserWindowInterface;
+
+namespace views {
+class Label;
+class LabelButton;
+}  // namespace views
+
+// helium-fork M4-r1: "N tabs closed · Undo", at the bottom of the sidebar.
+//
+// This replaces the toast that used to appear at the top-right of the
+// window. The user asked for it here (2026-08-26): it is where the tabs
+// were, so it is where the offer to put them back belongs, and it is far
+// more noticeable than a corner toast.
+//
+// Two things it deliberately does not do:
+//
+//  - It never counts closes itself. Tabs whose pages have unload handlers
+//    close asynchronously, well after the command returns, so any number
+//    taken at that moment is wrong (and being wrong there is what made the
+//    old Undo reach back into an earlier run). Instead it watches
+//    TabRestoreService and reports how many entries have appeared since the
+//    watermark, which is right whenever it is asked.
+//
+//  - It never changes the layout while fading. Visibility flips once at
+//    each end of the fade and the animation drives layer opacity only --
+//    the same shape HeliumMediaStripView uses. Anything else would run
+//    InvalidateLayout() every frame, and that marks all the way up to the
+//    RootView.
+class HeliumUndoBarView : public views::View,
+                          public views::AnimationDelegateViews,
+                          public sessions::TabRestoreServiceObserver {
+  METADATA_HEADER(HeliumUndoBarView, views::View)
+
+ public:
+  explicit HeliumUndoBarView(BrowserWindowInterface* browser);
+  HeliumUndoBarView(const HeliumUndoBarView&) = delete;
+  HeliumUndoBarView& operator=(const HeliumUndoBarView&) = delete;
+  ~HeliumUndoBarView() override;
+
+  // Shows the bar for the tabs closed since |watermark| (the id of what was
+  // TabRestoreService's most recent entry before the command ran, or an
+  // invalid id if it had none).
+  void ShowForWatermark(SessionID watermark);
+
+  // Hides it early -- after Undo is pressed, or when the window changes out
+  // from under it.
+  void Dismiss();
+
+  bool IsShowing() const { return shown_; }
+
+ private:
+  void SetShown(bool shown);
+  int ClosedSinceWatermark() const;
+  void UpdateLabel();
+  void OnUndoPressed();
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void Layout(PassKey) override;
+  void OnPaintBackground(gfx::Canvas* canvas) override;
+  void OnThemeChanged() override;
+
+  // views::AnimationDelegateViews:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+  // sessions::TabRestoreServiceObserver:
+  void TabRestoreServiceChanged(sessions::TabRestoreService* service) override;
+  void TabRestoreServiceDestroyed(
+      sessions::TabRestoreService* service) override;
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<views::Label> label_ = nullptr;
+  raw_ptr<views::LabelButton> undo_button_ = nullptr;
+
+  SessionID watermark_ = SessionID::InvalidValue();
+  bool shown_ = false;
+  base::OneShotTimer dismiss_timer_;
+  gfx::SlideAnimation shown_animation_{this};
+
+  base::ScopedObservation<sessions::TabRestoreService,
+                          sessions::TabRestoreServiceObserver>
+      restore_observation_{this};
+};
