+
+namespace {
+
+// The toast this replaces stayed up for eight seconds when it carried an
+// action button; keeping that means the two never felt different.
+constexpr base::TimeDelta kDismissDelay = base::Seconds(8);
+
+constexpr int kFadeMs = 200;
+constexpr int kHorizontalInset = 10;
+
+}  // namespace
+
+HeliumUndoBarView::HeliumUndoBarView(BrowserWindowInterface* browser)
+    : views::AnimationDelegateViews(this), browser_(browser) {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  layer()->SetOpacity(0.0f);
+  SetVisible(false);
+
+  shown_animation_.SetSlideDuration(base::Milliseconds(kFadeMs));
+
+  label_ = AddChildView(std::make_unique<views::Label>());
+  label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label_->SetAutoColorReadabilityEnabled(false);
+  // ⛔ Subpixel text may only be drawn onto an opaque surface, and Label
+  // DCHECKs it (label.cc, PaintText). This bar owns a layer that spends the
+  // fade at partial opacity, so it never qualifies -- leaving this on
+  // aborted the browser the first time the bar was shown. The media capsule
+  // beside it is in the same position for the same reason.
+  label_->SetSubpixelRenderingEnabled(false);
+
+  undo_button_ = AddChildView(std::make_unique<views::LabelButton>(
+      base::BindRepeating(&HeliumUndoBarView::OnUndoPressed,
+                          base::Unretained(this)),
+      l10n_util::GetStringUTF16(IDS_HELIUM_UNPINNED_TABS_CLOSED_UNDO)));
+  undo_button_->SetHorizontalAlignment(gfx::ALIGN_RIGHT);
+  undo_button_->SetTextSubpixelRenderingEnabled(false);
+
+  if (sessions::TabRestoreService* const service =
+          TabRestoreServiceFactory::GetForProfile(browser_->GetProfile())) {
+    restore_observation_.Observe(service);
+  }
+}
+
+HeliumUndoBarView::~HeliumUndoBarView() = default;
+
+void HeliumUndoBarView::ShowForWatermark(SessionID watermark) {
+  watermark_ = watermark;
+  UpdateLabel();
+  SetShown(true);
+  dismiss_timer_.Start(FROM_HERE, kDismissDelay,
+                       base::BindOnce(&HeliumUndoBarView::Dismiss,
+                                      base::Unretained(this)));
+}
+
+void HeliumUndoBarView::Dismiss() {
+  dismiss_timer_.Stop();
+  SetShown(false);
+}
+
+void HeliumUndoBarView::SetShown(bool shown) {
+  if (shown_ == shown) {
+    return;
+  }
+  shown_ = shown;
+  if (shown) {
+    // Visible from the first frame; the fade is opacity only, so the one
+    // layout change happens exactly here.
+    SetVisible(true);
+    shown_animation_.Show();
+  } else {
+    shown_animation_.Hide();
+  }
+}
+
+int HeliumUndoBarView::ClosedSinceWatermark() const {
+  sessions::TabRestoreService* const service =
+      TabRestoreServiceFactory::GetForProfile(browser_->GetProfile());
+  if (!service) {
+    return 0;
+  }
+  int count = 0;
+  for (const auto& entry : service->entries()) {
+    if (entry->id == watermark_) {
+      break;
+    }
+    ++count;
+  }
+  return count;
+}
+
+void HeliumUndoBarView::UpdateLabel() {
+  label_->SetText(l10n_util::GetPluralStringFUTF16(
+      IDS_HELIUM_UNPINNED_TABS_CLOSED_BODY, ClosedSinceWatermark()));
+}
+
+void HeliumUndoBarView::OnUndoPressed() {
+  if (helium_workspace::WorkspaceTabController* const controller =
+          helium_workspace::WorkspaceTabController::From(browser_)) {
+    controller->UndoLastCloseUnpinnedTabs();
+  }
+  Dismiss();
+}
+
+gfx::Size HeliumUndoBarView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  // Same height as the media capsule below it, so the sidebar's bottom edge
+  // keeps one rhythm. Width comes from the sidebar; the flex spec is
+  // preferred/preferred, so this view neither shrinks nor grows and the
+  // space is taken from the bottom container's slack -- the new tab button
+  // above it does not move.
+  return gfx::Size(0, helium::kMediaStripRowHeight);
+}
+
+void HeliumUndoBarView::Layout(PassKey) {
+  const int undo_width =
+      undo_button_->GetPreferredSize(views::SizeBounds()).width();
+  const int available = std::max(0, width() - 2 * kHorizontalInset);
+  const int label_width = std::max(0, available - undo_width);
+  label_->SetBounds(kHorizontalInset, 0, label_width, height());
+  undo_button_->SetBounds(kHorizontalInset + label_width, 0,
+                          std::min(undo_width, available), height());
+}
+
+void HeliumUndoBarView::OnPaintBackground(gfx::Canvas* canvas) {
+  const ui::ColorProvider* const provider = GetColorProvider();
+  const SkColor sidebar =
+      provider ? provider->GetColor(kColorToolbar) : SK_ColorWHITE;
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(helium::GetSidebarFloatingCardColor(sidebar));
+  canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()),
+                        helium::kMediaStripCornerRadius, flags);
+}
+
+void HeliumUndoBarView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  if (const ui::ColorProvider* const provider = GetColorProvider()) {
+    label_->SetEnabledColor(provider->GetColor(kColorTabForegroundActiveFrameActive));
+  }
+}
+
+void HeliumUndoBarView::AnimationProgressed(const gfx::Animation* animation) {
+  layer()->SetOpacity(static_cast<float>(animation->GetCurrentValue()));
+}
+
+void HeliumUndoBarView::AnimationEnded(const gfx::Animation* animation) {
+  layer()->SetOpacity(static_cast<float>(animation->GetCurrentValue()));
+  if (animation->GetCurrentValue() == 0.0) {
+    SetVisible(false);
+  }
+}
+
+void HeliumUndoBarView::TabRestoreServiceChanged(
+    sessions::TabRestoreService* service) {
+  // Asynchronously-closed tabs land here, after the command returned. This
+  // is why the count is read from the service and never carried.
+  if (shown_) {
+    UpdateLabel();
+  }
+}
+
+void HeliumUndoBarView::TabRestoreServiceDestroyed(
+    sessions::TabRestoreService* service) {
+  restore_observation_.Reset();
+}
+
