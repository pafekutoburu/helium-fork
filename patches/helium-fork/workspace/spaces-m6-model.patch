+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/sessions/helium_session_tab_extra_data.h"
+
+#include "content/public/browser/web_contents.h"
+
+HeliumSessionTabExtraData::HeliumSessionTabExtraData(
+    content::WebContents* contents)
+    : content::WebContentsUserData<HeliumSessionTabExtraData>(*contents) {}
+
+HeliumSessionTabExtraData::~HeliumSessionTabExtraData() = default;
+
+// static
+void HeliumSessionTabExtraData::Set(content::WebContents* contents,
+                                    const std::string& key,
+                                    const std::string& value) {
+  if (!contents) {
+    return;
+  }
+  CreateForWebContents(contents);
+  FromWebContents(contents)->entries_[key] = value;
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(HeliumSessionTabExtraData);
