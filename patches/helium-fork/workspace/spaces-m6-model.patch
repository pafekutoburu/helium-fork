+
+// Same rule as the entry bindings: a handle whose tab is gone is non-Null
+// but must answer "nothing", or its stale tag keeps a ghost in the filters.
+TEST_F(WorkspaceServiceTest, TabSpaceTagIgnoresDeadHandles) {
+  const std::string work = service_->AddSpace(u"Work", "", kDefaultSpaceId);
+  std::unique_ptr<tabs::MockTabInterface> tab =
+      MakeTab("https://a.example/", window_a());
+  const tabs::TabHandle handle = tab->GetHandle();
+
+  EXPECT_FALSE(service_->HasTabSpaceTag(handle));
+  EXPECT_TRUE(service_->GetSpaceForTab(handle).empty());
+  EXPECT_TRUE(service_->IsTabInSpace(handle, kDefaultSpaceId));
+
+  service_->SetTabSpace(handle, work);
+  EXPECT_TRUE(service_->HasTabSpaceTag(handle));
+  EXPECT_EQ(work, service_->GetSpaceForTab(handle));
+  EXPECT_TRUE(service_->IsTabInSpace(handle, work));
+  EXPECT_FALSE(service_->IsTabInSpace(handle, kDefaultSpaceId));
+
+  tab.reset();
+  EXPECT_FALSE(service_->HasTabSpaceTag(handle));
+  EXPECT_TRUE(service_->GetSpaceForTab(handle).empty());
+  EXPECT_TRUE(service_->IsTabInSpace(handle, kDefaultSpaceId));
+}
+
+// Arc g8c: a favorite's tab stays the active tab across a space switch, so
+// it belongs to every space. Demoting the favorite into a space makes the
+// tab that space's.
+TEST_F(WorkspaceServiceTest, FavoriteBoundTabReportsTheGlobalSpace) {
+  const std::string work = service_->AddSpace(u"Work", "", kDefaultSpaceId);
+  const std::string fav = service_->AddEntry(
+      WorkspaceEntry::Section::kFavorite, GURL("https://f.example/"), u"F",
+      kDefaultSpaceId);
+  std::unique_ptr<tabs::MockTabInterface> tab =
+      MakeTab("https://f.example/", window_a());
+  const tabs::TabHandle handle = tab->GetHandle();
+  service_->SetTabSpace(handle, kDefaultSpaceId);
+  service_->BindTab(handle, fav);
+
+  EXPECT_EQ(kGlobalSpaceId, service_->GetSpaceForTab(handle));
+  EXPECT_TRUE(service_->IsTabInSpace(handle, kDefaultSpaceId));
+  EXPECT_TRUE(service_->IsTabInSpace(handle, work));
+
+  // DemotedFavoriteLandsInTheGivenSpace: the space the user is looking at.
+  ASSERT_TRUE(service_->SetEntrySection(fav, WorkspaceEntry::Section::kPinned,
+                                        work));
+  EXPECT_EQ(work, service_->FindEntryById(fav)->space_id);
+  EXPECT_EQ(0, service_->FindEntryById(fav)->position);
+  EXPECT_EQ(work, service_->GetSpaceForTab(handle));
+  EXPECT_FALSE(service_->IsTabInSpace(handle, kDefaultSpaceId));
+
+  // Unpinning drops the binding but not the tab's own tag: the tab stays in
+  // the space it was opened in rather than showing up everywhere.
+  ASSERT_TRUE(service_->RemoveEntry(fav));
+  EXPECT_EQ(kDefaultSpaceId, service_->GetSpaceForTab(handle));
+}
+
+TEST_F(WorkspaceServiceTest, RemoveSpaceTakesItsEntriesAndRestorePutsThemBack) {
+  const std::string work = service_->AddSpace(u"Work", "", kDefaultSpaceId);
+  const std::string home = service_->AddEntry(
+      WorkspaceEntry::Section::kPinned, GURL("https://h.example/"), u"H",
+      kDefaultSpaceId);
+  const std::string folder = service_->AddFolder(u"F", work);
+  const std::string a = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://a.example/"), u"A",
+                                           work);
+  ASSERT_TRUE(service_->MoveEntryToFolder(a, folder, 0));
+  const std::string b = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://b.example/"), u"B",
+                                           work);
+  std::unique_ptr<tabs::MockTabInterface> tab =
+      MakeTab("https://b.example/", window_a());
+  service_->SetTabSpace(tab->GetHandle(), work);
+  service_->BindTab(tab->GetHandle(), b);
+
+  const std::optional<WorkspaceService::RemovedSpace> removed =
+      service_->RemoveSpace(work);
+  ASSERT_TRUE(removed.has_value());
+  EXPECT_EQ(work, removed->space.id);
+  EXPECT_EQ(1, removed->space.position);
+  EXPECT_THAT(SpaceShape(*service_), ElementsAre(kDefaultSpaceId));
+  EXPECT_THAT(PinnedShape(*service_), ElementsAre(home));
+  ASSERT_EQ(3u, removed->entries.size());
+  EXPECT_EQ(folder, removed->entries[0].id);
+  EXPECT_FALSE(service_->IsWorkspaceTab(tab->GetHandle()));
+  EXPECT_TRUE(service_->GetSpaceForTab(tab->GetHandle()).empty());
+
+  // The last space cannot go.
+  EXPECT_FALSE(service_->RemoveSpace(kDefaultSpaceId).has_value());
+
+  ASSERT_TRUE(service_->RestoreSpace(*removed));
+  EXPECT_THAT(SpaceShape(*service_), ElementsAre(kDefaultSpaceId, work));
+  EXPECT_THAT(PinnedShapeIn(*service_, work),
+              ElementsAre(folder, folder + "/" + a, b));
+  EXPECT_FALSE(service_->RestoreSpace(*removed));  // already back
+}
+
 }  // namespace
 }  // namespace helium_workspace
