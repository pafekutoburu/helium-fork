+
+bool WorkspaceService::MoveSpace(const std::string& id, size_t target_index) {
+  const auto source = std::ranges::find_if(
+      spaces_, [&](const WorkspaceSpace& s) { return s.id == id; });
+  if (source == spaces_.end()) {
+    return false;
+  }
+  WorkspaceSpace moved = std::move(*source);
+  spaces_.erase(source);
+  const size_t slot = std::min(target_index, spaces_.size());
+  spaces_.insert(spaces_.begin() + static_cast<std::ptrdiff_t>(slot),
+                 std::move(moved));
+  for (size_t i = 0; i < spaces_.size(); ++i) {
+    spaces_[i].position = static_cast<int>(i);
+  }
+  SortEntries();
+  PersistSpacesToPrefs();
+  NotifySpacesChanged();
+  NotifyChanged();
+  return true;
+}
+
+std::optional<WorkspaceService::RemovedSpace> WorkspaceService::RemoveSpace(
+    const std::string& id) {
+  const auto source = std::ranges::find_if(
+      spaces_, [&](const WorkspaceSpace& s) { return s.id == id; });
+  if (source == spaces_.end() || spaces_.size() <= 1) {
+    return std::nullopt;  // unknown, or the last space stays
+  }
+  RemovedSpace removed;
+  removed.space = *source;
+  spaces_.erase(source);
+  // entries_ is in display order, so the snapshot already reads folder
+  // first, children after -- what RestoreEntries wants.
+  for (const WorkspaceEntry& entry : entries_) {
+    if (entry.section == WorkspaceEntry::Section::kPinned &&
+        entry.space_id == id) {
+      removed.entries.push_back(entry);
+    }
+  }
+  std::erase_if(entries_, [&](const WorkspaceEntry& e) {
+    return e.section == WorkspaceEntry::Section::kPinned && e.space_id == id;
+  });
+  for (const WorkspaceEntry& entry : removed.entries) {
+    std::erase_if(tab_to_entry_, [&](const auto& pair) {
+      return pair.second == entry.id;
+    });
+  }
+  // A tag naming a space that no longer exists would hide its tab in every
+  // space; untagged shows everywhere, which is the safe side until the
+  // controller re-homes or closes those tabs.
+  std::erase_if(tab_to_space_,
+                [&](const auto& pair) { return pair.second == id; });
+  // Favorites keep their dormant space_id; ResolveSpaceId covers a stale one
+  // the next time they are demoted.
+  SortAndRenumberSpaces();
+  SortEntries();
+  PersistSpacesToPrefs();
+  PersistToPrefs();
+  NotifyBindingsChanged();
+  NotifySpacesChanged();
+  NotifyChanged();
+  return removed;
+}
+
+bool WorkspaceService::RestoreSpace(const RemovedSpace& snapshot) {
+  if (snapshot.space.id.empty() || FindSpaceById(snapshot.space.id)) {
+    return false;
+  }
+  for (const WorkspaceEntry& entry : snapshot.entries) {
+    if (FindEntryById(entry.id)) {
+      return false;
+    }
+  }
+  const size_t slot =
+      std::min(static_cast<size_t>(std::max(snapshot.space.position, 0)),
+               spaces_.size());
+  spaces_.insert(spaces_.begin() + static_cast<std::ptrdiff_t>(slot),
+                 snapshot.space);
+  for (size_t i = 0; i < spaces_.size(); ++i) {
+    spaces_[i].position = static_cast<int>(i);
+  }
+  for (const WorkspaceEntry& entry : snapshot.entries) {
+    entries_.push_back(entry);
+  }
+  SortEntries();
+  PersistSpacesToPrefs();
+  PersistToPrefs();
+  NotifySpacesChanged();
+  NotifyChanged();
+  return true;
+}
