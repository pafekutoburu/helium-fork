+// ---- M6 Spaces ----
+
+// Space ids in bar order.
+std::vector<std::string> SpaceShape(const WorkspaceService& service) {
+  std::vector<std::string> shape;
+  for (const WorkspaceSpace& space : service.spaces()) {
+    shape.push_back(space.id);
+  }
+  return shape;
+}
+
+// Pinned entry ids of one space, in display order.
+std::vector<std::string> PinnedShapeIn(const WorkspaceService& service,
+                                       const std::string& space_id) {
+  std::vector<std::string> shape;
+  for (const WorkspaceEntry& entry : service.entries()) {
+    if (entry.section == WorkspaceEntry::Section::kPinned &&
+        entry.space_id == space_id) {
+      shape.push_back(entry.folder_id.empty()
+                          ? entry.id
+                          : entry.folder_id + "/" + entry.id);
+    }
+  }
+  return shape;
+}
+
+// A pre-M6 profile has entries but no spaces list. Every one of those entries
+// carries space_id "default", so the minted space must have exactly that id
+// -- and it must be persisted, or the next start would mint it again.
+TEST_F(WorkspaceServiceTest, LoadCreatesADefaultSpaceWhenNoneExist) {
+  EXPECT_THAT(SpaceShape(*service_), ElementsAre(kDefaultSpaceId));
+  EXPECT_EQ(kDefaultSpaceId, service_->FirstSpaceId());
+  EXPECT_EQ(u"Personal", service_->spaces()[0].name);
+  EXPECT_TRUE(service_->spaces()[0].icon.empty());
+  EXPECT_EQ(1u, prefs_.GetList(prefs::kWorkspaceSpaces).size());
+
+  WorkspaceService reloaded(&prefs_, u"Other");
+  EXPECT_THAT(SpaceShape(reloaded), ElementsAre(kDefaultSpaceId));
+  EXPECT_EQ(u"Personal", reloaded.spaces()[0].name);
+}
+
+// Arc lands a new space right of the current one, not at the end (轮0
+// g2b/g2c: 📦🤩🎨🎬🍏 -> 📦🤩🎨😀🎬🍏).
+TEST_F(WorkspaceServiceTest, AddSpaceInsertsAfterTheGivenSpace) {
+  const std::string a = service_->AddSpace(u"A", "", kDefaultSpaceId);
+  const std::string b = service_->AddSpace(u"B", "🎨", kDefaultSpaceId);
+  const std::string c = service_->AddSpace(u"C", "", "no-such-space");
+  EXPECT_THAT(SpaceShape(*service_), ElementsAre(kDefaultSpaceId, b, a, c));
+  for (size_t i = 0; i < service_->spaces().size(); ++i) {
+    EXPECT_EQ(static_cast<int>(i), service_->spaces()[i].position);
+  }
+  ASSERT_TRUE(service_->FindSpaceById(b));
+  EXPECT_EQ("🎨", service_->FindSpaceById(b)->icon);
+
+  ASSERT_TRUE(service_->MoveSpace(c, 0));
+  EXPECT_THAT(SpaceShape(*service_), ElementsAre(c, kDefaultSpaceId, b, a));
+}
+
+TEST_F(WorkspaceServiceTest, SpacesRoundTripThroughPrefs) {
+  const std::string work = service_->AddSpace(u"Work", "🎨", kDefaultSpaceId);
+  ASSERT_TRUE(service_->RenameSpace(work, u"Job"));
+  ASSERT_TRUE(service_->SetSpaceCollapsed(work, true));
+  ASSERT_TRUE(service_->SetSpaceIcon(kDefaultSpaceId, "🏠"));
+  service_->Shutdown();
+
+  WorkspaceService reloaded(&prefs_, u"Personal");
+  EXPECT_THAT(SpaceShape(reloaded), ElementsAre(kDefaultSpaceId, work));
+  ASSERT_TRUE(reloaded.FindSpaceById(work));
+  EXPECT_EQ(u"Job", reloaded.FindSpaceById(work)->name);
+  EXPECT_EQ("🎨", reloaded.FindSpaceById(work)->icon);
+  EXPECT_TRUE(reloaded.FindSpaceById(work)->collapsed);
+  EXPECT_EQ("🏠", reloaded.FindSpaceById(kDefaultSpaceId)->icon);
+}
+
+// Display order is space by space in bar order, and positions are dense
+// within each space's pinned top level -- the sidebar's drop index counts
+// the rows of one space, so this is what MoveEntry's scope must match.
+TEST_F(WorkspaceServiceTest, PositionsAreUniqueWithinASpace) {
+  const std::string work = service_->AddSpace(u"Work", "", kDefaultSpaceId);
+  std::vector<std::string> home_ids;
+  std::vector<std::string> work_ids;
+  for (int i = 0; i < 3; ++i) {
+    home_ids.push_back(service_->AddEntry(
+        WorkspaceEntry::Section::kPinned,
+        GURL("https://home.example/" + base::NumberToString(i)), u"H",
+        kDefaultSpaceId));
+    work_ids.push_back(service_->AddEntry(
+        WorkspaceEntry::Section::kPinned,
+        GURL("https://work.example/" + base::NumberToString(i)), u"W",
+        work));
+  }
+  EXPECT_THAT(PinnedShape(*service_),
+              ElementsAre(home_ids[0], home_ids[1], home_ids[2], work_ids[0],
+                          work_ids[1], work_ids[2]));
+  for (const std::string& id : {home_ids[1], work_ids[1]}) {
+    EXPECT_EQ(1, service_->FindEntryById(id)->position);
+  }
+  EXPECT_EQ(2, service_->FindEntryById(work_ids[2])->position);
+
+  // Bar order drives display order.
+  ASSERT_TRUE(service_->MoveSpace(work, 0));
+  EXPECT_THAT(PinnedShape(*service_),
+              ElementsAre(work_ids[0], work_ids[1], work_ids[2], home_ids[0],
+                          home_ids[1], home_ids[2]));
+
+  // An unknown space resolves to the first space instead of nowhere.
+  const std::string stray = service_->AddEntry(
+      WorkspaceEntry::Section::kPinned, GURL("https://stray.example/"), u"S",
+      "no-such-space");
+  EXPECT_EQ(service_->FirstSpaceId(), service_->FindEntryById(stray)->space_id);
+}
+
+// The defect the per-space scope exists for: index 0 "among what I can see"
+// must never reorder another space's rows.
+TEST_F(WorkspaceServiceTest, MovingAnEntryInOneSpaceLeavesAnotherAlone) {
+  const std::string work = service_->AddSpace(u"Work", "", kDefaultSpaceId);
+  const std::string a = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://a.example/"), u"A",
+                                           kDefaultSpaceId);
+  const std::string b = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://b.example/"), u"B",
+                                           kDefaultSpaceId);
+  const std::string c = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://c.example/"), u"C",
+                                           kDefaultSpaceId);
+  const std::string x = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://x.example/"), u"X",
+                                           work);
+  const std::string y = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://y.example/"), u"Y",
+                                           work);
+
+  ASSERT_TRUE(service_->MoveEntry(c, WorkspaceEntry::Section::kPinned, 0));
+  EXPECT_THAT(PinnedShapeIn(*service_, kDefaultSpaceId), ElementsAre(c, a, b));
+  EXPECT_THAT(PinnedShapeIn(*service_, work), ElementsAre(x, y));
+  EXPECT_EQ(0, service_->FindEntryById(x)->position);
+  EXPECT_EQ(1, service_->FindEntryById(y)->position);
+
+  // Retargeting the space (round 3's Move to) lands at the index there.
+  ASSERT_TRUE(service_->MoveEntry(a, WorkspaceEntry::Section::kPinned, 1, work));
+  EXPECT_THAT(PinnedShapeIn(*service_, kDefaultSpaceId), ElementsAre(c, b));
+  EXPECT_THAT(PinnedShapeIn(*service_, work), ElementsAre(x, a, y));
+  EXPECT_EQ(work, service_->FindEntryById(a)->space_id);
+}
+
+TEST_F(WorkspaceServiceTest, DanglingSpaceIdFallsBackToTheFirstSpace) {
+  const std::string work = service_->AddSpace(u"Work", "", kDefaultSpaceId);
+  const std::string a = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://a.example/"), u"A",
+                                           work);
+  service_->Shutdown();
+
+  // The space vanishes from the raw pref (a newer build's format rejected,
+  // or a delete that never got to rewrite the entries).
+  {
+    ScopedListPrefUpdate update(&prefs_, prefs::kWorkspaceSpaces);
+    update->EraseIf([&](const base::Value& value) {
+      const std::string* id = value.GetDict().FindString("id");
+      return id && *id == work;
+    });
+  }
+
+  WorkspaceService reloaded(&prefs_, u"Personal");
+  EXPECT_THAT(SpaceShape(reloaded), ElementsAre(kDefaultSpaceId));
+  ASSERT_TRUE(reloaded.FindEntryById(a));
+  EXPECT_EQ(kDefaultSpaceId, reloaded.FindEntryById(a)->space_id);
+}
+
+// A folder child's space is its folder's: set on the way in, and repaired
+// on load if the pref disagrees.
+TEST_F(WorkspaceServiceTest, FolderChildInheritsItsFoldersSpace) {
+  const std::string work = service_->AddSpace(u"Work", "", kDefaultSpaceId);
+  const std::string folder = service_->AddFolder(u"F", work);
+  const std::string a = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://a.example/"), u"A",
+                                           kDefaultSpaceId);
