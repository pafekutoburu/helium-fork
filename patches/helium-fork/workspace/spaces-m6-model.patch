+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_SESSIONS_HELIUM_SESSION_TAB_EXTRA_DATA_H_
+#define CHROME_BROWSER_SESSIONS_HELIUM_SESSION_TAB_EXTRA_DATA_H_
+
+#include <map>
+#include <string>
+
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+// helium-fork M6-r1: per-tab session extra_data that has to survive a rebuild
+// of the session file.
+//
+// SessionService::AddTabExtraData() only appends a command. Whenever the
+// service rebuilds the file from the live browsers (startup, a window
+// closing, RebuildCommandsIfRequired), SessionServiceBase::BuildCommandsForTab
+// re-emits navigation, pin state, group, app id -- and no extra_data at all,
+// so anything written through AddTabExtraData() is gone after the next
+// rebuild. Measured on the user's profile 2026-09-03: the newest Session_
+// file held 9 tabs and zero "helium.space" commands, which is how every
+// space's Today tabs landed in the last-used space after a restart.
+//
+// Writers park their key/value here as well; BuildCommandsForTab re-emits
+// everything in it. The map is the tab's, so it also follows a tab across
+// windows.
+class HeliumSessionTabExtraData
+    : public content::WebContentsUserData<HeliumSessionTabExtraData> {
+ public:
+  ~HeliumSessionTabExtraData() override;
+
+  // Creates the holder on first use.
+  static void Set(content::WebContents* contents,
+                  const std::string& key,
+                  const std::string& value);
+
+  const std::map<std::string, std::string>& entries() const {
+    return entries_;
+  }
+
+ private:
+  friend class content::WebContentsUserData<HeliumSessionTabExtraData>;
+
+  explicit HeliumSessionTabExtraData(content::WebContents* contents);
+
+  std::map<std::string, std::string> entries_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CHROME_BROWSER_SESSIONS_HELIUM_SESSION_TAB_EXTRA_DATA_H_
