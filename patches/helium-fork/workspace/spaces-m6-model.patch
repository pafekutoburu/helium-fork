+// step is L 33.6 -> 39.0, +5.4; walking the light sidebar (L228 = L* 90.6)
+// the same distance the other way lands at L* 85.2 ≈ RGB 213, which is
+// black at ≈0.066 over 228. Acceptance-tunable.
+inline SkColor GetSidebarCurrentSpaceSurfaceColor(SkColor sidebar) {
+  return color_utils::IsDark(sidebar)
+             ? color_utils::AlphaBlend(SK_ColorWHITE, sidebar, 0.074f)
+             : color_utils::AlphaBlend(SK_ColorBLACK, sidebar, 0.066f);
+}
