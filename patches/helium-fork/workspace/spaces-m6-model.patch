+std::vector<tabs::TabHandle> WorkspaceService::FindTabsInSpace(
+    const std::string& space_id) const {
+  std::vector<tabs::TabHandle> tabs;
+  if (space_id.empty()) {
+    return tabs;
+  }
+  // Both maps: a tab bound to a pinned entry answers the entry's space and
+  // may carry a stale raw tag; a Today tab has only the raw tag.
+  for (const auto& [handle, entry_id] : tab_to_entry_) {
+    if (handle.Get() && GetSpaceForTab(handle) == space_id) {
+      tabs.push_back(handle);
+    }
+  }
+  for (const auto& [handle, tag] : tab_to_space_) {
+    if (handle.Get() && !tab_to_entry_.contains(handle) &&
+        GetSpaceForTab(handle) == space_id) {
+      tabs.push_back(handle);
+    }
+  }
+  return tabs;
+}
