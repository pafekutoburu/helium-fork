@@ -0,0 +1,61 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_space.h"
+
+#include "base/strings/utf_string_conversions.h"
+
+namespace helium_workspace {
+
+namespace {
+
+constexpr char kKeyId[] = "id";
+constexpr char kKeyName[] = "name";
+constexpr char kKeyIcon[] = "icon";
+constexpr char kKeyPosition[] = "position";
+constexpr char kKeyCollapsed[] = "collapsed";
+constexpr char kKeyVersion[] = "version";
+
+}  // namespace
+
+WorkspaceSpace::WorkspaceSpace() = default;
+WorkspaceSpace::WorkspaceSpace(const WorkspaceSpace&) = default;
+WorkspaceSpace& WorkspaceSpace::operator=(const WorkspaceSpace&) = default;
+WorkspaceSpace::~WorkspaceSpace() = default;
+
+base::DictValue WorkspaceSpace::ToValue() const {
+  base::DictValue dict;
+  dict.Set(kKeyId, id);
+  dict.Set(kKeyName, name);
+  dict.Set(kKeyIcon, icon);
+  dict.Set(kKeyPosition, position);
+  if (collapsed) {
+    dict.Set(kKeyCollapsed, true);
+  }
+  dict.Set(kKeyVersion, version);
+  return dict;
+}
+
+// static
+std::optional<WorkspaceSpace> WorkspaceSpace::FromValue(
+    const base::DictValue& dict) {
+  const std::string* id = dict.FindString(kKeyId);
+  if (!id || id->empty()) {
+    return std::nullopt;
+  }
+  WorkspaceSpace space;
+  space.id = *id;
+  if (const std::string* name = dict.FindString(kKeyName)) {
+    space.name = base::UTF8ToUTF16(*name);
+  }
+  if (const std::string* icon = dict.FindString(kKeyIcon)) {
+    space.icon = *icon;
+  }
+  space.position = dict.FindInt(kKeyPosition).value_or(0);
+  space.collapsed = dict.FindBool(kKeyCollapsed).value_or(false);
+  space.version = dict.FindInt(kKeyVersion).value_or(kCurrentVersion);
+  return space;
+}
+
+}  // namespace helium_workspace
