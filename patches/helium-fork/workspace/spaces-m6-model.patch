+std::string WorkspaceService::AddSpace(const std::u16string& name,
+                                       const std::string& icon,
+                                       const std::string& insert_after_id) {
+  WorkspaceSpace space;
+  space.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  space.name = name;
+  space.icon = icon;
+  // Right of |insert_after_id|: give it that slot + 1 and push everything
+  // from there on by one; SortAndRenumberSpaces makes the order official.
+  size_t slot = spaces_.size();
+  for (size_t i = 0; i < spaces_.size(); ++i) {
+    if (spaces_[i].id == insert_after_id) {
+      slot = i + 1;
+      break;
+    }
+  }
+  for (size_t i = slot; i < spaces_.size(); ++i) {
+    ++spaces_[i].position;
+  }
+  space.position = static_cast<int>(slot);
+  const std::string id = space.id;
+  spaces_.push_back(std::move(space));
+  SortAndRenumberSpaces();
+  SortEntries();
+  PersistSpacesToPrefs();
+  NotifySpacesChanged();
+  NotifyChanged();
+  return id;
+}
