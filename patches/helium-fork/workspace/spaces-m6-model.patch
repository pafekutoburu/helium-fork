+  // 1. What the space was looking at when the window last left it.
+  if (const auto it = last_active_by_space_.find(space_id);
+      it != last_active_by_space_.end()) {
+    tabs::TabInterface* const tab = it->second.Get();
+    if (tab && tab->GetBrowserWindowInterface() == browser_window_ &&
+        service_->GetSpaceForTab(it->second) == space_id && activate(tab)) {
+      return;
+    }
+  }
+  // 2. Its first tab in strip order -- a tab of its own, not a global or an
+  //    untagged one.
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* const tab = model->GetTabAtIndex(i);
+    if (tab && service_->GetSpaceForTab(tab->GetHandle()) == space_id &&
+        activate(tab)) {
+      return;
+    }
+  }
+  // 3. Nothing open here: a fresh new tab page, tagged to the space through
+  //    the kInserted handler (the same call DeleteFolder uses to keep a
+  //    window from emptying).
+  pending_space_tag_ = space_id;
+  chrome::AddTabAt(browser_window_, GURL(), /*index=*/-1, /*foreground=*/true);
+  pending_space_tag_.clear();
+  if (tabs::TabInterface* const active = model->GetActiveTab()) {
+    last_active_by_space_[space_id] = active->GetHandle();
+  }
