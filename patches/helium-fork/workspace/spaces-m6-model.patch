Index: src/chrome/browser/ui/helium_workspace/workspace_archive_policy_unittest.cc
===================================================================
--- src.orig/chrome/browser/ui/helium_workspace/workspace_archive_policy_unittest.cc
+++ src/chrome/browser/ui/helium_workspace/workspace_archive_policy_unittest.cc
@@ -390,5 +390,62 @@
   EXPECT_FALSE(plan.empties_window);
 }
 
+// ---- M6 spaces ------------------------------------------------------------
+
+// Cmd+Shift+K clears the Today the user is looking at. Tabs of other spaces
+// are alive in the same strip and must be left alone; a global (favorite)
+// tab and an untagged one belong everywhere and are still fair game -- but
+// kSidebarEntry keeps its precedence over kOtherSpace.
+TEST_F(WorkspaceArchivePolicyTest, CloseUnpinnedSparesOtherSpaces) {
+  std::vector<ArchiveTabState> tabs;
+  for (int i = 0; i < 5; ++i) {
+    tabs.push_back(Aged(base::Minutes(1)));
+  }
+  tabs[0].space_id = "home";
+  tabs[1].space_id = "work";
+  tabs[2].space_id = "";  // global / untagged
+  tabs[3].space_id = "work";
+  tabs[3].is_workspace_entry = true;
+  tabs[4].space_id = "home";
+  tabs[4].is_active = true;
+
+  EXPECT_EQ(ArchiveSkipReason::kOtherSpace,
+            ClassifyForCloseUnpinned(tabs[1], "home"));
+  EXPECT_EQ(ArchiveSkipReason::kSidebarEntry,
+            ClassifyForCloseUnpinned(tabs[3], "home"));
+  EXPECT_EQ(ArchiveSkipReason::kNone, ClassifyForCloseUnpinned(tabs[2], "home"));
+
+  const ArchivePlan plan = PlanCloseUnpinned(tabs, "home");
+  EXPECT_THAT(plan.to_close,
+              ElementsAre(tabs[0].handle, tabs[2].handle, tabs[4].handle));
+  EXPECT_FALSE(plan.empties_window);
+}
+
+// No current space named = the pre-M6 command: every space at once.
+TEST_F(WorkspaceArchivePolicyTest, CloseUnpinnedWithoutASpaceClearsAllSpaces) {
+  std::vector<ArchiveTabState> tabs = {Aged(base::Minutes(1)),
+                                       Aged(base::Minutes(1))};
+  tabs[0].space_id = "home";
+  tabs[1].space_id = "work";
+  const ArchivePlan plan = PlanCloseUnpinned(tabs);
+  EXPECT_THAT(plan.to_close, ElementsAre(tabs[0].handle, tabs[1].handle));
+  EXPECT_TRUE(plan.empties_window);
+}
+
+// Arc archives across every space (non-active spaces' tabs are alive and
+// age like any other), so the unattended sweep never looks at the space.
