+  EXPECT_EQ(work, service_->FindEntryById(a)->space_id);
+  EXPECT_THAT(PinnedShapeIn(*service_, work),
+              ElementsAre(folder, folder + "/" + a));
+  EXPECT_THAT(PinnedShapeIn(*service_, kDefaultSpaceId), ElementsAre());
+  service_->Shutdown();
+
+  {
+    ScopedListPrefUpdate update(&prefs_, prefs::kWorkspaceEntries);
+    for (base::Value& value : *update) {
+      const std::string* id = value.GetDict().FindString("id");
+      if (id && *id == a) {
+        value.GetDict().Set("space_id", kDefaultSpaceId);
+      }
