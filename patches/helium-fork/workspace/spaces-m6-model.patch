+void WorkspaceTabController::DeleteSpace(const std::string& space_id) {
+  if (!service_ || !service_->FindSpaceById(space_id) ||
+      service_->spaces().size() <= 1) {
+    return;
+  }
+  // 1. Every window looking at this space moves to its neighbour first --
+  //    Arc lands on the adjacent space (g10c); the one to the left, or the
+  //    right when it was first. Done before the model changes so no window
+  //    ever names a space that is gone.
+  const std::vector<WorkspaceSpace>& spaces = service_->spaces();
+  std::string neighbour;
+  for (size_t i = 0; i < spaces.size(); ++i) {
+    if (spaces[i].id == space_id) {
+      neighbour = i > 0 ? spaces[i - 1].id : spaces[i + 1].id;
+      break;
+    }
+  }
+  for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+    if (browser->GetProfile() != browser_window_->GetProfile()) {
+      continue;
+    }
+    if (WorkspaceTabController* controller = From(browser)) {
+      if (controller->current_space_id_ == space_id) {
+        controller->SwitchToSpaceInternal(neighbour, -1);
+      }
+    }
+  }
+
+  // 2. The space's tabs, collected while the tags are intact -- the close
+  //    writes each tab's space into its TabRestoreService entry
+  //    (PopulateWorkspaceExtraData), which is how Undo puts them back into
+  //    the restored space rather than the current one.
+  space_undo_watermark_ = RestoreWatermark(
+      TabRestoreServiceFactory::GetForProfile(browser_window_->GetProfile()));
+  std::map<BrowserWindowInterface*, std::vector<tabs::TabHandle>> by_window;
+  for (tabs::TabHandle handle : service_->FindTabsInSpace(space_id)) {
+    tabs::TabInterface* const tab = handle.Get();
+    if (!tab) {
+      continue;
+    }
+    if (BrowserWindowInterface* const window =
+            tab->GetBrowserWindowInterface()) {
+      by_window[window].push_back(handle);
+    }
+  }
+  for (auto& [window, handles] : by_window) {
+    if (window->IsDeleteScheduled()) {
+      continue;
+    }
+    TabStripModel* const model = window->GetTabStripModel();
+    if (!model) {
+      continue;
+    }
+    // The window keeps one tab (⛔ M4: a second close of a blank tab takes
+    // the window down). That window is already on the neighbour space, so
+    // the tab ActivateSpaceTab minted for it counts; if every tab is
+    // leaving, add one.
+    if (static_cast<int>(handles.size()) >= model->count()) {
+      chrome::AddTabAt(window, GURL(), /*index=*/-1, /*foreground=*/true);
+    }
+    for (auto it = handles.rbegin(); it != handles.rend(); ++it) {
+      tabs::TabInterface* const tab = it->Get();
+      if (!tab) {
+        continue;
+      }
+      const int index = model->GetIndexOfTab(tab);
+      if (index < 0) {
+        continue;
+      }
+      model->CloseWebContentsAt(
+          index, TabCloseTypes::CLOSE_USER_GESTURE |
+                     TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    }
+  }
+
+  // 3. The model: the space and its entries, snapshotted for the undo.
+  space_undo_snapshot_ = service_->RemoveSpace(space_id);
+  if (!space_undo_snapshot_) {
+    return;
+  }
+
+  if (BrowserView* const browser_view =
+          BrowserView::GetBrowserViewForBrowser(browser_window_)) {
+    if (VerticalTabStripRegionView* const region =
+            browser_view->vertical_tab_strip_region_view()) {
+      region->ShowUndoBarForAction(
+          l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_DELETED_BODY),
+          base::BindOnce(&WorkspaceTabController::UndoLastDeleteSpace,
+                         weak_factory_.GetWeakPtr()));
+    }
+  }
+}
+
+void WorkspaceTabController::UndoLastDeleteSpace() {
+  if (!service_ || !space_undo_snapshot_) {
+    return;
+  }
+  const std::string space_id = space_undo_snapshot_->space.id;
+  const bool restored = service_->RestoreSpace(*space_undo_snapshot_);
+  space_undo_snapshot_.reset();
+  const SessionID watermark = space_undo_watermark_;
+  space_undo_watermark_ = SessionID::InvalidValue();
+  if (!restored) {
+    return;
+  }
+  // The space exists again, so the reopened tabs' "helium.space" carrier
+  // lands them in it (TagInsertedTab); the entries re-claim their tabs as
+  // the loads commit (认领不是一次性的, M3.11-r1).
+  RewindTabRestoreTo(watermark);
+  SwitchToSpaceInternal(space_id, kDirectionFromOrder);
+}
