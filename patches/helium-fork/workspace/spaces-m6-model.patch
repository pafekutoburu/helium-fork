+void WorkspaceTabController::CloseAbandonedBlankTab(
+    const std::string& space_id) {
+  TabStripModel* const model = browser_window_->GetTabStripModel();
+  if (!model || model->count() <= 1) {
+    return;
+  }
+  tabs::TabInterface* lone = nullptr;
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* const tab = model->GetTabAtIndex(i);
+    if (!tab || service_->GetSpaceForTab(tab->GetHandle()) != space_id) {
+      continue;
+    }
+    if (lone) {
+      return;  // two or more: the space is in use
+    }
+    lone = tab;
+  }
+  content::WebContents* const contents = lone ? lone->GetContents() : nullptr;
+  if (!contents || lone == model->GetActiveTab() ||
+      !IsBlankNewTabState(contents->GetVisibleURL(),
+                          contents->GetController().GetEntryCount())) {
+    return;
+  }
+  const int index = model->GetIndexOfTab(lone);
+  if (index >= 0) {
+    model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_NONE);
+  }
+}
