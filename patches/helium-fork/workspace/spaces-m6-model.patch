+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_space.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium_workspace {
+namespace {
+
+WorkspaceSpace MakeSpace() {
+  WorkspaceSpace space;
+  space.id = "5c1d7d2a-0e6b-4a0f-8d1e-2f3a4b5c6d7e";
+  space.name = u"Work 工作";
+  space.icon = "🎨";
+  space.position = 2;
+  space.collapsed = true;
+  return space;
+}
+
+TEST(WorkspaceSpaceTest, RoundTrip) {
+  const WorkspaceSpace original = MakeSpace();
+  const std::optional<WorkspaceSpace> decoded =
+      WorkspaceSpace::FromValue(original.ToValue());
+  ASSERT_TRUE(decoded.has_value());
+  EXPECT_EQ(decoded->id, original.id);
+  EXPECT_EQ(decoded->name, original.name);
+  EXPECT_EQ(decoded->icon, original.icon);
+  EXPECT_EQ(decoded->position, original.position);
+  EXPECT_EQ(decoded->collapsed, original.collapsed);
+  EXPECT_EQ(decoded->version, WorkspaceSpace::kCurrentVersion);
+}
+
+TEST(WorkspaceSpaceTest, SpaceWithoutIdIsRejected) {
+  base::DictValue dict = MakeSpace().ToValue();
+  dict.Remove("id");
+  EXPECT_FALSE(WorkspaceSpace::FromValue(dict).has_value());
+  dict.Set("id", "");
+  EXPECT_FALSE(WorkspaceSpace::FromValue(dict).has_value());
+}
+
+// Everything but the id is optional: an old build must keep a space some
+// newer build wrote (say with a theme key) rather than drop it wholesale,
+// and a bare {"id"} is a valid, nameless, iconless space.
+TEST(WorkspaceSpaceTest, UnknownKeysAreIgnoredAndMissingKeysDefault) {
+  base::DictValue dict;
+  dict.Set("id", "s1");
+  dict.Set("theme", "blue");   // a round-2 key
+  dict.Set("position", 7);
+  const std::optional<WorkspaceSpace> decoded = WorkspaceSpace::FromValue(dict);
+  ASSERT_TRUE(decoded.has_value());
+  EXPECT_EQ("s1", decoded->id);
+  EXPECT_TRUE(decoded->name.empty());
+  EXPECT_TRUE(decoded->icon.empty());
+  EXPECT_EQ(7, decoded->position);
+  EXPECT_FALSE(decoded->collapsed);
+  EXPECT_EQ(WorkspaceSpace::kCurrentVersion, decoded->version);
+}
+
+// The collapsed key is written only when set, so an expanded space's dict
+// is the same shape a build without the bit would have written.
+TEST(WorkspaceSpaceTest, CollapsedIsWrittenOnlyWhenSet) {
+  WorkspaceSpace space = MakeSpace();
+  space.collapsed = false;
+  EXPECT_FALSE(space.ToValue().contains("collapsed"));
+  space.collapsed = true;
+  EXPECT_TRUE(space.ToValue().contains("collapsed"));
+}
+
+}  // namespace
+}  // namespace helium_workspace
