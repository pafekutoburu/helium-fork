+void WorkspaceTabController::HandleActiveTabChange(
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (switching_space_ || !selection.active_tab_changed() ||
+      !selection.new_tab) {
+    return;
+  }
+  const tabs::TabHandle handle = selection.new_tab->GetHandle();
+  const std::string space = service_->GetSpaceForTab(handle);
+  // Compare spaces, not tabs: active_tab_changed() is also true across a
+  // discard, and a global (favorite) tab must not overwrite any space's
+  // memory of what it was looking at (Arc g8c).
+  if (space.empty() || space == kGlobalSpaceId) {
+    return;
+  }
+  if (space == current_space_id_) {
+    last_active_by_space_[space] = handle;
+    return;
+  }
+  if (change.type() == TabStripModelChange::kRemoved) {
+    // The strip picked a neighbour after a close. Stay here; put one of
+    // this space's own tabs (or a fresh page) in front instead. Posted --
+    // the strip forbids mutation from inside an observer callback.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<WorkspaceTabController> self,
+               const std::string& expected_space) {
+              if (self && self->current_space_id_ == expected_space) {
+                base::AutoReset<bool> guard(&self->switching_space_, true);
+                self->ActivateSpaceTab(expected_space);
+              }
+            },
+            weak_factory_.GetWeakPtr(), current_space_id_));
+    return;
+  }
+  if (service_->FindSpaceById(space)) {
+    SetCurrentSpace(space);  // the tab is already active: state only
+    last_active_by_space_[space] = handle;
+  }
+}
