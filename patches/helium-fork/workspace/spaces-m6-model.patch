+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+
+namespace helium_workspace {
+
+WorkspaceTabRestoreData::WorkspaceTabRestoreData(content::WebContents* contents,
+                                                 std::string space_id)
+    : content::WebContentsUserData<WorkspaceTabRestoreData>(*contents),
+      space_id_(std::move(space_id)) {}
+
+WorkspaceTabRestoreData::~WorkspaceTabRestoreData() = default;
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(WorkspaceTabRestoreData);
+
+void PopulateWorkspaceExtraData(
+    tabs::TabInterface* tab,
+    std::map<std::string, std::string>* extra_data) {
+  if (!tab || !extra_data) {
+    return;
+  }
+  BrowserWindowInterface* const window = tab->GetBrowserWindowInterface();
+  if (!window) {
+    return;
+  }
+  WorkspaceService* const service =
+      WorkspaceServiceFactory::GetForProfile(window->GetProfile());
+  if (!service) {
+    return;  // off-the-record: no sidebar, no spaces
+  }
+  const std::string space = service->GetSpaceForTab(tab->GetHandle());
+  if (space.empty() || space == kGlobalSpaceId) {
+    return;
+  }
+  (*extra_data)[kSpaceExtraDataKey] = space;
+}
+
+void RestoreWorkspaceSpaceFromExtraData(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data) {
+  if (!contents) {
+    return;
+  }
+  const auto it = extra_data.find(kSpaceExtraDataKey);
+  if (it == extra_data.end() || it->second.empty()) {
+    return;
+  }
+  // Whether the space still exists is the controller's question -- it has
+  // the service and a current space to fall back to.
+  WorkspaceTabRestoreData::CreateForWebContents(contents, it->second);
+}
+
+}  // namespace helium_workspace
