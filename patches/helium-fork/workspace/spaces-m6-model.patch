--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/workspace_space.h
@@ -0,0 +1,63 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_SPACE_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_SPACE_H_
+
+#include <optional>
+#include <string>
+
+#include "base/values.h"
+
+namespace helium_workspace {
+
+// The pseudo space of a tab bound to a favorite. Favorites are the same in
+// every space (Arc, M6 轮0 g1: six tiles pixel-identical across three
+// spaces), so such a tab belongs everywhere: it is never hidden by the
+// per-space filters and it stays the active tab across a switch (g8c).
+// Never a real id (those are UUIDs or kDefaultSpaceId), never persisted.
+inline constexpr char kGlobalSpaceId[] = "*";
+
+// The id LoadFromPrefs mints for the first space of a profile that has none
+// yet. Every entry written before M6 already carries space_id == "default"
+// (workspace_entry.h has shipped the field since v1), so this one literal is
+// what lands all of them in that space with no migration step -- and it is
+// what the m313/m311 probe fixtures write, so it must not change.
+inline constexpr char kDefaultSpaceId[] = "default";
+
+// One Arc-style space: a named, icon'd bucket of pinned rows and folders
+// (WorkspaceEntry::space_id points here) plus, at runtime, a subset of the
+// open tabs. Favorites are not per space. v2.0 carries no theme colour.
+struct WorkspaceSpace {
+  WorkspaceSpace();
+  WorkspaceSpace(const WorkspaceSpace&);
+  WorkspaceSpace& operator=(const WorkspaceSpace&);
+  ~WorkspaceSpace();
+
+  static constexpr int kCurrentVersion = 1;
+
+  base::DictValue ToValue() const;
+
+  // Rejects only a missing/empty id. Everything else defaults and unknown
+  // keys are ignored: a later build may write a theme key, and an older one
+  // must keep the space rather than drop it -- the same additive rule that
+  // keeps folders out of WorkspaceEntry::Section. Deliberately no enum with
+  // a range check for the same reason.
+  static std::optional<WorkspaceSpace> FromValue(const base::DictValue& dict);
+
+  std::string id;  // UUID (or kDefaultSpaceId), primary key.
+  std::u16string name;
+  // One emoji, UTF-8. Empty = no icon: the bottom bar and the head row draw
+  // an 8pt grey dot instead (Arc g1 f_00300).
+  std::string icon;
+  // Order in the bottom bar, dense from 0.
+  int position = 0;
+  // The head row's chevron: hides this space's whole pinned list.
+  bool collapsed = false;
+  int version = kCurrentVersion;
+};
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_SPACE_H_
