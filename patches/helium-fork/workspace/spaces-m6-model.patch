+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_TAB_RESTORE_DATA_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_TAB_RESTORE_DATA_H_
+
+#include <map>
+#include <string>
+
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+namespace helium_workspace {
+
+// The session extra_data key under which a tab's space travels across a
+// restart (SessionService::AddTabExtraData) and across Cmd+Shift+T
+// (BrowserLiveTabContext::GetExtraDataForTab). Namespaced like glic's.
+inline constexpr char kSpaceExtraDataKey[] = "helium.space";
+
+// M6: carries a restored tab's space from the raw WebContents (where
+// browser_tabrestore.cc hands the extra_data back, before the tab exists
+// in any model) to WorkspaceTabController's kInserted handler, which tags
+// the tab and drops this. Same shape as glic::GlicTabRestoreData.
+class WorkspaceTabRestoreData
+    : public content::WebContentsUserData<WorkspaceTabRestoreData> {
+ public:
+  ~WorkspaceTabRestoreData() override;
+
+  const std::string& space_id() const { return space_id_; }
+
+ private:
+  friend class content::WebContentsUserData<WorkspaceTabRestoreData>;
+
+  WorkspaceTabRestoreData(content::WebContents* contents, std::string space_id);
+
+  const std::string space_id_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+// Writes |tab|'s space into |extra_data| (the Cmd+Shift+T half; the restart
+// half is the controller's AddTabExtraData). Nothing is written for a tab
+// with no space of its own -- a favorite's tab is re-claimed by URL anyway.
+void PopulateWorkspaceExtraData(tabs::TabInterface* tab,
+                                std::map<std::string, std::string>* extra_data);
+
+// Parks the space found in |extra_data|, if any, on |contents| as a
+// WorkspaceTabRestoreData for the controller to consume on insert.
+void RestoreWorkspaceSpaceFromExtraData(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data);
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_TAB_RESTORE_DATA_H_
