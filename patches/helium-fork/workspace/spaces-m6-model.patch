+// ---- Spaces (M6) ----
+
+void WorkspaceTabController::SwitchToSpace(const std::string& space_id) {
+  SwitchToSpaceInternal(space_id, kDirectionFromOrder);
+}
+
+void WorkspaceTabController::SwitchToSpaceInternal(const std::string& space_id,
+                                                   int direction) {
+  if (!service_ || space_id == current_space_id_ ||
+      !service_->FindSpaceById(space_id)) {
+    return;
+  }
+  const std::string previous = current_space_id_;
+  base::AutoReset<bool> guard(&switching_space_, true);
+  // Views first, tab second: activating first would make the sidebar's
+  // SyncBindings run against the old space's rows and then throw them away
+  // -- one wasted pass and a frame of the old space wearing the new card.
+  SetCurrentSpace(space_id, direction);
+  ActivateSpaceTab(space_id);
+  CloseAbandonedBlankTab(previous);
+}
+
+void WorkspaceTabController::SwitchToSpaceIndex(size_t index) {
+  if (!service_ || index >= service_->spaces().size()) {
+    return;
+  }
+  SwitchToSpace(service_->spaces()[index].id);
+}
+
+void WorkspaceTabController::NextSpace() {
+  if (!service_) {
+    return;
+  }
+  const std::vector<WorkspaceSpace>& spaces = service_->spaces();
+  for (size_t i = 0; i < spaces.size(); ++i) {
+    if (spaces[i].id == current_space_id_) {
+      // "Next" slides the same way even when it wraps to the first space.
+      SwitchToSpaceInternal(spaces[(i + 1) % spaces.size()].id, +1);
+      return;
+    }
+  }
+}
+
+void WorkspaceTabController::PrevSpace() {
+  if (!service_) {
+    return;
+  }
+  const std::vector<WorkspaceSpace>& spaces = service_->spaces();
+  for (size_t i = 0; i < spaces.size(); ++i) {
+    if (spaces[i].id == current_space_id_) {
+      SwitchToSpaceInternal(spaces[(i + spaces.size() - 1) % spaces.size()].id,
+                            -1);
+      return;
+    }
+  }
+}
+
+void WorkspaceTabController::NewSpaceFromMenu() {
+  if (!service_) {
+    return;
+  }
+  const std::string id = service_->AddSpace(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WS_NEW_SPACE_DEFAULT_NAME),
+      /*icon=*/std::string(), /*insert_after_id=*/current_space_id_);
+  if (id.empty()) {
+    return;
+  }
+  SwitchToSpace(id);
+  if (BrowserView* const browser_view =
+          BrowserView::GetBrowserViewForBrowser(browser_window_)) {
+    if (VerticalTabStripRegionView* const region =
+            browser_view->vertical_tab_strip_region_view()) {
+      if (WorkspaceSidebarView* const sidebar =
+              region->WorkspaceDragSidebar()) {
+        sidebar->StartSpaceRename(id);
+      }
+    }
+  }
+}
+
+void WorkspaceTabController::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void WorkspaceTabController::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void WorkspaceTabController::SetCurrentSpace(const std::string& space_id,
+                                             int direction) {
+  if (space_id == current_space_id_) {
+    return;
+  }
+  if (direction == kDirectionFromOrder) {
+    // Bar order decides: a space further right slides in from the right.
+    const auto index_of = [&](const std::string& id) {
+      const std::vector<WorkspaceSpace>& spaces = service_->spaces();
+      for (size_t i = 0; i < spaces.size(); ++i) {
+        if (spaces[i].id == id) {
+          return static_cast<int>(i);
+        }
+      }
+      return -1;
+    };
+    const int from = index_of(current_space_id_);
+    const int to = index_of(space_id);
+    direction = (from < 0 || to < 0 || from == to) ? 0 : (to > from ? +1 : -1);
+  }
+  for (Observer& observer : observers_) {
+    observer.OnCurrentSpaceWillChange(direction);
+  }
+  last_switch_direction_ = direction;
+  current_space_id_ = space_id;
+  browser_window_->GetProfile()->GetPrefs()->SetString(
+      prefs::kWorkspaceCurrentSpaceId, space_id);
+  for (Observer& observer : observers_) {
+    observer.OnCurrentSpaceChanged();
+  }
+}
+
+void WorkspaceTabController::ActivateSpaceTab(const std::string& space_id) {
+  TabStripModel* const model = browser_window_->GetTabStripModel();
+  if (!model || model->empty()) {
+    return;
+  }
+  // A favorite's tab belongs to every space, so it simply stays active
+  // (Arc g8c: letterboxd kept the focus across a switch).
+  if (const tabs::TabInterface* active = model->GetActiveTab();
+      active && service_->GetSpaceForTab(active->GetHandle()) == kGlobalSpaceId) {
+    return;
+  }
+
+  const auto activate = [&](tabs::TabInterface* tab) {
+    const int index = model->GetIndexOfTab(tab);
+    if (index < 0) {
+      return false;
+    }
+    model->ActivateTabAt(
+        index, TabStripUserGestureDetails(
+                   TabStripUserGestureDetails::GestureType::kOther));
+    last_active_by_space_[space_id] = tab->GetHandle();
+    return true;
+  };
