Index: src/chrome/browser/ui/helium/arc_sidebar_menu.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_sidebar_menu.h
@@ -0,0 +1,86 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_SIDEBAR_MENU_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_SIDEBAR_MENU_H_
+
+#include <algorithm>
+
+#include "base/time/time.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+// helium-fork M6: the sidebar's bottom "⌄" menu -- the panel Dia opens from
+// the chevron at the bottom of its sidebar. The user pointed at Dia for this
+// module (2026-09-02, screenshot `Screenshot 2026-09-02 at 06.47.25.png`,
+// 1156x2170 @2x, Dia sidebar 262pt wide), so the numbers are Dia's, measured
+// off that screenshot (2x px / 2):
+//
+//   panel width 333pt; corner radius ≈18pt (37px fitted); 1px hairline
+//   (L177 on a L236 panel); a soft ≈20pt shadow (255 -> 233 above the panel);
+//   rows 37pt apart, icon at x17 (14pt), text at x40.5 (≈13pt, cap 19px);
+//   the separator 1pt at ≈0.10 black; the panel's bottom 46pt above the
+//   window's bottom with the chevron's centre 23.5pt above it, 23pt in from
+//   the sidebar's right edge; the panel's left edge 8pt left of the chevron's
+//   centre, the panel running out over the page.
+//
+// Header-only and free of //ui/views on purpose, like every other arc_*.h:
+// the geometry below is asserted in helium_workspace_unittests.
+namespace helium {
+
+inline constexpr int kSidebarMenuWidth = 333;
+// M6-r3: was Dia's 18; the user's rule (2026-09-03) is one radius for
+// every rounded rect in the shell -- the capsules' 12
+// (LayoutConstant::kVerticalTabCornerRadius; this header stays free of
+// //ui/views, hence the literal).
+inline constexpr int kSidebarMenuRadius = 12;
+inline constexpr int kSidebarMenuRowHeight = 37;
+inline constexpr int kSidebarMenuIconX = 17;
+inline constexpr int kSidebarMenuIconSize = 14;
+inline constexpr int kSidebarMenuTextX = 42;  // our row column (M3.10), 40.5 in Dia
+inline constexpr int kSidebarMenuVerticalInset = 8;
+inline constexpr int kSidebarMenuSeparatorHeight = 1;
+inline constexpr float kSidebarMenuSeparatorAlpha = 0.10f;
+// Dia's 1px hairline: L177 on the L236 panel = black at ≈0.25.
+inline constexpr float kSidebarMenuBorderAlpha = 0.25f;
+// How far the panel's left edge sits left of the chevron's centre.
+inline constexpr int kSidebarMenuAnchorOverhang = 8;
+// The gap between the panel's bottom and the top of the chevron's 32pt slot
+// (Dia: panel bottom at 46, the slot's top at 41).
+inline constexpr int kSidebarMenuAnchorGap = 5;
+// The same 200ms the media panel and the undo bar open with.
+inline constexpr base::TimeDelta kSidebarMenuDuration = base::Milliseconds(200);
+
+// The panel's height for |rows| rows split into |groups| groups (a
+// separator between consecutive groups).
+inline constexpr int SidebarMenuHeight(int rows, int groups) {
+  const int separators = groups > 1 ? groups - 1 : 0;
+  return 2 * kSidebarMenuVerticalInset + rows * kSidebarMenuRowHeight +
+         separators * (kSidebarMenuSeparatorHeight + 2 * kSidebarMenuVerticalInset);
+}
+
+// Where the panel goes: |anchor| is the chevron's 32pt slot in the parent's
+// coordinates, |parent| the parent's size. The panel's left edge hangs
+// kSidebarMenuAnchorOverhang left of the anchor's centre and its bottom sits
+// kSidebarMenuAnchorGap above the anchor's top, both clamped so the panel
+// never leaves the parent. At |progress| < 1 the panel is that much shorter,
+// growing upward out of the anchor (the media panel's own rule).
+inline gfx::Rect SidebarMenuBounds(const gfx::Rect& anchor,
+                                   const gfx::Size& parent,
+                                   int expanded_height,
+                                   double progress) {
+  const double t = std::clamp(progress, 0.0, 1.0);
+  const int width = std::min(kSidebarMenuWidth, std::max(parent.width(), 0));
+  const int bottom = std::min(anchor.y() - kSidebarMenuAnchorGap, parent.height());
+  const int max_height = std::max(bottom, 0);
+  const int full = std::min(expanded_height, max_height);
+  const int height = static_cast<int>(full * t + 0.5);
+  int x = anchor.CenterPoint().x() - kSidebarMenuAnchorOverhang;
+  x = std::clamp(x, 0, std::max(parent.width() - width, 0));
+  return gfx::Rect(x, bottom - height, width, height);
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_SIDEBAR_MENU_H_
Index: src/chrome/browser/ui/helium/arc_sidebar_menu_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_sidebar_menu_unittest.cc
@@ -0,0 +1,55 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_sidebar_menu.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+// Four rows in two groups (New Space | Downloads / History / Bookmarks).
+TEST(ArcSidebarMenuTest, HeightCountsRowsAndOneSeparatorPerGroupBoundary) {
+  EXPECT_EQ(2 * kSidebarMenuVerticalInset + 4 * kSidebarMenuRowHeight +
+                kSidebarMenuSeparatorHeight + 2 * kSidebarMenuVerticalInset,
+            SidebarMenuHeight(4, 2));
+  EXPECT_EQ(2 * kSidebarMenuVerticalInset + 3 * kSidebarMenuRowHeight,
+            SidebarMenuHeight(3, 1));
+}
+
+// Dia: the panel hangs 8pt left of the chevron's centre, its bottom 5pt
+// above the chevron's slot, and it runs out over the page.
+TEST(ArcSidebarMenuTest, FullPanelSitsAboveTheAnchorAndOverhangsIt) {
+  const gfx::Rect anchor(230, 1000, 32, 32);
+  const gfx::Size parent(1200, 1050);
+  const gfx::Rect bounds = SidebarMenuBounds(anchor, parent, 200, 1.0);
+  EXPECT_EQ(anchor.CenterPoint().x() - kSidebarMenuAnchorOverhang, bounds.x());
+  EXPECT_EQ(kSidebarMenuWidth, bounds.width());
+  EXPECT_EQ(200, bounds.height());
+  EXPECT_EQ(anchor.y() - kSidebarMenuAnchorGap, bounds.bottom());
+}
+
+// The bottom edge is pinned while the panel grows: y + height is constant.
+TEST(ArcSidebarMenuTest, GrowsUpwardFromAPinnedBottom) {
+  const gfx::Rect anchor(230, 1000, 32, 32);
+  const gfx::Size parent(1200, 1050);
+  const gfx::Rect half = SidebarMenuBounds(anchor, parent, 200, 0.5);
+  const gfx::Rect full = SidebarMenuBounds(anchor, parent, 200, 1.0);
+  EXPECT_EQ(full.bottom(), half.bottom());
+  EXPECT_EQ(100, half.height());
+  EXPECT_EQ(0, SidebarMenuBounds(anchor, parent, 200, 0.0).height());
+}
+
+// A short window caps the height; a narrow one keeps the panel inside.
+TEST(ArcSidebarMenuTest, ClampsToTheParent) {
+  const gfx::Rect anchor(230, 120, 32, 32);
+  const gfx::Rect bounds = SidebarMenuBounds(anchor, gfx::Size(300, 160), 200, 1.0);
+  EXPECT_EQ(anchor.y() - kSidebarMenuAnchorGap, bounds.height());
+  EXPECT_EQ(0, bounds.y());
+  EXPECT_EQ(300 - kSidebarMenuWidth < 0 ? 0 : 300 - kSidebarMenuWidth, bounds.x());
+  EXPECT_LE(bounds.right(), 300);
+}
+
+}  // namespace
+}  // namespace helium
