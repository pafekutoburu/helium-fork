+void WorkspaceTabController::RequestDeleteSpace(const std::string& space_id) {
+  if (!service_ || service_->spaces().size() <= 1) {
+    return;  // the last space stays (WorkspaceService::RemoveSpace agrees)
+  }
+  const WorkspaceSpace* space = service_->FindSpaceById(space_id);
+  if (!space) {
+    return;
+  }
+  auto run_delete = base::BindOnce(&WorkspaceTabController::DeleteSpace,
+                                   weak_factory_.GetWeakPtr(), space_id);
+  bool has_entries = false;
+  for (const WorkspaceEntry& entry : service_->entries()) {
+    if (entry.section == WorkspaceEntry::Section::kPinned &&
+        entry.space_id == space_id) {
+      has_entries = true;
+      break;
+    }
+  }
+  if (!has_entries && service_->FindTabsInSpace(space_id).empty()) {
+    // Nothing to lose: no dialog (the folder rule, M3.13).
+    std::move(run_delete).Run();
+    return;
+  }
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser_window_);
+  if (!browser_view) {
+    return;
+  }
+  // Arc 轮0 g10c: a centred dialog, Cancel [ESC] / Delete [⏎]; the copy is
+  // ours (we close tabs, Arc archives them).
+  ui::DialogModel::Builder builder;
+  builder
+      .SetTitle(l10n_util::GetStringFUTF16(IDS_HELIUM_WS_DELETE_SPACE_TITLE,
+                                           space->name))
+      .AddParagraph(ui::DialogModelLabel(
+          l10n_util::GetStringUTF16(IDS_HELIUM_WS_DELETE_SPACE_BODY)))
+      .AddOkButton(std::move(run_delete),
+                   ui::DialogModel::Button::Params()
+                       .SetLabel(l10n_util::GetStringUTF16(
+                           IDS_HELIUM_WS_DELETE_SPACE_CONFIRM))
+                       .SetStyle(ui::ButtonStyle::kProminent))
+      .AddCancelButton(base::DoNothing());
+  constrained_window::ShowBrowserModal(builder.Build(),
+                                       browser_view->GetNativeWindow());
+}
