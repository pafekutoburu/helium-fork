+void WorkspaceTabController::TagInsertedTab(tabs::TabInterface* tab) {
+  if (!tab) {
+    return;
+  }
+  const tabs::TabHandle handle = tab->GetHandle();
+  if (service_->HasTabSpaceTag(handle)) {
+    return;  // dragged in from another window: keeps its space
+  }
+  content::WebContents* const contents = tab->GetContents();
+  std::string space;
+  if (contents) {
+    if (const WorkspaceTabRestoreData* restored =
+            WorkspaceTabRestoreData::FromWebContents(contents)) {
+      if (service_->FindSpaceById(restored->space_id())) {
+        space = restored->space_id();
+      }
+      contents->RemoveUserData(WorkspaceTabRestoreData::UserDataKey());
+    }
+  }
+  if (space.empty()) {
+    if (const WorkspaceEntry* entry =
+            service_->FindEntryById(service_->FindEntryIdForTab(handle))) {
+      space = entry->section == WorkspaceEntry::Section::kFavorite
+                  ? current_space_id_
+                  : entry->space_id;
+    }
+  }
+  if (space.empty()) {
+    space = pending_space_tag_.empty() ? current_space_id_ : pending_space_tag_;
+  }
+  service_->SetTabSpace(handle, space);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspaceTabController::PersistTabSpace,
+                                weak_factory_.GetWeakPtr(), handle, space));
+}
+
+void WorkspaceTabController::PersistTabSpace(tabs::TabHandle handle,
+                                             const std::string& space_id) {
+  tabs::TabInterface* const tab = handle.Get();
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return;
+  }
+  // The rebuild-proof copy first (M6-r1): the command appended below dies
+  // with the next rebuild of the session file, this one is what
+  // BuildCommandsForTab re-emits then.
+  HeliumSessionTabExtraData::Set(contents, kSpaceExtraDataKey, space_id);
+  // Same incantation as send_tab_to_self's tracker; the service is null for
+  // profiles that keep no session (incognito, guest).
+  SessionService* const session_service =
+      SessionServiceFactory::GetForProfile(browser_window_->GetProfile());
+  if (!session_service) {
+    return;
+  }
+  const SessionID window_id =
+      sessions::SessionTabHelper::IdForWindowContainingTab(contents);
+  const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (window_id.is_valid() && tab_id.is_valid()) {
+    session_service->AddTabExtraData(window_id, tab_id, kSpaceExtraDataKey,
+                                     space_id);
+  }
+}
