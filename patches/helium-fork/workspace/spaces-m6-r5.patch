+// The hover square every button on the bar wears (M6-r5, user ruling
+// 2026-09-04): the resting square behind the current space is gone -- Arc
+// has none, light (measured 2026-09-03) or dark (2026-09-04); which space is
+// current is told by saturation alone, as in Arc -- and a square shows only
+// under the mouse. One recipe for the whole row (user rule: every hover on a
+// row is the same colour): the sidebar's hover for surfaces with no resting
+// fill (GetSidebarHoverSurfaceColor, the rows'), instant like the rows'
+// (no tween), radius 12 like every rounded rect. Arc's own hover square was
+// not measured (it takes moving the mouse over the user's Arc).
+void PaintBarHoverSquare(const views::Button& button, gfx::Canvas* canvas) {
+  const views::Button::ButtonState state = button.GetState();
+  if (state != views::Button::STATE_HOVERED &&
+      state != views::Button::STATE_PRESSED) {
+    return;
+  }
+  const ui::ColorProvider* colors = button.GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  cc::PaintFlags fill;
+  fill.setStyle(cc::PaintFlags::kFill_Style);
+  fill.setAntiAlias(true);
+  fill.setColor(
+      helium::GetSidebarHoverSurfaceColor(colors->GetColor(kColorToolbar)));
+  canvas->DrawRoundRect(gfx::RectF(button.GetLocalBounds()), kSquareRadius,
+                        fill);
+}
