+void HeliumSidebarMenuView::HideForSidebarFold() {
+  if (fold_paced_hide_ && !shown_) {
+    return;  // the fold's second notification (kCollapsed): leg already running
+  }
+  if (shown_) {
+    SetShown(false);  // hooks off, submenus gone, the panel's own fade begun
+  }
+  fold_paced_hide_ = true;
+  // Whatever is still on screen -- the fade just begun, an Escape fade
+  // already in flight, or an opening cut short -- is re-paced so that the
+  // part left ends with the sidebar's hide leg. SlideAnimation runs a leg
+  // for slide_duration * (distance left) (SlideAnimation::GetDuration), so
+  // the duration is stretched by 1 / opacity for the remaining fade to take
+  // the leg's full length; Reset() first, since Hide() on a leg already
+  // hiding is a no-op. Zero (reduce motion) stays zero: the leg then ends
+  // synchronously, AnimationEnded included (T025 (2): it must reach
+  // SetVisible(false), not stop at transparent).
+  const double opacity = open_animation_.GetCurrentValue();
+  if (opacity <= 0.0) {
+    AnimationEnded(&open_animation_);  // nothing to fade: just make sure it is hidden
+    return;
+  }
+  open_animation_.Reset(opacity);
+  open_animation_.SetSlideDuration(
+      gfx::Animation::RichAnimationDuration(helium::kFloatingSidebarHideDuration) /
+      opacity);
+  open_animation_.SetTweenType(helium::kFloatingSidebarHideTween);
+  open_animation_.Hide();
+}
