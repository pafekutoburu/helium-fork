@@ -254,20 +293,60 @@
 
 void HeliumSidebarMenuView::VisibilityChanged(views::View* starting_from,
                                               bool is_visible) {
-  if (!is_visible && shown_) {
-    // Hidden from above (the sidebar folded away, the window changed
-    // shape): drop the dismissal hooks without animating.
-    shown_ = false;
-    ResetAccelerators();
-    event_monitor_.reset();
+  if (is_visible || !shown_) {
+    return;
+  }
+  // Hidden from above (the window ordered out, the sidebar folded away):
+  // drop the dismissal hooks without animating.
+  shown_ = false;
+  ResetAccelerators();
+  event_monitor_.reset();
+  submenu_action_.reset();
+  data_->CancelAll();
+  open_animation_.Reset(0.0);
+  layer()->SetOpacity(0.0f);
+  if (shadow_frame_) {
+    shadow_frame_->SetVisible(false);
+  }
+  if (starting_from == this) {
+    // Our own SetVisible(false): the only child list locked is ours, so
+    // the parent's can be edited.
     CloseSubmenusFrom(0);
-    submenu_action_.reset();
-    data_->CancelAll();
-    open_animation_.Reset(0.0);
-    layer()->SetOpacity(0.0f);
-    if (shadow_frame_) {
-      shadow_frame_->SetVisible(false);
+    return;
+  }
+  // helium-fork T025 (T024 cluster B): the notification came down from an
+  // ancestor, so this runs inside View::PropagateVisibilityNotifications
+  // with the parent's ScopedChildrenLock held -- and the submenus are the
+  // parent's children. RemoveChildViewT here is CHECK(!iterating_) (five
+  // user crash reports, out/Rel included, all under -[NSWindow orderOut:]).
+  // Hide the levels now (SetVisible never touches children_) and drop them
+  // once the traversal is over; the WeakPtr covers the window going away
+  // first, in which case the parent deletes them with itself.
+  for (const SubmenuLevel& level : submenus_) {
+    if (level.view) {
+      level.view->SetVisible(false);
     }
+    if (level.shadow) {
+      level.shadow->SetVisible(false);
+    }
+  }
+  // The panel itself too: the animation was just stopped, so AnimationEnded
+  // (which hides it on the animated path) never runs, and a panel that is
+  // merely transparent still hit-tests -- after ⌘H and back, a click on
+  // where its rows were would run them. Re-enters VisibilityChanged with
+  // starting_from == this and shown_ already false: a no-op.
+  SetVisible(false);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&HeliumSidebarMenuView::DropSubmenusIfStillHidden,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void HeliumSidebarMenuView::DropSubmenusIfStillHidden() {
+  // Reopened before this ran (an input task can overtake the default queue):
+  // SetShown(true) already dropped the levels that were left behind, and
+  // whatever is in submenus_ now is the new panel's.
+  if (!shown_) {
+    CloseSubmenusFrom(0);
   }
 }
 
