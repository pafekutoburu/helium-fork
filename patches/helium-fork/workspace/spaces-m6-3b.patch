+void WorkspaceEntryView::StartRename() {
+  if (editing_ || renders_as_capsule()) {
+    return;
+  }
+  editing_ = true;
+  // The field starts with what the row reads and all of it selected (Arc
+  // g34-3); emptied, it shows the same text as a grey placeholder (g34-4).
+  rename_shown_before_ = DisplayTitle();
+  editor_->SetText(rename_shown_before_);
+  editor_->SetPlaceholderText(rename_shown_before_);
+  editor_->SetVisible(true);
+  title_label_->SetVisible(false);
