+class EntryEmojiSource : public gfx::CanvasImageSource {
+ public:
+  EntryEmojiSource(std::u16string emoji, SkColor color)
+      : gfx::CanvasImageSource(gfx::Size(gfx::kFaviconSize, gfx::kFaviconSize)),
+        emoji_(std::move(emoji)),
+        color_(color) {}
+
+  // gfx::CanvasImageSource:
+  void Draw(gfx::Canvas* canvas) override {
+    // A colour emoji ignores |color_|; a text-style symbol (☀) wears it.
+    canvas->DrawStringRectWithFlags(
+        emoji_,
+        gfx::FontList().DeriveWithSizeDelta(kEntryEmojiFontSize -
+                                            gfx::FontList().GetFontSize()),
+        color_, gfx::Rect(size()),
+        gfx::Canvas::TEXT_ALIGN_CENTER | gfx::Canvas::NO_SUBPIXEL_RENDERING);
+  }
+
+ private:
+  const std::u16string emoji_;
+  const SkColor color_;
+};
+
+}  // namespace
+
+ui::ImageModel EntryCustomIconImage(const std::string& icon,
+                                    SkColor glyph_color) {
+  if (icon.empty()) {
+    return ui::ImageModel();
+  }
+  if (helium_workspace::IsVectorIconRef(icon)) {
+    const gfx::VectorIcon* vector =
+        FindSpaceVectorIcon(helium_workspace::VectorIconRefName(icon));
+    if (!vector) {
+      return ui::ImageModel();
+    }
+    return ui::ImageModel::FromImageSkia(
+        gfx::CreateVectorIcon(*vector, gfx::kFaviconSize, glyph_color));
+  }
+  return ui::ImageModel::FromImageSkia(
+      gfx::CanvasImageSource::MakeImageSkia<EntryEmojiSource>(
+          base::UTF8ToUTF16(icon), glyph_color));
+}
