===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_entry_label.h
@@ -0,0 +1,74 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_ENTRY_LABEL_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_ENTRY_LABEL_H_
+
+#include <string>
+#include <string_view>
+
+#include "base/strings/string_util.h"
+
+// helium-fork M6 轮3 3b: what a sidebar entry's title reads, and what a
+// Rename... edit does when it ends -- as plain functions over plain state,
+// asserted in helium_workspace_unittests like every other arc_*.h.
+//
+// Arc (decisions.md 「M6 轮3 3b」①, user recording 2026-09-22): a renamed
+// row keeps its name whatever the page does -- it stayed "zzz" after the tab
+// navigated to another page and drifted (g34-1) -- and emptying the name
+// brings the page's title back (g34-2). So the name the user gave wins over
+// everything, and "empty" means "no name of our own".
+namespace helium {
+
+// The row's text: the user's name for it; else, while a tab is bound and has
+// a title, the live title (M3.10: a drifted row shows the page it is on);
+// else the pinned page's stored title. A bound tab that has no title yet
+// (still loading) keeps the stored one rather than flashing blank.
+inline const std::u16string& EffectiveEntryTitle(
+    const std::u16string& custom_title,
+    bool bound,
+    const std::u16string& live_title,
+    const std::u16string& stored_title) {
+  if (!custom_title.empty()) {
+    return custom_title;
+  }
+  return bound && !live_title.empty() ? live_title : stored_title;
+}
+
+enum class RenameOutcome {
+  kNoChange,  // write nothing
+  kSet,       // store |text| as the entry's own name
+  kClear,     // drop the entry's own name: the page's title shows again
+};
+
+struct RenameResult {
+  RenameOutcome outcome = RenameOutcome::kNoChange;
+  // kSet only: the entered text with the surrounding whitespace trimmed.
+  std::u16string text;
+};
+
+// |entered| is the field's text when the edit ends (Return or focus loss),
+// |shown_before| what the row read when the edit began, |has_custom_title|
+// whether the entry already had a name of its own. Whitespace alone counts as
+// empty. Pressing Return on the text as it was writes nothing -- otherwise a
+// Rename... that is merely confirmed would freeze the page's current title
+// into a custom name that no longer follows the page.
+inline RenameResult ResolveRename(std::u16string_view entered,
+                                  std::u16string_view shown_before,
+                                  bool has_custom_title) {
+  const std::u16string_view trimmed =
+      base::TrimWhitespace(entered, base::TRIM_ALL);
+  if (trimmed.empty()) {
+    return {has_custom_title ? RenameOutcome::kClear
+                             : RenameOutcome::kNoChange};
+  }
+  if (trimmed == base::TrimWhitespace(shown_before, base::TRIM_ALL)) {
+    return {RenameOutcome::kNoChange};
+  }
+  return {RenameOutcome::kSet, std::u16string(trimmed)};
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_ENTRY_LABEL_H_
Index: src/chrome/browser/ui/helium/arc_entry_label_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_entry_label_unittest.cc
@@ -0,0 +1,65 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_entry_label.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+TEST(ArcEntryLabelTest, TheUsersNameWinsInEveryState) {
+  // Arc g34-1: "zzz" stayed "zzz" after the tab drifted to another page.
+  const std::u16string custom = u"zzz";
+  EXPECT_EQ(u"zzz", EffectiveEntryTitle(custom, /*bound=*/false, u"",
+                                        u"Films.Dance"));
+  EXPECT_EQ(u"zzz", EffectiveEntryTitle(custom, /*bound=*/true, u"Films.Dance",
+                                        u"Films.Dance"));
+  EXPECT_EQ(u"zzz", EffectiveEntryTitle(custom, /*bound=*/true,
+                                        u"About — Films.Dance", u"Films.Dance"));
+}
+
+TEST(ArcEntryLabelTest, WithoutANameTheOldRuleHolds) {
+  const std::u16string none;
+  // Unbound: the pinned page's stored title.
+  EXPECT_EQ(u"Stored", EffectiveEntryTitle(none, false, u"Live", u"Stored"));
+  // Bound: the live title (a drifted row shows the page it is on).
+  EXPECT_EQ(u"Live", EffectiveEntryTitle(none, true, u"Live", u"Stored"));
+  // Bound but still loading: the stored title, not a blank row.
+  EXPECT_EQ(u"Stored", EffectiveEntryTitle(none, true, u"", u"Stored"));
+}
+
+TEST(ArcEntryLabelTest, RenameSetsTrimmedText) {
+  const RenameResult r = ResolveRename(u"  zzz  ", u"Films.Dance", false);
+  EXPECT_EQ(RenameOutcome::kSet, r.outcome);
+  EXPECT_EQ(u"zzz", r.text);
+}
+
+TEST(ArcEntryLabelTest, ConfirmingTheShownTextWritesNothing) {
+  // Return on the untouched field must not freeze the page title into a
+  // custom name that would stop following the page.
+  EXPECT_EQ(RenameOutcome::kNoChange,
+            ResolveRename(u"Films.Dance", u"Films.Dance", false).outcome);
+  EXPECT_EQ(RenameOutcome::kNoChange,
+            ResolveRename(u"zzz ", u"zzz", true).outcome);
+}
+
+TEST(ArcEntryLabelTest, EmptyClearsANameOrDoesNothing) {
+  // Arc g34-2: emptying a custom name brings back the page's title.
+  EXPECT_EQ(RenameOutcome::kClear, ResolveRename(u"", u"zzz", true).outcome);
+  EXPECT_EQ(RenameOutcome::kClear,
+            ResolveRename(u" \t ", u"zzz", true).outcome);
+  // Nothing to clear.
+  EXPECT_EQ(RenameOutcome::kNoChange,
+            ResolveRename(u"", u"Films.Dance", false).outcome);
+}
+
+TEST(ArcEntryLabelTest, RenamingARenamedEntrySetsTheNewName) {
+  const RenameResult r = ResolveRename(u"代码", u"zzz", true);
+  EXPECT_EQ(RenameOutcome::kSet, r.outcome);
+  EXPECT_EQ(u"代码", r.text);
+}
+
+}  // namespace
+}  // namespace helium
