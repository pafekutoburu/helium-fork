+TEST_F(WorkspaceServiceTest, CustomTitleAndIconSetClearAndSurviveAReload) {
+  const std::string a = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://a.example/"), u"A");
+  ASSERT_TRUE(service_->SetEntryCustomTitle(a, u"zzz"));
+  ASSERT_TRUE(service_->SetEntryIcon(a, "vi:star"));
+  EXPECT_EQ(u"zzz", service_->FindEntryById(a)->custom_title);
+  EXPECT_EQ("vi:star", service_->FindEntryById(a)->icon);
+  // The page title is its own field: the write-back keeps working under a
+  // custom name, so clearing the name later brings back the latest title.
+  ASSERT_TRUE(service_->SetEntryTitle(a, u"A (new)"));
+  EXPECT_EQ(u"zzz", service_->FindEntryById(a)->custom_title);
+  service_->Shutdown();
+
+  WorkspaceService reloaded(&prefs_, u"Personal");
+  const WorkspaceEntry* entry = reloaded.FindEntryById(a);
+  ASSERT_TRUE(entry);
+  EXPECT_EQ(u"zzz", entry->custom_title);
+  EXPECT_EQ("vi:star", entry->icon);
+  EXPECT_EQ(u"A (new)", entry->title);
+  EXPECT_EQ(WorkspaceEntry::kCurrentVersion, entry->version);
+
+  ASSERT_TRUE(reloaded.SetEntryCustomTitle(a, u""));
+  ASSERT_TRUE(reloaded.SetEntryIcon(a, ""));
+  EXPECT_TRUE(reloaded.FindEntryById(a)->custom_title.empty());
+  EXPECT_TRUE(reloaded.FindEntryById(a)->icon.empty());
+  reloaded.Shutdown();
+}
+
+TEST_F(WorkspaceServiceTest, CustomTitleAndIconAreForSitesOnly) {
+  const std::string folder = service_->AddFolder(u"F", kDefaultSpaceId);
+  EXPECT_FALSE(service_->SetEntryCustomTitle(folder, u"G"));
+  EXPECT_FALSE(service_->SetEntryIcon(folder, "vi:star"));
+  EXPECT_EQ(u"F", service_->FindEntryById(folder)->title);
+  EXPECT_TRUE(service_->FindEntryById(folder)->icon.empty());
+  EXPECT_FALSE(service_->SetEntryCustomTitle("no-such-id", u"G"));
+  EXPECT_FALSE(service_->SetEntryIcon("no-such-id", "vi:star"));
+}
+
+TEST_F(WorkspaceServiceTest, DuplicateCarriesCustomTitleAndIcon) {
+  const std::string a = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://a.example/"), u"A");
+  ASSERT_TRUE(service_->SetEntryCustomTitle(a, u"zzz"));
+  ASSERT_TRUE(service_->SetEntryIcon(a, "\xF0\x9F\x91\xA4"));
+  const std::string copy = service_->DuplicateEntry(a);
