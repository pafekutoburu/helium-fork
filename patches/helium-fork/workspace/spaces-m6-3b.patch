+  // either grid.
+  const base::span<const helium_workspace::EmojiEntry> table =
+      helium_workspace::EmojiTable();
+  std::optional<size_t> emoji_selected;
+  for (size_t k = 0; k < emoji_indices_.size(); ++k) {
+    if (has_icon && current_icon_ == table[emoji_indices_[k]].utf8) {
+      emoji_selected = k;
+      break;
+    }
+  }
+  emoji_grid_->SetSelectedIndex(emoji_selected);
+  std::optional<size_t> icon_selected;
+  const std::string_view name =
+      helium_workspace::VectorIconRefName(current_icon_);
+  const base::span<const helium_workspace::SpaceIconName> names =
+      helium_workspace::SpaceIconNames();
+  for (size_t i = 0; !name.empty() && i < names.size(); ++i) {
+    if (name == names[i].name) {
+      icon_selected = i;
+      break;
+    }
+  }
+  icon_grid_->SetSelectedIndex(icon_selected);
+  // The segment row lays out with or without the trash.
+  DeprecatedLayoutImmediately();
+  SchedulePaint();
+}
