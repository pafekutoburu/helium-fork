+// M6 轮3 3b (schema v3): a site's own name and icon.
+TEST(WorkspaceEntryTest, CustomTitleAndIconRoundTrip) {
+  WorkspaceEntry original = MakeEntry();
+  original.custom_title = u"代码 zzz";
+  original.icon = "\xF0\x9F\x91\xA4";  // 👤
+  const std::optional<WorkspaceEntry> decoded =
+      WorkspaceEntry::FromValue(original.ToValue());
+  ASSERT_TRUE(decoded.has_value());
+  EXPECT_EQ(decoded->custom_title, original.custom_title);
+  EXPECT_EQ(decoded->icon, original.icon);
+  // The page's own title is a separate field and survives untouched.
+  EXPECT_EQ(decoded->title, original.title);
+
+  WorkspaceEntry vector_icon = MakeEntry();
+  vector_icon.icon = "vi:star";
+  const std::optional<WorkspaceEntry> decoded_vector =
+      WorkspaceEntry::FromValue(vector_icon.ToValue());
+  ASSERT_TRUE(decoded_vector.has_value());
+  EXPECT_EQ(decoded_vector->icon, "vi:star");
+}
+
+TEST(WorkspaceEntryTest, CustomKeysWrittenOnlyWhenSet) {
+  // An entry that never used the feature writes neither key, and the one it
+  // loaded with -- version and all -- comes back out unchanged.
+  const base::DictValue plain = MakeEntry().ToValue();
+  EXPECT_FALSE(plain.contains("custom_title"));
+  EXPECT_FALSE(plain.contains("icon"));
+
+  base::DictValue v2 = MakeEntry().ToValue();
+  v2.Set("version", 2);
+  const std::optional<WorkspaceEntry> decoded = WorkspaceEntry::FromValue(v2);
+  ASSERT_TRUE(decoded.has_value());
+  EXPECT_EQ(decoded->version, 2);
+  EXPECT_EQ(decoded->ToValue(), v2);
+}
+
+TEST(WorkspaceEntryTest, CustomKeysOfTheWrongTypeAreIgnored) {
+  base::DictValue dict = MakeEntry().ToValue();
+  dict.Set("custom_title", 7);
+  dict.Set("icon", true);
+  const std::optional<WorkspaceEntry> decoded = WorkspaceEntry::FromValue(dict);
+  ASSERT_TRUE(decoded.has_value());
+  EXPECT_TRUE(decoded->custom_title.empty());
+  EXPECT_TRUE(decoded->icon.empty());
+}
+
+TEST(WorkspaceEntryTest, FoldersNeverCarryCustomKeys) {
+  // A folder's name lives in |title| and it has no icon of its own; stray
+  // keys from some other build are dropped on load.
+  base::DictValue dict = MakeFolder().ToValue();
+  dict.Set("custom_title", "Renamed");
+  dict.Set("icon", "vi:star");
+  const std::optional<WorkspaceEntry> decoded = WorkspaceEntry::FromValue(dict);
+  ASSERT_TRUE(decoded.has_value());
+  EXPECT_TRUE(decoded->custom_title.empty());
+  EXPECT_TRUE(decoded->icon.empty());
+  EXPECT_EQ(decoded->title, u"Untitled");
+}
