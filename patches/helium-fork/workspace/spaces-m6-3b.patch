+
+bool WorkspaceEntryView::HandleKeyEvent(views::Textfield* sender,
+                                        const ui::KeyEvent& key_event) {
+  if (key_event.type() != ui::EventType::kKeyPressed || !editing_) {
+    return false;
+  }
+  // Mid-composition, Return and Escape belong to the input method (Arc g34-5:
+  // the candidates are confirmed first). The Mac's input method usually
+  // takes them before they get here; Textfield::OnKeyPressed asks the
+  // controller without looking, so this is the belt to that.
+  if (sender->IsIMEComposing()) {
+    return false;
+  }
+  // Both keys leave through the framework's own focus system (FinishRename
+  // clears it before the field hides).
+  if (key_event.key_code() == ui::VKEY_RETURN) {
+    FinishRename(/*commit=*/true, /*clear_focus=*/true);
+    return true;
+  }
+  if (key_event.key_code() == ui::VKEY_ESCAPE) {
+    FinishRename(/*commit=*/false, /*clear_focus=*/true);
+    return true;
+  }
+  return false;
+}
+
+void WorkspaceEntryView::FinishRename(bool commit, bool clear_focus) {
+  if (!editing_) {
+    return;
+  }
+  // Off first: the blur that clearing the focus sends must find the edit
+  // already over.
+  editing_ = false;
+  const std::u16string entered(editor_->GetText());
+  // ⛔ Out of the field before it hides: hiding a focused view advances the
+  // focus to the next stop, and past the sidebar that is the page (the icon
+  // picker learned it with the page's focus ring, 2a).
+  if (clear_focus) {
+    if (views::FocusManager* const focus = GetFocusManager();
+        focus && editor_->HasFocus()) {
+      focus->ClearFocus();
+    }
+  }
+  editor_->SetVisible(false);
+  title_label_->SetVisible(!renders_as_capsule());
+  UpdateTitleText();
+  // The pointer usually left long ago (the edit ends on a key or a click
+  // somewhere else), and no exit event is coming.
+  if (!IsMouseHovered()) {
+    hovered_ = false;
+  }
+  UpdateCloseButton();
+  DeprecatedLayoutImmediately();
+  SchedulePaint();
+  if (!commit || !delegate_) {
+    return;
+  }
+  const helium::RenameResult result = helium::ResolveRename(
+      entered, rename_shown_before_, !custom_title_.empty());
+  if (result.outcome == helium::RenameOutcome::kNoChange) {
+    return;
+  }
+  const std::u16string custom = result.outcome == helium::RenameOutcome::kSet
+                                    ? result.text
+                                    : std::u16string();
+  // ⛔ A finish can run inside the sidebar's own sync: a blur while the
+  // sidebar drops this very row (another window moved the entry to another
+  // space), or SetEntry turning the row into a tile under the edit. The
+  // model notifies the sidebar synchronously -- a second sync inside the
+  // first, removing views twice (reviewer diff r0 #1, r1). So every commit,
+  // Return's too, reaches the model one task later, and only if the row is
+  // still around. The row reads the new name meanwhile, its accessible name
+  // and tooltip included: the model's echo finds nothing changed (r1).
+  custom_title_ = custom;
+  UpdateTitleText();
+  UpdateAccessibleState();
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<WorkspaceEntryView> self, std::u16string custom) {
+            if (self && self->delegate_) {
+              self->delegate_->OnEntryRenamed(self->entry_id_, custom);
+            }
+          },
+          weak_factory_.GetWeakPtr(), custom));
 }
 
