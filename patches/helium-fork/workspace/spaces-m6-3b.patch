+bool WorkspaceService::SetEntryCustomTitle(const std::string& id,
+                                           const std::u16string& custom_title) {
+  for (WorkspaceEntry& entry : entries_) {
+    if (entry.id != id) {
+      continue;
+    }
+    if (entry.is_folder()) {
+      return false;  // a folder's name is its |title| (SetEntryTitle)
+    }
+    if (entry.custom_title != custom_title) {
+      entry.custom_title = custom_title;
+      entry.version = WorkspaceEntry::kCurrentVersion;
+      SchedulePersist();
+      NotifyChanged();
+    }
+    return true;
+  }
+  return false;
+}
+
+bool WorkspaceService::SetEntryIcon(const std::string& id,
+                                    const std::string& icon) {
+  for (WorkspaceEntry& entry : entries_) {
+    if (entry.id != id) {
+      continue;
+    }
+    if (entry.is_folder()) {
+      return false;  // folders keep their own glyph (user 2026-09-22)
+    }
+    if (entry.icon != icon) {
+      entry.icon = icon;
+      entry.version = WorkspaceEntry::kCurrentVersion;
+      SchedulePersist();
+      NotifyChanged();
+    }
+    return true;
+  }
+  return false;
+}
