+
+void WorkspaceSidebarView::OnEntryChangeIconRequested(
+    const std::string& entry_id) {
+  const auto it = entry_views_.find(entry_id);
+  const helium_workspace::WorkspaceEntry* const entry =
+      service_ ? service_->FindEntryById(entry_id) : nullptr;
+  if (it == entry_views_.end() || !entry) {
+    return;
+  }
+  WorkspaceEntryView* const view = it->second.get();
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(GetBrowserWindow());
+  VerticalTabStripRegionView* const region =
+      browser_view ? browser_view->vertical_tab_strip_region_view() : nullptr;
+  // The menu was opened on this row, so it is on screen; one that has gone
+  // since (a fold, an empty layout) has nowhere to hang the card.
+  if (!region || !view->GetVisible() || view->bounds().IsEmpty()) {
+    return;
+  }
+  const gfx::Rect anchor = views::View::ConvertRectToTarget(
+      view, browser_view, view->IconBounds());
+  const gfx::Rect row =
+      views::View::ConvertRectToTarget(view, browser_view, view->GetLocalBounds());
+  const gfx::Rect region_bounds = views::View::ConvertRectToTarget(
+      region, browser_view, region->GetLocalBounds());
+  // Arc g35 f_00400: the card's top 7 below the row, the tail at the favicon;
+  // the same card as a space's (the user's 2026-09-22 rule: it stays up
+  // after a pick, so each one arrives here by id).
+  browser_view->ShowHeliumSpaceIconPicker(
+      anchor, helium::SpaceIconPickerPlacement::kBelowAnchor,
+      row.bottom() + helium::kSpaceIconPickerGapBelowEntryRow,
+      region_bounds.x(), entry->icon,
+      base::BindRepeating(&WorkspaceSidebarView::OnEntryIconPicked,
+                          weak_factory_.GetWeakPtr(), entry_id),
+      base::DoNothing());
+}
+
+void WorkspaceSidebarView::OnEntryIconPicked(const std::string& entry_id,
+                                             const std::string& icon) {
+  // An id that has gone (deleted or moved away while the picker was up) is a
+  // no-op in the service.
+  if (service_) {
+    service_->SetEntryIcon(entry_id, icon);
+  }
+}
