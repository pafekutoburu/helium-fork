@@ -0,0 +1,233 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/space_swipe_monitor_mac.h"
+
+#import <Cocoa/Cocoa.h>
+
+#include <cmath>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/ui/helium/arc_space_motion.h"
+#include "ui/events/event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/gfx/geometry/point_conversions.h"
+#include "ui/views/cocoa/native_widget_mac_ns_window_host.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+SpaceSwipeMonitorMac::SpaceSwipeMonitorMac(views::Widget* widget,
+                                           views::View* region,
+                                           Delegate* delegate)
+    : region_(region), delegate_(delegate) {
+  if (views::NativeWidgetMacNSWindowHost* const host =
+          views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+              widget->GetNativeWindow())) {
+    monitor_ = host->AddEventMonitor(this);
+  }
+}
+
+SpaceSwipeMonitorMac::~SpaceSwipeMonitorMac() = default;
+
+// static
+void SpaceSwipeMonitorMac::PerformEndDiscHaptic() {
+  // ⚠ Ours: Arc's binary names an NSHapticFeedbackPerformer and "page detent"
+  // haptics, but which pattern it plays was not measured; "level change" is
+  // the one macOS gives for stepping over a discrete threshold. Now, not at
+  // the next draw: the fill is drawn by the GPU process, not AppKit's pass.
+  [NSHapticFeedbackManager.defaultPerformer
+      performFeedbackPattern:NSHapticFeedbackPatternLevelChange
+             performanceTime:NSHapticFeedbackPerformanceTimeNow];
+}
+
+void SpaceSwipeMonitorMac::Abort() {
+  momentum_wait_.Stop();
+  awaiting_momentum_ = false;
+  if (state_ == State::kUndecided || state_ == State::kHorizontal) {
+    state_ = State::kAborted;
+  }
+}
+
+void SpaceSwipeMonitorMac::NativeWidgetMacEventMonitorOnEvent(
+    ui::Event* event,
+    bool target_is_this_window,
+    bool* event_handled) {
+  if (*event_handled) {
+    return;
+  }
+  // ⛔ Esc cancels a gesture in progress before it does anything else (Esc =
+  // cancel and restore, user 2026-09-17; reviewer 4b diff r0): the list goes
+  // back, and the key goes no further. In progress = the fingers on it, or
+  // lifted with the release not judged yet (r1); and only an Esc meant for
+  // this window -- another window's sheet keeps its own (r1).
+  if (event->type() == ui::EventType::kKeyPressed &&
+      event->AsKeyEvent()->key_code() == ui::VKEY_ESCAPE &&
+      target_is_this_window &&
+      (state_ == State::kHorizontal || awaiting_momentum_)) {
+    *event_handled = true;
+    if (awaiting_momentum_) {
+      // Its momentum is still eaten (eating_momentum_ stays set).
+      momentum_wait_.Stop();
+      awaiting_momentum_ = false;
+    } else {
+      state_ = State::kAborted;
+    }
+    delegate_->OnSpaceSwipeCancel();
+    return;
+  }
+  // 4b-r2: and once released, the page a filled end disc is turning to its
+  // sheet is the gesture's still: Esc turns it back (reviewer 4b-r2 diff r0
+  // -- the sheet would otherwise come up regardless).
+  if (event->type() == ui::EventType::kKeyPressed &&
+      event->AsKeyEvent()->key_code() == ui::VKEY_ESCAPE &&
+      target_is_this_window && delegate_->OnSpaceSwipeEscapeAfterRelease()) {
+    *event_handled = true;
+    return;
+  }
+  if (event->type() != ui::EventType::kScroll) {
+    return;
+  }
+  if (!target_is_this_window) {
+    // The gesture's events went to another window: whatever this one had
+    // claimed is over -- its Ended will never come here, and a drag left
+    // hanging would swallow the next gesture (reviewer 4b diff r0).
+    if (state_ == State::kHorizontal) {
+      state_ = State::kIdle;
+      delegate_->OnSpaceSwipeCancel();
+    } else if (state_ == State::kUndecided) {
+      state_ = State::kIdle;
+    }
+    return;
+  }
+  NSEvent* const ns = event->native_event().Get();
+  // A mouse wheel (no precise deltas, no phases) never starts a swipe.
+  if (!ns || !ns.hasPreciseScrollingDeltas) {
+    return;
+  }
+  const NSEventPhase phase = ns.phase;
+  const NSEventPhase momentum = ns.momentumPhase;
+  const double dx = ns.scrollingDeltaX;
+  const double dy = ns.scrollingDeltaY;
+
+  // ---- momentum: after the fingers lifted ----
+  if (phase == NSEventPhaseNone && momentum != NSEventPhaseNone) {
+    if (awaiting_momentum_ && momentum == NSEventPhaseBegan) {
+      // macOS carried the gesture on: a flick, the way it goes (Arc g41: a
+      // flick completes toward itself from any position).
+      const double way = dx != 0.0 ? dx : last_dx_;
+      Release(way > 0 ? +1 : way < 0 ? -1 : 0);
+    }
+    if (eating_momentum_) {
+      *event_handled = true;
+      if (momentum == NSEventPhaseEnded || momentum == NSEventPhaseCancelled) {
+        eating_momentum_ = false;
+      }
+    }
+    return;
+  }
+  if (phase == NSEventPhaseNone) {
+    return;
+  }
+
+  // ---- a new gesture ----
+  if (phase == NSEventPhaseMayBegin || phase == NSEventPhaseBegan) {
+    if (awaiting_momentum_) {
+      // New fingers before the momentum showed: the old release was slow.
+      Release(0);
+    }
+    eating_momentum_ = false;
+    // A new gesture starts over -- except the Began that follows this
+    // gesture's own may-begin. One still horizontal here never ended: over.
+    if (phase == NSEventPhaseMayBegin || state_ != State::kUndecided) {
+      if (state_ == State::kHorizontal) {
+        state_ = State::kIdle;
+        delegate_->OnSpaceSwipeCancel();
+      }
+      sum_dx_ = sum_dy_ = last_dx_ = 0.0;
+      gfx::Point point = gfx::ToFlooredPoint(event->AsLocatedEvent()->location_f());
+      views::View::ConvertPointFromWidget(region_, &point);
+      state_ = delegate_->CanStartSpaceSwipe(point) ? State::kUndecided
+                                                     : State::kIgnored;
+    }
+    if (phase == NSEventPhaseMayBegin) {
+      return;
+    }
+  }
+
+  switch (state_) {
+    case State::kIdle:
+    case State::kIgnored:
+    case State::kVertical:
+      break;
+    case State::kAborted:
+      *event_handled = true;
+      if (phase == NSEventPhaseEnded || phase == NSEventPhaseCancelled) {
+        eating_momentum_ = true;
+        state_ = State::kIdle;
+      }
+      break;
+    case State::kUndecided: {
+      sum_dx_ += dx;
+      sum_dy_ += dy;
+      if (phase == NSEventPhaseEnded || phase == NSEventPhaseCancelled) {
+        state_ = State::kIdle;
+        break;
+      }
+      if (std::max(std::abs(sum_dx_), std::abs(sum_dy_)) <
+          helium::kSpaceSwipeAxisLock) {
+        break;  // still passes: the list may scroll a point or two
+      }
+      if (std::abs(sum_dx_) <= std::abs(sum_dy_)) {
+        state_ = State::kVertical;
+        break;
+      }
+      state_ = State::kHorizontal;
+      *event_handled = true;
+      if (dx != 0.0) {
+        last_dx_ = dx;
+      }
+      delegate_->OnSpaceSwipeBegin();
+      if (state_ != State::kHorizontal) {
+        break;  // the delegate could not take it (Abort)
+      }
+      // No dead zone (Arc g39): the travel so far counts.
+      delegate_->OnSpaceSwipeUpdate(sum_dx_);
+      break;
+    }
+    case State::kHorizontal:
+      *event_handled = true;
+      if (phase == NSEventPhaseCancelled) {
+        state_ = State::kIdle;
+        delegate_->OnSpaceSwipeCancel();
+        break;
+      }
+      sum_dx_ += dx;
+      if (dx != 0.0) {
+        last_dx_ = dx;
+      }
+      delegate_->OnSpaceSwipeUpdate(sum_dx_);
+      if (phase == NSEventPhaseEnded) {
+        state_ = State::kIdle;
+        awaiting_momentum_ = true;
+        eating_momentum_ = true;
+        momentum_wait_.Start(
+            FROM_HERE, helium::kSpaceSwipeMomentumWait,
+            base::BindOnce(&SpaceSwipeMonitorMac::OnMomentumWaitElapsed,
+                           weak_factory_.GetWeakPtr()));
+      }
+      break;
+  }
+}
+
+void SpaceSwipeMonitorMac::OnMomentumWaitElapsed() {
+  if (awaiting_momentum_) {
+    Release(0);
+  }
+}
+
+void SpaceSwipeMonitorMac::Release(int flick) {
+  momentum_wait_.Stop();
+  awaiting_momentum_ = false;
+  delegate_->OnSpaceSwipeEnd(flick);
+}
