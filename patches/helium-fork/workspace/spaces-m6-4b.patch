+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_SPACE_SWIPE_MONITOR_MAC_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_SPACE_SWIPE_MONITOR_MAC_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/views/cocoa/native_widget_mac_event_monitor.h"
+
+namespace views {
+class View;
+class Widget;
+}  // namespace views
+
+// helium-fork M6 轮4 4b: the two-finger horizontal swipe on the sidebar
+// (decisions.md 「M6 轮4」② g39–g44, tasks/4/brief.md §3.1). A window-level
+// NSEvent monitor (NativeWidgetMacNSWindowHost::AddEventMonitor, the
+// precedent is MenuPreTargetHandlerMac): it runs before AppKit's hit test,
+// so it sees the sidebar's blank stretches (window-drag area, invisible to
+// views) and the lists' scroll views, which swallow every scroll event,
+// horizontal ones included; and it can take a whole NSEvent away.
+//
+// One gesture at a time, by its NSEvent phases:
+//   began / may-begin inside the claim area and past the delegate's gates
+//     -> undecided (events pass through);
+//   the first finger travel of kSpaceSwipeAxisLock picks the axis for good
+//     (Arc g43): vertical -> everything passes, momentum too, until the next
+//     gesture; horizontal -> every event of the gesture is taken, the
+//     finger total goes to the delegate;
+//   fingers up -> wait kSpaceSwipeMomentumWait for momentum to begin: it did
+//     = a flick, the way the momentum goes; it did not = a slow release;
+//     the momentum that follows a horizontal gesture is taken whole.
+// ⛔ Esc while the fingers hold the list cancels the drag first (the key is
+// taken); a new gesture always starts over, and a claimed one whose events
+// go to another window is over (reviewer 4b diff r0).
+class SpaceSwipeMonitorMac : public views::NativeWidgetMacEventMonitor::Client {
+ public:
+  class Delegate {
+   public:
+    // Whether a gesture that begins at |point| (the region's coordinates)
+    // may be claimed: inside the sidebar below its top row, nothing modal
+    // (sheet, drag, resize, menu, inline rename), the sidebar expanded.
+    virtual bool CanStartSpaceSwipe(const gfx::Point& point) = 0;
+    // The axis is horizontal: a drag starts (grabbing a running slide).
+    virtual void OnSpaceSwipeBegin() = 0;
+    // The fingers' horizontal travel since the gesture began, in points,
+    // as scrollingDeltaX reports it (the system's natural-scrolling setting
+    // already applied: > 0 moves the content right).
+    virtual void OnSpaceSwipeUpdate(double finger_dx) = 0;
+    // The fingers lifted. |flick| is the momentum's direction in the same
+    // terms (+1 content right, -1 left), 0 for a slow release.
+    virtual void OnSpaceSwipeEnd(int flick) = 0;
+    // The system took the gesture away (a Mission Control swipe, the window
+    // losing it): no release judgement, back to where it was.
+    virtual void OnSpaceSwipeCancel() = 0;
+    // 4b-r2: Esc after the release was judged -- a release on a filled end
+    // disc is still turning the page to its sheet. True when that was so and
+    // the turn is going back (the key then goes no further).
+    virtual bool OnSpaceSwipeEscapeAfterRelease() = 0;
+
+   protected:
+    virtual ~Delegate() = default;
+  };
+
+  SpaceSwipeMonitorMac(views::Widget* widget,
+                       views::View* region,
+                       Delegate* delegate);
+  SpaceSwipeMonitorMac(const SpaceSwipeMonitorMac&) = delete;
+  SpaceSwipeMonitorMac& operator=(const SpaceSwipeMonitorMac&) = delete;
+  ~SpaceSwipeMonitorMac();
+
+  // The region can no longer take the drag (a sheet opened, the sidebar
+  // folded, the space list changed under it): nothing more is reported for
+  // this gesture, but its remaining events -- momentum included -- are
+  // still taken, so the list does not scroll off under the fingers.
+  void Abort();
+
+  // 4b-r4: one tap of the trackpad under the fingers, as an end's disc fills
+  // in (user 2026-10-01, on Arc: 「触控板会有一下震动，跟弹动的动画是同步的」).
+  // Nothing on a trackpad without haptics, or with them off in System
+  // Settings.
+  static void PerformEndDiscHaptic();
+
+ private:
+  enum class State {
+    kIdle,        // between gestures
+    kIgnored,     // not ours: began elsewhere or a gate said no
+    kUndecided,   // ours, axis not picked yet
+    kHorizontal,  // taking every event, reporting to the delegate
+    kVertical,    // a scroll: leave it all alone
+    kAborted,     // taken, but no longer reported
+  };
+
+  // views::NativeWidgetMacEventMonitor::Client:
+  void NativeWidgetMacEventMonitorOnEvent(ui::Event* event,
+                                          bool target_is_this_window,
+                                          bool* event_handled) override;
+
+  void OnMomentumWaitElapsed();
+  void Release(int flick);
+
+  const raw_ptr<views::View> region_;
+  const raw_ptr<Delegate> delegate_;
+  std::unique_ptr<views::NativeWidgetMacEventMonitor> monitor_;
+
+  State state_ = State::kIdle;
+  double sum_dx_ = 0.0;
+  double sum_dy_ = 0.0;
+  // The fingers' last horizontal step: the flick's direction when the
+  // momentum's first event carries no distance of its own.
+  double last_dx_ = 0.0;
+  // Fingers up on a horizontal gesture, the release not judged yet.
+  bool awaiting_momentum_ = false;
+  // Swallowing the horizontal gesture's momentum until it ends.
+  bool eating_momentum_ = false;
+  base::OneShotTimer momentum_wait_;
+
+  base::WeakPtrFactory<SpaceSwipeMonitorMac> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_SPACE_SWIPE_MONITOR_MAC_H_
