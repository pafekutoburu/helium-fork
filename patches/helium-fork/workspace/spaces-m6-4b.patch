+    return gfx::PointF(end_ == End::kLast ? width() - inset : inset,
+                       height() / 2.0f);
+  }
+
+  // Through a page turn the flight draws the card; this one stands aside,
+  // and comes back if the turn is undone (its lists spring it home).
+  void SetHeldAway(bool away) {
+    held_away_ = away;
+    SetVisible(!away && past_ > 0.0);
+  }
+
+ private:
+  // gfx::AnimationDelegate:
+  void AnimationProgressed(const gfx::Animation* animation) override {
+    SchedulePaint();
+  }
+  void AnimationEnded(const gfx::Animation* animation) override {
+    SchedulePaint();
+  }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* const colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    PaintEndCard(canvas, colors, end_ == End::kLast, icon_, Centre(),
+                 helium::kSpaceSwipeCardScale, /*degrees=*/0.0, FillMs(),
+                 solid_ ? 1.0 : helium::SwipeEndOutline(past_),
+                 /*card_opacity=*/1.0);
+  }
+
+  const End end_;
+  std::string icon_;
+  double past_ = 0.0;
+  bool solid_ = false;
+  bool held_away_ = false;
+  gfx::LinearAnimation fill_;
+};
