+  // Through (46 + 40, 300 + 60) = (86, 360): half-way at (62.5, 330).
+  EXPECT_NEAR(62.5, manage(0.5).x, 1e-9);
+  EXPECT_NEAR(330.0, manage(0.5).y, 1e-9);
+  EXPECT_NEAR(7.0, manage(0.5).degrees, 1e-9);
+  EXPECT_DOUBLE_EQ(1.0, manage(0.0).card_opacity);
+  EXPECT_DOUBLE_EQ(1.0, manage(0.6).card_opacity);
+  EXPECT_NEAR(0.5, manage(0.8).card_opacity, 1e-9);
+  EXPECT_NEAR(0.0, manage(1.0).card_opacity, 1e-9);
+  EXPECT_NEAR(kSpaceSwipeCardLandScale, manage(1.0).scale, 1e-9);
+  EXPECT_NEAR(32.0, manage(1.0).x, 1e-9);
+  EXPECT_NEAR(150.0, manage(1.0).y, 1e-9);
