+      // 4b-r2: the page turns on to the left and the form follows it in from
+      // the right (Arc g42 seg4 just put the form up and sent the ⊕ back
+      // out -- the user's 「原路返回」).
+      StartSheetSlide(SidebarSheetKind::kCreateForm);
+      break;
+    case SpaceCarousel::DragEnd::kOpenManage:
+      // Its mirror (4b-r1): to the right, Manage in from the left.
+      StartSheetSlide(SidebarSheetKind::kManage);
+      break;
+    case SpaceCarousel::DragEnd::kSettle:
+      break;
+  }
