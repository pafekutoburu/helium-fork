+  const float card_w = static_cast<float>(helium::kSpaceFormCardWidth) * scale;
+  const float card_h = static_cast<float>(helium::kSpaceFormCardHeight) * scale;
+  const float radius = static_cast<float>(helium::kSpaceFormCardRadius) * scale;
+  canvas->Save();
+  gfx::Transform t;
+  t.Translate(centre.x(), centre.y());
+  t.Rotate(degrees);
+  t.Translate(-centre.x(), -centre.y());
+  canvas->Transform(t);
+  const gfx::RectF card(centre.x() - card_w / 2, centre.y() - card_h / 2,
+                        card_w, card_h);
+  cc::PaintFlags shadow;
+  shadow.setStyle(cc::PaintFlags::kFill_Style);
+  shadow.setAntiAlias(true);
+  shadow.setColor(SkColorSetA(SK_ColorBLACK, 0x22));
+  gfx::RectF shadow_rect = card;
+  shadow_rect.Offset(0, 1.5f * scale);
+  canvas->DrawRoundRect(shadow_rect, radius, shadow);
+  cc::PaintFlags fill;
+  fill.setStyle(cc::PaintFlags::kFill_Style);
+  fill.setAntiAlias(true);
+  fill.setColor(SK_ColorWHITE);
+  canvas->DrawRoundRect(card, radius, fill);
+  cc::PaintFlags inner;
+  inner.setStyle(cc::PaintFlags::kFill_Style);
+  inner.setAntiAlias(true);
+  inner.setColor(SkColorSetRGB(0x9A, 0x9E, 0xA6));
+  gfx::RectF screen = card;
+  screen.Inset(gfx::InsetsF::TLBR(card_h * 0.22f, card_w * 0.18f,
+                                  card_h * 0.30f, card_w * 0.18f));
+  canvas->DrawRoundRect(screen, 2.0f * scale, inner);
+  canvas->Restore();
+}
