+// 4b-r2: the page turn's clock and what it holds. The spring is
+// arc_space_motion.h's SheetSlideAt; this only keeps time -- compositor
+// driven, every vsync, like the carousel's -- and remembers what the turn
+// moves so that EndSheetSlide can put it all back.
+class VerticalTabStripRegionView::SheetSlide
+    : public views::AnimationDelegateViews {
+ public:
+  struct Moved {
+    raw_ptr<views::View> view;
+    bool could_process_events = true;
+  };
+
+  explicit SheetSlide(VerticalTabStripRegionView* region)
+      : views::AnimationDelegateViews(region),
+        region_(region),
+        clock_(base::Seconds(kClockSeconds),
+               gfx::LinearAnimation::kDefaultFrameRate,
+               this) {}
+  SheetSlide(const SheetSlide&) = delete;
+  SheetSlide& operator=(const SheetSlide&) = delete;
+  ~SheetSlide() override = default;
+
+  bool active() const { return active_; }
+  // Turned back with Esc (Reverse): on its way to the page, not the sheet.
+  bool reversing() const { return active_ && target_ == 0.0; }
+  SidebarSheetKind kind() const { return kind_; }
+  int width() const { return width_; }
+  HeliumViewSnapshotLayer* picture() const { return picture_.get(); }
+  const std::vector<Moved>& page() const { return page_; }
+  bool was_masked() const { return was_masked_; }
+
+  void Start(SidebarSheetKind kind,
+             std::unique_ptr<HeliumViewSnapshotLayer> picture,
+             std::vector<Moved> page,
+             int width,
+             bool was_masked) {
+    kind_ = kind;
+    picture_ = std::move(picture);
+    page_ = std::move(page);
+    width_ = width;
+    was_masked_ = was_masked;
+    active_ = true;
+    origin_ = {0.0, 0.0};
+    target_ = 1.0;
+    origin_seconds_ = 0.0;
+    snapped_ = false;
+    // The picture was taken in this frame's time, not the user's.
+    cap_first_step_ = true;
+    clock_.Start();
+  }
+
+  // Esc on the way (4b-r2, reviewer diff r0; ⛔ Esc = cancel and restore):
+  // from wherever the turn is, at the speed it has, the same spring aimed
+  // back at the page. False when no turn is running.
+  bool Reverse() {
+    if (!active_) {
+      return false;
+    }
+    if (target_ != 0.0) {
+      const double now = Now();
+      origin_ = StateAt(now);
+      origin_seconds_ = now;
+      target_ = 0.0;
+      snapped_ = false;
+      cap_first_step_ = false;
+    }
+    return true;
+  }
+
+  // Idle again: the clock stopped, the picture gone (its layer leaves the
+  // region's with it); what was moved is the caller's to put back -- read
+  // page() / was_masked() first.
+  void Reset() {
+    active_ = false;
+    if (clock_.is_animating()) {
+      clock_.Stop();
+    }
+    picture_.reset();
+    page_.clear();
+  }
+
+ private:
+  // The clock's ceiling; the turn ends when its spring settles (≈0.31s).
+  static constexpr double kClockSeconds = 10.0;
+
+  double Now() const { return clock_.GetCurrentValue() * kClockSeconds; }
+  // The turn's spring: helium::SheetSlideAt until an Esc re-aims it.
+  helium::SpringState StateAt(double now) const {
+    return helium::StepCriticalSpring(origin_, target_,
+                                      helium::kSpaceSlideOmega,
+                                      std::max(0.0, now - origin_seconds_));
+  }
+
+  // views::AnimationDelegateViews:
+  void AnimationProgressed(const gfx::Animation* animation) override {
+    if (!active_) {
+      return;
+    }
+    const double now = Now();
+    if (cap_first_step_) {
+      cap_first_step_ = false;
+      origin_seconds_ = helium::CapFirstStepOrigin(origin_seconds_, now);
+    }
+    const helium::SpringState state = StateAt(now);
+    if (helium::SpringSettled(state, target_, width_)) {
+      // "Settled" still leaves up to a quarter point: shown there, the
+      // picture sits half a pixel off and the real sheet taking its place
+      // ticks by that much (4b-r2 tvs-r0: the whole form 1px left at the
+      // swap). One frame exactly at rest first, then the swap.
+      if (!snapped_) {
+        snapped_ = true;
+        region_->ApplySheetSlide(target_);
+        return;
+      }
+      if (target_ == 1.0) {
+        region_->EndSheetSlide(/*show=*/true);
+      } else {
+        region_->EndSheetSlide(/*show=*/false, /*spring_lists_back=*/true);
+      }
+      return;
+    }
+    region_->ApplySheetSlide(state.x);
+  }
+  void AnimationEnded(const gfx::Animation* animation) override {
+    // The ceiling, reached only by a spring that never settled.
+    if (active_) {
+      region_->EndSheetSlide(/*show=*/target_ == 1.0);
+    }
+  }
+
+  const raw_ptr<VerticalTabStripRegionView> region_;
+  gfx::LinearAnimation clock_;
+  bool active_ = false;
+  SidebarSheetKind kind_ = SidebarSheetKind::kNone;
+  std::unique_ptr<HeliumViewSnapshotLayer> picture_;
+  std::vector<Moved> page_;
+  int width_ = 0;
+  bool was_masked_ = false;
+  // The spring: from |origin_| at |origin_seconds_| on the clock toward
+  // |target_| (1 the sheet, 0 back to the page).
+  helium::SpringState origin_;
+  double target_ = 1.0;
+  double origin_seconds_ = 0.0;
+  bool cap_first_step_ = false;
+  // The settled spring's one exact frame has been shown (AnimationProgressed).
+  bool snapped_ = false;
+};
