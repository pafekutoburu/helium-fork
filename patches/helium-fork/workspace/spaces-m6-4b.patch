+void VerticalTabStripRegionView::UpdateSwipeEndCard(bool last, double past) {
+  raw_ptr<SwipeEndCard>& card = last ? swipe_plus_ : swipe_manage_;
+  if (!card) {
+    if (past <= 0.0) {
+      return;
+    }
+    card = AddChildView(std::make_unique<SwipeEndCard>(
+        last ? SwipeEndCard::End::kLast : SwipeEndCard::End::kFirst));
+    card->SetProperty(views::kViewIgnoredByLayoutKey, true);
+  }
+  // Along its edge, centred on the sidebar's height (Arc's ⊕: on the
+  // window's, 541.75 of 1084pt).
+  const gfx::Rect bounds(last ? width() - SwipeEndCard::kWidth : 0,
+                         (height() - SwipeEndCard::kHeight) / 2,
+                         SwipeEndCard::kWidth, SwipeEndCard::kHeight);
+  if (card->bounds() != bounds) {
+    card->SetBoundsRect(bounds);
+  }
+  // Manage's carries the current space's icon (4b-r5).
+  if (!last) {
+    card->SetIcon(CurrentSpaceIcon());
+  }
+  card->SetPast(past, carousel_ && carousel_->IsDragging());
+}
