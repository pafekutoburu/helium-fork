+  EXPECT_DOUBLE_EQ(0.0, SwipePastLast(3.9, 4, 299.0));
+  EXPECT_DOUBLE_EQ(4.0 + SwipeEndTravel(149.5) / 299.0,
+                   SwipeShownX(4.5, 0, 4, 299.0));
+  // Before the first: the mirror image (4b kept the lists still there and
+  // slid a picture of the Manage sheet in over them).
+  EXPECT_DOUBLE_EQ(149.5, SwipeBeforeFirst(-0.5, 0, 299.0));
+  EXPECT_DOUBLE_EQ(0.0, SwipeBeforeFirst(0.4, 0, 299.0));
+  EXPECT_DOUBLE_EQ(0.0 - SwipeEndTravel(149.5) / 299.0,
+                   SwipeShownX(-0.5, 0, 4, 299.0));
+  // No width to measure by: the lists stay on the strip.
+  EXPECT_DOUBLE_EQ(4.0, SwipeShownX(4.5, 0, 4, 0.0));
+  EXPECT_DOUBLE_EQ(0.0, SwipeShownX(-0.5, 0, 4, 0.0));
+}
