+
+TEST(ArcSpaceMotionTest, PastTheKneeTheEndsGiveLessTheFurtherTheyArePulled) {
+  // Through the knee the give grows -- never past the pace Arc's ⊕ came in
+  // at (g42: 0.387pt a point) by more than a hair -- and from there on every
+  // further point gives less than the one before, short of the limit.
+  double travel = 0.0;
+  double step = 0.0;
+  double steepest = 0.0;
+  for (int tenth = 1; tenth <= 20000; ++tenth) {
+    const double next = SwipeEndTravel(tenth / 10.0);
+    ASSERT_GT(next, travel) << tenth;
+    const double now = (next - travel) * 10.0;
+    if (tenth > 800) {
+      ASSERT_LT(now, step) << tenth;
+    }
+    steepest = std::max(steepest, now);
+    step = now;
+    travel = next;
+  }
+  EXPECT_NEAR(0.39, steepest, 0.01);
+  EXPECT_LT(travel, kSpaceSwipeEndTravelLimit);
+  EXPECT_NEAR(9.0, SwipeEndTravel(60.0), 0.05);
+  EXPECT_NEAR(24.2, SwipeEndTravel(100.0), 0.05);
+  // Where 4b-r2's ring closed the lists had gone about as far as 4b-r1's
+  // (43.5), and a long pull about as far too (4b-r1: 55.0 at 240).
