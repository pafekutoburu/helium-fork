+bool SpaceCarousel::BeginDrag() {
+  helium_workspace::WorkspaceTabController* const controller =
+      delegate_->CarouselController();
+  TabStripView* const strip = delegate_->CarouselStrip();
+  if (pending_ || !controller || !strip || !strip->GetWidget() ||
+      !strip->GetVisible() || !strip->layer() || strip->width() <= 0) {
+    return false;
+  }
+  if (active_ && (wrapping_ || controller->current_space_id() != live_space_ ||
+                  strip->width() != width_)) {
+    // A wrap-around Next / Previous has no bar neighbours to drag toward,
+    // and a motion that no longer shows this list is stale: land first.
+    Stop();
+  }
+  const std::vector<std::string> order = delegate_->CarouselSpaceOrder();
+  if (active_) {
+    // Grabbed mid-slide (Arc g41 at 93%, g44 at 99%): from where the list
+    // is, at rest.
+    if (clock_.is_animating()) {
+      x_ = StateAt(ClockSeconds()).x;
+      clock_.Stop();
+    }
+  } else {
+    const std::string live = controller->current_space_id();
+    const int index = BarIndexOf(live);
+    if (index < 0) {
+      return false;
+    }
+    live_space_ = live;
+    live_slot_ = index;
+    x_ = target_ = live_slot_;
+    width_ = strip->width();
+    picture_bottom_ = 0;
+    wrapping_ = false;
+    blend_start_.clear();
+    blend_end_.clear();
+    shown_greys_ = {{live_space_, 0.0f}};
+    active_ = true;
+  }
+  const int live_index = BarIndexOf(live_space_);
+  if (live_index < 0) {
+    Stop();
+    return false;
+  }
+  first_slot_ = live_slot_ - live_index;
+  last_slot_ = first_slot_ + static_cast<int>(order.size()) - 1;
+  // The live list's scroll position, put back after each neighbour's picture.
+  SaveScroll(live_space_);
+  dragging_ = true;
+  gesture_ = true;
+  drag_start_x_ = x_;
+  cap_first_step_ = false;
+  EnsureDragPictures();
+  Apply();
+  return true;
+}
+
+void SpaceCarousel::UpdateDrag(double finger_dx) {
+  if (!dragging_) {
+    return;
+  }
+  x_ = helium::SwipeDragX(drag_start_x_, finger_dx, width_);
+  EnsureDragPictures();
+  Apply();
+}
+
+SpaceCarousel::DragEnd SpaceCarousel::EndDrag(int flick) {
+  if (!dragging_) {
+    return DragEnd::kSettle;
+  }
+  dragging_ = false;
+  // An end's disc, filled: its sheet opens (Arc g42 for the ⊕; the first
+  // space's end is its mirror, 4b-r1). The lists stay where the rubber band
+  // has them -- the region turns the page on from there, and the sheet's
+  // arrival lands this (4b-r2; 4b / 4b-r1 sprang them back behind a sheet
+  // that was simply there). Short of that a release at an end -- flicked or
+  // not -- lands on the end's own space below.
+  if (helium::SwipeEndSolid(
+          helium::SwipePastLast(x_, last_slot_, width_))) {
+    return DragEnd::kOpenCreate;
+  }
+  if (helium::SwipeEndSolid(
+          helium::SwipeBeforeFirst(x_, first_slot_, width_))) {
+    return DragEnd::kOpenManage;
+  }
+  // |flick| > 0 is the content going right: toward lower slots.
+  const int target = helium::SwipeReleaseTarget(
+      helium::SwipeShownX(x_, first_slot_, last_slot_, width_), live_slot_,
+      -flick, first_slot_, last_slot_);
+  helium_workspace::WorkspaceTabController* const controller =
+      delegate_->CarouselController();
+  const std::string space =
+      target == live_slot_ ? std::string()
+                           : SpaceForSlot(target, live_slot_, live_space_,
+                                          /*wrapping=*/false);
+  if (space.empty() || !controller) {
+    SettleBack();
+    return DragEnd::kSettle;
+  }
+  // The real switch, now: the controller's hooks aim the spring from here.
+  const std::string was_live = live_space_;
+  HoldHere();
+  {
+    const base::AutoReset<bool> committing(&committing_, true);
+    controller->SwitchToSpace(space);
+  }
+  if (live_space_ == was_live) {
+    // It did not happen (the space went away under the fingers): back.
+    SettleBack();
+  }
+  return DragEnd::kSettle;
+}
+
+void SpaceCarousel::CancelDrag() {
+  if (dragging_) {
+    SettleBack();
+  }
+}
+
+void SpaceCarousel::ReleaseHold() {
+  if (active_ && !dragging_ && !pending_ && !clock_.is_animating()) {
+    SettleBack();
+  }
+}
+
+std::map<std::string, float> SpaceCarousel::DragBlend() const {
+  // Within the bar (the ends do not grey the last or the first space).
+  const double shown = std::clamp(x_, static_cast<double>(first_slot_),
+                                  static_cast<double>(last_slot_));
+  std::map<std::string, float> greys;
+  greys[live_space_] =
+      static_cast<float>(std::min(1.0, std::abs(shown - live_slot_)));
+  for (const int slot : {static_cast<int>(std::floor(shown)),
+                         static_cast<int>(std::ceil(shown))}) {
+    const auto it = slots_.find(slot);
+    if (slot == live_slot_ || it == slots_.end()) {
+      continue;
+    }
+    greys[it->second.space_id] =
+        static_cast<float>(std::min(1.0, std::abs(shown - slot)));
+  }
+  return greys;
+}
+
+void SpaceCarousel::EnsureDragPictures() {
+  helium_workspace::WorkspaceTabController* const controller =
+      delegate_->CarouselController();
+  if (!controller) {
+    return;
+  }
+  const double shown =
+      helium::SwipeShownX(x_, first_slot_, last_slot_, width_);
+  std::set<int> wanted;
+  for (const int slot : {static_cast<int>(std::floor(shown)),
+                         static_cast<int>(std::ceil(shown))}) {
+    if (slot != live_slot_ && !slots_.contains(slot) && slot >= first_slot_ &&
+        slot <= last_slot_) {
+      wanted.insert(slot);
+    }
+  }
+  bool taken = false;
+  for (const int slot : wanted) {
+    std::string space =
+        SpaceForSlot(slot, live_slot_, live_space_, /*wrapping=*/false);
+    if (space.empty()) {
+      continue;
+    }
+    // Nothing is committed while the fingers are on, so the neighbour has no
+    // active row either: no white card (Arc g39, the arriving list).
+    Slot picture;
+    picture.space_id = std::move(space);
+    picture.layers = CaptureSpace(picture.space_id);
+    slots_[slot] = std::move(picture);
+    taken = true;
+  }
+  if (taken) {
+    controller->SetViewSpaceOverride(std::string());
+    delegate_->CarouselResyncViews();
+    RestoreLiveViews(live_space_);
+  }
+}
+
+void SpaceCarousel::HoldHere() {
+  origin_ = {x_, 0.0};
+  target_ = x_;
+  origin_seconds_ = 0.0;
+  if (clock_.is_animating()) {
+    clock_.Stop();
+  }
+  clock_.Start();
+}
+
+void SpaceCarousel::SettleBack() {
+  dragging_ = false;
+  blend_start_ = shown_greys_;
+  blend_end_.clear();
+  for (const auto& [space, grey] : blend_start_) {
+    blend_end_[space] = space == live_space_ ? 0.0f : 1.0f;
+  }
+  blend_origin_x_ = x_;
+  origin_ = {x_, 0.0};
+  target_ = live_slot_;
+  origin_seconds_ = 0.0;
+  if (clock_.is_animating()) {
+    clock_.Stop();
+  }
+  clock_.Start();
+  cap_first_step_ = true;
+  Apply();
 }
 
