+namespace {
+
+// The rounded rect a card's outline runs round, as one path from 12
+// o'clock: anticlockwise (Create's, the fingers going left) or clockwise.
+SkPath CardOutlinePath(const gfx::RectF& card, float radius, bool clockwise) {
+  const float l = card.x(), t = card.y(), r = card.right(), b = card.bottom();
+  const float cx = card.CenterPoint().x();
+  constexpr float kQuarter = 0.70710678f;  // a conic's weight for 90°
+  SkPathBuilder path;
+  path.moveTo(cx, t);
+  path.lineTo(l + radius, t);
+  path.conicTo(l, t, l, t + radius, kQuarter);
+  path.lineTo(l, b - radius);
+  path.conicTo(l, b, l + radius, b, kQuarter);
+  path.lineTo(r - radius, b);
+  path.conicTo(r, b, r, b - radius, kQuarter);
+  path.lineTo(r, t + radius);
+  path.conicTo(r, t, r - radius, t, kQuarter);
+  path.close();
+  SkPath out = path.detach();
+  if (clockwise) {
+    // The mirror about the card's centre line runs the other way round.
+    SkMatrix mirror;
+    mirror.setScale(-1.0f, 1.0f, cx, card.CenterPoint().y());
+    out = out.makeTransform(mirror);
+  }
+  return out;
+}
+
+// A space's icon -- an emoji, a vector glyph, or (none) the bar's 8pt dot --
+// centred at |centre|, as its row in Manage Spaces draws it.
+void PaintSpaceIcon(gfx::Canvas* canvas,
+                    const ui::ColorProvider* colors,
+                    const std::string& icon,
+                    const gfx::PointF& centre) {
+  const float glyph = static_cast<float>(helium::kSpaceManageGlyphSize);
+  const SkColor ink =
+      colors->GetColor(ui::kColorLabelForegroundSecondary);
+  if (icon.empty()) {
+    cc::PaintFlags dot;
+    dot.setStyle(cc::PaintFlags::kFill_Style);
+    dot.setAntiAlias(true);
+    dot.setColor(ink);
+    canvas->DrawCircle(centre, helium::kSpaceManageDotSize / 2.0f, dot);
+    return;
+  }
+  if (helium_workspace::IsVectorIconRef(icon)) {
+    if (const gfx::VectorIcon* vector = FindSpaceVectorIcon(
+            helium_workspace::VectorIconRefName(icon))) {
+      const gfx::ImageSkia image = gfx::CreateVectorIcon(
+          *vector, helium::kSpaceManageGlyphSize, ink);
+      canvas->DrawImageInt(image,
+                           static_cast<int>(std::round(centre.x() - glyph / 2)),
+                           static_cast<int>(std::round(centre.y() - glyph / 2)));
+    }
+    return;
+  }
+  const gfx::FontList font = gfx::FontList().DeriveWithSizeDelta(
+      helium::kSpaceManageGlyphSize - gfx::FontList().GetFontSize());
+  const float slot = glyph + 2.0f * helium::kSpaceManageEmojiSlop;
+  canvas->DrawStringRectWithFlags(
+      base::UTF8ToUTF16(icon), font, ink,
+      gfx::ToEnclosingRect(gfx::RectF(centre.x() - slot / 2,
+                                      centre.y() - slot / 2, slot, slot)),
+      gfx::Canvas::TEXT_ALIGN_CENTER | gfx::Canvas::NO_ELLIPSIS);
+}
+
+// Manage's card, materialised: a white card the illustration's size times
+// |scale|, and its shadow -- what its icon rides in on.
+void PaintSpaceCardBody(gfx::Canvas* canvas,
+                        const gfx::PointF& centre,
+                        float scale,
+                        float degrees) {
+  const float w = static_cast<float>(helium::kSpaceFormCardWidth) * scale;
+  const float h = static_cast<float>(helium::kSpaceFormCardHeight) * scale;
+  const float radius = static_cast<float>(helium::kSpaceFormCardRadius) * scale;
+  canvas->Save();
+  gfx::Transform t;
+  t.Translate(centre.x(), centre.y());
+  t.Rotate(degrees);
+  t.Translate(-centre.x(), -centre.y());
+  canvas->Transform(t);
+  const gfx::RectF card(centre.x() - w / 2, centre.y() - h / 2, w, h);
+  cc::PaintFlags shadow;
+  shadow.setStyle(cc::PaintFlags::kFill_Style);
+  shadow.setAntiAlias(true);
+  shadow.setColor(SkColorSetA(SK_ColorBLACK, 0x22));
+  gfx::RectF shadow_rect = card;
+  shadow_rect.Offset(0, 1.5f * scale);
+  canvas->DrawRoundRect(shadow_rect, radius, shadow);
+  cc::PaintFlags fill;
+  fill.setStyle(cc::PaintFlags::kFill_Style);
+  fill.setAntiAlias(true);
+  fill.setColor(SK_ColorWHITE);
+  canvas->DrawRoundRect(card, radius, fill);
+  canvas->Restore();
+}
+
+// The end card as it stands |ms| into its fill (0 short of it), |drawn| of
+// its outline drawn: the strip's card, and the flight's -- which carries a
+// fill the release cut short on from where it was, the same card, rather
+// than starting out filled (reviewer 4b-r5 r0). |base_scale| is its size
+// before the fill's swell; |degrees| tilts it and |card_opacity| fades it,
+// all but Manage's icon.
+void PaintEndCard(gfx::Canvas* canvas,
+                  const ui::ColorProvider* colors,
+                  bool create,
+                  const std::string& icon,
+                  const gfx::PointF& centre,
+                  double base_scale,
+                  double degrees,
+                  double ms,
+                  double drawn,
+                  double card_opacity) {
+  const SkColor ink = helium::GetSidebarRowTitleColor(
+      colors->GetColor(kColorToolbar), /*active=*/false);
+  const float scale = static_cast<float>(
+      base_scale * (1.0 + helium::SwipeEndFillSwell(ms)));
+  const float made = static_cast<float>(helium::SwipeEndMaterialize(ms));
+  const float opacity =
+      std::clamp(static_cast<float>(card_opacity), 0.0f, 1.0f);
+
+  // The card itself, as it materialises.
+  if (made > 0.0f && opacity > 0.0f) {
+    canvas->SaveLayerAlpha(
+        static_cast<uint8_t>(std::lround(made * opacity * 255)));
+    if (create) {
+      HeliumSpaceCreateFormView::PaintIllustrationCard(
+          canvas, centre, scale, static_cast<float>(degrees));
+    } else {
+      PaintSpaceCardBody(canvas, centre, scale, static_cast<float>(degrees));
+    }
+    canvas->Restore();
+  }
+  // Its outline -- a faint track all round, the drawn part darker -- and
+  // the "+", going as it materialises.
+  if (made < 1.0f && opacity > 0.0f) {
+    canvas->Save();
+    gfx::Transform tilt;
+    tilt.Translate(centre.x(), centre.y());
+    tilt.Rotate(degrees);
+    tilt.Translate(-centre.x(), -centre.y());
+    canvas->Transform(tilt);
+    const float w = static_cast<float>(helium::kSpaceFormCardWidth) * scale;
+    const float h = static_cast<float>(helium::kSpaceFormCardHeight) * scale;
+    const gfx::RectF card(centre.x() - w / 2, centre.y() - h / 2, w, h);
+    const SkPath outline = CardOutlinePath(
+        card, static_cast<float>(helium::kSpaceFormCardRadius) * scale,
+        /*clockwise=*/!create);
+    const float keep = (1.0f - made) * opacity;
+    cc::PaintFlags track;
+    track.setAntiAlias(true);
+    track.setStyle(cc::PaintFlags::kStroke_Style);
+    track.setStrokeWidth(1.3f);
+    track.setColor(SkColorSetA(
+        ink, static_cast<U8CPU>(std::lround(SkColorGetA(ink) * 0.16f * keep))));
+    canvas->DrawPath(outline, track);
+    if (drawn > 0.0) {
+      SkPathMeasure measure(outline, /*forceClosed=*/false);
+      SkPathBuilder part;
+      if (measure.getSegment(
+              0.0f, static_cast<float>(drawn) * measure.getLength(), &part,
+              /*startWithMoveTo=*/true)) {
+        cc::PaintFlags line;
+        line.setAntiAlias(true);
+        line.setStyle(cc::PaintFlags::kStroke_Style);
+        line.setStrokeWidth(
+            static_cast<float>(helium::kSpaceSwipeCardOutlineWidth));
+        line.setStrokeCap(cc::PaintFlags::kRound_Cap);
+        line.setColor(SkColorSetA(
+            ink, static_cast<U8CPU>(std::lround(SkColorGetA(ink) * keep))));
+        canvas->DrawPath(part.detach(), line);
+      }
+    }
+    if (create) {
+      constexpr float kArm = 5.0f;
+      cc::PaintFlags glyph;
+      glyph.setAntiAlias(true);
+      glyph.setStyle(cc::PaintFlags::kStroke_Style);
+      glyph.setStrokeWidth(1.8f);
+      glyph.setStrokeCap(cc::PaintFlags::kRound_Cap);
+      glyph.setColor(SkColorSetA(
+          ink, static_cast<U8CPU>(std::lround(SkColorGetA(ink) * keep))));
+      canvas->DrawLine(gfx::PointF(centre.x() - kArm, centre.y()),
+                       gfx::PointF(centre.x() + kArm, centre.y()), glyph);
+      canvas->DrawLine(gfx::PointF(centre.x(), centre.y() - kArm),
+                       gfx::PointF(centre.x(), centre.y() + kArm), glyph);
+    }
+    canvas->Restore();
+  }
+  // Manage's: the space's own icon, through all of it.
+  if (!create) {
+    PaintSpaceIcon(canvas, colors, icon, centre);
+  }
+}
+
+}  // namespace
+
+// The card at each end: past the last space one of the Create form's
+// illustration cards with a "+"; before the first the current space's own,
+// its icon inside. Its outline draws as the fingers go; filled in, it
+// materialises. Drawn in a strip along its own edge of the sidebar, which
+// cuts it off while the lists have not yet made room for all of it, and
+// moved by repainting that strip -- no layout, no bounds change per frame.
+class VerticalTabStripRegionView::SwipeEndCard
+    : public views::View,
+      public gfx::AnimationDelegate {
+  METADATA_HEADER(SwipeEndCard, views::View)
+
+ public:
+  // kLast: at the right edge, Create a Space. kFirst: at the left edge,
+  // Manage Spaces.
+  enum class End { kLast, kFirst };
+
+  // Room for the card as far in as the rubber band can ever bring it, its
+  // swell and its shadow.
+  static constexpr int kWidth = 144;
+  static constexpr int kHeight = 48;
+  static_assert(kWidth >= helium::kSpaceSwipeEndTravelLimit + 5.0);
+  static_assert(kHeight >= helium::kSpaceSwipeCardHeight *
+                                   (1.0 + helium::kSpaceSwipeEndSwell) +
+                               6.0);
+
+  explicit SwipeEndCard(End end)
+      : end_(end),
+        fill_(helium::kSpaceSwipeEndFill,
+              gfx::LinearAnimation::kDefaultFrameRate,
+              this) {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    SetCanProcessEventsWithinSubtree(false);
+    SetVisible(false);
+  }
+  SwipeEndCard(const SwipeEndCard&) = delete;
+  SwipeEndCard& operator=(const SwipeEndCard&) = delete;
+  ~SwipeEndCard() override = default;
+
+  // kFirst: the current space's icon ("" -- the dot).
+  void SetIcon(const std::string& icon) {
+    if (icon_ != icon) {
+      icon_ = icon;
+      SchedulePaint();
+    }
+  }
+  const std::string& icon() const { return icon_; }
+
+  // |past|: points of 0.5 × finger beyond this card's end of the strip.
+  // |fingers_on|: the two fingers are still on the trackpad -- the only
+  // time a tap can be felt (4b-r4).
+  void SetPast(double past, bool fingers_on) {
+    past_ = past;
+    const bool solid = helium::SwipeEndSolid(past);
+    if (solid != solid_) {
+      solid_ = solid;
+      if (solid) {
+        fill_.Start();
+#if BUILDFLAG(IS_MAC)
+        // 4b-r4: with the fill, one tap of the trackpad under the fingers.
+        if (fingers_on) {
+          SpaceSwipeMonitorMac::PerformEndDiscHaptic();
+        }
+#endif
+      } else {
+        fill_.Stop();
+      }
+    }
+    if (!held_away_) {
+      SetVisible(past > 0.0);
+    }
+    SchedulePaint();
+  }
+
+  bool solid() const { return solid_; }
+  // How far into its fill (arc_space_motion.h) the card is, in ms: 0 short
+  // of it, the fill's length once it is done.
+  double FillMs() const {
+    if (!solid_) {
+      return 0.0;
+    }
+    return (fill_.is_animating() ? fill_.GetCurrentValue() : 1.0) *
+           helium::kSpaceSwipeEndFill.InMillisecondsF();
+  }
+  // Where the card's centre is, in this view's coordinates.
+  gfx::PointF Centre() const {
+    const float inset =
