+TEST(ArcSpaceMotionTest, ThePageTurnRidesTheSwitchSpringAndTheCardFliesIn) {
+  // A release on a filled card turns the page on the switch's own spring,
+  // from rest: half-way at 53ms, settled where a one-space slide does.
+  EXPECT_DOUBLE_EQ(0.0, SheetSlideAt(0.0).x);
+  EXPECT_DOUBLE_EQ(0.0, SheetSlideAt(-1.0).x);
+  EXPECT_NEAR(0.5, SheetSlideAt(0.0534).x, 0.002);
+  for (double t : {0.02, 0.1, 0.25}) {
