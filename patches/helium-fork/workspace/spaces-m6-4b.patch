+bool VerticalTabStripRegionView::CanStartSpaceSwipe(const gfx::Point& point) {
+  // 4b-r2: nor while a page turn is still bringing a sheet in -- it is as
+  // good as up.
+  if (!carousel_ || !GetVisible() || sheet_ || IsSheetSliding() ||
+      !GetLocalBounds().Contains(point)) {
+    return false;
+  }
+  // ⛔ The top row is the window's drag area and the traffic lights' (brief
+  // 4b-1; Arc not measured there). Everything below it is the sidebar's --
+  // the address row, the favorites, the lists, the blank, the bar (Arc g43
+  // / g44 s1).
+  if (arc_top_container_ && arc_top_container_->GetVisible() &&
+      point.y() < arc_top_container_->bounds().bottom()) {
+    return false;
+  }
+  // Gates (brief 4b-10): judged when the gesture begins; a gesture that
+  // does not pass is left alone whole, momentum included.
+  if (state_controller_->GetCollapseState() !=
+          tabs::VerticalTabStripCollapseState::kExpanded ||
+      (resize_area_ && resize_area_->is_resizing()) ||
+      views::MenuController::GetActiveInstance()) {
+    return false;
+  }
+  if (browser_view()) {
+    if (const HeliumSidebarMenuView* const menu =
+            browser_view()->helium_sidebar_menu();
+        menu && menu->GetVisible()) {
+      return false;
+    }
+  }
+  if (const WorkspaceSidebarView* const sidebar = WorkspaceDragSidebar();
+      sidebar && sidebar->IsBusyForSpaceSwipe()) {
+    return false;
+  }
+  if (const UnpinnedTabContainerView* const today = TodayDropContainer();
+      today && today->IsDragging()) {
+    return false;
+  }
+  return true;
+}
