+  EXPECT_DOUBLE_EQ(0.0, SwipeCardStackFan(0.0));
+  EXPECT_DOUBLE_EQ(0.0, SwipeCardStackFan(0.55));
+  EXPECT_NEAR(0.5, SwipeCardStackFan(0.775), 1e-9);
