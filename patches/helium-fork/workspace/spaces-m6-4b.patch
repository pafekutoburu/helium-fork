+// How far the lists -- and the card at that end -- have moved for |past|
+// points of 0.5 × finger beyond either end of the strip.
+inline double SwipeEndTravel(double past) {
+  if (past <= 0.0) {
+    return 0.0;
+  }
+  // k·ln(1 + e^(x/k)), without overflow either way.
+  const auto soft = [](double x) {
+    constexpr double k = kSpaceSwipeEndSlackKnee;
+    return x > 0.0 ? x + k * std::log1p(std::exp(-x / k))
+                   : k * std::log1p(std::exp(x / k));
+  };
+  const double taken =
+      kSpaceSwipeEndSlackGive * past +
+      (1.0 - kSpaceSwipeEndSlackGive) *
+          (soft(past - kSpaceSwipeEndSlack) - soft(-kSpaceSwipeEndSlack));
+  const double linear = kSpaceSwipeEndRate * taken;
+  return linear / (1.0 + linear / kSpaceSwipeEndTravelLimit);
+}
+
+// How far beyond the lists' edge an end's card rides: what the slack gives
+// (≈5.9pt), so the card's near side reaches the sidebar's edge just as the
+// slack is taken up.
+inline double SwipeEndGap() {
+  return SwipeEndTravel(kSpaceSwipeEndSlack);
+}
+
+// ---- M6 轮4 4b: the two-finger swipe (tasks/4/brief.md §3) ----
+
+// Where the fingers have taken the carousel, in slots: from |start_x|, 0.5 ×
+// the fingers' horizontal travel (Arc g39), |width| points to a slot.
+// Natural scrolling: scrollingDeltaX > 0 moves the content right, toward
+// the previous space -- lower slots. Unbounded: SwipeShownX has the ends.
+inline double SwipeDragX(double start_x, double finger_dx, double width) {
+  return width > 0.0 ? start_x - kSpaceSwipeFollowRatio * finger_dx / width
+                     : start_x;
+}
+
+// How far beyond an end of the strip the carousel at |x| (slots of |width|
+// points) is, in points of 0.5 × finger: past the last slot, before the
+// first.
+inline double SwipePastLast(double x, int last, double width) {
+  return x > last ? (x - last) * width : 0.0;
+}
+inline double SwipeBeforeFirst(double x, int first, double width) {
+  return x < first ? (first - x) * width : 0.0;
+}
+
+// Where the lists show a carousel at |x| (slots; a drag and its spring back
+// may take x past either end): beyond an end they give SwipeEndTravel of
+// it, the same at both.
+inline double SwipeShownX(double x, int first, int last, double width) {
+  if (width <= 0.0) {
+    return std::clamp(x, static_cast<double>(first), static_cast<double>(last));
+  }
+  if (x > last) {
+    return last + SwipeEndTravel(SwipePastLast(x, last, width)) / width;
+  }
+  if (x < first) {
+    return first - SwipeEndTravel(SwipeBeforeFirst(x, first, width)) / width;
+  }
+  return x;
+}
+
+// ---- 4b-r5: the card at each end (user 2026-10-01, decisions 「M6 轮4」⑮) ----
+//
+// Past the last space, one of the Create form's illustration cards
+// (arc_space_form.h) at 5/6 its size, a "+" inside; before the first, the
+// current space's own card, its icon inside. It rides the lists' edge, the
+// slack's gap beyond it (the disc's rule since 4b-r1), its outline drawing
+// as the fingers go -- from 12 o'clock, their way: anticlockwise past the
+// last space, clockwise before the first. Filled in, it materialises --
+// Create's into the illustration's card, Manage's into a white card under
+// its icon -- and a release flies it through the page turn to where it
+// lands in the incoming sheet (SwipeCardFlightAt).
+inline constexpr double kSpaceSwipeCardScale = 5.0 / 6.0;
+inline constexpr double kSpaceSwipeCardWidth =
+    kSpaceFormCardWidth * kSpaceSwipeCardScale;
+inline constexpr double kSpaceSwipeCardHeight =
+    kSpaceFormCardHeight * kSpaceSwipeCardScale;
+inline constexpr double kSpaceSwipeCardOutlineWidth = 1.6;
+
+// An end's card: its centre, in points in from the sidebar's edge on its
+// side (negative: still outside it), for |past| points of 0.5 × finger
+// beyond that end.
+inline double SwipeEndCardCenterInset(double past) {
+  return SwipeEndTravel(past) - (SwipeEndGap() + kSpaceSwipeCardWidth / 2.0);
+}
+
+// How much of the card's outline is drawn, 0..1 -- from where the card
+// starts to come in to where it fills in.
+inline double SwipeEndOutline(double past) {
+  return std::clamp((past - kSpaceSwipeEndSlack) /
+                        (kSpaceSwipeEndSolidAt - kSpaceSwipeEndSlack),
+                    0.0, 1.0);
+}
+
+// Whether the card is filled in -- a release now opens that end's sheet,
+// and nothing short of it does: a flick goes back like any release (⚠ ours;
+// Arc's flick on a ⊕ still hollow was not measured).
+inline bool SwipeEndSolid(double past) {
+  return past >= kSpaceSwipeEndSolidAt;
+}
+
+// ---- Filling in (4b-r4; the card's since 4b-r5) ----
+//
+// The user's recording of Arc 1.166.0 (2026-10-01, two pulls, alike;
+// tasks/evidence/4b-r4/user-arc-recording), read at ~60fps -- finer than 4b's
+// reading of g42 (180ms, a swell to 33.5pt, the glyph turning light at the
+// end): the frame the ring closes the dark "+" goes; the white inside
+// shrinks to nothing in 150ms, leaving the glyph white on the dark disc; the
+// disc swells from 45ms, most at 115ms (+12%), and is back by 185ms. The
+// trackpad gives one tap with it (user: 「触控板会有一下震动，跟弹动的动画是
+// 同步的」 -- ⚠ which of macOS's patterns Arc plays was not measured).
+// 4b-r5: the card materialises over those first 150ms -- its white and its
+// screen coming up as the outline and the "+" go -- and swells the same.
+inline constexpr base::TimeDelta kSpaceSwipeEndFill = base::Milliseconds(200);
+inline constexpr double kSpaceSwipeEndMaterializeMs = 150.0;
+inline constexpr double kSpaceSwipeEndSwell = 0.12;
+inline constexpr double kSpaceSwipeEndSwellFromMs = 45.0;
+inline constexpr double kSpaceSwipeEndSwellToMs = 185.0;
+
+// How far the card has materialised |ms| into the fill, 0..1.
+inline double SwipeEndMaterialize(double ms) {
+  return std::clamp(ms / kSpaceSwipeEndMaterializeMs, 0.0, 1.0);
+}
+
+// The card's swell |ms| into the fill: it is (1 + this) of its size.
+inline double SwipeEndFillSwell(double ms) {
+  if (ms <= kSpaceSwipeEndSwellFromMs || ms >= kSpaceSwipeEndSwellToMs) {
+    return 0.0;
+  }
+  return kSpaceSwipeEndSwell *
+         std::sin(std::numbers::pi * (ms - kSpaceSwipeEndSwellFromMs) /
+                  (kSpaceSwipeEndSwellToMs - kSpaceSwipeEndSwellFromMs));
+}
+
+// The page turn after a release on a filled card: how far along it is, 0..1,
+// |t| seconds in -- the switch's spring from rest.
+inline SpringState SheetSlideAt(double t) {
+  return StepCriticalSpring({0.0, 0.0}, 1.0, kSpaceSlideOmega,
+                            std::max(0.0, t));
+}
+
+// 4b-r5: the card through the page turn. It leaves from where the release
+// left it and lands where it belongs in the incoming sheet -- Create's on
+// the form's illustration as its front card, Manage's in the current
+// space's row as its icon -- on the turn's own spring (|g|, 0..1, is the
+// turn's progress), so it lands as the sheet does; an Esc on the way flies
+// it back the same way. Its path is the one in the animation the user
+// approved (tasks/evidence/4b-r5/anim/anim.py; 2026-10-01 「就按这个做」): a
+// quadratic Bézier whose control point is 40pt from where it left, the way
+// the page goes, and 60pt below the middle of its rise -- it sets off with
+// the page and climbs late. It tilts toward the way the page goes at
+// mid-flight (7°) and grows (Create: 5/6 to the illustration's size); as
+// it lands, the form's two back cards fan open to ±kSpaceFormCardFan
+// (SwipeCardStackFan). Manage's -- ⚠ ours, the animation only showed
+// Create -- is its mirror, shrinking to 0.55 of the illustration card, the
+// card fading out over the last 40% so that its icon lands alone.
+inline constexpr double kSpaceSwipeCardFlightLead = 40.0;
+inline constexpr double kSpaceSwipeCardFlightSag = 60.0;
+inline constexpr double kSpaceSwipeCardFlightTilt = 7.0;
+inline constexpr double kSpaceSwipeCardLandScale = 0.55;
+inline constexpr double kSpaceSwipeCardFadeFrom = 0.6;
+inline constexpr double kSpaceSwipeCardFanFrom = 0.55;
+
+struct SwipeCardFlight {
+  // The card's centre (the flight's own coordinates, pt).
+  double x = 0.0;
+  double y = 0.0;
+  // Of the illustration card's size.
+  double scale = 1.0;
+  // About its centre, clockwise.
+  double degrees = 0.0;
+  // The card's own, not its icon's.
+  double card_opacity = 1.0;
+};
+
+// |way|: -1 when the page goes left (Create), +1 right (Manage).
+inline SwipeCardFlight SwipeCardFlightAt(double g,
+                                         double from_x,
+                                         double from_y,
+                                         double to_x,
+                                         double to_y,
+                                         double from_scale,
+                                         double to_scale,
+                                         int way,
+                                         bool lands_as_icon) {
+  const double t = std::clamp(g, 0.0, 1.0);
+  const double via_x = from_x + way * kSpaceSwipeCardFlightLead;
+  const double via_y = (from_y + to_y) / 2.0 + kSpaceSwipeCardFlightSag;
+  const double a = (1.0 - t) * (1.0 - t);
+  const double b = 2.0 * (1.0 - t) * t;
+  const double c = t * t;
+  SwipeCardFlight out;
+  out.x = a * from_x + b * via_x + c * to_x;
+  out.y = a * from_y + b * via_y + c * to_y;
+  out.scale = from_scale + (to_scale - from_scale) * t;
+  out.degrees =
+      way * kSpaceSwipeCardFlightTilt * std::sin(std::numbers::pi * t);
+  if (lands_as_icon && t > kSpaceSwipeCardFadeFrom) {
+    const double f =
+        (t - kSpaceSwipeCardFadeFrom) / (1.0 - kSpaceSwipeCardFadeFrom);
+    out.card_opacity = 1.0 - f * f * (3.0 - 2.0 * f);
+  }
+  return out;
+}
+
+// How far Create's two back cards have fanned open, 0..1 of
+// ±kSpaceFormCardFan, |g| into the turn: closed behind where the front card
+// lands until it is 55% of the way, open as it lands (the animation's).
+inline double SwipeCardStackFan(double g) {
+  return std::clamp(
+      (g - kSpaceSwipeCardFanFrom) / (1.0 - kSpaceSwipeCardFanFrom), 0.0, 1.0);
 }
 
