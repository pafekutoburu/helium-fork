+        StepCriticalSpring({0.0, 0.0}, 1.0, kSpaceSlideOmega, t).x,
+        SheetSlideAt(t).x)
+        << t;
+  }
+  EXPECT_FALSE(SpringSettled(SheetSlideAt(0.25), 1.0, 299.0));
+  EXPECT_TRUE(SpringSettled(SheetSlideAt(0.33), 1.0, 299.0));
+
+  // 4b-r5: Create's card leaves from where the release left it and lands as
+  // the form's front card, on the turn's own progress.
+  const auto create = [](double g) {
+    return SwipeCardFlightAt(g, 214.0, 450.0, 130.0, 119.0,
+                             kSpaceSwipeCardScale, 1.0, -1, false);
+  };
+  EXPECT_DOUBLE_EQ(214.0, create(0.0).x);
+  EXPECT_DOUBLE_EQ(450.0, create(0.0).y);
+  EXPECT_DOUBLE_EQ(kSpaceSwipeCardScale, create(0.0).scale);
+  EXPECT_DOUBLE_EQ(0.0, create(0.0).degrees);
+  EXPECT_NEAR(130.0, create(1.0).x, 1e-9);
+  EXPECT_DOUBLE_EQ(119.0, create(1.0).y);
+  EXPECT_DOUBLE_EQ(1.0, create(1.0).scale);
+  EXPECT_NEAR(0.0, create(1.0).degrees, 1e-9);
+  // The animation's path: a quadratic Bézier through (214 - 40, the
+  // rise's middle + 60) = (174, 344.5). A quarter of the way it has gone
+  // 20pt the page's way but risen only 60 -- (193.75, 389.75); half-way it
+  // is at (173, 314.5), 30pt below the straight line's middle (172, 284.5).
+  // Tilted 7° toward the way the page goes at mid-flight; its own card
+  // never fades.
+  EXPECT_NEAR(193.75, create(0.25).x, 1e-9);
+  EXPECT_NEAR(389.75, create(0.25).y, 1e-9);
+  EXPECT_NEAR(173.0, create(0.5).x, 1e-9);
+  EXPECT_NEAR(314.5, create(0.5).y, 1e-9);
+  EXPECT_NEAR(-7.0, create(0.5).degrees, 1e-9);
+  for (double g : {0.0, 0.3, 0.7, 1.0}) {
