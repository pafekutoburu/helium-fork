+std::unique_ptr<HeliumViewSnapshotLayer>
+VerticalTabStripRegionView::BuildSheetPicture(
+    SidebarSheetKind kind,
+    std::optional<gfx::PointF>* landing) {
+  if (!browser_view() || !layer() || width() <= 0) {
+    return nullptr;
+  }
+  // Where ShowSidebarSheet puts the sheet: in the address row's place (it
+  // hides the row; the top row's gap stays above) down to the bar, less the
+  // gap the bar keeps above whatever stands over it -- the flex layout
+  // collapses the sheet's zero margin and the bar's kBottomContainerGap
+  // into the larger. (4b's stand-in reached the bar itself: 2pt long.)
+  const int top = arc_address_row_ && arc_address_row_->GetVisible()
+                      ? arc_address_row_->y()
+                      : (arc_top_container_
+                             ? arc_top_container_->bounds().bottom() +
+                                   kArcTopContainerGap
+                             : 0);
+  const int bottom = space_bar_ && space_bar_->GetVisible()
+                         ? space_bar_->y() - kBottomContainerGap
+                         : height();
+  if (bottom <= top) {
+    return nullptr;
+  }
+  // A copy of the sheet, in the widget for one paint and gone again in this
+  // same task: no frame shows it, and it takes no focus and arms no Escape
+  // (SetForPicture).
+  std::unique_ptr<views::View> sheet;
+  HeliumSpaceManageView* manage_copy = nullptr;
+  if (kind == SidebarSheetKind::kCreateForm) {
+    auto form = std::make_unique<HeliumSpaceCreateFormView>(
+        base::DoNothing(), base::DoNothing(), base::DoNothing());
+    form->SetForPicture();
+    // 4b-r5: the illustration is the flight's -- its front card the one in
+    // flight, its back two fanning open under it.
+    if (landing) {
+      form->SetIllustrationHidden();
+    }
+    sheet = std::move(form);
+  } else {
+    auto manage = std::make_unique<HeliumSpaceManageView>(
+        browser_view()->browser(), base::DoNothing(), base::DoNothing(),
+        base::DoNothing(), base::DoNothing());
+    manage->SetForPicture();
+    manage_copy = manage.get();
+    sheet = std::move(manage);
+  }
+  sheet->SetProperty(views::kViewIgnoredByLayoutKey, true);
+  views::View* const copy = AddChildView(std::move(sheet));
+  copy->SetBounds(0, top, width(), bottom - top);
+  copy->DeprecatedLayoutImmediately();
+  // 4b-r5: where the card in flight lands, in this view's coordinates --
+  // the form's front card, or the current space's icon slot in Manage
+  // (left empty in the picture; none when its row is out of sight).
+  if (landing) {
+    if (kind == SidebarSheetKind::kCreateForm) {
+      gfx::PointF at =
+          HeliumSpaceCreateFormView::IllustrationCentre(copy->size());
+      at.Offset(copy->x(), copy->y());
+      *landing = at;
+    } else if (helium_workspace::WorkspaceTabController* const controller =
+                   CarouselController();
+               controller && manage_copy) {
+      const std::string current = controller->current_space_id();
+      if (std::optional<gfx::PointF> at = manage_copy->IconCentreFor(current)) {
+        manage_copy->HideIconForPicture(current);
+        at->Offset(copy->x(), copy->y());
+        *landing = at;
+      }
+    }
+  }
+  std::unique_ptr<HeliumViewSnapshotLayer> picture =
+      HeliumViewSnapshotLayer::Capture(copy, copy->GetLocalBounds(),
+                                       layer()->device_scale_factor());
+  RemoveChildViewT(copy);
+  if (!picture) {
+    return nullptr;
+  }
+  picture->layer()->SetBounds(gfx::Rect(0, top, width(), bottom - top));
+  layer()->Add(picture->layer());
+  return picture;
+}
+
+void VerticalTabStripRegionView::StartSheetSlide(SidebarSheetKind kind) {
+  const auto show_now = [this, kind] {
+    if (kind == SidebarSheetKind::kCreateForm) {
+      ShowSpaceCreateForm();
+    } else {
+      ShowSpaceManageSheet();
+    }
+  };
+  if (!sheet_slide_ || IsSheetSliding() || sheet_ || !GetWidget() ||
+      !layer() || width() <= 0) {
+    show_now();
+    return;
+  }
+  // 4b-r5: the card the release was on flies into the sheet.
+  SwipeEndCard* const card = kind == SidebarSheetKind::kCreateForm
+                                 ? swipe_plus_.get()
+                                 : swipe_manage_.get();
+  const bool flies = card && card->GetVisible() && card->solid();
+  std::optional<gfx::PointF> landing;
+  std::unique_ptr<HeliumViewSnapshotLayer> picture =
+      BuildSheetPicture(kind, flies ? &landing : nullptr);
+  if (!picture) {
+    // No picture to slide: the sheet is simply there (4b-r1's way).
+    show_now();
+    return;
+  }
+  // The old page: everything that stands where the sheet will -- the
+  // address row, the strip (favorites and lists, the lists still where the
+  // rubber band has them), the row shadows riding them, and the undo bar /
+  // media capsules / the media hover panel when they are up (reviewer
+  // 4b-r2 diff r0: the panel is its own child of this view). All have
+  // layers; nothing re-lays out while it goes, and none of it takes a click
+  // on its way out.
+  std::vector<SheetSlide::Moved> page;
+  const auto take = [&page](views::View* view) {
+    if (view && view->GetVisible() && view->layer()) {
+      page.push_back({view, view->GetCanProcessEventsWithinSubtree()});
+      view->SetCanProcessEventsWithinSubtree(false);
+    }
+  };
+  for (views::View* view :
+       {static_cast<views::View*>(arc_address_row_.get()),
+        static_cast<views::View*>(tab_strip_view()),
+        static_cast<views::View*>(row_shadow_host_.get()),
+        static_cast<views::View*>(undo_bar_.get()),
+        static_cast<views::View*>(media_strip_.get()),
+        static_cast<views::View*>(media_strip_shadow_.get()),
+        static_cast<views::View*>(media_strip_panel_.get()),
+        static_cast<views::View*>(media_strip_panel_shadow_.get())}) {
+    take(view);
+  }
+  if (media_overlay_stack_ && media_overlay_stack_->GetVisible()) {
+    for (views::View* child : media_overlay_stack_->children()) {
+      take(child);
+    }
+  }
+  // The bar takes the sheet's shape with the release (⚠ at once for now --
+  // its icons making way is 4c, Arc g45 ω≈26).
+  if (space_bar_) {
+    space_bar_->SetFormMode(kind == SidebarSheetKind::kCreateForm
+                                ? WorkspaceSpaceBarView::FormMode::kCreate
+                                : WorkspaceSpaceBarView::FormMode::kManage);
+  }
+  // The picture comes in from beyond one edge and the page goes out over
+  // the other: the sidebar clips both while they move.
+  const bool was_masked = layer()->GetMasksToBounds();
+  layer()->SetMasksToBounds(true);
+  if (flies) {
+    if (!card_flight_) {
+      card_flight_ = AddChildView(std::make_unique<SwipeCardFlight>());
+      card_flight_->SetProperty(views::kViewIgnoredByLayoutKey, true);
+    }
+    card_flight_->SetBoundsRect(GetLocalBounds());
+    gfx::PointF from = card->Centre();
+    from.Offset(card->x(), card->y());
+    // A Manage row out of the list's sight: nowhere to land -- the card
+    // leaves with the page instead.
+    const float way =
+        kind == SidebarSheetKind::kCreateForm ? -1.0f : 1.0f;
+    const gfx::PointF to = landing.value_or(
+        gfx::PointF(from.x() + way * width(), from.y()));
+    card_flight_->Start({kind == SidebarSheetKind::kCreateForm, from, to,
+                         card->icon(), card->FillMs(),
+                         static_cast<float>(width())});
+    // Over the picture and the page alike (and kept there through any
+    // re-stack: ReorderChildLayers).
+    if (card_flight_->layer()->parent() == layer()) {
+      layer()->StackAtTop(card_flight_->layer());
+    }
+    card->SetHeldAway(true);
+  }
+  sheet_slide_->Start(kind, std::move(picture), std::move(page), width(),
+                      was_masked);
+  ApplySheetSlide(0.0);
+}
+
+void VerticalTabStripRegionView::ApplySheetSlide(double progress) {
+  if (!IsSheetSliding() || !sheet_slide_->picture()) {
+    return;
+  }
+  // Create: the page goes on to the left and the form follows it in from
+  // the right -- the way the fingers went. Manage: the mirror.
+  const float way =
+      sheet_slide_->kind() == SidebarSheetKind::kCreateForm ? -1.0f : 1.0f;
+  const float w = static_cast<float>(sheet_slide_->width());
+  const float p = static_cast<float>(progress);
+  const gfx::Transform page = gfx::Transform::MakeTranslation(way * p * w, 0.0f);
+  for (const SheetSlide::Moved& moved : sheet_slide_->page()) {
+    if (moved.view->layer()) {
+      moved.view->layer()->SetTransform(page);
+    }
+  }
+  sheet_slide_->picture()->layer()->SetTransform(
+      gfx::Transform::MakeTranslation(-way * (1.0f - p) * w, 0.0f));
+  // 4b-r5: the card flies on the same progress, landing as the sheet does.
+  if (card_flight_ && card_flight_->GetVisible()) {
+    card_flight_->SetProgress(progress);
+  }
+}
+
+bool VerticalTabStripRegionView::CancelSheetSlide() {
+  if (!IsSheetSliding() || !sheet_slide_->Reverse()) {
+    return false;
+  }
+  // The bar goes back with the cancel, as it changed with the release.
+  if (space_bar_ && !sheet_) {
+    space_bar_->SetFormMode(WorkspaceSpaceBarView::FormMode::kNone);
+  }
+  return true;
+}
+
+void VerticalTabStripRegionView::EndSheetSlide(bool show,
+                                               bool spring_lists_back) {
+  if (!IsSheetSliding()) {
+    return;
+  }
+  // Turned back with Esc: no sheet, whatever cuts the turn short.
+  if (sheet_slide_->reversing()) {
+    show = false;
+  }
+  const SidebarSheetKind kind = sheet_slide_->kind();
+  const std::vector<SheetSlide::Moved> page = sheet_slide_->page();
+  const bool was_masked = sheet_slide_->was_masked();
+  // Idle first: what follows (ShowSidebarSheet) comes back through here.
+  sheet_slide_->Reset();
+  if (show) {
+    // The real sheet where the picture stood -- ShowSidebarSheet lands the
+    // carousel (the lists back at rest, the cards away) and hides the old
+    // page, all before the next frame; the card in flight has just landed
+    // where the sheet's own takes over.
+    if (kind == SidebarSheetKind::kCreateForm) {
+      ShowSpaceCreateForm();
+    } else {
+      ShowSpaceManageSheet();
+    }
+  } else if (!sheet_) {
+    // Turned back all the way: the lists the release left on the rubber band
+    // go home like any release short of the disc, the disc riding out on
+    // their edge. Dropped (the sidebar going, another sheet coming): at once.
+    if (carousel_) {
+      if (spring_lists_back) {
+        carousel_->ReleaseHold();
+      } else {
+        carousel_->Stop();
+      }
+    }
+    if (space_bar_) {
+      space_bar_->SetFormMode(WorkspaceSpaceBarView::FormMode::kNone);
+    }
+  }
+  // Everything the turn moved, back where it lives.
+  for (const SheetSlide::Moved& moved : page) {
+    if (moved.view->layer()) {
+      moved.view->layer()->SetTransform(gfx::Transform());
+    }
+    moved.view->SetCanProcessEventsWithinSubtree(moved.could_process_events);
+  }
+  // The card: landed (the sheet's own is there now), or -- turned back --
+  // home on its lists' edge, which spring it out from where the flight
+  // brought it back to.
+  if (card_flight_) {
+    card_flight_->Stop();
+  }
+  for (SwipeEndCard* const card : {swipe_plus_.get(), swipe_manage_.get()}) {
+    if (card) {
+      card->SetHeldAway(false);
+    }
+  }
+  if (layer()) {
+    layer()->SetMasksToBounds(was_masked);
+  }
+  // Back on the page: whatever was held off during the turn (a media capsule
+  // that arrived meanwhile) comes up now. With the sheet up there is none.
+  if (!sheet_) {
+    UpdateMediaStripVisibility();
+  }
+}
