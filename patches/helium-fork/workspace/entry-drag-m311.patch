+  bool active_ = false;
+  ui::ImageModel favicon_;
+  std::u16string title_;
+  SkColor surface_ = SK_ColorTRANSPARENT;
+  SkColor text_color_ = SK_ColorTRANSPARENT;
+  gfx::Size row_size_;
+  gfx::Size capsule_size_;
+  gfx::Vector2dF grab_;
+  gfx::Point pointer_;
+  // Where the card logically is, in the parent's coordinates. The view's own
+  // bounds sit at the origin and the offset rides on the layer transform (see
+  // ApplyBounds), so this is what the settle path has to read.
+  gfx::Rect card_rect_;
+
+  // 0 = row, 1 = capsule; the tween runs between them.
+  bool as_capsule_ = false;
+  // The morph value the current layer contents were painted at. OnPaint reads
+  // nothing else that moves, so this is the whole repaint trigger (a pure
+  // translation of a layer-backed view needs none).
+  double painted_morph_ = -1.0;
+  gfx::SlideAnimation morph_animation_{this};
+  gfx::SlideAnimation settle_animation_{this};
+  gfx::Rect settle_from_;
+  gfx::Rect settle_to_;
+  base::OnceClosure settle_done_;
+
+  raw_ptr<HeliumCardShadowView> shadow_ = nullptr;
+};
