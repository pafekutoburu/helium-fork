+  // down, as a fraction of its size, so the card keeps sitting under the
+  // pointer as it changes shape.
+  void Start(const ui::ImageModel& favicon,
+             const std::u16string& title,
+             SkColor surface,
+             SkColor text_color,
+             const gfx::Size& row_size,
+             const gfx::Vector2dF& grab);
+  // Pointer moved, in this view's parent's coordinates.
+  void SetPointer(const gfx::Point& point_in_parent);
+  // The shape the card should be wearing: a full row, or a grid capsule of
+  // |form_size|. Morphs over kSidebarDragMorphDuration.
+  void SetForm(bool as_capsule, const gfx::Size& form_size);
+  // Flies to |target| (parent coordinates) over kSidebarDragSettleDuration
+  // and then runs |done|. One motion for both endings -- Dia measures the
+  // same curve for a drop and for an ESC.
+  void SettleTo(const gfx::Rect& target, base::OnceClosure done);
+  void Stop();
+
+  bool active() const { return active_; }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+
+  // views::AnimationDelegateViews:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+ private:
+  // Where the card sits right now: under the grab point while dragging, or
+  // along the settle path once it has been let go.
+  gfx::Rect CurrentRect() const;
+  void ApplyBounds();
+  // Re-asserts "card above shadow above everything else" -- layer order does
+  // not follow view order, and the strip below owns a layer.
+  void StackLayersOnTop();
