+
+void WorkspaceSidebarView::SetFolderDropTarget(bool folder_drop) {
+  const bool now = drag_ && folder_drop;
+  if (auto* header = views::AsViewClass<WorkspaceSpaceHeader>(space_header_)) {
+    header->SetDropTarget(now);
+  }
+  if (!drag_ || drag_->folder_drop == now) {
+    return;
+  }
+  // The hole appears or disappears with this flag, so the layout has to be
+  // told even when the plan itself did not move.
+  drag_->folder_drop = now;
+  drag_->form_dirty = true;
+  drag_->hit_dirty = true;
+  InvalidateLayout();
+  SchedulePaint();
+}
+
+void WorkspaceSidebarView::RetargetDragYield() {
+  drag_prev_layout_ = CurrentLayout(width());
+  drag_prev_layout_valid_ = true;
+  drag_yield_animation_.Reset(0.0);
+  drag_yield_animation_.Show();
+}
+
+void WorkspaceSidebarView::EndDragSession() {
+  if (!drag_ || drag_->settling) {
+    return;
+  }
+  DragPerfFinish();
+  // Let the rows glide from wherever the preview left them to the settled
+  // layout -- after a drop that is a no-op (they are already there); after a
+  // cancel it is the fold-back.
+  RetargetDragYield();
+  // The entry rejoins the layout now, but its row stays hidden until the
+  // floating card lands on it: the card *is* the row until then, and
+  // revealing both would show it twice.
+  drag_->settling = true;
+  if (today_container_ && drag_->plan_today_index) {
+    today_container_->InvalidateLayout();
+  }
+  PreferredSizeChanged();
+  InvalidateLayout();
+  SchedulePaint();
+
+  if (!drag_overlay_ || !drag_overlay_->active()) {
+    FinishDragSettle();
+    return;
+  }
+  drag_overlay_->SettleTo(SettledDragTargetInOverlaySpace(),
+                          base::BindOnce(&WorkspaceSidebarView::FinishDragSettle,
+                                         weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceSidebarView::FinishDragSettle() {
+  SetFolderDropTarget(false);
+  drag_.reset();
+  if (drag_overlay_) {
+    drag_overlay_->Stop();
+  }
+  if (today_container_) {
+    today_container_->SetWorkspaceEntryDragActive(false);
+  }
+  // The folder stays shut and just shows what was dropped into it -- `Arc:`
+  // reveals the one entry, not the whole folder (user 2026-08-25).
+  if (!drop_surfaced_entry_id_.empty() && space_collapsed_ &&
+      surfaced_entry_ids_.insert(drop_surfaced_entry_id_).second) {
+    PreferredSizeChanged();
+  }
+  PreferredSizeChanged();
+  InvalidateLayout();
+  SchedulePaint();
+  // The row that was floating is only made visible again by the layout this
+  // just asked for, so ask views what is under the pointer one turn later --
+  // hit testing skips a hidden view, and the answer would be "the sidebar".
+  ScheduleHoverResync();
+}
+
+void WorkspaceSidebarView::ScheduleHoverResync() {
+  // Always posted: the bounds this reads are the ones the layout it follows
+  // is about to write, and hit-testing the pointer against the old ones is
+  // the very mistake being repaired.
+  if (hover_resync_pending_) {
+    return;
+  }
+  hover_resync_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspaceSidebarView::ResyncHoverFromCursor,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceSidebarView::ClearStaleHovers() {
+  // Hover is latched from mouse enter/exit, and both a drag (the pointer
+  // belongs to the OS for the whole gesture) and a plain relayout can take a
+  // view out from under a pointer that never moves -- no exit is ever sent,
+  // and the card stays lit until the user runs over it again (user
+  // 2026-08-24, one more lit card per drag).
+  //
+  // Only ever *clears*: lighting a row from here would strand it the moment
+  // the RootView, which does not agree that it is the hovered view, hands a
+  // later exit to somebody else. Setting is the synthesized move's job.
+  for (WorkspaceEntryView* view : ordered_entries_) {
+    if (!view->IsMouseHovered()) {
+      view->ClearHover();
+    }
+  }
+}
+
+void WorkspaceSidebarView::ResyncHoverFromCursor() {
+  hover_resync_pending_ = false;
+  views::Widget* widget = GetWidget();
+  if (!widget) {
+    return;
+  }
+  ClearStaleHovers();
+  // Then one synthesized move, dispatched the ordinary way, to light
+  // whatever the pointer *is* on: going through the RootView is what keeps
+  // its own hover bookkeeping in step, which setting the flag would not.
+  widget->SynthesizeMouseMoveEvent();
+}
+
+gfx::Rect WorkspaceSidebarView::SettledDragTargetInOverlaySpace() {
+  gfx::Rect target;
+  const std::optional<size_t> index = DragEntryOrderedIndex();
+  if (index) {
+    const SidebarLayout settled = ComputeLayout(width(), space_collapsed_);
+    if (settled.entry_visible[*index]) {
+      target = settled.entry_bounds[*index];
+    }
+  }
+  if (target.IsEmpty()) {
+    return target;
+  }
+  if (drag_overlay_ && drag_overlay_->parent()) {
+    return views::View::ConvertRectToTarget(this, drag_overlay_->parent(),
+                                            target);
+  }
+  return target;
+}
+
+void WorkspaceSidebarView::UpdateDragOverlay(const gfx::Point& point_in_sidebar) {
+  if (!drag_ || !drag_overlay_ || !drag_overlay_->active()) {
+    return;
+  }
+  if (drag_->form_dirty) {
+    drag_->form_dirty = false;
+    RefreshDragForm();
+  }
+  gfx::Point point = point_in_sidebar;
+  if (drag_overlay_->parent()) {
+    views::View::ConvertPointToTarget(this, drag_overlay_->parent(), &point);
+  }
+  drag_overlay_->SetPointer(point);
+}
+
+void WorkspaceSidebarView::RefreshDragForm() {
+  if (!drag_ || !drag_overlay_ || !drag_overlay_->active()) {
+    return;
+  }
+  const bool as_capsule =
+      drag_->plan_section == helium_workspace::WorkspaceEntry::Section::kFavorite;
+  // The capsule the card would become is the slot it would fill; a refused
+  // grid (Arc's thirteenth) never asks for one, so the card stays a row.
+  // The shape to wear is the slot the card would drop into, asked of the
+  // layout rather than recomputed here, so the card can never be a couple of
+  // points off the rows it travels between. A refused drop (Arc's thirteenth
+  // favorite) leaves no slot, and the card stays the row it started as.
+  const SidebarLayout preview = ComputeLayout(width(), space_collapsed_);
+  gfx::Size form_size = preview.drag_slot_bounds.size();
+  if (form_size.IsEmpty() && !as_capsule) {
+    const int indent_width =
+        width() -
+        GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding) -
+        kFolderChildIndent;
+    form_size = gfx::Size(std::max(0, indent_width),
+                          GetLayoutConstant(LayoutConstant::kVerticalTabHeight));
+  }
+  if (!form_size.IsEmpty()) {
+    drag_overlay_->SetForm(as_capsule, form_size);
+  }
+}
+
+void WorkspaceSidebarView::SetDragOverlay(WorkspaceEntryDragOverlay* overlay) {
+  drag_overlay_ = overlay;
+}
