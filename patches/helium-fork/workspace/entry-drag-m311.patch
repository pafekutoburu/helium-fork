+++ src/chrome/browser/ui/helium_workspace/workspace_service.cc
@@ -189,6 +189,52 @@ bool WorkspaceService::SetEntrySection(c
   return false;
 }
 
+bool WorkspaceService::MoveEntry(const std::string& id,
+                                 WorkspaceEntry::Section target_section,
+                                 size_t target_index) {
+  const auto source = std::ranges::find_if(
+      entries_, [&](const WorkspaceEntry& e) { return e.id == id; });
+  if (source == entries_.end()) {
+    return false;
+  }
+  if (target_section == WorkspaceEntry::Section::kFavorite &&
+      source->section != WorkspaceEntry::Section::kFavorite &&
+      CountFavorites() >= kMaxFavorites) {
+    return false;
+  }
+
+  WorkspaceEntry moved = std::move(*source);
+  entries_.erase(source);
+  moved.section = target_section;
+
+  // entries_ is kept sorted favorites-first, so the target section is one
+  // contiguous run; clamp |target_index| into it and splice the entry in.
+  const size_t favorites = CountFavorites();
+  const size_t run_begin =
+      target_section == WorkspaceEntry::Section::kFavorite ? 0u : favorites;
+  const size_t run_size =
+      target_section == WorkspaceEntry::Section::kFavorite
+          ? favorites
+          : entries_.size() - favorites;
+  const size_t insert_at = run_begin + std::min(target_index, run_size);
+  entries_.insert(entries_.begin() + insert_at, std::move(moved));
+
+  // Renumber both sections densely. A dense numbering has no room between
+  // neighbours, so an insert renumbers everyone; the pref is rewritten in
+  // full on every persist anyway.
+  int favorite_position = 0;
+  int pinned_position = 0;
+  for (WorkspaceEntry& entry : entries_) {
+    entry.position = entry.section == WorkspaceEntry::Section::kFavorite
+                         ? favorite_position++
+                         : pinned_position++;
+  }
+  std::stable_sort(entries_.begin(), entries_.end(), EntryOrderLess);
+  PersistToPrefs();
+  NotifyChanged();
+  return true;
+}
+
 size_t WorkspaceService::CountFavorites() const {
   return std::ranges::count_if(entries_, [](const WorkspaceEntry& e) {
     return e.section == WorkspaceEntry::Section::kFavorite;
