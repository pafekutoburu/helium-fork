+// ---- M3.11 entry drag: target side ----
+
+bool WorkspaceSidebarView::GetDropFormats(
+    int* formats,
+    std::set<ui::ClipboardFormatType>* format_types) {
+  format_types->insert(helium_workspace::WorkspaceEntryDragFormat());
