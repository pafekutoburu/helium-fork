+
+bool WorkspaceSidebarView::CanDrop(const ui::OSExchangeData& data) {
+  // Same-session only for now: a drag from another window has no session
+  // (and so no preview) here; cross-window entry drags are a later round.
+  //
+  // ⛔ The session, never the payload. Reading the pickle means
+  // [NSPasteboard dataForType:] -- a cross-process round trip
+  // (os_exchange_data_provider_mac.mm:261). DropHelper re-walks the target
+  // chain, calling this, every time the view under the pointer changes
+  // (drop_helper.cc:176-208), which during a drag that keeps crossing the
+  // sidebar/Today boundary is many times a second. Same argument the region
+  // view's OnDragUpdated already runs on: a live entry session and a link
+  // drag cannot both be in flight, and a drag started in another window
+  // leaves no session here. The payload is read once per gesture, in
+  // GetDropCallback's neighbourhood.
+  return HasEntryDragSession();
+}
+
+void WorkspaceSidebarView::OnDragEntered(const ui::DropTargetEvent& event) {
+  UpdateDragPlan(event.location());
+  UpdateDragOverlay(event.location());
+}
+
+int WorkspaceSidebarView::OnDragUpdated(const ui::DropTargetEvent& event) {
+  TRACE_EVENT0("ui", "WorkspaceSidebarView::OnDragUpdated");
+  DragPerf* const perf = drag_perf_.get();
+  const base::TimeTicks t0 = perf ? base::TimeTicks::Now() : base::TimeTicks();
+  if (perf) {
+    DragPerfTick(t0);
+  }
+  UpdateDragPlan(event.location());
+  const base::TimeTicks t1 = perf ? base::TimeTicks::Now() : base::TimeTicks();
+  UpdateDragOverlay(event.location());
+  if (perf) {
+    const base::TimeTicks t2 = base::TimeTicks::Now();
+    perf->plan_us += (t1 - t0).InMicroseconds();
+    perf->overlay_us += (t2 - t1).InMicroseconds();
+    perf->handler_us.push_back(
+        static_cast<int>((t2 - t0).InMicroseconds() + perf->pending_us));
+    perf->pending_us = 0;
+  }
+  return drag_ && drag_->plan_section ? ui::DragDropTypes::DRAG_MOVE
+                                      : ui::DragDropTypes::DRAG_NONE;
+}
+
+void WorkspaceSidebarView::OnDragExited() {
+  // The pointer left the sidebar: the hole closes, the session stays -- the
+  // frozen frame and the latched height must survive a trip across the
+  // Today container (the old container-scoped resets died exactly there).
+  SetDragPlan(std::nullopt, 0);
+}
+
+views::View::DropCallback WorkspaceSidebarView::GetDropCallback(
+    const ui::DropTargetEvent& event) {
+  if (!drag_ || !drag_->plan_section) {
+    return base::NullCallback();
+  }
+  // Bound by value: by the time this runs the session may have been torn
+  // down by the source row's OnDragDone (see PerformEntryDrop).
+  return base::BindOnce(&WorkspaceSidebarView::PerformEntryDrop,
+                        weak_factory_.GetWeakPtr(), drag_->entry_id,
+                        *drag_->plan_section, drag_->plan_index);
+}
+
+void WorkspaceSidebarView::PerformEntryDrop(
+    std::string entry_id,
+    helium_workspace::WorkspaceEntry::Section section,
+    size_t index,
+    const ui::DropTargetEvent& event,
+    ui::mojom::DragOperation& output_drag_op,
+    std::unique_ptr<ui::LayerTreeOwner> drag_image_layer_owner) {
+  output_drag_op = ui::mojom::DragOperation::kNone;
+  if (!service_) {
+    return;
+  }
+  // The one model write of the whole gesture. The index is "slot among that
+  // section's entries with the dragged one already removed" -- exactly what
+  // the hit math produces and what MoveEntry consumes. An id another window
+  // removed in the meantime simply misses.
+  if (service_->MoveEntry(entry_id, section, index)) {
+    output_drag_op = ui::mojom::DragOperation::kMove;
+    if (space_collapsed_ &&
+        section == helium_workspace::WorkspaceEntry::Section::kPinned) {
+      drop_surfaced_entry_id_ = entry_id;
+    }
+  }
+}
