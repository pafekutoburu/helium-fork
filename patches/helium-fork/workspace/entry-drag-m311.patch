--- src.orig/chrome/browser/ui/helium_workspace/workspace_service_unittest.cc
+++ src/chrome/browser/ui/helium_workspace/workspace_service_unittest.cc
@@ -21,6 +21,7 @@
 namespace helium_workspace {
 namespace {
 
+using ::testing::ElementsAre;
 using ::testing::Return;
 
 // Every test here corresponds to a defect that reached the user at least
@@ -226,5 +227,153 @@ TEST_F(WorkspaceServiceTest, EntriesRoun
   EXPECT_TRUE(reloaded.FindTabsForEntry(entry.id).empty());
 }
 
+
+// One section's URLs in entries() order -- what the sidebar renders top to
+// bottom for that section. Takes the service so reloaded instances can be
+// checked too.
+std::vector<std::string> SectionUrls(const WorkspaceService& service,
+                                     WorkspaceEntry::Section section) {
+  std::vector<std::string> urls;
+  for (const WorkspaceEntry& entry : service.entries()) {
+    if (entry.section == section) {
+      urls.push_back(entry.url.spec());
+    }
+  }
+  return urls;
+}
+
+// MoveEntry is the drag-drop commit, so its index contract is the one the
+// drop math emits: the slot among that section's entries with the dragged
+// one already removed. Both directions, to pin the off-by-one down.
+TEST_F(WorkspaceServiceTest, MoveEntryReordersWithinASection) {
+  const std::string a = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://a.example/"), u"A");
+  const std::string b = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://b.example/"), u"B");
+  const std::string c = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://c.example/"), u"C");
+  ASSERT_FALSE(a.empty() || b.empty() || c.empty());
+
+  // Down: drop A on the last slot.
+  EXPECT_TRUE(service_->MoveEntry(a, WorkspaceEntry::Section::kPinned, 2));
+  EXPECT_THAT(SectionUrls(*service_, WorkspaceEntry::Section::kPinned),
+              ElementsAre("https://b.example/", "https://c.example/",
+                          "https://a.example/"));
+
+  // Up: back to the top slot.
+  EXPECT_TRUE(service_->MoveEntry(a, WorkspaceEntry::Section::kPinned, 0));
+  EXPECT_THAT(SectionUrls(*service_, WorkspaceEntry::Section::kPinned),
+              ElementsAre("https://a.example/", "https://b.example/",
+                          "https://c.example/"));
+
+  // Renumbering keeps positions dense as well as unique; sparse survivors
+  // of repeated moves are how order drifted between launches once before.
+  std::set<int> positions;
+  for (const WorkspaceEntry& entry : service_->entries()) {
+    EXPECT_TRUE(positions.insert(entry.position).second)
+        << "duplicate position " << entry.position;
+  }
+  EXPECT_EQ((std::set<int>{0, 1, 2}), positions);
+}
+
+// A cross-boundary drag is a section change with a chosen slot -- unlike
+// SetEntrySection, which can only append to the far end. The new order must
+// also be what a restart reads back.
+TEST_F(WorkspaceServiceTest, MoveEntryCrossesSectionsBothWays) {
+  const std::string f = service_->AddEntry(WorkspaceEntry::Section::kFavorite,
+                                           GURL("https://f.example/"), u"F");
+  const std::string p1 = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                            GURL("https://p1.example/"), u"P1");
+  const std::string p2 = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                            GURL("https://p2.example/"), u"P2");
+  ASSERT_FALSE(f.empty() || p1.empty() || p2.empty());
+
+  // Favorite -> between the two pinned rows.
+  EXPECT_TRUE(service_->MoveEntry(f, WorkspaceEntry::Section::kPinned, 1));
+  EXPECT_TRUE(
+      SectionUrls(*service_, WorkspaceEntry::Section::kFavorite).empty());
+  EXPECT_THAT(SectionUrls(*service_, WorkspaceEntry::Section::kPinned),
+              ElementsAre("https://p1.example/", "https://f.example/",
+                          "https://p2.example/"));
+
+  // Pinned -> the first favorites slot.
+  EXPECT_TRUE(service_->MoveEntry(p2, WorkspaceEntry::Section::kFavorite, 0));
+  EXPECT_THAT(SectionUrls(*service_, WorkspaceEntry::Section::kFavorite),
+              ElementsAre("https://p2.example/"));
+  EXPECT_THAT(SectionUrls(*service_, WorkspaceEntry::Section::kPinned),
+              ElementsAre("https://p1.example/", "https://f.example/"));
+
+  service_->Shutdown();
+  WorkspaceService reloaded(&prefs_);
+  EXPECT_THAT(SectionUrls(reloaded, WorkspaceEntry::Section::kFavorite),
+              ElementsAre("https://p2.example/"));
+  EXPECT_THAT(SectionUrls(reloaded, WorkspaceEntry::Section::kPinned),
+              ElementsAre("https://p1.example/", "https://f.example/"));
+}
+
+// Promoting by drag obeys the same cap as "Add to Favorites", and the
+// refusal leaves the order untouched. Rearranging within the full grid is
+// not a promotion and stays legal.
+TEST_F(WorkspaceServiceTest, MoveEntryHonorsTheFavoritesCap) {
+  std::string first_favorite;
+  for (size_t i = 0; i < WorkspaceService::kMaxFavorites; ++i) {
+    const std::string id = service_->AddEntry(
+        WorkspaceEntry::Section::kFavorite,
+        GURL("https://f" + base::NumberToString(i) + ".example/"), u"F");
+    ASSERT_FALSE(id.empty());
+    if (i == 0) {
+      first_favorite = id;
+    }
+  }
+  const std::string pinned = service_->AddEntry(
+      WorkspaceEntry::Section::kPinned, GURL("https://p.example/"), u"P");
+  ASSERT_FALSE(pinned.empty());
+
+  EXPECT_FALSE(
+      service_->MoveEntry(pinned, WorkspaceEntry::Section::kFavorite, 0));
+  EXPECT_THAT(SectionUrls(*service_, WorkspaceEntry::Section::kPinned),
+              ElementsAre("https://p.example/"));
+  EXPECT_EQ(WorkspaceService::kMaxFavorites, service_->CountFavorites());
+
+  EXPECT_TRUE(service_->MoveEntry(first_favorite,
+                                  WorkspaceEntry::Section::kFavorite,
+                                  WorkspaceService::kMaxFavorites - 1));
+  EXPECT_EQ("https://f0.example/",
+            SectionUrls(*service_, WorkspaceEntry::Section::kFavorite).back());
+}
+
+// The drop math computes its slot against a layout snapshot; if another
+// window shrank the list mid-drag, an out-of-range slot must land at the
+// section's end rather than corrupt the order.
+TEST_F(WorkspaceServiceTest, MoveEntryClampsOutOfRangeIndices) {
+  const std::string a = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://a.example/"), u"A");
+  const std::string b = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://b.example/"), u"B");
+  ASSERT_FALSE(a.empty() || b.empty());
+
+  EXPECT_TRUE(service_->MoveEntry(a, WorkspaceEntry::Section::kPinned, 99));
+  EXPECT_THAT(SectionUrls(*service_, WorkspaceEntry::Section::kPinned),
+              ElementsAre("https://b.example/", "https://a.example/"));
+
+  // An empty target section clamps all the way to slot zero.
+  EXPECT_TRUE(service_->MoveEntry(a, WorkspaceEntry::Section::kFavorite, 99));
+  EXPECT_THAT(SectionUrls(*service_, WorkspaceEntry::Section::kFavorite),
+              ElementsAre("https://a.example/"));
+}
+
+// An id that resolves to nothing (a race with removal in another window)
+// is a visible no-op, not a crash and not a phantom insert.
+TEST_F(WorkspaceServiceTest, MoveEntryRejectsUnknownIds) {
+  const std::string a = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://a.example/"), u"A");
+  ASSERT_FALSE(a.empty());
+
+  EXPECT_FALSE(
+      service_->MoveEntry("no-such-id", WorkspaceEntry::Section::kPinned, 0));
+  EXPECT_THAT(SectionUrls(*service_, WorkspaceEntry::Section::kPinned),
+              ElementsAre("https://a.example/"));
+}
+
 }  // namespace
 }  // namespace helium_workspace
