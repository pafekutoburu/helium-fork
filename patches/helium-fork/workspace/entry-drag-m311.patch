+// ---- M3.11 entry drag: target side ----
+
+bool WorkspaceSidebarView::GetDropFormats(
+    int* formats,
+    std::set<ui::ClipboardFormatType>* format_types) {
+  format_types->insert(helium_workspace::WorkspaceEntryDragFormat());
+  return true;
+}
+
+bool WorkspaceSidebarView::AreDropTypesRequired() {
+  return true;
+}
+
+bool WorkspaceSidebarView::CanDrop(const ui::OSExchangeData& data) {
+  // Same-session only for now: the id must be the one this sidebar floated.
+  // A drag from another window has no session (and so no preview) here;
+  // cross-window entry drags are a later round.
+  const std::optional<std::string> id =
+      helium_workspace::ReadWorkspaceEntryDragData(data);
+  return id && drag_ && drag_->entry_id == *id;
+}
+
+void WorkspaceSidebarView::OnDragEntered(const ui::DropTargetEvent& event) {
+  UpdateDragPlan(event.location());
+  UpdateDragOverlay(event.location());
+}
+
+int WorkspaceSidebarView::OnDragUpdated(const ui::DropTargetEvent& event) {
+  UpdateDragPlan(event.location());
+  UpdateDragOverlay(event.location());
+  return drag_ && drag_->plan_section ? ui::DragDropTypes::DRAG_MOVE
+                                      : ui::DragDropTypes::DRAG_NONE;
+}
+
+void WorkspaceSidebarView::OnDragExited() {
+  // The pointer left the sidebar: the hole closes, the session stays -- the
+  // frozen frame and the latched height must survive a trip across the
+  // Today container (the old container-scoped resets died exactly there).
+  SetDragPlan(std::nullopt, 0);
+}
+
+views::View::DropCallback WorkspaceSidebarView::GetDropCallback(
+    const ui::DropTargetEvent& event) {
+  if (!drag_ || !drag_->plan_section) {
+    return base::NullCallback();
+  }
+  // Bound by value: by the time this runs the session may have been torn
+  // down by the source row's OnDragDone (see PerformEntryDrop).
+  return base::BindOnce(&WorkspaceSidebarView::PerformEntryDrop,
+                        weak_factory_.GetWeakPtr(), drag_->entry_id,
+                        *drag_->plan_section, drag_->plan_index);
+}
+
+void WorkspaceSidebarView::PerformEntryDrop(
+    std::string entry_id,
+    helium_workspace::WorkspaceEntry::Section section,
+    size_t index,
+    const ui::DropTargetEvent& event,
+    ui::mojom::DragOperation& output_drag_op,
+    std::unique_ptr<ui::LayerTreeOwner> drag_image_layer_owner) {
+  output_drag_op = ui::mojom::DragOperation::kNone;
+  if (!service_) {
+    return;
+  }
+  // The one model write of the whole gesture. The index is "slot among that
+  // section's entries with the dragged one already removed" -- exactly what
+  // the hit math produces and what MoveEntry consumes. An id another window
+  // removed in the meantime simply misses.
+  if (service_->MoveEntry(entry_id, section, index)) {
+    output_drag_op = ui::mojom::DragOperation::kMove;
+  }
+}
+
+// ---- M3.11 entry drag: session plumbing ----
+
+std::optional<size_t> WorkspaceSidebarView::DragEntryOrderedIndex() const {
+  if (!drag_) {
+    return std::nullopt;
+  }
+  for (size_t i = 0; i < ordered_entries_.size(); ++i) {
+    if (ordered_entries_[i]->entry_id() == drag_->entry_id) {
+      return i;
+    }
+  }
+  return std::nullopt;
+}
+
+void WorkspaceSidebarView::UpdateDragPlan(const gfx::Point& point) {
+  if (!drag_ || !service_) {
+    return;
+  }
+  const SidebarLayout current_target = ComputeLayout(width(), space_collapsed_);
+  const helium_workspace::SidebarDragZone zone =
+      helium_workspace::ClassifySidebarDragZone(point.y(),
+                                                drag_->zone_boundary_y);
+  if (zone == helium_workspace::SidebarDragZone::kGrid) {
+    // Arc's refusal is passive: a 13th capsule gets no slot and no morph;
+    // releasing over a full grid does nothing.
+    const bool accepted =
+        drag_->from_favorite ||
+        service_->CountFavorites() <
+            helium_workspace::WorkspaceService::kMaxFavorites;
+    if (!accepted) {
+      SetDragPlan(std::nullopt, 0);
+      return;
+    }
+    const size_t effective_favorites =
+        favorite_count_ - (drag_->from_favorite ? 1u : 0u);
+    const std::vector<gfx::Rect> slot_rects =
+        BuildGridSlotRects(effective_favorites + 1, width());
+    SetDragPlan(helium_workspace::WorkspaceEntry::Section::kFavorite,
+                helium_workspace::GridInsertIndex(point, slot_rects));
+    return;
+  }
+  // Rows. A collapsed folder has nowhere visible to land a row.
+  if (space_collapsed_) {
+    SetDragPlan(std::nullopt, 0);
+    return;
+  }
+  const std::optional<size_t> drag_index = DragEntryOrderedIndex();
+  std::vector<int> row_centers;
+  for (size_t i = favorite_count_; i < ordered_entries_.size(); ++i) {
+    if (drag_index && i == *drag_index) {
+      continue;
+    }
+    if (!current_target.entry_visible[i]) {
+      continue;
+    }
+    row_centers.push_back(current_target.entry_bounds[i].CenterPoint().y());
+  }
+  SetDragPlan(helium_workspace::WorkspaceEntry::Section::kPinned,
+              helium_workspace::RowInsertIndex(point.y(), row_centers));
+}
+
+void WorkspaceSidebarView::SetDragPlan(
+    std::optional<helium_workspace::WorkspaceEntry::Section> section,
+    size_t index) {
+  if (!drag_) {
+    return;
+  }
+  if (drag_->plan_section == section &&
+      (!section || drag_->plan_index == index)) {
+    return;
+  }
+  // Snapshot what is on screen *before* the flip (M3.10-r1 lesson), then
+  // glide to the new preview.
+  RetargetDragYield();
+  drag_->plan_section = section;
+  drag_->plan_index = index;
+  const int target_height = ComputeLayout(width(), space_collapsed_).height;
+  if (target_height > drag_->latched_height) {
+    // Discrete, once per plan change -- a zone crossing, not a pointer
+    // frame -- so the container animation gets one new target, not sixty.
+    drag_->latched_height = target_height;
+    PreferredSizeChanged();
+  }
+  InvalidateLayout();
+  SchedulePaint();
+}
+
+void WorkspaceSidebarView::RetargetDragYield() {
+  drag_prev_layout_ = CurrentLayout(width());
+  drag_prev_layout_valid_ = true;
+  drag_yield_animation_.Reset(0.0);
+  drag_yield_animation_.Show();
+}
+
+void WorkspaceSidebarView::EndDragSession() {
+  if (!drag_ || drag_->settling) {
+    return;
+  }
+  // Let the rows glide from wherever the preview left them to the settled
+  // layout -- after a drop that is a no-op (they are already there); after a
+  // cancel it is the fold-back.
+  RetargetDragYield();
+  // The entry rejoins the layout now, but its row stays hidden until the
+  // floating card lands on it: the card *is* the row until then, and
+  // revealing both would show it twice.
+  drag_->settling = true;
+  PreferredSizeChanged();
+  InvalidateLayout();
+  SchedulePaint();
+
+  if (!drag_overlay_ || !drag_overlay_->active()) {
+    FinishDragSettle();
+    return;
+  }
+  drag_overlay_->SettleTo(SettledDragTargetInOverlaySpace(),
+                          base::BindOnce(&WorkspaceSidebarView::FinishDragSettle,
+                                         weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceSidebarView::FinishDragSettle() {
+  drag_.reset();
+  if (drag_overlay_) {
+    drag_overlay_->Stop();
+  }
+  PreferredSizeChanged();
+  InvalidateLayout();
+  SchedulePaint();
+  // The row that was floating is only made visible again by the layout this
+  // just asked for, so ask views what is under the pointer one turn later --
+  // hit testing skips a hidden view, and the answer would be "the sidebar".
+  ScheduleHoverResync();
+}
+
+void WorkspaceSidebarView::ScheduleHoverResync() {
+  // Always posted: the bounds this reads are the ones the layout it follows
+  // is about to write, and hit-testing the pointer against the old ones is
+  // the very mistake being repaired.
+  if (hover_resync_pending_) {
+    return;
+  }
+  hover_resync_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspaceSidebarView::ResyncHoverFromCursor,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceSidebarView::ClearStaleHovers() {
+  // Hover is latched from mouse enter/exit, and both a drag (the pointer
+  // belongs to the OS for the whole gesture) and a plain relayout can take a
+  // view out from under a pointer that never moves -- no exit is ever sent,
+  // and the card stays lit until the user runs over it again (user
+  // 2026-08-24, one more lit card per drag).
+  //
+  // Only ever *clears*: lighting a row from here would strand it the moment
+  // the RootView, which does not agree that it is the hovered view, hands a
+  // later exit to somebody else. Setting is the synthesized move's job.
+  for (WorkspaceEntryView* view : ordered_entries_) {
+    if (!view->IsMouseHovered()) {
+      view->ClearHover();
+    }
+  }
+}
+
+void WorkspaceSidebarView::ResyncHoverFromCursor() {
+  hover_resync_pending_ = false;
+  views::Widget* widget = GetWidget();
+  if (!widget) {
+    return;
+  }
+  ClearStaleHovers();
+  // Then one synthesized move, dispatched the ordinary way, to light
+  // whatever the pointer *is* on: going through the RootView is what keeps
+  // its own hover bookkeeping in step, which setting the flag would not.
+  widget->SynthesizeMouseMoveEvent();
+}
+
+gfx::Rect WorkspaceSidebarView::SettledDragTargetInOverlaySpace() {
+  gfx::Rect target;
+  const std::optional<size_t> index = DragEntryOrderedIndex();
+  if (index) {
+    const SidebarLayout settled = ComputeLayout(width(), space_collapsed_);
+    if (settled.entry_visible[*index]) {
+      target = settled.entry_bounds[*index];
+    }
+  }
+  if (target.IsEmpty()) {
+    return target;
+  }
+  if (drag_overlay_ && drag_overlay_->parent()) {
+    return views::View::ConvertRectToTarget(this, drag_overlay_->parent(),
+                                            target);
+  }
+  return target;
+}
+
+void WorkspaceSidebarView::UpdateDragOverlay(const gfx::Point& point_in_sidebar) {
+  if (!drag_ || !drag_overlay_ || !drag_overlay_->active()) {
+    return;
+  }
+  const bool as_capsule =
+      drag_->plan_section == helium_workspace::WorkspaceEntry::Section::kFavorite;
+  // The capsule the card would become is the slot it would fill; a refused
+  // grid (Arc's thirteenth) never asks for one, so the card stays a row.
+  // The shape to wear is the slot the card would drop into, asked of the
+  // layout rather than recomputed here, so the card can never be a couple of
+  // points off the rows it travels between. A refused drop (Arc's thirteenth
+  // favorite) leaves no slot, and the card stays the row it started as.
+  const SidebarLayout preview = ComputeLayout(width(), space_collapsed_);
+  gfx::Size form_size = preview.drag_slot_bounds.size();
+  if (form_size.IsEmpty() && !as_capsule) {
+    const int indent_width =
+        width() -
+        GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding) -
+        kFolderChildIndent;
+    form_size = gfx::Size(std::max(0, indent_width),
+                          GetLayoutConstant(LayoutConstant::kVerticalTabHeight));
+  }
+  if (!form_size.IsEmpty()) {
+    drag_overlay_->SetForm(as_capsule, form_size);
+  }
+  gfx::Point point = point_in_sidebar;
+  if (drag_overlay_->parent()) {
+    views::View::ConvertPointToTarget(this, drag_overlay_->parent(), &point);
+  }
+  drag_overlay_->SetPointer(point);
+}
+
+void WorkspaceSidebarView::SetDragOverlay(WorkspaceEntryDragOverlay* overlay) {
+  drag_overlay_ = overlay;
+}
