+
+#include "chrome/browser/ui/views/tabs/common/workspace_entry_drag_data.h"
+
+#include "base/no_destructor.h"
+#include "base/pickle.h"
+#include "ui/base/clipboard/clipboard_format_type.h"
+#include "ui/base/dragdrop/os_exchange_data.h"
+
+namespace helium_workspace {
+
+const ui::ClipboardFormatType& WorkspaceEntryDragFormat() {
+  static base::NoDestructor<ui::ClipboardFormatType> format(
+      ui::ClipboardFormatType::CustomPlatformType(
+          "chromium/x-helium-workspace-entry"));
+  return *format;
+}
+
+void WriteWorkspaceEntryDragData(const std::string& entry_id,
+                                 ui::OSExchangeData* data) {
+  base::Pickle pickle;
+  pickle.WriteString(entry_id);
+  data->SetPickledData(WorkspaceEntryDragFormat(), pickle);
+}
+
+std::optional<std::string> ReadWorkspaceEntryDragData(
+    const ui::OSExchangeData& data) {
+  if (!data.HasCustomFormat(WorkspaceEntryDragFormat())) {
+    return std::nullopt;
+  }
+  std::optional<base::Pickle> pickle =
+      data.GetPickledData(WorkspaceEntryDragFormat());
+  if (!pickle) {
+    return std::nullopt;
+  }
+  base::PickleIterator it(*pickle);
+  std::string id;
+  if (!it.ReadString(&id) || id.empty()) {
+    return std::nullopt;
+  }
+  return id;
+}
+
+}  // namespace helium_workspace
