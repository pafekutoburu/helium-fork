===================================================================
--- src.orig/chrome/browser/ui/helium_workspace/workspace_tab_controller.cc
+++ src/chrome/browser/ui/helium_workspace/workspace_tab_controller.cc
@@ -25,6 +25,7 @@
 #include "chrome/browser/ui/tabs/tab_enums.h"
 #include "components/tabs/public/tab_interface.h"
 #include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
 #include "content/public/browser/web_contents.h"
 #include "content/public/common/referrer.h"
 #include "ui/base/page_transition_types.h"
@@ -41,6 +42,36 @@ namespace {
 // rather than grow the pref by a screenshot.
 constexpr size_t kMaxFaviconBytes = 32 * 1024;
 
+// The URL to match an entry against. TabInterface::GetURL() is the *last
+// committed* one, and a tab that is still on its way to a page has committed
+// nothing -- which is every tab this window opens with. Claiming them on the
+// committed URL alone is why a startup tab never joined its pinned row
+// (2026-08-24: on an untouched Rel build too, so not a M3.11 regression).
+// The visible URL is where the tab is headed, which is what the user pinned.
+GURL ClaimUrl(tabs::TabInterface* tab) {
+  const GURL committed = tab->GetURL();
+  if (!committed.is_empty()) {
+    return committed;
+  }
+  content::WebContents* contents = tab->GetContents();
+  return contents ? contents->GetVisibleURL() : GURL();
+}
+
+// Whether a tab being inserted brings a page with it rather than being
+// opened right now: session restore, Cmd+Shift+T and a tab dragged in from
+// another window all arrive with their navigation entries already restored,
+// while a tab the user is opening still holds only the initial entry every
+// FrameTree starts with.
