+
+bool WorkspaceSidebarView::OnTodayDragUpdate(const views::View& source,
+                                             const gfx::Point& point_in_source,
+                                             std::optional<int> tab_index,
+                                             size_t row_position) {
+  if (!drag_) {
+    return false;
+  }
+  TRACE_EVENT0("ui", "WorkspaceSidebarView::OnTodayDragUpdate");
+  DragPerf* const perf = drag_perf_.get();
+  const base::TimeTicks t0 = perf ? base::TimeTicks::Now() : base::TimeTicks();
+  if (perf) {
+    DragPerfTick(t0);
+  }
+  SetTodayDragPlan(tab_index, row_position);
+  // The card is region-owned, so it keeps tracking the pointer across a
+  // container the sidebar does not contain. Only this view knows the grab
+  // point and the shape it should be wearing, so the conversion happens
+  // here rather than in the container: without it the card freezes at the
+  // sidebar's edge the moment the pointer crosses.
+  gfx::Point point_in_sidebar = point_in_source;
+  views::View::ConvertPointToTarget(&source, this, &point_in_sidebar);
+  const base::TimeTicks t1 = perf ? base::TimeTicks::Now() : base::TimeTicks();
+  UpdateDragOverlay(point_in_sidebar);
+  if (perf) {
+    const base::TimeTicks t2 = base::TimeTicks::Now();
+    perf->plan_us += (t1 - t0).InMicroseconds();
+    perf->overlay_us += (t2 - t1).InMicroseconds();
+    perf->handler_us.push_back(
+        static_cast<int>((t2 - t0).InMicroseconds() + perf->pending_us));
+    perf->pending_us = 0;
+  }
+  return tab_index.has_value();
+}
+
+void WorkspaceSidebarView::OnTodayDragExited() {
+  // Same contract as this view's own OnDragExited: the hole closes, the
+  // session stays. The pointer crosses this boundary mid-gesture in both
+  // directions, so tearing down here would kill the drag on the way back.
+  SetTodayDragPlan(std::nullopt, 0);
+}
+
+views::View::DropCallback WorkspaceSidebarView::GetTodayDropCallback() {
+  if (!drag_ || !drag_->plan_today_index) {
+    return base::NullCallback();
+  }
+  return base::BindOnce(&WorkspaceSidebarView::PerformTodayDrop,
+                        weak_factory_.GetWeakPtr(), drag_->entry_id,
+                        *drag_->plan_today_index);
+}
+
+std::optional<size_t> WorkspaceSidebarView::TodayDropSlotRow() const {
+  if (!drag_ || drag_->settling || !drag_->plan_today_index) {
+    return std::nullopt;
+  }
+  return drag_->plan_today_row;
+}
+
+void WorkspaceSidebarView::SetTodayDragPlan(std::optional<int> tab_index,
+                                            size_t row_position) {
+  if (!drag_) {
+    return;
+  }
+  SetFolderDropTarget(false);
+  const bool had_today = drag_->plan_today_index.has_value();
+  if (drag_->plan_today_index == tab_index && !drag_->plan_section &&
+      (!tab_index || drag_->plan_today_row == row_position)) {
+    return;
+  }
+  if (drag_perf_) {
+    ++drag_perf_->plan_changes;
+    if (!had_today && tab_index) {
+      ++drag_perf_->crossings;
+    }
+  }
+  // Crossing the boundary closes the sidebar's hole in the same breath as it
+  // opens Today's: one snapshot, one glide, so the two sides can never be a
+  // frame apart about where the entry is.
+  RetargetDragYield();
+  drag_->plan_section = std::nullopt;
+  drag_->plan_index = 0;
+  drag_->plan_today_index = tab_index;
+  drag_->plan_today_row = row_position;
+  drag_->form_dirty = true;
+  drag_->hit_dirty = true;
+  InvalidateLayout();
+  SchedulePaint();
+  if (today_container_ && (had_today || tab_index)) {
+    today_container_->InvalidateLayout();
+  }
+}
+
+void WorkspaceSidebarView::PerformTodayDrop(
+    std::string entry_id,
+    int tab_index,
+    const ui::DropTargetEvent& event,
+    ui::mojom::DragOperation& output_drag_op,
+    std::unique_ptr<ui::LayerTreeOwner> drag_image_layer_owner) {
+  output_drag_op = ui::mojom::DragOperation::kNone;
+  BrowserWindowInterface* const browser = GetBrowserWindow();
+  if (!service_ || !browser) {
+    return;
+  }
+  const helium_workspace::WorkspaceEntry* const entry =
+      service_->FindEntryById(entry_id);
+  TabStripModel* const model = browser->GetTabStripModel();
+  if (!entry || !model) {
+    return;
+  }
+  const GURL url = entry->url;
+  const tabs::TabHandle handle =
+      service_->FindTabForEntryInWindow(entry_id, browser);
+  if (tabs::TabInterface* const tab = handle.Get()) {
+    // The page is already open here, so it just stops being the entry's and
+    // takes its place among the ordinary tabs. Unbind first: Today filters
+    // its layout on the binding, and moving a still-bound tab would be
+    // moving a row nobody draws.
+    service_->UnbindTab(handle);
+    const int from = model->GetIndexOfTab(tab);
+    if (from >= 0 && model->count() > 0) {
+      model->MoveWebContentsAt(from, std::clamp(tab_index, 0, model->count() - 1),
+                               /*select_after_move=*/false);
+    }
+  } else {
+    // No tab here. `Arc:` starts loading the page on landing rather than
+    // parking a placeholder row (measured 2026-08-24), so open a real tab
+    // at the drop index. Not foregrounded: the drop is a reorganisation, and
+    // stealing the active tab is not something the recordings show.
+    chrome::AddAndReturnTabAt(browser, url, std::clamp(tab_index, 0, model->count()),
+                              /*foreground=*/false, /*group=*/std::nullopt,
+                              /*pinned=*/false);
+  }
+  // The one model write that ends the entry's life. Ordered last so that a
+  // failed open still leaves the entry where it was.
+  service_->RemoveEntry(entry_id);
+  output_drag_op = ui::mojom::DragOperation::kMove;
+}
+
+// ---- M3.11 entry drag: session plumbing ----
+
+void WorkspaceSidebarView::AddTodayHitSample(base::TimeDelta elapsed) {
+  if (!drag_perf_) {
+    return;
+  }
+  const int64_t us = elapsed.InMicroseconds();
+  drag_perf_->today_us += us;
+  // Spent before OnTodayDragUpdate was reached, so it would otherwise fall
+  // outside the frame's handler total.
+  drag_perf_->pending_us += us;
+}
+
+void WorkspaceSidebarView::DragPerfTick(base::TimeTicks now) {
+  DragPerf* const perf = drag_perf_.get();
+  if (perf->last_tick.is_null()) {
+    perf->started = now;
+    perf->last_tick = now;
+    perf->ticks = 1;
+    return;
+  }
+  const base::TimeDelta gap = now - perf->last_tick;
+  // DropHelper delivers an enter *and* an update inside one AppKit callback
+  // when the target view changes; that is one frame, not two.
+  if (gap < base::Milliseconds(1)) {
+    return;
+  }
+  perf->gap_us.push_back(static_cast<int>(gap.InMicroseconds()));
+  perf->last_tick = now;
+  ++perf->ticks;
+}
+
+void WorkspaceSidebarView::DragPerfFinish() {
+  if (!drag_perf_) {
+    return;
+  }
+  std::unique_ptr<DragPerf> perf = std::move(drag_perf_);
+  drag_frame_probe_.reset();
+  // Frames alone are enough to be worth a line: a gesture that never moved
+  // over the sidebar (the pointer left the window) has no updates at all,
+  // and that is exactly the control worth reading.
+  if (perf->ticks < 2 && perf->frame_us.size() < 2) {
+    return;
+  }
+  // How many compositor frames came in at more than 1.5 budgets -- the
+  // closest thing to "frames the user saw drop".
+  int late_frames = 0;
+  if (perf->frame_interval_us > 0) {
+    const int64_t late = perf->frame_interval_us * 3 / 2;
+    for (int us : perf->frame_us) {
+      if (us > late) {
+        ++late_frames;
+      }
+    }
+  }
+  const int64_t span_ms = (perf->last_tick - perf->started).InMilliseconds();
+  const size_t frames = perf->frame_us.size();
+  const std::string line = base::StringPrintf(
+      "helium drag-perf: %" PRId64 "ms | frame us budget=%" PRId64
+      " n=%zu p50=%d p95=%d max=%d late=%d | handler us p50=%d p95=%d max=%d "
+      "over %d updates | layout us total=%" PRId64 " n=%d | gap us p50=%d "
+      "p95=%d max=%d | phases us plan=%" PRId64 " overlay=%" PRId64
+      " todayhit=%" PRId64 " | plan-changes=%d crossings=%d",
+      span_ms, perf->frame_interval_us, frames,
+      PercentileUs(perf->frame_us, 0.50), PercentileUs(perf->frame_us, 0.95),
+      PercentileUs(perf->frame_us, 1.0), late_frames,
+      PercentileUs(perf->handler_us, 0.50),
+      PercentileUs(perf->handler_us, 0.95),
+      PercentileUs(perf->handler_us, 1.0), perf->ticks, perf->layout_us,
+      perf->layouts, PercentileUs(perf->gap_us, 0.50),
+      PercentileUs(perf->gap_us, 0.95), PercentileUs(perf->gap_us, 1.0),
+      perf->plan_us, perf->overlay_us, perf->today_us, perf->plan_changes,
+      perf->crossings);
+  LOG(WARNING) << line;
+  // `open -na` gives the user no stderr, so the line also lands in a file
+  // next to the profile. Off the UI thread: this runs at the end of a
+  // gesture, and blocking there is exactly what is being measured.
+  base::FilePath dir;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &dir)) {
+    return;
+  }
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(
+          [](base::FilePath path, std::string text) {
+            // OPEN_ALWAYS, not AppendToFile: the latter opens without
+            // O_CREAT and simply fails while the log does not exist yet.
+            base::File file(path, base::File::FLAG_OPEN_ALWAYS |
+                                      base::File::FLAG_APPEND);
+            if (file.IsValid()) {
+              file.WriteAtCurrentPos(base::as_byte_span(text));
+            }
+          },
+          dir.AppendASCII("helium_drag_perf.log"), line + "\n"));
+}
+
+std::optional<size_t> WorkspaceSidebarView::DragEntryOrderedIndex() const {
+  if (!drag_) {
+    return std::nullopt;
+  }
+  for (size_t i = 0; i < ordered_entries_.size(); ++i) {
+    if (ordered_entries_[i]->entry_id() == drag_->entry_id) {
+      return i;
+    }
+  }
+  return std::nullopt;
+}
+
+void WorkspaceSidebarView::EnsureDropGeometry() {
+  if (!drag_) {
+    return;
+  }
+  // The two inputs that move without a plan change: the sidebar resizing
+  // under the drag, and an entry arriving or leaving mid-gesture.
+  const int w = width();
+  const size_t count = ordered_entries_.size();
+  if (!drag_->hit_dirty && drag_->hit_width == w &&
+      drag_->hit_entry_count == count) {
+    return;
+  }
+  drag_->hit_dirty = false;
+  drag_->hit_width = w;
+  drag_->hit_entry_count = count;
+
+  const std::optional<size_t> drag_index = DragEntryOrderedIndex();
+  const size_t effective_favorites =
+      favorite_count_ - (drag_->from_favorite ? 1u : 0u);
+  drag_->hit_grid_slots = BuildGridSlotRects(effective_favorites + 1, w);
+
+  // The live layout -- the one with the preview slot in it -- on purpose:
+  // measuring against what the user can actually see is what gives the row
+  // rule its hysteresis (the slot only advances once the pointer passes the
+  // row where it is *drawn*), and that is the 轮2 feel the user accepted.
+  // Measuring against the closed-up layout instead removes the hysteresis
+  // and shifts every row-to-row drop one place; tried 2026-08-25, reverted.
+  const SidebarLayout current_target = ComputeLayout(w, space_collapsed_);
+  drag_->hit_row_centers.clear();
+  for (size_t i = favorite_count_; i < ordered_entries_.size(); ++i) {
+    if (drag_index && i == *drag_index) {
+      continue;
+    }
+    if (!current_target.entry_visible[i]) {
+      continue;
+    }
+    drag_->hit_row_centers.push_back(
+        current_target.entry_bounds[i].CenterPoint().y());
+  }
+}
+
+void WorkspaceSidebarView::UpdateDragPlan(const gfx::Point& point) {
+  if (!drag_ || !service_) {
+    return;
+  }
+  // ⛔ Not a fresh ComputeLayout per pointer frame (轮3 did that, and it was
+  // still there after r3 removed the overlay's copy). What the pointer is
+  // measured against only moves when the plan does, so it is cached and the
+  // plan-change sites mark it dirty -- the same contract as form_dirty.
+  // Nothing below recomputes it, so the vectors stay put for this call.
+  EnsureDropGeometry();
+  const helium_workspace::SidebarDragZone zone =
+      helium_workspace::ClassifySidebarDragZone(point.y(),
+                                                drag_->zone_boundary_y);
+  if (zone == helium_workspace::SidebarDragZone::kGrid) {
+    // Arc's refusal is passive: a 13th capsule gets no slot and no morph;
+    // releasing over a full grid does nothing.
+    const bool accepted =
+        drag_->from_favorite ||
+        service_->CountFavorites() <
+            helium_workspace::WorkspaceService::kMaxFavorites;
+    if (!accepted) {
+      SetFolderDropTarget(false);
+      SetDragPlan(std::nullopt, 0);
+      return;
+    }
+    SetFolderDropTarget(false);
+    SetDragPlan(
+        helium_workspace::WorkspaceEntry::Section::kFavorite,
+        helium_workspace::GridInsertIndex(point, drag_->hit_grid_slots));
+    return;
+  }
+  const std::optional<size_t> drag_index = DragEntryOrderedIndex();
+  // Rows. 轮3: a collapsed folder *does* take a drop -- `Arc:` expands it
+  // afterwards to show the new member, and neither reference spring-loads on
+  // hover (measured 2026-08-24). What a collapsed folder cannot do is show a
+  // slot: its rows are not laid out, so there is no ordering to preview and
+  // the plan is simply "append to the section".
+  if (space_collapsed_) {
+    // `Arc:` fills the closed folder's own row and opens nothing: the item
+    // appears on the line under it only once you let go (recordings
+    // re-read 2026-08-25). So the plan is "append", but the layout is told
+    // to leave the rows exactly where they are.
+    const size_t pinned_count = ordered_entries_.size() - favorite_count_;
+    const bool dragging_a_row = drag_index && *drag_index >= favorite_count_;
+    SetFolderDropTarget(true);
+    SetDragPlan(helium_workspace::WorkspaceEntry::Section::kPinned,
+                pinned_count - (dragging_a_row ? 1u : 0u));
+    return;
+  }
+  SetFolderDropTarget(false);
+  SetDragPlan(
+      helium_workspace::WorkspaceEntry::Section::kPinned,
+      helium_workspace::RowInsertIndex(point.y(), drag_->hit_row_centers));
+}
+
+void WorkspaceSidebarView::SetDragPlan(
+    std::optional<helium_workspace::WorkspaceEntry::Section> section,
+    size_t index) {
+  if (!drag_) {
+    return;
+  }
+  const bool had_today = drag_->plan_today_index.has_value();
+  if (drag_->plan_section == section &&
+      (!section || drag_->plan_index == index) && !had_today) {
+    return;
+  }
+  if (drag_perf_) {
+    ++drag_perf_->plan_changes;
+    if (had_today) {
+      ++drag_perf_->crossings;
+    }
+  }
+  // Snapshot what is on screen *before* the flip (M3.10-r1 lesson), then
+  // glide to the new preview.
+  RetargetDragYield();
+  drag_->plan_section = section;
+  drag_->plan_index = index;
+  drag_->form_dirty = true;
+  drag_->hit_dirty = true;
+  // 轮3: the two plans are mutually exclusive. Coming back from Today has to
+  // close that slot here, in the same snapshot, or both sides show a hole.
+  drag_->plan_today_index = std::nullopt;
+  drag_->plan_today_row = 0;
+  if (had_today && today_container_) {
+    today_container_->InvalidateLayout();
+  }
+  const int target_height = ComputeLayout(width(), space_collapsed_).height;
+  if (target_height > drag_->latched_height) {
+    // Discrete, once per plan change -- a zone crossing, not a pointer
+    // frame -- so the container animation gets one new target, not sixty.
+    drag_->latched_height = target_height;
+    PreferredSizeChanged();
+  }
