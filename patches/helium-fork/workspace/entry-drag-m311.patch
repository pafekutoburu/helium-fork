+// ---- M3.11 entry drag: source side (views::DragController) ----
+
+void WorkspaceSidebarView::WriteDragDataForView(views::View* sender,
+                                                const gfx::Point& press_pt,
+                                                ui::OSExchangeData* data) {
+  auto* row = views::AsViewClass<WorkspaceEntryView>(sender);
+  if (!row) {
+    return;
+  }
+  helium_workspace::WriteWorkspaceEntryDragData(row->entry_id(), data);
+  // A 1x1 transparent drag image, because the visual is ours: macOS centres
+  // the system image on the pointer and cannot morph it, and Dia does both
+  // the opposite (drag_drop_client_mac.mm:81-84, measured 2026-08-24).
+  SkBitmap blank;
+  blank.allocN32Pixels(1, 1);
+  blank.eraseColor(SK_ColorTRANSPARENT);
+  data->provider().SetDragImage(gfx::ImageSkia::CreateFrom1xBitmap(blank),
+                                gfx::Vector2d());
+  const gfx::Size row_size = row->size();
+  pending_drag_grab_ = gfx::Vector2dF(
+      row_size.width() ? static_cast<float>(press_pt.x()) / row_size.width()
+                       : 0.5f,
+      row_size.height() ? static_cast<float>(press_pt.y()) / row_size.height()
+                        : 0.5f);
+}
+
+int WorkspaceSidebarView::GetDragOperationsForView(views::View* sender,
+                                                   const gfx::Point& p) {
+  return ui::DragDropTypes::DRAG_MOVE;
+}
+
+bool WorkspaceSidebarView::CanStartDragForView(views::View* sender,
+                                               const gfx::Point& press_pt,
+                                               const gfx::Point& p) {
+  auto* row = views::AsViewClass<WorkspaceEntryView>(sender);
+  if (!row) {
+    return false;
+  }
+  // Not while the folder is mid-tween (the two would fight over the layout),
+  // and not for rows hiding inside a collapsed folder -- there is nowhere
+  // visible to put them down.
+  if (folder_animation_.is_animating()) {
+    return false;
+  }
+  if (!row->renders_as_capsule() && space_collapsed_) {
+    return false;
+  }
+  return true;
+}
+
+void WorkspaceSidebarView::OnWillStartDragForView(views::View* dragged_view) {
+  auto* row = views::AsViewClass<WorkspaceEntryView>(dragged_view);
+  if (!row) {
+    return;
+  }
+  // Read the settled geometry before the session exists, so the frozen
+  // frame is the one the user was looking at when they pressed.
+  const int settled_boundary = ComputeLayout(width(), space_collapsed_)
+                                   .header_bounds.y();
+
+  drag_ = std::make_unique<DragState>();
+  drag_->zone_boundary_y = settled_boundary;
+  drag_->entry_id = row->entry_id();
+  drag_->from_favorite = row->renders_as_capsule();
+  // The session opens with the hole in the entry's own slot -- picking a row
+  // up changes nothing but the row itself floating (Dia).
+  const std::optional<size_t> index = DragEntryOrderedIndex();
+  if (index) {
+    drag_->plan_section =
+        drag_->from_favorite
+            ? helium_workspace::WorkspaceEntry::Section::kFavorite
+            : helium_workspace::WorkspaceEntry::Section::kPinned;
+    drag_->plan_index =
+        drag_->from_favorite ? *index : *index - favorite_count_;
+  }
+  drag_->latched_height = ComputeLayout(width(), space_collapsed_).height;
+  drag_->grab = pending_drag_grab_;
+  // helium-fork M3.11-r1: from here to the drop the pointer belongs to the
+  // OS drag session -- no view will ever be told the mouse left it. Sweep
+  // out anything a previous gesture left lit before adding to the pile
+  // (user 2026-08-24: one more lit card per drag). The row being picked up
+  // is under the pointer, so it keeps its own highlight.
+  ClearStaleHovers();
+  if (drag_overlay_) {
+    drag_overlay_->Start(row->drag_favicon(), row->drag_title(),
+                         row->drag_surface_color(), row->drag_text_color(),
+                         row->size(), drag_->grab);
+  }
+  InvalidateLayout();
+  SchedulePaint();
+}
+
+void WorkspaceSidebarView::OnEntryDragDone() {
+  EndDragSession();
+}
