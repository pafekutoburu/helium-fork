--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/workspace_drag_math.h
@@ -0,0 +1,91 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_DRAG_MATH_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_DRAG_MATH_H_
+
+#include <cstddef>
+#include <cstdlib>
+#include <vector>
+
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace helium_workspace {
+
+// Pure hit math for dragging sidebar entries (M3.11). Kept dependency-free
+// so helium_workspace_unittests can exercise it directly.
+//
+// The drop model is Dia's (measured 2026-08-24): the dragged row floats on
+// an overlay, the remaining entries yield in real time, and the only drop
+// guidance is the one empty slot. These functions answer "which slot" from
+// geometry the view supplies; they never look at the model, so the
+// feedback loop that oscillated the old #311 stack (hit test moves the
+// geometry, the geometry re-answers the hit test) cannot form: the row rule
+// reaches a fixpoint after one yield, and the grid rule's slot rects do not
+// depend on which slot is empty at all.
+
+// Insert position among the pinned rows: the number of remaining
+// (non-dragged) rows whose visual center sits above |y|. Midpoint rule --
+// crossing a row's center is what displaces it, which is also why the
+// answer is stable while that row animates: its *target* center is already
+// on the other side. Centers must be in top-to-bottom order.
+inline size_t RowInsertIndex(int y, const std::vector<int>& row_centers) {
+  size_t index = 0;
+  for (int center : row_centers) {
+    if (y > center) {
+      ++index;
+    }
+  }
+  return index;
+}
+
+// Insert slot in the favorites grid. |slot_rects| is the grid laid out for
+// remaining favorites + one (the floating entry's slot travels, the slot
+// count does not), so the geometry is a function of the count alone.
+// Nearest slot: the row band containing |point| (clamped to the first/last
+// band), then the slot in that band whose center is horizontally closest.
+inline size_t GridInsertIndex(const gfx::Point& point,
+                              const std::vector<gfx::Rect>& slot_rects) {
+  if (slot_rects.empty()) {
+    return 0;
+  }
+  // Pick the row band by vertical distance to the band's center.
+  int best_row_y = slot_rects.front().CenterPoint().y();
+  for (const gfx::Rect& r : slot_rects) {
+    const int cy = r.CenterPoint().y();
+    if (std::abs(point.y() - cy) < std::abs(point.y() - best_row_y)) {
+      best_row_y = cy;
+    }
+  }
+  size_t best = 0;
+  int best_dx = 0;
+  bool have = false;
+  for (size_t i = 0; i < slot_rects.size(); ++i) {
+    if (slot_rects[i].CenterPoint().y() != best_row_y) {
+      continue;
+    }
+    const int dx = std::abs(point.x() - slot_rects[i].CenterPoint().x());
+    if (!have || dx < best_dx) {
+      best = i;
+      best_dx = dx;
+      have = true;
+    }
+  }
+  return best;
+}
+
+// Which segment of the sidebar a drag point is over. The header band counts
+// as the rows segment (dropping on the folder head means "first row"), so
+// the boundary that matters is the header's *top*: above it is the grid's
+// territory, everything below belongs to the rows.
+enum class SidebarDragZone { kGrid, kRows };
+
+inline SidebarDragZone ClassifySidebarDragZone(int y, int header_top) {
+  return y < header_top ? SidebarDragZone::kGrid : SidebarDragZone::kRows;
+}
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_DRAG_MATH_H_
Index: src/chrome/browser/ui/helium_workspace/workspace_drag_math_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/workspace_drag_math_unittest.cc
@@ -0,0 +1,91 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_drag_math.h"
+
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium_workspace {
+namespace {
+
+TEST(WorkspaceDragMathTest, RowInsertIndexFollowsTheMidpointRule) {
+  const std::vector<int> centers = {100, 200, 300};
+  EXPECT_EQ(0u, RowInsertIndex(50, centers));
+  EXPECT_EQ(1u, RowInsertIndex(150, centers));
+  EXPECT_EQ(2u, RowInsertIndex(250, centers));
+  EXPECT_EQ(3u, RowInsertIndex(350, centers));
+  // Sitting exactly on a center inserts before it -- crossing displaces.
+  EXPECT_EQ(0u, RowInsertIndex(100, centers));
+  EXPECT_EQ(3u, RowInsertIndex(9999, centers));
+  EXPECT_EQ(0u, RowInsertIndex(0, std::vector<int>()));
+}
+
+TEST(WorkspaceDragMathTest, RowInsertIndexIsMonotonicOverAPointerSweep) {
+  const std::vector<int> centers = {40, 78, 116, 154, 192};
+  size_t last = 0;
+  for (int y = 0; y < 260; ++y) {
+    const size_t index = RowInsertIndex(y, centers);
+    EXPECT_GE(index, last) << "index went backwards at y=" << y;
+    last = index;
+  }
+  EXPECT_EQ(centers.size(), last);
+}
+
+// The one-step fixpoint that keeps live-yield from oscillating: compute an
+// index, let the remaining rows yield to the new hole, and the recomputed
+// index must not change. This is the executable form of the old #311
+// lesson "hit test moves the geometry, the geometry re-answers the hit
+// test".
+TEST(WorkspaceDragMathTest, RowInsertIndexIsAFixpointOnceTheRowsYield) {
+  constexpr int kTop = 500;
+  constexpr int kPitch = 38;
+  constexpr size_t kRemaining = 6;
+  const auto centers_for_hole = [](size_t hole) {
+    std::vector<int> centers;
+    for (size_t i = 0; i < kRemaining; ++i) {
+      const size_t slot = i < hole ? i : i + 1;
+      centers.push_back(kTop + static_cast<int>(slot) * kPitch + kPitch / 2);
+    }
+    return centers;
+  };
+  for (size_t start_hole = 0; start_hole <= kRemaining; ++start_hole) {
+    for (int y = kTop - 20; y < kTop + kPitch * 8; ++y) {
+      const size_t first = RowInsertIndex(y, centers_for_hole(start_hole));
+      const size_t second = RowInsertIndex(y, centers_for_hole(first));
+      EXPECT_EQ(first, second)
+          << "oscillates at y=" << y << " start_hole=" << start_hole;
+    }
+  }
+}
+
+TEST(WorkspaceDragMathTest, GridInsertIndexPicksTheNearestSlotInTheRowBand) {
+  // Two rows of three 60x44 slots with an 8px gap, origin (0, 0).
+  std::vector<gfx::Rect> slots;
+  for (int row = 0; row < 2; ++row) {
+    for (int col = 0; col < 3; ++col) {
+      slots.emplace_back(col * 68, row * 52, 60, 44);
+    }
+  }
+  EXPECT_EQ(0u, GridInsertIndex(gfx::Point(10, 10), slots));
+  EXPECT_EQ(1u, GridInsertIndex(gfx::Point(70, 10), slots));
+  EXPECT_EQ(2u, GridInsertIndex(gfx::Point(140, 20), slots));
+  EXPECT_EQ(3u, GridInsertIndex(gfx::Point(10, 70), slots));
+  EXPECT_EQ(5u, GridInsertIndex(gfx::Point(500, 500), slots));
+  // Above the grid clamps into the first band, never off the list.
+  EXPECT_EQ(0u, GridInsertIndex(gfx::Point(-50, -50), slots));
+  EXPECT_EQ(0u, GridInsertIndex(gfx::Point(0, 0), std::vector<gfx::Rect>()));
+}
+
+TEST(WorkspaceDragMathTest, ZoneSplitsAtTheHeadersTop) {
+  EXPECT_EQ(SidebarDragZone::kGrid, ClassifySidebarDragZone(99, 100));
+  // The header band itself belongs to the rows: dropping on the folder head
+  // means "first row".
+  EXPECT_EQ(SidebarDragZone::kRows, ClassifySidebarDragZone(100, 100));
+  EXPECT_EQ(SidebarDragZone::kRows, ClassifySidebarDragZone(150, 100));
+}
+
+}  // namespace
+}  // namespace helium_workspace
