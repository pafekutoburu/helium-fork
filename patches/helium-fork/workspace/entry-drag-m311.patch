===================================================================
--- /dev/null
+++ src/chrome/browser/ui/views/tabs/common/workspace_entry_drag_overlay.cc
@@ -0,0 +1,271 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/common/workspace_entry_drag_overlay.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/task/sequenced_task_runner.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/helium/arc_sidebar_surface.h"
+#include "chrome/browser/ui/layout_constants.h"
+#include "chrome/browser/ui/views/frame/helium_card_shadow_view.h"
+#include "ui/compositor/layer.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/gfx/animation/tween.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/views/style/typography.h"
+#include "ui/views/style/typography_provider.h"
+#include "ui/views/view_class_properties.h"
+
+namespace {
+
+// The row's own metrics, so the floating card is the row (see
+// workspace_entry_view.cc: the favicon's visual x is kIconLeadingInset 6
+// plus TabIcon's 3pt border, and the title follows one icon and one gap
+// later).
+constexpr int kIconSize = 16;
+constexpr int kRowIconX = 9;
+constexpr int kRowTitleX = 34;
+constexpr int kRowTitleTrailing = 12;
+
+int LerpInt(int from, int to, double t) {
+  return from + base::ClampRound((to - from) * t);
+}
+
+}  // namespace
+
+WorkspaceEntryDragOverlay::WorkspaceEntryDragOverlay()
+    : views::AnimationDelegateViews(this) {
+  SetCanProcessEventsWithinSubtree(false);
+  SetProperty(views::kViewIgnoredByLayoutKey, true);
+  SetVisible(false);
+  morph_animation_.SetSlideDuration(helium::kSidebarDragMorphDuration);
+  morph_animation_.SetTweenType(gfx::Tween::FAST_OUT_SLOW_IN);
+  settle_animation_.SetSlideDuration(helium::kSidebarDragSettleDuration);
+  settle_animation_.SetTweenType(helium::kSidebarDragSettleTween);
+}
+
+WorkspaceEntryDragOverlay::~WorkspaceEntryDragOverlay() = default;
+
+void WorkspaceEntryDragOverlay::SetShadowView(HeliumCardShadowView* shadow) {
+  shadow_ = shadow;
+}
+
+void WorkspaceEntryDragOverlay::Start(const ui::ImageModel& favicon,
+                                      const std::u16string& title,
+                                      SkColor surface,
+                                      SkColor text_color,
+                                      const gfx::Size& row_size,
+                                      const gfx::Vector2dF& grab) {
+  active_ = true;
+  favicon_ = favicon;
+  title_ = title;
+  surface_ = surface;
+  text_color_ = text_color;
+  row_size_ = row_size;
+  capsule_size_ = row_size;
+  grab_ = grab;
+  as_capsule_ = false;
+  morph_animation_.Reset(0.0);
+  settle_animation_.Reset(0.0);
+  settle_done_.Reset();
+  SetVisible(true);
+  // Layers, not view order: the tab strip below paints into one of its own
+  // (it masks to bounds), and a sibling without a layer is painted under it
+  // however late it was added -- the card came out sliced by whatever the
+  // strip drew over it. Both the card and its shadow take a layer for the
+  // length of the gesture and say where they belong out loud.
+  if (shadow_) {
+    shadow_->SetPaintToLayer();
+    shadow_->layer()->SetFillsBoundsOpaquely(false);
+  }
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  StackLayersOnTop();
+}
+
+void WorkspaceEntryDragOverlay::StackLayersOnTop() {
+  // Shadow first, then the card, so the card ends up above its own shadow.
+  if (shadow_ && shadow_->layer() && shadow_->layer()->parent()) {
+    shadow_->layer()->parent()->StackAtTop(shadow_->layer());
+  }
+  if (layer() && layer()->parent()) {
+    layer()->parent()->StackAtTop(layer());
+  }
+}
+
+void WorkspaceEntryDragOverlay::SetPointer(const gfx::Point& point_in_parent) {
+  if (!active_ || settle_animation_.is_animating()) {
+    return;
+  }
+  pointer_ = point_in_parent;
+  ApplyBounds();
+}
+
+void WorkspaceEntryDragOverlay::SetForm(bool as_capsule,
+                                        const gfx::Size& form_size) {
+  if (!active_) {
+    return;
+  }
+  if (as_capsule) {
+    capsule_size_ = form_size;
+  } else {
+    row_size_ = form_size;
+  }
+  if (as_capsule_ == as_capsule) {
+    ApplyBounds();
+    return;
+  }
+  as_capsule_ = as_capsule;
+  // Always driven 0 -> 1 from wherever it stands, so the two directions read
+  // the same. Arc's grid refuses a thirteenth entry by simply never asking
+  // for the capsule form.
+  if (as_capsule) {
+    morph_animation_.Show();
+  } else {
+    morph_animation_.Hide();
+  }
+  ApplyBounds();
+}
+
+void WorkspaceEntryDragOverlay::SettleTo(const gfx::Rect& target,
+                                         base::OnceClosure done) {
+  if (!active_) {
+    std::move(done).Run();
+    return;
+  }
+  settle_from_ = bounds();
+  settle_to_ = target;
+  settle_done_ = std::move(done);
+  if (settle_from_ == settle_to_ || settle_from_.IsEmpty() ||
+      settle_to_.IsEmpty()) {
+    // Nowhere to travel, or nowhere to travel to (the entry went away
+    // underneath us). Hand the row back on the next turn rather than
+    // re-entering the caller from inside its own call.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(settle_done_));
+    return;
+  }
+  settle_animation_.Reset(0.0);
+  settle_animation_.Show();
+}
+
+void WorkspaceEntryDragOverlay::Stop() {
+  active_ = false;
+  // A layer per row is exactly what M3.10-r1 warned against keeping around;
+  // these two exist only while the card is in the air.
+  DestroyLayer();
+  if (shadow_ && shadow_->layer()) {
+    shadow_->DestroyLayer();
+  }
+  settle_animation_.Reset(0.0);
+  morph_animation_.Reset(0.0);
+  settle_done_.Reset();
+  favicon_ = ui::ImageModel();
+  title_.clear();
+  SetVisible(false);
+  if (shadow_) {
+    shadow_->SetVisible(false);
+  }
+}
+
+gfx::Rect WorkspaceEntryDragOverlay::CurrentRect() const {
+  if (settle_animation_.is_animating()) {
+    const double t = settle_animation_.GetCurrentValue();
+    return gfx::Rect(LerpInt(settle_from_.x(), settle_to_.x(), t),
+                     LerpInt(settle_from_.y(), settle_to_.y(), t),
+                     LerpInt(settle_from_.width(), settle_to_.width(), t),
+                     LerpInt(settle_from_.height(), settle_to_.height(), t));
+  }
+  const double t = morph_animation_.GetCurrentValue();
+  const gfx::Size size(
+      LerpInt(row_size_.width(), capsule_size_.width(), t),
+      LerpInt(row_size_.height(), capsule_size_.height(), t));
+  // The grab point keeps its place inside the card as the card changes
+  // shape, which is what makes the morph read as the same object.
+  return gfx::Rect(
+      pointer_.x() - base::ClampRound(grab_.x() * size.width()),
+      pointer_.y() - base::ClampRound(grab_.y() * size.height()), size.width(),
+      size.height());
+}
+
+void WorkspaceEntryDragOverlay::ApplyBounds() {
+  const gfx::Rect rect = CurrentRect();
+  SetBoundsRect(rect);
+  StackLayersOnTop();
+  if (shadow_) {
+    const int radius =
+        GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius);
+    shadow_->SetShadowCornerRadius(radius);
+    shadow_->SetCardBounds(rect);
+    shadow_->SetVisible(
+        active_ && helium::CanShowCardShadow(rect.width(), rect.height(),
+                                             radius));
+  }
+  SchedulePaint();
+}
+
+void WorkspaceEntryDragOverlay::OnPaint(gfx::Canvas* canvas) {
+  if (!active_) {
+    return;
+  }
+  const gfx::RectF local(GetLocalBounds());
+  const int radius = GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius);
+  cc::PaintFlags fill;
+  fill.setStyle(cc::PaintFlags::kFill_Style);
+  fill.setAntiAlias(true);
+  fill.setColor(surface_);
+  canvas->DrawRoundRect(local, radius, fill);
+
+  const double morph = settle_animation_.is_animating()
+                           ? (as_capsule_ ? 1.0 : 0.0)
+                           : morph_animation_.GetCurrentValue();
+  // Row form puts the favicon in the rows' icon column; capsule form centres
+  // it. The title only belongs to the row, and it leaves as the card
+  // narrows rather than being clipped by it.
+  const int icon_row_x = kRowIconX;
+  const int icon_capsule_x = (width() - kIconSize) / 2;
+  const gfx::Rect icon_rect(LerpInt(icon_row_x, icon_capsule_x, morph),
+                            (height() - kIconSize) / 2, kIconSize, kIconSize);
+  if (!favicon_.IsEmpty() && favicon_.IsImage()) {
+    canvas->DrawImageInt(favicon_.GetImage().AsImageSkia(), 0, 0, kIconSize,
+                         kIconSize, icon_rect.x(), icon_rect.y(), kIconSize,
+                         kIconSize, /*filter=*/true);
+  }
+  const int title_alpha = base::ClampRound(255 * (1.0 - morph));
+  if (!title_.empty() && title_alpha > 0) {
+    const int title_width = width() - kRowTitleX - kRowTitleTrailing;
+    if (title_width > 0) {
+      canvas->DrawStringRectWithFlags(
+          title_,
+          views::TypographyProvider::Get().GetFont(views::style::CONTEXT_LABEL,
+                                                   views::style::STYLE_PRIMARY),
+          SkColorSetA(text_color_, title_alpha),
+          gfx::Rect(kRowTitleX, 0, title_width, height()),
+          gfx::Canvas::TEXT_ALIGN_LEFT | gfx::Canvas::NO_SUBPIXEL_RENDERING);
+    }
+  }
+}
+
+void WorkspaceEntryDragOverlay::AnimationProgressed(
+    const gfx::Animation* animation) {
+  ApplyBounds();
+}
+
+void WorkspaceEntryDragOverlay::AnimationEnded(const gfx::Animation* animation) {
+  if (animation == &settle_animation_) {
+    if (!settle_done_.is_null()) {
+      std::move(settle_done_).Run();
+    }
+    return;
+  }
+  ApplyBounds();
+}
+
+BEGIN_METADATA(WorkspaceEntryDragOverlay)
+END_METADATA
