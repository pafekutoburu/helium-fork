+void WorkspaceTabController::AddTabToFavorites(int index) {
+  TabStripModel* model = browser_window_->GetTabStripModel();
+  if (!model || index < 0 || index >= model->count()) {
+    return;
+  }
+  tabs::TabInterface* tab = model->GetTabAtIndex(index);
+  if (!tab) {
+    return;
+  }
+  const tabs::TabHandle handle = tab->GetHandle();
+  if (!service_->FindEntryIdForTab(handle).empty()) {
+    // Already an entry — moving it between sections is SetEntrySection's job.
+    return;
+  }
+  const GURL url = tab->GetURL();
+  if (!url.is_valid()) {
+    return;
+  }
+
+  // Adopt an entry already recorded for this URL rather than minting a second
+  // one, for the same reason as the native-pin path in
+  // OnTabPinnedStateChanged().
+  std::string id;
+  if (const WorkspaceEntry* existing =
+          service_->FindEntryByUrlUnboundInWindow(url, browser_window_)) {
+    id = existing->id;
+    if (!service_->SetEntrySection(id, WorkspaceEntry::Section::kFavorite)) {
+      return;  // Favorites cap.
+    }
+  } else {
+    content::WebContents* contents = tab->GetContents();
+    id = service_->AddEntry(WorkspaceEntry::Section::kFavorite, url,
+                            contents ? contents->GetTitle() : std::u16string());
+    if (id.empty()) {
+      return;  // Favorites cap.
+    }
+  }
+  BindTabToEntry(tab, id);
+}
