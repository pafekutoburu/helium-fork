Index: src/chrome/browser/ui/helium_workspace/workspace_blank_tab.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/workspace_blank_tab.h
@@ -0,0 +1,49 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_BLANK_TAB_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_BLANK_TAB_H_
+
+#include <string_view>
+
+#include "url/gurl.h"
+
+namespace helium_workspace {
+
+// The scheme and the two hosts the new tab page answers on. The browser
+// navigates new tabs to `chrome://newtab`, a URL handler pair rewrites that to
+// `chrome://new-tab-page` and reverse-rewrites it back, so one and the same
+// tab reports `new-tab-page` as its committed URL and `newtab` as its virtual
+// one. Which host a caller sees depends on where it reads the URL from, so
+// both count.
+//
+// These are literals rather than chrome::kChromeUINewTabHost and friends so
+// that the predicate below can be tested without dragging //chrome/common into
+// the test target. tab_strip_model.cc has the real constants in scope and
+// static_asserts them against these, so an upstream rename fails the build
+// rather than quietly turning this predicate into "never".
+inline constexpr std::string_view kNewTabScheme = "chrome";
+inline constexpr std::string_view kNewTabHost = "newtab";
+inline constexpr std::string_view kNewTabPageHost = "new-tab-page";
+
+// Whether a tab is the browser's own new tab page with nothing behind it.
+//
+// This is the state a window is left in when closing its last tab hands the
+// user a fresh tab instead of taking the window away. Recognising that state
+// is what lets the *next* close actually close the window, so the rule reads
+// as "closing the last tab costs you nothing, closing the nothing costs you
+// the window".
+//
+// |entry_count| is the tab's navigation entry count: zero while the new tab is
+// still pending, one once it commits. Anything above that means the user has
+// navigated, and the tab now holds something they could lose.
+inline bool IsBlankNewTabState(const GURL& visible_url, int entry_count) {
+  return entry_count <= 1 && visible_url.scheme() == kNewTabScheme &&
+         (visible_url.host() == kNewTabHost ||
+          visible_url.host() == kNewTabPageHost);
+}
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_BLANK_TAB_H_
