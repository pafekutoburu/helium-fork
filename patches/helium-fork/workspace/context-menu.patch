+bool WorkspaceService::SetEntrySection(const std::string& id,
+                                       WorkspaceEntry::Section section) {
+  for (WorkspaceEntry& entry : entries_) {
+    if (entry.id != id) {
+      continue;
+    }
+    if (entry.section == section) {
+      return true;
+    }
+    if (section == WorkspaceEntry::Section::kFavorite &&
+        CountFavorites() >= kMaxFavorites) {
+      return false;
+    }
+    entry.section = section;
+    entry.position = NextPosition(section);
+    std::stable_sort(entries_.begin(), entries_.end(), EntryOrderLess);
+    PersistToPrefs();
+    NotifyChanged();
+    return true;
+  }
+  return false;
+}
+
+size_t WorkspaceService::CountFavorites() const {
+  return std::ranges::count_if(entries_, [](const WorkspaceEntry& e) {
+    return e.section == WorkspaceEntry::Section::kFavorite;
+  });
+}
+
 void WorkspaceService::BindTab(tabs::TabHandle handle,
                                const std::string& entry_id) {
   tab_to_entry_[handle] = entry_id;
@@ -180,6 +209,59 @@ bool WorkspaceService::IsWorkspaceTab(ta
   return tab_to_entry_.contains(handle);
 }
 
+std::optional<WorkspaceEntry::Section> WorkspaceService::GetSectionForTab(
+    tabs::TabHandle handle) const {
+  const auto it = tab_to_entry_.find(handle);
+  if (it == tab_to_entry_.end()) {
+    return std::nullopt;
+  }
+  const WorkspaceEntry* entry = FindEntryById(it->second);
+  return entry ? std::optional(entry->section) : std::nullopt;
+}
+
+bool WorkspaceService::IsFavoriteTab(tabs::TabHandle handle) const {
+  return GetSectionForTab(handle) == WorkspaceEntry::Section::kFavorite;
+}
+
+void WorkspaceService::SyncOrderFromTabStrip(TabStripModel* model) {
+  if (!model) {
+    return;
+  }
+  int favorite_position = 0;
+  int pinned_position = 0;
+  bool changed = false;
+  for (int i = 0; i < model->IndexOfFirstNonPinnedTab(); ++i) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(i);
+    if (!tab) {
+      continue;
+    }
+    const std::string entry_id = FindEntryIdForTab(tab->GetHandle());
+    if (entry_id.empty()) {
+      continue;
+    }
+    for (WorkspaceEntry& entry : entries_) {
+      if (entry.id != entry_id) {
+        continue;
+      }
+      int& next_position =
+          entry.section == WorkspaceEntry::Section::kFavorite
+              ? favorite_position
+              : pinned_position;
+      if (entry.position != next_position) {
+        entry.position = next_position;
+        changed = true;
+      }
+      ++next_position;
+      break;
+    }
+  }
+  if (changed) {
+    std::stable_sort(entries_.begin(), entries_.end(), EntryOrderLess);
+    PersistToPrefs();
+    NotifyChanged();
+  }
+}
+
 void WorkspaceService::MarkPendingReset(tabs::TabHandle handle) {
   pending_reset_.insert(handle);
 }
