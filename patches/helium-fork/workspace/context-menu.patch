+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace helium_workspace {
+namespace {
+
+// The virtual URL of a new tab, which is what the browser navigated to.
+TEST(WorkspaceBlankTabTest, PendingNewTabIsBlank) {
+  EXPECT_TRUE(IsBlankNewTabState(GURL("chrome://newtab/"), 0));
+}
+
+TEST(WorkspaceBlankTabTest, CommittedNewTabIsBlank) {
+  EXPECT_TRUE(IsBlankNewTabState(GURL("chrome://newtab/"), 1));
+}
+
+// The committed URL of the same tab: a URL handler rewrites `chrome://newtab`
+// to this and reverse-rewrites it back, so both hosts have to be recognised.
+TEST(WorkspaceBlankTabTest, RewrittenNewTabHostIsBlank) {
+  EXPECT_TRUE(IsBlankNewTabState(GURL("chrome://new-tab-page/"), 1));
+}
+
+// Going to a site and back leaves the new tab page on screen with history
+// behind it. Closing that is not free, so it must not pass for blank.
+TEST(WorkspaceBlankTabTest, NewTabWithHistoryBehindItIsNotBlank) {
+  EXPECT_FALSE(IsBlankNewTabState(GURL("chrome://new-tab-page/"), 2));
+}
+
+TEST(WorkspaceBlankTabTest, OrdinaryPageIsNotBlank) {
+  EXPECT_FALSE(IsBlankNewTabState(GURL("https://example.com/"), 1));
+}
+
+// A tab with no visible entry at all reports an empty URL. Treating that as
+// blank would let a window close while a real navigation was still in flight.
+TEST(WorkspaceBlankTabTest, EmptyUrlIsNotBlank) {
+  EXPECT_FALSE(IsBlankNewTabState(GURL(), 0));
+}
+
+// Same scheme, different WebUI: only the new tab page is disposable.
+TEST(WorkspaceBlankTabTest, OtherWebUiPageIsNotBlank) {
+  EXPECT_FALSE(IsBlankNewTabState(GURL("chrome://settings/"), 1));
+}
+
+// A site cannot dress up as the new tab page by borrowing its host.
+TEST(WorkspaceBlankTabTest, MatchingHostOnAnotherSchemeIsNotBlank) {
+  EXPECT_FALSE(IsBlankNewTabState(GURL("https://newtab/"), 1));
+}
+
+}  // namespace
+}  // namespace helium_workspace
