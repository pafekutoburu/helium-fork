+
+void WorkspaceService::SyncOrderFromTabStrip(TabStripModel* model) {
+  if (!model) {
+    return;
+  }
+  int favorite_position = 0;
+  int pinned_position = 0;
+  bool changed = false;
+  std::set<std::string> renumbered;
+  const auto next_position_for = [&](WorkspaceEntry::Section section) -> int& {
+    return section == WorkspaceEntry::Section::kFavorite ? favorite_position
+                                                         : pinned_position;
+  };
+  const auto place = [&](WorkspaceEntry& entry) {
+    int& next_position = next_position_for(entry.section);
+    if (entry.position != next_position) {
+      entry.position = next_position;
+      changed = true;
+    }
+    ++next_position;
+    renumbered.insert(entry.id);
+  };
+
+  for (int i = 0; i < model->IndexOfFirstNonPinnedTab(); ++i) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(i);
+    if (!tab) {
+      continue;
+    }
+    const std::string entry_id = FindEntryIdForTab(tab->GetHandle());
+    if (entry_id.empty()) {
+      continue;
+    }
+    for (WorkspaceEntry& entry : entries_) {
+      if (entry.id == entry_id) {
+        place(entry);
+        break;
+      }
+    }
+  }
+
+  // helium-fork: entries this window did not walk -- bound in another window,
+  // or still waiting for reconciliation to re-create their tab -- used to keep
+  // whatever position they already had, while the loop above re-based the
+  // visited subset to zero and handed those same numbers out again. Every
+  // window re-basing its own subset left `position` full of collisions, which
+  // makes EntryOrderLess a sea of ties and lets the sidebar order drift
+  // between passes. Renumber the remainder after the visited prefix instead,
+  // keeping its existing relative order (entries_ is kept sorted).
+  for (WorkspaceEntry& entry : entries_) {
+    if (!renumbered.contains(entry.id)) {
+      place(entry);
+    }
+  }
+
+  if (changed) {
+    std::stable_sort(entries_.begin(), entries_.end(), EntryOrderLess);
+    PersistToPrefs();
+    NotifyChanged();
+  }
+}
