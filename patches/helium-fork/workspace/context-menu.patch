+void WorkspaceTabController::ScheduleEnforceSectionOrder() {
+  if (enforce_order_pending_) {
+    return;
+  }
+  enforce_order_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&WorkspaceTabController::EnforceSectionOrder,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceTabController::EnforceSectionOrder() {
+  enforce_order_pending_ = false;
+  TabStripModel* model = browser_window_->GetTabStripModel();
+  if (!model || model->closing_all()) {
+    return;
+  }
+  base::AutoReset<bool> self_mutation(&in_self_mutation_, true);
+
+  // Desired order = entries in model order (favorites first, then by
+  // position) mapped to their bound tabs in this window.
+  int slot = 0;
+  for (const WorkspaceEntry& entry : service_->entries()) {
+    const tabs::TabHandle handle = service_->FindTabForEntry(entry.id);
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab) {
+      continue;
+    }
+    const int current = model->GetIndexOfTab(tab);
+    if (current < 0) {
+      continue;  // Bound in another window.
+    }
+    if (current != slot) {
+      model->MoveWebContentsAt(current, slot, /*select_after_move=*/false);
+    }
+    ++slot;
+  }
+  service_->SyncOrderFromTabStrip(model);
+}
+
+void WorkspaceTabController::OnWorkspaceEntriesChanged() {
