+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_archive_service.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/lifetime/browser_shutdown.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
+#include "chrome/browser/ui/helium_workspace/workspace_archive_policy.h"
+#include "chrome/browser/ui/helium_workspace/workspace_prefs.h"
+#include "chrome/browser/ui/helium_workspace/workspace_service.h"
+#include "chrome/browser/ui/helium_workspace/workspace_service_factory.h"
+#include "components/prefs/pref_service.h"
+#include "components/sessions/core/session_id.h"
+
+namespace helium_workspace {
+namespace {
+
+// Acceptance levers, off unless asked for. Declared here rather than in
+// chrome_switches.h for the same reason --helium-drag-perf is declared in
+// workspace_sidebar_view.cc: one fewer shared upstream file in the patch.
+//
+// Without these the default tier is 24 hours, so an acceptance run would
+// have to wait a day.
+constexpr char kThresholdSwitch[] = "helium-today-archive-minutes";
+constexpr char kSweepSecondsSwitch[] = "helium-today-archive-sweep-seconds";
+
+int SwitchValueOr(const char* name, int fallback) {
+  const base::CommandLine* const command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(name)) {
+    return fallback;
+  }
+  int value = 0;
+  if (!base::StringToInt(command_line->GetSwitchValueASCII(name), &value)) {
+    return fallback;
+  }
+  return value;
+}
+
+}  // namespace
+
+WorkspaceArchiveService::WorkspaceArchiveService(Profile* profile)
+    : profile_(profile) {
+  threshold_override_minutes_ = SwitchValueOr(kThresholdSwitch, -1);
+  const int sweep_seconds = SwitchValueOr(kSweepSecondsSwitch, 0);
+  if (sweep_seconds > 0) {
+    sweep_interval_ = base::Seconds(sweep_seconds);
+  }
+
+  pref_change_registrar_.Init(profile_->GetPrefs());
+  pref_change_registrar_.Add(
+      prefs::kWorkspaceTodayArchiveMinutes,
+      base::BindRepeating(&WorkspaceArchiveService::ApplyThreshold,
+                          base::Unretained(this)));
+  ApplyThreshold();
+}
+
+WorkspaceArchiveService::~WorkspaceArchiveService() = default;
+
+void WorkspaceArchiveService::Shutdown() {
+  // Stop, and do *not* run one last sweep. WorkspaceService::Shutdown()
+  // flushes its debounced write on the way out because losing a write loses
+  // data; closing tabs on the way out is the opposite trade -- and by then
+  // TabRestoreService may already be gone, which would take the tabs out of
+  // Cmd+Shift+T with them.
+  sweep_timer_.Stop();
+  pref_change_registrar_.RemoveAll();
+}
+
+int WorkspaceArchiveService::ThresholdMinutes() const {
+  if (threshold_override_minutes_ >= 0) {
+    return ClampArchiveMinutes(threshold_override_minutes_);
+  }
+  return ClampArchiveMinutes(profile_->GetPrefs()->GetInteger(
+      prefs::kWorkspaceTodayArchiveMinutes));
+}
+
+void WorkspaceArchiveService::ApplyThreshold() {
+  if (ThresholdMinutes() == kArchiveNeverMinutes) {
+    sweep_timer_.Stop();
+    return;
+  }
+  if (sweep_timer_.IsRunning()) {
+    return;
+  }
+  // Start() waits a full interval before the first run, and that wait is
+  // the grace period: sweeping the instant the browser comes up would close
+  // a pile of restored tabs before the user has looked at the window, and
+  // would do it while session restore is still adding tabs. Anything the
+  // user touches in those five minutes refreshes its own clock and is
+  // spared.
+  sweep_timer_.Start(FROM_HERE, sweep_interval_,
+                     base::BindRepeating(&WorkspaceArchiveService::Sweep,
+                                         base::Unretained(this)));
+}
+
+void WorkspaceArchiveService::SweepNowForTesting() {
+  Sweep();
+}
+
+void WorkspaceArchiveService::Sweep() {
+  // If the profile is being torn down, TabRestoreService may already have
+  // shut down, and CreateHistoricalTab then quietly drops the tab instead of
+  // filing it. An unrecoverable close is the one failure this feature may
+  // not have.
+  if (browser_shutdown::HasShutdownStarted()) {
+    return;
+  }
+  const int minutes = ThresholdMinutes();
+  if (minutes == kArchiveNeverMinutes) {
+    return;
+  }
+  WorkspaceService* const service =
+      WorkspaceServiceFactory::GetForProfile(profile_);
+  ProfileBrowserCollection* const collection =
+      ProfileBrowserCollection::GetForProfile(profile_);
+  if (!service || !collection) {
+    return;
+  }
+
+  // Pass one is read-only. ForEach hands out raw pointers from a snapshot
+  // and explicitly does not track what closes during iteration, so nothing
+  // here may close a tab.
+  const base::Time now = base::Time::Now();
+  std::vector<std::pair<SessionID, ArchivePlan>> plans;
+  collection->ForEach([&](BrowserWindowInterface* browser) {
+    if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+        browser->IsDeleteScheduled()) {
+      return true;
+    }
+    ArchivePlan plan =
+        PlanAutoArchive(SampleWindow(browser, *service), now, minutes);
+    // The active tab is always spared, and every non-empty strip has one,
+    // so a sweep can never take a window down. Asserted at the call site
+    // because the proof lives in the pure layer's contract.
+    CHECK(!plan.empties_window);
+    if (!plan.to_close.empty()) {
+      plans.emplace_back(browser->GetSessionID(), std::move(plan));
+    }
+    return true;
+  });
+
+  // Pass two resolves everything again: a window or a tab may have gone
+  // away while pass one was still walking.
+  for (const auto& [session_id, plan] : plans) {
+    ExecuteArchivePlan(collection->FindBrowserWithID(session_id), plan);
+  }
+}
+
+}  // namespace helium_workspace
