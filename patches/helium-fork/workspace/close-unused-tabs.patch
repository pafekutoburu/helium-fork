+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_ARCHIVE_SERVICE_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_ARCHIVE_SERVICE_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/prefs/pref_change_registrar.h"
+
+class Profile;
+
+namespace helium_workspace {
+
+// helium-fork M4: closes unpinned sidebar tabs untouched for longer
+// than helium.workspace.today_archive_minutes.
+//
+// Why its own service rather than a few lines in WorkspaceService: that
+// class takes nothing but a PrefService* on purpose (see its header), which
+// is what lets helium_workspace_unittests build it directly. Enumerating
+// windows needs //content and //chrome/browser/ui, neither of which that
+// target has -- adding them would cost the whole lightweight test suite.
+//
+// Why not one timer per window: WorkspaceTabController comes and goes with
+// its window (tearing a tab out builds a new one), so a timer living there
+// would reset its phase every time, and "when will this tab be swept" would
+// depend on which window it happens to be in. Cmd+Shift+K *is* window
+// scoped and does live there -- WorkspaceTabController::CloseUnpinnedTabs().
+class WorkspaceArchiveService : public KeyedService {
+ public:
+  // Arc sweeps every five minutes (measured 2026-08-25: its sweep timestamps
+  // are all five-minute multiples off a per-run offset). Matching it keeps
+  // the overshoot bounded by the interval.
+  static constexpr base::TimeDelta kDefaultSweepInterval = base::Minutes(5);
+
+  explicit WorkspaceArchiveService(Profile* profile);
+  WorkspaceArchiveService(const WorkspaceArchiveService&) = delete;
+  WorkspaceArchiveService& operator=(const WorkspaceArchiveService&) = delete;
+  ~WorkspaceArchiveService() override;
+
+  // KeyedService:
+  void Shutdown() override;
+
+  // Runs a sweep now. Public for the probe's sake as well as tests -- the
+  // real cadence is far too slow to drive an acceptance run.
+  void SweepNowForTesting();
+
+  bool IsTimerRunningForTesting() const { return sweep_timer_.IsRunning(); }
+
+ private:
+  // The pref, clamped, unless --helium-today-archive-minutes overrode it.
+  int ThresholdMinutes() const;
+
+  // Starts, restarts or stops the timer to match the current tier. Never
+  // means stopped, not "running but returning early" -- a permanently armed
+  // timer keeps the process out of some idle states for nothing.
+  void ApplyThreshold();
+
+  void Sweep();
+
+  const raw_ptr<Profile> profile_;
+  PrefChangeRegistrar pref_change_registrar_;
+  base::RepeatingTimer sweep_timer_;
+
+  // Test/probe overrides from the command line. -1 means "not overridden".
+  int threshold_override_minutes_ = -1;
+  base::TimeDelta sweep_interval_ = kDefaultSweepInterval;
+};
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_ARCHIVE_SERVICE_H_
