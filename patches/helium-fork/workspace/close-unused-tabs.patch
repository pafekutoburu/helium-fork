--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/workspace_archive_policy_unittest.cc
@@ -0,0 +1,394 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_archive_policy.h"
+
+#include <limits>
+#include <memory>
+#include <vector>
+
+#include "base/time/time.h"
+#include "components/tabs/public/mock_tab_interface.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium_workspace {
+namespace {
+
+using ::testing::ElementsAre;
+
+// This is the only place the "close tabs unattended" rules are actually
+// held. Everything below the pure layer -- the timer, the sweep, the
+// keyboard shortcut -- can only get these wrong by not calling them.
+class WorkspaceArchivePolicyTest : public testing::Test {
+ protected:
+  // Distinct, resolvable handles. The policy only ever copies them, but
+  // using real ones keeps the tests honest about identity.
+  tabs::TabHandle NewHandle() {
+    tabs_.push_back(std::make_unique<tabs::MockTabInterface>());
+    return tabs_.back()->GetHandle();
+  }
+
+  // A plain unpinned tab, last touched |age| ago.
+  ArchiveTabState Aged(base::TimeDelta age) {
+    ArchiveTabState tab;
+    tab.handle = NewHandle();
+    tab.last_active = now_ - age;
+    return tab;
+  }
+
+  const base::Time now_ = base::Time::Now();
+
+ private:
+  std::vector<std::unique_ptr<tabs::MockTabInterface>> tabs_;
+};
+
+// ---- tiers ----------------------------------------------------------------
+
+// The tiers are minute counts, and appearance_behavior_page.ts writes the
+// same numbers. A typo here is a tier that silently means something else.
+TEST_F(WorkspaceArchivePolicyTest, TierValuesAreTheMinuteCounts) {
+  EXPECT_EQ(720, kArchive12Hours);
+  EXPECT_EQ(1440, kArchive24Hours);
+  EXPECT_EQ(4320, kArchive3Days);
+  EXPECT_EQ(10080, kArchive7Days);
+  EXPECT_EQ(43200, kArchive30Days);
+  EXPECT_EQ(0, kArchiveNeverMinutes);
+}
+
+// The user moved the default off Arc's 12h on 2026-08-25. Nothing should
+// quietly move it back while "matching the reference browser".
+TEST_F(WorkspaceArchivePolicyTest, DefaultTierIs24Hours) {
+  EXPECT_EQ(kArchive24Hours, kArchiveDefaultMinutes);
+}
+
+TEST_F(WorkspaceArchivePolicyTest, ClampFoldsNonPositiveToNever) {
+  EXPECT_EQ(kArchiveNeverMinutes, ClampArchiveMinutes(0));
+  EXPECT_EQ(kArchiveNeverMinutes, ClampArchiveMinutes(-1));
+  EXPECT_EQ(kArchiveNeverMinutes,
+            ClampArchiveMinutes(std::numeric_limits<int>::min()));
+}
+
+TEST_F(WorkspaceArchivePolicyTest, ClampHasAnUpperBound) {
+  EXPECT_EQ(kArchiveMaxMinutes,
+            ClampArchiveMinutes(std::numeric_limits<int>::max()));
+  EXPECT_EQ(kArchive30Days, ClampArchiveMinutes(kArchive30Days));
+}
+
+// ---- the age test ---------------------------------------------------------
+
+// Arc's floor across 120 automatic archives is exactly 12.00h with nothing
+// under it, so the comparison is >=, not >.
+TEST_F(WorkspaceArchivePolicyTest, ExactlyAtThresholdArchives) {
+  const ArchiveTabState tab = Aged(base::Minutes(kArchive12Hours));
+  EXPECT_EQ(ArchiveSkipReason::kNone,
+            ClassifyForAutoArchive(tab, now_, kArchive12Hours));
+}
+
+TEST_F(WorkspaceArchivePolicyTest, OneSecondUnderThresholdSpared) {
+  const ArchiveTabState tab =
+      Aged(base::Minutes(kArchive12Hours) - base::Seconds(1));
+  EXPECT_EQ(ArchiveSkipReason::kTooRecent,
+            ClassifyForAutoArchive(tab, now_, kArchive12Hours));
+}
+
+// A pref someone hand-edited to a value no menu offers still works: the
+// value *is* the minute count, there is no enum to fall off.
+TEST_F(WorkspaceArchivePolicyTest, ArbitraryThresholdIsHonored) {
+  EXPECT_EQ(ArchiveSkipReason::kNone,
+            ClassifyForAutoArchive(Aged(base::Minutes(91)), now_, 90));
+  EXPECT_EQ(ArchiveSkipReason::kTooRecent,
+            ClassifyForAutoArchive(Aged(base::Minutes(89)), now_, 90));
+}
+
+// Clock moved backwards, or the machine resumed with a corrected clock.
+// "Leave it alone" is the only safe direction for an unattended close.
+TEST_F(WorkspaceArchivePolicyTest, FutureLastActiveSpared) {
+  ArchiveTabState tab = Aged(base::TimeDelta());
+  tab.last_active = now_ + base::Hours(1);
+  EXPECT_EQ(ArchiveSkipReason::kTooRecent,
+            ClassifyForAutoArchive(tab, now_, kArchive12Hours));
+}
+
+TEST_F(WorkspaceArchivePolicyTest, NeverThresholdDisablesEverything) {
+  const ArchiveTabState tab = Aged(base::Days(30));
+  EXPECT_EQ(ArchiveSkipReason::kDisabled,
+            ClassifyForAutoArchive(tab, now_, kArchiveNeverMinutes));
+}
+
+TEST_F(WorkspaceArchivePolicyTest, NegativeThresholdIsNever) {
+  const ArchiveTabState tab = Aged(base::Days(30));
+  EXPECT_EQ(ArchiveSkipReason::kDisabled,
+            ClassifyForAutoArchive(tab, now_, -1));
+}
+
+// ---- the six protections --------------------------------------------------
+
+TEST_F(WorkspaceArchivePolicyTest, ActiveTabNeverArchived) {
+  ArchiveTabState tab = Aged(base::Days(30));
+  tab.is_active = true;
+  EXPECT_EQ(ArchiveSkipReason::kActive,
+            ClassifyForAutoArchive(tab, now_, kArchive12Hours));
+}
+
+// Not the same question as active: the other half of a split view is on
+// screen without being the active tab.
+TEST_F(WorkspaceArchivePolicyTest, VisibleNonActiveTabSpared) {
+  ArchiveTabState tab = Aged(base::Days(30));
+  tab.is_visible = true;
+  EXPECT_EQ(ArchiveSkipReason::kVisible,
+            ClassifyForAutoArchive(tab, now_, kArchive12Hours));
+}
+
+// Whether a split's inactive half ever gets WasShown() is unmeasured in
+// this fork, so is_split guards it independently of is_visible.
+TEST_F(WorkspaceArchivePolicyTest, SplitTabSpared) {
+  ArchiveTabState tab = Aged(base::Days(30));
+  tab.is_split = true;
+  EXPECT_EQ(ArchiveSkipReason::kSplit,
+            ClassifyForAutoArchive(tab, now_, kArchive12Hours));
+}
+
+TEST_F(WorkspaceArchivePolicyTest, SidebarEntryTabIsNotUnpinned) {
+  ArchiveTabState tab = Aged(base::Days(30));
+  tab.is_workspace_entry = true;
+  EXPECT_EQ(ArchiveSkipReason::kSidebarEntry,
+            ClassifyForAutoArchive(tab, now_, kArchive12Hours));
+}
+
+// A blank new tab page holds nothing, and TabStripModel does not file one
+// with TabRestoreService -- so archiving one is both pointless and, via the
+// Clear toast's Undo count, actively wrong.
+TEST_F(WorkspaceArchivePolicyTest, BlankNewTabSpared) {
+  ArchiveTabState tab = Aged(base::Days(30));
+  tab.is_blank_new_tab = true;
+  EXPECT_EQ(ArchiveSkipReason::kBlankNewTab,
+            ClassifyForAutoArchive(tab, now_, kArchive12Hours));
+  EXPECT_EQ(ArchiveSkipReason::kBlankNewTab, ClassifyForCloseUnpinned(tab));
+}
+
+TEST_F(WorkspaceArchivePolicyTest, AudibleTabSpared) {
+  ArchiveTabState tab = Aged(base::Days(30));
+  tab.is_audible = true;
+  EXPECT_EQ(ArchiveSkipReason::kAudible,
+            ClassifyForAutoArchive(tab, now_, kArchive12Hours));
+}
+
+TEST_F(WorkspaceArchivePolicyTest, MediaActiveTabSpared) {
+  ArchiveTabState tab = Aged(base::Days(30));
+  tab.is_media_active = true;
+  EXPECT_EQ(ArchiveSkipReason::kMediaActive,
+            ClassifyForAutoArchive(tab, now_, kArchive12Hours));
+}
+
+// The unattended sweep spares it -- nobody is watching, so a page that
+// would put up a "Leave site?" dialog gets left alone.
+TEST_F(WorkspaceArchivePolicyTest, BeforeUnloadTabSparedBySweep) {
+  ArchiveTabState tab = Aged(base::Days(30));
+  tab.could_prompt = true;
+  EXPECT_EQ(ArchiveSkipReason::kBeforeUnload,
+            ClassifyForAutoArchive(tab, now_, kArchive12Hours));
+}
+
+// ...but the explicit command must NOT. This is the one that made YouTube
+// unclosable: it is a single-page app, so its beforeunload registration
+// survives every in-page navigation, and one click anywhere on the page
+// arms sticky activation across all its same-origin frames. Honouring the
+// flag here meant the tab could never be closed again for the rest of its
+// life (user 2026-08-26).
+TEST_F(WorkspaceArchivePolicyTest, BeforeUnloadTabIsClosedByExplicitCommand) {
+  ArchiveTabState tab = Aged(base::Minutes(1));
+  tab.could_prompt = true;
+  EXPECT_EQ(ArchiveSkipReason::kNone, ClassifyForCloseUnpinned(tab));
+
+  std::vector<ArchiveTabState> tabs = {tab};
+  EXPECT_THAT(PlanCloseUnpinned(tabs).to_close, ElementsAre(tab.handle));
+}
+
+// The probe counts tabs per reason, so a tab that trips several rules must
+// always report the same one.
+TEST_F(WorkspaceArchivePolicyTest, SkipReasonPrecedenceIsStable) {
+  ArchiveTabState tab = Aged(base::Days(30));
+  tab.is_workspace_entry = true;
+  tab.is_audible = true;
+  tab.could_prompt = true;
+  tab.is_active = true;
+  EXPECT_EQ(ArchiveSkipReason::kSidebarEntry,
+            ClassifyForAutoArchive(tab, now_, kArchive12Hours));
+  EXPECT_EQ(ArchiveSkipReason::kSidebarEntry, ClassifyForCloseUnpinned(tab));
+}
+
+// ---- PlanAutoArchive ------------------------------------------------------
+
+TEST_F(WorkspaceArchivePolicyTest, PlanPreservesStripOrder) {
+  std::vector<ArchiveTabState> tabs;
+  for (int i = 0; i < 5; ++i) {
+    tabs.push_back(Aged(base::Days(30)));
+  }
+  tabs[0].is_active = true;
+  const ArchivePlan plan = PlanAutoArchive(tabs, now_, kArchive12Hours);
+  EXPECT_THAT(plan.to_close,
+              ElementsAre(tabs[1].handle, tabs[2].handle, tabs[3].handle,
+                          tabs[4].handle));
+}
+
+// The theorem: a non-empty strip has exactly one active tab, and either
+// rule kActive or rule kSidebarEntry spares it. Both branches below.
+TEST_F(WorkspaceArchivePolicyTest, PlanNeverEmptiesWindow) {
+  std::vector<ArchiveTabState> tabs;
+  for (int i = 0; i < 8; ++i) {
+    tabs.push_back(Aged(base::Days(30)));
+  }
+  tabs[3].is_active = true;
+  const ArchivePlan plan = PlanAutoArchive(tabs, now_, kArchive12Hours);
+  EXPECT_EQ(7u, plan.to_close.size());
+  EXPECT_FALSE(plan.empties_window);
+}
+
+TEST_F(WorkspaceArchivePolicyTest, PlanNeverEmptiesWindowWhenActiveIsEntryTab) {
+  std::vector<ArchiveTabState> tabs;
+  for (int i = 0; i < 8; ++i) {
+    tabs.push_back(Aged(base::Days(30)));
+  }
+  tabs[0].is_active = true;
+  tabs[0].is_workspace_entry = true;
+  const ArchivePlan plan = PlanAutoArchive(tabs, now_, kArchive12Hours);
+  EXPECT_EQ(7u, plan.to_close.size());
+  EXPECT_FALSE(plan.empties_window);
+}
+
+TEST_F(WorkspaceArchivePolicyTest, SingleTabWindowIsNeverTouched) {
+  std::vector<ArchiveTabState> tabs = {Aged(base::Days(30))};
+  tabs[0].is_active = true;
+  const ArchivePlan plan = PlanAutoArchive(tabs, now_, kArchive12Hours);
+  EXPECT_TRUE(plan.to_close.empty());
+  EXPECT_FALSE(plan.empties_window);
+}
+
+TEST_F(WorkspaceArchivePolicyTest, EmptyWindowYieldsEmptyPlan) {
+  const ArchivePlan plan = PlanAutoArchive({}, now_, kArchive12Hours);
+  EXPECT_TRUE(plan.to_close.empty());
+  EXPECT_FALSE(plan.empties_window);
+}
+
+TEST_F(WorkspaceArchivePolicyTest, DisabledThresholdYieldsEmptyPlan) {
+  std::vector<ArchiveTabState> tabs;
+  for (int i = 0; i < 5; ++i) {
+    tabs.push_back(Aged(base::Days(30)));
+  }
+  const ArchivePlan plan = PlanAutoArchive(tabs, now_, kArchiveNeverMinutes);
+  EXPECT_TRUE(plan.to_close.empty());
+  EXPECT_FALSE(plan.empties_window);
+}
+
+// No hidden state: the sweep runs this every five minutes.
+TEST_F(WorkspaceArchivePolicyTest, PlanIsPure) {
+  std::vector<ArchiveTabState> tabs;
+  for (int i = 0; i < 4; ++i) {
+    tabs.push_back(Aged(base::Days(30)));
+  }
+  tabs[0].is_active = true;
+  const ArchivePlan first = PlanAutoArchive(tabs, now_, kArchive12Hours);
+  const ArchivePlan second = PlanAutoArchive(tabs, now_, kArchive12Hours);
+  EXPECT_EQ(first.to_close, second.to_close);
+  EXPECT_EQ(first.empties_window, second.empties_window);
+}
+
+// One of each, so a rule that stops working shows up as a count change.
+TEST_F(WorkspaceArchivePolicyTest, MixedWindowPicksOnlyEligible) {
+  std::vector<ArchiveTabState> tabs;
+  for (int i = 0; i < 8; ++i) {
+    tabs.push_back(Aged(base::Days(30)));
+  }
+  tabs[0].is_active = true;
+  tabs[1].is_audible = true;
+  tabs[2].could_prompt = true;
+  tabs[3].is_workspace_entry = true;
+  tabs[4].last_active = now_ - base::Minutes(5);  // too recent
+  tabs[5].is_blank_new_tab = true;
+  // tabs[6..7] are eligible.
+  const ArchivePlan plan = PlanAutoArchive(tabs, now_, kArchive12Hours);
+  EXPECT_THAT(plan.to_close, ElementsAre(tabs[6].handle, tabs[7].handle));
+  EXPECT_FALSE(plan.empties_window);
+}
+
+// ---- PlanCloseUnpinned ----------------------------------------------------
+
+// The command means what it says. The active-tab rule belongs to the sweep.
+TEST_F(WorkspaceArchivePolicyTest, CloseUnpinnedClosesTheActiveTab) {
+  std::vector<ArchiveTabState> tabs = {Aged(base::Minutes(1))};
+  tabs[0].is_active = true;
+  const ArchivePlan plan = PlanCloseUnpinned(tabs);
+  EXPECT_THAT(plan.to_close, ElementsAre(tabs[0].handle));
+}
+
+TEST_F(WorkspaceArchivePolicyTest, CloseUnpinnedIgnoresAge) {
+  std::vector<ArchiveTabState> tabs = {Aged(base::Seconds(1))};
+  const ArchivePlan plan = PlanCloseUnpinned(tabs);
+  EXPECT_THAT(plan.to_close, ElementsAre(tabs[0].handle));
+}
+
+TEST_F(WorkspaceArchivePolicyTest, CloseUnpinnedSparesSidebarEntries) {
+  std::vector<ArchiveTabState> tabs = {Aged(base::Minutes(1)),
+                                       Aged(base::Minutes(1))};
+  tabs[0].is_workspace_entry = true;
+  const ArchivePlan plan = PlanCloseUnpinned(tabs);
+  EXPECT_THAT(plan.to_close, ElementsAre(tabs[1].handle));
+  EXPECT_FALSE(plan.empties_window);
+}
+
+// What the explicit command still spares: sound, media, and the other half
+// of a split (closing that one collapses the split under the user).
+TEST_F(WorkspaceArchivePolicyTest, CloseUnpinnedSparesAudibleMediaAndSplit) {
+  std::vector<ArchiveTabState> tabs;
+  for (int i = 0; i < 3; ++i) {
+    tabs.push_back(Aged(base::Minutes(1)));
+  }
+  tabs[0].is_audible = true;
+  tabs[1].is_split = true;
+  tabs[2].is_media_active = true;
+  const ArchivePlan plan = PlanCloseUnpinned(tabs);
+  EXPECT_TRUE(plan.to_close.empty());
+  EXPECT_FALSE(plan.empties_window);
+}
+
+// The one case where the window would go empty. A replacement blank tab is
+// opened first; the flag is how that rule stays assertable here.
+TEST_F(WorkspaceArchivePolicyTest, CloseUnpinnedOfWholeWindowSetsEmptiesWindow) {
+  std::vector<ArchiveTabState> tabs;
+  for (int i = 0; i < 3; ++i) {
+    tabs.push_back(Aged(base::Minutes(1)));
+  }
+  tabs[0].is_active = true;
+  const ArchivePlan plan = PlanCloseUnpinned(tabs);
+  EXPECT_EQ(3u, plan.to_close.size());
+  EXPECT_TRUE(plan.empties_window);
+}
+
+TEST_F(WorkspaceArchivePolicyTest, CloseUnpinnedWithSidebarEntriesDoesNotEmptyWindow) {
+  std::vector<ArchiveTabState> tabs;
+  for (int i = 0; i < 3; ++i) {
+    tabs.push_back(Aged(base::Minutes(1)));
+  }
+  tabs[2].is_workspace_entry = true;
+  const ArchivePlan plan = PlanCloseUnpinned(tabs);
+  EXPECT_EQ(2u, plan.to_close.size());
+  EXPECT_FALSE(plan.empties_window);
+}
+
+// Running it on a window that holds only sidebar entries must do nothing at
+// all -- no flash, no stray new tab.
+TEST_F(WorkspaceArchivePolicyTest, CloseUnpinnedWithNothingToCloseIsNoOp) {
+  std::vector<ArchiveTabState> tabs;
+  for (int i = 0; i < 2; ++i) {
+    tabs.push_back(Aged(base::Minutes(1)));
+    tabs.back().is_workspace_entry = true;
+  }
+  const ArchivePlan plan = PlanCloseUnpinned(tabs);
+  EXPECT_TRUE(plan.to_close.empty());
+  EXPECT_FALSE(plan.empties_window);
+}
+
+}  // namespace
+}  // namespace helium_workspace
