+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_archive_service_factory.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/tab_restore_service_factory.h"
+#include "chrome/browser/ui/browser_manager_service_factory.h"
+#include "chrome/browser/ui/helium_workspace/workspace_archive_service.h"
+#include "chrome/browser/ui/helium_workspace/workspace_service_factory.h"
+
+namespace helium_workspace {
+
+// static
+WorkspaceArchiveService* WorkspaceArchiveServiceFactory::GetForProfile(
+    Profile* profile) {
+  return static_cast<WorkspaceArchiveService*>(
+      GetInstance()->GetServiceForBrowserContext(profile, true));
+}
+
+// static
+WorkspaceArchiveServiceFactory* WorkspaceArchiveServiceFactory::GetInstance() {
+  static base::NoDestructor<WorkspaceArchiveServiceFactory> instance;
+  return instance.get();
+}
+
+WorkspaceArchiveServiceFactory::WorkspaceArchiveServiceFactory()
+    : ProfileKeyedServiceFactory(
+          "HeliumWorkspaceArchiveService",
+          // The same selection WorkspaceServiceFactory uses, and here it is
+          // load-bearing rather than merely consistent: TabRestoreService is
+          // kOriginalOnly too and DCHECKs off-the-record profiles, so an
+          // incognito tab closed by a sweep would reach neither Cmd+Shift+T
+          // nor history. Closing a tab nobody can get back is the one thing
+          // this feature must never do.
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kOriginalOnly)
+              .WithGuest(ProfileSelection::kNone)
+              .WithSystem(ProfileSelection::kNone)
+              .WithAshInternals(ProfileSelection::kNone)
+              .Build()) {
+  // IsWorkspaceTab() decides what counts as a Today tab.
+  DependsOn(WorkspaceServiceFactory::GetInstance());
+  // Owns the ProfileBrowserCollection the sweep walks.
+  DependsOn(BrowserManagerServiceFactory::GetInstance());
+  // Must outlive us, or a swept tab never reaches Cmd+Shift+T.
+  DependsOn(TabRestoreServiceFactory::GetInstance());
+}
+
+WorkspaceArchiveServiceFactory::~WorkspaceArchiveServiceFactory() = default;
+
+std::unique_ptr<KeyedService>
+WorkspaceArchiveServiceFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  return std::make_unique<WorkspaceArchiveService>(
+      Profile::FromBrowserContext(context));
+}
+
+bool WorkspaceArchiveServiceFactory::ServiceIsCreatedWithBrowserContext()
+    const {
+  // Nothing in the UI ever asks for this service, so without this it would
+  // simply never exist and the sweep would never run.
+  return true;
+}
+
+}  // namespace helium_workspace
