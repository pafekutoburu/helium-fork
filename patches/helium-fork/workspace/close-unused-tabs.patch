--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/workspace_archive_policy.cc
@@ -0,0 +1,163 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_archive_policy.h"
+
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/helium_workspace/workspace_blank_tab.h"
+#include "chrome/browser/ui/helium_workspace/workspace_service.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/visibility.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace helium_workspace {
+namespace {
+
+// Whether any frame of the primary page would put up a "Leave site?"
+// dialog: a beforeunload handler *and* sticky user activation. Both halves
+// matter -- a page that merely registered the handler and was never typed
+// into has nothing to lose.
+//
+// Lifted from restartability_monitor.cc's helper of the same shape (that
+// one is in an anonymous namespace, so this is a copy, not a call).
+// ForEachRenderFrameHostWithAction because the handler can be in an iframe.
+bool CouldTabDisplayBeforeUnloadDialog(content::WebContents* contents) {
+  if (!contents) {
+    return false;
+  }
+  bool could_display = false;
+  contents->GetPrimaryMainFrame()->ForEachRenderFrameHostWithAction(
+      [&could_display](content::RenderFrameHost* rfh) {
+        if (rfh->CouldDisplayBeforeUnloadDialog()) {
+          could_display = true;
+          return content::RenderFrameHost::FrameIterationAction::kStop;
+        }
+        return content::RenderFrameHost::FrameIterationAction::kContinue;
+      });
+  return could_display;
+}
+
+}  // namespace
+
+ArchiveTabState SampleTab(tabs::TabInterface* tab,
+                          const tabs::TabInterface* active,
+                          const WorkspaceService& service) {
+  ArchiveTabState state;
+  if (!tab) {
+    return state;
+  }
+  state.handle = tab->GetHandle();
+  state.is_active = (tab == active);
+  state.is_split = tab->IsSplit();
+  state.is_workspace_entry = service.IsWorkspaceTab(tab->GetHandle());
+
+  content::WebContents* contents = tab->GetContents();
+  if (!contents) {
+    // Nothing committed, nothing playing, nothing to lose. It still has to
+    // appear in the window's list -- the "never empties the window" proof
+    // counts every tab, not every tab with contents.
+    return state;
+  }
+  state.last_active = contents->GetLastActiveTime();
+  state.is_visible = contents->GetVisibility() == content::Visibility::VISIBLE;
+  // A muted tab is not bothering anyone.
+  state.is_audible = contents->IsCurrentlyAudible() && !contents->IsAudioMuted();
+  state.is_media_active = contents->HasPictureInPictureVideo() ||
+                          contents->HasPictureInPictureDocument() ||
+                          contents->IsBeingVisiblyCaptured();
+  state.could_prompt = CouldTabDisplayBeforeUnloadDialog(contents);
+  // Same predicate TabStripModel::CloseWebContentsAt uses to decide whether
+  // handing back an empty tab is worth it.
+  state.is_blank_new_tab = IsBlankNewTabState(
+      contents->GetVisibleURL(), contents->GetController().GetEntryCount());
+  return state;
+}
+
+std::vector<ArchiveTabState> SampleWindow(BrowserWindowInterface* browser,
+                                          const WorkspaceService& service) {
+  std::vector<ArchiveTabState> tabs;
+  if (!browser) {
+    return tabs;
+  }
+  TabStripModel* model = browser->GetTabStripModel();
+  if (!model) {
+    return tabs;
+  }
+  const tabs::TabInterface* active = model->GetActiveTab();
+  tabs.reserve(static_cast<size_t>(model->count()));
+  for (int i = 0; i < model->count(); ++i) {
+    tabs.push_back(SampleTab(model->GetTabAtIndex(i), active, service));
+  }
+  return tabs;
+}
+
+void ExecuteArchivePlan(BrowserWindowInterface* browser,
+                        const ArchivePlan& plan) {
+  if (!browser || browser->IsDeleteScheduled()) {
+    return;
+  }
+  TabStripModel* model = browser->GetTabStripModel();
+  if (!model) {
+    return;
+  }
+  // ⛔ "Never leave the window empty" has to happen here, not be left to
+  // TabStripModel::CloseWebContentsAt. That guard deliberately lets a
+  // *second* close of an already-blank tab take the window down -- right for
+  // Cmd+W, wrong for this. Clearing a window whose leftover blank new tab
+  // was itself in the plan quit the browser outright (2026-08-25).
+  //
+  // Opening the replacement up front, rather than guarding the loop, keeps
+  // the promised outcome: the user lands on a fresh new tab page instead of
+  // being stranded on their oldest tab.
+  if (plan.empties_window) {
+    chrome::AddTabAt(browser, GURL(), /*index=*/-1, /*foreground=*/true);
+  }
+
+  // ⛔ Nothing here counts how many tabs actually closed, and callers must
+  // not try: CloseWebContentsAt() returning is not the same as the tab
+  // being gone. A tab whose page has an unload/pagehide/visibilitychange
+  // handler anywhere in its frame tree takes the asynchronous path
+  // (TabStripModel::CloseWebContentses -> RunUnloadListenerBeforeClosing),
+  // stays in the strip, and comes back to be closed tens of milliseconds
+  // later. YouTube's ad and analytics iframes make that the common case,
+  // not the exception.
+  //
+  // The first cut counted anyway, and the over-count went straight into
+  // Undo, which then reached one entry too far back and resurrected tabs
+  // from an *earlier* clear -- the same failure the blank-new-tab rule was
+  // added to prevent, arriving by a second route. Undo now works off a
+  // TabRestoreService watermark instead and needs no count at all.
+  //
+  // ⛔ Iterate the handles the read pass named -- never "while any Today tab
+  // is left". Both this function and CloseWebContentsAt can add a blank new
+  // tab, and that tab is itself a Today tab, so such a loop never ends.
+  //
+  // Back to front so the common case does not walk the model repeatedly;
+  // the index is re-resolved anyway, because closing can run an unload
+  // handler and shift everything after it.
+  for (auto it = plan.to_close.rbegin(); it != plan.to_close.rend(); ++it) {
+    tabs::TabInterface* tab = it->Get();
+    if (!tab) {
+      continue;
+    }
+    const int index = model->GetIndexOfTab(tab);
+    if (index < 0) {
+      continue;
+    }
+    // CLOSE_CREATE_HISTORICAL_TAB is the whole recovery story: it is what
+    // puts the tab in Cmd+Shift+T and chrome://history. Dropping it would
+    // make an unattended close unrecoverable.
+    model->CloseWebContentsAt(
+        index, TabCloseTypes::CLOSE_USER_GESTURE |
+                   TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  }
+}
+
+}  // namespace helium_workspace
Index: src/chrome/browser/ui/helium_workspace/workspace_archive_policy.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/workspace_archive_policy.h
@@ -0,0 +1,313 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_ARCHIVE_POLICY_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_ARCHIVE_POLICY_H_
+
+#include <algorithm>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/time/time.h"
+#include "components/tabs/public/tab_interface.h"
+
+class BrowserWindowInterface;
+
+namespace helium_workspace {
+
+class WorkspaceService;
+
+// helium-fork M4: which of the sidebar's unpinned tabs get closed, and why.
+//
+// "Archive" here means *close the tab* -- Chromium's own Recently Closed
+// (Cmd+Shift+T) and chrome://history are the recovery path, so this fork
+// grows no archive store of its own. That mapping is not a shortcut: Arc's
+// own archive, read on 2026-08-25, is 2463 manual entries against 120
+// automatic ones, and the manual ones land a median 29 seconds after the
+// tab was last active -- in Arc, closing a tab *is* archiving it, and its
+// Archive page is its history.
+//
+// Kept dependency-free (no //content, no //chrome/browser/ui) so
+// helium_workspace_unittests can exercise it directly -- the same reason
+// workspace_pin_semantics.h splits its live-tab wrappers into a .cc that
+// the test target does not build. Everything the renderer knows arrives
+// here as a plain bool; the sampling lives in workspace_archive_service.cc.
+
+// The tiers *are* minute counts, so appearance_behavior_page.ts can write
+// these numbers straight into its menuOptions and there is no C++ enum to
+// keep in sync (contrast kHeliumAddressBarMode, whose .ts carries a "must
+// be kept in sync" comment). 0 means Never.
+//
+// Arc's own set, measured 2026-08-25 from its binary's AutoArchiveType
+// cases: 6h / 12h / 24h / 7d / 30d / Never. The user dropped 6h, added 3d,
+// and set the default to 24h (Arc on this machine is 12h) -- a deliberate
+// divergence, not an approximation.
+inline constexpr int kArchiveNeverMinutes = 0;
+inline constexpr int kArchive12Hours = 12 * 60;
+inline constexpr int kArchive24Hours = 24 * 60;
+inline constexpr int kArchive3Days = 3 * 24 * 60;
+inline constexpr int kArchive7Days = 7 * 24 * 60;
+inline constexpr int kArchive30Days = 30 * 24 * 60;
+inline constexpr int kArchiveDefaultMinutes = kArchive24Hours;
+
+// A year. Nothing sane is above this; the cap exists so a hand-edited pref
+// cannot overflow base::Minutes().
+inline constexpr int kArchiveMaxMinutes = 365 * 24 * 60;
+
+// Negative -> Never. The pref is an integer the user can hand-edit, and
+// every read goes through here.
+inline int ClampArchiveMinutes(int minutes) {
+  if (minutes <= 0) {
+    return kArchiveNeverMinutes;
+  }
+  return std::min(minutes, kArchiveMaxMinutes);
+}
+
+// One tab as the sweep found it. Deliberately plain data: this header is
+// compiled into helium_workspace_unittests, which has neither //content nor
+// //chrome/browser/ui in its deps.
+struct ArchiveTabState {
+  // Identity that survives the sweep's two passes. The plan is executed
+  // after the read pass returns, by which time indices have moved.
+  tabs::TabHandle handle;
+
+  // WebContents::GetLastActiveTime(). Wall clock, and it survives a
+  // restart: the session file stores it (session_types.h) and
+  // session_restore.cc feeds it back into the restored tab. That matters
+  // more than it looks -- with the default at 24h, almost every archive
+  // happens across a restart, because few people leave a browser running
+  // for a day.
+  base::Time last_active;
+
+  // TabStripModel::GetActiveTab(): the tab the user is looking at.
+  bool is_active = false;
+  // GetVisibility() == VISIBLE. Not the same question as |is_active|: the
+  // other half of a split view is on screen without being active.
+  bool is_visible = false;
+  // TabInterface::IsSplit(). Belt to |is_visible|'s braces -- whether a
+  // split's inactive half ever gets WasShown() is not something this fork
+  // has measured, so neither signal is trusted alone.
+  bool is_split = false;
+
+  // WorkspaceService::IsWorkspaceTab(): bound to a sidebar entry, so not one
+  // of the unpinned tabs at all. This is also the user's escape hatch --
+  // Cmd+D makes a tab permanent.
+  bool is_workspace_entry = false;
+
+  // IsCurrentlyAudible() && !IsAudioMuted(). A muted tab is not bothering
+  // anyone and gets no protection.
+  bool is_audible = false;
+  // Picture-in-picture on screen, or the tab is being captured (screen
+  // share, recording). Closing the source mid-meeting is expensive enough
+  // to be worth one bool.
+  bool is_media_active = false;
+
+  // helium_workspace::IsBlankNewTabState(): showing nothing, with nothing
+  // behind it. Never worth closing -- and closing one is actively harmful,
+  // because TabStripModel does not file a blank new tab with
+  // TabRestoreService. Counting it made the Clear toast's Undo reach one
+  // entry too far back and resurrect a tab from an *earlier* clear
+  // (observed 2026-08-25).
+  bool is_blank_new_tab = false;
+
+  // Any frame's RenderFrameHost::CouldDisplayBeforeUnloadDialog(), i.e. a
+  // beforeunload handler *and* sticky user activation.
+  //
+  // Deliberately not WebContents::NeedToFireBeforeUnloadOrUnloadEvents():
+  // that one is true for unload/pagehide/*visibilitychange* handlers too,
+  // and half the web registers visibilitychange for analytics, which would
+  // spare nearly every tab and quietly turn this feature off.
+  bool could_prompt = false;
+};
+
+// Why a tab was spared. Exists so the probe and the unit tests can assert
+// the *reason*, not just the outcome. The order is the precedence order:
+// a tab that is both an entry and audible always reports kSidebarEntry,
+// which is what makes the probe's per-reason counts deterministic.
+enum class ArchiveSkipReason {
+  kNone = 0,       // not spared -- close it
+  kDisabled,       // the tier is Never
+  kSidebarEntry,   // bound to a sidebar entry, so not an unpinned tab
+  kBlankNewTab,   // an empty new tab page; nothing to archive
+  kActive,        // the tab the user is on
+  kVisible,       // on screen without being active (split view)
+  kSplit,         // part of a split view
+  kAudible,       // playing sound
+  kMediaActive,   // picture-in-picture, or being captured
+  kBeforeUnload,  // would put up a "Leave site?" dialog
+  kTooRecent,     // has not aged past the tier yet
+};
+
+struct ArchivePlan {
+  // In strip order. The caller closes them back to front, re-resolving each
+  // index, because closing can run unload handlers and shift what is left.
+  std::vector<tabs::TabHandle> to_close;
+
+  // True when |to_close| covers every tab in the window.
+  //
+  // PlanAutoArchive() never sets it -- see the comment on that function.
+  // PlanCloseUnpinned() can: it closes the active tab too. Closing
+  // the last tab is already handled downstream (TabStripModel::
+  // CloseWebContentsAt hands back a blank new tab rather than letting the
+  // window vanish); this flag exists so the rule is stated in one place and
+  // can be asserted without a browser.
+  bool empties_window = false;
+};
+
+// The protections that apply no matter which gesture asked. Shared by the
+// timer sweep and by the explicit "close unpinned tabs" command so the two
+// can never drift apart.
+//
+// |could_prompt| is deliberately NOT checked here -- see
+// ClassifyForAutoArchive. It is the one protection the two gestures
+// disagree about.
+inline ArchiveSkipReason ClassifyProtections(const ArchiveTabState& tab) {
+  if (tab.is_workspace_entry) {
+    return ArchiveSkipReason::kSidebarEntry;
+  }
+  if (tab.is_blank_new_tab) {
+    return ArchiveSkipReason::kBlankNewTab;
+  }
+  if (tab.is_split) {
+    return ArchiveSkipReason::kSplit;
+  }
+  if (tab.is_audible) {
+    return ArchiveSkipReason::kAudible;
+  }
+  if (tab.is_media_active) {
+    return ArchiveSkipReason::kMediaActive;
+  }
+  return ArchiveSkipReason::kNone;
+}
+
+// The timer sweep's question.
+//
+// |threshold_minutes| is the raw pref; it is clamped here, so a caller that
+// forgot cannot arm a negative deadline. The age test is >=, matching Arc:
+// across 120 automatic archives its floor is exactly 12.00h with nothing
+// below it.
+//
+// A |last_active| in the future (clock moved backwards, machine resumed
+// from suspend with a corrected clock) reads as kTooRecent. Erring towards
+// "leave it alone" is the only safe direction for something that closes
+// tabs unattended.
+inline ArchiveSkipReason ClassifyForAutoArchive(const ArchiveTabState& tab,
+                                                base::Time now,
+                                                int threshold_minutes) {
+  const int minutes = ClampArchiveMinutes(threshold_minutes);
+  if (minutes == kArchiveNeverMinutes) {
+    return ArchiveSkipReason::kDisabled;
+  }
+  const ArchiveSkipReason protection = ClassifyProtections(tab);
+  if (protection != ArchiveSkipReason::kNone) {
+    return protection;
+  }
+  // Only the unattended sweep honours this. Nobody is watching, so a page
+  // that would put up a "Leave site?" dialog gets left alone. The explicit
+  // command does the opposite -- see ClassifyForCloseUnpinned.
+  if (tab.could_prompt) {
+    return ArchiveSkipReason::kBeforeUnload;
+  }
+  if (tab.is_active) {
+    return ArchiveSkipReason::kActive;
+  }
+  if (tab.is_visible) {
+    return ArchiveSkipReason::kVisible;
+  }
+  if (tab.last_active > now ||
+      now - tab.last_active < base::Minutes(minutes)) {
+    return ArchiveSkipReason::kTooRecent;
+  }
+  return ArchiveSkipReason::kNone;
+}
+
+// The explicit "close unpinned tabs" command's question: the shared
+// protections, minus the active-tab rule, minus age, and -- the part that
+// matters -- minus |could_prompt|.
+//
+// Honouring |could_prompt| here is what made YouTube unclosable (user
+// 2026-08-26, on the homepage with no video playing). Its cause is
+// structural, not incidental: has_before_unload_handler_ is only cleared on
+// a *cross-document* navigation (render_frame_host_impl.cc), and YouTube is
+// a single-page app, so one registration lasts the tab's whole life. Sticky
+// activation propagates to every same-origin frame, so one click anywhere
+// on the page arms all of them.
+//
+// The user asked for these tabs to go. A page holding unsaved work still
+// gets to object -- Chromium puts up its own confirmation dialog on the way
+// out, which is the right place to change your mind.
+inline ArchiveSkipReason ClassifyForCloseUnpinned(const ArchiveTabState& tab) {
+  return ClassifyProtections(tab);
+}
+
+// |window_tabs| must be *every* tab in the window, active one included, in
+// strip order.
+//
+// That is not a convenience: "never empties the window" is a theorem about
+// this input, not a check performed on the output. A non-empty strip has
+// exactly one active tab; if it is an unpinned tab the kActive rule spares
+// it, and if it is a sidebar entry kSidebarEntry spares it. The two cases
+// are exhaustive, so at least one tab always survives and empties_window
+// stays false. Hand this function a pre-filtered list and that guarantee is
+// gone.
+inline ArchivePlan PlanAutoArchive(base::span<const ArchiveTabState> window_tabs,
+                                   base::Time now,
+                                   int threshold_minutes) {
+  ArchivePlan plan;
+  for (const ArchiveTabState& tab : window_tabs) {
+    if (ClassifyForAutoArchive(tab, now, threshold_minutes) ==
+        ArchiveSkipReason::kNone) {
+      plan.to_close.push_back(tab.handle);
+    }
+  }
+  plan.empties_window =
+      !window_tabs.empty() && plan.to_close.size() == window_tabs.size();
+  return plan;
+}
+
+// Same contract on |window_tabs| as above. Unlike the sweep, this one can
+// come back covering the whole window.
+inline ArchivePlan PlanCloseUnpinned(
+    base::span<const ArchiveTabState> window_tabs) {
+  ArchivePlan plan;
+  for (const ArchiveTabState& tab : window_tabs) {
+    if (ClassifyForCloseUnpinned(tab) == ArchiveSkipReason::kNone) {
+      plan.to_close.push_back(tab.handle);
+    }
+  }
+  plan.empties_window =
+      !window_tabs.empty() && plan.to_close.size() == window_tabs.size();
+  return plan;
+}
+
+// ---- live-object glue -----------------------------------------------------
+//
+// Declared here, defined in workspace_archive_policy.cc, which is *not*
+// built into helium_workspace_unittests -- it needs //content. Same split
+// workspace_pin_semantics.h uses, and for the same reason.
+
+// Reads one tab into the plain-data form above. |active| is the window's
+// active tab, compared by pointer.
+ArchiveTabState SampleTab(tabs::TabInterface* tab,
+                          const tabs::TabInterface* active,
+                          const WorkspaceService& service);
+
+// Every tab in |browser|, in strip order -- the whole window, which is what
+// PlanAutoArchive()'s "never empties the window" guarantee rests on.
+std::vector<ArchiveTabState> SampleWindow(BrowserWindowInterface* browser,
+                                          const WorkspaceService& service);
+
+// Closes what |plan| named, re-resolving every handle against the live
+// model first: this runs after the read pass returned, and closing a tab
+// can run unload handlers that move everything after it.
+//
+// Returns nothing on purpose. "How many closed" is not knowable here --
+// tabs with unload handlers close asynchronously, long after this returns.
+// Ask TabRestoreService instead.
+void ExecuteArchivePlan(BrowserWindowInterface* browser,
+                        const ArchivePlan& plan);
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_ARCHIVE_POLICY_H_
