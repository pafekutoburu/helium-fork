+
+std::vector<gfx::ImageSkia> WorkspaceSidebarView::CaptureEntryAsRow(
+    WorkspaceEntryView* view,
+    const std::vector<gfx::Size>& row_sizes) {
+  std::vector<gfx::ImageSkia> images;
+  const ui::Compositor* const compositor =
+      GetWidget() ? GetWidget()->GetCompositor() : nullptr;
+  if (!view || !compositor || !view->GetVisible()) {
+    return images;
+  }
+  // The entry as this view was last told it (the sync that removes an entry
+  // has not run yet when its row is painted for the flight out).
+  const helium_workspace::WorkspaceEntry* model = nullptr;
+  for (const helium_workspace::WorkspaceEntry& entry : ordered_model_) {
+    if (entry.id == view->entry_id()) {
+      model = &entry;
+      break;
+    }
+  }
+  const bool was_capsule = view->renders_as_capsule();
+  if (was_capsule && !model) {
+    return images;
+  }
+  const gfx::Rect bounds_then = view->bounds();
+  if (was_capsule) {
+    // Same id, URL and icon: only the form changes (SetEntry resolves no
+    // icon for that), and it changes back below.
+    helium_workspace::WorkspaceEntry as_row = *model;
+    as_row.section = helium_workspace::WorkspaceEntry::Section::kPinned;
+    view->SetEntry(as_row);
+  }
+  view->ClearHoverAtOnce();
+  for (const gfx::Size& size : row_sizes) {
+    if (size.IsEmpty()) {
+      continue;
+    }
+    view->SetSize(size);
+    // The close button just went, the width may be new: the title is laid
+    // out before the picture is taken, not at the next layout pass.
+    view->DeprecatedLayoutImmediately();
+    gfx::ImageSkia image = HeliumViewSnapshotLayer::CaptureImage(
+        view, view->GetLocalBounds(), compositor->device_scale_factor());
+    if (!image.isNull()) {
+      images.push_back(std::move(image));
+    }
+  }
+  if (was_capsule) {
+    view->SetEntry(*model);
+  }
+  view->SetBoundsRect(bounds_then);
+  view->DeprecatedLayoutImmediately();
+  return images;
+}
