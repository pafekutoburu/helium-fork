+std::optional<int> TabStripModel::GetTodayRowToCloseBeforeBlank(
+    content::WebContents* blank,
+    const std::string& space_id) const {
+  const helium_workspace::WorkspaceService* const workspace_service =
+      helium_workspace::WorkspaceServiceFactory::GetForProfile(profile_);
+  if (!workspace_service || !IsLastLoadedBlankTab(blank)) {
+    return std::nullopt;
+  }
+  std::vector<helium_workspace::SleepingLadderTab> rows(count());
+  for (int i = 0; i < count(); ++i) {
+    const tabs::TabInterface* const tab = GetTabAtIndex(i);
+    rows[i].blank = GetWebContentsAt(i) == blank;
+    rows[i].today_row =
+        tab && !IsTabCollapsed(i) &&
+        !workspace_service->IsWorkspaceTab(tab->GetHandle()) &&
+        workspace_service->IsTabInSpace(tab->GetHandle(), space_id);
+  }
+  return helium_workspace::TodayRowToCloseBeforeBlank(rows);
+}
