       [[fallthrough]];  // To create new window.
     case IDC_NEW_WINDOW:
-      CreateBrowser(profile->GetOriginalProfile());
+      OpenFirstWindow(profile->GetOriginalProfile());  // helium-fork 3a-r8
       break;
     case IDC_FOCUS_LOCATION:
       chrome::ExecuteCommand(ActivateOrCreateBrowser(profile),
@@ -1768,7 +1829,9 @@
       app_controller_mac::TabRestorer::RestoreMostRecent(profile);
       break;
     case IDC_OPEN_FILE:
-      chrome::ExecuteCommand(CreateBrowser(profile), IDC_OPEN_FILE);
+      chrome::ExecuteCommand(
+          CreateBrowser(profile, /*with_last_session=*/true),  // helium-fork
+          IDC_OPEN_FILE);
       break;
     case IDC_CLEAR_BROWSING_DATA: {
       // There may not be a browser open, so use the default profile.
@@ -1918,7 +1981,7 @@
           if (!profile) {
             return;
           }
-          CreateBrowser(profile);
+          OpenFirstWindow(profile);  // helium-fork 3a-r8
         }),
         app_controller_mac::kShowProfilePickerOnFailure);
   }
