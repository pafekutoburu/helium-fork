@@ -0,0 +1,36 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_close_landing.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium_workspace {
+namespace {
+
+// 3a-r7: Cmd+W on the blank tab that is the last loaded page goes on down
+// Today's other rows, top first, and leaves the window alone until there are
+// none.
+constexpr SleepingLadderTab kBlank{.blank = true, .today_row = true};
+constexpr SleepingLadderTab kAsleep{.blank = false, .today_row = true};
+constexpr SleepingLadderTab kNotToday{.blank = false, .today_row = false};
+
+TEST(WorkspaceCloseLandingTest, TheBlankTabGivesWayToTodaysTopRow) {
+  EXPECT_EQ(TodayRowToCloseBeforeBlank({kBlank, kAsleep, kAsleep}), 1);
+  // New tabs at the bottom: the blank tab is the last row, the top one goes.
+  EXPECT_EQ(TodayRowToCloseBeforeBlank({kAsleep, kAsleep, kBlank}), 0);
+  // An entry's tab and another space's are not Today's rows.
+  EXPECT_EQ(TodayRowToCloseBeforeBlank({kNotToday, kBlank, kNotToday, kAsleep}),
+            3);
+}
+
+TEST(WorkspaceCloseLandingTest, TheBlankTabAloneLetsTheWindowGo) {
+  EXPECT_EQ(TodayRowToCloseBeforeBlank({kBlank}), std::nullopt);
+  EXPECT_EQ(TodayRowToCloseBeforeBlank({kNotToday, kBlank, kNotToday}),
+            std::nullopt);
+  EXPECT_EQ(TodayRowToCloseBeforeBlank({}), std::nullopt);
+}
+
+}  // namespace
+}  // namespace helium_workspace
