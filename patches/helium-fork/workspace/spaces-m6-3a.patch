+}
+
+void WorkspaceSidebarView::OnEntryReplaceUrlRequested(
+    const std::string& entry_id) {
+  const std::string id = entry_id;
+  BrowserWindowInterface* const browser = GetBrowserWindow();
+  if (!service_ || !browser) {
+    return;
+  }
+  tabs::TabInterface* const tab =
+      service_->FindTabForEntryInWindow(id, browser).Get();
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  const helium_workspace::WorkspaceEntry* const entry =
+      service_->FindEntryById(id);
+  if (!contents || !entry) {
+    return;
+  }
+  // The committed page, not a pending one; about:blank is where a tab sits
+  // before its first commit, never somewhere to come home to.
+  const GURL current = contents->GetLastCommittedURL();
+  const std::optional<GURL> url =
+      helium_workspace::NormalizeDroppedUrl(current);
+  if (!url || url->IsAboutBlank() || *url == entry->url) {
+    return;
+  }
+  const bool same_site = helium_workspace::IsOnPinnedSite(*url, entry->url);
+  const std::u16string title = contents->GetTitle();
+  service_->SetEntryUrl(id, *url);
+  // The tab is at home again from here on, so the usual write-back keeps
+  // the title and icon current; seed them so the row is right at once.
+  service_->SetEntryTitle(id, title);
+  if (!same_site) {
+    service_->SetEntryFavicon(id, std::string());
+  }
+}
+
+void WorkspaceSidebarView::OnEntryEditUrlRequested(
+    const std::string& entry_id) {
+  BrowserWindowInterface* const browser = GetBrowserWindow();
+  const helium_workspace::WorkspaceEntry* const entry =
+      service_ ? service_->FindEntryById(entry_id) : nullptr;
+  if (!browser || !entry || !GetWidget()) {
+    return;
+  }
+  // Arc's dialog (轮0 g13d f_01103): the title, one line of explanation, the
+  // URL selected whole, Cancel on ESC and Save as the ⏎ default.
+  auto delegate = std::make_unique<EditPinnedUrlDialogDelegate>(
+      browser->GetProfile(), entry->id);
+  EditPinnedUrlDialogDelegate* const delegate_ptr = delegate.get();
+  ui::DialogModel::Builder builder(std::move(delegate));
+  builder
+      .SetTitle(l10n_util::GetStringUTF16(IDS_HELIUM_WS_EDIT_PINNED_URL_TITLE))
+      .AddParagraph(ui::DialogModelLabel(
+          l10n_util::GetStringUTF16(IDS_HELIUM_WS_EDIT_PINNED_URL_BODY)))
+      .AddTextfield(
+          kEditPinnedUrlFieldId, std::u16string(),
+          base::UTF8ToUTF16(entry->url.spec()),
+          ui::DialogModelTextfield::Params().SetAccessibleName(
+              l10n_util::GetStringUTF16(IDS_HELIUM_WS_EDIT_PINNED_URL_TITLE)))
+      .SetInitiallyFocusedField(kEditPinnedUrlFieldId)
+      // Unretained: the model owns the delegate.
+      .AddOkButton(base::BindRepeating(&EditPinnedUrlDialogDelegate::OnSave,
+                                       base::Unretained(delegate_ptr)),
+                   ui::DialogModel::Button::Params()
+                       .SetLabel(l10n_util::GetStringUTF16(
+                           IDS_HELIUM_WS_EDIT_PINNED_URL_SAVE))
+                       .SetStyle(ui::ButtonStyle::kProminent))
+      .AddCancelButton(base::DoNothing());
+  constrained_window::ShowBrowserModal(builder.Build(),
+                                       GetWidget()->GetNativeWindow());
+}
