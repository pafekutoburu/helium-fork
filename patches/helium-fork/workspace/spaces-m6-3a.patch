+void WorkspaceTabController::MoveEntryToSpace(const std::string& entry_id,
+                                              const std::string& space_id) {
+  // Copies: the callers' strings live in rows that the move rebuilds.
+  const std::string id = entry_id;
+  const std::string target = space_id;
+  const WorkspaceEntry* const entry =
+      service_ ? service_->FindEntryById(id) : nullptr;
+  if (!entry || entry->section != WorkspaceEntry::Section::kPinned ||
+      entry->space_id == target || !service_->FindSpaceById(target)) {
+    return;
+  }
+  // Collected before the model moves: afterwards the rows answer from the
+  // target space either way, but a failed move must touch no tab.
+  const std::vector<tabs::TabHandle> moved = TabsOfEntryTree(id);
+  if (!service_->MoveEntryToSpace(id, target)) {
+    return;
+  }
+  FollowMovedTabs(moved, target, tabs::TabHandle::Null());
+}
+
+void WorkspaceTabController::MoveTabToSpace(tabs::TabHandle handle,
+                                            const std::string& space_id) {
+  const std::string target = space_id;
+  tabs::TabInterface* const tab = handle.Get();
+  if (!service_ || !tab ||
+      tab->GetBrowserWindowInterface() != browser_window_ ||
+      !service_->FindSpaceById(target) ||
+      service_->GetSpaceForTab(handle) == target) {
+    return;
+  }
+  // A bound tab's space is its entry's: moving it means moving the row, and
+  // the row's own menu does that.
+  if (service_->FindEntryById(service_->FindEntryIdForTab(handle))) {
+    return;
+  }
+  // 3a-r7 (user 2026-09-19 #3, "新标签出现的逻辑要彻底地捋一遍"): a tab that
+  // arrives in a space's Today arrives where new tabs do there
+  // (prefs::kNewTabPosition) -- it kept its strip index, which among the
+  // other space's rows is no place in particular.
+  MoveTabToNewTabPlace(tab);
+  FollowMovedTabs({handle}, target, handle);
+}
+
+void WorkspaceTabController::TurnFolderIntoSpace(
+    const std::string& folder_id) {
+  const std::string id = folder_id;
+  const WorkspaceEntry* const folder =
+      service_ ? service_->FindEntryById(id) : nullptr;
+  if (!folder || !folder->is_folder()) {
+    return;
+  }
+  const std::vector<tabs::TabHandle> moved = TabsOfEntryTree(id);
+  const std::string space =
+      service_->TurnFolderIntoSpace(id, /*insert_after_id=*/current_space_id_);
+  if (space.empty()) {
+    return;
+  }
+  FollowMovedTabs(moved, space, tabs::TabHandle::Null());
+}
