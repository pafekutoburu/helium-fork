+WorkspaceSidebarView::EntryShiftFrom WorkspaceSidebarView::SnapshotEntryShift()
+    const {
+  EntryShiftFrom from;
+  from.height = laid_height_;
+  from.grid_segment = grid_segment_;
+  for (size_t i = 0; i < ordered_entries_.size(); ++i) {
+    const views::View* const view = ordered_entries_[i].get();
+    if (view->GetVisible()) {
+      EntryShiftFrom::Row row{view->bounds(), i < favorite_count_};
+      // 3a-r4: what a flight out of this row would need (RowFlight).
+      row.screen = view->GetBoundsInScreen();
+      if (const WorkspaceEntryView* const site = SiteRowAt(i)) {
+        if (const tabs::TabInterface* const tab = site->bound_tab()) {
+          row.tab = tab->GetHandle();
+        }
+        row.active = site->active();
+      }
+      from.rows[ordered_model_[i].id] = std::move(row);
+    }
+  }
+  return from;
+}
+
+void WorkspaceSidebarView::StartEntryShift(EntryShiftFrom from) {
+  // Not under a drag (the drop has its own settle, and the preview owns the
+  // layout), not across a fold (its toggle lands here too, through
+  // SetFolderCollapsed's notify, with the fold's snapshot already taken), and
+  // not before this view has ever been laid out.
+  if (!GetWidget() || width() <= 0 || drag_ || folder_prev_layout_valid_ ||
+      folder_animation_.is_animating() || from.height <= 0) {
+    FinishEntryShift();
+    return;
+  }
+  // 3a-r4: a flight still in the air belongs to the shift being replaced.
+  EndRowFlight();
+  entry_shift_from_ = std::move(from);
+  entry_shift_valid_ = true;
+  entry_shift_rides_today_ = false;
+  entry_shift_animation_.Reset(0.0);
+  // Posted, like the start of Today's run and for its reason
+  // (TabCollectionAnimatingLayoutManager::StartRun): the clock of a
+  // gfx::Animation runs from Show(), and the command that got us here may
+  // still have a tab to build in this task.
+  if (!entry_shift_start_pending_) {
+    entry_shift_start_pending_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&WorkspaceSidebarView::StartPendingEntryShift,
+                       weak_factory_.GetWeakPtr()));
+  }
+  // Again, although SyncEntryViews() just did: what it announced was the
+  // settled size, and the containers above cache what they are told.
+  PreferredSizeChanged();
+  InvalidateLayout();
+}
