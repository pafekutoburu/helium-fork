+  }
+}
+
+void UnpinnedTabContainerView::RemoveChildFromNode(views::View* child_view) {
+  // "Was the active one" = wore the card on the last paint; the row itself
+  // has usually been told otherwise by now (see painted_active_row_). Only a
+  // row Today actually shows: the tab of a sidebar entry is a child here too,
+  // parked (invisible, no bounds) -- closing that one moves nothing, so no
+  // run would ever come to clear the flag, and it would place the active row
+  // of some later, unrelated run.
+  const TabView* const tab_view = views::AsViewClass<TabView>(child_view);
+  if (tab_view &&
+      (tab_view->IsActive() || child_view == painted_active_row_.view()) &&
+      child_view->GetVisible() && !child_view->bounds().IsEmpty()) {
+    closed_active_row_in_run_ = true;
+  }
+  layout_manager_->AnimateAndDestroyChildView(child_view);
+}
