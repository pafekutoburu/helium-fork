+  // now: the shortcut is the user's to rebind, and with the pref off the
+  // default chord means Inspect instead (browser_command_controller.cc).
+  BrowserWindowInterface* const browser = GetBrowserWindow();
+  Profile* const profile = browser ? browser->GetProfile() : nullptr;
+  if (browser_shortcuts::BrowserShortcutService* const shortcuts =
+          profile ? browser_shortcuts::BrowserShortcutServiceFactory::
+                        GetForProfile(profile)
+                  : nullptr) {
+    const int command =
+        profile->GetPrefs()->GetBoolean(::prefs::kCopyPageUrlShortcut)
+            ? IDC_COPY_OR_INSPECT_SHORTCUT
+            : IDC_COPY_URL;
+    for (const auto& [accelerator, command_id] :
