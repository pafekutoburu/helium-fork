+int WorkspaceSidebarView::TopLevelRowWidth() const {
+  return std::max(
+      std::max(0, width() - GetLayoutConstant(
+                                LayoutConstant::
+                                    kVerticalTabStripHorizontalPadding)),
+      GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth));
