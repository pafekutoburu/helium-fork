+void WorkspaceTabController::FollowMovedTabs(
+    const std::vector<tabs::TabHandle>& moved,
+    const std::string& space_id,
+    tabs::TabHandle activate) {
+  const auto went_along = [&moved](tabs::TabHandle handle) {
+    return std::ranges::find(moved, handle) != moved.end();
+  };
+  // 1. The raw tag and the session's copy. A sleeping tab is only re-tagged:
+  //    nothing here loads it. Posted for TagInsertedTab's reason.
+  for (tabs::TabHandle handle : moved) {
+    if (!handle.Get()) {
+      continue;
+    }
+    service_->SetTabSpace(handle, space_id);
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&WorkspaceTabController::PersistTabSpace,
+                                  weak_factory_.GetWeakPtr(), handle, space_id));
   }
+  // 2. Every window of the profile: no space may keep remembering a tab that
+  //    left it, and a window whose active tab went along follows it -- state
+  //    only, the follow rule's own way (HandleActiveTabChange).
+  for (BrowserWindowInterface* browser : GetAllBrowserWindowInterfaces()) {
+    if (browser->GetProfile() != browser_window_->GetProfile()) {
+      continue;
+    }
+    WorkspaceTabController* const controller = From(browser);
+    if (!controller) {
+      continue;
+    }
+    std::erase_if(controller->last_active_by_space_, [&](const auto& pair) {
+      return pair.first != space_id && went_along(pair.second);
+    });
+    TabStripModel* const model = browser->GetTabStripModel();
+    tabs::TabInterface* const active = model ? model->GetActiveTab() : nullptr;
+    if (active && went_along(active->GetHandle())) {
+      controller->last_active_by_space_[space_id] = active->GetHandle();
+      if (controller != this) {
+        controller->SetCurrentSpace(space_id);
+      }
+    }
+  }
+  // 3. This window goes to the target space (Arc g9). ActivateSpaceTab finds
+  //    the tab step 2 -- or |activate| -- left in its memory.
+  //    3a-r8: not a sleeping |activate|. Moving a row is not opening it, and
+  //    step 1 of ActivateSpaceTab activates -- loads -- whatever this memory
+  //    names (the audit for user 2026-09-20 #6: "Move to" on a restored row
+  //    woke it). The row goes over asleep; the window lands there as on any
+  //    other visit.
+  TabStripModel* const model = browser_window_->GetTabStripModel();
+  tabs::TabInterface* const active = model ? model->GetActiveTab() : nullptr;
+  if (activate.Get() && !(active && went_along(active->GetHandle())) &&
+      !helium_workspace::IsSleepingTab(activate.Get()->GetContents())) {
+    last_active_by_space_[space_id] = activate;
+  }
+  SwitchToSpaceInternal(space_id, kDirectionFromOrder);
 }
 
