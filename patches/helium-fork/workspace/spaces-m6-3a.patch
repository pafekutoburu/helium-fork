+std::string WorkspaceService::DuplicateEntry(const std::string& id) {
+  const auto source = std::ranges::find_if(
+      entries_, [&](const WorkspaceEntry& e) { return e.id == id; });
+  if (source == entries_.end() || source->is_folder()) {
+    return std::string();
+  }
+  if (source->section == WorkspaceEntry::Section::kFavorite &&
+      CountFavorites() >= kMaxFavorites) {
+    return std::string();
+  }
+  // Bindings are keyed by entry id, so a fresh id is all it takes for the
+  // copy to start without a tab.
+  WorkspaceEntry copy = *source;
+  copy.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  const std::string copy_id = copy.id;
+  // entries_ is kept in display order and SortEntries() is stable: a copy
+  // that shares its source's position and sits right behind it in the vector
+  // stays right behind it, and the renumber opens the slot.
+  entries_.insert(std::next(source), std::move(copy));
+  SortEntries();
+  RenumberScopes();
+  PersistToPrefs();
+  NotifyChanged();
+  return copy_id;
+}
+
+bool WorkspaceService::MoveEntryToSpace(const std::string& id,
+                                        const std::string& space_id) {
+  const auto source = std::ranges::find_if(
+      entries_, [&](const WorkspaceEntry& e) { return e.id == id; });
+  if (source == entries_.end() ||
+      source->section != WorkspaceEntry::Section::kPinned ||
+      !FindSpaceById(space_id)) {
+    return false;
+  }
+  if (source->space_id == space_id) {
+    return true;
+  }
+  // Read before |source| joins the target scope, so it does not count
+  // itself.
+  source->position =
+      NextTopLevelPosition(WorkspaceEntry::Section::kPinned, space_id);
+  source->folder_id.clear();
+  source->space_id = space_id;
+  if (source->is_folder()) {
+    // A child's space is its folder's; its position is within the folder
+    // and stays.
+    for (WorkspaceEntry& entry : entries_) {
+      if (entry.folder_id == id) {
+        entry.space_id = space_id;
+      }
+    }
+  }
+  SortEntries();
+  RenumberScopes();  // closes the hole left behind
+  PersistToPrefs();
+  NotifyChanged();
+  return true;
+}
