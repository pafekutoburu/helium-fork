+
+#include "chrome/browser/ui/helium/arc_entry_menu.h"
+
+#include <string>
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+using Id = EntryMenuItemId;
+using Label = EntryMenuLabel;
+
+const EntryMenuItem* Find(const std::vector<EntryMenuItem>& items, Id id) {
+  for (const EntryMenuItem& item : items) {
+    if (item.id == id) {
+      return &item;
+    }
+  }
+  return nullptr;
+}
+
+std::vector<Id> Ids(const std::vector<EntryMenuItem>& items) {
+  std::vector<Id> ids;
+  for (const EntryMenuItem& item : items) {
+    ids.push_back(item.id);
+  }
+  return ids;
+}
+
+// The ids that open a group.
+std::vector<Id> GroupHeads(const std::vector<EntryMenuItem>& items) {
+  std::vector<Id> heads;
+  for (const EntryMenuItem& item : items) {
+    if (item.separator_before) {
+      heads.push_back(item.id);
+    }
+  }
+  return heads;
+}
+
+EntryMenuState Row() {
+  EntryMenuState s;
+  s.space_ids = {"a", "b", "c"};
+  s.owner_space_id = "b";
+  s.copy_shortcut_live = true;
+  return s;
+}
+
+TEST(ArcEntryMenuTest, ClosedPinnedRowShape) {
+  const std::vector<EntryMenuItem> menu = BuildEntryMenu(Row());
+  EXPECT_EQ((std::vector<Id>{Id::kCopyLink, Id::kToggleMute,
+                             Id::kBackToPinnedUrl, Id::kEditPinnedPage,
+                             Id::kOpen, Id::kDuplicate, Id::kMoveTo,
+                             Id::kToggleFavorite, Id::kRemove}),
+            Ids(menu));
+  EXPECT_EQ((std::vector<Id>{Id::kToggleMute, Id::kOpen, Id::kRemove}),
+            GroupHeads(menu));
+  // No tab: nothing to mute, nowhere to come back from, nothing to replace
+  // the pinned URL with -- and no shortcut hint, the shortcut copies the
+  // *active page's* URL.
+  EXPECT_FALSE(Find(menu, Id::kCopyLink)->show_accelerator);
+  EXPECT_FALSE(Find(menu, Id::kToggleMute)->enabled);
+  EXPECT_FALSE(Find(menu, Id::kBackToPinnedUrl)->enabled);
+  const EntryMenuItem* edit = Find(menu, Id::kEditPinnedPage);
+  ASSERT_EQ(2u, edit->submenu.size());
+  EXPECT_EQ(Id::kReplacePinnedUrl, edit->submenu[0].id);
+  EXPECT_FALSE(edit->submenu[0].enabled);
+  EXPECT_EQ(Id::kEditUrl, edit->submenu[1].id);
+  EXPECT_TRUE(edit->submenu[1].enabled);
+  EXPECT_EQ(Label::kAddToFavorites, Find(menu, Id::kToggleFavorite)->label);
+  EXPECT_EQ(Label::kRemovePin, Find(menu, Id::kRemove)->label);
+}
+
+TEST(ArcEntryMenuTest, OpenAtHomeShowsCopyHint) {
+  EntryMenuState s = Row();
+  s.bound = true;
+  EXPECT_TRUE(Find(BuildEntryMenu(s), Id::kCopyLink)->show_accelerator);
+  // The shortcut is unbound, or the pref turns it into Inspect.
+  s.copy_shortcut_live = false;
+  EXPECT_FALSE(Find(BuildEntryMenu(s), Id::kCopyLink)->show_accelerator);
+}
+
+TEST(ArcEntryMenuTest, DriftedEnablesBackAndReplaceNoHint) {
+  EntryMenuState s = Row();
+  s.bound = true;
+  s.drifted = true;
+  const std::vector<EntryMenuItem> menu = BuildEntryMenu(s);
+  EXPECT_TRUE(Find(menu, Id::kBackToPinnedUrl)->enabled);
+  EXPECT_TRUE(Find(menu, Id::kEditPinnedPage)->submenu[0].enabled);
+  // The item copies the pinned URL, the shortcut the page's.
+  EXPECT_FALSE(Find(menu, Id::kCopyLink)->show_accelerator);
+}
+
+TEST(ArcEntryMenuTest, TileHidesMoveToAndBack) {
+  EntryMenuState s = Row();
+  s.is_tile = true;
+  s.bound = true;
+  s.drifted = true;
+  const std::vector<EntryMenuItem> menu = BuildEntryMenu(s);
+  EXPECT_EQ(nullptr, Find(menu, Id::kMoveTo));
+  EXPECT_EQ(nullptr, Find(menu, Id::kBackToPinnedUrl));
+  EXPECT_EQ(Label::kMoveToPinnedTabs, Find(menu, Id::kToggleFavorite)->label);
+  EXPECT_EQ(Label::kRemoveFavorite, Find(menu, Id::kRemove)->label);
+  // Replace still works on a tile: the tab and the pinned URL both exist.
+  EXPECT_TRUE(Find(menu, Id::kEditPinnedPage)->submenu[0].enabled);
+}
+
+TEST(ArcEntryMenuTest, MuteMatrix) {
+  EntryMenuState s = Row();
+  s.audible = true;  // stale bit without a tab
+  EXPECT_FALSE(Find(BuildEntryMenu(s), Id::kToggleMute)->enabled);
+  s.bound = true;
+  EXPECT_TRUE(Find(BuildEntryMenu(s), Id::kToggleMute)->enabled);
+  EXPECT_EQ(Label::kMute, Find(BuildEntryMenu(s), Id::kToggleMute)->label);
+  // Muted pages stop being audible; Unmute must stay reachable.
+  s.audible = false;
+  s.muted = true;
+  EXPECT_TRUE(Find(BuildEntryMenu(s), Id::kToggleMute)->enabled);
+  EXPECT_EQ(Label::kUnmute, Find(BuildEntryMenu(s), Id::kToggleMute)->label);
+  s.muted = false;
+  EXPECT_FALSE(Find(BuildEntryMenu(s), Id::kToggleMute)->enabled);
+}
+
+TEST(ArcEntryMenuTest, CapDisablesFavoriteAndTileDuplicate) {
+  EntryMenuState s = Row();
+  s.can_become_favorite = false;
+  s.favorites_full = true;
+  EXPECT_FALSE(Find(BuildEntryMenu(s), Id::kToggleFavorite)->enabled);
+  // A row's copy lands among the rows, whatever the grid holds.
+  EXPECT_TRUE(Find(BuildEntryMenu(s), Id::kDuplicate)->enabled);
+  s.is_tile = true;
+  EXPECT_FALSE(Find(BuildEntryMenu(s), Id::kDuplicate)->enabled);
+  // ... and a tile can always leave the grid.
+  EXPECT_TRUE(Find(BuildEntryMenu(s), Id::kToggleFavorite)->enabled);
+}
+
+TEST(ArcEntryMenuTest, NoLeadingTrailingOrDoubleSeparators) {
+  for (int bits = 0; bits < 64; ++bits) {
+    EntryMenuState s = Row();
+    s.is_tile = bits & 1;
+    s.bound = bits & 2;
+    s.drifted = bits & 4;
+    s.muted = bits & 8;
+    s.include_3b = bits & 16;
+    if (bits & 32) {
+      s.space_ids.clear();
+    }
+    const std::vector<EntryMenuItem> menu = BuildEntryMenu(s);
+    ASSERT_FALSE(menu.empty());
+    EXPECT_FALSE(menu.front().separator_before) << bits;
+    // A separator is a flag on the item after it, so neither a trailing nor
+    // a doubled one can be expressed; what can go wrong is an empty group.
+    EXPECT_EQ(3u, GroupHeads(menu).size()) << bits;
+    for (const EntryMenuItem& item : menu) {
+      if (!item.submenu.empty()) {
+        EXPECT_FALSE(item.submenu.front().separator_before) << bits;
+      }
+    }
+  }
+}
+
+TEST(ArcEntryMenuTest, MoveToChecksOwnerEndsWithNewSpace) {
+  const std::vector<EntryMenuItem> sub =
+      Find(BuildEntryMenu(Row()), Id::kMoveTo)->submenu;
+  ASSERT_EQ(4u, sub.size());
+  EXPECT_EQ("a", sub[0].space_id);
+  EXPECT_EQ("b", sub[1].space_id);
+  EXPECT_EQ("c", sub[2].space_id);
+  EXPECT_FALSE(sub[0].checked);
+  EXPECT_TRUE(sub[1].checked);
+  EXPECT_TRUE(sub[1].enabled);
+  EXPECT_EQ(Id::kMoveToNewSpace, sub[3].id);
+  EXPECT_TRUE(sub[3].separator_before);
+  EXPECT_FALSE(sub[0].separator_before);
+}
+
+TEST(ArcEntryMenuTest, ThreeBSlotsOpenTheSecondGroup) {
+  EntryMenuState s = Row();
+  s.include_3b = true;
+  const std::vector<EntryMenuItem> menu = BuildEntryMenu(s);
+  ASSERT_GE(menu.size(), 4u);
+  EXPECT_EQ(Id::kChangeIcon, menu[1].id);
+  EXPECT_TRUE(menu[1].separator_before);
+  EXPECT_EQ(Id::kRename, menu[2].id);
+  EXPECT_EQ(Id::kToggleMute, menu[3].id);
+  EXPECT_FALSE(menu[3].separator_before);
+}
+
+TEST(ArcEntryMenuTest, FolderShape) {
+  const std::vector<EntryMenuItem> menu =
+      BuildFolderMenu(/*has_children=*/true, /*include_3b=*/false, {"a", "b"},
+                      "a");
+  EXPECT_EQ((std::vector<Id>{Id::kTurnIntoSpace, Id::kCopyAllLinks,
+                             Id::kRename, Id::kMoveTo, Id::kDeleteFolder}),
+            Ids(menu));
+  EXPECT_EQ((std::vector<Id>{Id::kRename, Id::kMoveTo, Id::kDeleteFolder}),
+            GroupHeads(menu));
+  EXPECT_EQ(3u, Find(menu, Id::kMoveTo)->submenu.size());
+
+  const std::vector<EntryMenuItem> with_icon =
+      BuildFolderMenu(true, /*include_3b=*/true, {"a"}, "a");
+  EXPECT_EQ(Id::kChangeIcon, with_icon[2].id);
+  EXPECT_TRUE(with_icon[2].separator_before);
+  EXPECT_FALSE(with_icon[3].separator_before);
+}
+
+TEST(ArcEntryMenuTest, EmptyFolderDisablesCopyAllLinks) {
+  const std::vector<EntryMenuItem> menu =
+      BuildFolderMenu(/*has_children=*/false, false, {"a"}, "a");
+  EXPECT_FALSE(Find(menu, Id::kCopyAllLinks)->enabled);
+  EXPECT_TRUE(Find(menu, Id::kTurnIntoSpace)->enabled);
+}
+
+TEST(ArcEntryMenuTest, JoinFolderLinksDisplayOrder) {
+  EXPECT_EQ("", JoinFolderLinks({}));
+  EXPECT_EQ("https://a.test/", JoinFolderLinks({"https://a.test/"}));
+  EXPECT_EQ("https://b.test/\nhttps://a.test/",
+            JoinFolderLinks({"https://b.test/", "https://a.test/"}));
+}
+
+}  // namespace
+}  // namespace helium
