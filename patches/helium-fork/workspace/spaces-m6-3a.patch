@@ -0,0 +1,48 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_CLOSE_LANDING_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_CLOSE_LANDING_H_
+
+#include <optional>
+#include <vector>
+
+namespace helium_workspace {
+
+// helium-fork 3a-r7 (user 2026-09-19 #4: "我发现 Command + W 它不会关闭 Today
+// 区域已休眠的网页 ... 把所有最近打开的网页全部关完之后，这时候再按 Command + W，
+// 如果 Today 区域还有标签，就继续关这些 Today 区域的标签（顺序是从上往下）。如果
+// Today 区域的标签也关完了，最后会剩一个空标签页。用户再点一次 Command + W，整个
+// App 窗口就关闭了"). Cmd+W only ever closed the active tab, and nothing ever
+// makes a sleeping row active (that would load it -- "按 ⌘W 突然跳到了另外一个
+// 网页", 2a-r5), so once the loaded pages were gone the window stood on a
+// blank tab and the next Cmd+W took the window, rows and all. Now, on that
+// blank tab, Cmd+W closes the rows it could never reach instead -- from the
+// top, one per press, none of them woken -- and the window only when Today
+// has nothing else left.
+// One entry per tab, in strip order (the order Today draws its rows in).
+struct SleepingLadderTab {
+  // The blank tab Cmd+W was pressed on.
+  bool blank = false;
+  // A row Today shows in the window's current space: bound to no entry, of
+  // that space (or of none), not folded away.
+  bool today_row = false;
+};
+
+// The strip index Cmd+W closes instead of the blank tab: Today's top-most
+// other row. nullopt when there is none -- the blank tab is all Today has,
+// and the window goes.
+inline std::optional<int> TodayRowToCloseBeforeBlank(
+    const std::vector<SleepingLadderTab>& tabs) {
+  for (int i = 0; i < static_cast<int>(tabs.size()); ++i) {
+    if (tabs[i].today_row && !tabs[i].blank) {
+      return i;
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_CLOSE_LANDING_H_
