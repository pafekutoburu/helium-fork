+void WorkspaceSidebarView::OnFolderCopyAllLinksRequested(
+    const std::string& folder_id) {
+  if (!service_) {
+    return;
+  }
+  // entries() is in display order, so the links come out the way the rows
+  // read top to bottom.
+  std::vector<std::string> urls;
+  for (const helium_workspace::WorkspaceEntry& entry : service_->entries()) {
+    if (entry.folder_id == folder_id) {
+      urls.push_back(entry.url.spec());
+    }
+  }
+  if (urls.empty()) {
+    return;
+  }
+  ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+  writer.WriteText(base::UTF8ToUTF16(helium::JoinFolderLinks(urls)));
+}
