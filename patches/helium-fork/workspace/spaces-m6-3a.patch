+namespace {
+
+// The row Today keeps for |tab| (every tab of the strip has one here, shown
+// or parked).
+views::View* FindRowForTab(const views::View* container,
+                           const tabs::TabInterface* tab) {
+  if (!tab) {
+    return nullptr;
+  }
+  for (views::View* child : container->children()) {
+    const TabView* const tab_view = views::AsViewClass<TabView>(child);
+    if (tab_view && tab_view->tab_interface() == tab) {
+      return child;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+std::optional<gfx::Rect> UnpinnedTabContainerView::ShownRowBoundsInScreen(
+    const tabs::TabInterface* tab) const {
+  const views::View* const row = FindRowForTab(this, tab);
+  if (!row || !row->GetVisible() || row->bounds().IsEmpty() ||
+      !row->IsDrawn()) {
+    return std::nullopt;
+  }
+  gfx::Rect bounds = row->GetBoundsInScreen();
+  if (const views::ScrollView* const scroll_view =
+          GetScrollViewForContainer()) {
+    const gfx::Rect viewport = scroll_view->GetBoundsInScreen();
+    if (viewport.height() >= bounds.height()) {
+      bounds.set_y(std::clamp(bounds.y(), viewport.y(),
+                              viewport.bottom() - bounds.height()));
+    }
+  }
+  return bounds;
+}
+
+std::optional<gfx::Rect> UnpinnedTabContainerView::LaidOutRowBoundsInScreen(
+    const tabs::TabInterface* tab) const {
+  const views::View* const row = FindRowForTab(this, tab);
+  if (!row || row->bounds().IsEmpty() || !GetWidget()) {
+    return std::nullopt;
+  }
+  const gfx::Rect bounds = row->GetBoundsInScreen();
+  if (const views::ScrollView* const scroll_view =
+          GetScrollViewForContainer();
+      scroll_view && !scroll_view->GetBoundsInScreen().Contains(bounds)) {
+    return std::nullopt;
+  }
+  return bounds;
+}
+
+gfx::ImageSkia UnpinnedTabContainerView::CaptureRowImage(
+    const tabs::TabInterface* tab) {
+  views::View* const row = FindRowForTab(this, tab);
+  if (TabView* const tab_view = views::AsViewClass<TabView>(row)) {
+    tab_view->ClearHoverAtOnce();
+  }
+  const ui::Compositor* const compositor =
+      GetWidget() ? GetWidget()->GetCompositor() : nullptr;
+  if (!row || !row->GetVisible() || row->bounds().IsEmpty() || !compositor) {
+    return gfx::ImageSkia();
+  }
+  return HeliumViewSnapshotLayer::CaptureImage(
+      row, row->GetLocalBounds(), compositor->device_scale_factor());
+}
+
+bool UnpinnedTabContainerView::BeginRowFlight(
+    const tabs::TabInterface* arriving) {
+  views::View* const row = FindRowForTab(this, arriving);
+  // No row of its own here (grouped / split), or one Today is not going to
+  // show (another space's tab): nowhere for a card to land.
+  if (arriving &&
+      (!row || ShouldHideFromToday(GetWorkspaceService(), CurrentSpaceId(),
+                                   row))) {
+    return false;
+  }
+  flight_held_row_.SetView(row);
+  layout_manager_->SetNextRunTiming(helium::kSidebarRowFlightDuration,
+                                    helium::kSidebarRowFlightTween);
+  flight_scroll_.reset();
+  if (flight_held_row_.view()) {
+    // Synchronous: OnLayoutChanged() works the new target out right here.
+    InvalidateLayout();
+    // 3a-r5: where the list has to be scrolled to for the row's place to be
+    // on screen (its *target* bounds -- it has not been laid out yet).
+    const views::ScrollView* const scroll_view = GetScrollViewForContainer();
+    const views::ChildLayout* const target =
+        layout_manager_->target_layout().GetLayoutFor(flight_held_row_.view());
+    if (scroll_view && target && target->visible &&
+        !target->bounds.IsEmpty()) {
+      const gfx::Rect visible = scroll_view->GetVisibleRect();
+      int to = visible.y();
+      if (target->bounds.y() < visible.y()) {
+        to = target->bounds.y();
+      } else if (target->bounds.bottom() > visible.bottom()) {
+        to = target->bounds.bottom() - visible.height();
+      }
+      if (to != visible.y()) {
+        flight_scroll_ = std::make_pair(visible.y(), std::max(0, to));
+      }
+    }
+  }
+  return true;
+}
+
+void UnpinnedTabContainerView::EndRowFlight(bool keep_row_held) {
+  layout_manager_->ClearNextRunTiming();
+  if (flight_scroll_) {
+    // Whatever the flight was cut short by, the row ends up on screen.
+    if (views::ScrollView* const scroll_view = GetScrollViewForContainer()) {
+      scroll_view->ScrollToOffset(gfx::PointF(0.0f, flight_scroll_->second));
+    }
+    flight_scroll_.reset();
+  }
+  if (!keep_row_held) {
+    ReleaseHeldRow();
+  }
+}
+
+void UnpinnedTabContainerView::ReleaseHeldRow() {
+  if (flight_held_row_.view()) {
+    flight_held_row_.SetView(nullptr);
+    InvalidateLayout();
+  }
+}
+
+std::optional<gfx::Rect> UnpinnedTabContainerView::HeldRowBoundsInScreen()
+    const {
+  const views::View* const row = flight_held_row_.view();
+  if (!row || row->bounds().IsEmpty()) {
+    return std::nullopt;
+  }
+  return row->GetBoundsInScreen();
+}
+
+views::View::Views UnpinnedTabContainerView::GetChildrenInZOrder() {
+  Views ordered = views::View::GetChildrenInZOrder();
+  const auto active = std::ranges::find_if(ordered, [](views::View* child) {
+    const TabView* const tab_view = views::AsViewClass<TabView>(child);
+    return tab_view && tab_view->IsActive();
+  });
+  painted_active_row_.SetView(active != ordered.end() ? *active : nullptr);
+  if (active != ordered.end()) {
+    std::rotate(active, active + 1, ordered.end());
+  }
+  return ordered;
+}
