+
+std::vector<tabs::TabHandle> WorkspaceTabController::TabsOfEntryTree(
+    const std::string& entry_id) const {
+  std::vector<tabs::TabHandle> handles;
+  for (const WorkspaceEntry& entry : service_->entries()) {
+    if (entry.id != entry_id && entry.folder_id != entry_id) {
+      continue;
+    }
+    for (tabs::TabHandle handle : service_->FindTabsForEntry(entry.id)) {
+      handles.push_back(handle);
+    }
+  }
+  return handles;
