+bool WorkspaceTabController::ShowStartupPage(const GURL& url,
+                                             bool foreground) {
+  TabStripModel* const model = browser_window_->GetTabStripModel();
+  if (!model || !service_ || !url.is_valid()) {
+    return false;
+  }
+  const auto show = [&](tabs::TabInterface* tab) {
+    const int index = model->GetIndexOfTab(tab);
+    if (index < 0) {
+      return false;
+    }
+    if (!foreground) {
+      // Startup pages after the first open in the background; so does one
+      // that was here already.
+      tab->GetContents()->GetController().LoadIfNecessary();
+    } else if (model->active_index() != index) {
+      model->ActivateTabAt(
+          index, TabStripUserGestureDetails(
+                     TabStripUserGestureDetails::GestureType::kOther));
+    }
+    return true;
+  };
+
+  // The space the window is about to come up in. Not current_space_id_: this
+  // runs inside SessionRestore, ahead of the posted AdoptTabsInWindow that
+  // settles it, and with two windows the pref's space need not be this
+  // window's (reviewer 2026-09-18). The restored tabs are all in by now, so
+  // the answer is already the one AdoptTabsInWindow will reach.
+  const std::string here = RestoredWindowLandingSpace();
+
+  // 1. An entry this space shows, pinned at |url|. Favorites first: they are
+  //    every space's, so the answer does not depend on where the window
+  //    lands. (A pinned row of *another* space is not on screen here; the
+  //    window does not go looking for it.)
+  const WorkspaceEntry* match = nullptr;
+  for (const WorkspaceEntry& entry : service_->entries()) {
+    if (entry.is_folder() || entry.url != url) {
+      continue;
+    }
+    if (entry.section == WorkspaceEntry::Section::kFavorite) {
+      match = &entry;
+      break;
+    }
+    if (!match && entry.space_id == here) {
+      match = &entry;
+    }
+  }
+  if (match) {
+    if (tabs::TabInterface* const tab =
+            service_->FindTabForEntryInWindow(match->id, browser_window_)
+                .Get()) {
+      return show(tab);
+    }
+    // No tab of its own in this window: opened the way a click on the entry
+    // opens it (OpenEntry), bound before its row is ever drawn.
+    const GURL entry_url = match->url;
+    pending_bind_entry_id_ = match->id;
+    chrome::AddAndReturnTabAt(browser_window_, entry_url, /*index=*/-1,
+                              foreground, /*group=*/std::nullopt,
+                              /*pinned=*/false);
+    pending_bind_entry_id_.clear();
+    return true;
+  }
+
+  // 2. A tab this space shows that is already at |url| -- last run's copy
+  //    back asleep. Used rather than doubled: the restore keeps every Today
+  //    row, so a fresh copy per restart would stack one more every time.
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* const tab = model->GetTabAtIndex(i);
+    content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+    if (!contents || contents->GetVisibleURL() != url) {
+      continue;
+    }
+    const std::string space = service_->GetSpaceForTab(tab->GetHandle());
+    if (space == here || space == kGlobalSpaceId) {
+      return show(tab);
+    }
+  }
+  return false;
+}
