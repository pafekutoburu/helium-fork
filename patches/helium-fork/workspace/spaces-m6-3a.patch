+void WorkspaceTabController::RemoveEntryToToday(const std::string& entry_id) {
+  const WorkspaceEntry* const entry =
+      service_ ? service_->FindEntryById(entry_id) : nullptr;
+  if (!entry) {
+    return;
+  }
+  // Copies first: RemoveEntry() frees |entry|, and |entry_id| may live in the
+  // row this command came from.
+  const std::string id = entry_id;
+  const bool is_folder = entry->is_folder();
+  const GURL url = entry->url;
+  const std::u16string title = entry->title;
+  // A favorite is in every space; its page lands in the one on screen (the
+  // rule TagInsertedTab applies to a favorite's own tab).
+  const bool was_favorite =
+      entry->section == WorkspaceEntry::Section::kFavorite;
+  const std::string entry_space_id = entry->space_id;
+  const std::string space = was_favorite ? current_space_id_ : entry_space_id;
+  // A tab in a window that is on its way out does not count (reviewer
+  // 2026-09-18): its handle still resolves, RemoveEntry() would unbind it,
+  // and the window would take it along -- leaving Today with nothing.
+  bool has_live_tab = false;
+  for (const tabs::TabHandle& handle : service_->FindTabsForEntry(id)) {
+    tabs::TabInterface* const tab = handle.Get();
+    BrowserWindowInterface* const window =
+        tab ? tab->GetBrowserWindowInterface() : nullptr;
+    if (window && !window->IsDeleteScheduled()) {
+      has_live_tab = true;
+      break;
+    }
+  }
+  tabs::TabHandle made_tab = tabs::TabHandle::Null();
+  if (!is_folder && !has_live_tab && url.is_valid()) {
+    made_tab = AddSleepingTodayTab(url, title, space);
+  }
+  // 3a-r3: the entry's tabs land where the sleeping one above would have --
+  // in every window that has one (RemoveEntry() unbinds them all; a favorite
+  // is commonly open in two windows. Reviewer 2026-09-19).
+  for (const tabs::TabHandle& handle : service_->FindTabsForEntry(id)) {
+    LandTabInSpaceOnUnbind(handle.Get(), was_favorite, entry_space_id);
+    MoveTabToNewTabPlace(handle.Get());
+  }
+  // RemoveEntry() announces the bindings it dropped, so every window rewrites
+  // its session records (OnWorkspaceBindingsChanged): the tabs that were the
+  // entry's say "bound to nothing" from now on.
+  // 3a-r4: and the row flies to its place in Today (a folder's children do
+  // not -- several rows leaving at once are not one row relocating).
+  if (!is_folder) {
+    service_->set_entry_becoming_tab(
+        WorkspaceService::EntryBecomingTab{id, made_tab});
+  }
+  service_->RemoveEntry(id);
+  service_->set_entry_becoming_tab(std::nullopt);
+}
+
+void WorkspaceTabController::LandTabInSpaceOnUnbind(
+    tabs::TabInterface* tab,
+    bool was_favorite,
+    const std::string& entry_space_id) {
+  BrowserWindowInterface* const window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  WorkspaceTabController* const owner =
+      window && !window->IsDeleteScheduled() ? From(window) : nullptr;
+  if (!owner) {
+    return;
+  }
+  const std::string space =
+      was_favorite ? owner->current_space_id_ : entry_space_id;
+  if (!service_->FindSpaceById(space)) {
+    return;
+  }
+  const tabs::TabHandle handle = tab->GetHandle();
+  service_->SetTabSpace(handle, space);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspaceTabController::PersistTabSpace,
+                                owner->weak_factory_.GetWeakPtr(), handle,
+                                space));
+}
+
+void WorkspaceTabController::MoveTabToNewTabPlace(tabs::TabInterface* tab) {
+  // The tab's own window: Remove Pin / Remove Favorite reaches the entry's
+  // tabs in other windows too.
+  BrowserWindowInterface* const window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  TabStripModel* const model =
+      window && !window->IsDeleteScheduled() ? window->GetTabStripModel()
+                                             : nullptr;
+  const int index = model ? model->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+  // A tab somebody grouped or split stays put -- moving it out would take the
+  // group or the split apart (same rule as session_restore.cc's
+  // MoveLandingPageToFront).
+  if (index == TabStripModel::kNoTab || model->closing_all() ||
+      model->GetTabGroupForTab(index).has_value() ||
+      model->GetSplitForTab(index).has_value()) {
+    return;
+  }
+  const int place =
+      std::min(model->GetDefaultNewTabIndex(), model->count() - 1);
+  if (place != index) {
+    model->MoveWebContentsAt(index, place, /*select_after_move=*/false);
+  }
+}
