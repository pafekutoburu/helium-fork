+class WorkspaceMoveToSpaceMenuModel;
+
+// helium-fork M6 轮3 3a: the right-click menu of a sidebar row, tile or
+// folder head row. The order, the separators and the enabled bits are
+// helium::BuildEntryMenu / BuildFolderMenu's (arc_entry_menu.h, unit-tested);
+// this class only turns that shape into a native menu and hands the chosen
+// item back. Local command ids: the host executes them, they are never in
+// the browser command table -- the space menu's pattern.
+class WorkspaceEntryMenuModel : public ui::SimpleMenuModel,
+                                public ui::SimpleMenuModel::Delegate {
+ public:
+  // |space_id| is set for kMoveToSpace only.
+  using CommandCallback =
+      base::RepeatingCallback<void(helium::EntryMenuItemId id,
+                                   const std::string& space_id)>;
+
+  // |spaces| / |owner_space_id| feed the Move to submenu. |folder_name| goes
+  // into Turn "x" into Space. |copy_accelerator| is what Copy Link shows
+  // when the shape asks for the hint; empty shows nothing.
+  WorkspaceEntryMenuModel(
+      const std::vector<helium::EntryMenuItem>& shape,
+      const std::vector<helium_workspace::WorkspaceSpace>& spaces,
+      const std::string& owner_space_id,
+      const std::u16string& folder_name,
+      const ui::Accelerator& copy_accelerator,
+      CommandCallback on_command);
+  WorkspaceEntryMenuModel(const WorkspaceEntryMenuModel&) = delete;
+  WorkspaceEntryMenuModel& operator=(const WorkspaceEntryMenuModel&) = delete;
+  ~WorkspaceEntryMenuModel() override;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdEnabled(int command_id) const override;
+  bool GetAcceleratorForCommandId(int command_id,
+                                  ui::Accelerator* accelerator) const override;
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+ private:
+  struct Command {
+    helium::EntryMenuItemId id;
+    bool enabled;
+  };
+
+  void AddItems(ui::SimpleMenuModel* menu,
+                const std::vector<helium::EntryMenuItem>& items,
+                const std::vector<helium_workspace::WorkspaceSpace>& spaces,
+                const std::string& owner_space_id,
+                const std::u16string& folder_name);
+  void OnMoveToChoice(const std::string& space_id);
+
+  // Command id - 1 indexes this, across the root menu and its submenus.
+  std::vector<Command> commands_;
+  std::vector<std::unique_ptr<ui::SimpleMenuModel>> submenus_;
+  std::unique_ptr<WorkspaceMoveToSpaceMenuModel> move_to_;
+  const ui::Accelerator copy_accelerator_;
+  const CommandCallback on_command_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_WORKSPACE_ENTRY_MENU_MODEL_H_
