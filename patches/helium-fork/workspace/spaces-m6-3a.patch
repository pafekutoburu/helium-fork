+bool PinnedTabContainerView::ShouldPlaceMovedChildAtOnce(
+    const views::View& child_view) const {
+  // helium-fork 3a-r3: the sidebar's bounds are its preferred size, every
+  // frame. It animates that size itself (a folder's fold, a row arriving or
+  // leaving); this container's own 200ms on top re-aimed at each of those
+  // frames and never caught up, so the bounds trailed the rows drawn in them
+  // and View::Paint clipped the last one -- the folder's closing blink
+  // (M3.10-r2), the arriving space's last row (M6-r4), and a newly pinned row
+  // wiping in from its top edge well after Today had already made room (user
+  // 2026-09-19: "还是有一个从上而下的闪烁。这个我在很多地方都提到这个问题了").
+  // ShouldSnapToTarget() cannot say this: it is only asked about a child
+  // that has just been added.
+  return &child_view == workspace_view_;
+}
