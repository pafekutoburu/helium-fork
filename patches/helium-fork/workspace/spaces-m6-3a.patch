+void UnpinnedTabContainerView::OnAnimationProgressed() {
+  // 3a-r5: the list scrolls the arriving row into view on the run's own
+  // progress -- before the sidebar reads where that row is (the card homes in
+  // on its place *now*, so the two converge on the same spot).
+  if (flight_scroll_) {
+    if (views::ScrollView* const scroll_view = GetScrollViewForContainer()) {
+      const double t = layout_manager_->run_progress().value_or(1.0);
+      scroll_view->ScrollToOffset(gfx::PointF(
+          0.0f, static_cast<float>(
+                    flight_scroll_->first +
+                    (flight_scroll_->second - flight_scroll_->first) * t)));
+    }
+  }
+  if (workspace_drag_host_) {
+    workspace_drag_host_->OnTodayRowShiftProgressed();
+  }
+}
