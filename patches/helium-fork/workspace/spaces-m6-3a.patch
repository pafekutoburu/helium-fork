+void WorkspaceSidebarView::StartPendingEntryShift() {
+  entry_shift_start_pending_ = false;
+  if (entry_shift_valid_) {
+    // 3a-r4 (reviewer 2026-09-19): whose clock this shift runs on is settled
+    // here, once. A Today run that is part of the same command has been set
+    // up by now (pending counts); one that starts later -- Cmd+T a moment
+    // after moving a row into the grid -- is somebody else's, and letting it
+    // take the progress over rewound the shift, and the flying card, to 0.
+    // (A run of Today's already under way is somebody else's too: the one
+    // that belongs to this command has not produced a frame yet.)
+    const std::optional<double> today =
+        today_container_ ? today_container_->RowShiftProgress() : std::nullopt;
+    entry_shift_rides_today_ = today.has_value() && *today == 0.0;
+    entry_shift_animation_.Show();
+  }
+}
+
+void WorkspaceSidebarView::FinishEntryShift(bool landed) {
+  // 3a-r6 (reviewer 2026-09-19): whatever cuts a shift short -- a fold, a
+  // space switch, a drag or a URL session starting -- also takes a card that
+  // is still setting down from the *last* flight. That flight is over
+  // (|row_flight_| is gone, the shift usually too), so nothing below would
+  // reach it; and a favourite's tile outlives a space switch, so the card
+  // would not notice by itself that the list under it was replaced.
+  if (!landed && drag_overlay_ && drag_overlay_->setting_down()) {
+    drag_overlay_->Stop();
+  }
+  if (!entry_shift_valid_) {
+    return;
+  }
+  EndRowFlight(landed);
+  entry_shift_valid_ = false;
+  entry_shift_rides_today_ = false;
+  entry_shift_from_ = EntryShiftFrom();
+  entry_shift_animation_.Reset(0.0);
+  PreferredSizeChanged();
+  InvalidateLayout();
+  ScheduleHoverResync();
+}
+
+double WorkspaceSidebarView::EntryShiftProgress() const {
+  if (entry_shift_start_pending_) {
+    return 0.0;
+  }
+  if (entry_shift_rides_today_ && today_container_) {
+    if (const std::optional<double> today =
+            today_container_->RowShiftProgress()) {
+      return *today;
+    }
+  }
+  return entry_shift_animation_.GetCurrentValue();
+}
+
+void WorkspaceSidebarView::OnTodayRowShiftProgressed() {
+  if (entry_shift_valid_ && entry_shift_rides_today_) {
+    PreferredSizeChanged();
+    InvalidateLayout();
+    UpdateRowFlight();
+  }
+}
+
+void WorkspaceSidebarView::MaybeStartRowFlight() {
+  // Only with the shift this very task set up: its snapshot is where the row
+  // was, and nothing has been laid out or painted since.
+  if (!entry_shift_valid_ || !entry_shift_start_pending_ || row_flight_ ||
+      drag_ || !drag_overlay_ || !drag_overlay_->parent() ||
+      !today_container_) {
+    return;
+  }
+  // 3a-r6: a card still setting down from the last flight is not in anybody's
+  // way -- stopping it shows the row under it (3a-r8: ReleaseSetDownRow).
+  if (drag_overlay_->setting_down()) {
+    drag_overlay_->Stop();
+  }
+  if (drag_overlay_->active()) {
+    return;
+  }
+  const auto& was = entry_shift_from_.rows;
+  RowFlight flight;
+  // 3a-r5: what the card wears (see StartFlight): the row that takes off, as
+  // painted. Null when a tile takes off, or a pinned row on its way to the
+  // grid (nobody says so before the sync that turns it into a tile).
+  gfx::ImageSkia row_image;
+  tabs::TabInterface* content_tab = nullptr;
+  const tabs::TabInterface* arriving_in_today = nullptr;
+  // Whether a row of Today's arrives or leaves -- a row going between the
+  // pinned list and the grid moves nothing in Today, and Today must then not
+  // be told about the flight at all (reviewer 2026-09-19: its next, unrelated
+  // run would have taken the flight's 300ms).
+  bool today_takes_part = false;
+  bool active = false;
+
+  // 1. Out to Today: the controller names the entry (Remove Pin / Remove
+  //    Favorite / Cmd+D). Its tab in this window is the one the row was
+  //    showing, or the sleeping one just made for an entry that had none.
+  if (const auto& hint = service_ ? service_->entry_becoming_tab()
+                                  : std::nullopt;
+      hint && !entry_views_.contains(hint->entry_id)) {
+    if (const auto it = was.find(hint->entry_id); it != was.end()) {
+      tabs::TabInterface* tab = it->second.tab.Get();
+      if (!tab) {
+        tab = hint->made_tab.Get();
+      }
+      if (tab && tab->GetBrowserWindowInterface() == GetBrowserWindow()) {
+        flight.from_screen = it->second.screen;
+        flight.from_tile = it->second.tile;
+        flight.to_tile = false;
+        active = it->second.active;
+        content_tab = tab;
+        arriving_in_today = tab;
+        flight.today_tab = tab->GetWeakPtr();
+        today_takes_part = true;
+        row_image = leaving_row_image_;
+        // A row scrolled out of the pinned viewport takes off from the
+        // viewport's edge on that side.
+        if (const views::ScrollView* const scroll_view = PinnedScrollView();
+            scroll_view && !flight.from_tile) {
+          const gfx::Rect viewport = scroll_view->GetBoundsInScreen();
+          if (viewport.height() >= flight.from_screen.height()) {
+            flight.from_screen.set_y(std::clamp(
+                flight.from_screen.y(), viewport.y(),
+                viewport.bottom() - flight.from_screen.height()));
+          }
+        }
+      }
+    }
+  }
+  // 2. Inside the sidebar, or in from Today: exactly one row the target shows
+  //    that was not there, or was there in the other form. More than one is a
+  //    different kind of change (a folder deleted, a sync from another
+  //    window) and nothing flies.
+  if (!content_tab) {
+    // Only a landing row the settled layout shows: one under a folded folder
+    // or a folded space has no place on screen to fly to.
+    const SidebarLayout settled = ComputeLayout(width());
+    size_t candidates = 0;
+    WorkspaceEntryView* row_view = nullptr;
+    gfx::Size row_view_size;
+    for (size_t i = 0; i < ordered_entries_.size(); ++i) {
+      WorkspaceEntryView* const view = SiteRowAt(i);
+      if (!view || i >= settled.entry_visible.size() ||
+          !settled.entry_visible[i]) {
+        continue;
+      }
+      const bool tile = i < favorite_count_;
+      const auto it = was.find(view->entry_id());
+      if (it != was.end() && it->second.tile == tile) {
+        continue;
+      }
+      ++candidates;
+      if (it != was.end()) {
+        // Pinned row <-> favorite tile.
+        flight.from_screen = it->second.screen;
+        flight.from_tile = it->second.tile;
+        active = it->second.active;
+        content_tab = view->bound_tab();
+        // 3a-r6: the row at the row end of the trip -- the one it was (the
+        // view is a tile by now), or the one it lands as. Painted below,
+        // once this is known to be the only candidate.
+        row_view = view;
+        row_view_size = tile ? it->second.screen.size()
+                             : settled.entry_bounds[i].size();
+      } else if (tabs::TabInterface* const tab = view->bound_tab()) {
+        // A new entry showing a tab Today is still showing: Pin / Add to
+        // Favorites / Cmd+D.
+        const std::optional<gfx::Rect> row =
+            today_container_->ShownRowBoundsInScreen(tab);
+        if (!row) {
+          continue;
+        }
+        flight.from_screen = *row;
+        flight.from_tile = false;
+        active = view->active();
+        content_tab = tab;
+        today_takes_part = true;
+        row_image = today_container_->CaptureRowImage(tab);
+      } else {
+        continue;
+      }
+      flight.to_tile = tile;
+      flight.to_entry_id = view->entry_id();
+      // 3a-r5: a landing row the pinned list has scrolled away is scrolled
+      // into view over the flight (tiles never scroll).
+      flight.pinned_scroll.reset();
+      if (const views::ScrollView* const scroll_view = PinnedScrollView();
+          scroll_view && !tile) {
+        gfx::Rect place = settled.entry_bounds[i];
+        place.Offset(0, -settled.grid_segment);  // Virtual -> this view.
+        place.Offset(0, y());                    // -> the scroll contents.
+        const gfx::Rect visible = scroll_view->GetVisibleRect();
+        int to = visible.y();
+        if (place.y() < visible.y()) {
+          to = place.y();
+        } else if (place.bottom() > visible.bottom()) {
+          to = place.bottom() - visible.height();
+        }
+        if (to != visible.y()) {
+          flight.pinned_scroll = std::make_pair(visible.y(), std::max(0, to));
+        }
+      }
+    }
+    if (candidates != 1 || flight.to_entry_id.empty()) {
+      return;
+    }
+    if (row_view && row_view->entry_id() == flight.to_entry_id) {
+      std::vector<gfx::ImageSkia> images =
+          CaptureEntryAsRow(row_view, {row_view_size});
+      if (!images.empty()) {
+        row_image = images.front();
+      }
+    }
+  }
+  if (flight.from_screen.IsEmpty()) {
+    return;
+  }
+
+  // What the card shows: the live tab's icon and title when there is one (the
+  // row at either end shows the same), else the entry's own.
+  ui::ImageModel favicon;
+  std::u16string title;
+  SkColor surface = SK_ColorTRANSPARENT;
+  SkColor text_color = SK_ColorTRANSPARENT;
+  WorkspaceEntryView* const landing =
+      flight.to_entry_id.empty() ? nullptr
+                                 : entry_views_[flight.to_entry_id].get();
+  if (landing) {
+    favicon = landing->drag_favicon();
+    title = landing->drag_title();
+  }
+  if (content_tab && (!landing || !landing->bound_tab())) {
+    if (content::WebContents* const contents = content_tab->GetContents()) {
+      title = contents->GetTitle();
+    }
+  }
+  if (content_tab && (favicon.IsEmpty() || !landing)) {
+    favicon = tabs::TabData::FromTabInterface(content_tab).favicon;
+  }
+  if (const ui::ColorProvider* const colors = GetColorProvider()) {
+    surface =
+        helium::GetSidebarFloatingCardColor(colors->GetColor(kColorToolbar));
+    text_color = colors->GetColor(kColorTabForegroundActiveFrameActive);
+  }
+  // A tile's selected look is not the row's white card, so only a row that is
+  // active at both ends keeps the card on all the way.
+  flight.lifts = !active || flight.from_tile || flight.to_tile;
+
+  // A tab somebody grouped or split has no row of its own in Today to land
+  // on (it sits inside the group's view): no flight, it is simply there.
+  if (today_takes_part &&
+      !today_container_->BeginRowFlight(arriving_in_today)) {
+    today_container_->EndRowFlight();
+    return;
+  }
+  flight.today_takes_part = today_takes_part;
+  row_flight_ = std::move(flight);
+  entry_shift_animation_.SetSlideDuration(helium::kSidebarRowFlightDuration);
+  entry_shift_animation_.SetTweenType(helium::kSidebarRowFlightTween);
+  const gfx::Rect from = views::View::ConvertRectFromScreen(
+      drag_overlay_->parent(), row_flight_->from_screen);
+  drag_overlay_->StartFlight(favicon, title, surface, text_color, row_image,
+                             from, row_flight_->from_tile ? 1.0 : 0.0,
+                             row_flight_->lifts ? 0.0 : 1.0);
+  // The landing row steps aside for the card (CurrentLayout).
+  InvalidateLayout();
+}
+
+void WorkspaceSidebarView::UpdateRowFlight() {
+  if (!row_flight_ || !drag_overlay_ || !drag_overlay_->in_flight() ||
+      !drag_overlay_->parent()) {
+    return;
+  }
+  const double t = entry_shift_start_pending_ ? 0.0 : EntryShiftProgress();
+  // 3a-r5: first, so that the landing row read below is where it is going to
+  // be drawn this frame.
+  if (row_flight_->pinned_scroll) {
+    if (views::ScrollView* const scroll_view = PinnedScrollView()) {
+      const auto [then, shown] = *row_flight_->pinned_scroll;
+      scroll_view->ScrollToOffset(
+          gfx::PointF(0.0f, static_cast<float>(then + (shown - then) * t)));
+    }
+  }
+  // Where the landing row is *now*: it rides whatever is still moving (the
+  // Today container under this view's height), so the card homes in on it
+  // and is exactly on it at 1. Until it has been laid out the card waits
+  // where it took off.
+  std::optional<gfx::Rect> to_screen;
+  if (row_flight_->to_entry_id.empty()) {
+    to_screen = today_container_ ? today_container_->HeldRowBoundsInScreen()
+                                 : std::nullopt;
+  } else if (const auto it = entry_views_.find(row_flight_->to_entry_id);
+             it != entry_views_.end() && !it->second->bounds().IsEmpty()) {
+    to_screen = it->second->GetBoundsInScreen();
+  }
+  gfx::Rect rect = row_flight_->from_screen;
+  if (to_screen) {
+    rect = LerpRect(row_flight_->from_screen, *to_screen, t);
+  }
+  const double from_morph = row_flight_->from_tile ? 1.0 : 0.0;
+  const double to_morph = row_flight_->to_tile ? 1.0 : 0.0;
+  const double lift =
+      row_flight_->lifts ? helium::SidebarRowFlightLift(t) : 1.0;
+  drag_overlay_->SetFlight(
+      views::View::ConvertRectFromScreen(drag_overlay_->parent(), rect),
+      from_morph + (to_morph - from_morph) * t, lift);
+}
+
+// static
+std::optional<gfx::Rect> WorkspaceSidebarView::SetDownRowBounds(
+    base::WeakPtr<WorkspaceSidebarView> self,
+    const std::string& entry_id,
+    base::WeakPtr<tabs::TabInterface> today_tab) {
+  if (!self || !self->GetWidget() || !self->drag_overlay_ ||
+      !self->drag_overlay_->parent()) {
+    return std::nullopt;
+  }
+  std::optional<gfx::Rect> screen;
+  if (!entry_id.empty()) {
+    const auto it = self->entry_views_.find(entry_id);
+    if (it == self->entry_views_.end() || it->second->bounds().IsEmpty()) {
+      return std::nullopt;
+    }
+    screen = it->second->GetBoundsInScreen();
+    // Tiles never scroll; a pinned row can be scrolled away under the card.
+    const views::ScrollView* const scroll_view = self->PinnedScrollView();
+    if (scroll_view && !it->second->renders_as_capsule() &&
+        !scroll_view->GetBoundsInScreen().Contains(*screen)) {
+      return std::nullopt;
+    }
+  } else if (today_tab && self->today_container_) {
+    screen = self->today_container_->LaidOutRowBoundsInScreen(today_tab.get());
+  }
+  if (!screen) {
+    return std::nullopt;
+  }
+  return views::View::ConvertRectFromScreen(self->drag_overlay_->parent(),
+                                            *screen);
+}
+
+void WorkspaceSidebarView::EndRowFlight(bool landed) {
+  if (!row_flight_) {
+    return;
+  }
+  const bool today_took_part = row_flight_->today_takes_part;
+  // 3a-r6: the card of a row that wears none at rest stays on, over the row
+  // it landed on, while its fill fades (user 2026-09-19: "到位之后，它才开始
+  // 衰减"). Only a flight that ran out: one cut short by whatever comes next
+  // has not landed anywhere.
+  const bool sets_down = landed && row_flight_->lifts && drag_overlay_ &&
+                         drag_overlay_->in_flight();
+  // 3a-r8: see the header.
+  const bool holds_row = sets_down && !row_flight_->to_tile;
+  WorkspaceEntryDragOverlay::WhereCallback where;
+  if (sets_down) {
+    where = base::BindRepeating(&WorkspaceSidebarView::SetDownRowBounds,
+                                weak_factory_.GetWeakPtr(),
+                                row_flight_->to_entry_id,
+                                row_flight_->today_tab);
+  }
+  if (holds_row) {
+    set_down_entry_id_ = row_flight_->to_entry_id;
+    set_down_holds_today_ = set_down_entry_id_.empty() && today_took_part;
+  }
+  // 3a-r5: however the flight ended, the landing row is on screen.
+  if (row_flight_->pinned_scroll) {
+    if (views::ScrollView* const scroll_view = PinnedScrollView()) {
+      scroll_view->ScrollToOffset(gfx::PointF(
+          0.0f, static_cast<float>(row_flight_->pinned_scroll->second)));
+    }
+  }
+  row_flight_.reset();
+  entry_shift_animation_.SetSlideDuration(helium::kSidebarRowShiftDuration);
+  entry_shift_animation_.SetTweenType(helium::kSidebarRowShiftTween);
+  if (today_took_part && today_container_) {
+    today_container_->EndRowFlight(/*keep_row_held=*/set_down_holds_today_);
+  }
+  if (drag_overlay_ && drag_overlay_->in_flight()) {
+    if (sets_down) {
+      // |done| may run inside this very call (nothing to set down on).
+      drag_overlay_->SetDownFlight(
+          std::move(where),
+          base::BindOnce(&WorkspaceSidebarView::ReleaseSetDownRow,
+                         weak_factory_.GetWeakPtr()));
+    } else {
+      drag_overlay_->Stop();
+    }
+  }
+}
+
+void WorkspaceSidebarView::ReleaseSetDownRow() {
+  if (set_down_holds_today_ && today_container_) {
+    today_container_->ReleaseHeldRow();
+  }
+  set_down_holds_today_ = false;
+  if (!set_down_entry_id_.empty()) {
+    set_down_entry_id_.clear();
+    InvalidateLayout();
+  }
+  ScheduleHoverResync();
+}
+
+bool WorkspaceSidebarView::IsHeldForCard(const std::string& entry_id) const {
+  return (row_flight_ && entry_id == row_flight_->to_entry_id) ||
+         (!set_down_entry_id_.empty() && entry_id == set_down_entry_id_);
+}
+
+void WorkspaceSidebarView::OnTodayRowShiftEnded() {
+  // Only the run this shift rides ends it (3a-r4); still pending, the shift
+  // has not picked a clock yet and whatever just ended was not its run.
+  if (entry_shift_rides_today_ && !entry_shift_start_pending_) {
+    FinishEntryShift(/*landed=*/true);
+  }
 }
 
