+tabs::TabHandle WorkspaceTabController::AddSleepingTodayTab(
+    const GURL& url,
+    const std::u16string& title,
+    const std::string& space_id) {
+  Browser* const browser = browser_window_->GetBrowserForMigrationOnly();
+  TabStripModel* const model = browser_window_->GetTabStripModel();
+  if (!browser || !model) {
+    return tabs::TabHandle::Null();
+  }
+  sessions::SerializedNavigationEntry navigation;
+  navigation.set_index(0);
+  navigation.set_virtual_url(url);
+  navigation.set_title(title);
+  navigation.set_transition_type(ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  navigation.set_timestamp(base::Time::Now());
+  // Both records ride in on the tab (browser_tabrestore.cc hands them to
+  // TagInsertedTab / RestoreEntryBindingFromSession): this space, and the
+  // "bound to nothing" sentinel -- without it the next restart would find a
+  // tab with no record and try to guess an entry for it by origin.
+  const std::map<std::string, std::string> extra_data = {
+      {kSpaceExtraDataKey, space_id},
+      {kEntryExtraDataKey, kEntryExtraDataNone}};
+  const std::vector<sessions::SerializedNavigationEntry> navigations = {
+      navigation};
+  // Where any new tab goes (AddRestoredTab wants the index spelled out).
+  content::WebContents* const contents = chrome::AddRestoredTab(
+      browser, navigations, model->GetDefaultNewTabIndex(),
+      /*selected_navigation=*/0, /*extension_app_id=*/std::string(),
+      /*group=*/std::nullopt, /*select=*/false, /*pin=*/false,
+      base::TimeTicks::Now(), base::Time::Now(),
+      /*session_storage_namespace=*/nullptr,
+      sessions::SerializedUserAgentOverride(), extra_data,
+      /*from_session_restore=*/false, /*is_active_browser=*/std::nullopt);
+  // A tab that never navigates never asks for its icon (2a-r6 #2b).
+  if (favicon::FaviconDriver* const driver =
+          contents ? favicon::ContentFaviconDriver::FromWebContents(contents)
+                   : nullptr) {
+    driver->FetchFavicon(url, /*is_same_document=*/false);
+  }
+  tabs::TabInterface* const made =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  return made ? made->GetHandle() : tabs::TabHandle::Null();
+}
