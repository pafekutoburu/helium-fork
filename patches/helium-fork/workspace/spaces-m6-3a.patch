+namespace {
+
+int StringIdFor(helium::EntryMenuLabel label) {
+  using Label = helium::EntryMenuLabel;
+  switch (label) {
+    case Label::kCopyLink:
+      return IDS_HELIUM_WS_ENTRY_MENU_COPY_LINK;
+    case Label::kChangeIcon:
+      return IDS_HELIUM_WS_ENTRY_MENU_CHANGE_ICON;
+    case Label::kRename:
+      return IDS_HELIUM_WS_FOLDER_MENU_RENAME;
+    case Label::kMute:
+      return IDS_HELIUM_WS_ENTRY_MENU_MUTE;
+    case Label::kUnmute:
+      return IDS_HELIUM_WS_ENTRY_MENU_UNMUTE;
+    case Label::kBackToPinnedUrl:
+      return IDS_HELIUM_WS_ENTRY_BACK_TO_PINNED_URL;
+    case Label::kEditPinnedPage:
+      return IDS_HELIUM_WS_ENTRY_MENU_EDIT_PINNED_PAGE;
+    case Label::kReplacePinnedUrl:
+      return IDS_HELIUM_WS_ENTRY_MENU_REPLACE_PINNED_URL;
+    case Label::kEditUrl:
+      return IDS_HELIUM_WS_ENTRY_MENU_EDIT_URL;
+    case Label::kOpen:
+      return IDS_HELIUM_WS_ENTRY_MENU_OPEN;
+    case Label::kDuplicate:
+      return IDS_HELIUM_WS_ENTRY_MENU_DUPLICATE;
+    case Label::kMoveTo:
+      return IDS_HELIUM_WS_ENTRY_MENU_MOVE_TO;
+    case Label::kAddToFavorites:
+      return IDS_TAB_CXMENU_ADD_TO_FAVORITES;
+    case Label::kMoveToPinnedTabs:
+      return IDS_HELIUM_WS_ENTRY_MENU_MOVE_TO_PINNED;
+    case Label::kRemovePin:
+      return IDS_HELIUM_WS_ENTRY_MENU_REMOVE_PIN;
+    case Label::kRemoveFavorite:
+      return IDS_HELIUM_WS_ENTRY_MENU_REMOVE_FAVORITE;
+    case Label::kCopyAllLinks:
+      return IDS_HELIUM_WS_FOLDER_MENU_COPY_ALL_LINKS;
+    case Label::kDeleteFolder:
+      return IDS_HELIUM_WS_FOLDER_MENU_DELETE;
+    case Label::kTurnIntoSpace:
+      return IDS_HELIUM_WS_FOLDER_MENU_TURN_INTO_SPACE;
+    case Label::kSpaceName:
+    case Label::kNewSpace:
+      // The Move to submenu's own (WorkspaceMoveToSpaceMenuModel).
+      break;
+  }
+  NOTREACHED();
+}
+
+}  // namespace
+
+WorkspaceEntryMenuModel::WorkspaceEntryMenuModel(
+    const std::vector<helium::EntryMenuItem>& shape,
+    const std::vector<helium_workspace::WorkspaceSpace>& spaces,
+    const std::string& owner_space_id,
+    const std::u16string& folder_name,
+    const ui::Accelerator& copy_accelerator,
+    CommandCallback on_command)
+    : ui::SimpleMenuModel(this),
+      copy_accelerator_(copy_accelerator),
+      on_command_(std::move(on_command)) {
+  AddItems(this, shape, spaces, owner_space_id, folder_name);
+}
+
+WorkspaceEntryMenuModel::~WorkspaceEntryMenuModel() = default;
+
+bool WorkspaceEntryMenuModel::IsCommandIdEnabled(int command_id) const {
+  const size_t index = static_cast<size_t>(command_id - 1);
+  return index < commands_.size() && commands_[index].enabled;
+}
+
+bool WorkspaceEntryMenuModel::GetAcceleratorForCommandId(
+    int command_id,
+    ui::Accelerator* accelerator) const {
+  const size_t index = static_cast<size_t>(command_id - 1);
+  if (index >= commands_.size() ||
+      commands_[index].id != helium::EntryMenuItemId::kCopyLink ||
+      copy_accelerator_.IsEmpty()) {
+    return false;
+  }
+  *accelerator = copy_accelerator_;
+  return true;
+}
+
+void WorkspaceEntryMenuModel::ExecuteCommand(int command_id, int event_flags) {
+  const size_t index = static_cast<size_t>(command_id - 1);
+  if (index >= commands_.size()) {
+    return;
+  }
+  // Locals: Remove, Move to and Turn into Space rebuild the sidebar, which
+  // takes the row that owns this model -- and the model -- down inside the
+  // callback.
+  const helium::EntryMenuItemId id = commands_[index].id;
+  const CommandCallback on_command = on_command_;
+  on_command.Run(id, std::string());
+}
+
+void WorkspaceEntryMenuModel::AddItems(
+    ui::SimpleMenuModel* menu,
+    const std::vector<helium::EntryMenuItem>& items,
+    const std::vector<helium_workspace::WorkspaceSpace>& spaces,
+    const std::string& owner_space_id,
+    const std::u16string& folder_name) {
+  for (const helium::EntryMenuItem& item : items) {
+    if (item.separator_before) {
+      menu->AddSeparator(ui::NORMAL_SEPARATOR);
+    }
+    commands_.push_back({item.id, item.enabled});
+    const int command_id = static_cast<int>(commands_.size());
+    const int string_id = StringIdFor(item.label);
+
+    if (item.id == helium::EntryMenuItemId::kMoveTo) {
+      // Unretained: |move_to_| is ours, and its callback copies what it
+      // needs before it runs (see OnMoveToChoice).
+      move_to_ = std::make_unique<WorkspaceMoveToSpaceMenuModel>(
+          spaces, owner_space_id,
+          base::BindRepeating(&WorkspaceEntryMenuModel::OnMoveToChoice,
+                              base::Unretained(this)));
+      menu->AddSubMenuWithStringId(command_id, string_id, move_to_.get());
+    } else if (!item.submenu.empty()) {
+      submenus_.push_back(std::make_unique<ui::SimpleMenuModel>(this));
+      ui::SimpleMenuModel* const submenu = submenus_.back().get();
+      AddItems(submenu, item.submenu, spaces, owner_space_id, folder_name);
+      menu->AddSubMenuWithStringId(command_id, string_id, submenu);
+    } else if (item.label == helium::EntryMenuLabel::kTurnIntoSpace) {
+      menu->AddItem(command_id,
+                    l10n_util::GetStringFUTF16(string_id, folder_name));
+    } else {
+      menu->AddItemWithStringId(command_id, string_id);
+    }
+    // A submenu's parent never reaches IsCommandIdEnabled on the Mac, and a
+    // context menu only shows an accelerator it is forced to.
+    const size_t index = menu->GetItemCount() - 1;
+    menu->SetEnabledAt(index, item.enabled);
+    if (item.show_accelerator && !copy_accelerator_.IsEmpty()) {
+      menu->SetForceShowAcceleratorForItemAt(index, true);
+    }
+  }
+}
+
+void WorkspaceEntryMenuModel::OnMoveToChoice(const std::string& space_id) {
+  const CommandCallback on_command = on_command_;
+  on_command.Run(space_id.empty() ? helium::EntryMenuItemId::kMoveToNewSpace
+                                  : helium::EntryMenuItemId::kMoveToSpace,
+                 space_id);
+}
