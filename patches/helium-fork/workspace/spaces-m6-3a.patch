--- src.orig/chrome/browser/app_controller_mac.mm
+++ src/chrome/browser/app_controller_mac.mm
@@ -240,13 +240,40 @@
 
 // Creates an empty browser window with the given profile and returns a pointer
 // to the new |BrowserWindowInterface|.
-BrowserWindowInterface* CreateBrowser(Profile* profile) {
+//
+// helium-fork 3a-r9 (user 2026-09-20, of Open File / Cmd+L with no window
+// open: "就和 Command + N 一样，恢复原来的窗口，但是活动状态不恢复，也就是原来所有
+// 的标签都保留"): |with_last_session| opens the window without
+// g_is_opening_new_window, so that SessionService::WindowOpened() puts the
+// closed window's tabs back into this one, asleep, behind its New Tab page --
+// the road Settings, History and the other chrome::Open*Window() helpers have
+// always taken (m6_probe dock_reopen, M6_REOPEN_VIA=settings / history: rows
+// kept on the 3a-r8 build), where the bare window of upstream writes them off
+// (SessionService::CommitPendingCloses). chrome::OpenEmptyWindow(), not
+// NewEmptyWindow(): without the flag that one leaves the window to
+// SessionService::RestoreIfNecessary(no browser), which makes it once the
+// session file is read -- there is nothing to return, and the CHECK below
+// goes off.
+BrowserWindowInterface* CreateBrowser(Profile* profile,
+                                      bool with_last_session = false) {
   // Closes the first run if we open a new window.
   if (auto* fre_service =
           FirstRunServiceFactory::GetForBrowserContextIfExists(profile)) {
     fre_service->FinishFirstRunWithoutResumeTask();
   }
 
+  // An off-the-record window has no session (and NewEmptyWindow() knows when
+  // one is forced).
+  if (with_last_session && !profile->IsOffTheRecord() &&
+      !profile->IsGuestSession() &&
+      !IncognitoModePrefs::ShouldOpenSubsequentBrowsersInIncognito(
+          *base::CommandLine::ForCurrentProcess(), profile->GetPrefs())) {
+    if (BrowserWindowInterface* browser =
+            chrome::OpenEmptyWindow(profile->GetOriginalProfile())) {
+      return browser;
+    }
+  }
+
   {
     base::AutoReset<bool> auto_reset_in_run(&g_is_opening_new_window, true);
     chrome::NewEmptyWindow(profile);
@@ -258,6 +285,40 @@
   return browser;
 }
 
+// helium-fork 3a-r8 (user 2026-09-20 #5 / #6: "当 app 窗口关了之后，所有 space
+// 之前开过的标签页状态也全都重启。新打开 App 窗口之后，就按用户设置中的启动页来显示"
+// ... "只要App重启或者App窗口关掉，只对用户设置中的启动页那一项负责"): the first
+// window after the last one was closed -- the Dock icon, Cmd+N, Cmd+T -- comes
+// up the way a launch does. Upstream gives it a bare new window
+// (CreateBrowser: SessionService::ShouldRestore() stands down while
+// g_is_opening_new_window is set), which here meant: whatever the startup
+// setting, a New Tab page; and the sidebar's Today rows -- they live in the
+// session (StartupBrowserCreatorImpl::DetermineBrowserOpenBehavior) -- gone
+// from every space, the closed window being written off the moment another
+// one opens (SessionService::CommitPendingCloses). This is the road a second
+// launch of the binary already takes (StartupBrowserCreatorImpl::
+// MaybeAsyncRestore): the session comes back, every row asleep, under what
+// the startup setting asks for. With a tabbed window still open, or for an
+// off-the-record profile, there is nothing to bring back and the window is
+// the bare one, as before.
+void OpenFirstWindow(Profile* profile) {
+  if (profile->IsOffTheRecord() || profile->IsGuestSession() ||
+      ProfileBrowserCollection::GetForProfile(profile)->FindTabbedBrowser()) {
+    CreateBrowser(profile);
+    return;
+  }
+  if (auto* fre_service =
+          FirstRunServiceFactory::GetForBrowserContextIfExists(profile)) {
+    fre_service->FinishFirstRunWithoutResumeTask();
+  }
+  StartupBrowserCreator browser_creator;
+  browser_creator.LaunchBrowser(*base::CommandLine::ForCurrentProcess(),
+                                profile, base::FilePath(),
+                                chrome::startup::IsProcessStartup::kNo,
+                                chrome::startup::IsFirstRun::kNo,
+                                /*restore_tabbed_browser=*/true);
+}
+
 // Activates a browser window having the given profile (the last one active) if
 // possible or creates an empty one if necessary. Returns a pointer to the
 // activated/new |BrowserWindowInterface|.
@@ -265,7 +326,7 @@
   if (BrowserWindowInterface* browser = ActivateBrowser(profile)) {
     return browser;
   }
-  return CreateBrowser(profile);
+  return CreateBrowser(profile, /*with_last_session=*/true);  // helium-fork
 }
 
 // Attempts restoring a previous session if there is one. Otherwise, opens
@@ -1751,7 +1812,7 @@
