+std::string WorkspaceTabController::RestoredWindowLandingSpace() const {
+  TabStripModel* const model = browser_window_->GetTabStripModel();
+  std::string landing = current_space_id_;
+  if (!model) {
+    return landing;
+  }
+  bool current_has_own_tab = false;
+  for (const tabs::TabHandle& handle : session_spaced_tabs_) {
+    if (handle.Get() && service_->GetSpaceForTab(handle) == current_space_id_) {
+      current_has_own_tab = true;
+      break;
+    }
+  }
+  if (!current_has_own_tab) {
+    for (int i = 0; i < model->count(); ++i) {
+      tabs::TabInterface* const tab = model->GetTabAtIndex(i);
+      if (!tab ||
+          !std::ranges::contains(session_spaced_tabs_, tab->GetHandle())) {
+        continue;
+      }
+      const std::string space = service_->GetSpaceForTab(tab->GetHandle());
+      if (space.empty() || space == kGlobalSpaceId ||
+          !service_->FindSpaceById(space)) {
+        continue;
+      }
+      landing = space;
+      break;
+    }
+  }
+  return landing;
+}
