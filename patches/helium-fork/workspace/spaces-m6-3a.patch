+void TabCollectionAnimatingLayoutManager::StartRun() {
+  if (!in_place_motion_) {
+    animation_.Show();
+    return;
+  }
+  start_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&TabCollectionAnimatingLayoutManager::StartPendingRun,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void TabCollectionAnimatingLayoutManager::StartPendingRun() {
+  if (!start_pending_) {
+    return;  // Snapped to the target meanwhile.
+  }
+  start_pending_ = false;
+  animation_.Show();
+}
