+  const helium_workspace::WorkspaceEntry* folder =
+      service_->FindEntryById(folder_id);
+  if (!folder || !folder->is_folder()) {
+    return;
+  }
+  // 3a-r1 (user 2026-09-18): always asked, empty folder included -- unlike
+  // Delete there is no undo bar afterwards, and even an empty folder makes a
+  // space and takes the window there. Same dialog shape as the delete one:
+  // Cancel on ESC, the confirming button as the ⏎ default. The id travels by
+  // value: |folder_id| lives in the row, and the conversion rebuilds the rows.
+  auto run_convert = base::BindOnce(
+      [](BrowserWindowInterface* browser, const std::string& folder_id) {
+        if (auto* controller =
+                helium_workspace::WorkspaceTabController::From(browser)) {
+          controller->TurnFolderIntoSpace(folder_id);
+        }
+      },
+      base::Unretained(browser), folder_id);
+  ui::DialogModel::Builder builder;
+  builder
+      .SetTitle(l10n_util::GetStringFUTF16(IDS_HELIUM_WS_TURN_INTO_SPACE_TITLE,
+                                           folder->title))
+      .AddParagraph(ui::DialogModelLabel(
+          l10n_util::GetStringUTF16(IDS_HELIUM_WS_TURN_INTO_SPACE_BODY)))
+      .AddOkButton(
+          std::move(run_convert),
+          ui::DialogModel::Button::Params()
+              .SetLabel(l10n_util::GetStringUTF16(
+                  IDS_HELIUM_WS_TURN_INTO_SPACE_CONFIRM))
+              .SetStyle(ui::ButtonStyle::kProminent))
+      .AddCancelButton(base::DoNothing());
+  constrained_window::ShowBrowserModal(builder.Build(),
+                                       GetWidget()->GetNativeWindow());
+}
