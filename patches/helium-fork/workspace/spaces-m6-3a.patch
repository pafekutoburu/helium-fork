+void WorkspaceEntryDragOverlay::SetDownFlight(WhereCallback where,
+                                              base::OnceClosure done) {
+  FinishSetDown();
+  set_down_done_ = std::move(done);
+  if (!in_flight() || where.is_null()) {
+    Stop();
+    return;
+  }
+  set_down_where_ = std::move(where);
+  set_down_animation_.Reset(0.0);
+  set_down_animation_.Show();
+}
+
+void WorkspaceEntryDragOverlay::FinishSetDown() {
+  set_down_where_.Reset();
+  set_down_animation_.Reset(0.0);
+  if (set_down_done_) {
+    std::move(set_down_done_).Run();
+  }
+}
