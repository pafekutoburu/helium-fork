+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/image/canvas_image_source.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/paint_vector_icon.h"
+#include "ui/native_theme/native_theme.h"
+
+namespace {
+
+// The bar's icon slot at menu size.
+constexpr int kIconSize = 16;
+constexpr int kEmojiFontSize = 13;
+// A space without an icon is the bar's 8pt dot.
+constexpr float kDotRadius = 4.0f;
+
+// A space's icon the way the bottom bar draws it, as a plain image: the Mac's
+// native context menus show neither vector icons (outside the new icon
+// scheme) nor generated images (ui/menus/cocoa/menu_controller.mm), and an
+// emoji typed into the label would start where the other rows' names do.
+class SpaceIconSource : public gfx::CanvasImageSource {
+ public:
+  SpaceIconSource(std::string icon, SkColor color)
+      : gfx::CanvasImageSource(gfx::Size(kIconSize, kIconSize)),
+        icon_(std::move(icon)),
+        color_(color) {}
+
+  // gfx::CanvasImageSource:
+  void Draw(gfx::Canvas* canvas) override {
+    if (icon_.empty()) {
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(color_);
+      canvas->DrawCircle(gfx::PointF(kIconSize / 2.0f, kIconSize / 2.0f),
+                         kDotRadius, flags);
+      return;
+    }
+    canvas->DrawStringRectWithFlags(
+        base::UTF8ToUTF16(icon_),
+        gfx::FontList().DeriveWithSizeDelta(kEmojiFontSize -
+                                            gfx::FontList().GetFontSize()),
+        color_, gfx::Rect(kIconSize, kIconSize),
+        gfx::Canvas::TEXT_ALIGN_CENTER | gfx::Canvas::NO_SUBPIXEL_RENDERING);
+  }
+
+ private:
+  const std::string icon_;
+  const SkColor color_;
+};
+
+ui::ImageModel SpaceMenuIcon(const std::string& icon) {
+  // The menu is built when it opens, so the theme read here is the one it
+  // shows in.
+  const bool dark = ui::NativeTheme::GetInstanceForNativeUi()
+                        ->preferred_color_scheme() ==
+                    ui::NativeTheme::PreferredColorScheme::kDark;
+  const SkColor color =
+      dark ? SkColorSetRGB(0xC4, 0xC7, 0xC5) : SkColorSetRGB(0x5F, 0x63, 0x68);
+  if (helium_workspace::IsVectorIconRef(icon)) {
+    if (const gfx::VectorIcon* vector =
+            FindSpaceVectorIcon(helium_workspace::VectorIconRefName(icon))) {
+      return ui::ImageModel::FromImageSkia(
+          gfx::CreateVectorIcon(*vector, kIconSize, color));
+    }
+    return ui::ImageModel::FromImageSkia(
+        gfx::CanvasImageSource::MakeImageSkia<SpaceIconSource>(std::string(),
+                                                               color));
+  }
+  return ui::ImageModel::FromImageSkia(
+      gfx::CanvasImageSource::MakeImageSkia<SpaceIconSource>(icon, color));
+}
+
+}  // namespace
+
+WorkspaceMoveToSpaceMenuModel::WorkspaceMoveToSpaceMenuModel(
+    const std::vector<helium_workspace::WorkspaceSpace>& spaces,
+    const std::string& owner_space_id,
+    ChoiceCallback on_choice)
+    : ui::SimpleMenuModel(this),
+      owner_space_id_(owner_space_id),
+      on_choice_(std::move(on_choice)) {
+  for (const helium_workspace::WorkspaceSpace& space : spaces) {
+    space_ids_.push_back(space.id);
+  }
+  int command_id = 0;
+  for (const helium::EntryMenuItem& item :
+       helium::BuildMoveToSubmenu(space_ids_, owner_space_id_)) {
+    ++command_id;
+    if (item.separator_before) {
+      AddSeparator(ui::NORMAL_SEPARATOR);
+    }
+    if (item.id == helium::EntryMenuItemId::kMoveToNewSpace) {
+      AddItemWithStringId(command_id,
+                          IDS_HELIUM_WS_ENTRY_MENU_MOVE_TO_NEW_SPACE);
+      continue;
+    }
+    const helium_workspace::WorkspaceSpace& space = spaces[command_id - 1];
+    AddCheckItem(command_id, space.name);
+    SetIcon(GetItemCount() - 1, SpaceMenuIcon(space.icon));
+  }
+}
+
+WorkspaceMoveToSpaceMenuModel::~WorkspaceMoveToSpaceMenuModel() = default;
+
+bool WorkspaceMoveToSpaceMenuModel::IsCommandIdChecked(int command_id) const {
+  const size_t index = static_cast<size_t>(command_id - 1);
+  return index < space_ids_.size() && space_ids_[index] == owner_space_id_;
+}
+
+void WorkspaceMoveToSpaceMenuModel::ExecuteCommand(int command_id,
+                                                   int event_flags) {
+  const size_t index = static_cast<size_t>(command_id - 1);
+  // Locals: moving a row rebuilds the sidebar, which can take the row that
+  // owns this model -- and the model -- down inside the callback.
+  const std::string choice =
+      index < space_ids_.size() ? space_ids_[index] : std::string();
+  const ChoiceCallback on_choice = on_choice_;
+  on_choice.Run(choice);
+}
