===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_entry_menu.h
@@ -0,0 +1,247 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_ENTRY_MENU_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_ENTRY_MENU_H_
+
+#include <string>
+#include <utility>
+#include <vector>
+
+// helium-fork M6 轮3 3a: the *shape* of the sidebar's right-click menus -- a
+// pinned row, a favorite tile, a row inside a folder, a folder's head row --
+// as a pure function of plain state, so that the order, the separators and
+// every enabled bit are unit-tested without a view.
+//
+// Arc's grouping (decisions.md 「M6 轮0」B, 2026-09-02, rows g11/g9/g12):
+//   Copy Link / Share >
+//   Change Icon... / Rename... / Mute / Customize Page... / Edit Pinned Page >
+//   Open in Split View / Duplicate / Move to >
+//   Remove Pin                      (a tile: Remove Favorite)
+// Ours keeps that skeleton. Share, Customize Page and Split View have no
+// mechanism here and are left out (same section, C.3). Three items are our
+// own and stay (decisions.md 「M6 轮3」③): Open takes the Split View slot,
+// Back to Pinned URL (user 2026-08-23) sits next to its inverse, Replace,
+// and the Favorites toggle closes the third group. Change Icon... and
+// Rename... arrive with 3b; |include_3b| reserves their slots.
+//
+// Header-only and free of //ui/views and grit on purpose, like every other
+// arc_*.h: asserted in helium_workspace_unittests. The views side
+// (WorkspaceEntryMenuModel) maps labels to strings and runs the commands.
+namespace helium {
+
+enum class EntryMenuItemId {
+  kCopyLink = 1,
+  kChangeIcon,  // 3b
+  kRename,      // 3b on a row; the folder head row has had it since M3.13
+  kToggleMute,
+  kBackToPinnedUrl,
+  kEditPinnedPage,  // submenu: kReplacePinnedUrl, kEditUrl
+  kReplacePinnedUrl,
+  kEditUrl,
+  kOpen,
+  kDuplicate,
+  kMoveTo,          // submenu: kMoveToSpace..., kMoveToNewSpace
+  kMoveToSpace,     // |space_id| says which
+  kMoveToNewSpace,
+  kToggleFavorite,
+  kRemove,
+  // The folder head row.
+  kTurnIntoSpace,
+  kCopyAllLinks,
+  kDeleteFolder,
+};
+
+// What an item reads. One id can read two ways (Mute / Unmute), so the label
+// is part of the shape; kSpaceName is filled in by the views side from
+// |space_id|.
+enum class EntryMenuLabel {
+  kCopyLink,
+  kChangeIcon,
+  kRename,
+  kMute,
+  kUnmute,
+  kBackToPinnedUrl,
+  kEditPinnedPage,
+  kReplacePinnedUrl,
+  kEditUrl,
+  kOpen,
+  kDuplicate,
+  kMoveTo,
+  kSpaceName,
+  kNewSpace,
+  kAddToFavorites,
+  // A tile's way back to the pinned rows. Not "Remove from Favorites": that
+  // reads like Arc's Remove Favorite, which deletes.
+  kMoveToPinnedTabs,
+  kRemovePin,
+  kRemoveFavorite,
+  kTurnIntoSpace,
+  kCopyAllLinks,
+  kDeleteFolder,
+};
+
+struct EntryMenuItem {
+  EntryMenuItemId id;
+  EntryMenuLabel label;
+  bool enabled = true;
+  // Move to: the space the row is already in.
+  bool checked = false;
+  // Copy Link: show the page-URL shortcut next to it (Arc shows ⇧⌘C on a row
+  // whose tab is open, g9/g13c/g15).
+  bool show_accelerator = false;
+  bool separator_before = false;
+  std::string space_id;
+  std::vector<EntryMenuItem> submenu;
+};
+
+struct EntryMenuState {
+  // A favorite tile rather than a row.
+  bool is_tile = false;
+  // A tab is open for the entry.
+  bool bound = false;
+  // ... and it has left the pinned URL.
+  bool drifted = false;
+  bool audible = false;
+  bool muted = false;
+  // The Favorites grid has room and the entry may go there (a row only).
+  bool can_become_favorite = true;
+  // The grid is at its cap, so a tile cannot be duplicated.
+  bool favorites_full = false;
+  // The copy-page-URL shortcut is bound and means "copy" (not "inspect").
+  bool copy_shortcut_live = false;
+  bool include_3b = false;
+  // Bar order.
+  std::vector<std::string> space_ids;
+  // The space the entry is in.
+  std::string owner_space_id;
+};
+
+// Spaces in bar order with the owner checked -- choosing it is a no-op, the
+// item stays enabled the way Arc's does -- then New Space...
+inline std::vector<EntryMenuItem> BuildMoveToSubmenu(
+    const std::vector<std::string>& space_ids,
+    const std::string& owner_space_id) {
+  std::vector<EntryMenuItem> items;
+  for (const std::string& id : space_ids) {
+    EntryMenuItem item{EntryMenuItemId::kMoveToSpace,
+                       EntryMenuLabel::kSpaceName};
+    item.checked = id == owner_space_id;
+    item.space_id = id;
+    items.push_back(std::move(item));
+  }
+  EntryMenuItem new_space{EntryMenuItemId::kMoveToNewSpace,
+                          EntryMenuLabel::kNewSpace};
+  new_space.separator_before = !items.empty();
+  items.push_back(std::move(new_space));
+  return items;
+}
+
+inline std::vector<EntryMenuItem> BuildEntryMenu(const EntryMenuState& s) {
+  std::vector<EntryMenuItem> items;
+  const auto add = [&items](EntryMenuItemId id, EntryMenuLabel label,
+                            bool enabled = true) -> EntryMenuItem& {
+    EntryMenuItem item{id, label};
+    item.enabled = enabled;
+    items.push_back(std::move(item));
+    return items.back();
+  };
+
+  // The item copies the pinned URL and the shortcut copies the page's, so
+  // the hint would lie on a drifted row.
+  add(EntryMenuItemId::kCopyLink, EntryMenuLabel::kCopyLink).show_accelerator =
+      s.bound && !s.drifted && s.copy_shortcut_live;
+
+  const size_t second_group = items.size();
+  if (s.include_3b) {
+    add(EntryMenuItemId::kChangeIcon, EntryMenuLabel::kChangeIcon);
+    add(EntryMenuItemId::kRename, EntryMenuLabel::kRename);
+  }
+  // Arc greys Mute on a silent page (g17) and flips it to Unmute (g16).
+  add(EntryMenuItemId::kToggleMute,
+      s.muted ? EntryMenuLabel::kUnmute : EntryMenuLabel::kMute,
+      s.bound && (s.audible || s.muted));
+  // A tile has no drift marker, so it has no way back either (M3.10).
+  if (!s.is_tile) {
+    add(EntryMenuItemId::kBackToPinnedUrl, EntryMenuLabel::kBackToPinnedUrl,
+        s.bound && s.drifted);
+  }
+  EntryMenuItem& edit =
+      add(EntryMenuItemId::kEditPinnedPage, EntryMenuLabel::kEditPinnedPage);
+  edit.submenu.push_back({EntryMenuItemId::kReplacePinnedUrl,
+                          EntryMenuLabel::kReplacePinnedUrl,
+                          /*enabled=*/s.bound && s.drifted});
+  edit.submenu.push_back(
+      {EntryMenuItemId::kEditUrl, EntryMenuLabel::kEditUrl});
+  items[second_group].separator_before = true;
+
+  add(EntryMenuItemId::kOpen, EntryMenuLabel::kOpen).separator_before = true;
+  add(EntryMenuItemId::kDuplicate, EntryMenuLabel::kDuplicate,
+      !(s.is_tile && s.favorites_full));
+  // Favorites are the same in every space (Arc g1), so a tile has nowhere to
+  // move to; Arc's own tile submenu is profiles only (g12).
+  if (!s.is_tile) {
+    add(EntryMenuItemId::kMoveTo, EntryMenuLabel::kMoveTo).submenu =
+        BuildMoveToSubmenu(s.space_ids, s.owner_space_id);
+  }
+  add(EntryMenuItemId::kToggleFavorite,
+      s.is_tile ? EntryMenuLabel::kMoveToPinnedTabs
+                : EntryMenuLabel::kAddToFavorites,
+      s.is_tile || s.can_become_favorite);
+
+  add(EntryMenuItemId::kRemove,
+      s.is_tile ? EntryMenuLabel::kRemoveFavorite : EntryMenuLabel::kRemovePin)
+      .separator_before = true;
+  return items;
+}
+
+// Arc's folder menu (g11/g17): Share Folder... | New Nested Folder... / Turn
+// "x" into Space / Copy All Links | Change Icon... / Rename... | Duplicate /
+// Move to > | Delete. Folders are one level here and the user left Share and
+// Duplicate out (decisions.md 「M6 轮3」①).
+inline std::vector<EntryMenuItem> BuildFolderMenu(
+    bool has_children,
+    bool include_3b,
+    const std::vector<std::string>& space_ids,
+    const std::string& owner_space_id) {
+  std::vector<EntryMenuItem> items;
+  items.push_back(
+      {EntryMenuItemId::kTurnIntoSpace, EntryMenuLabel::kTurnIntoSpace});
+  items.push_back({EntryMenuItemId::kCopyAllLinks,
+                   EntryMenuLabel::kCopyAllLinks, /*enabled=*/has_children});
+  const size_t second_group = items.size();
+  if (include_3b) {
+    items.push_back(
+        {EntryMenuItemId::kChangeIcon, EntryMenuLabel::kChangeIcon});
+  }
+  items.push_back({EntryMenuItemId::kRename, EntryMenuLabel::kRename});
+  items[second_group].separator_before = true;
+
+  EntryMenuItem move_to{EntryMenuItemId::kMoveTo, EntryMenuLabel::kMoveTo};
+  move_to.separator_before = true;
+  move_to.submenu = BuildMoveToSubmenu(space_ids, owner_space_id);
+  items.push_back(std::move(move_to));
+
+  EntryMenuItem del{EntryMenuItemId::kDeleteFolder,
+                    EntryMenuLabel::kDeleteFolder};
+  del.separator_before = true;
+  items.push_back(std::move(del));
+  return items;
+}
+
+// Copy All Links: one URL per line, in the order the rows show.
+inline std::string JoinFolderLinks(const std::vector<std::string>& urls) {
+  std::string joined;
+  for (const std::string& url : urls) {
+    if (!joined.empty()) {
+      joined += '\n';
+    }
+    joined += url;
+  }
+  return joined;
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_ENTRY_MENU_H_
