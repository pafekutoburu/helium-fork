+  const std::string id = entry_id;
+  const std::string target = space_id;
+  if (auto* controller =
+          helium_workspace::WorkspaceTabController::From(GetBrowserWindow())) {
+    if (target.empty()) {
+      controller->RequestNewSpaceForEntryMove(id);
+    } else {
+      controller->MoveEntryToSpace(id, target);
