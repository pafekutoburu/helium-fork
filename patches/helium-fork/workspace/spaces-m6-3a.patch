+gfx::ImageSkia WorkspaceSidebarView::CaptureEntryRowImage(
+    const std::string& entry_id) {
+  const auto it = entry_views_.find(entry_id);
+  const ui::Compositor* const compositor =
+      GetWidget() ? GetWidget()->GetCompositor() : nullptr;
+  if (it == entry_views_.end() || !compositor) {
+    return gfx::ImageSkia();
+  }
+  WorkspaceEntryView* const view = it->second.get();
+  if (view->bounds().IsEmpty()) {
+    return gfx::ImageSkia();
+  }
+  const gfx::Size size =
+      view->renders_as_capsule()
+          ? gfx::Size(TopLevelRowWidth(),
+                      GetLayoutConstant(LayoutConstant::kVerticalTabHeight))
+          : view->size();
+  std::vector<gfx::ImageSkia> images = CaptureEntryAsRow(view, {size});
+  return images.empty() ? gfx::ImageSkia() : images.front();
+}
