+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_TAB_CONTROLLER_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_TAB_CONTROLLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+
+class BrowserWindowInterface;
+
+namespace helium_workspace {
+
+class WorkspaceService;
+
+// Per-window behavior of the workspace sidebar entries (Arc pinned-tab
+// semantics):
+//   - Cmd+D toggles the active tab between a plain tab and a workspace
+//     Pinned entry (IDC_HELIUM_WS_TOGGLE_PIN).
+//   - Cmd+W on an entry's tab unloads it (discard) instead of closing;
+//     the entry survives and the next activation returns to the entry URL.
+//   - Entry tabs closed through any other path are re-created as background
+//     discarded pinned tabs, upholding the invariant that every entry is
+//     backed by a real pinned tab.
+//   - Native pin/unpin (context menu, dragging across the pinned boundary)
+//     is kept in sync with the entry model in both directions.
+class WorkspaceTabController : public TabStripModelObserver {
+ public:
+  DECLARE_USER_DATA(WorkspaceTabController);
+
+  WorkspaceTabController(BrowserWindowInterface* browser_window,
+                         WorkspaceService* service);
+  WorkspaceTabController(const WorkspaceTabController&) = delete;
+  WorkspaceTabController& operator=(const WorkspaceTabController&) = delete;
+  ~WorkspaceTabController() override;
+
+  static WorkspaceTabController* From(BrowserWindowInterface* browser_window);
+
+  // IDC_HELIUM_WS_TOGGLE_PIN. No-op on non-tab windows.
+  void TogglePinActiveTab();
+
+  // Returns true if Cmd+W was consumed (active tab is a workspace entry and
+  // was unloaded instead of closed).
+  static bool MaybeHandleCloseTab(BrowserWindowInterface* browser_window);
+
+ private:
+  bool UnloadActiveWorkspaceTab();
+  // Ensures the active tab is not |index| by activating a reasonable
+  // neighbor (first non-pinned tab, or a fresh NTP when there is none).
+  void DeactivateTabAt(int index);
+  // Re-creates |entry_id|'s backing tab as a background discarded pinned
+  // tab. Posted (never called re-entrantly) because TabStripModel forbids
+  // mutation from within observer notifications.
+  void RecreateEntryTab(const std::string& entry_id);
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+
+  const raw_ptr<BrowserWindowInterface> browser_window_;
+  const raw_ptr<WorkspaceService> service_;
+  // Re-entrancy guard for model mutations we perform ourselves (pin/unpin,
+  // re-creation) so the observer hooks do not feed back.
+  bool in_self_mutation_ = false;
+
+  ui::ScopedUnownedUserData<WorkspaceTabController> scoped_unowned_user_data_;
+  base::WeakPtrFactory<WorkspaceTabController> weak_factory_{this};
+};
+
+}  // namespace helium_workspace
