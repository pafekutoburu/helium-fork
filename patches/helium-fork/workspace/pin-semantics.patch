+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_TAB_CONTROLLER_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_TAB_CONTROLLER_H_
+
+#include <map>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/base/models/image_model.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+
+class BrowserWindowInterface;
+
+namespace helium_workspace {
+
+class WorkspaceService;
+
+// Per-window half of the workspace sidebar. Entries themselves are profile
+// data owned by WorkspaceService; this class is what turns them into tabs in
+// one particular window, and what keeps that window's tab strip in the shape
+// the sidebar assumes:
+//   - Cmd+D toggles the active tab between a plain tab and a Pinned entry
+//     (IDC_HELIUM_WS_TOGGLE_PIN). It does not pin anything natively.
+//   - Clicking a sidebar entry activates this window's tab for it, or opens
+//     an ordinary foreground tab at the entry URL and binds it.
+//   - On window creation, tabs restored at an entry's URL are adopted so the
+//     sidebar shows them instead of Today showing them twice.
+//   - Title and favicon are written back to the entry as its tab navigates,
+//     so an entry with no tab can still be drawn after a cold start.
+//   - Any tab that becomes natively pinned is un-pinned again and recorded
+//     as an entry instead. The pinned region must stay empty: it is what
+//     makes TabStripModel::empty() -- and therefore "closing the last tab
+//     closes the window" -- correct.
+class WorkspaceTabController : public TabStripModelObserver {
+ public:
+  DECLARE_USER_DATA(WorkspaceTabController);
+
+  WorkspaceTabController(BrowserWindowInterface* browser_window,
+                         WorkspaceService* service);
+  WorkspaceTabController(const WorkspaceTabController&) = delete;
+  WorkspaceTabController& operator=(const WorkspaceTabController&) = delete;
+  ~WorkspaceTabController() override;
+
+  static WorkspaceTabController* From(BrowserWindowInterface* browser_window);
+
+  // IDC_HELIUM_WS_TOGGLE_PIN. No-op on non-tab windows.
+  void TogglePinActiveTab();
+
+  // Activates this window's tab for |entry_id|, or opens one at the entry
+  // URL. Each window keeps its own tab for an entry.
+  void OpenEntry(const std::string& entry_id);
+
+ private:
+  // Binds tabs already open in this window to entries with the same URL, so
+  // a restored session does not show the same page twice.
+  void AdoptTabsInWindow();
+  // Posted from OnTabPinnedStateChanged(); see the class comment.
+  void UnpinTab(tabs::TabHandle handle);
+
+  // Binds |tab| to |entry_id| and takes its icon right away. Every binding
+  // goes through here: an icon captured only on the next change notification
+  // leaves the entry blank in any other window until the page happens to
+  // navigate again.
+  void BindTabToEntry(tabs::TabInterface* tab, const std::string& entry_id);
+  // Writes |tab|'s current favicon onto its entry, if it has one. Safe to
+  // call at any time; a tab with no icon yet leaves the entry untouched.
+  void CaptureFavicon(tabs::TabInterface* tab, const std::string& entry_id);
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      int index,
+                      TabChangeType change_type) override;
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+
+  const raw_ptr<BrowserWindowInterface> browser_window_;
+  const raw_ptr<WorkspaceService> service_;
+  // Re-entrancy guard for the un-pin we perform ourselves, so it does not
+  // feed back into OnTabPinnedStateChanged().
+  bool suppress_pin_observer_ = false;
+  // Set immediately before chrome::AddAndReturnTabAt() so the kInserted
+  // notification -- which that call fires synchronously, before returning --
+  // can bind the new tab. Binding after the call instead would leave the tab
+  // unbound for a frame, and it would flash into the Today section.
+  std::string pending_bind_entry_id_;
+  // Last favicon written back per bound tab, so navigation only pays for PNG
+  // encoding when the icon actually changed rather than on every title tick.
+  std::map<tabs::TabHandle, ui::ImageModel> last_favicon_;
+
+  ui::ScopedUnownedUserData<WorkspaceTabController> scoped_unowned_user_data_;
+  base::WeakPtrFactory<WorkspaceTabController> weak_factory_{this};
+};
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_TAB_CONTROLLER_H_
