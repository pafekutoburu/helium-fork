+#include "chrome/browser/ui/helium_workspace/workspace_tab_controller.h"
+
+#include <string>
+#include <vector>
+
+#include "base/auto_reset.h"
+#include "base/functional/bind.h"
+#include "base/containers/span.h"
+#include "base/strings/string_view_util.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/tab_list/tab_removed_reason.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/helium_workspace/workspace_entry.h"
+#include "chrome/browser/ui/helium_workspace/workspace_favicon.h"
+#include "chrome/browser/ui/helium_workspace/workspace_service.h"
+#include "chrome/browser/ui/tabs/tab_data.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_user_gesture_details.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/gfx/codec/png_codec.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/image/image_skia_rep.h"
+
+namespace helium_workspace {
+
+namespace {
+
+// A stored favicon is only there to draw a 16x16 sidebar row on a cold
+// start. Anything larger is a page that served an oversized icon; skip it
+// rather than grow the pref by a screenshot.
+constexpr size_t kMaxFaviconBytes = 32 * 1024;
+
+}  // namespace
+
+DEFINE_USER_DATA(WorkspaceTabController);
+
+WorkspaceTabController::WorkspaceTabController(
+    BrowserWindowInterface* browser_window,
+    WorkspaceService* service)
+    : browser_window_(browser_window),
+      service_(service),
+      scoped_unowned_user_data_(browser_window->GetUnownedUserDataHost(),
+                                *this) {
+  if (TabStripModel* model = browser_window_->GetTabStripModel()) {
+    model->AddObserver(this);
+  }
+
+  // Deferred: BrowserWindowFeatures::Init() runs before this window's
+  // startup or session-restore tabs have been inserted, so there would be
+  // nothing to adopt yet.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspaceTabController::AdoptTabsInWindow,
+                                weak_factory_.GetWeakPtr()));
+}
+
+WorkspaceTabController::~WorkspaceTabController() {
+  if (TabStripModel* model = browser_window_->GetTabStripModel()) {
+    model->RemoveObserver(this);
+  }
+}
+
+// static
+WorkspaceTabController* WorkspaceTabController::From(
+    BrowserWindowInterface* browser_window) {
+  if (!browser_window) {
+    return nullptr;
+  }
+  return Get(browser_window->GetUnownedUserDataHost());
+}
+
+void WorkspaceTabController::TogglePinActiveTab() {
+  TabStripModel* model = browser_window_->GetTabStripModel();
+  if (!model || model->empty()) {
+    return;
+  }
+  tabs::TabInterface* tab = model->GetTabAtIndex(model->active_index());
+  if (!tab) {
+    return;
+  }
+  const tabs::TabHandle handle = tab->GetHandle();
+
+  const std::string entry_id = service_->FindEntryIdForTab(handle);
+  if (!entry_id.empty()) {
+    // Unpin: the entry disappears and the tab lives on as a plain Today tab.
+    service_->RemoveEntry(entry_id);
+    return;
+  }
+
+  const GURL url = tab->GetURL();
+  if (!url.is_valid()) {
+    return;
+  }
+  content::WebContents* contents = tab->GetContents();
+  const std::string id =
+      service_->AddEntry(WorkspaceEntry::Section::kPinned, url,
+                         contents ? contents->GetTitle() : std::u16string());
+  if (!id.empty()) {
+    BindTabToEntry(tab, id);
+  }
+}
+
+void WorkspaceTabController::OpenEntry(const std::string& entry_id) {
+  TabStripModel* model = browser_window_->GetTabStripModel();
+  if (!model) {
+    return;
+  }
+  const tabs::TabHandle bound =
+      service_->FindTabForEntryInWindow(entry_id, browser_window_);
+  if (tabs::TabInterface* tab = bound.Get()) {
+    const int index = model->GetIndexOfTab(tab);
+    if (index >= 0) {
+      model->ActivateTabAt(
+          index, TabStripUserGestureDetails(
+                     TabStripUserGestureDetails::GestureType::kOther));
+      return;
+    }
+  }
+
+  const WorkspaceEntry* entry = service_->FindEntryById(entry_id);
+  if (!entry) {
+    return;
+  }
+  // Appended, never positioned: an entry's tab is not drawn in Today, so its
+  // index is invisible and there is nothing to keep in order.
+  pending_bind_entry_id_ = entry_id;
+  chrome::AddAndReturnTabAt(browser_window_, entry->url, /*index=*/-1,
+                            /*foreground=*/true, /*group=*/std::nullopt,
+                            /*pinned=*/false);
+  pending_bind_entry_id_.clear();
+}
+
+void WorkspaceTabController::AdoptTabsInWindow() {
+  TabStripModel* model = browser_window_->GetTabStripModel();
+  if (!model) {
+    return;
+  }
+
+  std::vector<tabs::TabHandle> unclaimed;
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(i);
+    if (tab && !service_->IsWorkspaceTab(tab->GetHandle())) {
+      unclaimed.push_back(tab->GetHandle());
+    }
+  }
+
+  // Pass A -- exact URL. Runs over every entry before pass B starts, so an
+  // exact match always wins over a same-origin one.
+  std::erase_if(unclaimed, [&](tabs::TabHandle handle) {
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab) {
+      return true;
+    }
+    if (const WorkspaceEntry* entry = service_->FindEntryByUrlUnboundInWindow(
+            tab->GetURL(), browser_window_)) {
+      BindTabToEntry(tab, entry->id);
+      return true;
+    }
+    return false;
+  });
+
+  // Pass B -- same origin. An entry's URL is the one it was pinned at, and a
+  // restored tab is wherever the user left it, so exact matching misses the
+  // common case. The tab is left where it is; only the binding is restored.
+  for (tabs::TabHandle handle : unclaimed) {
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab) {
+      continue;
+    }
+    const GURL origin = tab->GetURL().DeprecatedGetOriginAsURL();
+    for (const WorkspaceEntry& entry : service_->entries()) {
+      if (entry.url.DeprecatedGetOriginAsURL() == origin &&
+          service_->FindTabForEntryInWindow(entry.id, browser_window_) ==
+              tabs::TabHandle::Null()) {
+        BindTabToEntry(tab, entry.id);
+        break;
+      }
+    }
+  }
+}
+
+void WorkspaceTabController::BindTabToEntry(tabs::TabInterface* tab,
+                                            const std::string& entry_id) {
+  if (!tab || entry_id.empty()) {
+    return;
+  }
+  service_->BindTab(tab->GetHandle(), entry_id);
+  CaptureFavicon(tab, entry_id);
+}
+
+void WorkspaceTabController::CaptureFavicon(tabs::TabInterface* tab,
+                                            const std::string& entry_id) {
+  // A tab that has not fetched an icon yet still reports one -- the
+  // placeholder globe -- and it passes IsImage(). Writing it would replace
+  // the entry's real icon with a globe, persistently, every time the entry
+  // was reopened. Only a favicon the site actually served may be stored.
+  if (!tab || entry_id.empty() || !TabHasRealFavicon(tab)) {
+    return;
+  }
+  const ui::ImageModel favicon =
+      tabs::TabData::FromTabInterface(tab).favicon;
+  if (!favicon.IsImage()) {
+    return;
+  }
+
+  // Store the densest representation the icon has rather than the 1x one.
+  // A sidebar row draws the icon at gfx::kFaviconSize dip, so a 16x16 bitmap
+  // is stretched to 32 physical pixels on a Retina display and looks soft.
+  // WorkspaceEntryView recovers the scale from the stored pixel width, so
+  // this needs no schema change.
+  const gfx::ImageSkia image = favicon.GetImage().AsImageSkia();
+  // image_reps() returns by value, so keep a copy: a pointer into that
+  // temporary vector dangles the moment the loop ends.
+  gfx::ImageSkiaRep best;
+  for (const gfx::ImageSkiaRep& rep : image.image_reps()) {
+    if (!rep.is_null() && (best.is_null() || rep.scale() > best.scale())) {
+      best = rep;
+    }
+  }
+  if (best.is_null()) {
+    return;
+  }
+  std::optional<std::vector<uint8_t>> png =
+      gfx::PNGCodec::EncodeBGRASkBitmap(best.GetBitmap(),
+                                        /*discard_transparency=*/false);
+  if (png && !png->empty() && png->size() <= kMaxFaviconBytes) {
+    service_->SetEntryFavicon(
+        entry_id, std::string(base::as_string_view(base::span(*png))));
+  }
+}
+
+void WorkspaceTabController::UnpinTab(tabs::TabHandle handle) {
+  tabs::TabInterface* tab = handle.Get();
+  TabStripModel* model = browser_window_->GetTabStripModel();
+  if (!tab || !model || model->closing_all()) {
+    return;
+  }
+  const int index = model->GetIndexOfTab(tab);
+  if (index < 0 || !model->IsTabPinned(index)) {
+    return;
+  }
+  base::AutoReset<bool> guard(&suppress_pin_observer_, true);
+  model->SetTabPinned(index, false);
+}
+
+void WorkspaceTabController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (change.type() == TabStripModelChange::kInserted) {
+    if (pending_bind_entry_id_.empty()) {
+      return;
+    }
+    for (const TabStripModelChange::ContentsWithIndex& inserted :
+         change.GetInsert()->contents) {
+      BindTabToEntry(inserted.tab, pending_bind_entry_id_);
+    }
+    pending_bind_entry_id_.clear();
+    return;
+  }
+
+  if (change.type() != TabStripModelChange::kRemoved) {
+    return;
+  }
+  // Closing an entry's tab just unbinds it. The entry stays in the sidebar,
+  // drawn from its persisted title and favicon, and clicking it opens the
+  // entry URL again.
+  for (const TabStripModelChange::RemovedTab& removed :
+       change.GetRemove()->contents) {
+    if (!TabRemoveReasonUtils::WillDeleteTab(removed.remove_reason)) {
+      continue;
+    }
+    const tabs::TabHandle handle = removed.tab->GetHandle();
+    // Do not read the tab here. By the time kRemoved arrives its TabUIHelper
+    // is already gone, and TabData::FromTabInterface() dereferences it. There
+    // is nothing to capture anyway: the icon a closing tab is showing is the
+    // one its last OnTabChangedAt already persisted.
+    last_favicon_.erase(handle);
+    service_->UnbindTab(handle);
+  }
+}
+
+void WorkspaceTabController::OnTabChangedAt(tabs::TabInterface* tab,
+                                            int index,
+                                            TabChangeType change_type) {
+  if (!tab || change_type != TabChangeType::kAll) {
+    return;
+  }
+  const tabs::TabHandle handle = tab->GetHandle();
+  const std::string entry_id = service_->FindEntryIdForTab(handle);
+  if (entry_id.empty()) {
+    return;
+  }
+
+  // The entry's URL stays the one it was pinned at, but its title and icon
+  // follow the page: an entry with no tab has to be recognisable after a
+  // restart, and the last thing the user saw is what they will recognise.
+  const tabs::TabData data = tabs::TabData::FromTabInterface(tab);
+  service_->SetEntryTitle(entry_id, data.title);
+
+  const auto it = last_favicon_.find(handle);
+  if (it != last_favicon_.end() && it->second == data.favicon) {
+    return;
+  }
+  last_favicon_[handle] = data.favicon;
+  CaptureFavicon(tab, entry_id);
+}
+
+void WorkspaceTabController::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                                     int index) {
+  TabStripModel* model = browser_window_->GetTabStripModel();
+  if (suppress_pin_observer_ || !tab || !model || !model->IsTabPinned(index)) {
+    return;
+  }
+  const tabs::TabHandle handle = tab->GetHandle();
+
+  // Something pinned a tab natively -- the context menu, an extension, a
+  // restored session. There is no view for a pinned tab any more (the
+  // sidebar draws entries, not the pinned collection), and a non-empty
+  // pinned region breaks TabStripModel::empty(). So record the intent as an
+  // entry and take the pin back.
+  //
+  // Recording runs synchronously because it touches no TabStripModel state;
+  // doing it in the posted task instead would leave a frame in which the tab
+  // is neither in the sidebar nor in Today.
+  if (service_->FindEntryIdForTab(handle).empty()) {
+    const GURL url = tab->GetURL();
+    if (url.is_valid()) {
+      if (const WorkspaceEntry* existing =
+              service_->FindEntryByUrlUnboundInWindow(url, browser_window_)) {
+        BindTabToEntry(tab, existing->id);
+      } else {
+        content::WebContents* contents = tab->GetContents();
+        const std::string id = service_->AddEntry(
+            WorkspaceEntry::Section::kPinned, url,
+            contents ? contents->GetTitle() : std::u16string());
+        if (!id.empty()) {
+          BindTabToEntry(tab, id);
+        }
+      }
+    }
+  }
+
+  // TabStripModel forbids re-entrant mutation from an observer callback.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&WorkspaceTabController::UnpinTab,
+                                weak_factory_.GetWeakPtr(), handle));
+}
+
+}  // namespace helium_workspace
