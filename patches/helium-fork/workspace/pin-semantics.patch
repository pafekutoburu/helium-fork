@@ -0,0 +1,293 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_tab_controller.h"
+
+#include <string>
+
+#include "base/auto_reset.h"
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_restore.h"
+#include "chrome/browser/tab_list/tab_removed_reason.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/helium_workspace/workspace_entry.h"
+#include "chrome/browser/ui/helium_workspace/workspace_service.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_user_gesture_details.h"
+#include "chrome/common/webui_url_constants.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+
+namespace helium_workspace {
+
+DEFINE_USER_DATA(WorkspaceTabController);
+
+WorkspaceTabController::WorkspaceTabController(
+    BrowserWindowInterface* browser_window,
+    WorkspaceService* service)
+    : browser_window_(browser_window),
+      service_(service),
+      scoped_unowned_user_data_(browser_window->GetUnownedUserDataHost(),
+                                *this) {
+  if (TabStripModel* model = browser_window_->GetTabStripModel()) {
+    model->AddObserver(this);
+  }
+
+  // Fallback reconciliation for startups that do not go through session
+  // restore (fresh profile, "open the New Tab page" startup setting, ...).
+  // Deferred so Chromium's own startup tabs (including PinnedTabCodec ones)
+  // exist by the time it runs; the session-restore path is subscribed by the
+  // service itself.
+  Profile* profile = browser_window_->GetProfile();
+  if (!service_->reconciled() && !SessionRestore::IsRestoring(profile) &&
+      !browser_window_->CreatedBySessionRestore()) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::WeakPtr<WorkspaceTabController> self) {
+                         if (self) {
+                           self->service_->EnsureReconciled();
+                         }
+                       },
+                       weak_factory_.GetWeakPtr()));
+  }
+}
+
+WorkspaceTabController::~WorkspaceTabController() {
+  if (TabStripModel* model = browser_window_->GetTabStripModel()) {
+    model->RemoveObserver(this);
+  }
+}
+
+// static
+WorkspaceTabController* WorkspaceTabController::From(
+    BrowserWindowInterface* browser_window) {
+  if (!browser_window) {
+    return nullptr;
+  }
+  return Get(browser_window->GetUnownedUserDataHost());
+}
+
+void WorkspaceTabController::TogglePinActiveTab() {
+  TabStripModel* model = browser_window_->GetTabStripModel();
+  if (!model || model->empty()) {
+    return;
+  }
+  const int active_index = model->active_index();
+  tabs::TabInterface* tab = model->GetTabAtIndex(active_index);
+  if (!tab) {
+    return;
+  }
+  const tabs::TabHandle handle = tab->GetHandle();
+  base::AutoReset<bool> self_mutation(&in_self_mutation_, true);
+
+  const std::string entry_id = service_->FindEntryIdForTab(handle);
+  if (!entry_id.empty()) {
+    // Unpin: entry disappears, the tab lives on as a plain Today tab.
+    service_->RemoveEntry(entry_id);
+    if (model->IsTabPinned(active_index)) {
+      model->SetTabPinned(active_index, false);
+    }
+    return;
+  }
+
+  const GURL url = tab->GetURL();
+  if (!url.is_valid()) {
+    return;
+  }
+  content::WebContents* contents = tab->GetContents();
+  const std::string id =
+      service_->AddEntry(WorkspaceEntry::Section::kPinned, url,
+                         contents ? contents->GetTitle() : std::u16string());
+  if (id.empty()) {
+    return;
+  }
+  service_->BindTab(handle, id);
+  if (!model->IsTabPinned(active_index)) {
+    model->SetTabPinned(active_index, true);
+  }
+}
+
+// static
+bool WorkspaceTabController::MaybeHandleCloseTab(
+    BrowserWindowInterface* browser_window) {
+  WorkspaceTabController* controller = From(browser_window);
+  return controller && controller->UnloadActiveWorkspaceTab();
+}
+
+bool WorkspaceTabController::UnloadActiveWorkspaceTab() {
+  TabStripModel* model = browser_window_->GetTabStripModel();
+  if (!model || model->empty()) {
+    return false;
+  }
+  const int index = model->active_index();
+  tabs::TabInterface* tab = model->GetTabAtIndex(index);
+  if (!tab || !service_->IsWorkspaceTab(tab->GetHandle())) {
+    return false;
+  }
+  const tabs::TabHandle handle = tab->GetHandle();
+
+  // A foreground tab cannot be discarded; move the user somewhere sensible
+  // first (Arc: clearing a pinned tab lands you on the next Today tab).
+  DeactivateTabAt(index);
+
+  service_->MarkPendingReset(handle);
+  if (!WorkspaceService::DiscardTabForWorkspace(tab)) {
+    // Not eligible (audio, capture, ...): recreate as a fresh background
+    // discarded tab at the entry URL. This always unloads, at the cost of
+    // dropping that tab's history — same as Arc archiving it.
+    const std::string entry_id = service_->FindEntryIdForTab(handle);
+    const WorkspaceEntry* entry = service_->FindEntryById(entry_id);
+    if (!entry) {
+      return true;
+    }
+    const GURL entry_url = entry->url;
+    base::AutoReset<bool> self_mutation(&in_self_mutation_, true);
+    service_->UnbindTab(handle);
+    const int tab_index = model->GetIndexOfTab(tab);
+    if (tab_index >= 0) {
+      model->CloseWebContentsAt(tab_index, TabCloseTypes::CLOSE_NONE);
+    }
+    content::WebContents* new_contents = chrome::AddAndReturnTabAt(
+        browser_window_, entry_url, model->IndexOfFirstNonPinnedTab(),
+        /*foreground=*/false, /*group=*/std::nullopt, /*pinned=*/true);
+    if (new_contents) {
+      if (tabs::TabInterface* new_tab =
+              model->GetTabForWebContents(new_contents)) {
+        service_->BindTab(new_tab->GetHandle(), entry_id);
+        WorkspaceService::DiscardTabForWorkspace(new_tab);
+      }
+    }
+  }
+  return true;
+}
+
+void WorkspaceTabController::DeactivateTabAt(int index) {
+  TabStripModel* model = browser_window_->GetTabStripModel();
+  if (model->active_index() != index) {
+    return;
+  }
+  // Prefer the first unpinned (Today) tab.
+  const int first_unpinned = model->IndexOfFirstNonPinnedTab();
+  for (int i = first_unpinned; i < model->count(); ++i) {
+    if (i != index) {
+      model->ActivateTabAt(
+          i, TabStripUserGestureDetails(
+                 TabStripUserGestureDetails::GestureType::kOther));
+      return;
+    }
+  }
+  // No Today tab: open a fresh NTP in the foreground.
+  base::AutoReset<bool> self_mutation(&in_self_mutation_, true);
+  chrome::AddTabAt(browser_window_, GURL(chrome::kChromeUINewTabPageURL),
+                   /*index=*/-1, /*foreground=*/true);
+}
+
+void WorkspaceTabController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  // Reset-to-origin on activation. CHANGE_REASON_REPLACED activations are
+  // discard replacements (including our own unloads) — navigating there
+  // would defeat the unload, so they are skipped; the reset happens on the
+  // next real activation.
+  if (selection.active_tab_changed() && selection.new_tab &&
+      !(selection.reason & TabStripModelObserver::CHANGE_REASON_REPLACED)) {
+    tabs::TabInterface* tab = selection.new_tab;
+    const tabs::TabHandle handle = tab->GetHandle();
+    if (service_->TakePendingReset(handle)) {
+      const WorkspaceEntry* entry =
+          service_->FindEntryById(service_->FindEntryIdForTab(handle));
+      if (entry && tab->GetContents() && tab->GetURL() != entry->url) {
+        content::NavigationController::LoadURLParams params(entry->url);
+        params.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+        tab->GetContents()->GetController().LoadURLWithParams(params);
+      }
+    }
+  }
+
+  // Uphold the invariant when an entry's tab is destroyed through a path we
+  // do not control (context menu close, close-other-tabs, ...): re-create it
+  // as a background discarded pinned tab.
+  if (change.type() != TabStripModelChange::kRemoved || in_self_mutation_ ||
+      tab_strip_model->closing_all()) {
+    return;
+  }
+  for (const TabStripModelChange::RemovedTab& removed :
+       change.GetRemove()->contents) {
+    if (!TabRemoveReasonUtils::WillDeleteTab(removed.remove_reason)) {
+      continue;
+    }
+    const tabs::TabHandle handle = removed.tab->GetHandle();
+    const std::string entry_id = service_->FindEntryIdForTab(handle);
+    if (entry_id.empty()) {
+      continue;
+    }
+    service_->UnbindTab(handle);
+    // TabStripModel forbids re-entrant mutation from observer callbacks
+    // (see the guard CHECK in tab_strip_model.cc), so the re-creation is
+    // posted.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&WorkspaceTabController::RecreateEntryTab,
+                                  weak_factory_.GetWeakPtr(), entry_id));
+  }
+}
+
+void WorkspaceTabController::RecreateEntryTab(const std::string& entry_id) {
+  TabStripModel* model = browser_window_->GetTabStripModel();
+  if (!model || model->closing_all()) {
+    return;
+  }
+  const WorkspaceEntry* entry = service_->FindEntryById(entry_id);
+  if (!entry ||
+      service_->FindTabForEntry(entry_id) != tabs::TabHandle::Null()) {
+    return;
+  }
+  base::AutoReset<bool> self_mutation(&in_self_mutation_, true);
+  content::WebContents* new_contents = chrome::AddAndReturnTabAt(
+      browser_window_, entry->url, model->IndexOfFirstNonPinnedTab(),
+      /*foreground=*/false, /*group=*/std::nullopt, /*pinned=*/true);
+  if (!new_contents) {
+    return;
+  }
+  if (tabs::TabInterface* new_tab = model->GetTabForWebContents(new_contents)) {
+    service_->BindTab(new_tab->GetHandle(), entry_id);
+    WorkspaceService::DiscardTabForWorkspace(new_tab);
+  }
+}
+
+void WorkspaceTabController::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                                     int index) {
+  if (in_self_mutation_ || !tab) {
+    return;
+  }
+  TabStripModel* model = browser_window_->GetTabStripModel();
+  const tabs::TabHandle handle = tab->GetHandle();
+  const bool pinned = model->IsTabPinned(index);
+  const std::string entry_id = service_->FindEntryIdForTab(handle);
+
+  if (pinned && entry_id.empty()) {
+    // Native pin (context menu / drag into the pinned zone) — record an
+    // entry so native pinning and Cmd+D mean the same thing.
+    const GURL url = tab->GetURL();
+    if (!url.is_valid()) {
+      return;
+    }
+    content::WebContents* contents = tab->GetContents();
+    const std::string id =
+        service_->AddEntry(WorkspaceEntry::Section::kPinned, url,
+                           contents ? contents->GetTitle() : std::u16string());
+    if (!id.empty()) {
+      service_->BindTab(handle, id);
+    }
+  } else if (!pinned && !entry_id.empty()) {
+    // Native unpin — the entry goes away, tab becomes a plain Today tab.
+    service_->RemoveEntry(entry_id);
+  }
+}
+
+}  // namespace helium_workspace
