+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_SERVICE_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_SERVICE_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/helium_workspace/workspace_entry.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/tabs/public/tab_interface.h"
+
+class BrowserWindowInterface;
+class GURL;
+class PrefService;
+
+namespace helium_workspace {
+
+// Profile-scoped model of the workspace sidebar: the persistent
+// Favorites/Pinned entries plus their runtime binding to live tabs.
+//
+// Entries are data, not tabs. An entry exists whether or not anything is
+// open for it; clicking one opens an ordinary (unpinned) tab, and closing
+// that tab leaves the entry behind. Because the sidebar is profile-scoped
+// while tabs are per-window, one entry may be bound to several tabs at once
+// -- at most one per window -- so lookups that care about a specific window
+// must say so.
+//
+// Nothing here pins a tab. The pinned region of every TabStripModel is
+// deliberately kept empty (WorkspaceTabController undoes any native pin),
+// which is what keeps TabStripModel::empty() meaningful.
+class WorkspaceService : public KeyedService {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // Fired on any change to the persistent entry list, and on any change to
+    // the tab bindings -- the sidebar renders both, and the Today section
+    // hides tabs that are bound, so a binding change is a view change even
+    // when no entry was touched.
+    virtual void OnWorkspaceEntriesChanged() {}
+  };
+
+  static constexpr size_t kMaxFavorites = 12;
+
+  // Takes the PrefService rather than the Profile it came from: everything
+  // here is entry data plus a tab-handle map, and keeping the dependency this
+  // narrow is what lets helium_workspace_unittests exercise it directly.
+  explicit WorkspaceService(PrefService* prefs);
+  WorkspaceService(const WorkspaceService&) = delete;
+  WorkspaceService& operator=(const WorkspaceService&) = delete;
+  ~WorkspaceService() override;
+
+  // ---- Persistent model ----
+  const std::vector<WorkspaceEntry>& entries() const { return entries_; }
+  const WorkspaceEntry* FindEntryById(const std::string& id) const;
+  // First entry whose URL is exactly |url| and which has no live tab in
+  // |window|, or nullptr. Used to adopt an existing tab into an entry
+  // instead of minting a duplicate.
+  const WorkspaceEntry* FindEntryByUrlUnboundInWindow(
+      const GURL& url,
+      BrowserWindowInterface* window) const;
+
+  // Returns the new entry's id, or the empty string if rejected (favorites
+  // cap reached).
+  std::string AddEntry(WorkspaceEntry::Section section,
+                       const GURL& url,
+                       const std::u16string& title);
+  bool RemoveEntry(const std::string& id);
+  bool SetEntryUrl(const std::string& id, const GURL& url);
+  bool SetEntryTitle(const std::string& id, const std::u16string& title);
+  // Raw PNG bytes; empty clears the icon. Persisted so a cold start can draw
+  // entries that have no tab.
+  bool SetEntryFavicon(const std::string& id, std::string png_bytes);
+
+  // ---- Runtime tab binding (never persisted) ----
+  void BindTab(tabs::TabHandle handle, const std::string& entry_id);
+  void UnbindTab(tabs::TabHandle handle);
+  // Empty string if the tab is not a workspace entry.
+  std::string FindEntryIdForTab(tabs::TabHandle handle) const;
+  // Every live tab bound to |entry_id|, across all windows.
+  std::vector<tabs::TabHandle> FindTabsForEntry(
+      const std::string& entry_id) const;
+  // |entry_id|'s tab in |window|, or Null.
+  tabs::TabHandle FindTabForEntryInWindow(const std::string& entry_id,
+                                          BrowserWindowInterface* window) const;
+  bool IsWorkspaceTab(tabs::TabHandle handle) const;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  void LoadFromPrefs();
+  void PersistToPrefs();
+  // Coalesces the writes that follow the active tab around: title and
+  // favicon change on every navigation, and PersistToPrefs() rewrites the
+  // whole list. Structural edits (add/remove/section) stay synchronous.
+  void SchedulePersist();
+  void NotifyChanged();
+  int NextPosition(WorkspaceEntry::Section section) const;
+
+  const raw_ptr<PrefService> prefs_;
+
+  std::vector<WorkspaceEntry> entries_;
+  std::map<tabs::TabHandle, std::string> tab_to_entry_;
+
+  base::OneShotTimer persist_timer_;
+  base::ObserverList<Observer> observers_;
+};
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_SERVICE_H_
