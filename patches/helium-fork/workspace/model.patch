@@ -0,0 +1,399 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_service.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/uuid.h"
+#include "chrome/browser/performance_manager/policies/discard_eligibility_policy.h"
+#include "chrome/browser/performance_manager/public/user_tuning/user_tuning_utils.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/resource_coordinator/lifecycle_unit_state.mojom.h"
+#include "chrome/browser/sessions/session_restore.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
+#include "chrome/browser/ui/helium_workspace/workspace_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/performance_manager/public/performance_manager.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "content/public/browser/web_contents.h"
+
+namespace helium_workspace {
+
+namespace {
+
+using performance_manager::PerformanceManager;
+using DiscardEligibilityPolicy =
+    performance_manager::policies::DiscardEligibilityPolicy;
+using performance_manager::policies::CanDiscardResult;
+
+constexpr auto kWorkspaceDiscardReason =
+    ::mojom::LifecycleUnitDiscardReason::EXTERNAL;
+
+// Entries sort favorites-first, then by position.
+bool EntryOrderLess(const WorkspaceEntry& a, const WorkspaceEntry& b) {
+  if (a.section != b.section) {
+    return a.section == WorkspaceEntry::Section::kFavorite;
+  }
+  return a.position < b.position;
+}
+
+}  // namespace
+
+WorkspaceService::WorkspaceService(Profile* profile)
+    : profile_(profile), prefs_(profile->GetPrefs()) {
+  LoadFromPrefs();
+  session_restored_subscription_ =
+      SessionRestore::RegisterOnSessionRestoredCallback(base::BindRepeating(
+          &WorkspaceService::OnSessionRestored, weak_factory_.GetWeakPtr()));
+}
+
+WorkspaceService::~WorkspaceService() = default;
+
+const WorkspaceEntry* WorkspaceService::FindEntryById(
+    const std::string& id) const {
+  for (const WorkspaceEntry& entry : entries_) {
+    if (entry.id == id) {
+      return &entry;
+    }
+  }
+  return nullptr;
+}
+
+const WorkspaceEntry* WorkspaceService::FindUnboundEntryByUrl(
+    const GURL& url) const {
+  for (const WorkspaceEntry& entry : entries_) {
+    if (entry.url == url &&
+        FindTabForEntry(entry.id) == tabs::TabHandle::Null()) {
+      return &entry;
+    }
+  }
+  return nullptr;
+}
+
+std::string WorkspaceService::AddEntry(WorkspaceEntry::Section section,
+                                       const GURL& url,
+                                       const std::u16string& title) {
+  if (!url.is_valid()) {
+    return std::string();
+  }
+  if (section == WorkspaceEntry::Section::kFavorite) {
+    const size_t favorites = std::ranges::count_if(
+        entries_, [](const WorkspaceEntry& e) {
+          return e.section == WorkspaceEntry::Section::kFavorite;
+        });
+    if (favorites >= kMaxFavorites) {
+      return std::string();
+    }
+  }
+
+  WorkspaceEntry entry;
+  entry.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  entry.section = section;
+  entry.url = url;
+  entry.title = title;
+  entry.position = NextPosition(section);
+  const std::string id = entry.id;
+  entries_.push_back(std::move(entry));
+  std::stable_sort(entries_.begin(), entries_.end(), EntryOrderLess);
+  PersistToPrefs();
+  NotifyChanged();
+  return id;
+}
+
+bool WorkspaceService::RemoveEntry(const std::string& id) {
+  const size_t erased = std::erase_if(
+      entries_, [&](const WorkspaceEntry& e) { return e.id == id; });
+  if (!erased) {
+    return false;
+  }
+  std::erase_if(tab_to_entry_,
+                [&](const auto& pair) { return pair.second == id; });
+  PersistToPrefs();
+  NotifyChanged();
+  return true;
+}
+
+bool WorkspaceService::SetEntryUrl(const std::string& id, const GURL& url) {
+  if (!url.is_valid()) {
+    return false;
+  }
+  for (WorkspaceEntry& entry : entries_) {
+    if (entry.id == id) {
+      entry.url = url;
+      PersistToPrefs();
+      NotifyChanged();
+      return true;
+    }
+  }
+  return false;
+}
+
+bool WorkspaceService::SetEntryTitle(const std::string& id,
+                                     const std::u16string& title) {
+  for (WorkspaceEntry& entry : entries_) {
+    if (entry.id == id) {
+      if (entry.title == title) {
+        return true;
+      }
+      entry.title = title;
+      PersistToPrefs();
+      NotifyChanged();
+      return true;
+    }
+  }
+  return false;
+}
+
+void WorkspaceService::BindTab(tabs::TabHandle handle,
+                               const std::string& entry_id) {
+  tab_to_entry_[handle] = entry_id;
+}
+
+void WorkspaceService::UnbindTab(tabs::TabHandle handle) {
+  tab_to_entry_.erase(handle);
+  pending_reset_.erase(handle);
+}
+
+std::string WorkspaceService::FindEntryIdForTab(tabs::TabHandle handle) const {
+  const auto it = tab_to_entry_.find(handle);
+  return it != tab_to_entry_.end() ? it->second : std::string();
+}
+
+tabs::TabHandle WorkspaceService::FindTabForEntry(
+    const std::string& entry_id) const {
+  for (const auto& [handle, id] : tab_to_entry_) {
+    if (id == entry_id) {
+      return handle;
+    }
+  }
+  return tabs::TabHandle::Null();
+}
+
+bool WorkspaceService::IsWorkspaceTab(tabs::TabHandle handle) const {
+  return tab_to_entry_.contains(handle);
+}
+
+void WorkspaceService::MarkPendingReset(tabs::TabHandle handle) {
+  pending_reset_.insert(handle);
+}
+
+bool WorkspaceService::TakePendingReset(tabs::TabHandle handle) {
+  return pending_reset_.erase(handle) > 0;
+}
+
+// static
+bool WorkspaceService::DiscardTabForWorkspace(tabs::TabInterface* tab) {
+  if (!tab) {
+    return false;
+  }
+  content::WebContents* contents = tab->GetContents();
+  if (!contents) {
+    return false;
+  }
+  if (contents->WasDiscarded()) {
+    return true;  // Already unloaded.
+  }
+  if (!PerformanceManager::IsAvailable()) {
+    return false;
+  }
+  DiscardEligibilityPolicy* policy =
+      DiscardEligibilityPolicy::GetFromGraph(PerformanceManager::GetGraph());
+  if (!policy) {
+    return false;
+  }
+  base::WeakPtr<performance_manager::PageNode> page_node =
+      PerformanceManager::GetPrimaryPageNodeForWebContents(contents);
+  if (!page_node) {
+    return false;
+  }
+  if (policy->CanDiscard(page_node.get(), kWorkspaceDiscardReason,
+                         /*ignore_recent_visibility=*/true) !=
+      CanDiscardResult::kEligible) {
+    return false;
+  }
+  performance_manager::user_tuning::DiscardPage(
+      page_node.get(), kWorkspaceDiscardReason,
+      /*ignore_minimum_time_in_background=*/true);
+  return true;
+}
+
+void WorkspaceService::EnsureReconciled() {
+  if (reconciled_) {
+    return;
+  }
+  RunStartupReconciliation();
+}
+
+void WorkspaceService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void WorkspaceService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void WorkspaceService::Shutdown() {
+  session_restored_subscription_ = {};
+}
+
+void WorkspaceService::LoadFromPrefs() {
+  entries_.clear();
+  for (const base::Value& value :
+       prefs_->GetList(prefs::kWorkspaceEntries)) {
+    if (!value.is_dict()) {
+      continue;
+    }
+    if (std::optional<WorkspaceEntry> entry =
+            WorkspaceEntry::FromValue(value.GetDict())) {
+      entries_.push_back(std::move(*entry));
+    }
+  }
+  std::stable_sort(entries_.begin(), entries_.end(), EntryOrderLess);
+}
+
+void WorkspaceService::PersistToPrefs() {
+  ScopedListPrefUpdate update(prefs_, prefs::kWorkspaceEntries);
+  base::ListValue& values = update.Get();
+  values.clear();
+  for (const WorkspaceEntry& entry : entries_) {
+    values.Append(entry.ToValue());
+  }
+}
+
+void WorkspaceService::NotifyChanged() {
+  for (Observer& observer : observers_) {
+    observer.OnWorkspaceEntriesChanged();
+  }
+}
+
+int WorkspaceService::NextPosition(WorkspaceEntry::Section section) const {
+  int max_position = -1;
+  for (const WorkspaceEntry& entry : entries_) {
+    if (entry.section == section) {
+      max_position = std::max(max_position, entry.position);
+    }
+  }
+  return max_position + 1;
+}
+
+void WorkspaceService::OnSessionRestored(Profile* profile, int num_tabs) {
+  if (profile != profile_ || reconciled_) {
+    return;
+  }
+  RunStartupReconciliation();
+}
+
+void WorkspaceService::RunStartupReconciliation() {
+  reconciled_ = true;
+
+  BrowserWindowInterface* target_browser = nullptr;
+
+  // Collect every unclaimed pinned tab across this profile's windows
+  // (session restore, Chromium's PinnedTabCodec startup tabs, ...).
+  std::vector<tabs::TabHandle> unclaimed;
+  ProfileBrowserCollection::GetForProfile(profile_)->ForEach(
+      [&](BrowserWindowInterface* browser) {
+        TabStripModel* model = browser->GetTabStripModel();
+        if (!model) {
+          return true;
+        }
+        if (!target_browser) {
+          target_browser = browser;
+        }
+        for (int i = 0; i < model->IndexOfFirstNonPinnedTab(); ++i) {
+          tabs::TabInterface* tab = model->GetTabAtIndex(i);
+          if (tab && !IsWorkspaceTab(tab->GetHandle())) {
+            unclaimed.push_back(tab->GetHandle());
+          }
+        }
+        return true;
+      },
+      BrowserCollection::Order::kActivation);
+
+  if (!target_browser) {
+    // No suitable window yet; allow a later EnsureReconciled() attempt.
+    reconciled_ = false;
+    return;
+  }
+
+  // Adopt pass A — exact URL match (tab is already at its entry URL).
+  std::erase_if(unclaimed, [&](tabs::TabHandle handle) {
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab) {
+      return true;
+    }
+    if (const WorkspaceEntry* entry = FindUnboundEntryByUrl(tab->GetURL())) {
+      BindTab(handle, entry->id);
+      return true;
+    }
+    return false;
+  });
+
+  // Adopt pass B — same-origin match (a pinned tab that had navigated away
+  // when the browser quit). Marked for reset so its next activation returns
+  // to the entry URL, matching Arc's after-restart semantics.
+  std::erase_if(unclaimed, [&](tabs::TabHandle handle) {
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab) {
+      return true;
+    }
+    const GURL url = tab->GetURL();
+    for (const WorkspaceEntry& entry : entries_) {
+      if (FindTabForEntry(entry.id) == tabs::TabHandle::Null() &&
+          entry.url.DeprecatedGetOriginAsURL() ==
+              url.DeprecatedGetOriginAsURL()) {
+        BindTab(handle, entry.id);
+        MarkPendingReset(handle);
+        return true;
+      }
+    }
+    return false;
+  });
+
+  // Back-fill pass — pinned tabs the model does not know about become
+  // entries, so model and tab strip stay consistent in both directions.
+  for (tabs::TabHandle handle : unclaimed) {
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab) {
+      continue;
+    }
+    content::WebContents* contents = tab->GetContents();
+    const std::string id =
+        AddEntry(WorkspaceEntry::Section::kPinned, tab->GetURL(),
+                 contents ? contents->GetTitle() : std::u16string());
+    if (!id.empty()) {
+      BindTab(handle, id);
+    }
+  }
+
+  // Pass 2 — rebuild: entries without a live tab get a fresh background
+  // pinned tab at the entry URL, immediately discarded so it stays unloaded
+  // until clicked.
+  for (const WorkspaceEntry& entry : entries_) {
+    if (FindTabForEntry(entry.id) != tabs::TabHandle::Null()) {
+      continue;
+    }
+    TabStripModel* model = target_browser->GetTabStripModel();
+    content::WebContents* contents = chrome::AddAndReturnTabAt(
+        target_browser, entry.url, model->IndexOfFirstNonPinnedTab(),
+        /*foreground=*/false, /*group=*/std::nullopt, /*pinned=*/true);
+    if (!contents) {
+      continue;
+    }
+    tabs::TabInterface* tab = model->GetTabForWebContents(contents);
+    if (!tab) {
+      continue;
+    }
+    BindTab(tab->GetHandle(), entry.id);
+    DiscardTabForWorkspace(tab);
+  }
+}
+
+}  // namespace helium_workspace
