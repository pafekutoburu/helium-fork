+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_SERVICE_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_SERVICE_H_
+
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "chrome/browser/ui/helium_workspace/workspace_entry.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/tabs/public/tab_interface.h"
+
+class GURL;
+class PrefService;
+class Profile;
+
+namespace helium_workspace {
+
+// Profile-scoped model of the workspace sidebar: the persistent
+// Favorites/Pinned entries, their runtime binding to live tabs, and the
+// startup reconciliation that re-establishes that binding after a restart.
+//
+// Invariant (established by reconciliation, maintained by
+// WorkspaceTabController): every entry is backed by a real native pinned
+// tab; an "unloaded" entry's tab is in the discarded state.
+class WorkspaceService : public KeyedService {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // Fired on any change to the persistent entry list.
+    virtual void OnWorkspaceEntriesChanged() {}
+  };
+
+  static constexpr size_t kMaxFavorites = 12;
+
+  explicit WorkspaceService(Profile* profile);
+  WorkspaceService(const WorkspaceService&) = delete;
+  WorkspaceService& operator=(const WorkspaceService&) = delete;
+  ~WorkspaceService() override;
+
+  // ---- Persistent model ----
+  const std::vector<WorkspaceEntry>& entries() const { return entries_; }
+  const WorkspaceEntry* FindEntryById(const std::string& id) const;
+  // First unbound entry matching |url| exactly, or nullptr.
+  const WorkspaceEntry* FindUnboundEntryByUrl(const GURL& url) const;
+
+  // Returns the new entry's id, or the empty string if rejected (favorites
+  // cap reached).
+  std::string AddEntry(WorkspaceEntry::Section section,
+                       const GURL& url,
+                       const std::u16string& title);
+  bool RemoveEntry(const std::string& id);
+  bool SetEntryUrl(const std::string& id, const GURL& url);
+  bool SetEntryTitle(const std::string& id, const std::u16string& title);
+
+  // ---- Runtime tab binding (never persisted) ----
+  void BindTab(tabs::TabHandle handle, const std::string& entry_id);
+  void UnbindTab(tabs::TabHandle handle);
+  // Empty string if the tab is not a workspace entry.
+  std::string FindEntryIdForTab(tabs::TabHandle handle) const;
+  tabs::TabHandle FindTabForEntry(const std::string& entry_id) const;
+  bool IsWorkspaceTab(tabs::TabHandle handle) const;
+
+  // ---- Reset-to-origin marker ----
+  // Set when an entry's tab is unloaded so that its next activation
+  // navigates back to the entry URL instead of the last visited one.
+  void MarkPendingReset(tabs::TabHandle handle);
+  bool TakePendingReset(tabs::TabHandle handle);
+
+  // Discards |tab|'s contents via the same performance_manager path Helium's
+  // tab hibernation uses, for exactly one tab. The tab must not be in the
+  // foreground. Returns false if the tab is not eligible (audio playing,
+  // form data, capture in progress, ...). A true return (including the
+  // already-discarded case) means the tab is unloaded.
+  static bool DiscardTabForWorkspace(tabs::TabInterface* tab);
+
+  // Called by the first WorkspaceTabController of a profile when this
+  // startup did not go through session restore; the session-restore path
+  // subscribes itself in the constructor. Idempotent.
+  void EnsureReconciled();
+  bool reconciled() const { return reconciled_; }
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  void LoadFromPrefs();
+  void PersistToPrefs();
+  void NotifyChanged();
+  int NextPosition(WorkspaceEntry::Section section) const;
+
+  void OnSessionRestored(Profile* profile, int num_tabs);
+
+  // Startup reconciliation: adopt existing pinned tabs by URL, re-create
+  // tabs for entries without one (as background discarded pinned tabs), and
+  // record entries for pinned tabs the model does not know about.
+  void RunStartupReconciliation();
+
+  const raw_ptr<Profile> profile_;
+  const raw_ptr<PrefService> prefs_;
+
+  std::vector<WorkspaceEntry> entries_;
+  std::map<tabs::TabHandle, std::string> tab_to_entry_;
+  std::set<tabs::TabHandle> pending_reset_;
+  bool reconciled_ = false;
+
+  base::CallbackListSubscription session_restored_subscription_;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<WorkspaceService> weak_factory_{this};
+};
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_SERVICE_H_
