@@ -0,0 +1,94 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_entry.h"
+
+#include "base/base64.h"
+#include "base/strings/utf_string_conversions.h"
+
+namespace helium_workspace {
+
+namespace {
+
+constexpr char kKeyId[] = "id";
+constexpr char kKeySpaceId[] = "space_id";
+constexpr char kKeySection[] = "section";
+constexpr char kKeyUrl[] = "url";
+constexpr char kKeyTitle[] = "title";
+constexpr char kKeyPosition[] = "position";
+constexpr char kKeyFavicon[] = "favicon";
+constexpr char kKeyVersion[] = "version";
+
+}  // namespace
+
+WorkspaceEntry::WorkspaceEntry() = default;
+WorkspaceEntry::WorkspaceEntry(const WorkspaceEntry&) = default;
+WorkspaceEntry& WorkspaceEntry::operator=(const WorkspaceEntry&) = default;
+WorkspaceEntry::~WorkspaceEntry() = default;
+
+base::DictValue WorkspaceEntry::ToValue() const {
+  base::DictValue dict;
+  dict.Set(kKeyId, id);
+  dict.Set(kKeySpaceId, space_id);
+  dict.Set(kKeySection, static_cast<int>(section));
+  dict.Set(kKeyUrl, url.spec());
+  dict.Set(kKeyTitle, title);
+  dict.Set(kKeyPosition, position);
+  if (!favicon_png.empty()) {
+    dict.Set(kKeyFavicon, base::Base64Encode(favicon_png));
+  }
+  dict.Set(kKeyVersion, version);
+  return dict;
+}
+
+// static
+std::optional<WorkspaceEntry> WorkspaceEntry::FromValue(
+    const base::DictValue& dict) {
+  const std::string* id = dict.FindString(kKeyId);
+  if (!id || id->empty()) {
+    return std::nullopt;
+  }
+
+  const std::string* url_string = dict.FindString(kKeyUrl);
+  if (!url_string) {
+    return std::nullopt;
+  }
+  GURL url(*url_string);
+  if (!url.is_valid()) {
+    return std::nullopt;
+  }
+
+  const std::optional<int> section = dict.FindInt(kKeySection);
+  if (!section ||
+      *section < static_cast<int>(Section::kFavorite) ||
+      *section > static_cast<int>(Section::kPinned)) {
+    return std::nullopt;
+  }
+
+  WorkspaceEntry entry;
+  entry.id = *id;
+  entry.url = std::move(url);
+  entry.section = static_cast<Section>(*section);
+
+  if (const std::string* space_id = dict.FindString(kKeySpaceId);
+      space_id && !space_id->empty()) {
+    entry.space_id = *space_id;
+  }
+  if (const std::string* title = dict.FindString(kKeyTitle)) {
+    entry.title = base::UTF8ToUTF16(*title);
+  }
+  entry.position = dict.FindInt(kKeyPosition).value_or(0);
+  // A corrupt icon is not worth rejecting the entry over — drop it and let
+  // the view fall back to the favicon service.
+  if (const std::string* favicon = dict.FindString(kKeyFavicon)) {
+    if (std::optional<std::vector<uint8_t>> bytes =
+            base::Base64Decode(*favicon)) {
+      entry.favicon_png.assign(bytes->begin(), bytes->end());
+    }
+  }
+  entry.version = dict.FindInt(kKeyVersion).value_or(kCurrentVersion);
+  return entry;
+}
+
+}  // namespace helium_workspace
Index: src/chrome/browser/ui/helium_workspace/workspace_entry.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/workspace_entry.h
@@ -0,0 +1,60 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_ENTRY_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_ENTRY_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/values.h"
+#include "url/gurl.h"
+
+namespace helium_workspace {
+
+// One persistent sidebar entry (a Favorite or a Pinned tab). Entries outlive
+// their tabs: closing ("unloading") the backing tab keeps the entry, and the
+// entry's |url| — the URL it was originally pinned at — is what the tab
+// returns to when reset or re-created.
+struct WorkspaceEntry {
+  // Values are persisted; do not renumber.
+  enum class Section {
+    kFavorite = 0,
+    kPinned = 1,
+  };
+
+  WorkspaceEntry();
+  WorkspaceEntry(const WorkspaceEntry&);
+  WorkspaceEntry& operator=(const WorkspaceEntry&);
+  ~WorkspaceEntry();
+
+  // Serialization schema version this code writes. v2 added |favicon_png|;
+  // v1 entries load unchanged and simply carry no icon.
+  static constexpr int kCurrentVersion = 2;
+
+  base::DictValue ToValue() const;
+
+  // Returns std::nullopt for missing/invalid required fields (id, url,
+  // section). Unknown fields are ignored; missing optional fields get
+  // defaults.
+  static std::optional<WorkspaceEntry> FromValue(const base::DictValue& dict);
+
+  std::string id;                  // UUID, primary key.
+  std::string space_id = "default";  // Reserved for v2 Spaces.
+  Section section = Section::kPinned;
+  GURL url;                        // Original pinned URL (reset target).
+  std::u16string title;
+  int position = 0;                // Sort key within its section.
+  // Raw PNG bytes of the entry's favicon, base64-encoded in the pref. The
+  // sidebar draws entries that have no tab, so without a stored icon a cold
+  // start would show nothing but placeholders until something is clicked.
+  // Empty means "fall back to the favicon service, then to the default".
+  std::string favicon_png;
+  int version = kCurrentVersion;
+};
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_ENTRY_H_
Index: src/chrome/browser/ui/helium_workspace/workspace_entry_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/workspace_entry_unittest.cc
@@ -0,0 +1,187 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_entry.h"
+
+#include <vector>
+
+#include "chrome/browser/ui/helium_workspace/workspace_grid_math.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium_workspace {
+namespace {
+
+WorkspaceEntry MakeEntry() {
+  WorkspaceEntry entry;
+  entry.id = "0d9b1c9e-3f6a-4a3e-9d55-1c2b3a4d5e6f";
+  entry.space_id = "default";
+  entry.section = WorkspaceEntry::Section::kFavorite;
+  entry.url = GURL("https://example.com/path?q=1");
+  entry.title = u"Example 例子";
+  entry.position = 3;
+  return entry;
+}
+
+TEST(WorkspaceEntryTest, RoundTrip) {
+  const WorkspaceEntry original = MakeEntry();
+  const std::optional<WorkspaceEntry> decoded =
+      WorkspaceEntry::FromValue(original.ToValue());
+  ASSERT_TRUE(decoded.has_value());
+  EXPECT_EQ(decoded->id, original.id);
+  EXPECT_EQ(decoded->space_id, original.space_id);
+  EXPECT_EQ(decoded->section, original.section);
+  EXPECT_EQ(decoded->url, original.url);
+  EXPECT_EQ(decoded->title, original.title);
+  EXPECT_EQ(decoded->position, original.position);
+  EXPECT_EQ(decoded->version, WorkspaceEntry::kCurrentVersion);
+}
+
+TEST(WorkspaceEntryTest, FaviconRoundTrips) {
+  WorkspaceEntry original = MakeEntry();
+  // Bytes that are not valid UTF-8, so this also proves the base64 hop is
+  // what makes the icon safe to store in a JSON pref.
+  original.favicon_png = std::string("\x89PNG\r\n\x1a\n\xff\xfe\x00\x01", 13);
+
+  const std::optional<WorkspaceEntry> decoded =
+      WorkspaceEntry::FromValue(original.ToValue());
+  ASSERT_TRUE(decoded.has_value());
+  EXPECT_EQ(decoded->favicon_png, original.favicon_png);
+}
+
+TEST(WorkspaceEntryTest, FaviconOptionalAndCorruptionTolerated) {
+  // Absent icon: the key is not even written, and decoding leaves it empty.
+  const WorkspaceEntry without = MakeEntry();
+  EXPECT_FALSE(without.ToValue().contains("favicon"));
+  const std::optional<WorkspaceEntry> decoded_without =
+      WorkspaceEntry::FromValue(without.ToValue());
+  ASSERT_TRUE(decoded_without.has_value());
+  EXPECT_TRUE(decoded_without->favicon_png.empty());
+
+  // A corrupt icon must not cost us the whole entry.
+  base::DictValue corrupt = MakeEntry().ToValue();
+  corrupt.Set("favicon", "!!!! not base64 !!!!");
+  const std::optional<WorkspaceEntry> decoded_corrupt =
+      WorkspaceEntry::FromValue(corrupt);
+  ASSERT_TRUE(decoded_corrupt.has_value());
+  EXPECT_TRUE(decoded_corrupt->favicon_png.empty());
+  EXPECT_EQ(decoded_corrupt->id, without.id);
+}
+
+TEST(WorkspaceEntryTest, VersionOneEntriesStillLoad) {
+  // A profile written by the previous build: no favicon key, version 1.
+  base::DictValue v1 = MakeEntry().ToValue();
+  v1.Remove("favicon");
+  v1.Set("version", 1);
+
+  const std::optional<WorkspaceEntry> decoded = WorkspaceEntry::FromValue(v1);
+  ASSERT_TRUE(decoded.has_value());
+  EXPECT_EQ(decoded->version, 1);
+  EXPECT_TRUE(decoded->favicon_png.empty());
+  EXPECT_EQ(decoded->url, MakeEntry().url);
+}
+
+TEST(WorkspaceEntryTest, MissingRequiredFieldsRejected) {
+  // Empty dict.
+  EXPECT_FALSE(WorkspaceEntry::FromValue(base::DictValue()).has_value());
+
+  // Missing id.
+  base::DictValue no_id = MakeEntry().ToValue();
+  no_id.Remove("id");
+  EXPECT_FALSE(WorkspaceEntry::FromValue(no_id).has_value());
+
+  // Missing url.
+  base::DictValue no_url = MakeEntry().ToValue();
+  no_url.Remove("url");
+  EXPECT_FALSE(WorkspaceEntry::FromValue(no_url).has_value());
+
+  // Invalid url.
+  base::DictValue bad_url = MakeEntry().ToValue();
+  bad_url.Set("url", "not a url");
+  EXPECT_FALSE(WorkspaceEntry::FromValue(bad_url).has_value());
+
+  // Out-of-range section.
+  base::DictValue bad_section = MakeEntry().ToValue();
+  bad_section.Set("section", 42);
+  EXPECT_FALSE(WorkspaceEntry::FromValue(bad_section).has_value());
+
+  // Wrong type for section.
+  base::DictValue wrong_type = MakeEntry().ToValue();
+  wrong_type.Set("section", "pinned");
+  EXPECT_FALSE(WorkspaceEntry::FromValue(wrong_type).has_value());
+}
+
+TEST(WorkspaceEntryTest, OptionalFieldsGetDefaults) {
+  base::DictValue minimal;
+  minimal.Set("id", "some-id");
+  minimal.Set("url", "https://example.org/");
+  minimal.Set("section", 1);
+
+  const std::optional<WorkspaceEntry> decoded =
+      WorkspaceEntry::FromValue(minimal);
+  ASSERT_TRUE(decoded.has_value());
+  EXPECT_EQ(decoded->space_id, "default");
+  EXPECT_TRUE(decoded->title.empty());
+  EXPECT_EQ(decoded->position, 0);
+  EXPECT_EQ(decoded->version, WorkspaceEntry::kCurrentVersion);
+  EXPECT_EQ(decoded->section, WorkspaceEntry::Section::kPinned);
+}
+
+TEST(WorkspaceEntryTest, UnknownFieldsIgnored) {
+  base::DictValue dict = MakeEntry().ToValue();
+  dict.Set("future_field", "whatever");
+  EXPECT_TRUE(WorkspaceEntry::FromValue(dict).has_value());
+}
+
+// Expands a plan into the per-row column counts for readability.
+std::vector<int> RowsFor(int count, int per_row_max = 4) {
+  const FavoritesGridPlan plan = PlanFavoritesGrid(count, per_row_max);
+  std::vector<int> cols;
+  for (int row = 0; row < plan.rows; ++row) {
+    cols.push_back(FavoritesGridColsForRow(plan, row));
+  }
+  return cols;
+}
+
+TEST(WorkspaceGridMathTest, ArcBalancedRows) {
+  // Arc: at most 4 per row, rows balanced (verified against Arc itself).
+  EXPECT_EQ(RowsFor(0), (std::vector<int>{}));
+  EXPECT_EQ(RowsFor(1), (std::vector<int>{1}));
+  EXPECT_EQ(RowsFor(2), (std::vector<int>{2}));
+  EXPECT_EQ(RowsFor(3), (std::vector<int>{3}));
+  EXPECT_EQ(RowsFor(4), (std::vector<int>{4}));
+  EXPECT_EQ(RowsFor(5), (std::vector<int>{3, 2}));
+  EXPECT_EQ(RowsFor(6), (std::vector<int>{3, 3}));
+  EXPECT_EQ(RowsFor(7), (std::vector<int>{4, 3}));
+  EXPECT_EQ(RowsFor(8), (std::vector<int>{4, 4}));
+  EXPECT_EQ(RowsFor(9), (std::vector<int>{3, 3, 3}));
+  EXPECT_EQ(RowsFor(10), (std::vector<int>{4, 3, 3}));
+  EXPECT_EQ(RowsFor(11), (std::vector<int>{4, 4, 3}));
+  EXPECT_EQ(RowsFor(12), (std::vector<int>{4, 4, 4}));
+}
+
+TEST(WorkspaceGridMathTest, NarrowWidthReducesPerRowMax) {
+  // Collapse animation can only fit fewer capsules per row.
+  EXPECT_EQ(RowsFor(6, /*per_row_max=*/2), (std::vector<int>{2, 2, 2}));
+  EXPECT_EQ(RowsFor(5, /*per_row_max=*/1),
+            (std::vector<int>{1, 1, 1, 1, 1}));
+}
+
+TEST(WorkspaceGridMathTest, GridBottomFollowsRowCount) {
+  constexpr int kRowHeight = 44;
+  constexpr int kGap = 8;
+  const auto Bottom = [](int count) {
+    return FavoritesGridBottom(PlanFavoritesGrid(count, 4), kRowHeight, kGap);
+  };
+  EXPECT_EQ(Bottom(0), 0);
+  EXPECT_EQ(Bottom(1), 44);
+  EXPECT_EQ(Bottom(4), 44);
+  // Fifth favorite wraps: two rows plus the gap between them.
+  EXPECT_EQ(Bottom(5), 96);
+  EXPECT_EQ(Bottom(8), 96);
+  EXPECT_EQ(Bottom(9), 148);
+  EXPECT_EQ(Bottom(12), 148);
+}
+
+}  // namespace
+}  // namespace helium_workspace
Index: src/chrome/browser/ui/helium_workspace/workspace_service.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/workspace_service.cc
@@ -0,0 +1,303 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_service.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/uuid.h"
+#include "chrome/browser/ui/helium_workspace/workspace_prefs.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace helium_workspace {
+
+namespace {
+
+// Title and favicon follow whatever page the entry's tab is on, so they
+// change several times per navigation. Coalesce those writes; the pref is
+// rewritten in full every time.
+constexpr base::TimeDelta kPersistDebounce = base::Seconds(2);
+
+// Entries sort favorites-first, then by position.
+bool EntryOrderLess(const WorkspaceEntry& a, const WorkspaceEntry& b) {
+  if (a.section != b.section) {
+    return a.section == WorkspaceEntry::Section::kFavorite;
+  }
+  return a.position < b.position;
+}
+
+}  // namespace
+
+WorkspaceService::WorkspaceService(PrefService* prefs) : prefs_(prefs) {
+  LoadFromPrefs();
+
+  // One-shot migration off the old model, where every entry was backed by a
+  // real native pinned tab. Chromium wrote those tabs into kPinnedTabs on
+  // exit and re-navigated them on the next start; entries are data now, so
+  // the stale list is dropped. It is too late to stop *this* start from
+  // opening them -- Chromium reads the pref before any KeyedService is
+  // built -- but every start after this one is clean.
+  if (!prefs_->GetBoolean(prefs::kWorkspaceMigratedFromPinnedTabs)) {
+    prefs_->ClearPref(::prefs::kPinnedTabs);
+    prefs_->SetBoolean(prefs::kWorkspaceMigratedFromPinnedTabs, true);
+  }
+}
+
+WorkspaceService::~WorkspaceService() = default;
+
+const WorkspaceEntry* WorkspaceService::FindEntryById(
+    const std::string& id) const {
+  for (const WorkspaceEntry& entry : entries_) {
+    if (entry.id == id) {
+      return &entry;
+    }
+  }
+  return nullptr;
+}
+
+const WorkspaceEntry* WorkspaceService::FindEntryByUrlUnboundInWindow(
+    const GURL& url,
+    BrowserWindowInterface* window) const {
+  for (const WorkspaceEntry& entry : entries_) {
+    if (entry.url == url &&
+        FindTabForEntryInWindow(entry.id, window) == tabs::TabHandle::Null()) {
+      return &entry;
+    }
+  }
+  return nullptr;
+}
+
+std::string WorkspaceService::AddEntry(WorkspaceEntry::Section section,
+                                       const GURL& url,
+                                       const std::u16string& title) {
+  if (!url.is_valid()) {
+    return std::string();
+  }
+  if (section == WorkspaceEntry::Section::kFavorite) {
+    const size_t favorites = std::ranges::count_if(
+        entries_, [](const WorkspaceEntry& e) {
+          return e.section == WorkspaceEntry::Section::kFavorite;
+        });
+    if (favorites >= kMaxFavorites) {
+      return std::string();
+    }
+  }
+
+  WorkspaceEntry entry;
+  entry.id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  entry.section = section;
+  entry.url = url;
+  entry.title = title;
+  entry.position = NextPosition(section);
+  const std::string id = entry.id;
+  entries_.push_back(std::move(entry));
+  std::stable_sort(entries_.begin(), entries_.end(), EntryOrderLess);
+  PersistToPrefs();
+  NotifyChanged();
+  return id;
+}
+
+bool WorkspaceService::RemoveEntry(const std::string& id) {
+  const size_t erased = std::erase_if(
+      entries_, [&](const WorkspaceEntry& e) { return e.id == id; });
+  if (!erased) {
+    return false;
+  }
+  // Any tabs opened for this entry stay open; dropping the binding is what
+  // makes them ordinary tabs again, and the Today section will show them on
+  // the next layout.
+  std::erase_if(tab_to_entry_,
+                [&](const auto& pair) { return pair.second == id; });
+  PersistToPrefs();
+  NotifyChanged();
+  return true;
+}
+
+bool WorkspaceService::SetEntryUrl(const std::string& id, const GURL& url) {
+  if (!url.is_valid()) {
+    return false;
+  }
+  for (WorkspaceEntry& entry : entries_) {
+    if (entry.id == id) {
+      entry.url = url;
+      PersistToPrefs();
+      NotifyChanged();
+      return true;
+    }
+  }
+  return false;
+}
+
+bool WorkspaceService::SetEntryTitle(const std::string& id,
+                                     const std::u16string& title) {
+  for (WorkspaceEntry& entry : entries_) {
+    if (entry.id == id) {
+      if (entry.title == title) {
+        return true;
+      }
+      entry.title = title;
+      SchedulePersist();
+      NotifyChanged();
+      return true;
+    }
+  }
+  return false;
+}
+
+bool WorkspaceService::SetEntryFavicon(const std::string& id,
+                                       std::string png_bytes) {
+  for (WorkspaceEntry& entry : entries_) {
+    if (entry.id == id) {
+      if (entry.favicon_png == png_bytes) {
+        return true;
+      }
+      entry.favicon_png = std::move(png_bytes);
+      SchedulePersist();
+      NotifyChanged();
+      return true;
+    }
+  }
+  return false;
+}
+
+void WorkspaceService::BindTab(tabs::TabHandle handle,
+                               const std::string& entry_id) {
+  const auto it = tab_to_entry_.find(handle);
+  if (it != tab_to_entry_.end() && it->second == entry_id) {
+    return;
+  }
+  tab_to_entry_[handle] = entry_id;
+  // A binding change is a view change even though no entry moved: the
+  // sidebar row switches to its live tab, and the Today section stops
+  // drawing that tab. Adopting an already-open tab produces no view-tree
+  // event of its own, so without this the tab would stay visible in Today.
+  NotifyChanged();
+}
+
+void WorkspaceService::UnbindTab(tabs::TabHandle handle) {
+  if (tab_to_entry_.erase(handle) > 0) {
+    NotifyChanged();
+  }
+}
+
+std::string WorkspaceService::FindEntryIdForTab(tabs::TabHandle handle) const {
+  // Same rule as FindTabsForEntry(): a binding only counts while its tab is
+  // still alive. Handle values are never recycled, so an entry left in the
+  // map by a tab that went away without unbinding is dead but not Null, and
+  // answering "yes, that is a workspace tab" for it is how bindings used to
+  // get stranded.
+  if (!handle.Get()) {
+    return std::string();
+  }
+  const auto it = tab_to_entry_.find(handle);
+  return it != tab_to_entry_.end() ? it->second : std::string();
+}
+
+std::vector<tabs::TabHandle> WorkspaceService::FindTabsForEntry(
+    const std::string& entry_id) const {
+  std::vector<tabs::TabHandle> handles;
+  for (const auto& [handle, id] : tab_to_entry_) {
+    // The handle must still resolve. Handle values are never recycled, so a
+    // handle whose tab was destroyed is non-Null but dead; treating one as a
+    // live binding used to strand the entry -- invisible to adoption and to
+    // the sidebar alike -- and pinning the same URL again minted a duplicate.
+    if (id == entry_id && handle.Get()) {
+      handles.push_back(handle);
+    }
+  }
+  return handles;
+}
+
+tabs::TabHandle WorkspaceService::FindTabForEntryInWindow(
+    const std::string& entry_id,
+    BrowserWindowInterface* window) const {
+  if (!window) {
+    return tabs::TabHandle::Null();
+  }
+  for (const auto& [handle, id] : tab_to_entry_) {
+    if (id != entry_id) {
+      continue;
+    }
+    tabs::TabInterface* tab = handle.Get();
+    if (tab && tab->GetBrowserWindowInterface() == window) {
+      return handle;
+    }
+  }
+  return tabs::TabHandle::Null();
+}
+
+bool WorkspaceService::IsWorkspaceTab(tabs::TabHandle handle) const {
+  return !FindEntryIdForTab(handle).empty();
+}
+
+void WorkspaceService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void WorkspaceService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void WorkspaceService::Shutdown() {
+  if (persist_timer_.IsRunning()) {
+    persist_timer_.Stop();
+    PersistToPrefs();
+  }
+}
+
+void WorkspaceService::LoadFromPrefs() {
+  entries_.clear();
+  for (const base::Value& value :
+       prefs_->GetList(prefs::kWorkspaceEntries)) {
+    if (!value.is_dict()) {
+      continue;
+    }
+    if (std::optional<WorkspaceEntry> entry =
+            WorkspaceEntry::FromValue(value.GetDict())) {
+      entries_.push_back(std::move(*entry));
+    }
+  }
+  std::stable_sort(entries_.begin(), entries_.end(), EntryOrderLess);
+}
+
+void WorkspaceService::PersistToPrefs() {
+  persist_timer_.Stop();
+  ScopedListPrefUpdate update(prefs_, prefs::kWorkspaceEntries);
+  base::ListValue& values = update.Get();
+  values.clear();
+  for (const WorkspaceEntry& entry : entries_) {
+    values.Append(entry.ToValue());
+  }
+}
+
+void WorkspaceService::SchedulePersist() {
+  if (persist_timer_.IsRunning()) {
+    return;
+  }
+  persist_timer_.Start(FROM_HERE, kPersistDebounce,
+                       base::BindOnce(&WorkspaceService::PersistToPrefs,
+                                      base::Unretained(this)));
+}
+
+void WorkspaceService::NotifyChanged() {
+  for (Observer& observer : observers_) {
+    observer.OnWorkspaceEntriesChanged();
+  }
+}
+
+int WorkspaceService::NextPosition(WorkspaceEntry::Section section) const {
+  int max_position = -1;
+  for (const WorkspaceEntry& entry : entries_) {
+    if (entry.section == section) {
+      max_position = std::max(max_position, entry.position);
+    }
+  }
+  return max_position + 1;
+}
+
+}  // namespace helium_workspace
