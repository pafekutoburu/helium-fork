+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/style/typography.h"
+
+namespace {
+
+// Command ids for the entry context menu. Local to this view: the actions are
+// executed here, so they never reach the browser command table.
+enum EntryMenuCommand {
+  kOpen = 1,
+  kToggleFavorite,
+  kCopyAddress,
+  kRemove,
+};
+
+// Row metrics. The capsule/row heights and radii are the ones the tab strip
+// already uses for pinned vertical tabs, so an entry row lines up with a
+// Today row exactly.
+constexpr int kIconLeadingInset = 2;
+constexpr int kTitleSpacing = 8;
+constexpr int kTitleTrailingInset = 8;
+constexpr int kActiveOutlineThickness = 2;
+
+}  // namespace
+
+WorkspaceEntryView::WorkspaceEntryView(Delegate* delegate, Profile* profile)
+    : delegate_(delegate), profile_(profile) {
+  icon_ = AddChildView(std::make_unique<TabIcon>());
+  icon_->SetCanProcessEventsWithinSubtree(false);
+  title_label_ = AddChildView(std::make_unique<TabTitle>());
+
+  set_context_menu_controller(this);
+  GetViewAccessibility().SetRole(ax::mojom::Role::kButton);
+}
+
+WorkspaceEntryView::~WorkspaceEntryView() = default;
+
+void WorkspaceEntryView::SetEntry(
+    const helium_workspace::WorkspaceEntry& entry) {
+  const bool section_changed = section_ != entry.section;
+  const bool icon_changed = favicon_png_ != entry.favicon_png;
+
+  entry_id_ = entry.id;
+  url_ = entry.url;
+  section_ = entry.section;
+
+  if (title_ != entry.title) {
+    title_ = entry.title;
+    title_label_->SetText(title_);
+    UpdateAccessibleState();
+  }
+  if (icon_changed) {
+    favicon_png_ = entry.favicon_png;
+    ResolveIcon();
+  }
+  if (section_changed) {
+    // Capsules hide their title and are a different height entirely.
+    title_label_->SetVisible(!renders_as_capsule());
+    InvalidateLayout();
+    SchedulePaint();
+  }
+}
+
+void WorkspaceEntryView::SetBoundTab(tabs::TabInterface* tab) {
+  const bool was_bound = !!bound_tab_;
+  if (bound_tab_.get() == tab) {
+    return;
+  }
+  bound_tab_ = tab ? tab->GetWeakPtr() : nullptr;
+  ResolveIcon();
+  if (was_bound != !!bound_tab_) {
+    // An unbound entry is drawn faded: it is a place the user can go, not a
+    // page that is open.
+    title_label_->SetEnabledColor(ui::kColorLabelForegroundSecondary);
+    if (bound_tab_) {
+      title_label_->SetEnabledColor(ui::kColorLabelForeground);
+    }
+    SchedulePaint();
+  }
+}
+
+void WorkspaceEntryView::SetActive(bool active) {
+  if (active_ == active) {
+    return;
+  }
+  active_ = active;
+  icon_->SetActiveState(active_);
+  SchedulePaint();
+}
+
+gfx::Size WorkspaceEntryView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  const int height = GetLayoutConstant(
+      renders_as_capsule() ? LayoutConstant::kVerticalTabFavoriteHeight
+                           : LayoutConstant::kVerticalTabHeight);
+  const int min_width = GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth);
+  const int width = available_size.width().is_bounded()
+                        ? std::max(min_width, available_size.width().value())
+                        : min_width;
+  return gfx::Size(width, height);
+}
+
+void WorkspaceEntryView::Layout(PassKey) {
+  const gfx::Size icon_size = icon_->GetPreferredSize();
+  const int icon_y = (height() - icon_size.height()) / 2;
+
+  if (renders_as_capsule()) {
+    // Centred icon, no text -- Arc's favorites grid.
+    icon_->SetBounds((width() - icon_size.width()) / 2, icon_y,
+                     icon_size.width(), icon_size.height());
+    return;
+  }
+
+  const int icon_x =
+      GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding) +
+      kIconLeadingInset;
+  icon_->SetBounds(icon_x, icon_y, icon_size.width(), icon_size.height());
+
+  const int title_x = icon_->bounds().right() + kTitleSpacing;
+  const int title_width = std::max(0, width() - title_x - kTitleTrailingInset);
+  const int title_height = title_label_->GetPreferredSize().height();
+  title_label_->SetBounds(title_x, (height() - title_height) / 2, title_width,
+                          title_height);
+}
+
+void WorkspaceEntryView::OnPaint(gfx::Canvas* canvas) {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    views::View::OnPaint(canvas);
+    return;
+  }
+
+  const int radius = GetLayoutConstant(
+      renders_as_capsule() ? LayoutConstant::kVerticalTabFavoriteCornerRadius
+                           : LayoutConstant::kVerticalTabCornerRadius);
+
+  cc::PaintFlags fill;
+  fill.setStyle(cc::PaintFlags::kFill_Style);
+  fill.setAntiAlias(true);
+  if (active_) {
+    fill.setColor(colors->GetColor(kColorTabBackgroundActiveFrameActive));
+    canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), radius, fill);
+  } else if (hovered_) {
+    fill.setColor(colors->GetColor(kColorTabBackgroundInactiveHoverFrameActive));
+    canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), radius, fill);
+  }
+
+  // Capsules always carry an outline, so an empty grid slot still reads as a
+  // slot; the active one gets the accent ring on top of its fill.
+  if (active_ && renders_as_capsule()) {
+    cc::PaintFlags stroke;
+    stroke.setStyle(cc::PaintFlags::kStroke_Style);
+    stroke.setStrokeWidth(kActiveOutlineThickness);
+    stroke.setAntiAlias(true);
+    stroke.setColor(colors->GetColor(kColorVerticalTabFavoriteActiveOutline));
+    gfx::RectF rect(GetLocalBounds());
+    rect.Inset(kActiveOutlineThickness / 2.0f);
+    canvas->DrawRoundRect(rect, radius, stroke);
+  } else if (renders_as_capsule()) {
+    const int thickness =
+        GetLayoutConstant(LayoutConstant::kVerticalTabPinnedBorderThickness);
+    cc::PaintFlags stroke;
+    stroke.setStyle(cc::PaintFlags::kStroke_Style);
+    stroke.setStrokeWidth(thickness);
+    stroke.setAntiAlias(true);
+    stroke.setColor(colors->GetColor(kColorVerticalTabPinnedOutline));
+    gfx::RectF rect(GetLocalBounds());
+    rect.Inset(thickness / 2.0f);
+    canvas->DrawRoundRect(rect, radius, stroke);
+  }
+
+  views::View::OnPaint(canvas);
+}
+
+bool WorkspaceEntryView::OnMousePressed(const ui::MouseEvent& event) {
+  return event.IsOnlyLeftMouseButton();
+}
+
+void WorkspaceEntryView::OnMouseReleased(const ui::MouseEvent& event) {
+  if (event.IsOnlyLeftMouseButton() && HitTestPoint(event.location()) &&
+      delegate_) {
+    delegate_->OnEntryActivated(entry_id_);
+  }
+}
+
+void WorkspaceEntryView::OnMouseEntered(const ui::MouseEvent& event) {
+  hovered_ = true;
+  SchedulePaint();
+}
+
+void WorkspaceEntryView::OnMouseExited(const ui::MouseEvent& event) {
+  hovered_ = false;
+  SchedulePaint();
+}
+
+void WorkspaceEntryView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_model_->AddItemWithStringId(EntryMenuCommand::kOpen,
+                                   IDS_HELIUM_WS_ENTRY_MENU_OPEN);
+  menu_model_->AddItemWithStringId(
+      EntryMenuCommand::kToggleFavorite,
+      renders_as_capsule() ? IDS_TAB_CXMENU_REMOVE_FROM_FAVORITES
+                           : IDS_TAB_CXMENU_ADD_TO_FAVORITES);
+  menu_model_->AddItemWithStringId(EntryMenuCommand::kCopyAddress,
+                                   IDS_CONTENT_CONTEXT_COPYLINKLOCATION);
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItemWithStringId(EntryMenuCommand::kRemove,
+                                   IDS_HELIUM_WS_ENTRY_MENU_REMOVE);
+
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(),
+      views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(source->GetWidget(), nullptr,
+                          gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+bool WorkspaceEntryView::IsCommandIdEnabled(int command_id) const {
+  if (command_id == EntryMenuCommand::kToggleFavorite &&
+      !renders_as_capsule()) {
+    return delegate_ && delegate_->CanEntryBecomeFavorite(entry_id_);
+  }
+  return true;
+}
+
+void WorkspaceEntryView::ExecuteCommand(int command_id, int event_flags) {
+  if (!delegate_) {
+    return;
+  }
+  switch (command_id) {
+    case EntryMenuCommand::kOpen:
+      delegate_->OnEntryActivated(entry_id_);
+      break;
+    case EntryMenuCommand::kToggleFavorite:
+      delegate_->OnEntryToggleFavorite(entry_id_);
+      break;
+    case EntryMenuCommand::kCopyAddress: {
+      ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+      writer.WriteText(base::UTF8ToUTF16(url_.spec()));
+      break;
+    }
+    case EntryMenuCommand::kRemove:
+      // Leaves any open tab alone; it simply becomes an ordinary tab again.
+      delegate_->OnEntryRemoved(entry_id_);
+      break;
+    default:
+      break;
+  }
+}
+
+void WorkspaceEntryView::ResolveIcon() {
+  favicon_tracker_.TryCancelAll();
+
+  // 1. The live tab, but only once it has a favicon the site actually
+  // served. A tab still loading reports the placeholder globe, and taking it
+  // here would blank out an entry that already has a perfectly good icon --
+  // reopening a closed entry would visibly lose its logo.
+  //
+  // Never its throbber, either: a sidebar row is a bookmark-like thing, and
+  // spinning it on every reload reads as jank rather than as progress.
+  if (tabs::TabInterface* tab = bound_tab_.get()) {
+    if (helium_workspace::TabHasRealFavicon(tab)) {
+      tabs::TabData data = tabs::TabData::FromTabInterface(tab);
+      data.network_state = tabs::TabNetworkState::kNone;
+      data.should_hide_throbber = true;
+      icon_->SetData(std::move(data));
+      return;
+    }
+  }
+
+  // 2. The icon persisted with the entry -- the only one available on a cold
+  // start, before anything has been clicked.
+  if (!favicon_png_.empty()) {
+    const SkBitmap bitmap =
+        gfx::PNGCodec::Decode(base::as_byte_span(favicon_png_));
+    if (!bitmap.isNull() && bitmap.width() > 0) {
+      // The stored PNG carries whatever density the tab had, so recover the
+      // scale from its pixel width instead of assuming 1x -- otherwise a 32px
+      // icon is drawn as 32 dip, and a 16px one is stretched on a Retina
+      // display. Dividing by kFaviconSize normalises any source size to the
+      // 16 dip the row draws at.
+      const float scale =
+          static_cast<float>(bitmap.width()) / gfx::kFaviconSize;
+      ApplyIcon(ui::ImageModel::FromImageSkia(
+          gfx::ImageSkia::CreateFromBitmap(bitmap, scale)));
+      return;
+    }
+  }
+
+  // 3. Whatever history already knows about the URL.
+  if (profile_ && url_.is_valid()) {
+    if (favicon::FaviconService* service =
+            FaviconServiceFactory::GetForProfile(
+                profile_, ServiceAccessType::EXPLICIT_ACCESS)) {
+      ApplyIcon(favicon::GetDefaultFaviconModel());
+      service->GetFaviconImageForPageURL(
+          url_,
+          base::BindOnce(&WorkspaceEntryView::OnFaviconFetched,
+                         weak_factory_.GetWeakPtr()),
+          &favicon_tracker_);
+      return;
+    }
+  }
+
+  // 4. TabIcon draws nothing at all for an empty ImageModel, so the default
+  // globe is a requirement rather than a nicety.
+  ApplyIcon(favicon::GetDefaultFaviconModel());
+}
+
+void WorkspaceEntryView::OnFaviconFetched(
+    const favicon_base::FaviconImageResult& result) {
+  if (result.image.IsEmpty()) {
+    return;
+  }
+  ApplyIcon(ui::ImageModel::FromImage(result.image));
+}
+
+void WorkspaceEntryView::ApplyIcon(const ui::ImageModel& favicon) {
+  tabs::TabData data;
+  data.title = title_;
+  data.favicon = favicon;
+  data.should_display_favicon = true;
+  data.network_state = tabs::TabNetworkState::kNone;
+  data.should_hide_throbber = true;
+  data.visible_url = url_;
+  data.last_committed_url = url_;
+  icon_->SetData(data);
+}
+
+void WorkspaceEntryView::UpdateAccessibleState() {
+  GetViewAccessibility().SetName(
+      title_.empty() ? base::UTF8ToUTF16(url_.spec()) : title_);
+  // A capsule draws no text at all, so the tooltip is the only way to tell
+  // one favorite from another.
+  SetTooltipText(title_.empty()
+                     ? base::UTF8ToUTF16(url_.spec())
+                     : title_ + u"\n" + base::UTF8ToUTF16(url_.spec()));
+}
+
