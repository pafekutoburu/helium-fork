+// Two presentations, matching Arc: Favorites are a fixed-height capsule with
+// a centred icon and no text, Pinned entries are a full-width row with icon
+// and title. Only TabIcon and TabTitle are reused from the tab strip;
+// TabView::OnPaint is deliberately not, because it pulls in TabStyle,
+// GlowHoverController, theme-image lookups and the drag plumbing.
+class WorkspaceEntryView : public views::View,
+                           public views::ContextMenuController,
+                           public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(WorkspaceEntryView, views::View)
+
+ public:
+  class Delegate {
+   public:
+    virtual void OnEntryActivated(const std::string& entry_id) = 0;
+    virtual void OnEntryToggleFavorite(const std::string& entry_id) = 0;
+    virtual void OnEntryRemoved(const std::string& entry_id) = 0;
+    // False when promoting would exceed the favorites cap.
+    virtual bool CanEntryBecomeFavorite(const std::string& entry_id) const = 0;
+
+   protected:
