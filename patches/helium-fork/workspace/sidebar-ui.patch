+// Arc favorites grid metrics: spacing between capsules, the gap separating
+// the grid from the space header, the per-row capsule maximum (the 12-entry
+// cap in three rows) and the height of the persistent empty state.
+constexpr int kTabPadding = 4;
+constexpr int kFavoriteGridGap = 8;
+constexpr int kSectionGap = 8;
+constexpr int kMaxFavoritesPerRow = 4;
+constexpr int kFavoritesPlaceholderHeight = 90;
+
+// Arc space header row metrics.
+constexpr int kSpaceHeaderHeight = 28;
+constexpr int kSpaceHeaderChevronSize = 16;
+constexpr int kSpaceHeaderInnerSpacing = 4;
+constexpr int kSpaceHeaderHorizontalInset = 6;
+
+int GridPerRowMax(int available_width, int min_child_width) {
+  return std::clamp(
+      (available_width + kFavoriteGridGap) / (min_child_width + kFavoriteGridGap),
+      1, kMaxFavoritesPerRow);
+}
+
+// Arc-style persistent placeholder shown while the Favorites grid is empty.
+// Draws a dashed rounded outline with a hint, and never intercepts events.
+class FavoritesEmptyPlaceholder : public views::View {
+  METADATA_HEADER(FavoritesEmptyPlaceholder, views::View)
+
+ public:
+  FavoritesEmptyPlaceholder() {
+    SetCanProcessEventsWithinSubtree(false);
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(12, 16), 2));
+    layout->set_main_axis_alignment(
+        views::BoxLayout::MainAxisAlignment::kCenter);
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+
+    auto* star = AddChildView(std::make_unique<views::ImageView>());
+    star->SetImage(ui::ImageModel::FromVectorIcon(
+        omnibox::kStarFilledIcon, ui::kColorLabelForegroundSecondary, 16));
+
+    // The tab strip paints into non-opaque scroll layers, so labels here
+    // must opt out of the subpixel-rendering opacity DCHECK, same as every
+    // other label in the tab strip (see tab_title.cc).
+    auto* title = AddChildView(std::make_unique<views::Label>(
+        l10n_util::GetStringUTF16(IDS_HELIUM_WS_FAVORITES_PLACEHOLDER_TITLE),
+        views::style::CONTEXT_LABEL, views::style::STYLE_EMPHASIZED));
+    title->SetSkipSubpixelRenderingOpacityCheck(true);
+
+    auto* subtitle = AddChildView(std::make_unique<views::Label>(
+        l10n_util::GetStringUTF16(IDS_HELIUM_WS_FAVORITES_PLACEHOLDER_SUBTITLE),
+        views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+    subtitle->SetMultiLine(true);
+    subtitle->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    subtitle->SetSkipSubpixelRenderingOpacityCheck(true);
+  }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override {
+    views::View::OnPaint(canvas);
+    if (!GetColorProvider()) {
+      return;
+    }
+    cc::PaintFlags flags;
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(1.0f);
+    flags.setAntiAlias(true);
+    static constexpr float kDashIntervals[] = {4, 3};
+    flags.setPathEffect(cc::PathEffect::MakeDash(kDashIntervals, 2, 0));
+    flags.setColor(
+        GetColorProvider()->GetColor(kColorVerticalTabPinnedOutline));
+    gfx::RectF rect(GetLocalBounds());
+    rect.Inset(0.5f);
+    canvas->DrawRoundRect(
+        rect,
+        GetLayoutConstant(LayoutConstant::kVerticalTabFavoriteCornerRadius),
+        flags);
+  }
+};
