+// helium-fork: Arc's space name row, which always sits between the Favorites
+// grid and the full-row pinned section. It is permanent even when the section
+// below it is empty — that is what gives pinned tabs a drop target instead of
+// the hairline gap left by the section separator. Clicking anywhere on the row
+// collapses/expands the rows below.
+class WorkspaceSpaceHeader : public views::View {
+  METADATA_HEADER(WorkspaceSpaceHeader, views::View)
+
+ public:
+  explicit WorkspaceSpaceHeader(base::RepeatingClosure on_toggled)
+      : on_toggled_(std::move(on_toggled)) {
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal,
+        gfx::Insets::VH(0, kSpaceHeaderHorizontalInset),
+        kSpaceHeaderInnerSpacing));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+
+    chevron_ = AddChildView(std::make_unique<views::ImageView>());
+
+    // The tab strip paints into non-opaque scroll layers, so labels here must
+    // opt out of the subpixel-rendering opacity DCHECK, same as every other
+    // label in the tab strip (see tab_title.cc).
+    auto* title = AddChildView(std::make_unique<views::Label>(
+        l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_DEFAULT_NAME),
+        views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+    title->SetSkipSubpixelRenderingOpacityCheck(true);
+    title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    layout->SetFlexForView(title, 1);
+
+    GetViewAccessibility().SetRole(ax::mojom::Role::kButton);
+    GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_DEFAULT_NAME));
+
+    UpdateChevron();
+  }
+
+  void SetCollapsed(bool collapsed) {
+    if (collapsed_ == collapsed) {
+      return;
+    }
+    collapsed_ = collapsed;
+    UpdateChevron();
+  }
+
+  // Highlights the whole row while it is the active drop target for a tab
+  // drag, the way Arc does. Without it there is no feedback that an empty
+  // pinned section is about to receive the tab.
+  void SetDropTargetActive(bool active) {
+    if (drop_target_active_ == active) {
+      return;
+    }
+    drop_target_active_ = active;
+    SchedulePaint();
+  }
+
+  // views::View:
+  void OnThemeChanged() override {
+    views::View::OnThemeChanged();
+    UpdateChevron();
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    if (drop_target_active_ && GetColorProvider()) {
+      cc::PaintFlags flags;
+      flags.setStyle(cc::PaintFlags::kFill_Style);
+      flags.setAntiAlias(true);
+      flags.setColor(GetColorProvider()->GetColor(
+          kColorVerticalTabSpaceHeaderDropTarget));
+      canvas->DrawRoundRect(
+          gfx::RectF(GetLocalBounds()),
+          GetLayoutConstant(LayoutConstant::kVerticalTabFavoriteCornerRadius),
+          flags);
+    }
+    views::View::OnPaint(canvas);
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    return event.IsOnlyLeftMouseButton();
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (event.IsOnlyLeftMouseButton() && HitTestPoint(event.location())) {
+      on_toggled_.Run();
+    }
+  }
+
+ private:
+  void UpdateChevron() {
+    chevron_->SetImage(ui::ImageModel::FromVectorIcon(
+        collapsed_ ? vector_icons::kKeyboardArrowRightFlippableIcon
+                   : vector_icons::kKeyboardArrowDownIcon,
+        ui::kColorLabelForegroundSecondary, kSpaceHeaderChevronSize));
+  }
+
+  const base::RepeatingClosure on_toggled_;
+  raw_ptr<views::ImageView> chevron_ = nullptr;
+  bool collapsed_ = false;
+  bool drop_target_active_ = false;
+};
+
+BEGIN_METADATA(WorkspaceSpaceHeader)
+END_METADATA
