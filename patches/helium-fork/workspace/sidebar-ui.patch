+void PinnedTabContainerView::AddedToWidget() {
+  views::View::AddedToWidget();
+  // helium-fork: the browser (and therefore the profile prefs holding the
+  // collapsed flag) is only reachable once the widget exists.
+  LoadSpaceCollapsedFromPrefs();
+}
+
+PrefService* PinnedTabContainerView::GetProfilePrefs() const {
+  if (!GetWidget()) {
+    return nullptr;
+  }
+  gfx::NativeWindow window = GetWidget()->GetNativeWindow();
+  if (!window) {
+    return nullptr;
+  }
+  BrowserView* browser_view =
+      BrowserView::GetBrowserViewForNativeWindow(window);
+  if (!browser_view || !browser_view->browser()) {
+    return nullptr;
+  }
+  return browser_view->browser()->profile()->GetPrefs();
+}
+
+void PinnedTabContainerView::LoadSpaceCollapsedFromPrefs() {
+  PrefService* prefs = GetProfilePrefs();
+  if (!prefs) {
+    return;
+  }
+  const bool collapsed =
+      prefs->GetBoolean(helium_workspace::prefs::kWorkspaceSpaceCollapsed);
+  if (collapsed == space_collapsed_) {
+    return;
+  }
+  space_collapsed_ = collapsed;
+  if (auto* header = views::AsViewClass<WorkspaceSpaceHeader>(space_header_)) {
+    header->SetCollapsed(space_collapsed_);
+  }
+  InvalidateLayout();
+}
+
+void PinnedTabContainerView::SetSpaceHeaderDropTargetActive(bool active) {
+  if (auto* header = views::AsViewClass<WorkspaceSpaceHeader>(space_header_)) {
+    header->SetDropTargetActive(active);
+  }
+}
+
+void PinnedTabContainerView::ToggleSpaceCollapsed() {
+  space_collapsed_ = !space_collapsed_;
+  if (auto* header = views::AsViewClass<WorkspaceSpaceHeader>(space_header_)) {
+    header->SetCollapsed(space_collapsed_);
+  }
+  if (PrefService* prefs = GetProfilePrefs()) {
+    prefs->SetBoolean(helium_workspace::prefs::kWorkspaceSpaceCollapsed,
+                      space_collapsed_);
+  }
+  InvalidateLayout();
+}
+
+size_t PinnedTabContainerView::CountLeadingFavorites(
+    const std::vector<views::View*>& children) const {
+  size_t count = 0;
+  for (views::View* child : children) {
+    TabView* tab_view = views::AsViewClass<TabView>(child);
+    if (!tab_view || !tab_view->IsFavoriteWorkspaceTab()) {
+      break;
+    }
+    ++count;
+  }
+  return count;
+}
