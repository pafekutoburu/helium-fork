+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_COMMON_WORKSPACE_SIDEBAR_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_COMMON_WORKSPACE_SIDEBAR_VIEW_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/ui/helium_workspace/workspace_service.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "chrome/browser/ui/views/tabs/common/workspace_entry_view.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+class BrowserWindowInterface;
+class PrefService;
+class Profile;
+class TabStripModel;
+
+// The whole workspace sidebar: the Favorites capsule grid, the collapsible
+// space header, and the full-row Pinned entries. It renders
+// WorkspaceService::entries() -- profile data -- rather than the window's
+// pinned tab collection, which is why a new window shows a complete sidebar
+// on its first frame.
+//
+// This lives one level below PinnedTabContainerView instead of inside it
+// because pinned_tab_container_view.h belongs to the "common" source_set,
+// whose dependencies cannot reach //chrome/browser/ui, and observing the
+// service needs the complete WorkspaceService type in a header.
+class WorkspaceSidebarView : public views::View,
+                             public helium_workspace::WorkspaceService::Observer,
+                             public TabStripModelObserver,
+                             public WorkspaceEntryView::Delegate {
+  METADATA_HEADER(WorkspaceSidebarView, views::View)
+
+ public:
+  WorkspaceSidebarView();
+  WorkspaceSidebarView(const WorkspaceSidebarView&) = delete;
+  WorkspaceSidebarView& operator=(const WorkspaceSidebarView&) = delete;
+  ~WorkspaceSidebarView() override;
+
+  // views::View:
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  gfx::Size GetMinimumSize() const override;
+  void Layout(PassKey) override;
+
+  // helium_workspace::WorkspaceService::Observer:
+  void OnWorkspaceEntriesChanged() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+  // WorkspaceEntryView::Delegate:
+  void OnEntryActivated(const std::string& entry_id) override;
+  void OnEntryToggleFavorite(const std::string& entry_id) override;
+  void OnEntryRemoved(const std::string& entry_id) override;
+  bool CanEntryBecomeFavorite(const std::string& entry_id) const override;
+
+ private:
+  // Geometry of one layout pass, shared by Layout() and the preferred-size
+  // calculation so the two can never disagree.
+  struct SidebarLayout {
+    int height = 0;
+    std::vector<gfx::Rect> entry_bounds;  // Parallel to |ordered_entries_|.
+    gfx::Rect placeholder_bounds;
+    gfx::Rect header_bounds;
+    bool placeholder_visible = false;
+  };
+
+  // Resolves the browser this sidebar belongs to; only valid once the widget
+  // exists.
+  BrowserWindowInterface* GetBrowserWindow() const;
+  PrefService* GetProfilePrefs() const;
+  void LoadSpaceCollapsedFromPrefs();
+  void ToggleSpaceCollapsed();
+
+  // Brings |entry_views_| in line with the service. Reconciles rather than
+  // rebuilds: OnWorkspaceEntriesChanged() fires on every persisted title
+  // change, and re-creating every row would restart every favicon fetch.
+  void SyncEntryViews();
+  // Pushes the per-window facts (which entry has a tab here, which one is
+  // active) onto the rows.
+  void SyncBindings();
+
+  SidebarLayout ComputeLayout(int width) const;
+
+  raw_ptr<Profile> profile_ = nullptr;
+  raw_ptr<helium_workspace::WorkspaceService> service_ = nullptr;
+
+  raw_ptr<views::View> placeholder_ = nullptr;
+  raw_ptr<views::View> space_header_ = nullptr;
+  bool space_collapsed_ = false;
+
+  // Entry id -> row, plus the model order the layout walks.
+  std::map<std::string, raw_ptr<WorkspaceEntryView>> entry_views_;
+  std::vector<raw_ptr<WorkspaceEntryView>> ordered_entries_;
+  size_t favorite_count_ = 0;
+
+  base::ScopedObservation<helium_workspace::WorkspaceService,
+                          helium_workspace::WorkspaceService::Observer>
+      service_observation_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_WORKSPACE_SIDEBAR_VIEW_H_
