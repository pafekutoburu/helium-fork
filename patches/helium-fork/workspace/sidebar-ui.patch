+WorkspaceSidebarView::WorkspaceSidebarView() {
+  placeholder_ = AddChildView(std::make_unique<FavoritesEmptyPlaceholder>());
+  space_header_ = AddChildView(std::make_unique<WorkspaceSpaceHeader>(
+      base::BindRepeating(&WorkspaceSidebarView::ToggleSpaceCollapsed,
+                          base::Unretained(this))));
+}
+
+WorkspaceSidebarView::~WorkspaceSidebarView() {
+  // The tab strip observation unregisters itself: ~TabStripModelObserver
+  // calls StopObservingAll(). Reaching for the widget here to do it by hand
+  // would be worse than redundant -- by this point it may already be gone.
+  service_observation_.Reset();
+}
+
+void WorkspaceSidebarView::AddedToWidget() {
+  views::View::AddedToWidget();
+  // The browser -- and so the profile, the service and this window's tab
+  // strip -- is only reachable once the widget exists.
+  BrowserWindowInterface* browser = GetBrowserWindow();
+  if (!browser) {
+    return;
+  }
+  profile_ = browser->GetProfile();
+  // Null for off-the-record profiles, which have no sidebar of their own and
+  // must not render the parent profile's.
+  service_ = helium_workspace::WorkspaceServiceFactory::GetForProfile(profile_);
+  if (!service_) {
+    return;
+  }
+  service_observation_.Observe(service_);
+  if (TabStripModel* model = browser->GetTabStripModel()) {
+    model->AddObserver(this);
+  }
+  LoadSpaceCollapsedFromPrefs();
+  SyncEntryViews();
+}
+
+void WorkspaceSidebarView::RemovedFromWidget() {
+  service_observation_.Reset();
+  TabStripModelObserver::StopObservingAll(this);
+  service_ = nullptr;
+  profile_ = nullptr;
+  views::View::RemovedFromWidget();
+}
+
+BrowserWindowInterface* WorkspaceSidebarView::GetBrowserWindow() const {
+  if (!GetWidget()) {
+    return nullptr;
+  }
+  gfx::NativeWindow window = GetWidget()->GetNativeWindow();
+  if (!window) {
+    return nullptr;
+  }
+  BrowserView* browser_view =
+      BrowserView::GetBrowserViewForNativeWindow(window);
+  return browser_view ? browser_view->browser() : nullptr;
+}
+
+PrefService* WorkspaceSidebarView::GetProfilePrefs() const {
+  return profile_ ? profile_->GetPrefs() : nullptr;
+}
+
+void WorkspaceSidebarView::LoadSpaceCollapsedFromPrefs() {
+  PrefService* prefs = GetProfilePrefs();
+  if (!prefs) {
+    return;
+  }
+  const bool collapsed =
+      prefs->GetBoolean(helium_workspace::prefs::kWorkspaceSpaceCollapsed);
+  if (collapsed == space_collapsed_) {
+    return;
+  }
+  space_collapsed_ = collapsed;
+  if (auto* header = views::AsViewClass<WorkspaceSpaceHeader>(space_header_)) {
+    header->SetCollapsed(space_collapsed_);
+  }
+  InvalidateLayout();
+}
+
+void WorkspaceSidebarView::ToggleSpaceCollapsed() {
+  space_collapsed_ = !space_collapsed_;
+  if (auto* header = views::AsViewClass<WorkspaceSpaceHeader>(space_header_)) {
+    header->SetCollapsed(space_collapsed_);
+  }
+  if (PrefService* prefs = GetProfilePrefs()) {
+    prefs->SetBoolean(helium_workspace::prefs::kWorkspaceSpaceCollapsed,
+                      space_collapsed_);
+  }
+  PreferredSizeChanged();
+  InvalidateLayout();
+}
+
+void WorkspaceSidebarView::OnWorkspaceEntriesChanged() {
+  SyncEntryViews();
+}
+
+void WorkspaceSidebarView::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  SyncBindings();
+}
+
+void WorkspaceSidebarView::SyncEntryViews() {
+  if (!service_) {
+    return;
+  }
+
+  const std::vector<helium_workspace::WorkspaceEntry>& entries =
+      service_->entries();
+
+  // Drop rows whose entry is gone.
+  std::vector<std::string> stale;
+  for (const auto& [id, view] : entry_views_) {
+    const bool still_there =
+        std::ranges::any_of(entries, [&id](const auto& e) {
+          return e.id == id;
+        });
+    if (!still_there) {
+      stale.push_back(id);
+    }
+  }
+  bool structure_changed = !stale.empty();
+  for (const std::string& id : stale) {
+    RemoveChildViewT(entry_views_[id].get());
+    entry_views_.erase(id);
+  }
+
+  // Create or update the rest, and rebuild the model order.
+  std::vector<raw_ptr<WorkspaceEntryView>> ordered;
+  ordered.reserve(entries.size());
+  size_t favorites = 0;
+  for (const helium_workspace::WorkspaceEntry& entry : entries) {
+    auto it = entry_views_.find(entry.id);
+    WorkspaceEntryView* view = nullptr;
+    if (it == entry_views_.end()) {
+      view = AddChildView(
+          std::make_unique<WorkspaceEntryView>(this, profile_.get()));
+      entry_views_[entry.id] = view;
+      structure_changed = true;
+    } else {
+      view = it->second.get();
+      if (!ordered_entries_.empty() && ordered.size() < ordered_entries_.size() &&
+          ordered_entries_[ordered.size()].get() != view) {
+        structure_changed = true;
+      }
+    }
+    const bool was_capsule = view->renders_as_capsule();
+    view->SetEntry(entry);
+    if (was_capsule != view->renders_as_capsule()) {
+      structure_changed = true;
+    }
+    ordered.push_back(view);
+    if (entry.section == helium_workspace::WorkspaceEntry::Section::kFavorite) {
+      ++favorites;
+    }
+  }
+  if (ordered.size() != ordered_entries_.size()) {
+    structure_changed = true;
+  }
+  ordered_entries_ = std::move(ordered);
+  favorite_count_ = favorites;
+
+  SyncBindings();
+
+  // A title or favicon write-back fires this method too; only a change in
+  // membership, order or section can move anything.
+  if (structure_changed) {
+    PreferredSizeChanged();
+    InvalidateLayout();
+  }
+}
+
+void WorkspaceSidebarView::SyncBindings() {
+  if (!service_) {
+    return;
+  }
+  BrowserWindowInterface* browser = GetBrowserWindow();
+  if (!browser) {
+    return;
+  }
+  TabStripModel* model = browser->GetTabStripModel();
+  tabs::TabInterface* active_tab =
+      (model && !model->empty()) ? model->GetTabAtIndex(model->active_index())
+                                 : nullptr;
+
+  for (WorkspaceEntryView* view : ordered_entries_) {
+    const tabs::TabHandle handle =
+        service_->FindTabForEntryInWindow(view->entry_id(), browser);
+    tabs::TabInterface* tab = handle.Get();
+    view->SetBoundTab(tab);
+    view->SetActive(tab && tab == active_tab);
+  }
+}
+
+WorkspaceSidebarView::SidebarLayout WorkspaceSidebarView::ComputeLayout(
+    int width) const {
+  SidebarLayout out;
+  out.entry_bounds.resize(ordered_entries_.size());
+
+  const int min_child_width =
+      GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth);
+  const int available_width = std::max(
+      0,
+      width - GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding));
+  const int row_width = std::max(available_width, min_child_width);
+  const int per_row_max = available_width > 0
+                              ? GridPerRowMax(available_width, min_child_width)
+                              : kMaxFavoritesPerRow;
+
+  int y = 0;
+
+  if (favorite_count_ == 0) {
+    out.placeholder_visible = true;
+    out.placeholder_bounds =
+        gfx::Rect(0, 0, row_width, kFavoritesPlaceholderHeight);
+    y = kFavoritesPlaceholderHeight;
+  } else {
+    const helium_workspace::FavoritesGridPlan plan =
+        helium_workspace::PlanFavoritesGrid(static_cast<int>(favorite_count_),
+                                            per_row_max);
+    const int capsule_height =
+        GetLayoutConstant(LayoutConstant::kVerticalTabFavoriteHeight);
+    size_t index = 0;
+    for (int row = 0; row < plan.rows; ++row) {
+      const int cols = helium_workspace::FavoritesGridColsForRow(plan, row);
+      const int capsule_width = std::max(
+          min_child_width,
+          (row_width - (cols - 1) * kFavoriteGridGap) / std::max(cols, 1));
+      int x = 0;
+      for (int col = 0; col < cols && index < favorite_count_; ++col, ++index) {
+        out.entry_bounds[index] =
+            gfx::Rect(x, y, capsule_width, capsule_height);
+        x += capsule_width + kFavoriteGridGap;
+      }
+      y += capsule_height;
+      if (row + 1 < plan.rows) {
+        y += kFavoriteGridGap;
+      }
+    }
+  }
+
+  y += kSectionGap;
+  out.header_bounds = gfx::Rect(0, y, row_width, kSpaceHeaderHeight);
+  y += kSpaceHeaderHeight;
+
+  const int row_height = GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+  if (!space_collapsed_) {
+    for (size_t i = favorite_count_; i < ordered_entries_.size(); ++i) {
+      y += kTabPadding;
+      out.entry_bounds[i] = gfx::Rect(0, y, row_width, row_height);
+      y += row_height;
+    }
+  }
+
+  out.height = y;
+  return out;
+}
+
+gfx::Size WorkspaceSidebarView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  const int width = available_size.width().is_bounded()
+                        ? available_size.width().value()
+                        : GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth);
+  return gfx::Size(width, ComputeLayout(width).height);
+}
+
+gfx::Size WorkspaceSidebarView::GetMinimumSize() const {
+  // Deliberately not ComputeLayout(): at an unbounded width the grid plans a
+  // single column, so twelve favorites would claim twelve rows of minimum
+  // height and squeeze Today out of the strip entirely. What the sidebar
+  // actually needs is the space header (permanent -- it is the pinned
+  // section's visible edge), the empty-state placeholder while the grid is
+  // empty, and one row's worth of content.
+  int height = kSpaceHeaderHeight + kSectionGap;
+  height += favorite_count_ == 0
+                ? kFavoritesPlaceholderHeight
+                : GetLayoutConstant(LayoutConstant::kVerticalTabFavoriteHeight);
+  if (ordered_entries_.size() > favorite_count_ && !space_collapsed_) {
+    height +=
+        kTabPadding + GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+  }
+  return gfx::Size(GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth),
+                   height);
+}
+
+void WorkspaceSidebarView::Layout(PassKey) {
+  const SidebarLayout layout = ComputeLayout(width());
+
+  if (placeholder_) {
+    placeholder_->SetVisible(layout.placeholder_visible);
+    if (layout.placeholder_visible) {
+      placeholder_->SetBoundsRect(layout.placeholder_bounds);
+    }
+  }
+  if (space_header_) {
+    space_header_->SetBoundsRect(layout.header_bounds);
+  }
+  for (size_t i = 0; i < ordered_entries_.size(); ++i) {
+    WorkspaceEntryView* view = ordered_entries_[i].get();
+    const bool visible = i < favorite_count_ || !space_collapsed_;
+    view->SetVisible(visible);
+    if (visible) {
+      view->SetBoundsRect(layout.entry_bounds[i]);
+    }
+  }
+}
+
+void WorkspaceSidebarView::OnEntryActivated(const std::string& entry_id) {
+  if (auto* controller =
+          helium_workspace::WorkspaceTabController::From(GetBrowserWindow())) {
+    controller->OpenEntry(entry_id);
+  }
+}
+
+void WorkspaceSidebarView::OnEntryToggleFavorite(const std::string& entry_id) {
+  if (!service_) {
+    return;
+  }
+  const helium_workspace::WorkspaceEntry* entry =
+      service_->FindEntryById(entry_id);
+  if (!entry) {
+    return;
+  }
+  service_->SetEntrySection(
+      entry_id,
+      entry->section == helium_workspace::WorkspaceEntry::Section::kFavorite
+          ? helium_workspace::WorkspaceEntry::Section::kPinned
+          : helium_workspace::WorkspaceEntry::Section::kFavorite);
+}
+
+void WorkspaceSidebarView::OnEntryRemoved(const std::string& entry_id) {
+  if (service_) {
+    service_->RemoveEntry(entry_id);
+  }
+}
+
+bool WorkspaceSidebarView::CanEntryBecomeFavorite(
+    const std::string& entry_id) const {
+  if (!service_) {
+    return false;
+  }
+  const helium_workspace::WorkspaceEntry* entry =
+      service_->FindEntryById(entry_id);
+  if (!entry) {
+    return false;
+  }
+  return entry->section ==
+             helium_workspace::WorkspaceEntry::Section::kFavorite ||
+         service_->CountFavorites() <
+             helium_workspace::WorkspaceService::kMaxFavorites;
+}
+
+BEGIN_METADATA(WorkspaceSidebarView)
+END_METADATA
