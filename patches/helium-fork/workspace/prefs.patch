--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/workspace_prefs.h
@@ -0,0 +1,31 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_PREFS_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_PREFS_H_
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}  // namespace user_prefs
+
+namespace helium_workspace::prefs {
+
+// List of dicts describing the persistent Favorites/Pinned entries of the
+// workspace sidebar. See workspace_entry.h for the schema.
+inline constexpr char kWorkspaceEntries[] = "helium.workspace.entries";
+
+// Set once, the first time WorkspaceService runs against a profile whose
+// entries used to be backed by real native pinned tabs. Those tabs were
+// written into prefs::kPinnedTabs on every exit and re-navigated on every
+// start; the entries now live entirely in kWorkspaceEntries, so the stale
+// list is cleared exactly once and this flag stops us clearing a list the
+// user has since populated themselves.
+inline constexpr char kWorkspaceMigratedFromPinnedTabs[] =
+    "helium.workspace.migrated_from_pinned_tabs";
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+}  // namespace helium_workspace::prefs
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_PREFS_H_
