+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_prefs.h"
+
+#include "components/pref_registry/pref_registry_syncable.h"
+
+namespace helium_workspace::prefs {
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterListPref(kWorkspaceEntries);
+  registry->RegisterBooleanPref(kWorkspaceMigratedFromPinnedTabs, false);
+}
+
+}  // namespace helium_workspace::prefs
