+void WorkspaceSidebarView::AnimationProgressed(const gfx::Animation* animation) {
+  if (animation != &folder_animation_ &&
+      animation != &folder_fade_animation_) {
+    return;
+  }
+  if (auto* header = views::AsViewClass<WorkspaceSpaceHeader>(space_header_)) {
+    // The tween runs from the state we left, so "how closed the folder is"
+    // is the value itself when closing and its complement when opening.
+    const double t = folder_animation_.GetCurrentValue();
+    header->SetCollapsedProgress(space_collapsed_ ? t : 1.0 - t);
+  }
+  // The height is what actually moves, and it is this view's preferred size:
+  // asking for it again on every frame is what slides everything below the
+  // sidebar.
   PreferredSizeChanged();
   InvalidateLayout();
 }
 
+void WorkspaceSidebarView::AnimationEnded(const gfx::Animation* animation) {
+  if (animation == &folder_animation_) {
+    folder_prev_layout_valid_ = false;
+  }
+  AnimationProgressed(animation);
+}
