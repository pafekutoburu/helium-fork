+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_pin_semantics.h"
+
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+
+namespace helium_workspace {
+
+bool IsTabAtPinnedUrl(const tabs::TabInterface* tab, const GURL& pinned_url) {
+  if (!tab) {
+    return false;
+  }
+  content::WebContents* contents = tab->GetContents();
+  if (!contents) {
+    return false;
+  }
+  content::NavigationEntry* entry =
+      contents->GetController().GetLastCommittedEntry();
+  base::span<const GURL> chain;
+  if (entry) {
+    chain = entry->GetRedirectChain();
+  }
+  return IsAtPinnedUrl(contents->GetLastCommittedURL(), pinned_url, chain);
+}
+
+bool IsTabDriftedFromPinnedUrl(const tabs::TabInterface* tab,
+                               const GURL& pinned_url) {
+  if (!tab) {
+    return false;
+  }
+  content::WebContents* contents = tab->GetContents();
+  if (!contents) {
+    return false;
+  }
+  // GetLastCommittedEntry() never returns null once the FrameTree exists: a
+  // tab that has committed nothing still reports the synthetic *initial*
+  // entry. IsInitialEntry() is the only way to tell that apart from a real
+  // commit, and it is exactly the state a freshly opened pinned tab is in.
+  const content::NavigationEntry* entry =
+      contents->GetController().GetLastCommittedEntry();
+  base::span<const GURL> chain;
+  if (entry) {
+    chain = entry->GetRedirectChain();
+  }
+  return IsDriftedFromPinnedUrl(entry && !entry->IsInitialEntry(),
+                                contents->GetLastCommittedURL(), pinned_url,
+                                chain);
+}
+
+}  // namespace helium_workspace
