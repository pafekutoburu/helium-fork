+  // Read the WebContents, not TabData: the latter dereferences TabUIHelper,
+  // which is already gone for a tab mid-removal (see the controller's
+  // kRemoved note). A bound tab's contents are alive by construction.
+  content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return;
+  }
+  view->SetLiveState(
+      contents->GetTitle(),
+      helium_workspace::IsTabDriftedFromPinnedUrl(tab, view->url()));
+}
