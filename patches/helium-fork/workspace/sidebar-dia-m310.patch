+int LerpInt(int from, int to, double t) {
+  return from + base::ClampRound((to - from) * t);
+}
+
+gfx::Rect LerpRect(const gfx::Rect& from, const gfx::Rect& to, double t) {
+  return gfx::Rect(LerpInt(from.x(), to.x(), t), LerpInt(from.y(), to.y(), t),
+                   LerpInt(from.width(), to.width(), t),
+                   LerpInt(from.height(), to.height(), t));
+}
