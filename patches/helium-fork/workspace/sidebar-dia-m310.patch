+                                       TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+}
+
+void WorkspaceTabController::ResetEntryTab(const std::string& entry_id) {
+  TabStripModel* model = browser_window_->GetTabStripModel();
+  const WorkspaceEntry* entry = service_->FindEntryById(entry_id);
+  if (!model || !entry) {
+    return;
+  }
+  tabs::TabInterface* tab =
+      service_->FindTabForEntryInWindow(entry_id, browser_window_).Get();
+  content::WebContents* contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    OpenEntry(entry_id);
+    return;
+  }
+  // A bookmark-like transition: the user asked for "the page I pinned", not
+  // for a link the page offered. The title and icon write-back resumes on
+  // its own once this commits (OnTabChangedAt sees the tab at home again).
+  contents->GetController().LoadURL(entry->url, content::Referrer(),
+                                    ui::PAGE_TRANSITION_AUTO_BOOKMARK,
+                                    std::string());
+  const int index = model->GetIndexOfTab(tab);
+  if (index >= 0) {
+    model->ActivateTabAt(
+        index, TabStripUserGestureDetails(
+                   TabStripUserGestureDetails::GestureType::kOther));
+  }
+}
