+void WorkspaceEntryView::SetFolderMotion(bool in_motion, float opacity) {
+  if (folder_in_motion_ == in_motion && fade_opacity_ == opacity) {
+    return;
+  }
+  folder_in_motion_ = in_motion;
+  fade_opacity_ = opacity;
+  // The layer does two jobs, both only for the ~150ms the folder is moving:
+  //
+  //  - it is the only way to fade a whole subtree (the fill is ours, but the
+  //    favicon and both labels are child views);
+  //  - it takes the row out from under View::Paint's clip to its parent's
+  //    bounds. The sidebar's bounds are what the tween animates, so a
+  //    non-layered row is cut off at the opening folder's edge -- the rows
+  //    wipe in from the top and the active row's shadow (region-owned, never
+  //    clipped) is left hanging on its own. Dia clips nothing: its rows are
+  //    at their final places from the first frame and whatever is below
+  //    slides out from under them.
+  //
+  // A permanent layer would cost a texture per row and put every row above
+  // its non-layered siblings, so it goes again the moment the tween stops.
+  if (!in_motion && opacity >= 1.0f) {
+    if (layer()) {
+      DestroyLayer();
+    }
+    return;
+  }
+  if (!layer()) {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+  }
+  layer()->SetOpacity(opacity);
+}
