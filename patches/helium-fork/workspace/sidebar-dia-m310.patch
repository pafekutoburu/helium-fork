+#include "chrome/browser/ui/helium_workspace/workspace_pin_semantics.h"
+
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace helium_workspace {
+namespace {
+
+const GURL kPinned("https://example.com/");
+
+// The ordinary case: the tab is exactly where it was pinned.
+TEST(WorkspacePinSemanticsTest, TheSameUrlIsHome) {
+  const std::vector<GURL> chain = {kPinned};
+  EXPECT_TRUE(IsAtPinnedUrl(kPinned, kPinned, chain));
+  // A chain is not required for the exact match.
+  EXPECT_TRUE(IsAtPinnedUrl(kPinned, kPinned, {}));
+}
+
+// Pinned at the root, served a redirect to /home: the navigation *started*
+// at the pinned URL, so this is still the pinned page.
+TEST(WorkspacePinSemanticsTest, AServerRedirectFromThePinnedUrlIsHome) {
+  const std::vector<GURL> chain = {kPinned, GURL("https://example.com/home")};
+  EXPECT_TRUE(
+      IsAtPinnedUrl(GURL("https://example.com/home"), kPinned, chain));
+}
+
+// Clicking around the site leaves home, same origin or not.
+TEST(WorkspacePinSemanticsTest, NavigatingAwayIsNotHome) {
+  const GURL away("https://example.com/settings");
+  EXPECT_FALSE(IsAtPinnedUrl(away, kPinned, std::vector<GURL>{away}));
+  EXPECT_FALSE(IsAtPinnedUrl(GURL("https://other.test/"), kPinned,
+                             std::vector<GURL>{GURL("https://other.test/")}));
+  EXPECT_FALSE(IsAtPinnedUrl(away, kPinned, {}));
+}
+
+// A redirect that merely *ends* somewhere is not a redirect *from* home.
+TEST(WorkspacePinSemanticsTest, ARedirectEndingAtThePinnedUrlIsOnlyHomeByUrl) {
+  const std::vector<GURL> chain = {GURL("https://example.com/login"), kPinned};
+  // Ends at the pinned URL: home by the URL test.
+  EXPECT_TRUE(IsAtPinnedUrl(kPinned, kPinned, chain));
+  // Ends elsewhere and did not start at home: drifted.
+  EXPECT_FALSE(IsAtPinnedUrl(GURL("https://example.com/dash"), kPinned,
+                             std::vector<GURL>{GURL("https://example.com/login"),
+                                               GURL("https://example.com/dash")}));
+}
+
+// Nothing committed yet, or an entry with no usable URL, is never home.
+TEST(WorkspacePinSemanticsTest, EmptyAndInvalidUrlsAreNotHome) {
+  EXPECT_FALSE(IsAtPinnedUrl(GURL(), kPinned, {}));
+  EXPECT_FALSE(IsAtPinnedUrl(kPinned, GURL(), std::vector<GURL>{kPinned}));
+}
+
+// helium-fork M3.10-r2. The row the user just clicked has committed nothing
+// yet, and the load in flight is the pinned URL: it must not wear the "/".
+// This is the whole reason drift is its own predicate rather than the
+// negation of home.
+TEST(WorkspacePinSemanticsTest, ATabThatHasCommittedNothingHasNotDrifted) {
+  EXPECT_FALSE(IsDriftedFromPinnedUrl(/*has_committed_navigation=*/false,
+                                      GURL(), kPinned, {}));
+  // Not even if some stale URL is still readable off the tab.
+  EXPECT_FALSE(IsDriftedFromPinnedUrl(
+      /*has_committed_navigation=*/false, GURL("https://example.com/settings"),
+      kPinned, {}));
+  // And "not home" is still true for the same inputs -- the write-back gate
+  // and the drift mark deliberately disagree here.
+  EXPECT_FALSE(IsAtPinnedUrl(GURL(), kPinned, {}));
+}
+
+// Once something has committed, drift is exactly "not home".
+TEST(WorkspacePinSemanticsTest, DriftIsNotHomeOnceSomethingCommitted) {
+  const std::vector<GURL> chain = {kPinned};
+  EXPECT_FALSE(IsDriftedFromPinnedUrl(/*has_committed_navigation=*/true,
+                                      kPinned, kPinned, chain));
+  const GURL away("https://example.com/settings");
+  EXPECT_TRUE(IsDriftedFromPinnedUrl(/*has_committed_navigation=*/true, away,
+                                     kPinned, std::vector<GURL>{away}));
+  // A server redirect off the pinned URL is still home, so still no mark.
+  const std::vector<GURL> redirected = {kPinned,
+                                        GURL("https://example.com/home")};
+  EXPECT_FALSE(IsDriftedFromPinnedUrl(/*has_committed_navigation=*/true,
+                                      GURL("https://example.com/home"),
+                                      kPinned, redirected));
+}
+
