+// helium-fork M3.10: whether a tab bound to an entry is *at home* -- still on
+// the URL the entry was pinned at (Arc/Dia's "pinned URL"). Two things hang
+// off the answer (user 2026-08-23, Dia photo "Back to Pinned URL"):
+//   - the entry's persisted title and favicon follow the tab only while it is
+//     at home, so closing a drifted tab leaves the entry describing the
+//     pinned page, not wherever the user ended up;
+//   - a drifted row shows the "/" drift mark and, with the pointer on its
+//     favicon, the "Back to Pinned URL" hint; clicking the favicon navigates
+//     the tab back.
+//
+// |tab_url| is the tab's last committed URL, |pinned_url| the entry's, and
+// |redirect_chain| the last committed navigation's chain, whose first element
+// is the URL that navigation was started with. The chain is what keeps a
+// server redirect at home: an entry pinned at https://site/ that always
+// lands on https://site/home would otherwise never count as home again.
+inline bool IsAtPinnedUrl(const GURL& tab_url,
+                          const GURL& pinned_url,
+                          base::span<const GURL> redirect_chain) {
+  if (!pinned_url.is_valid()) {
+    return false;
+  }
+  if (tab_url == pinned_url) {
+    return true;
+  }
+  return !redirect_chain.empty() && redirect_chain.front() == pinned_url;
