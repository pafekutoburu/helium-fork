                       space_collapsed_);
   }
+  // Collapsing surfaces the active row; opening clears the surfaced set.
+  SyncBindings();
+
+  // Always driven 0 -> 1, "the state we left" -> "the state we are going to",
+  // so the curve is the same in both directions the way Dia's is.
+  folder_animation_.Reset(0.0);
+  folder_animation_.Show();
+  // Opening puts every row at its final place, fully opaque, on the first
+  // frame -- Dia does not fade them in. Closing is the only direction with a
+  // fade.
+  folder_fade_animation_.Reset(1.0);
+  if (space_collapsed_) {
+    folder_fade_animation_.Hide();
+  }
+
+  PreferredSizeChanged();
+  InvalidateLayout();
+}
