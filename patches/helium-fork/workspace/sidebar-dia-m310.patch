+void WorkspaceTabController::CloseEntryTab(const std::string& entry_id) {
+  TabStripModel* model = browser_window_->GetTabStripModel();
+  if (!model) {
+    return;
+  }
+  tabs::TabInterface* tab =
+      service_->FindTabForEntryInWindow(entry_id, browser_window_).Get();
+  if (!tab) {
+    return;
