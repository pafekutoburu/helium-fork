+  // pushed everything below it down; Dia does not -- its card measured
+  // y=16..81 on all 281 frames of the 2026-08-23 recording, resting and
+  // hovered alike. The title moves up inside the row instead (Layout).
+  return GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
 }
 
