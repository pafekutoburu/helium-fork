+
+#include "chrome/browser/ui/helium/arc_sidebar_split.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+constexpr int kRow = 34;  // LayoutConstant::kVerticalTabHeight.
+
+// The user's common case: pinned fits, so it is fixed at full content height
+// no matter how tall Today is -- upstream's half rule would have clamped
+// this to 300.
+TEST(ArcSidebarSplitTest, PinnedGetsFullHeightWhenItFits) {
+  EXPECT_EQ(200, SidebarPinnedViewportHeight(
+                     /*pinned_preferred_height=*/200,
+                     /*today_preferred_height=*/500,
+                     /*available_height=*/600, kRow,
+                     /*pinned_minimum_height=*/60));
+}
+
+// The exception clause: pinned itself overflows, so it clamps to what
+// Today's reserve leaves and scrolls internally.
+TEST(ArcSidebarSplitTest, OverfullPinnedClampsToAvailableMinusReserve) {
+  EXPECT_EQ(600 - 3 * kRow, SidebarPinnedViewportHeight(
+                                /*pinned_preferred_height=*/900,
+                                /*today_preferred_height=*/500,
+                                /*available_height=*/600, kRow,
+                                /*pinned_minimum_height=*/60));
+}
+
+// A one-row Today only reserves its own height -- no dead gap under the
+// pinned surface.
+TEST(ArcSidebarSplitTest, ShortTodayReservesOnlyItsOwnHeight) {
+  EXPECT_EQ(40, SidebarTodayReserve(/*today_preferred_height=*/40, kRow));
+  EXPECT_EQ(600 - 40, SidebarPinnedViewportHeight(
+                          /*pinned_preferred_height=*/900,
+                          /*today_preferred_height=*/40,
+                          /*available_height=*/600, kRow,
+                          /*pinned_minimum_height=*/60));
+}
+
+TEST(ArcSidebarSplitTest, EmptyTodayReservesNothing) {
+  EXPECT_EQ(0, SidebarTodayReserve(/*today_preferred_height=*/0, kRow));
+  EXPECT_EQ(600, SidebarPinnedViewportHeight(
+                     /*pinned_preferred_height=*/900,
+                     /*today_preferred_height=*/0,
+                     /*available_height=*/600, kRow,
+                     /*pinned_minimum_height=*/60));
+}
+
+// Tiny windows: the minimum wins even when the budget goes to zero or below.
+TEST(ArcSidebarSplitTest, FloorsAtPinnedMinimum) {
+  EXPECT_EQ(60, SidebarPinnedViewportHeight(
+                    /*pinned_preferred_height=*/900,
+                    /*today_preferred_height=*/500,
+                    /*available_height=*/80, kRow,
+                    /*pinned_minimum_height=*/60));
+  EXPECT_EQ(60, SidebarPinnedViewportHeight(
+                    /*pinned_preferred_height=*/900,
+                    /*today_preferred_height=*/500,
+                    /*available_height=*/0, kRow,
+                    /*pinned_minimum_height=*/60));
+}
+
+TEST(ArcSidebarSplitTest, NegativeTodayPreferredTreatedAsZero) {
+  EXPECT_EQ(0, SidebarTodayReserve(/*today_preferred_height=*/-10, kRow));
+}
+
