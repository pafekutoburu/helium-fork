+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_SIDEBAR_SPLIT_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_SIDEBAR_SPLIT_H_
+
+// helium-fork: how TabStripView divides its height between its two scroll
+// views -- the pinned surface (favorites grid + folder header + pinned rows)
+// and the Today list.
+//
+// User spec 2026-08-30 (M3.12-r1): the pinned surface is fixed -- fully
+// visible, never scrolling -- unless its own content is what overflows; Today
+// is the one flexible element, absorbing every change through its own
+// scrolling. This replaces upstream's half-split, which viewport-clamped the
+// pinned surface at half the strip whenever Today was tall and sent the
+// favorites grid scrolling off the top.
+//
+// Header-only and free of //ui/views so it pins in the lightweight test
+// target.
+namespace helium {
+
+// What Today keeps when the pinned surface could fill the strip. A target,
+// not a fit: the strip's actual row pitch adds inter-row padding, so the
+// third row shows partially cut -- which doubles as the scroll affordance.
+inline constexpr int kSidebarTodayReserveRows = 3;
+
+// Never more than Today actually wants: a one-tab Today reserves one row,
+// an empty Today reserves nothing (the pinned surface may take it all).
+inline constexpr int SidebarTodayReserve(int today_preferred_height,
+                                         int today_row_height) {
+  const int cap = kSidebarTodayReserveRows * today_row_height;
+  const int preferred = today_preferred_height > 0 ? today_preferred_height : 0;
+  return preferred < cap ? preferred : cap;
+}
+
+// The pinned scroll viewport: full content height when it fits above the
+// Today reserve; clamped to what the reserve leaves when it does not, which
+// makes the pinned surface internally scrollable -- favorites included, the
+// user's accepted exception ("除非 pinned 塞满"). Floored at
+// `pinned_minimum_height` like the rule it replaces.
+inline constexpr int SidebarPinnedViewportHeight(int pinned_preferred_height,
+                                                 int today_preferred_height,
+                                                 int available_height,
+                                                 int today_row_height,
+                                                 int pinned_minimum_height) {
+  const int reserve =
+      SidebarTodayReserve(today_preferred_height, today_row_height);
+  const int budget = available_height - reserve;
+  const int height =
+      pinned_preferred_height < budget ? pinned_preferred_height : budget;
+  return height > pinned_minimum_height ? height : pinned_minimum_height;
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_SIDEBAR_SPLIT_H_
