+void WorkspaceSidebarView::PerformUrlDrop(
+    helium_workspace::WorkspaceEntry::Section section,
+    size_t index,
+    const ui::DropTargetEvent& event,
+    ui::mojom::DragOperation& output_drag_op,
+    std::unique_ptr<ui::LayerTreeOwner> drag_image_layer_owner) {
+  output_drag_op = ui::mojom::DragOperation::kNone;
+  const std::vector<ui::ClipboardUrlInfo> urls =
+      event.data().GetURLs(ui::FilenameToURLPolicy::CONVERT_FILENAMES);
+  // One entry per drop. mac only ever writes one URL anyway
+  // (os_exchange_data_provider_mac.mm:189-191), and `Dia:` was never seen to
+  // take more than one.
+  const std::optional<GURL> url =
+      urls.empty() ? std::nullopt
+                   : helium_workspace::NormalizeDroppedUrl(urls.front().url);
+
+  // Close the hole *before* the model write, and from the frame that is on
+  // screen: the entry about to be added lands in exactly that slot, so the
+  // glide this sets up has nothing left to travel and the row simply appears
+  // where the hole was. Doing it the other way round shows the rows shut and
+  // re-open, or (writing first) one slot too many for a frame.
+  if (!drag_) {
+    return;
+  }
+  const bool collapsed_folder_drop = space_collapsed_;
+  DragPerfFinish();
+  RetargetDragYield();
+  drag_->settling = true;
+
+  if (url && service_) {
+    // AddEntry only appends, so the planned slot needs the second call. The
+    // index is "slot among that section's entries with the moved one already
+    // removed", and the moved one is the one just appended, which leaves the
+    // hit math's answer -- computed over the list as it was -- exactly right.
+    const std::string id = service_->AddEntry(section, *url, urls.front().title);
+    if (!id.empty()) {
+      service_->MoveEntry(id, section, index);
+      output_drag_op = ui::mojom::DragOperation::kCopy;
+      if (collapsed_folder_drop &&
+          section == helium_workspace::WorkspaceEntry::Section::kPinned) {
+        drop_surfaced_entry_id_ = id;
+      }
+      FinishDragSettle();
+      // `Dia:` opens and activates what was dropped (2026-08-26: the new row
+      // takes the active card, the content area navigates, the address bar
+      // goes about:blank then to the URL). That is also where its favicon and
+      // title come from, and ours arrive by the same route -- OpenEntry binds
+      // the tab, and the bind is what CaptureFavicon and the title write-back
+      // hang off. Last, because it activates a tab and this view is mid-drop.
+      OnEntryActivated(id);
+      return;
+    }
+    // Empty id = the favorites cap. `Dia:` has no cap at all (the user got to
+    // ~20), `Arc:` refuses the thirteenth; the user chose to keep our 12 and
+    // reuse the passive refusal (2026-08-26), which is what already happened
+    // upstream of here: UpdateDragPlan never gave the grid a plan, so this
+    // path is only reachable if the count changed mid-drag.
+  }
+  FinishDragSettle();
+}
