+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium_workspace/workspace_url_drop.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium_workspace {
+namespace {
+
+TEST(WorkspaceUrlDropTest, OrdinaryPageUrlsAreAccepted) {
+  EXPECT_EQ(NormalizeDroppedUrl(GURL("https://example.com/a?b=c#d")),
+            GURL("https://example.com/a?b=c#d"));
+  EXPECT_EQ(NormalizeDroppedUrl(GURL("http://example.com/")),
+            GURL("http://example.com/"));
+}
+
+TEST(WorkspaceUrlDropTest, FileUrlsAreAccepted) {
+  // `Dia:` 2026-08-26: dragging plain-url.txt and not-a-url.md out of Finder
+  // both produced entries, so files are in scope rather than filtered out.
+  EXPECT_EQ(NormalizeDroppedUrl(GURL("file:///tmp/not-a-url.md")),
+            GURL("file:///tmp/not-a-url.md"));
+}
+
+TEST(WorkspaceUrlDropTest, JavascriptUrlsAreRefused) {
+  // A stored entry is clickable forever; a javascript: URL in one would be a
+  // self-XSS that outlives the drag.
+  EXPECT_EQ(NormalizeDroppedUrl(GURL("javascript:alert(1)")), std::nullopt);
+  EXPECT_EQ(NormalizeDroppedUrl(GURL("JavaScript:alert(1)")), std::nullopt);
+}
+
+TEST(WorkspaceUrlDropTest, InvalidAndEmptyUrlsAreRefused) {
+  EXPECT_EQ(NormalizeDroppedUrl(GURL()), std::nullopt);
+  EXPECT_EQ(NormalizeDroppedUrl(GURL("")), std::nullopt);
+  EXPECT_EQ(NormalizeDroppedUrl(GURL("not a url at all")), std::nullopt);
+}
+
+TEST(WorkspaceUrlDropTest, OtherSchemesAreNotSecondGuessed) {
+  // Only javascript: is singled out. Anything else the platform managed to
+  // parse into a valid URL is the user's business -- refusing more would be
+  // us inventing policy `Dia:` does not have.
+  EXPECT_EQ(NormalizeDroppedUrl(GURL("chrome://settings/")),
+            GURL("chrome://settings/"));
+  EXPECT_EQ(NormalizeDroppedUrl(GURL("mailto:someone@example.com")),
+            GURL("mailto:someone@example.com"));
+}
+
+}  // namespace
+}  // namespace helium_workspace
