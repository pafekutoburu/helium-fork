+bool WorkspaceSidebarView::HasUrlDragSession() const {
+  return drag_ && drag_->kind == DragKind::kExternalUrl && !drag_->settling;
+}
+
+void WorkspaceSidebarView::EnsureUrlDragSession() {
+  // |drag_| rather than the two predicates on purpose: a session that is
+  // still settling is not "no session", and replacing it here would hand its
+  // pending FinishDragSettle the new one to tear down.
+  if (!drag_) {
+    StartUrlDragSession();
+    return;
+  }
+  if (HasUrlDragSession()) {
+    KeepUrlDragSessionAlive();
+  }
+}
+
+void WorkspaceSidebarView::KeepUrlDragSessionAlive() {
+  ++url_teardown_generation_;
+}
+
+void WorkspaceSidebarView::ScheduleUrlSessionTeardown() {
+  // Crossings between our own targets deliver exit→enter within one native
+  // callback (drop_helper.cc:66-77), so this task cannot interleave with
+  // them -- the enter's generation bump lands first. Only a true exit
+  // (window leave, ESC, drop landing somewhere that is not ours) leaves the
+  // generation untouched long enough for the task to fire.
+  const uint64_t generation = ++url_teardown_generation_;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<WorkspaceSidebarView> self, uint64_t generation) {
+            if (self && generation == self->url_teardown_generation_ &&
+                self->HasUrlDragSession()) {
+              self->EndDragSession();
+            }
+          },
+          weak_factory_.GetWeakPtr(), generation));
+}
+
+void WorkspaceSidebarView::StartUrlDragSession() {
+  // Same freeze as OnWillStartDragForView, and for the same reason: read the
+  // settled boundary before the session exists, because the first slot this
+  // session opens moves the header, and a boundary read off the live layout
+  // would then re-answer the hit test that opened it.
+  const int settled_boundary =
+      ComputeLayout(width(), space_collapsed_).header_bounds.y();
+
+  drag_ = std::make_unique<DragState>();
+  drag_->kind = DragKind::kExternalUrl;
+  drag_->zone_boundary_y = settled_boundary;
+  {
+    const SidebarLayout seed = ComputeLayout(width(), space_collapsed_);
+    drag_->latched_grid_segment = seed.grid_segment;
+    drag_->latched_rows_segment = seed.height - seed.grid_segment;
+  }
+  if (DragPerfRequested()) {
+    drag_perf_ = std::make_unique<DragPerf>();
+    if (ui::Compositor* const compositor =
+            GetWidget() ? GetWidget()->GetCompositor() : nullptr) {
+      drag_perf_->frame_interval_us =
+          compositor->refresh_rate() > 0.0
+              ? static_cast<int64_t>(1e6 / compositor->refresh_rate())
+              : 0;
+      drag_frame_probe_ =
+          std::make_unique<WorkspaceDragFrameProbe>(compositor, drag_perf_.get());
+    }
+  }
+  // M3.12-r2: Today shows this session's slot too, so its scrollbar and
+  // overflow indicator get the same gesture-long suppression as for entry
+  // drags. FinishDragSettle clears it unconditionally.
+  if (today_container_) {
+    today_container_->SetWorkspaceEntryDragActive(true);
+  }
+  // No overlay: the dragged thing is the OS's own link image, drawn by the
+  // source process. `Dia:` shows exactly that too -- the grey capsule with the
+  // title, the URL and a green plus, unchanged for the whole drag (2026-08-26).
+  //
+  // An OS drag session eats the mouse, so whatever row was lit when the drag
+  // arrived never gets told the pointer left it -- same reason
+  // OnWillStartDragForView sweeps before adding to the pile (M3.11-r1).
