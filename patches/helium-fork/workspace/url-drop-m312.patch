+  // Both ends of the range the hit math can produce: 0 and "after the last".
+  const std::string top = service_->AddEntry(
+      WorkspaceEntry::Section::kPinned, GURL("https://top.example/"), u"Top");
+  ASSERT_TRUE(service_->MoveEntry(top, WorkspaceEntry::Section::kPinned, 0));
+  const std::string end = service_->AddEntry(
+      WorkspaceEntry::Section::kPinned, GURL("https://end.example/"), u"End");
