+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_URL_DROP_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_URL_DROP_H_
+
+#include <optional>
+
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace helium_workspace {
+
+// M3.12: what the sidebar is willing to turn into an entry when a URL is
+// dropped on it.
+//
+// `Dia:` (measured 2026-08-26) takes anything the pasteboard offers as a URL,
+// including plain files dragged out of Finder -- `plain-url.txt` and
+// `not-a-url.md` both became entries pointing at their `file://` URLs. So the
+// only filtering here is the one upstream applies at every other URL drop
+// target: a `javascript:` URL must never become a stored, clickable entry,
+// because that turns one drag into a self-XSS that survives a restart
+// (home_button.cc:203-207 refuses it for the same reason on the same kind of
+// drop, and it is the only scheme upstream singles out there).
+//
+// Returns the URL to store, or nullopt if the payload is not something an
+// entry may point at. Deliberately not a bare bool: the caller stores what
+// comes back, so anything this function decides to rewrite later travels with
+// the verdict instead of being reapplied at each call site.
+inline std::optional<GURL> NormalizeDroppedUrl(const GURL& url) {
+  if (!url.is_valid() || url.is_empty()) {
+    return std::nullopt;
+  }
+  if (url.SchemeIs(url::kJavaScriptScheme)) {
+    return std::nullopt;
+  }
+  return url;
+}
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_URL_DROP_H_
