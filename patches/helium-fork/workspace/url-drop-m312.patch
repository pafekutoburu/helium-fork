+                          "https://c.example/", "https://end.example/"));
+}
+
+// The same composition in the grid, plus the refusal the user chose to keep:
+// `Dia:` has no favorites cap (2026-08-26, ~20 and still adding) but ours
+// stays at 12, and a dropped URL has to hit it the same way a dragged row
+// does -- AddEntry returns an empty id and nothing else runs.
+TEST_F(WorkspaceServiceTest, DroppedUrlLandsInTheGridAndStopsAtTheCap) {
+  ASSERT_FALSE(service_
+                   ->AddEntry(WorkspaceEntry::Section::kFavorite,
+                              GURL("https://one.example/"), u"One")
+                   .empty());
+  const std::string dropped = service_->AddEntry(
+      WorkspaceEntry::Section::kFavorite, GURL("https://two.example/"), u"Two");
+  ASSERT_FALSE(dropped.empty());
+  // Slot 0: dropped on the left of the only capsule there.
+  ASSERT_TRUE(
+      service_->MoveEntry(dropped, WorkspaceEntry::Section::kFavorite, 0));
+  EXPECT_THAT(SectionUrls(*service_, WorkspaceEntry::Section::kFavorite),
+              ElementsAre("https://two.example/", "https://one.example/"));
+
+  while (service_->CountFavorites() < WorkspaceService::kMaxFavorites) {
+    ASSERT_FALSE(service_
+                     ->AddEntry(WorkspaceEntry::Section::kFavorite,
+                                GURL("https://filler.example/"), u"F")
+                     .empty());
+  }
+  EXPECT_TRUE(service_
+                  ->AddEntry(WorkspaceEntry::Section::kFavorite,
+                             GURL("https://thirteenth.example/"), u"No")
+                  .empty());
+  EXPECT_EQ(WorkspaceService::kMaxFavorites, service_->CountFavorites());
+}
