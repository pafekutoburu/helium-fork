+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/common/workspace_favorites_band_view.h"
+
+#include "chrome/browser/ui/views/tabs/common/workspace_entry_drag_data.h"
+#include "chrome/browser/ui/views/tabs/common/workspace_sidebar_view.h"
+#include "ui/base/clipboard/clipboard_format_type.h"
+#include "ui/base/dragdrop/drag_drop_types.h"
+#include "ui/base/dragdrop/drop_target_event.h"
+#include "ui/base/dragdrop/os_exchange_data.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+
+WorkspaceFavoritesBandView::WorkspaceFavoritesBandView() = default;
+
+WorkspaceFavoritesBandView::~WorkspaceFavoritesBandView() = default;
+
+void WorkspaceFavoritesBandView::SetWorkspaceDragHost(
+    WorkspaceSidebarView* sidebar) {
+  sidebar_ = sidebar;
+}
+
+gfx::Size WorkspaceFavoritesBandView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  if (!sidebar_) {
+    return gfx::Size();
+  }
+  const int width = available_size.width().is_bounded()
+                        ? available_size.width().value()
+                        : sidebar_->width();
+  return gfx::Size(width, sidebar_->BandSegmentHeight(width));
+}
+
+gfx::Size WorkspaceFavoritesBandView::GetMinimumSize() const {
+  return gfx::Size(0, sidebar_ ? sidebar_->BandMinimumHeight() : 0);
+}
+
+bool WorkspaceFavoritesBandView::GetDropFormats(
+    int* formats,
+    std::set<ui::ClipboardFormatType>* format_types) {
+  // The grid's drop surface for both kinds -- same recipe as the sidebar's
+  // own registration. Assignment, not |= (pitfalls M3.12 #3).
+  format_types->insert(helium_workspace::WorkspaceEntryDragFormat());
+  *formats = ui::OSExchangeData::URL;
+  format_types->insert(ui::ClipboardFormatType::UrlType());
+  return true;
+}
+
+bool WorkspaceFavoritesBandView::AreDropTypesRequired() {
+  return true;
+}
+
+bool WorkspaceFavoritesBandView::CanDrop(const ui::OSExchangeData& data) {
+  if (!sidebar_) {
+    return false;
+  }
+  // Session first, one payload read second (pitfalls M3.12 #4).
+  if (sidebar_->HasEntryDragSession() || sidebar_->HasUrlDragSession()) {
+    return true;
+  }
+  return data.HasURL(ui::FilenameToURLPolicy::CONVERT_FILENAMES);
+}
+
+void WorkspaceFavoritesBandView::OnDragEntered(
+    const ui::DropTargetEvent& event) {
+  if (!sidebar_) {
+    return;
+  }
+  sidebar_->EnsureUrlDragSession();
+  OnDragUpdated(event);
+}
+
+int WorkspaceFavoritesBandView::OnDragUpdated(
+    const ui::DropTargetEvent& event) {
+  return sidebar_ ? sidebar_->OnBandDragUpdated(*this, event.location())
+                  : ui::DragDropTypes::DRAG_NONE;
+}
+
+void WorkspaceFavoritesBandView::OnDragExited() {
+  if (sidebar_) {
+    // Same semantics as leaving the sidebar itself: hole closes, session
+    // stays (URL sessions get the deferred teardown there).
+    sidebar_->OnDragExited();
+  }
+}
+
+views::View::DropCallback WorkspaceFavoritesBandView::GetDropCallback(
+    const ui::DropTargetEvent& event) {
+  return sidebar_ ? sidebar_->GetDropCallback(event) : base::NullCallback();
+}
+
+void WorkspaceFavoritesBandView::RemovedFromWidget() {
+  sidebar_ = nullptr;
+}
+
+BEGIN_METADATA(WorkspaceFavoritesBandView)
+END_METADATA
