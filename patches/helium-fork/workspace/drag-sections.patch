+    // split down the middle. Appending after the last pinned row needs the
+    // pointer below that row's centre, and at the midpoint there was barely
+    // any travel left before the drag routed into Today instead — the
+    // section a tab lands in should not depend on hitting a ten-pixel band.
+    // Today gives up nothing in return: its own first row is a full-height
+    // target well below the boundary.
+    const int boundary_y = unpinned_rect.y() - kTodayLeadingSlop;
+    return point_in_screen.y() < boundary_y
+               ? &pinned->GetTabDragTarget(point_in_screen)
+               : &unpinned->GetTabDragTarget(point_in_screen);
