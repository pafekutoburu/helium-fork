+void DraggedTabsContainer::UpdateDropIndicator(
+    const views::ProposedLayout& layout,
+    const TabCollectionNode* target) {
+  std::optional<gfx::Rect> indicator;
+  if (target && target->view()) {
+    for (const auto& child_layout : layout.child_layouts) {
+      if (child_layout.child_view == target->view()) {
+        if (child_layout.visible && !child_layout.bounds.IsEmpty()) {
+          indicator = child_layout.bounds;
+        }
+        break;
+      }
+    }
+  } else {
