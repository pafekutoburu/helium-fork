+  // helium-fork: in the vertical sidebar, route by pointer geometry instead
+  // of the dragged tabs' pin state, so tabs can cross the pinned/unpinned
+  // boundary (Arc: dropping a Today tab on the pinned section pins it and
+  // vice versa). Group headers cannot be pinned and keep the upstream
+  // routing, as does the horizontal layout.
+  auto* tab_strip_view = views::AsViewClass<TabStripView>(GetTabStripView());
+  if (tab_strip_view && !drag_handler_->IsDraggingGroups()) {
+    PinnedTabContainerView* pinned = GetPinnedTabsContainer();
+    UnpinnedTabContainerView* unpinned = GetUnpinnedTabsContainer();
+    const gfx::Rect unpinned_rect =
+        tab_strip_view->unpinned_tabs_scroll_view()->GetBoundsInScreen();
+
+    // Section membership is a pure function of the pointer. There is
+    // deliberately no hysteresis — a slop belt around the container currently
+    // handling the drag made the boundary feel magnetic rather than tracking
+    // the cursor, which is not how Arc behaves.
