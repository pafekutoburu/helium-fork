+void PinnedTabContainerView::OnPaintBorder(gfx::Canvas* canvas) {
+  views::View::OnPaintBorder(canvas);
+  // helium-fork: the drop marker is for the full-row segment only — inside
+  // the Favorites grid the capsule transformation is the feedback, and Arc
+  // shows no line there either. It is also suppressed while the space header
+  // is highlighted, so a drop is never signalled two ways at once.
+  if (IsHandlingTabDrag() && !last_drag_in_grid_ && !space_header_drop_active_) {
+    PaintDropIndicator(canvas);
+  }
+}
