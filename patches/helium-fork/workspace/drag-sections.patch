+int PinnedTabContainerView::GridSectionBottom() const {
+  const std::vector<views::View*> children =
+      collection_node_ ? collection_node_->GetDirectChildren()
+                       : std::vector<views::View*>();
+  const size_t favorite_count = CountLeadingFavorites(children);
+  // helium-fork: derive the boundary from the same row plan the layout uses,
+  // not from the children's painted bounds. A floating capsule is painted
+  // under the pointer while still reserving a slot, so its bounds say nothing
+  // about where the grid ends — and when it is the only favorite there is no
+  // other child left to measure at all.
+  // The freeze floors it so the segment can never shrink under a stationary
+  // pointer and reverse the decision that shrank it.
+  return std::max(GridExtentForSlots(children, favorite_count,
+                                     CountGridSlots(children, favorite_count)),
+                  FrozenGridExtent()) +
+         kSectionGap / 2;
+}
+
+void PinnedTabContainerView::NotifyWorkspaceSectionForDrag(bool in_grid) {
+  if (!GetWidget()) {
+    return;
+  }
+  std::vector<tabs::TabHandle> handles;
+  for (const views::View* view : GetDraggingViews()) {
+    if (const TabView* tab_view = views::AsViewClass<TabView>(view)) {
+      if (tab_view->tab_interface()) {
+        handles.push_back(tab_view->tab_interface()->GetHandle());
+      }
+    }
+  }
+  if (handles.empty()) {
+    return;
+  }
+  BrowserView* browser_view =
+      BrowserView::GetBrowserViewForNativeWindow(GetWidget()->GetNativeWindow());
+  if (!browser_view || !browser_view->browser()) {
+    return;
+  }
+  auto* workspace_controller =
+      helium_workspace::WorkspaceTabController::From(browser_view->browser());
+  if (!workspace_controller) {
+    return;
+  }
+  workspace_controller->SetDraggedTabsSection(
+      handles, in_grid ? helium_workspace::WorkspaceEntry::Section::kFavorite
+                       : helium_workspace::WorkspaceEntry::Section::kPinned);
+  // The favorites prefix may have changed; re-layout so capsules and rows
+  // swap presentation immediately while the drag continues.
+  InvalidateLayout();
+}
+
+TabDragContext* PinnedTabContainerView::OnTabDragUpdated(
+    TabDragTarget::DragController& controller,
+    const gfx::Point& point_in_screen) {
+  const bool was_handling = IsHandlingTabDrag();
+
+  // helium-fork: the pointer, in container coordinates, drives both the
+  // section flip below and the grid drop target. Cache it before the base
+  // class runs so `GetTargetForTabDrag` — which only receives the dragged
+  // view's bounding box — can probe with the pointer instead.
+  last_drag_point_in_container_ = point_in_screen;
+  views::View::ConvertPointFromScreen(this, &last_drag_point_in_container_);
+
+  // helium-fork: freeze the section's envelope for the whole drag. Every
+  // boundary here moves as a *consequence* of the drop decision — the tall
+  // empty-state placeholder appears the moment the grid loses its last
+  // favorite, a row leaving for Today shortens the section — and a boundary
+  // that moves past a stationary pointer immediately reverses the decision
+  // that moved it.
+  ArmDragFreeze();
+
+  // helium-fork: if the previous frame's section flip resized the dragged
+  // view (row <-> capsule), re-anchor the drag box before the base class
+  // positions anything with it.
+  ReanchorDragBoundsForResizedViews();
+
+  TabDragContext* result =
+      DraggedTabsContainer::OnTabDragUpdated(controller, point_in_screen);
+
+  // helium-fork: crossing the grid/rows boundary flips the dragged tabs'
+  // workspace section. On entry the section is pushed unconditionally (the
+  // tabs may have just been re-pinned with a default section).
+  const bool in_grid = IsPointInGridSection(last_drag_point_in_container_);
+  if (!was_handling || in_grid != last_drag_in_grid_) {
+    last_drag_in_grid_ = in_grid;
+    NotifyWorkspaceSectionForDrag(in_grid);
+  }
+  // helium-fork: only the row actually under the pointer highlights — the
+  // same rule Finder uses when moving files. Highlighting the header for the
+  // whole rows segment while the drop line was also showing gave two cues for
+  // one drop.
+  const bool over_space_header =
+      space_header_ && space_header_->GetVisible() &&
+      space_header_->bounds().Contains(last_drag_point_in_container_);
+  SetSpaceHeaderDropTargetActive(over_space_header);
+  space_header_drop_active_ = over_space_header;
+
+  // helium-fork: grow-only. The section takes its extra row the moment the
+  // carried tab actually becomes one of its own — crossing into the grid, or
+  // a multi-selection needing more than one slot — and holds it from then on.
+  // Room is never given back mid-drag. The accessors already fold the current
+  // freeze in, so storing what they return is what accumulates it.
+  if (drag_frozen_) {
+    const std::vector<views::View*> children =
+        collection_node_ ? collection_node_->GetDirectChildren()
+                         : std::vector<views::View*>();
+    const size_t favorite_count = CountLeadingFavorites(children);
+    const size_t slots = CountGridSlots(children, favorite_count);
+    drag_frozen_->slot_count = slots;
+    drag_frozen_->grid_extent =
+        std::max(drag_frozen_->grid_extent,
+                 GridExtentForSlots(children, favorite_count, slots));
+    drag_frozen_->total_height =
+        std::max(drag_frozen_->total_height,
+                 GetPreferredSize(views::SizeBounds(width(), {})).height());
+  }
+  return result;
+}
