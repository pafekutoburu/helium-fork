+const TabCollectionNode* PinnedTabContainerView::GetTargetForTabDrag(
+    const views::ProposedLayout& layout,
+    const gfx::Rect& dragged_tab_bounds) const {
+  // helium-fork: section-aware targeting. Capsules in the grid segment use
