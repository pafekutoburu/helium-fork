+void WorkspaceTabController::OnTabDragStarted() {
+  drag_in_progress_ = true;
+}
+
+void WorkspaceTabController::OnTabDragEnded() {
+  if (!drag_in_progress_) {
+    return;
+  }
+  drag_in_progress_ = false;
+
+  // The drop's physical order is authoritative: absorb it into entry
+  // positions, then run one enforcement pass to bounce back anything
+  // inconsistent (e.g. cap-rejected promotions).
+  TabStripModel* model = browser_window_->GetTabStripModel();
+  if (model && !model->closing_all()) {
+    service_->SyncOrderFromTabStrip(model);
+  }
+  ScheduleEnforceSectionOrder();
+
+  for (const std::string& entry_id : std::exchange(pending_recreates_, {})) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&WorkspaceTabController::RecreateEntryTab,
+                                  weak_factory_.GetWeakPtr(), entry_id));
+  }
+}
+
+void WorkspaceTabController::SetDraggedTabsSection(
+    const std::vector<tabs::TabHandle>& handles,
+    WorkspaceEntry::Section section) {
+  for (const tabs::TabHandle& handle : handles) {
+    const std::string entry_id = service_->FindEntryIdForTab(handle);
+    if (entry_id.empty()) {
+      continue;
+    }
+    const std::optional<WorkspaceEntry::Section> current =
+        service_->GetSectionForTab(handle);
+    if (current && *current != section) {
+      service_->SetEntrySection(entry_id, section);
+    }
+  }
+}
