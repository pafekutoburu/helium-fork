+bool PinnedTabContainerView::IsDropIndicatorCandidate(
+    const views::View& child_view) const {
+  // helium-fork: the marker never appears inside the Favorites grid — there
+  // the gap opening in the capsules is the feedback, and Arc draws no line
+  // either. Asking the view how it is being rendered keeps this in step with
+  // what was actually drawn; deriving it from the grid's bottom edge instead
+  // let the two disagree about a capsule sitting on the boundary.
+  const TabView* tab_view = views::AsViewClass<TabView>(&child_view);
+  return !tab_view || !tab_view->RenderAsGridIcon();
+}
+
+std::optional<gfx::Rect> PinnedTabContainerView::GetEmptyDropIndicatorBounds()
+    const {
+  // Favorites but no pinned rows yet: mark the head of the empty row list,
+  // just under the space header, at full row width.
+  if (!space_header_ || !space_header_->GetVisible()) {
+    return std::nullopt;
+  }
+  const gfx::Rect header = space_header_->bounds();
+  return gfx::Rect(0, header.bottom() + kTabPadding, width(), 0);
+}
+
+void PinnedTabContainerView::OnDragStateReset() {
+  // helium-fork: deliberately *not* dropping the geometry freeze here. This
+  // runs on `OnTabDragExited` as well as `OnTabDragEnded`, and exited fires
+  // every time the pointer crosses into Today — releasing the envelope at
+  // that exact moment is what let the boundary chase the pointer back and
+  // forth. `SyncDragFreeze()` retires it once the session is really over.
+  SyncDragFreeze();
+  space_header_drop_active_ = false;
+  SetSpaceHeaderDropTargetActive(false);
+}
