+size_t PinnedTabContainerView::CountGridSlots(
+    const std::vector<views::View*>& children,
+    size_t favorite_count) const {
+  size_t count = 0;
+  for (size_t i = 0; i < favorite_count; ++i) {
+    auto drag_data = GetVisualDataForDraggedView(*children[i]);
+    if (!drag_data || !drag_data->should_hide) {
+      ++count;
+    }
+  }
+  SyncDragFreeze();
+  return drag_frozen_ ? std::max(count, drag_frozen_->slot_count) : count;
+}
+
+int PinnedTabContainerView::GridMinChildWidth(
+    const std::vector<views::View*>& children,
+    size_t favorite_count) const {
+  bool contains_split = false;
+  for (size_t i = 0; i < favorite_count; ++i) {
+    const TabCollectionNode* node = GetCollectionNodeFromView(*children[i]);
+    if (node && node->type() == TabCollectionNode::Type::SPLIT) {
+      contains_split = true;
+    }
+  }
+  return GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth) *
+         (contains_split ? 2 : 1);
+}
+
+int PinnedTabContainerView::GridExtentForSlots(
+    const std::vector<views::View*>& children,
+    size_t favorite_count,
+    size_t slot_count) const {
+  if (slot_count == 0) {
+    return (placeholder_ && PlaceholderMayShow()) ? kFavoritesPlaceholderHeight
+                                                  : 0;
+  }
+  const int available_width =
+      width() -
+      GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+  const int per_row_max =
+      available_width > 0
+          ? GridPerRowMax(available_width,
+                          GridMinChildWidth(children, favorite_count))
+          : kMaxFavoritesPerRow;
+  return helium_workspace::FavoritesGridBottom(
+      helium_workspace::PlanFavoritesGrid(static_cast<int>(slot_count),
+                                          per_row_max),
+      GetLayoutConstant(LayoutConstant::kVerticalTabFavoriteHeight),
+      kFavoriteGridGap);
+}
+
+int PinnedTabContainerView::FrozenGridExtent() const {
+  SyncDragFreeze();
+  return drag_frozen_ ? drag_frozen_->grid_extent : 0;
+}
+
+bool PinnedTabContainerView::PlaceholderMayShow() const {
+  SyncDragFreeze();
+  return !drag_frozen_ || drag_frozen_->placeholder_shown;
+}
+
+void PinnedTabContainerView::ArmDragFreeze() {
+  SyncDragFreeze();
+  if (drag_frozen_ || !IsDragging()) {
+    return;
+  }
+  const std::vector<views::View*> children =
+      collection_node_ ? collection_node_->GetDirectChildren()
+                       : std::vector<views::View*>();
+  const size_t favorite_count = CountLeadingFavorites(children);
+  const size_t slot_count = CountGridSlots(children, favorite_count);
+
+  // Armed with what the section holds right now. A tab arriving from
+  // elsewhere is not reserved for here: the grid takes its extra row at the
+  // moment the pointer crosses into it and the tab becomes a favorite, which
+  // is where the room is wanted and the only movement the user asked to keep.
+  // Reserving on entry to the *container* instead would open a gap in the
+  // grid for a drag that is only ever headed for the rows below it.
+  drag_frozen_ = DragFrozenGeometry{
+      .slot_count = slot_count,
+      .grid_extent = GridExtentForSlots(children, favorite_count, slot_count),
+      .total_height = GetPreferredSize(views::SizeBounds(width(), {})).height(),
+      .placeholder_shown = placeholder_ && slot_count == 0,
+  };
+}
+
+void PinnedTabContainerView::SyncDragFreeze() const {
+  if (drag_frozen_ && !IsDragging()) {
+    drag_frozen_.reset();
+  }
+}
