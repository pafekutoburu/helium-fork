+void DraggedTabsContainer::PaintDropIndicator(gfx::Canvas* canvas) const {
+  if (!drop_indicator_bounds_ || !host_view_->GetColorProvider()) {
+    return;
+  }
+  // Arc's drop marker: a hairline across the row with a small open dot at its
+  // leading end.
+  static constexpr float kLineThickness = 2.0f;
+  static constexpr float kDotRadius = 3.0f;
+  // helium-fork: the dot is *stroked*, and Skia centres a stroke on its path,
+  // so the ink actually reaches half a stroke width beyond the radius. Sizing
+  // the margins off kDotRadius alone left a pixel of it clipped at every edge.
+  static constexpr float kDotOuter = kDotRadius + kLineThickness / 2.0f;
+
+  const gfx::Rect& bounds = *drop_indicator_bounds_;
+  // helium-fork: the dot is what decides how much room the marker needs, and
+  // the host clips to its own bounds. Sitting the marker exactly on the first
+  // row's top edge put the dot's upper half outside the host, so it came out
+  // sliced. Keep the whole marker within the paintable area instead of
+  // anchoring it exactly on the row edge; a couple of pixels of drift beats a
+  // marker that changes shape at the ends.
+  const float y_min = kDotOuter - kLineThickness / 2.0f;
+  const float y_max = host_view_->height() - kDotOuter - kLineThickness / 2.0f;
