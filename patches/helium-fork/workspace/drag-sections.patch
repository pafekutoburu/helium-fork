+bool PinnedTabContainerView::IsPointInGridSection(
+    const gfx::Point& point_in_container) const {
+  return point_in_container.y() < GridSectionBottom();
+}
+
+gfx::Rect PinnedTabContainerView::GridDragProbe(
+    const views::ProposedLayout& layout,
+    const gfx::Rect& dragged_tab_bounds) const {
+  // helium-fork: inside the grid the drop slot has to track the pointer, not
+  // the dragged view's bounding box. That box is built once at drag start
+  // (DraggedTabsContainer::BuildDragLayout) and keeps whatever width the view
+  // had then — a full sidebar row for anything coming from the rows segment
+  // or Today. Probing with its left edge therefore matched the leftmost
+  // capsule no matter where the pointer was, which is why the preview sat at
+  // the start of the row and only jumped into place on drop. Probe with a
+  // capsule-sized rect centred on the pointer instead.
+  for (const auto& child_layout : layout.child_layouts) {
+    if (!child_layout.visible || child_layout.bounds.IsEmpty() ||
+        GetDragHandler().IsViewDragging(*child_layout.child_view)) {
+      continue;
+    }
+    // Measure against something actually drawn as a capsule — see
+    // `IsDropIndicatorCandidate` on why this is not a geometric test.
+    if (IsDropIndicatorCandidate(*child_layout.child_view)) {
+      continue;
+    }
+    gfx::Rect probe(child_layout.bounds.size());
+    probe.set_origin(
+        gfx::Point(last_drag_point_in_container_.x() - probe.width() / 2,
+                   last_drag_point_in_container_.y() - probe.height() / 2));
+    return probe;
+  }
+  // No capsule to measure against (the grid is empty), so the insertion point
+  // is trivial and the original bounds are good enough.
+  return dragged_tab_bounds;
+}
