@@ -0,0 +1,71 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_GRID_MATH_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_GRID_MATH_H_
+
+namespace helium_workspace {
+
+// Pure layout math for the Arc-style favorites grid and the section
+// inference used by non-drag tab moves. Kept dependency-free so
+// helium_workspace_unittests can exercise it directly.
+
+// Row plan for |count| favorites with at most |per_row_max| per row: rows
+// are balanced, leading rows take the extra capsules (6 -> 3+3, 7 -> 4+3,
+// 9 -> 3+3+3, 12 -> 4+4+4).
+struct FavoritesGridPlan {
+  int rows = 0;
+  int base_cols = 0;    // Columns in each non-extra row.
+  int extra_rows = 0;   // This many leading rows get base_cols + 1.
+};
+
+inline FavoritesGridPlan PlanFavoritesGrid(int count, int per_row_max) {
+  FavoritesGridPlan plan;
+  if (count <= 0 || per_row_max <= 0) {
+    return plan;
+  }
+  plan.rows = (count + per_row_max - 1) / per_row_max;
+  plan.base_cols = count / plan.rows;
+  plan.extra_rows = count % plan.rows;
+  return plan;
+}
+
+inline int FavoritesGridColsForRow(const FavoritesGridPlan& plan, int row) {
+  return plan.base_cols + (row < plan.extra_rows ? 1 : 0);
+}
+
+// Bottom edge of a grid laid out per |plan|, with |row_height|-tall rows and
+// |gap| between them, starting at y = 0. Zero for an empty plan. This is the
+// single source of truth for where the grid segment ends: measuring the
+// children instead would read the drag-time position of a floating capsule,
+// which is under the pointer rather than in the slot it reserves.
+inline int FavoritesGridBottom(const FavoritesGridPlan& plan,
+                               int row_height,
+                               int gap) {
+  if (plan.rows <= 0) {
+    return 0;
+  }
+  return plan.rows * row_height + (plan.rows - 1) * gap;
+}
+
+// Section inference for a non-drag move landing at |to_index| with
+// |favorites_before| favorites physically above it (the moved tab excluded).
+// Landing strictly inside the favorites prefix promotes, strictly below it
+// demotes; the boundary slot is ambiguous between grid-end and rows-start,
+// so it keeps the current section.
+inline bool MoveLandsInFavorites(int to_index,
+                                 int favorites_before,
+                                 bool currently_favorite) {
+  if (to_index < favorites_before) {
+    return true;
+  }
+  if (to_index > favorites_before) {
+    return false;
+  }
+  return currently_favorite;
+}
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_GRID_MATH_H_
