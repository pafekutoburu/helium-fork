--- /dev/null
+++ src/chrome/browser/ui/views/tabs/common/space_carousel.cc
@@ -0,0 +1,376 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/common/space_carousel.h"
+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+#include "chrome/browser/ui/helium_workspace/workspace_tab_controller.h"
+#include "chrome/browser/ui/views/tabs/common/tab_strip_view.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/transform.h"
+#include "ui/views/controls/scroll_view.h"
+#include "ui/views/view.h"
+
+namespace {
+
+// The clock's length. Only a ceiling -- a motion ends when its spring
+// settles (≈0.3s); running this long would mean a spring that never did.
+constexpr double kClockSeconds = 10.0;
+
+}  // namespace
+
+SpaceCarousel::Slot::Slot() = default;
+SpaceCarousel::Slot::Slot(Slot&&) = default;
+SpaceCarousel::Slot& SpaceCarousel::Slot::operator=(Slot&&) = default;
+SpaceCarousel::Slot::~Slot() = default;
+
+SpaceCarousel::SpaceCarousel(views::View* host, Delegate* delegate)
+    : views::AnimationDelegateViews(host),
+      delegate_(delegate),
+      clock_(base::Seconds(kClockSeconds),
+             gfx::LinearAnimation::kDefaultFrameRate,
+             this) {}
+
+SpaceCarousel::~SpaceCarousel() = default;
+
+void SpaceCarousel::OnSwitchWillStart(int direction) {
+  pending_ = false;
+  helium_workspace::WorkspaceTabController* const controller =
+      delegate_->CarouselController();
+  TabStripView* const strip = delegate_->CarouselStrip();
+  // A landing (startup, a restore, the fallback when this window's space
+  // was deleted elsewhere) does not move; nor does a list that is not up.
+  if (direction == 0 || !controller || !strip || !strip->GetWidget() ||
+      !strip->GetVisible() || !strip->layer() || strip->width() <= 0) {
+    Stop();
+    return;
+  }
+  const std::string& from = controller->current_space_id();
+  if (active_ && (from != live_space_ || strip->width() != width_)) {
+    // Not the list this motion was showing (or the sidebar was resized
+    // under it): land and start over from rest.
+    Stop();
+  }
+  // Where the user left the list, for when the space comes back (and for
+  // its picture while it slides out).
+  SaveScroll(from);
+  if (!active_) {
+    const int index = BarIndexOf(from);
+    live_slot_ = std::max(index, 0);
+    live_space_ = from;
+    x_ = live_slot_;
+  }
+  pending_ = true;
+  pending_direction_ = direction > 0 ? 1 : -1;
+  pending_from_ = from;
+}
+
+void SpaceCarousel::OnSwitchActivated() {
+  if (!pending_) {
+    return;
+  }
+  pending_ = false;
+  helium_workspace::WorkspaceTabController* const controller =
+      delegate_->CarouselController();
+  TabStripView* const strip = delegate_->CarouselStrip();
+  if (!controller || !strip || strip->width() <= 0) {
+    Stop();
+    return;
+  }
+  const std::string to = controller->current_space_id();
+  const std::string from = pending_from_;
+  if (to == from) {
+    return;
+  }
+  const bool was_active = active_;
+  const helium::SpringState now =
+      was_active ? StateAt(ClockSeconds())
+                 : helium::SpringState{static_cast<double>(live_slot_), 0.0};
+
+  // Where |to| stands relative to |from|: its distance in bar order, the way
+  // the controller said the switch goes. Next / Previous wrapping around an
+  // end says the opposite -- that one slides a single width its own way,
+  // past nothing (as before 轮4; ⚠ Arc's wrap not measured).
+  const int from_index = BarIndexOf(from);
+  const int to_index = BarIndexOf(to);
+  const bool wrapping = from_index < 0 || to_index < 0 ||
+                        (to_index - from_index) * pending_direction_ <= 0;
+  const int from_slot = live_slot_;
+  const int to_slot = wrapping ? from_slot + pending_direction_
+                               : from_slot + (to_index - from_index);
+
+  // The slots the motion will show: everything between here and there, and
+  // one more the way a moving spring may run on before it turns.
+  double lo = std::min(now.x, static_cast<double>(to_slot));
+  double hi = std::max(now.x, static_cast<double>(to_slot));
+  if (now.v > 0.0) {
+    hi += 1.0;
+  } else if (now.v < 0.0) {
+    lo -= 1.0;
+  }
+  // The new live slot shows the live list; the old one is a picture now.
+  slots_.erase(to_slot);
+  std::vector<std::pair<int, std::string>> wanted;
+  for (int slot = static_cast<int>(std::floor(lo));
+       slot <= static_cast<int>(std::ceil(hi)); ++slot) {
+    if (slot == to_slot || slots_.contains(slot)) {
+      continue;
+    }
+    std::string space = slot == from_slot
+                            ? from
+                            : SpaceForSlot(slot, from_slot, from, wrapping);
+    if (!space.empty()) {
+      wanted.emplace_back(slot, std::move(space));
+    }
+  }
+  // Photographed now: the new space's tab is already active, so none of
+  // these lists has an active row -- no white card, no card shadow (Arc g38
+  // f_00203) -- and the old space's untouched blank page is not yet closed.
+  for (auto& [slot, space] : wanted) {
+    Slot picture;
+    picture.space_id = space;
+    picture.layers = CaptureSpace(space);
+    slots_[slot] = std::move(picture);
+  }
+  if (!wanted.empty()) {
+    controller->SetViewSpaceOverride(std::string());
+    delegate_->CarouselResyncViews();
+  }
+  RestoreLiveViews(to);
+
+  // The bar: from what it shows now -- the old current in colour at rest,
+  // or wherever a cross-fade that is still running has got to -- to the new
+  // current in colour and everything else grey.
+  std::map<std::string, float> start;
+  if (was_active) {
+    start = BlendAt(now.x);
+  } else {
+    start[from] = 0.0f;
+  }
+  if (!start.contains(to)) {
+    start[to] = 1.0f;
+  }
+  blend_start_ = start;
+  blend_end_.clear();
+  for (const auto& [space, grey] : start) {
+    blend_end_[space] = space == to ? 0.0f : 1.0f;
+  }
+  blend_origin_x_ = now.x;
+  live_slot_ = to_slot;
+  live_space_ = to;
+  target_ = to_slot;
+  width_ = strip->width();
+  origin_ = now;
+  x_ = now.x;
+  if (clock_.is_animating()) {
+    origin_seconds_ = ClockSeconds();
+  } else {
+    origin_seconds_ = 0.0;
+    clock_.Start();
+  }
+  cap_first_step_ = true;
+  active_ = true;
+  Apply();
+}
+
+void SpaceCarousel::Stop() {
+  pending_ = false;
+  if (clock_.is_animating()) {
+    clock_.Stop();
+  }
+  slots_.clear();
+  picture_bottom_ = 0;
+  x_ = target_ = live_slot_;
+  if (!active_) {
+    return;
+  }
+  active_ = false;
+  if (TabStripView* const strip = delegate_->CarouselStrip()) {
+    strip->SetListOffset(0.0f);
+    strip->SetListClipBottom(0);
+  }
+  delegate_->OnCarouselFrame(0.0f);
+  blend_start_.clear();
+  blend_end_.clear();
+  delegate_->OnCarouselBlend({});
+  delegate_->OnCarouselEnded();
+}
+
+void SpaceCarousel::AnimationProgressed(const gfx::Animation* animation) {
+  if (animation != &clock_ || !active_) {
+    return;
+  }
+  if (cap_first_step_) {
+    // The pictures and the layout above took this frame's time, not the
+    // user's: one step on from where the list was shown.
+    cap_first_step_ = false;
+    origin_seconds_ =
+        helium::CapFirstStepOrigin(origin_seconds_, ClockSeconds());
+  }
+  const helium::SpringState state = StateAt(ClockSeconds());
+  if (helium::SpringSettled(state, target_, width_)) {
+    x_ = target_;
+    Apply();
+    Stop();
+    return;
+  }
+  x_ = state.x;
+  Apply();
+}
+
+void SpaceCarousel::AnimationEnded(const gfx::Animation* animation) {
+  // The clock's ceiling, reached only by a spring that never settled.
+  if (animation == &clock_ && active_) {
+    Stop();
+  }
+}
+
+double SpaceCarousel::ClockSeconds() const {
+  return clock_.GetCurrentValue() * kClockSeconds;
+}
+
+helium::SpringState SpaceCarousel::StateAt(double seconds) const {
+  return helium::StepCriticalSpring(origin_, target_, helium::kSpaceSlideOmega,
+                                    std::max(0.0, seconds - origin_seconds_));
+}
+
+std::string SpaceCarousel::SpaceForSlot(int slot,
+                                        int live_slot,
+                                        const std::string& live_space,
+                                        bool wrapping) const {
+  if (slot == live_slot) {
+    return live_space;
+  }
+  if (wrapping) {
+    return std::string();
+  }
+  const std::vector<std::string> order = delegate_->CarouselSpaceOrder();
+  const int live_index = BarIndexOf(live_space);
+  if (live_index < 0) {
+    return std::string();
+  }
+  const int index = live_index + (slot - live_slot);
+  if (index < 0 || index >= static_cast<int>(order.size())) {
+    return std::string();
+  }
+  return order[index];
+}
+
+int SpaceCarousel::BarIndexOf(const std::string& space_id) const {
+  const std::vector<std::string> order = delegate_->CarouselSpaceOrder();
+  for (size_t i = 0; i < order.size(); ++i) {
+    if (order[i] == space_id) {
+      return static_cast<int>(i);
+    }
+  }
+  return -1;
+}
+
+std::vector<std::unique_ptr<HeliumViewSnapshotLayer>>
+SpaceCarousel::CaptureSpace(const std::string& space_id) {
+  helium_workspace::WorkspaceTabController* const controller =
+      delegate_->CarouselController();
+  TabStripView* const strip = delegate_->CarouselStrip();
+  if (!controller || !strip) {
+    return {};
+  }
+  controller->SetViewSpaceOverride(space_id);
+  delegate_->CarouselResyncViews();
+  // At this space's own height: the strip is as tall as its contents.
+  delegate_->CarouselFitStrip();
+  picture_bottom_ = std::max(picture_bottom_, strip->height());
+  ApplyScroll(space_id);
+  return strip->CaptureListSnapshot();
+}
+
+void SpaceCarousel::RestoreLiveViews(const std::string& live_space) {
+  TabStripView* const strip = delegate_->CarouselStrip();
+  if (!strip) {
+    return;
+  }
+  // Laid out for the live space first, at its height (so its scrollers
+  // know their contents' heights), then its own scroll position -- the one
+  // its picture was taken at, if it had one -- and laid out again.
+  delegate_->CarouselFitStrip();
+  ApplyScroll(live_space);
+  strip->DeprecatedLayoutImmediately();
+}
+
+void SpaceCarousel::SaveScroll(const std::string& space_id) {
+  TabStripView* const strip = delegate_->CarouselStrip();
+  if (!strip || space_id.empty()) {
+    return;
+  }
+  ScrollOffsets offsets;
+  if (views::ScrollView* const pinned = strip->pinned_tabs_scroll_view()) {
+    offsets.pinned = pinned->CurrentOffset().y();
+  }
+  if (views::ScrollView* const today = strip->unpinned_tabs_scroll_view()) {
+    offsets.today = today->CurrentOffset().y();
+  }
+  scroll_offsets_[space_id] = offsets;
+}
+
+void SpaceCarousel::ApplyScroll(const std::string& space_id) {
+  TabStripView* const strip = delegate_->CarouselStrip();
+  if (!strip) {
+    return;
+  }
+  // ⚠ Arc's own memory of a space's scroll position was not measured; ours
+  // makes a space's picture and the live list it becomes the same image. A
+  // space not yet left this session starts at the top.
+  const auto it = scroll_offsets_.find(space_id);
+  const ScrollOffsets offsets =
+      it != scroll_offsets_.end() ? it->second : ScrollOffsets();
+  if (views::ScrollView* const pinned = strip->pinned_tabs_scroll_view()) {
+    pinned->ScrollToOffset(
+        gfx::PointF(pinned->CurrentOffset().x(), offsets.pinned));
+  }
+  if (views::ScrollView* const today = strip->unpinned_tabs_scroll_view()) {
+    today->ScrollToOffset(
+        gfx::PointF(today->CurrentOffset().x(), offsets.today));
+  }
+}
+
+void SpaceCarousel::Apply() {
+  TabStripView* const strip = delegate_->CarouselStrip();
+  if (!strip) {
+    return;
+  }
+  const double width = width_;
+  const float live_dx = static_cast<float>((live_slot_ - x_) * width);
+  strip->SetListOffset(live_dx);
+  // A picture of a longer list than the committed one reaches below the
+  // strip's bottom edge; it slides out whole (every Arc list is as long as
+  // its own rows).
+  strip->SetListClipBottom(std::max(strip->height(), picture_bottom_));
+  delegate_->OnCarouselFrame(live_dx);
+  for (auto& [slot, picture] : slots_) {
+    const gfx::Transform transform = gfx::Transform::MakeTranslation(
+        static_cast<float>((slot - x_) * width), 0.0f);
+    for (auto& layer : picture.layers) {
+      layer->layer()->SetTransform(transform);
+    }
+  }
+  delegate_->OnCarouselBlend(BlendAt(x_));
+}
+
+std::map<std::string, float> SpaceCarousel::BlendAt(double x) const {
+  // A motion that starts on its own target (nothing to cover) is simply
+  // there.
+  const double progress = std::abs(target_ - blend_origin_x_) < 1e-6
+                              ? 1.0
+                              : helium::SlideBlend(x, blend_origin_x_, target_);
+  std::map<std::string, float> greys;
+  for (const auto& [space, start] : blend_start_) {
+    const auto end = blend_end_.find(space);
+    const float to = end != blend_end_.end() ? end->second : start;
+    greys[space] = start + (to - start) * static_cast<float>(progress);
+  }
+  return greys;
+}
