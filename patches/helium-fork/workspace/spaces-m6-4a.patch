--- /dev/null
+++ src/chrome/browser/ui/helium/arc_space_motion.h
@@ -0,0 +1,177 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_SPACE_MOTION_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_SPACE_MOTION_H_
+
+#include <algorithm>
+#include <cmath>
+
+#include "base/time/time.h"
+
+// helium-fork M6 轮4: the space-level transitions -- the switch carousel,
+// the two-finger swipe, the bottom bar making way -- measured on Arc
+// 1.165.1 on 2026-09-23 (decisions.md 「M6 轮4」②, recordings g38–g47,
+// evidence tasks/evidence/4/arc/). They sit outside ⛔「侧栏只有三处动效」,
+// which is about rows only (user ruling 2026-09-22, 「M6 轮4」①).
+//
+// Every one of them is a critically damped spring -- no overshoot, stepped
+// in closed form off the real elapsed time, so a dropped frame costs a frame
+// and never the curve. The carousel's unit is the *slot*: one space, one
+// sidebar width. The swipe's finger travel is in points.
+//
+// Header-only and free of //ui/views on purpose, like every other arc_*.h:
+// asserted in helium_workspace_unittests.
+namespace helium {
+
+// Arc g38: a click / Ctrl+number switch is a critically damped spring with
+// a 0.2s period, ω = 2π / 0.2s -- fixed-ω fits of the list's travel held to
+// ≤0.2% over the whole run (switches 1 and 4), half-way at 53ms, 90% at
+// 124ms, 99% at 211ms, the last half point still moving at 290–330ms. A far
+// jump (2 or 3 spaces) rides the same normalised curve (598 / 897pt).
+// ⛔ Replaces M6-r3's LINEAR_OUT_SLOW_IN 180ms (3–17% off in the tail).
+inline constexpr double kSpaceSlideOmega = 31.415926535897932;
+
+// Arc g45 / g47: the bottom bar's icons making way for the Create form's
+// dot, closing up after a delete and opening for an undo -- four fits,
+// ω 25.75–26.5/s (≈1% residual). A little slower than the list.
+inline constexpr double kSpaceBarMakeWayOmega = 26.0;
+
+// Arc g39: the list follows the fingers at 0.500 × scrollingDeltaX (two
+// segments, a = 0.5001 / 0.5000, residual 0.11pt), linear, no dead zone.
+inline constexpr double kSpaceSwipeFollowRatio = 0.5;
+
+// Arc g40 / g44: a release with no inertia completes from half-way on
+// (26% / 44% / 47% went back, 53.7% / 70% / 71% completed). Exactly half is
+// unmeasured; it completes here.
+inline constexpr double kSpaceSwipeCommitFraction = 0.5;
+
+// Arc g42 seg3: past the last space the list moves 0.128–0.141 of what the
+// fingers would have moved it (0.5 × finger), close to linear.
+inline constexpr double kSpaceSwipeRubberBand = 0.135;
+
+// Arc g42 seg3 / seg4: the ⊕ that trails in from the right edge past the
+// last space stops 36pt short of it (x≈263 in a 299pt sidebar) and turns
+// solid once 0.5 × finger passes about 185pt -- ⚠ Arc flips somewhere in
+// 155–214, the exact point was not measured. A release while it is solid
+// opens the Create a Space form.
+inline constexpr int kSpaceSwipePlusRestInset = 36;
+inline constexpr double kSpaceSwipePlusSolidAt = 185.0;
+
+// ⚠ Ours (Arc: "the first stretch picks the axis and it stays", g43): the
+// axis is decided once either finger total reaches this many points.
+inline constexpr double kSpaceSwipeAxisLock = 6.0;
+
+// ⚠ Ours: after the fingers lift, how long to wait for macOS's momentum
+// "began" -- the only way to tell a flick from a slow release. Arc's bounce
+// back starts about 27ms after the lift (g40).
+inline constexpr base::TimeDelta kSpaceSwipeMomentumWait =
+    base::Milliseconds(25);
+
+// A spring has settled when it is within a quarter point of its target and
+// slower than 5pt/s (at W = 299 a one-space slide settles at ≈314ms, inside
+// Arc's 290–330).
+inline constexpr double kSpaceSpringSettlePoints = 0.25;
+inline constexpr double kSpaceSpringSettleSpeed = 5.0;
+
+// Position (units of the caller's choosing) and velocity (units / s).
+struct SpringState {
+  double x = 0.0;
+  double v = 0.0;
+};
+
+// The critically damped spring toward |target|, |t| seconds after |from|:
+//   x(t) = target + (e + (v0 + ωe)t)·e^(−ωt),   e = x0 − target
+//   v(t) = (v0 − ω(v0 + ωe)t)·e^(−ωt)
+// Re-aiming mid-flight is starting a new one from the state reached, so
+// position and velocity stay continuous.
+inline SpringState StepCriticalSpring(const SpringState& from,
+                                      double target,
+                                      double omega,
+                                      double t) {
+  const double e = from.x - target;
+  const double b = from.v + omega * e;
+  const double decay = std::exp(-omega * t);
+  return {target + (e + b * t) * decay, (from.v - omega * b * t) * decay};
+}
+
+// |unit_points|: how many points one unit of |s| is (the sidebar width for
+// the carousel's slots, 1 for the bar's point offsets).
+inline bool SpringSettled(const SpringState& s,
+                          double target,
+                          double unit_points) {
+  return std::abs(s.x - target) * unit_points < kSpaceSpringSettlePoints &&
+         std::abs(s.v) * unit_points < kSpaceSpringSettleSpeed;
+}
+
+// ⚠ Ours: the first frame after a slide starts or re-aims comes after the
+// pictures were taken and the views laid out -- tens of milliseconds on a
+// far jump. The spring takes at most one 60 Hz frame's step across that gap,
+// so the list moves on from where it was shown instead of skipping the
+// stretch nobody saw (a re-aim at full speed jumped ~0.4 space in one frame,
+// 4a pos-r1). Arc's clock runs from the click and its first frame shows
+// 17–25ms of the curve (g38); ours shows at most 16.7ms.
+inline constexpr double kSpaceSpringMaxFirstStep = 1.0 / 60.0;
+
+// The origin (seconds, on the caller's clock) that frame is evaluated
+// against: |origin_seconds|, or one step back from |now_seconds| when the
+// frame came later than that.
+inline double CapFirstStepOrigin(double origin_seconds, double now_seconds) {
+  return std::max(origin_seconds, now_seconds - kSpaceSpringMaxFirstStep);
+}
+
+// Where a released swipe goes, in slots. |x| is the carousel's position,
+// |live| the committed space's slot, |flick| the direction x was heading
+// when macOS carried the gesture on with inertia (+1 toward higher slots, -1
+// toward lower, 0 when it did not -- a slow release). A flick goes the way
+// it points from wherever the list is, even back over the start (Arc g41:
+// released 70% toward the far side, the flick still landed where it
+// pointed); a slow release goes to the nearer slot, and exactly half-way
+// counts as leaving |live|. Clamped to [first, last].
+inline int SwipeReleaseTarget(double x,
+                              int live,
+                              int flick,
+                              int first,
+                              int last) {
+  // Positions within a hair of a slot count as on it (the float x of a
+  // spring that has come to rest).
+  constexpr double kOnSlot = 1e-6;
+  const double lower = std::floor(x + kOnSlot);
+  int target;
+  if (flick > 0) {
+    target = static_cast<int>(std::ceil(x - kOnSlot));
+  } else if (flick < 0) {
+    target = static_cast<int>(lower);
+  } else {
+    const double fraction = x - lower;
+    const int down = static_cast<int>(lower);
+    const int up = down + 1;
+    if (std::abs(fraction - kSpaceSwipeCommitFraction) < kOnSlot) {
+      // A tie leaves the committed slot (≥ half completes).
+      target = down == live ? up : down;
+    } else {
+      target = fraction < kSpaceSwipeCommitFraction ? down : up;
+    }
+  }
+  return std::clamp(target, first, last);
+}
+
+// The list's travel for |overshoot| slots of finger past the last space.
+inline double RubberBandTravel(double overshoot) {
+  return overshoot * kSpaceSwipeRubberBand;
+}
+
+// How far along a slide from |origin| to |target| the carousel at |x| is,
+// 0..1 -- what the bottom bar cross-fades the two icons by (Arc g38: the old
+// and new current emoji trade saturation on the list's own spring).
+inline double SlideBlend(double x, double origin, double target) {
+  if (origin == target) {
+    return 0.0;
+  }
+  return std::clamp((x - origin) / (target - origin), 0.0, 1.0);
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_SPACE_MOTION_H_
Index: src/chrome/browser/ui/helium/arc_space_motion_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_space_motion_unittest.cc
@@ -0,0 +1,149 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_space_motion.h"
+
+#include <cmath>
+#include <numbers>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+// The first time (ms, 0.1ms steps) a slide from rest reaches |fraction|.
+double MsToReach(double fraction, double omega) {
+  for (int tenth = 0; tenth < 20000; ++tenth) {
+    const double t = tenth / 10000.0;
+    if (StepCriticalSpring({0.0, 0.0}, 1.0, omega, t).x >= fraction) {
+      return tenth / 10.0;
+    }
+  }
+  return -1.0;
+}
+
+// The first time (ms) a slide of |slots| sidebar widths of |width| points
+// has settled.
+double MsToSettle(double slots, double width) {
+  for (int ms = 0; ms < 2000; ++ms) {
+    if (SpringSettled(
+            StepCriticalSpring({0.0, 0.0}, slots, kSpaceSlideOmega, ms / 1000.0),
+            slots, width)) {
+      return ms;
+    }
+  }
+  return -1.0;
+}
+
+TEST(ArcSpaceMotionTest, TheSwitchSpringIsArcsTwoTenthsOfASecond) {
+  EXPECT_NEAR(2.0 * std::numbers::pi / 0.2, kSpaceSlideOmega, 1e-9);
+  // decisions 「M6 轮4」②: half at 53ms, 90% at 124ms, 99% at 211ms.
+  EXPECT_NEAR(53.0, MsToReach(0.5, kSpaceSlideOmega), 2.0);
+  EXPECT_NEAR(124.0, MsToReach(0.9, kSpaceSlideOmega), 2.0);
+  EXPECT_NEAR(211.0, MsToReach(0.99, kSpaceSlideOmega), 2.0);
+}
+
+TEST(ArcSpaceMotionTest, ASlideSettlesWhereArcsDid) {
+  // Arc g38: the last half point of a one-space slide in a 299pt sidebar
+  // stopped 290–330ms after the start.
+  const double one = MsToSettle(1.0, 299.0);
+  EXPECT_GE(one, 290.0);
+  EXPECT_LE(one, 330.0);
+  // A three-space jump rides the same curve; its tail is a few points longer
+  // (Arc g38 #3/#4: 350ms from the last still frame).
+  const double three = MsToSettle(3.0, 299.0);
+  EXPECT_GT(three, one);
+  EXPECT_LE(three, 380.0);
+}
+
+TEST(ArcSpaceMotionTest, ReAimingMidFlightKeepsPositionAndSpeed) {
+  const SpringState mid =
+      StepCriticalSpring({0.0, 0.0}, 1.0, kSpaceSlideOmega, 0.05);
+  ASSERT_GT(mid.v, 0.0);
+  const SpringState again = StepCriticalSpring(mid, 3.0, kSpaceSlideOmega, 0.0);
+  EXPECT_DOUBLE_EQ(mid.x, again.x);
+  EXPECT_DOUBLE_EQ(mid.v, again.v);
+  // ...and it does get there, without overshooting.
+  double peak = 0.0;
+  for (int ms = 0; ms <= 600; ++ms) {
+    peak = std::max(
+        peak, StepCriticalSpring(mid, 3.0, kSpaceSlideOmega, ms / 1000.0).x);
+  }
+  EXPECT_LE(peak, 3.0 + 1e-9);
+  EXPECT_NEAR(3.0, StepCriticalSpring(mid, 3.0, kSpaceSlideOmega, 0.6).x, 1e-4);
+}
+
+TEST(ArcSpaceMotionTest, TheFirstFrameAfterAnAimTakesOneStepAtMost) {
+  // A frame on time keeps the spring's own clock.
+  EXPECT_DOUBLE_EQ(0.0, CapFirstStepOrigin(0.0, 0.008));
+  // One 80ms late (pictures taken, views laid out) moves a single 60 Hz
+  // step from where the list was shown.
+  EXPECT_NEAR(0.08 - 1.0 / 60.0, CapFirstStepOrigin(0.0, 0.08), 1e-12);
+  const SpringState shown =
+      StepCriticalSpring({0.0, 0.0}, 2.0, kSpaceSlideOmega, 0.0);
+  const double origin = CapFirstStepOrigin(0.0, 0.08);
+  EXPECT_NEAR(
+      StepCriticalSpring(shown, 2.0, kSpaceSlideOmega, 1.0 / 60.0).x,
+      StepCriticalSpring(shown, 2.0, kSpaceSlideOmega, 0.08 - origin).x,
+      1e-12);
+  // ...and from wherever a re-aim left the spring on its clock.
+  EXPECT_DOUBLE_EQ(1.0, CapFirstStepOrigin(1.0, 1.01));
+}
+
+TEST(ArcSpaceMotionTest, ASlowReleaseGoesToTheNearerSpace) {
+  // Arc g40 / g44 / g39 (live = 2): 26% / 44% / 47% went back, 53.7% / 70% /
+  // 71% completed -- either way.
+  for (double f : {0.26, 0.44, 0.47}) {
+    EXPECT_EQ(2, SwipeReleaseTarget(2.0 + f, 2, 0, 0, 4)) << f;
+    EXPECT_EQ(2, SwipeReleaseTarget(2.0 - f, 2, 0, 0, 4)) << f;
+  }
+  for (double f : {0.537, 0.70, 0.71}) {
+    EXPECT_EQ(3, SwipeReleaseTarget(2.0 + f, 2, 0, 0, 4)) << f;
+    EXPECT_EQ(1, SwipeReleaseTarget(2.0 - f, 2, 0, 0, 4)) << f;
+  }
+  // Exactly half completes.
+  EXPECT_EQ(3, SwipeReleaseTarget(2.5, 2, 0, 0, 4));
+  EXPECT_EQ(1, SwipeReleaseTarget(1.5, 2, 0, 0, 4));
+}
+
+TEST(ArcSpaceMotionTest, AFlickGoesTheWayItPoints) {
+  // Arc g41: fourteen quick flicks that had moved the list only 2.7%–21%
+  // all completed.
+  EXPECT_EQ(3, SwipeReleaseTarget(2.027, 2, +1, 0, 4));
+  EXPECT_EQ(3, SwipeReleaseTarget(2.21, 2, +1, 0, 4));
+  EXPECT_EQ(1, SwipeReleaseTarget(1.79, 2, -1, 0, 4));
+  // Released 70% toward the far side, flicked back: lands where it points.
+  EXPECT_EQ(2, SwipeReleaseTarget(2.7, 2, -1, 0, 4));
+  // Grabbed at 93% of a slide into 2 and flicked back (g41): 1.
+  EXPECT_EQ(1, SwipeReleaseTarget(1.93, 2, -1, 0, 4));
+  EXPECT_EQ(2, SwipeReleaseTarget(1.93, 2, +1, 0, 4));
+}
+
+TEST(ArcSpaceMotionTest, AReleaseNeverLeavesTheStrip) {
+  EXPECT_EQ(4, SwipeReleaseTarget(4.3, 4, +1, 0, 4));
+  EXPECT_EQ(4, SwipeReleaseTarget(4.8, 4, 0, 0, 4));
+  EXPECT_EQ(0, SwipeReleaseTarget(-0.2, 0, -1, 0, 4));
+  EXPECT_EQ(0, SwipeReleaseTarget(-0.9, 0, 0, 0, 4));
+}
+
+TEST(ArcSpaceMotionTest, TheRubberBandIsLinear) {
+  EXPECT_DOUBLE_EQ(0.0, RubberBandTravel(0.0));
+  EXPECT_DOUBLE_EQ(0.135, RubberBandTravel(1.0));
+  // Arc g42 seg3: 0.5 × finger at 296pt moved the list about 38pt.
+  EXPECT_NEAR(40.0, RubberBandTravel(296.0), 0.1);
+}
+
+TEST(ArcSpaceMotionTest, TheBarBlendFollowsTheSlide) {
+  EXPECT_DOUBLE_EQ(0.0, SlideBlend(1.0, 1.0, 3.0));
+  EXPECT_DOUBLE_EQ(0.5, SlideBlend(2.0, 1.0, 3.0));
+  EXPECT_DOUBLE_EQ(1.0, SlideBlend(3.0, 1.0, 3.0));
+  // Leftward too, and clamped at both ends.
+  EXPECT_DOUBLE_EQ(0.25, SlideBlend(2.5, 3.0, 1.0));
+  EXPECT_DOUBLE_EQ(0.0, SlideBlend(0.9, 1.0, 3.0));
+  EXPECT_DOUBLE_EQ(1.0, SlideBlend(3.01, 1.0, 3.0));
+  EXPECT_DOUBLE_EQ(0.0, SlideBlend(2.0, 2.0, 2.0));
+}
+
+}  // namespace
+}  // namespace helium
