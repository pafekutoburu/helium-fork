+// helium-fork M6 轮4: the space carousel (decisions.md 「M6 轮4」④, design
+// tasks/4/brief.md §2). The spaces stand side by side in bar order, one
+// sidebar width apart; slot i sits (i − x)·W from where the list rests, and
+// x -- the carousel's position, in slots -- is driven by one critically
+// damped spring (arc_space_motion.h). The committed space is the live list
+// (TabStripView's four sliding views); every other space on screen is a
+// picture taken while the views were briefly pointed at it
+// (WorkspaceTabController::shown_space_id). A click, a key, a far jump and a
+// switch that arrives mid-slide are all "aim the spring at another slot":
+// Arc g38 slid a two- and a three-space jump through the spaces in between
+// on the one-space curve, and a new switch picks up from wherever the list
+// is. Transforms only per frame; the views re-layout only at the discrete
+// moments a picture is taken.
+class SpaceCarousel : public views::AnimationDelegateViews {
+ public:
+  class Delegate {
+   public:
+    virtual TabStripView* CarouselStrip() = 0;
+    virtual helium_workspace::WorkspaceTabController* CarouselController() = 0;
+    // The profile's space ids in bar order.
+    virtual std::vector<std::string> CarouselSpaceOrder() = 0;
+    // Re-filters the sidebar and Today to the controller's shown_space_id()
+    // -- synchronously; the carousel lays the strip out itself.
+    virtual void CarouselResyncViews() = 0;
+    // Gives the strip the bounds the region's layout would give it for the
+    // space the views show now -- it is as tall as its contents -- and lays
+    // it out.
+    virtual void CarouselFitStrip() = 0;
+    // Every frame: the live list's offset (the row shadows ride it).
+    virtual void OnCarouselFrame(float live_dx) = 0;
+    // The bottom bar's cross-fade: how grey each icon the motion involves
+    // is right now (0 in full colour, 1 fully grey); icons not listed keep
+    // their resting look. An empty map clears it.
+    virtual void OnCarouselBlend(const std::map<std::string, float>& greys) = 0;
+    // At rest again: the live list's offset is 0, every picture is gone.
+    virtual void OnCarouselEnded() = 0;
+
+   protected:
+    virtual ~Delegate() = default;
+  };
+
+  SpaceCarousel(views::View* host, Delegate* delegate);
+  SpaceCarousel(const SpaceCarousel&) = delete;
+  SpaceCarousel& operator=(const SpaceCarousel&) = delete;
+  ~SpaceCarousel() override;
+
+  // The controller's switch, relayed by the region: WillChange (the views
+  // still show the space being left) and Activated (the new space's tab is
+  // active, the old space's blank page not yet closed).
+  void OnSwitchWillStart(int direction);
+  void OnSwitchActivated();
+
+  // Whether anything but the committed list at rest is on screen.
+  bool IsActive() const { return active_; }
+  // Lands at once: the live list at rest, every picture gone. Safe idle.
+  void Stop();
+
+ private:
+  struct Slot {
+    Slot();
+    Slot(Slot&&);
+    Slot& operator=(Slot&&);
+    ~Slot();
+
+    std::string space_id;
+    std::vector<std::unique_ptr<HeliumViewSnapshotLayer>> layers;
+  };
+  struct ScrollOffsets {
+    float pinned = 0.0f;
+    float today = 0.0f;
+  };
+
+  // views::AnimationDelegateViews:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+  // Seconds since the clock started, as of its last tick.
+  double ClockSeconds() const;
+  helium::SpringState StateAt(double seconds) const;
+  // The space in slot |slot| for a motion whose live slot |live_slot| holds
+  // |live_space|; empty past either end of the bar or when |wrapping|.
+  std::string SpaceForSlot(int slot,
+                           int live_slot,
+                           const std::string& live_space,
+                           bool wrapping) const;
+  int BarIndexOf(const std::string& space_id) const;
+  // Points the views at |space_id| and photographs the list. The views are
+  // left pointed there; RestoreLiveViews() points them back.
+  std::vector<std::unique_ptr<HeliumViewSnapshotLayer>> CaptureSpace(
+      const std::string& space_id);
+  void RestoreLiveViews(const std::string& live_space);
+  void SaveScroll(const std::string& space_id);
+  void ApplyScroll(const std::string& space_id);
+  void Apply();
+  // The involved icons' greys at |x|.
+  std::map<std::string, float> BlendAt(double x) const;
+
+  const raw_ptr<Delegate> delegate_;
+  // A clock and nothing more: the spring is evaluated off its elapsed time
+  // (compositor-driven through AnimationDelegateViews, so every vsync).
+  gfx::LinearAnimation clock_;
+
+  bool active_ = false;
+  // Between OnSwitchWillStart and OnSwitchActivated.
+  bool pending_ = false;
+  int pending_direction_ = 0;
+  std::string pending_from_;
+
+  int live_slot_ = 0;
+  std::string live_space_;
+  // Pictures, by slot. The live slot never has one.
+  std::map<int, Slot> slots_;
+  // The spring: from |origin_| at |origin_seconds_| on the clock toward
+  // |target_|; |x_| is the position last applied.
+  double target_ = 0.0;
+  helium::SpringState origin_;
+  double origin_seconds_ = 0.0;
+  // Set by a (re)aim: its first frame steps the spring by at most
+  // helium::kSpaceSpringMaxFirstStep.
+  bool cap_first_step_ = false;
+  double x_ = 0.0;
+  // The sidebar width the pictures were taken at.
+  int width_ = 0;
+  // The lowest bottom edge of any picture, in the strip's coordinates: a
+  // space with more rows than the committed one was photographed in a
+  // taller strip, and the strip stops clipping there while the motion runs.
+  int picture_bottom_ = 0;
+  // The bar's cross-fade (Arc g38: the old and the new current emoji trade
+  // saturation on the list's spring): each involved icon runs from its
+  // grey at the motion's start to its grey at the end, by how far x has come
+  // from |blend_origin_x_| toward the target. A switch that arrives mid-slide
+  // starts from whatever is on screen at that moment (reviewer 4a diff r0:
+  // re-aiming at the space passing by used to freeze the fade and flip it
+  // at the end).
+  std::map<std::string, float> blend_start_;
+  std::map<std::string, float> blend_end_;
+  double blend_origin_x_ = 0.0;
+  // Each space's two scrollers, as they were when it was last left.
+  std::map<std::string, ScrollOffsets> scroll_offsets_;
+};
