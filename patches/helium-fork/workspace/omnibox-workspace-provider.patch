@@ -0,0 +1,42 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_FAVICON_IMAGE_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_FAVICON_IMAGE_H_
+
+#include <string>
+
+#include "base/containers/span.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/gfx/codec/png_codec.h"
+#include "ui/gfx/favicon_size.h"
+#include "ui/gfx/image/image_skia.h"
+
+namespace helium_workspace {
+
+// helium-fork r8③: decodes an entry's persisted favicon (WorkspaceEntry::
+// favicon_png) into a 16 dip image. The stored PNG carries whatever density
+// the tab had, so the scale is recovered from its pixel width instead of
+// assuming 1x -- otherwise a 32px icon is drawn as 32 dip, and a 16px one is
+// stretched on a Retina display. Dividing by kFaviconSize normalises any
+// source size to the 16 dip both the sidebar row and the omnibox row draw at
+// (the omnibox's GetSizedIcon() DCHECKs on anything larger). Returns a null
+// image when there is nothing usable; callers fall through to their next
+// source.
+inline gfx::ImageSkia DecodeWorkspaceFavicon(const std::string& favicon_png) {
+  if (favicon_png.empty()) {
+    return gfx::ImageSkia();
+  }
+  const SkBitmap bitmap =
+      gfx::PNGCodec::Decode(base::as_byte_span(favicon_png));
+  if (bitmap.isNull() || bitmap.width() <= 0) {
+    return gfx::ImageSkia();
+  }
+  const float scale = static_cast<float>(bitmap.width()) / gfx::kFaviconSize;
+  return gfx::ImageSkia::CreateFromBitmap(bitmap, scale);
+}
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_FAVICON_IMAGE_H_
Index: src/chrome/browser/ui/helium_workspace/workspace_omnibox_match.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/workspace_omnibox_match.h
@@ -0,0 +1,121 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_OMNIBOX_MATCH_H_
+#define CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_OMNIBOX_MATCH_H_
+
+#include <stddef.h>
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/i18n/case_conversion.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/helium_workspace/workspace_entry.h"
+#include "url/gurl.h"
+
+namespace helium_workspace {
+
+// helium-fork r8③: which sidebar entries the omnibox offers for a typed input,
+// and in what order. This is the single source of truth the omnibox provider
+// (HeliumWorkspaceProvider, components/omnibox) is fed from; it is pure and
+// dependency-free so helium_workspace_unittests can pin the rule.
+//
+// Rule: split the input on whitespace and fold case; every term must be a
+// prefix of some whitespace-separated word of the title, or a substring of the
+// URL haystack (spec without scheme and without a leading "www."). A term is
+// normalised the same way the haystack is -- a leading "http://", "https://"
+// or "www." is dropped -- so typing the URL the way the omnibox shows it
+// ("www.you", "https://you") still finds the entry. Output keeps the order of
+// |entries| -- which WorkspaceService already sorts favorites first, then by
+// position -- and |rank| is dense over the hits only.
+struct WorkspaceOmniboxMatch {
+  size_t index = 0;  // Into the |entries| span that was matched.
+  int rank = 0;      // 0 for the first hit, 1 for the second, ...
+};
+
+// The part of |url| the input is searched in: host (minus a leading "www.")
+// plus path and query, case-folded. Empty for an invalid URL.
+inline std::u16string WorkspaceUrlHaystack(const GURL& url) {
+  if (!url.is_valid()) {
+    return std::u16string();
+  }
+  std::string host(url.host());
+  if (host.starts_with("www.")) {
+    host.erase(0, 4);
+  }
+  return base::i18n::ToLower(base::UTF8ToUTF16(host + url.PathForRequest()));
+}
+
+// Drops the prefixes the haystack never contains, so a term compares like for
+// like. "www." alone (or a bare scheme) becomes empty and then matches nothing.
+inline std::u16string_view NormalizeWorkspaceSearchTerm(
+    std::u16string_view term) {
+  for (std::u16string_view scheme : {u"https://", u"http://"}) {
+    if (term.starts_with(scheme)) {
+      term.remove_prefix(scheme.size());
+      break;
+    }
+  }
+  if (term.starts_with(u"www.")) {
+    term.remove_prefix(4);
+  }
+  return term;
+}
+
+inline std::vector<WorkspaceOmniboxMatch> MatchWorkspaceEntries(
+    base::span<const WorkspaceEntry> entries,
+    std::u16string_view input) {
+  std::vector<WorkspaceOmniboxMatch> hits;
+  const std::u16string lower_input = base::i18n::ToLower(input);
+  std::vector<std::u16string_view> terms = base::SplitStringPiece(
+      lower_input, base::kWhitespaceUTF16, base::TRIM_WHITESPACE,
+      base::SPLIT_WANT_NONEMPTY);
+  for (std::u16string_view& term : terms) {
+    term = NormalizeWorkspaceSearchTerm(term);
+    if (term.empty()) {
+      return hits;
+    }
+  }
+  if (terms.empty()) {
+    return hits;
+  }
+
+  for (size_t i = 0; i < entries.size(); ++i) {
+    const WorkspaceEntry& entry = entries[i];
+    if (!entry.url.is_valid()) {
+      continue;
+    }
+    const std::u16string haystack = WorkspaceUrlHaystack(entry.url);
+    const std::u16string lower_title = base::i18n::ToLower(entry.title);
+    const std::vector<std::u16string_view> title_words =
+        base::SplitStringPiece(lower_title, base::kWhitespaceUTF16,
+                               base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+
+    bool all_terms_hit = true;
+    for (std::u16string_view term : terms) {
+      bool hit = haystack.find(term) != std::u16string::npos;
+      for (size_t w = 0; !hit && w < title_words.size(); ++w) {
+        hit = base::StartsWith(title_words[w], term,
+                               base::CompareCase::SENSITIVE);
+      }
+      if (!hit) {
+        all_terms_hit = false;
+        break;
+      }
+    }
+    if (all_terms_hit) {
+      hits.push_back({.index = i, .rank = static_cast<int>(hits.size())});
+    }
+  }
+  return hits;
+}
+
+}  // namespace helium_workspace
+
+#endif  // CHROME_BROWSER_UI_HELIUM_WORKSPACE_WORKSPACE_OMNIBOX_MATCH_H_
Index: src/chrome/browser/ui/helium_workspace/workspace_omnibox_match_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium_workspace/workspace_omnibox_match_unittest.cc
@@ -0,0 +1,172 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// helium-fork r8③: pins the sidebar-entries matching rule.
+#include "chrome/browser/ui/helium_workspace/workspace_omnibox_match.h"
+
+#include <string>
+#include <vector>
+
+#include "chrome/browser/ui/helium_workspace/workspace_entry.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace helium_workspace {
+namespace {
+
+WorkspaceEntry MakeEntry(WorkspaceEntry::Section section,
+                         const std::string& url,
+                         const std::u16string& title) {
+  WorkspaceEntry entry;
+  entry.id = url;
+  entry.section = section;
+  entry.url = GURL(url);
+  entry.title = title;
+  return entry;
+}
+
+// Favorites first, then pinned -- the order WorkspaceService::entries() keeps.
+std::vector<WorkspaceEntry> Entries() {
+  return {
+      MakeEntry(WorkspaceEntry::Section::kFavorite,
+                "https://www.youtube.com/", u"YouTube - Home"),
+      MakeEntry(WorkspaceEntry::Section::kFavorite,
+                "https://example.com/docs?q=1", u"Project Alpha"),
+      MakeEntry(WorkspaceEntry::Section::kPinned, "https://music.youtube.com/",
+                u"YouTube Music"),
+  };
+}
+
+std::vector<size_t> Indices(const std::vector<WorkspaceOmniboxMatch>& hits) {
+  std::vector<size_t> out;
+  for (const auto& hit : hits) {
+    out.push_back(hit.index);
+  }
+  return out;
+}
+
+TEST(WorkspaceOmniboxMatchTest, EmptyOrWhitespaceInputMatchesNothing) {
+  const auto entries = Entries();
+  EXPECT_TRUE(MatchWorkspaceEntries(entries, u"").empty());
+  EXPECT_TRUE(MatchWorkspaceEntries(entries, u"   \t ").empty());
+}
+
+TEST(WorkspaceOmniboxMatchTest, TitleWordPrefixMatchesCaseInsensitively) {
+  const auto entries = Entries();
+  EXPECT_EQ(Indices(MatchWorkspaceEntries(entries, u"You")),
+            (std::vector<size_t>{0, 2}));
+  EXPECT_EQ(Indices(MatchWorkspaceEntries(entries, u"ALPHA")),
+            (std::vector<size_t>{1}));
+}
+
+TEST(WorkspaceOmniboxMatchTest, TitleMidWordDoesNotMatchWhenUrlDoesNot) {
+  const auto entries = Entries();
+  // "pha" is inside "Alpha" but not at a word start, and example.com/docs?q=1
+  // does not contain it either.
+  EXPECT_TRUE(MatchWorkspaceEntries(entries, u"pha").empty());
+}
+
+TEST(WorkspaceOmniboxMatchTest, UrlHaystackDropsSchemeAndWww) {
+  const auto entries = Entries();
+  EXPECT_TRUE(MatchWorkspaceEntries(entries, u"http").empty());
+  EXPECT_TRUE(MatchWorkspaceEntries(entries, u"www").empty());
+  // Mid-host substring: not a title-word prefix, but in the haystack.
+  EXPECT_EQ(Indices(MatchWorkspaceEntries(entries, u"tube")),
+            (std::vector<size_t>{0, 2}));
+}
+
+TEST(WorkspaceOmniboxMatchTest, TermsDropSchemeAndWwwLikeTheHaystack) {
+  const auto entries = Entries();
+  // Typed the way the omnibox displays or completes a URL. After the prefix
+  // is dropped these are plain substring terms again, so the pinned
+  // music.youtube.com entry matches alongside the favorite.
+  EXPECT_EQ(Indices(MatchWorkspaceEntries(entries, u"www.you")),
+            (std::vector<size_t>{0, 2}));
+  EXPECT_EQ(Indices(MatchWorkspaceEntries(entries, u"https://you")),
+            (std::vector<size_t>{0, 2}));
+  EXPECT_EQ(Indices(MatchWorkspaceEntries(entries, u"http://music.you")),
+            (std::vector<size_t>{2}));
+  EXPECT_EQ(Indices(MatchWorkspaceEntries(entries, u"https://www.youtube.com")),
+            (std::vector<size_t>{0, 2}));
+  // A bare prefix carries no information: nothing matches.
+  EXPECT_TRUE(MatchWorkspaceEntries(entries, u"www.").empty());
+  EXPECT_TRUE(MatchWorkspaceEntries(entries, u"https://").empty());
+  EXPECT_TRUE(MatchWorkspaceEntries(entries, u"you https://").empty());
+}
+
+TEST(WorkspaceOmniboxMatchTest, UrlPathAndQueryAreSearchable) {
+  const auto entries = Entries();
+  EXPECT_EQ(Indices(MatchWorkspaceEntries(entries, u"docs")),
+            (std::vector<size_t>{1}));
+  EXPECT_EQ(Indices(MatchWorkspaceEntries(entries, u"q=1")),
+            (std::vector<size_t>{1}));
+}
+
+TEST(WorkspaceOmniboxMatchTest, EveryTermMustMatch) {
+  const auto entries = Entries();
+  EXPECT_EQ(Indices(MatchWorkspaceEntries(entries, u"you home")),
+            (std::vector<size_t>{0}));
+  EXPECT_TRUE(MatchWorkspaceEntries(entries, u"you xyz").empty());
+}
+
+TEST(WorkspaceOmniboxMatchTest, TermsMaySplitAcrossTitleAndUrl) {
+  const auto entries = Entries();
+  // "tube" only lives in the URL, "home" only in the title.
+  EXPECT_EQ(Indices(MatchWorkspaceEntries(entries, u"tube home")),
+            (std::vector<size_t>{0}));
+}
+
+TEST(WorkspaceOmniboxMatchTest, OrderIsInputOrderAndRankIsDense) {
+  const auto entries = Entries();
+  const auto hits = MatchWorkspaceEntries(entries, u"youtube");
+  ASSERT_EQ(hits.size(), 2u);
+  EXPECT_EQ(hits[0].index, 0u);
+  EXPECT_EQ(hits[0].rank, 0);
+  // Entry 1 did not match, so the pinned entry is rank 1, not 2.
+  EXPECT_EQ(hits[1].index, 2u);
+  EXPECT_EQ(hits[1].rank, 1);
+}
+
+TEST(WorkspaceOmniboxMatchTest, NonAsciiCaseFoldingAndCjkSubstring) {
+  const std::vector<WorkspaceEntry> entries = {
+      MakeEntry(WorkspaceEntry::Section::kFavorite, "https://uber.example/",
+                u"ÜBER Fahrt"),
+      MakeEntry(WorkspaceEntry::Section::kPinned, "https://bilibili.com/",
+                u"哔哩哔哩 动画"),
+  };
+  EXPECT_EQ(Indices(MatchWorkspaceEntries(entries, u"über")),
+            (std::vector<size_t>{0}));
+  EXPECT_EQ(Indices(MatchWorkspaceEntries(entries, u"动画")),
+            (std::vector<size_t>{1}));
+  // CJK has no word boundary inside a run: a mid-run character is not a
+  // prefix of the word, and the URL does not help.
+  EXPECT_TRUE(MatchWorkspaceEntries(entries, u"哩").empty());
+}
+
+TEST(WorkspaceOmniboxMatchTest, InvalidUrlEntryIsSkipped) {
+  std::vector<WorkspaceEntry> entries = Entries();
+  entries.push_back(MakeEntry(WorkspaceEntry::Section::kFavorite, "not a url",
+                              u"YouTube broken"));
+  EXPECT_EQ(Indices(MatchWorkspaceEntries(entries, u"youtube")),
+            (std::vector<size_t>{0, 2}));
+}
+
+TEST(WorkspaceOmniboxMatchTest, MultipleSpacesAndTabsTokenize) {
+  const auto entries = Entries();
+  EXPECT_EQ(Indices(MatchWorkspaceEntries(entries, u"  you \t\t home  ")),
+            (std::vector<size_t>{0}));
+}
+
+TEST(WorkspaceOmniboxMatchTest, HaystackHelperExactOutput) {
+  EXPECT_EQ(WorkspaceUrlHaystack(GURL("https://www.YouTube.com/")),
+            u"youtube.com/");
+  EXPECT_EQ(WorkspaceUrlHaystack(GURL("http://example.com/Docs?Q=1#frag")),
+            u"example.com/docs?q=1");
+  EXPECT_EQ(WorkspaceUrlHaystack(GURL("https://wwwhat.example/")),
+            u"wwwhat.example/");
+  EXPECT_EQ(WorkspaceUrlHaystack(GURL("not a url")), u"");
+}
+
+}  // namespace
+}  // namespace helium_workspace
