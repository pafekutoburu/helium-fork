@@ -62,6 +62,10 @@
 #include "chrome/browser/ui/browser_window.h"
 #include "chrome/browser/ui/browser_window/public/browser_window_features.h"
 #include "chrome/browser/ui/hats/hats_service.h"
+#include "chrome/browser/ui/helium_workspace/workspace_entry.h"
+#include "chrome/browser/ui/helium_workspace/workspace_favicon_image.h"
+#include "chrome/browser/ui/helium_workspace/workspace_service.h"
+#include "chrome/browser/ui/helium_workspace/workspace_service_factory.h"
 #include "chrome/browser/ui/hats/hats_service_factory.h"
 #include "chrome/browser/ui/layout_constants.h"
 #include "chrome/browser/ui/lens/lens_search_controller.h"
@@ -738,6 +742,33 @@ void ChromeOmniboxClient::OnResultChange
 gfx::Image ChromeOmniboxClient::GetFaviconForPageUrl(
     const GURL& page_url,
     FaviconFetchedCallback on_favicon_fetched) {
+  // helium-fork r8③: a sidebar entry's own icon first -- the favicon database
+  // has nothing for a favorite whose history was cleared, and the sidebar
+  // already draws from this PNG, so the list and the sidebar agree. The
+  // factory returns null for incognito / guest profiles.
+  if (helium_workspace::WorkspaceService* service =
+          helium_workspace::WorkspaceServiceFactory::GetForProfile(profile_)) {
+    for (const helium_workspace::WorkspaceEntry& entry : service->entries()) {
+      if (entry.url != page_url || entry.favicon_png.empty()) {
+        continue;
+      }
+      auto it = workspace_favicons_.find(entry.id);
+      if (it == workspace_favicons_.end() ||
+          it->second.first != entry.favicon_png.size()) {
+        const gfx::ImageSkia image =
+            helium_workspace::DecodeWorkspaceFavicon(entry.favicon_png);
+        if (image.isNull()) {
+          break;
+        }
+        it = workspace_favicons_
+                 .insert_or_assign(entry.id,
+                                   std::make_pair(entry.favicon_png.size(),
+                                                  gfx::Image(image)))
+                 .first;
+      }
+      return it->second.second;
+    }
+  }
   return favicon_cache_.GetFaviconForPageUrl(page_url,
                                              std::move(on_favicon_fetched));
 }
