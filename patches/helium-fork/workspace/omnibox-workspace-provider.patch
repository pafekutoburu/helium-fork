@@ -0,0 +1,47 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef COMPONENTS_OMNIBOX_BROWSER_HELIUM_WORKSPACE_PROVIDER_H_
+#define COMPONENTS_OMNIBOX_BROWSER_HELIUM_WORKSPACE_PROVIDER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "components/omnibox/browser/autocomplete_input.h"
+#include "components/omnibox/browser/autocomplete_provider.h"
+
+class AutocompleteProviderClient;
+
+// helium-fork r8③: offers the sidebar's persistent entries (favorites first,
+// then pinned) as suggestions for typed input -- the sidebar's counterpart of
+// BookmarkProvider. Synchronous: everything is answered inside Start().
+//
+// The candidate list and its order come from
+// AutocompleteProviderClient::GetHeliumWorkspaceCandidates(); this class only
+// turns them into matches. Two deliberate choices:
+//  * The matches are typed OPEN_TAB so they win deduplication against the
+//    history/bookmark rows for the same URL (AutocompleteMatch::
+//    BetterDuplicate prefers OPEN_TAB before anything else); the surviving row
+//    therefore carries this provider, which is what AutocompleteMatch::
+//    GetSortingOrder() keys on to place it above search suggestions.
+//  * Inline autocompletion is computed here, verbatim after
+//    HistoryQuickProvider, because dedup never hands the loser's inline text
+//    to the winner -- without it "you" would stop completing to youtube.com
+//    the moment YouTube became a favorite.
+// Selecting a row navigates like any URL row (no takeover action): the user's
+// 2026-08-22 ruling, matching Chromium and Dia.
+class HeliumWorkspaceProvider : public AutocompleteProvider {
+ public:
+  explicit HeliumWorkspaceProvider(AutocompleteProviderClient* client);
+  HeliumWorkspaceProvider(const HeliumWorkspaceProvider&) = delete;
+  HeliumWorkspaceProvider& operator=(const HeliumWorkspaceProvider&) = delete;
+
+  // AutocompleteProvider:
+  void Start(const AutocompleteInput& input, bool minimal_changes) override;
+
+ private:
+  ~HeliumWorkspaceProvider() override;
+
+  raw_ptr<AutocompleteProviderClient> client_;
+};
+
+#endif  // COMPONENTS_OMNIBOX_BROWSER_HELIUM_WORKSPACE_PROVIDER_H_
