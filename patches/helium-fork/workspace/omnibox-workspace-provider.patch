--- /dev/null
+++ src/components/omnibox/browser/helium_workspace_provider.cc
@@ -0,0 +1,139 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+// helium-fork r8③: see the header for the design notes.
+#include "components/omnibox/browser/helium_workspace_provider.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/i18n/case_conversion.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/omnibox/browser/autocomplete_input.h"
+#include "components/omnibox/browser/autocomplete_match.h"
+#include "components/omnibox/browser/autocomplete_match_classification.h"
+#include "components/omnibox/browser/autocomplete_provider_client.h"
+#include "components/omnibox/browser/omnibox_field_trial.h"
+#include "components/omnibox/browser/url_prefix.h"
+#include "components/url_formatter/url_formatter.h"
+#include "url/gurl.h"
+
+namespace {
+
+// Above HistoryQuickProvider's ceiling (kScoreForBestInlineableResult, 1413),
+// so a favorite whose URL the user is typing is the default match rather than
+// the history row it deduplicates with (AutocompleteResult::FindTopMatch picks
+// the highest-relevance default-able row). Rows that cannot be the default
+// only need to stay above the 1300 search verbatim for culling purposes; their
+// on-screen slot is decided by AutocompleteMatch::GetSortingOrder().
+constexpr int kDefaultableRelevance = 1430;
+constexpr int kRelevance = 1390;
+
+}  // namespace
+
+HeliumWorkspaceProvider::HeliumWorkspaceProvider(
+    AutocompleteProviderClient* client)
+    : AutocompleteProvider(AutocompleteProvider::TYPE_HELIUM_WORKSPACE),
+      client_(client) {}
+
+HeliumWorkspaceProvider::~HeliumWorkspaceProvider() = default;
+
+void HeliumWorkspaceProvider::Start(const AutocompleteInput& input,
+                                    bool minimal_changes) {
+  matches_.clear();
+  // Nothing at rest (Dia's blank composer shows no list), nothing inside a
+  // keyword / starter-pack scope, and nothing for `@` inputs, whose only
+  // permitted default is search-what-you-typed.
+  if (input.IsZeroSuggest() || input.text().empty() ||
+      input.in_keyword_mode() || input.text().starts_with(u'@')) {
+    return;
+  }
+
+  const std::vector<HeliumWorkspaceCandidate> candidates =
+      client_->GetHeliumWorkspaceCandidates(input.text());
+  if (candidates.empty()) {
+    return;
+  }
+
+  const std::u16string fixed_up_input = FixupUserInput(input).second;
+  const bool input_has_scheme = input.parts().scheme.is_nonempty();
+  const bool input_has_www =
+      base::i18n::ToLower(input.text()).starts_with(u"www.");
+
+  int rank = 0;
+  for (const HeliumWorkspaceCandidate& candidate : candidates) {
+    const GURL& url = candidate.url;
+    if (!url.is_valid()) {
+      continue;
+    }
+
+    AutocompleteMatch match(this, /*relevance=*/0, /*deletable=*/false,
+                            AutocompleteMatchType::OPEN_TAB);
+    match.destination_url = url;
+
+    // Inline autocompletion, verbatim after
+    // HistoryQuickProvider::QuickMatchToACMatch: the offset is adjusted by the
+    // formatting applied to |fill_into_edit|.
+    size_t inline_autocomplete_offset = URLPrefix::GetInlineAutocompleteOffset(
+        input.text(), fixed_up_input,
+        /*allow_www_prefix_without_scheme=*/false,
+        base::UTF8ToUTF16(url.spec()));
+    auto fill_into_edit_format_types = url_formatter::kFormatUrlOmitDefaults;
+    if (AutocompleteInput::HasHTTPScheme(input.text())) {
+      fill_into_edit_format_types &= ~url_formatter::kFormatUrlOmitHTTP;
+    }
+    match.fill_into_edit =
+        AutocompleteInput::FormattedStringWithEquivalentMeaning(
+            url,
+            url_formatter::FormatUrl(url, fill_into_edit_format_types,
+                                     base::UnescapeRule::SPACES, nullptr,
+                                     nullptr, &inline_autocomplete_offset),
+            client_->GetSchemeClassifier(), &inline_autocomplete_offset);
+
+    match.contents = url_formatter::FormatUrl(
+        url,
+        AutocompleteMatch::GetFormatTypes(
+            /*preserve_scheme=*/input_has_scheme,
+            /*preserve_subdomain=*/input_has_www),
+        base::UnescapeRule::SPACES, nullptr, nullptr, nullptr);
+    const TermMatches contents_terms =
+        FindTermMatches(input.text(), match.contents);
+    match.contents_class = ClassifyTermMatches(
+        contents_terms, match.contents.size(),
+        ACMatchClassification::MATCH | ACMatchClassification::URL,
+        ACMatchClassification::URL);
+
+    match.description = AutocompleteMatch::SanitizeString(candidate.title);
+    const TermMatches description_terms =
+        FindTermMatches(input.text(), match.description);
+    match.description_class = ClassifyTermMatches(
+        description_terms, match.description.size(),
+        ACMatchClassification::MATCH, ACMatchClassification::NONE);
+
+    // Set |inline_autocompletion| and |allowed_to_be_default_match| if
+    // possible; otherwise the row stays a non-default suggestion. (Do not call
+    // SetAllowedToBeDefault() with an empty inline text -- it would allow any
+    // match, whatever the input.)
+    if (match.TryRichAutocompletion(input, match.contents,
+                                    match.description)) {
+      // Rich autocompletion applies; skip the plain alternative below.
+    } else if (inline_autocomplete_offset != std::u16string::npos) {
+      match.inline_autocompletion =
+          match.fill_into_edit.substr(inline_autocomplete_offset);
+      match.SetAllowedToBeDefault(input);
+    }
+
+    match.relevance =
+        (match.allowed_to_be_default_match ? kDefaultableRelevance
+                                           : kRelevance) -
+        rank;
+    match.RecordAdditionalInfo("helium_workspace_rank", rank);
+    matches_.push_back(std::move(match));
+    ++rank;
+  }
+
+  ResizeMatches(provider_max_matches(),
+                OmniboxFieldTrial::IsMlUrlScoringEnabled());
+}
