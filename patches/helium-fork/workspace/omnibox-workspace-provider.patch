+std::vector<HeliumWorkspaceCandidate>
+ChromeAutocompleteProviderClient::GetHeliumWorkspaceCandidates(
+    const std::u16string& input_text) {
+  std::vector<HeliumWorkspaceCandidate> candidates;
+  // helium-fork r8③: the factory builds no service for incognito / guest
+  // profiles, so those windows simply get no sidebar rows.
+  helium_workspace::WorkspaceService* service =
+      helium_workspace::WorkspaceServiceFactory::GetForProfile(profile_);
+  if (!service) {
+    return candidates;
+  }
+  const std::vector<helium_workspace::WorkspaceEntry>& entries =
+      service->entries();
+  for (const helium_workspace::WorkspaceOmniboxMatch& hit :
+       helium_workspace::MatchWorkspaceEntries(entries, input_text)) {
+    candidates.push_back({.url = entries[hit.index].url,
+                          .title = entries[hit.index].title});
+  }
+  return candidates;
+}
+
 bool ChromeAutocompleteProviderClient::IsIncognitoModeAvailable() const {
   return IncognitoModePrefs::IsIncognitoAllowed(profile_);
 }
