+int WorkspaceFolderRowView::RowHeight() const {
+  return GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+}
+
+gfx::Size WorkspaceFolderRowView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  const int width =
+      available_size.width().is_bounded()
+          ? available_size.width().value()
+          : GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth);
+  return gfx::Size(width, RowHeight());
+}
+
+void WorkspaceFolderRowView::Layout(PassKey) {
+  icon_->SetBounds(kFolderRowIconLeadingInset,
+                   (height() - kFolderRowIconSize) / 2, kFolderRowIconSize,
+                   kFolderRowIconSize);
+  // The name takes only what it needs so the chevron can follow it; what it
+  // may take stops short of the chevron and the trailing inset.
+  const gfx::Size title_size = title_->GetPreferredSize();
+  const int title_max =
+      std::max(0, width() - kFolderRowTitleX - kFolderRowInnerSpacing -
+                      kFolderRowChevronSize - kFolderRowTrailingInset);
+  const int title_width = std::min(title_size.width(), title_max);
+  title_->SetBounds(kFolderRowTitleX, (height() - title_size.height()) / 2,
+                    title_width, title_size.height());
+  chevron_->SetBounds(title_->bounds().right() + kFolderRowInnerSpacing,
+                      (height() - kFolderRowChevronSize) / 2,
+                      kFolderRowChevronSize, kFolderRowChevronSize);
+  // The editor takes the full name run -- it needs room to grow while the
+  // user types, not just the committed name's width.
+  const int editor_height = editor_->GetPreferredSize().height();
+  editor_->SetBounds(kFolderRowTitleX, (height() - editor_height) / 2,
+                     title_max, editor_height);
+}
+
+void WorkspaceFolderRowView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  const ui::ColorProvider* colors = GetColorProvider();
+  if ((!hovered_ && !drop_target_ && !editing_) || !colors) {
+    return;
+  }
+  // The row capsule, same fill and radius as a hovered pinned row; instant
+  // like every other sidebar hover (Dia has no tween). The edit state keeps
+  // it up so the field visibly sits on a surface.
+  cc::PaintFlags fill;
+  fill.setStyle(cc::PaintFlags::kFill_Style);
+  fill.setAntiAlias(true);
+  fill.setColor(
+      helium::GetSidebarHoverSurfaceColor(colors->GetColor(kColorToolbar)));
+  canvas->DrawRoundRect(
+      gfx::RectF(GetLocalBounds()),
+      GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius), fill);
+}
+
+void WorkspaceFolderRowView::OnMouseEntered(const ui::MouseEvent& event) {
+  hovered_ = true;
+  SchedulePaint();
+}
+
+void WorkspaceFolderRowView::OnMouseExited(const ui::MouseEvent& event) {
+  hovered_ = false;
+  SchedulePaint();
+}
+
+bool WorkspaceFolderRowView::OnMousePressed(const ui::MouseEvent& event) {
+  return event.IsOnlyLeftMouseButton();
+}
+
+void WorkspaceFolderRowView::OnMouseReleased(const ui::MouseEvent& event) {
+  if (editing_) {
+    return;  // a click inside the row while editing is the field's business
+  }
+  if (event.IsOnlyLeftMouseButton() && HitTestPoint(event.location())) {
+    delegate_->OnFolderToggled(folder_id_);
+  }
+}
+
+void WorkspaceFolderRowView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_model_->AddItemWithStringId(kRename, IDS_HELIUM_WS_FOLDER_MENU_RENAME);
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItemWithStringId(kDelete, IDS_HELIUM_WS_FOLDER_MENU_DELETE);
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::HAS_MNEMONICS |
+                             views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr,
+                          gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void WorkspaceFolderRowView::ExecuteCommand(int command_id, int event_flags) {
+  switch (command_id) {
+    case kRename:
+      StartRename();
+      break;
+    case kDelete:
+      delegate_->OnFolderDeleteRequested(folder_id_);
+      break;
+  }
+}
+
+bool WorkspaceFolderRowView::HandleKeyEvent(views::Textfield* sender,
+                                            const ui::KeyEvent& key_event) {
+  if (key_event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  // Both keys leave through the framework's focus system: committing flips
+  // editing_ off first, so the blur that follows is a no-op.
+  if (key_event.key_code() == ui::VKEY_RETURN) {
+    CommitRename();
+    GetFocusManager()->ClearFocus();
+    return true;
+  }
+  if (key_event.key_code() == ui::VKEY_ESCAPE) {
+    CancelRename();
+    GetFocusManager()->ClearFocus();
+    return true;
+  }
+  return false;
+}
+
+void WorkspaceFolderRowView::OnRenameFieldBlurred() {
+  if (editing_) {
+    CommitRename();
+  }
+}
+
+void WorkspaceFolderRowView::CommitRename() {
+  if (!editing_) {
+    return;
+  }
+  std::u16string text(editor_->GetText());
+  EndRename();
+  // An emptied name keeps the old one -- a nameless row is unclickable
+  // furniture.
+  if (!text.empty() && text != title_text_) {
+    delegate_->OnFolderRenamed(folder_id_, text);
+  }
+}
+
+void WorkspaceFolderRowView::CancelRename() {
+  if (!editing_) {
+    return;
+  }
+  EndRename();
+}
+
+void WorkspaceFolderRowView::EndRename() {
+  editing_ = false;
+  editor_->SetVisible(false);
+  title_->SetText(title_text_);
+  title_->SetVisible(true);
+  // The pointer usually left long ago (the edit ends on a key or a click
+  // somewhere else), and no exit event is coming.
+  if (!IsMouseHovered()) {
+    hovered_ = false;
+  }
+  DeprecatedLayoutImmediately();
+  SchedulePaint();
+}
+
+void WorkspaceFolderRowView::ClearHover() {
+  if (hovered_) {
+    hovered_ = false;
+    SchedulePaint();
+  }
+}
+
+void WorkspaceFolderRowView::UpdateIcon() {
+  // Arc (轮0): an expanded folder and an EMPTY folder wear the open glyph;
+  // only a closed folder with something inside wears the closed one. While
+  // the fold tween runs, the icon follows the chevron's half-way point.
+  const bool closed_state =
+      has_children_ && (collapsed_progress_ >= 0.5);
+  const gfx::VectorIcon& glyph = closed_state
+                                     ? vector_icons::kFolderFlippableIcon
+                                     : vector_icons::kFolderOpenIcon;
+  if (current_glyph_ == &glyph) {
+    return;
+  }
+  current_glyph_ = &glyph;
+  current_icon_ = ui::ImageModel::FromVectorIcon(
+      glyph, ui::kColorLabelForegroundSecondary, kFolderRowIconSize);
+  icon_->SetImage(current_icon_);
+}
+
+void WorkspaceFolderRowView::OnDragDone() {
+  delegate_->OnFolderDragDone();
+}
+
+SkColor WorkspaceFolderRowView::drag_surface_color() const {
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return SK_ColorTRANSPARENT;
+  }
+  // Same card fill as a floating site row (M3.11: the lifted card always
+  // carries one, even where the resting row has none).
+  return helium::GetSidebarFloatingCardColor(colors->GetColor(kColorToolbar));
+}
+
+SkColor WorkspaceFolderRowView::drag_text_color() const {
+  const ui::ColorProvider* colors = GetColorProvider();
+  // The resting row's name is a secondary label; the floating card keeps it.
+  return colors ? colors->GetColor(ui::kColorLabelForegroundSecondary)
+                : SK_ColorTRANSPARENT;
+}
