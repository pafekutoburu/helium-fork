+void WorkspaceSidebarView::OnFolderDeleteRequested(
+    const std::string& folder_id) {
+  BrowserWindowInterface* const browser = GetBrowserWindow();
+  if (!browser || !service_) {
+    return;
+  }
+  const helium_workspace::WorkspaceEntry* folder =
+      service_->FindEntryById(folder_id);
+  if (!folder || !folder->is_folder()) {
+    return;
+  }
+  auto run_delete = base::BindOnce(
+      [](BrowserWindowInterface* browser, const std::string& folder_id) {
+        if (auto* controller =
+                helium_workspace::WorkspaceTabController::From(browser)) {
+          controller->DeleteFolder(folder_id);
+        }
+      },
+      base::Unretained(browser), folder_id);
+  if (!FolderHasChildren(folder_id)) {
+    // An empty folder just goes (Arc asks only when there is something to
+    // lose -- 轮0, the user deleted empty Untitleds without a dialog).
+    std::move(run_delete).Run();
+    return;
+  }
+  // Arc's dialog shape (轮0 g4 f_00815): Cancel on ESC, the destructive
+  // button as the ⏎ default. The copy is ours -- we close-and-remove, Arc
+  // archives.
+  ui::DialogModel::Builder builder;
+  builder
+      .SetTitle(l10n_util::GetStringFUTF16(IDS_HELIUM_WS_DELETE_FOLDER_TITLE,
+                                           folder->title))
+      .AddParagraph(ui::DialogModelLabel(
+          l10n_util::GetStringUTF16(IDS_HELIUM_WS_DELETE_FOLDER_BODY)))
+      .AddOkButton(
+          std::move(run_delete),
+          ui::DialogModel::Button::Params()
+              .SetLabel(l10n_util::GetStringUTF16(
+                  IDS_HELIUM_WS_DELETE_FOLDER_CONFIRM))
+              .SetStyle(ui::ButtonStyle::kProminent))
+      .AddCancelButton(base::DoNothing());
+  constrained_window::ShowBrowserModal(builder.Build(),
+                                       GetWidget()->GetNativeWindow());
+}
+
+void WorkspaceSidebarView::StartFolderRename(const std::string& folder_id) {
+  if (auto it = folder_views_.find(folder_id); it != folder_views_.end()) {
+    it->second->StartRename();
+    return;
