+TEST_F(WorkspaceServiceTest, AddFolderLandsAtTheTopLevelEnd) {
+  const std::string a = service_->AddEntry(WorkspaceEntry::Section::kPinned,
+                                           GURL("https://a.example/"), u"A");
+  const std::string folder = service_->AddFolder(u"Untitled");
+  ASSERT_FALSE(folder.empty());
+
+  const WorkspaceEntry* entry = service_->FindEntryById(folder);
+  ASSERT_TRUE(entry);
+  EXPECT_TRUE(entry->is_folder());
+  EXPECT_FALSE(entry->collapsed);
+  EXPECT_TRUE(entry->url.is_empty());
+  EXPECT_THAT(PinnedShape(*service_), ElementsAre(a, folder));
+}
