+  entry.section = WorkspaceEntry::Section::kPinned;
+  entry.kind = WorkspaceEntry::Kind::kFolder;
+  entry.title = title;
+  entry.position = NextTopLevelPosition(WorkspaceEntry::Section::kPinned);
+  const std::string id = entry.id;
+  entries_.push_back(std::move(entry));
+  SortEntries();
+  PersistToPrefs();
+  NotifyChanged();
+  return id;
+}
+
+bool WorkspaceService::SetFolderCollapsed(const std::string& id,
+                                          bool collapsed) {
+  for (WorkspaceEntry& entry : entries_) {
+    if (entry.id != id) {
+      continue;
+    }
+    if (!entry.is_folder()) {
+      return false;
+    }
+    if (entry.collapsed == collapsed) {
+      return true;
+    }
+    entry.collapsed = collapsed;
+    PersistToPrefs();
+    NotifyChanged();
+    return true;
+  }
+  return false;
+}
+
+std::vector<WorkspaceEntry> WorkspaceService::RemoveFolderAndChildren(
+    const std::string& id) {
+  const WorkspaceEntry* folder = FindEntryById(id);
+  if (!folder || !folder->is_folder()) {
+    return {};
+  }
+  // entries_ is kept in display order, so one pass yields "folder first,
+  // children after" for free.
+  std::vector<WorkspaceEntry> removed;
+  for (const WorkspaceEntry& entry : entries_) {
+    if (entry.id == id || entry.folder_id == id) {
+      removed.push_back(entry);
+    }
+  }
+  std::erase_if(entries_, [&](const WorkspaceEntry& e) {
+    return e.id == id || e.folder_id == id;
+  });
+  for (const WorkspaceEntry& entry : removed) {
+    std::erase_if(tab_to_entry_, [&](const auto& pair) {
+      return pair.second == entry.id;
+    });
+  }
+  // No renumber on purpose: the vacated positions are what make an undo's
+  // RestoreEntries() land everything back in its exact slot.
+  PersistToPrefs();
+  NotifyChanged();
+  return removed;
+}
+
+bool WorkspaceService::RestoreEntries(
+    const std::vector<WorkspaceEntry>& snapshot) {
+  if (snapshot.empty()) {
+    return false;
+  }
+  for (const WorkspaceEntry& entry : snapshot) {
+    if (FindEntryById(entry.id)) {
+      return false;
+    }
+  }
+  for (const WorkspaceEntry& entry : snapshot) {
+    entries_.push_back(entry);
+  }
+  SortEntries();
+  PersistToPrefs();
+  NotifyChanged();
+  return true;
+}
+
+bool WorkspaceService::MoveEntryToFolder(const std::string& id,
+                                         const std::string& folder_id,
+                                         size_t target_index) {
+  if (folder_id.empty()) {
+    return MoveEntry(id, WorkspaceEntry::Section::kPinned, target_index);
+  }
+  const auto source = std::ranges::find_if(
+      entries_, [&](const WorkspaceEntry& e) { return e.id == id; });
+  if (source == entries_.end() || source->is_folder()) {
+    return false;  // unknown id, or no nesting
+  }
+  const WorkspaceEntry* folder = FindEntryById(folder_id);
+  if (!folder || !folder->is_folder()) {
+    return false;
+  }
+
+  WorkspaceEntry moved = std::move(*source);
+  entries_.erase(source);
+  moved.section = WorkspaceEntry::Section::kPinned;
+  moved.folder_id = folder_id;
+
+  // Same gap-at-slot technique as MoveEntry, over the folder's children.
+  std::vector<WorkspaceEntry*> scope;
+  for (WorkspaceEntry& entry : entries_) {
+    if (entry.folder_id == folder_id) {
+      scope.push_back(&entry);
+    }
+  }
+  const size_t slot = std::min(target_index, scope.size());
+  int scope_position = 0;
+  for (size_t i = 0; i < scope.size(); ++i) {
+    if (i == slot) {
+      ++scope_position;
+    }
+    scope[i]->position = scope_position++;
+  }
+  moved.position = static_cast<int>(slot);
+  entries_.push_back(std::move(moved));
+
+  SortEntries();
+  RenumberScopes();
+  PersistToPrefs();
+  NotifyChanged();
+  return true;
+}
