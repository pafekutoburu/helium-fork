+// ---- Folders (M3.13) ----
+
+// The pinned section's display order: "id" for top-level entries (sites and
+// folders alike), "folder_id/child_id" for children — the shape the sidebar
+// walks top to bottom.
+std::vector<std::string> PinnedShape(const WorkspaceService& service) {
+  std::vector<std::string> shape;
+  for (const WorkspaceEntry& entry : service.entries()) {
+    if (entry.section != WorkspaceEntry::Section::kPinned) {
+      continue;
+    }
+    shape.push_back(entry.folder_id.empty()
+                        ? entry.id
+                        : entry.folder_id + "/" + entry.id);
+  }
+  return shape;
+}
