+  // The row does not exist yet: the AddFolder that asked for this rename
+  // notified one observer pass ago, and this view's SyncEntryViews may not
+  // have run. It picks the request up when it builds the row.
+  pending_rename_folder_id_ = folder_id;
+  SyncEntryViews();
+}
