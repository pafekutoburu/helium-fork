+WorkspaceFolderRowView::~WorkspaceFolderRowView() = default;
+
+void WorkspaceFolderRowView::SetEntry(
+    const helium_workspace::WorkspaceEntry& entry,
+    bool has_children) {
+  folder_id_ = entry.id;
+  const bool collapsed_changed = collapsed_ != entry.collapsed;
+  collapsed_ = entry.collapsed;
+  has_children_ = has_children;
+  if (collapsed_changed) {
+    // Snap when the state arrives from the model without a running tween
+    // (load, another window); the sidebar overrides this per frame while
+    // its fold animation drives.
+    SetCollapsedProgress(collapsed_ ? 1.0 : 0.0);
+  }
+  UpdateIcon();
+  if (title_text_ != entry.title) {
+    title_text_ = entry.title;
+    if (!editing_) {
+      title_->SetText(title_text_);
+    }
+    GetViewAccessibility().SetName(title_text_);
+    DeprecatedLayoutImmediately();
+  }
+}
+
+void WorkspaceFolderRowView::SetCollapsedProgress(double collapsed) {
+  collapsed_progress_ = collapsed;
+  static_cast<FolderChevron*>(chevron_.get())->SetProgress(collapsed);
+  UpdateIcon();
+}
+
+void WorkspaceFolderRowView::SetDropTarget(bool drop_target) {
+  if (drop_target_ == drop_target) {
+    return;
+  }
+  drop_target_ = drop_target;
+  SchedulePaint();
+}
+
+void WorkspaceFolderRowView::StartRename() {
+  if (editing_) {
+    return;
+  }
+  editing_ = true;
+  editor_->SetText(title_text_);
+  editor_->SetVisible(true);
+  title_->SetVisible(false);
+  DeprecatedLayoutImmediately();
+  editor_->RequestFocus();
+  editor_->SelectAll(/*reversed=*/false);
+}
