+// Dia's folder-head metrics, unchanged from the retired WorkspaceSpaceHeader
+// (M3.10 四问②; Arc's own columns measured 2026-08-31 land within ~1-3pt of
+// these, and the "same column as a row" principle holds in both, so the
+// numbers stay). The 8pt the scroll view is already inset by makes these the
+// visual x17 / x42.
+constexpr int kFolderRowIconSize = 16;
+constexpr int kFolderRowIconLeadingInset = 9;
+constexpr int kFolderRowTitleX = 34;
+constexpr int kFolderRowChevronSize = 16;
+constexpr int kFolderRowInnerSpacing = 4;
+constexpr int kFolderRowTrailingInset = 8;
+
+// Local to this view: the actions are executed here, so they never reach
+// the browser command table (same pattern as WorkspaceEntryView's menu).
+enum FolderMenuCommand {
+  kRename = 1,
+  kDelete,
+};
+
+// Paints the right-pointing chevron glyph rotated with the fold: 0 is open
+// (pointing down), 1 is closed (pointing right). Moved verbatim from the
+// retired WorkspaceSpaceHeader.
+class FolderChevron : public views::View {
+  METADATA_HEADER(FolderChevron, views::View)
+
+ public:
+  FolderChevron() { SetCanProcessEventsWithinSubtree(false); }
+
+  void SetProgress(double progress) {
+    if (progress_ == progress) {
+      return;
+    }
+    progress_ = progress;
+    SchedulePaint();
+  }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    const gfx::ImageSkia icon =
+        ui::ImageModel::FromVectorIcon(
+            vector_icons::kKeyboardArrowRightFlippableIcon,
+            ui::kColorLabelForegroundSecondary, kFolderRowChevronSize)
+            .Rasterize(colors);
+    gfx::ScopedCanvas scoped(canvas);
+    canvas->Translate(gfx::Vector2d(width() / 2, height() / 2));
+    canvas->sk_canvas()->rotate(90.0f * (1.0f - progress_));
+    canvas->DrawImageInt(icon, -icon.width() / 2, -icon.height() / 2);
+  }
+
+ private:
+  double progress_ = 0.0;
+};
+
+BEGIN_METADATA(FolderChevron)
+END_METADATA
