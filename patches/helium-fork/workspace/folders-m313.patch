Index: src/chrome/browser/ui/helium_workspace/workspace_entry_unittest.cc
===================================================================
--- src.orig/chrome/browser/ui/helium_workspace/workspace_entry_unittest.cc
+++ src/chrome/browser/ui/helium_workspace/workspace_entry_unittest.cc
@@ -133,6 +133,85 @@ TEST(WorkspaceEntryTest, UnknownFieldsIg
   EXPECT_TRUE(WorkspaceEntry::FromValue(dict).has_value());
 }
 
+WorkspaceEntry MakeFolder() {
+  WorkspaceEntry entry;
+  entry.id = "f01dercafe-0000-4000-8000-000000000001";
+  entry.section = WorkspaceEntry::Section::kPinned;
+  entry.kind = WorkspaceEntry::Kind::kFolder;
+  entry.title = u"Untitled";
+  entry.position = 5;
+  entry.collapsed = true;
+  return entry;
+}
+
+TEST(WorkspaceEntryTest, FolderRoundTripsWithoutUrl) {
+  const WorkspaceEntry original = MakeFolder();
+  const std::optional<WorkspaceEntry> decoded =
+      WorkspaceEntry::FromValue(original.ToValue());
+  ASSERT_TRUE(decoded.has_value());
+  EXPECT_TRUE(decoded->is_folder());
+  EXPECT_TRUE(decoded->url.is_empty());
+  EXPECT_EQ(decoded->title, original.title);
+  EXPECT_EQ(decoded->position, original.position);
+  EXPECT_TRUE(decoded->collapsed);
+}
+
+TEST(WorkspaceEntryTest, FolderKeysAbsentFromSiteEntries) {
+  // A folderless profile's pref must stay byte-identical to what pre-M3.13
+  // builds wrote: no kind/folder_id/collapsed keys on plain sites.
+  const base::DictValue dict = MakeEntry().ToValue();
+  EXPECT_FALSE(dict.contains("kind"));
+  EXPECT_FALSE(dict.contains("folder_id"));
+  EXPECT_FALSE(dict.contains("collapsed"));
+}
+
+TEST(WorkspaceEntryTest, ChildFolderIdRoundTripsForPinnedSitesOnly) {
+  WorkspaceEntry child = MakeEntry();
+  child.section = WorkspaceEntry::Section::kPinned;
+  child.folder_id = "f01der";
+  const std::optional<WorkspaceEntry> decoded =
+      WorkspaceEntry::FromValue(child.ToValue());
+  ASSERT_TRUE(decoded.has_value());
+  EXPECT_EQ(decoded->folder_id, "f01der");
+
+  // A favorite lost its folder semantics when it was promoted; a stale link
+  // is dropped on load rather than the entry.
+  WorkspaceEntry favorite = MakeEntry();
+  favorite.section = WorkspaceEntry::Section::kFavorite;
+  base::DictValue dict = favorite.ToValue();
+  dict.Set("folder_id", "f01der");
+  const std::optional<WorkspaceEntry> decoded_favorite =
+      WorkspaceEntry::FromValue(dict);
+  ASSERT_TRUE(decoded_favorite.has_value());
+  EXPECT_TRUE(decoded_favorite->folder_id.empty());
+}
+
+TEST(WorkspaceEntryTest, NestedFolderFlattensOnLoad) {
+  // v1 is one level deep: a folder that some future build parented into
+  // another folder loads as a top-level folder, not as a reject.
+  base::DictValue dict = MakeFolder().ToValue();
+  dict.Set("folder_id", "some-other-folder");
+  const std::optional<WorkspaceEntry> decoded =
+      WorkspaceEntry::FromValue(dict);
+  ASSERT_TRUE(decoded.has_value());
+  EXPECT_TRUE(decoded->is_folder());
+  EXPECT_TRUE(decoded->folder_id.empty());
+}
+
+TEST(WorkspaceEntryTest, UnknownKindRejectedSiteUrlStillRequired) {
+  // An out-of-range kind is some future feature's data — same policy as an
+  // out-of-range section: drop the entry, keep the rest of the list.
+  base::DictValue future = MakeEntry().ToValue();
+  future.Set("kind", 42);
+  EXPECT_FALSE(WorkspaceEntry::FromValue(future).has_value());
+
+  // Relaxing the URL requirement for folders must not have relaxed it for
+  // sites.
+  base::DictValue site = MakeEntry().ToValue();
+  site.Set("url", "not a url");
+  EXPECT_FALSE(WorkspaceEntry::FromValue(site).has_value());
+}
