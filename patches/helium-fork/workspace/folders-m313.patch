+void WorkspaceTabController::DeleteFolder(const std::string& folder_id) {
+  if (!service_) {
+    return;
+  }
+  const WorkspaceEntry* folder = service_->FindEntryById(folder_id);
+  if (!folder || !folder->is_folder()) {
+    return;
+  }
+  const std::u16string folder_title = folder->title;
+
+  // The children's tabs, collected before the model drops the bindings.
+  // Entries are profile-scoped, so "delete the folder and what's in it"
+  // reaches into every window those tabs live in.
+  std::vector<tabs::TabHandle> to_close;
+  for (const WorkspaceEntry& entry : service_->entries()) {
+    if (entry.folder_id == folder_id) {
+      const std::vector<tabs::TabHandle> tabs =
+          service_->FindTabsForEntry(entry.id);
+      to_close.insert(to_close.end(), tabs.begin(), tabs.end());
+    }
+  }
+
+  folder_undo_watermark_ = RestoreWatermark(
+      TabRestoreServiceFactory::GetForProfile(browser_window_->GetProfile()));
+  folder_undo_snapshot_ = service_->RemoveFolderAndChildren(folder_id);
+  if (folder_undo_snapshot_.empty()) {
+    return;  // raced away under the dialog
+  }
+
+  // Group by window so the "never leave a window empty" rule holds in each
+  // (⛔ M4: CloseWebContentsAt's own guard deliberately lets a second close
+  // of a blank tab take the window down).
+  std::map<BrowserWindowInterface*, std::vector<tabs::TabHandle>> by_window;
+  for (tabs::TabHandle handle : to_close) {
+    tabs::TabInterface* const tab = handle.Get();
+    if (!tab) {
+      continue;
+    }
+    if (BrowserWindowInterface* const window =
+            tab->GetBrowserWindowInterface()) {
+      by_window[window].push_back(handle);
+    }
+  }
+  for (auto& [window, handles] : by_window) {
+    if (window->IsDeleteScheduled()) {
+      continue;
+    }
+    TabStripModel* const model = window->GetTabStripModel();
+    if (!model) {
+      continue;
+    }
+    if (static_cast<int>(handles.size()) >= model->count()) {
+      chrome::AddTabAt(window, GURL(), /*index=*/-1, /*foreground=*/true);
+    }
+    // Back to front; the index is re-resolved per close because an unload
+    // handler can shift everything after it (⛔ M4-r1: returning is not the
+    // same as closed, so nothing here counts).
+    for (auto it = handles.rbegin(); it != handles.rend(); ++it) {
+      tabs::TabInterface* const tab = it->Get();
+      if (!tab) {
+        continue;
+      }
+      const int index = model->GetIndexOfTab(tab);
+      if (index < 0) {
+        continue;
+      }
+      model->CloseWebContentsAt(
+          index, TabCloseTypes::CLOSE_USER_GESTURE |
+                     TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    }
+  }
+
+  if (BrowserView* const browser_view =
+          BrowserView::GetBrowserViewForBrowser(browser_window_)) {
+    if (VerticalTabStripRegionView* const region =
+            browser_view->vertical_tab_strip_region_view()) {
+      region->ShowUndoBarForFolderDelete(
+          folder_title,
+          base::BindOnce(&WorkspaceTabController::UndoLastDeleteFolder,
+                         weak_factory_.GetWeakPtr()));
+    }
+  }
+}
+
+void WorkspaceTabController::UndoLastDeleteFolder() {
+  if (!service_ || folder_undo_snapshot_.empty()) {
+    return;
+  }
+  service_->RestoreEntries(folder_undo_snapshot_);
+  folder_undo_snapshot_.clear();
+  const SessionID watermark = folder_undo_watermark_;
+  folder_undo_watermark_ = SessionID::InvalidValue();
+  // The reopened tabs re-bind to their restored entries through the ongoing
+  // claim pass (认领不是一次性的, M3.11-r1) as their loads commit.
+  RewindTabRestoreTo(watermark);
+}
