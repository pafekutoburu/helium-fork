+WorkspaceFolderRowView::WorkspaceFolderRowView(Delegate* delegate)
+    : delegate_(delegate) {
+  icon_ = AddChildView(std::make_unique<views::ImageView>());
+  icon_->SetCanProcessEventsWithinSubtree(false);
+
+  title_ = AddChildView(std::make_unique<views::Label>(
+      std::u16string(), views::style::CONTEXT_LABEL,
+      views::style::STYLE_SECONDARY));
+  title_->SetSkipSubpixelRenderingOpacityCheck(true);
+  title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  title_->SetElideBehavior(gfx::ELIDE_TAIL);
+  title_->SetCanProcessEventsWithinSubtree(false);
+
+  chevron_ = AddChildView(std::make_unique<FolderChevron>());
+
+  auto editor = std::make_unique<RenameField>(this);
+  editor->set_controller(this);
+  editor->SetVisible(false);
+  // The field edits in place: no border or background of its own, the row
+  // already provides the surface (Arc's edit state is just selected text on
+  // the row -- 轮0, g3b).
+  editor->SetBorder(nullptr);
+  editor->SetBackgroundEnabled(false);
+  // A focusable view with no accessible name is a DCHECK in
+  // RunAccessibilityPaintChecks the moment it becomes visible.
+  editor->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WS_FOLDER_MENU_RENAME));
+  editor_ = AddChildView(std::move(editor));
+
+  set_context_menu_controller(this);
+
+  GetViewAccessibility().SetRole(ax::mojom::Role::kButton);
+  UpdateIcon();
+}
