Index: src/chrome/browser/ui/helium/arc_space_manage.h
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_space_manage.h
@@ -0,0 +1,214 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_SPACE_MANAGE_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_SPACE_MANAGE_H_
+
+#include <algorithm>
+#include <cstddef>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+// helium-fork M6 轮2 2b: the "Manage Spaces" sheet. Arc's Manage Spaces… is
+// its Library, a whole-window overlay with one tall card per space and a
+// drag handle at the card's foot (decisions.md 「M6 轮2」§3 g23, 2026-09-04).
+// We have no Library; the user's ruling (2026-09-04, §1) is the minimal
+// form: the same in-sidebar sheet slot the Create form uses, listing one
+// 34pt row per space (icon, name, "···", a drag handle) that the user drags
+// to reorder, then MoveSpace on release. Nothing here is an Arc measurement
+// -- the numbers are ours, aligned with the Create form's column
+// (arc_space_form.h: side inset 15, Done / Cancel where its Create Space /
+// Cancel sit -- user 2026-09-17). The drag itself is the pinned rows'
+// (arc_sidebar_surface.h kSidebarDrag*, same date).
+//
+// Offsets are from the sheet's own top and bottom (the sheet ends 8pt above
+// the space bar's slot, like the Create form's).
+//
+// Header-only and free of //ui/views on purpose, like every other arc_*.h:
+// asserted in helium_workspace_unittests.
+namespace helium {
+
+// Every rounded rect in the shell is 12 (user rule 2026-09-03). Literal, so
+// this header stays free of //ui/views.
+inline constexpr int kSpaceManageCornerRadius = 12;
+
+// The Create form's column: x 15 to width - 15.
+inline constexpr int kSpaceManageSideInset = 15;
+// "Manage Spaces": the form's title font, 16 below the sheet's top (no
+// illustration above it here).
+inline constexpr int kSpaceManageTitleTop = 16;
+inline constexpr int kSpaceManageTitleHeight = 24;
+inline constexpr int kSpaceManageTitleFontSize = 18;
+// The list starts 16 under the title.
+inline constexpr int kSpaceManageListTop =
+    kSpaceManageTitleTop + kSpaceManageTitleHeight + 16;
+// One sidebar row per space: LayoutConstant::kVerticalTabHeight, which the
+// view DCHECKs against. Rows touch (the pinned list's spacing).
+inline constexpr int kSpaceManageRowHeight = 34;
+// "+ New Space" is one more row, 8 under the list.
+inline constexpr int kSpaceManageNewSpaceGap = 8;
+// ... and the list + that row end at least 16 above "Done".
+inline constexpr int kSpaceManageListBottomGap = 16;
+// The footer is the Create form's (user 2026-09-17): "Done" is its "Create
+// Space" -- the same capsule in the same place -- and "Cancel" its Cancel,
+// plain text under it. The numbers repeat arc_space_form.h's, asserted
+// equal in the unit test.
+inline constexpr int kSpaceManageDoneHeight = 38;
+inline constexpr int kSpaceManageDoneBottomInset = 44;
+inline constexpr int kSpaceManageDoneFontSize = 13;
+inline constexpr int kSpaceManageCancelGap = 12;
+inline constexpr int kSpaceManageCancelHeight = 20;
+inline constexpr int kSpaceManageCancelFontSize = 12;
+
+// Inside a row: 16pt glyphs (the space icon, "···", the drag handle), each
+// as far from the row's top as the icon is from its left ((34 - 16) / 2 =
+// 9: the user's equal-margins rule for something set into a capsule's
+// edge), 8 between neighbours. The handle's band (where the pointer turns
+// into a hand) is wider than its glyph and as tall as the row; the whole
+// row starts a drag, like a pinned row.
+inline constexpr int kSpaceManageGlyphSize = 16;
+inline constexpr int kSpaceManageRowLeadingInset =
+    (kSpaceManageRowHeight - kSpaceManageGlyphSize) / 2;
+inline constexpr int kSpaceManageGlyphGap = 8;
+inline constexpr int kSpaceManageHandleHitWidth = 24;
+// An icon-less space shows the bar's 8pt dot in the icon slot.
+inline constexpr int kSpaceManageDotSize = 8;
+// Apple Color Emoji draws wider than its point size (the head row puts a
+// 16pt emoji in a 20pt slot): the emoji label gets the icon slot outset by
+// this much on every side, or a 16x16 label elides the glyph to "…"
+// (probe 2026-09-17).
+inline constexpr int kSpaceManageEmojiSlop = 4;
+
+// The sheet's rectangles for |size| and |row_count| spaces. |list| is the
+// viewport: as tall as the rows until they would push "+ New Space" and
+// "Done" off the bottom, then it stops growing and |scrolls| is set (the
+// view puts the rows in a ScrollView). The stretch between "+ New Space"
+// and "Done" absorbs the rest of the height.
+struct SpaceManageLayout {
+  gfx::Rect title;
+  gfx::Rect list;
+  gfx::Rect new_space_row;
+  gfx::Rect done;
+  gfx::Rect cancel;
+  bool scrolls = false;
+};
+
+inline SpaceManageLayout ComputeSpaceManageLayout(const gfx::Size& size,
+                                                  size_t row_count) {
+  SpaceManageLayout out;
+  const int w = std::max(size.width(), 0);
+  const int h = std::max(size.height(), 0);
+  out.title = gfx::Rect(0, kSpaceManageTitleTop, w, kSpaceManageTitleHeight);
+  const int inner_w = std::max(w - 2 * kSpaceManageSideInset, 0);
+  const int done_bottom = std::max(h - kSpaceManageDoneBottomInset, 0);
+  out.done = gfx::Rect(kSpaceManageSideInset,
+                       std::max(done_bottom - kSpaceManageDoneHeight, 0),
+                       inner_w, kSpaceManageDoneHeight);
+  out.cancel = gfx::Rect(0, done_bottom + kSpaceManageCancelGap, w,
+                         kSpaceManageCancelHeight);
+  const int content_h = static_cast<int>(row_count) * kSpaceManageRowHeight;
+  const int avail = std::max(out.done.y() - kSpaceManageListBottomGap -
+                                 kSpaceManageRowHeight - kSpaceManageNewSpaceGap -
+                                 kSpaceManageListTop,
+                             0);
+  out.scrolls = content_h > avail;
+  out.list = gfx::Rect(kSpaceManageSideInset, kSpaceManageListTop, inner_w,
+                       std::min(content_h, avail));
+  out.new_space_row =
+      gfx::Rect(kSpaceManageSideInset, out.list.bottom() + kSpaceManageNewSpaceGap,
+                inner_w, kSpaceManageRowHeight);
+  return out;
+}
+
+// One row's columns for a row |width| wide (rows are kSpaceManageRowHeight
+// tall). Left to right: the icon slot, the name (which always ends clear of
+// the "···" so hovering never shifts the text), the "···" menu button, the
+// drag handle at the right edge. |handle_hit| is where the pointer wears
+// the hand: the glyph's band widened to kSpaceManageHandleHitWidth, full
+// row height.
+struct SpaceManageRowLayout {
+  gfx::Rect icon;
+  gfx::Rect name;
+  gfx::Rect menu;
+  gfx::Rect handle;
+  gfx::Rect handle_hit;
+};
+
+inline SpaceManageRowLayout ComputeSpaceManageRowLayout(int width) {
+  SpaceManageRowLayout out;
+  const int w = std::max(width, 0);
+  const int y = kSpaceManageRowLeadingInset;
+  out.icon = gfx::Rect(kSpaceManageRowLeadingInset, y, kSpaceManageGlyphSize,
+                       kSpaceManageGlyphSize);
+  out.handle = gfx::Rect(
+      std::max(w - kSpaceManageRowLeadingInset - kSpaceManageGlyphSize, 0), y,
+      kSpaceManageGlyphSize, kSpaceManageGlyphSize);
+  out.menu = gfx::Rect(
+      std::max(out.handle.x() - kSpaceManageGlyphGap - kSpaceManageGlyphSize, 0),
+      y, kSpaceManageGlyphSize, kSpaceManageGlyphSize);
+  const int name_x = out.icon.right() + kSpaceManageGlyphGap;
+  out.name = gfx::Rect(name_x, 0,
+                       std::max(out.menu.x() - kSpaceManageGlyphGap - name_x, 0),
+                       kSpaceManageRowHeight);
+  out.handle_hit = gfx::Rect(
+      out.handle.x() - (kSpaceManageHandleHitWidth - kSpaceManageGlyphSize) / 2,
+      0, kSpaceManageHandleHitWidth, kSpaceManageRowHeight);
+  return out;
+}
+
+// The slot the lifted row would land in -- the pinned rows' rule
+// (WorkspaceSidebarView::UpdateDragPlan): how many of the other rows have
+// their *target* centre above the pointer, measured against the layout the
+// user is looking at -- the gap at |current_insert|, or closed up when the
+// drag has no slot (the pointer is off the sheet). Measuring against the
+// live layout is what gives the rule its hysteresis, and makes the answer a
+// fixpoint: asking again right after the rows yield gives the same slot. It
+// is also MoveSpace's target index (the moved space already removed).
+// |pointer_y| is in the list's coordinates and unbounded, so the first and
+// the last slot are both reachable (probe 2026-09-17: fed a centre clamped
+// to the list, 0 -> 2 of three rows landed on 1).
+inline size_t SpaceManageInsertIndex(int pointer_y,
+                                     size_t row_count,
+                                     std::optional<size_t> current_insert) {
+  size_t index = 0;
+  for (size_t k = 0; k + 1 < row_count; ++k) {
+    const size_t slot = !current_insert || k < *current_insert ? k : k + 1;
+    const int center = static_cast<int>(slot) * kSpaceManageRowHeight +
+                       kSpaceManageRowHeight / 2;
+    if (pointer_y > center) {
+      ++index;
+    }
+  }
+  return index;
+}
+
+// The order Cancel puts back (user 2026-09-17: Cancel keeps nothing): the
+// ids the sheet opened with that still exist, in that order, then whatever
+// another window added since, in its current order. Element i is the space
+// MoveSpace(id, i) has to land at slot i, applied front to back.
+inline std::vector<std::string> SpaceManageRestoredOrder(
+    const std::vector<std::string>& opened_with,
+    const std::vector<std::string>& current) {
+  std::vector<std::string> out;
+  out.reserve(current.size());
+  for (const std::string& id : opened_with) {
+    if (std::ranges::find(current, id) != current.end()) {
+      out.push_back(id);
+    }
+  }
+  for (const std::string& id : current) {
+    if (std::ranges::find(opened_with, id) == opened_with.end()) {
+      out.push_back(id);
+    }
+  }
+  return out;
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_SPACE_MANAGE_H_
Index: src/chrome/browser/ui/helium/arc_space_manage_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_space_manage_unittest.cc
@@ -0,0 +1,158 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_space_manage.h"
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "chrome/browser/ui/helium/arc_space_form.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+// The Create form's test sheet: Arc's 257.5pt sidebar, top row to bar slot.
+constexpr gfx::Size kSheet(257, 1003);
+
+TEST(ArcSpaceManageTest, RowsStackUnderTheTitleAndTheFooterIsTheCreateForms) {
+  const SpaceManageLayout l = ComputeSpaceManageLayout(kSheet, 3);
+  EXPECT_EQ(16, l.title.y());
+  EXPECT_EQ(kSheet.width(), l.title.width());
+  EXPECT_EQ(l.title.bottom() + 16, l.list.y());
+  // The column is the Create form's: x 15, width - 30.
+  EXPECT_EQ(15, l.list.x());
+  EXPECT_EQ(kSheet.width() - 30, l.list.width());
+  EXPECT_EQ(3 * 34, l.list.height());
+  EXPECT_FALSE(l.scrolls);
+  EXPECT_EQ(l.list.bottom() + 8, l.new_space_row.y());
+  EXPECT_EQ(l.list.x(), l.new_space_row.x());
+  EXPECT_EQ(l.list.width(), l.new_space_row.width());
+  EXPECT_EQ(34, l.new_space_row.height());
+  // "Done" is the Create form's "Create Space" capsule and "Cancel" its
+  // Cancel, rect for rect (user 2026-09-17).
+  const SpaceFormLayout form = ComputeSpaceFormLayout(kSheet);
+  EXPECT_EQ(form.create_button.ToString(), l.done.ToString());
+  EXPECT_EQ(form.cancel.ToString(), l.cancel.ToString());
+  EXPECT_EQ(kSpaceFormCreateFontSize, kSpaceManageDoneFontSize);
+  EXPECT_EQ(kSpaceFormCancelFontSize, kSpaceManageCancelFontSize);
+  EXPECT_EQ(kSpaceFormCornerRadius, kSpaceManageCornerRadius);
+  EXPECT_LE(l.new_space_row.bottom() + 16, l.done.y());
+}
+
+TEST(ArcSpaceManageTest, TooManyRowsScrollAndTheFooterStaysPinned) {
+  const SpaceManageLayout few = ComputeSpaceManageLayout(kSheet, 3);
+  const SpaceManageLayout many = ComputeSpaceManageLayout(kSheet, 100);
+  EXPECT_TRUE(many.scrolls);
+  // The viewport stops exactly where "+ New Space" and "Done" still fit.
+  EXPECT_EQ(many.done.y() - 16 - 34 - 8, many.list.bottom());
+  EXPECT_LT(many.list.height(), 100 * 34);
+  EXPECT_EQ(many.list.bottom() + 8, many.new_space_row.y());
+  EXPECT_EQ(few.done.ToString(), many.done.ToString());
+  EXPECT_EQ(few.cancel.ToString(), many.cancel.ToString());
+  EXPECT_EQ(few.title.ToString(), many.title.ToString());
+  // A taller sheet only moves the footer (and lets more rows show).
+  const SpaceManageLayout tall =
+      ComputeSpaceManageLayout(gfx::Size(kSheet.width(), kSheet.height() + 200), 3);
+  EXPECT_EQ(few.done.y() + 200, tall.done.y());
+  EXPECT_EQ(few.cancel.y() + 200, tall.cancel.y());
+  EXPECT_EQ(few.list.ToString(), tall.list.ToString());
+}
+
+TEST(ArcSpaceManageTest, RowColumnsLeftToRightWithEqualMargins) {
+  const int w = kSheet.width() - 30;
+  const SpaceManageRowLayout r = ComputeSpaceManageRowLayout(w);
+  // The icon is as far from the row's left as from its top: (34 - 16) / 2.
+  EXPECT_EQ(9, r.icon.x());
+  EXPECT_EQ(r.icon.x(), r.icon.y());
+  EXPECT_EQ(16, r.icon.width());
+  EXPECT_EQ(16, r.icon.height());
+  // The handle hugs the right edge by the same margin; "···" is 8 left of
+  // it; the name ends 8 before "···" whether or not "···" is showing.
+  EXPECT_EQ(w - 9, r.handle.right());
+  EXPECT_EQ(r.handle.y(), r.icon.y());
+  EXPECT_EQ(r.handle.x() - 8, r.menu.right());
+  EXPECT_EQ(r.menu.x() - 8, r.name.right());
+  EXPECT_EQ(r.icon.right() + 8, r.name.x());
+  EXPECT_EQ(0, r.name.y());
+  EXPECT_EQ(34, r.name.height());
+  // The hand-cursor band contains the glyph and spans the row's height.
+  EXPECT_TRUE(r.handle_hit.Contains(r.handle));
+  EXPECT_EQ(0, r.handle_hit.y());
+  EXPECT_EQ(34, r.handle_hit.height());
+  EXPECT_EQ(24, r.handle_hit.width());
+  EXPECT_EQ(r.handle.CenterPoint().x(), r.handle_hit.CenterPoint().x());
+}
+
+// Three rows (centres 17 / 51 / 85), the first one lifted and dragged down:
+// the pinned rows' midpoint rule on the pointer.
+TEST(ArcSpaceManageTest, InsertIndexFollowsThePointerAgainstTheLiveLayout) {
+  // At rest and until the pointer passes the next row's centre.
+  EXPECT_EQ(0u, SpaceManageInsertIndex(17, 3, 0));
+  EXPECT_EQ(0u, SpaceManageInsertIndex(51, 3, 0));
+  EXPECT_EQ(1u, SpaceManageInsertIndex(52, 3, 0));
+  // A fixpoint: once the rows have yielded (gap at 1) the answer holds.
+  EXPECT_EQ(1u, SpaceManageInsertIndex(52, 3, 1));
+  // The last slot is one point past the last row's centre, and everything
+  // below the list still means "last" (probe 2026-09-17: a centre clamped
+  // to the list never got there).
+  EXPECT_EQ(1u, SpaceManageInsertIndex(85, 3, 1));
+  EXPECT_EQ(2u, SpaceManageInsertIndex(86, 3, 1));
+  EXPECT_EQ(2u, SpaceManageInsertIndex(86, 3, 2));
+  EXPECT_EQ(2u, SpaceManageInsertIndex(400, 3, 2));
+  // And back up to the first slot, from the last.
+  EXPECT_EQ(1u, SpaceManageInsertIndex(50, 3, 2));
+  EXPECT_EQ(0u, SpaceManageInsertIndex(16, 3, 1));
+  EXPECT_EQ(0u, SpaceManageInsertIndex(-40, 3, 0));
+  // One row: nowhere to go.
+  EXPECT_EQ(0u, SpaceManageInsertIndex(300, 1, 0));
+  EXPECT_EQ(0u, SpaceManageInsertIndex(300, 0, 0));
+}
+
+// Coming back onto the sheet after the hole closed: the other two rows sit
+// closed up (centres 17 / 51), whatever slot the drag had before.
+TEST(ArcSpaceManageTest, InsertIndexWithNoSlotMeasuresTheClosedUpRows) {
+  EXPECT_EQ(0u, SpaceManageInsertIndex(17, 3, std::nullopt));
+  EXPECT_EQ(1u, SpaceManageInsertIndex(18, 3, std::nullopt));
+  EXPECT_EQ(1u, SpaceManageInsertIndex(51, 3, std::nullopt));
+  EXPECT_EQ(2u, SpaceManageInsertIndex(52, 3, std::nullopt));
+  EXPECT_EQ(0u, SpaceManageInsertIndex(300, 1, std::nullopt));
+}
+
+TEST(ArcSpaceManageTest, CancelRestoresTheOrderTheSheetOpenedWith) {
+  using Ids = std::vector<std::string>;
+  // Untouched, and a plain reorder.
+  EXPECT_EQ((Ids{"a", "b", "c"}),
+            SpaceManageRestoredOrder({"a", "b", "c"}, {"a", "b", "c"}));
+  EXPECT_EQ((Ids{"a", "b", "c"}),
+            SpaceManageRestoredOrder({"a", "b", "c"}, {"c", "a", "b"}));
+  // Another window deleted one and added one meanwhile: the survivors go
+  // back in their old order, the newcomer stays after them.
+  EXPECT_EQ((Ids{"a", "c", "n"}),
+            SpaceManageRestoredOrder({"a", "b", "c"}, {"n", "c", "a"}));
+  EXPECT_EQ((Ids{"n"}), SpaceManageRestoredOrder({"a"}, {"n"}));
+  EXPECT_TRUE(SpaceManageRestoredOrder({"a"}, {}).empty());
+}
+
+TEST(ArcSpaceManageTest, DegenerateSizesNeverGoNegative) {
+  const SpaceManageLayout l = ComputeSpaceManageLayout(gfx::Size(), 0);
+  EXPECT_GE(l.list.width(), 0);
+  EXPECT_GE(l.list.height(), 0);
+  EXPECT_EQ(0, l.list.height());
+  EXPECT_GE(l.done.y(), 0);
+  EXPECT_GE(l.done.width(), 0);
