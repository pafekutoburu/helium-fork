+void VerticalTabStripRegionView::OnManageSheetPickerClosed() {
+  // Dismissed without a pick: the picker cleared the focus on its way out
+  // (never advanced -- advancing lands on the page); the sheet takes it
+  // back so Escape and Return keep working.
+  if (manage_view_) {
+    manage_view_->RequestFocus();
+  }
+}
