+void VerticalTabStripRegionView::OnManageSheetPickIcon(
+    views::View* anchor,
+    const std::string& space_id,
+    const std::string& current_icon) {
+  BrowserView* const view = browser_view();
+  if (!view || !anchor || !anchor->parent() || !manage_view_) {
+    return;
+  }
+  const gfx::Rect anchor_in_view =
+      views::View::ConvertRectToTarget(anchor, view, anchor->GetLocalBounds());
+  const gfx::Rect row_in_view = views::View::ConvertRectToTarget(
+      anchor->parent(), view, anchor->parent()->GetLocalBounds());
+  const gfx::Rect region_in_view =
+      views::View::ConvertRectToTarget(this, view, GetLocalBounds());
+  // The head row's placement (Arc g21b): the card's top 17 below the row's
+  // bottom, its tail at the icon, its left 13 in from the sidebar's edge.
+  view->ShowHeliumSpaceIconPicker(
+      anchor_in_view, helium::SpaceIconPickerPlacement::kBelowAnchor,
+      row_in_view.bottom() + helium::kSpaceIconPickerGapBelowHeadRow,
+      region_in_view.x(), current_icon,
+      base::BindRepeating(&VerticalTabStripRegionView::OnManageSheetIconPicked,
+                          sheet_weak_factory_.GetWeakPtr(), space_id),
+      base::BindRepeating(&VerticalTabStripRegionView::OnManageSheetPickerClosed,
+                          sheet_weak_factory_.GetWeakPtr()));
+}
