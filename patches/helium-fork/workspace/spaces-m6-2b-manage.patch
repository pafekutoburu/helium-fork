+// The footer is the Create form's (user 2026-09-17; the two classes there
+// are private to helium_space_create_form_view.cc). "Done": its "Create
+// Space" capsule -- Arc's (32,42,254), white text, the shell's radius --
+// never disabled here.
+
+class HeliumSpaceManageView::DoneButton : public views::Button {
+  METADATA_HEADER(DoneButton, views::Button)
+
+ public:
+  explicit DoneButton(PressedCallback callback)
+      : views::Button(std::move(callback)) {
+    GetViewAccessibility().SetRole(ax::mojom::Role::kButton);
+    GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_MANAGE_DONE));
+    font_ = FontOfSize(helium::kSpaceManageDoneFontSize,
+                       gfx::Font::Weight::SEMIBOLD);
+  }
+  DoneButton(const DoneButton&) = delete;
+  DoneButton& operator=(const DoneButton&) = delete;
+  ~DoneButton() override = default;
+
+  // views::Button:
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    cc::PaintFlags fill;
+    fill.setStyle(cc::PaintFlags::kFill_Style);
+    fill.setAntiAlias(true);
+    fill.setColor(SkColorSetRGB(helium::kSpaceFormCreateR,
+                                helium::kSpaceFormCreateG,
+                                helium::kSpaceFormCreateB));
+    canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), CornerRadius(), fill);
+    canvas->DrawStringRectWithFlags(
+        l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_MANAGE_DONE), font_,
+        SK_ColorWHITE, GetLocalBounds(), gfx::Canvas::TEXT_ALIGN_CENTER);
+  }
+
+ private:
+  gfx::FontList font_;
+};
