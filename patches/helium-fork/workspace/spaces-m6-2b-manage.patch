+class SpacesChangedCounter : public WorkspaceService::Observer {
+ public:
+  explicit SpacesChangedCounter(WorkspaceService* service) {
+    observation_.Observe(service);
+  }
+  int count() const { return count_; }
+  void OnWorkspaceSpacesChanged() override { ++count_; }
+
+ private:
+  int count_ = 0;
+  base::ScopedObservation<WorkspaceService, WorkspaceService::Observer>
+      observation_{this};
+};
