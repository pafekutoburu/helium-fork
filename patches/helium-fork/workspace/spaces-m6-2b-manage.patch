+
+void HeliumSpaceManageView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  const ui::ColorProvider* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  title_->SetEnabledColor(colors->GetColor(ui::kColorLabelForeground));
+  SchedulePaint();
+}
+
+bool HeliumSpaceManageView::AcceleratorPressed(
+    const ui::Accelerator& accelerator) {
+  if (accelerator.key_code() != ui::VKEY_ESCAPE) {
+    return false;
+  }
+  // Mid-drag, Escape flies the row home (and while a card is already
+  // gliding it does nothing); otherwise it is Cancel, like the form's.
+  if (gesture_) {
+    EndRowDrag(/*commit=*/false);
+  } else {
+    OnCancelPressed();
+  }
+  return true;
+}
+
+bool HeliumSpaceManageView::OnKeyPressed(const ui::KeyEvent& event) {
+  if (event.key_code() == ui::VKEY_ESCAPE) {
+    if (gesture_) {
+      EndRowDrag(/*commit=*/false);
+    } else {
+      OnCancelPressed();
+    }
+    return true;
+  }
+  if (event.key_code() == ui::VKEY_RETURN) {
+    // Return is Done; swallowed while a row is in the air.
+    if (!gesture_) {
+      OnDonePressed();
+    }
+    return true;
+  }
+  return false;
+}
+
+void HeliumSpaceManageView::AddedToWidget() {
+  views::View::AddedToWidget();
+  service_ = helium_workspace::WorkspaceServiceFactory::GetForProfile(
+      browser_->GetProfile());
+  opened_with_.clear();
+  if (service_) {
+    service_observation_.Observe(service_);
+    // What Cancel goes back to: everything this sheet can change.
+    for (const helium_workspace::WorkspaceSpace& space : service_->spaces()) {
+      opened_with_.push_back({space.id, space.icon});
+    }
+  }
+  Rebuild();
+  // Escape cancels (the sheet, or the drag) wherever the focus is.
+  AddAccelerator(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE));
+  RequestFocus();
+}
+
+void HeliumSpaceManageView::RemovedFromWidget() {
+  FinishRowDrag();
+  service_observation_.Reset();
+  service_ = nullptr;
+  views::View::RemovedFromWidget();
+}
+
+void HeliumSpaceManageView::OnWorkspaceSpacesChanged() {
+  if (suppress_rebuild_) {
+    rebuild_pending_ = true;
+    return;
+  }
+  Sync();
+}
+
+void HeliumSpaceManageView::Sync() {
+  rebuild_pending_ = false;
+  if (!service_) {
+    return;
+  }
+  const std::vector<helium_workspace::WorkspaceSpace>& spaces =
+      service_->spaces();
+  bool same_order = spaces.size() == rows_.size();
+  for (size_t i = 0; same_order && i < spaces.size(); ++i) {
+    same_order = rows_[i]->space_id() == spaces[i].id;
+  }
+  if (same_order) {
+    // A rename, an icon change, a collapse: the rows stay, and so does a
+    // drag in progress -- whose card is that row's picture too.
+    for (size_t i = 0; i < spaces.size(); ++i) {
+      rows_[i]->SetSpace(spaces[i]);
+      if (gesture_ && gesture_->row == rows_[i]) {
+        ghost_->SetSpace(spaces[i]);
+      }
+    }
+    return;
+  }
+  // Something else changed the list (another window added, removed or
+  // reordered a space): the gesture's indices mean nothing any more, and
+  // its row is about to be deleted -- no glide, end it here.
+  FinishRowDrag();
+  Rebuild();
+}
+
+void HeliumSpaceManageView::Rebuild() {
+  DCHECK(!gesture_);
+  // The tween's snapshot is parallel to the rows being replaced.
+  yield_animation_.Reset(0.0);
+  yield_from_y_.clear();
+  for (Row* row : rows_) {
+    row_list_->RemoveChildViewT(row);
+  }
+  rows_.clear();
+  if (service_) {
+    for (const helium_workspace::WorkspaceSpace& space : service_->spaces()) {
+      Row* row = row_list_->AddChildView(std::make_unique<Row>(this));
+      row->SetSpace(space);
+      rows_.push_back(row);
+    }
+  }
+  // The only layout invalidation on this path: the row count changed, so
+  // the viewport, "+ New Space" and the scroll extent move.
+  PositionRows();
+  InvalidateLayout();
+}
+
+int HeliumSpaceManageView::TargetRowY(size_t k) const {
+  const int h = helium::kSpaceManageRowHeight;
+  if (!gesture_ || gesture_->settling) {
+    // Settling: rows_ is already in its final order, the lifted row's slot
+    // included -- the card is gliding to exactly this.
+    return static_cast<int>(k) * h;
+  }
+  // Mid-drag: the other rows fill every slot but the insert slot, in order
+  // (closed up when there is none). The lifted row is not shown; it waits
+  // where it was.
+  const size_t from = gesture_->from_index;
+  if (k == from) {
+    return static_cast<int>(from) * h;
+  }
+  const size_t remaining = k < from ? k : k - 1;
+  const std::optional<size_t>& insert = gesture_->insert_index;
+  const size_t slot = !insert || remaining < *insert ? remaining : remaining + 1;
+  return static_cast<int>(slot) * h;
+}
+
+void HeliumSpaceManageView::PositionRows() {
+  const int w = row_list_->width();
+  const int h = helium::kSpaceManageRowHeight;
+  const bool gliding = yield_animation_.is_animating() &&
+                       yield_from_y_.size() == rows_.size();
+  const double t = gliding ? yield_animation_.GetCurrentValue() : 1.0;
+  for (size_t k = 0; k < rows_.size(); ++k) {
+    int y = TargetRowY(k);
+    // The lifted row snaps: its motion belongs to the card, not the rows.
+    if (gliding && !(gesture_ && gesture_->row == rows_[k])) {
+      y = yield_from_y_[k] + base::ClampRound((y - yield_from_y_[k]) * t);
+    }
+    rows_[k]->SetBoundsRect(gfx::Rect(0, y, w, h));
+  }
+}
+
+void HeliumSpaceManageView::RetargetYield() {
+  // What is on screen *before* the plan flips (M3.10-r1), then one glide to
+  // the new targets -- the pinned rows' RetargetDragYield.
+  yield_from_y_.clear();
+  yield_from_y_.reserve(rows_.size());
+  for (Row* row : rows_) {
+    yield_from_y_.push_back(row->y());
+  }
+  yield_animation_.Reset(0.0);
+  yield_animation_.Show();
+}
+
+void HeliumSpaceManageView::AnimationProgressed(
+    const gfx::Animation* animation) {
+  if (animation == &yield_animation_) {
+    // ⛔ Positions only, never InvalidateLayout(): views invalidates up, and
+    // a per-frame invalidation re-lays-out the whole window (M3.11 轮3-r4).
+    PositionRows();
+    return;
+  }
+  if (animation == &settle_animation_ && gesture_) {
+    const double t = settle_animation_.GetCurrentValue();
+    SetCardRect(gfx::Rect(
+        settle_from_.x() + base::ClampRound((settle_to_.x() - settle_from_.x()) * t),
+        settle_from_.y() + base::ClampRound((settle_to_.y() - settle_from_.y()) * t),
+        settle_to_.width(), settle_to_.height()));
+  }
+}
+
+void HeliumSpaceManageView::AnimationEnded(const gfx::Animation* animation) {
+  if (animation == &yield_animation_) {
+    PositionRows();
+    return;
+  }
+  if (animation == &settle_animation_) {
+    FinishRowDrag();
+  }
+}
+
+void HeliumSpaceManageView::BeginRowDrag(Row* row,
+                                         const gfx::Point& press,
+                                         const gfx::Point& point) {
+  // Not while the previous card is still gliding home.
+  if (gesture_ || !service_) {
+    return;
+  }
+  const auto it = std::find(rows_.begin(), rows_.end(), row);
+  const helium_workspace::WorkspaceSpace* const space =
+      service_->FindSpaceById(row->space_id());
+  if (it == rows_.end() || !space || row->size().IsEmpty()) {
+    return;
+  }
+  const size_t from = static_cast<size_t>(it - rows_.begin());
+  // The session opens with the hole in the row's own slot: picking a row up
+  // changes nothing but the row itself floating (Dia). The grip is where the
+  // press landed, not where the threshold was crossed (probe 2026-09-17), so
+  // the card's first frame catches up with the pointer.
+  gesture_ = Gesture{
+      row, row->space_id(), from, from,
+      gfx::Vector2dF(static_cast<float>(press.x()) / row->width(),
+                     static_cast<float>(press.y()) / row->height())};
+  row->SetAway(true);
+  ghost_->SetSpace(*space);
+  // Size through bounds once, position through the transform from here on
+  // (SetCardRect). A layer only while in the air, non-opaque so the sidebar
+  // shows through the card's corners.
+  ghost_->SetBoundsRect(gfx::Rect(row->size()));
+  ghost_->SetPaintToLayer();
+  ghost_->layer()->SetFillsBoundsOpaquely(false);
+  ghost_->SetVisible(true);
+  const int radius = CornerRadius();
+  shadow_->SetShadowCornerRadius(radius);
+  shadow_->SetPaintToLayer();
+  shadow_->layer()->SetFillsBoundsOpaquely(false);
+  shadow_->SetVisible(
+      helium::CanShowCardShadow(row->width(), row->height(), radius));
+  UpdateRowDrag(point);
+}
+
+void HeliumSpaceManageView::UpdateRowDrag(const gfx::Point& point) {
+  if (!gesture_ || gesture_->settling) {
+    return;
+  }
+  Gesture& g = *gesture_;
+  gfx::Point in_sheet = point;
+  views::View::ConvertPointToTarget(g.row, this, &in_sheet);
+  // ⛔ The per-frame path: one transform on the card, one on its shadow.
+  // Nothing here invalidates a layout.
+  SetCardRect(gfx::Rect(
+      in_sheet.x() - base::ClampRound(g.grab.x() * ghost_->width()),
+      in_sheet.y() - base::ClampRound(g.grab.y() * ghost_->height()),
+      ghost_->width(), ghost_->height()));
+  // The slot, by the pinned rows' rule: the pointer against the rows where
+  // they are drawn -- and none at all once the pointer leaves the sheet.
+  std::optional<size_t> slot;
+  if (GetLocalBounds().Contains(in_sheet)) {
+    gfx::Point in_list = point;
+    // Through the ScrollView: the list's coordinates carry the scroll offset.
+    views::View::ConvertPointToTarget(g.row, row_list_, &in_list);
+    // Only rows on screen can be passed: beyond the viewport's ends (over
+    // "+ New Space", the footer, the title) the pointer reads as just past
+    // the last row showing, not as deep into the rows scrolled out of sight.
+    // With everything showing this changes nothing.
+    int y = in_list.y();
+    if (const gfx::Rect visible = row_list_->GetVisibleBounds();
+        !visible.IsEmpty()) {
+      y = std::clamp(y, visible.y() - 1, visible.bottom());
+    }
+    slot = helium::SpaceManageInsertIndex(y, rows_.size(), g.insert_index);
+  }
+  if (slot != g.insert_index) {
+    RetargetYield();
+    g.insert_index = slot;
+  }
+}
+
+void HeliumSpaceManageView::EndRowDrag(bool commit) {
+  if (!gesture_ || gesture_->settling) {
+    return;
+  }
+  Gesture& g = *gesture_;
+  g.row->Disarm();
+  // Let the rows glide from wherever the preview left them to the final
+  // order: after a drop they are already there, after a cancel it is the
+  // fold-back.
+  RetargetYield();
+  g.settling = true;
+  const bool moved =
+      commit && g.insert_index && *g.insert_index != g.from_index;
+  // Copies first: the service write below re-enters this view.
+  const std::string space_id = g.space_id;
+  const size_t target = moved ? *g.insert_index : g.from_index;
+  if (moved) {
+    // The order the service is about to have; the snapshot above is per
+    // row, so it moves with them.
+    Row* const row = g.row;
+    const int row_from_y = yield_from_y_[g.from_index];
+    rows_.erase(rows_.begin() + static_cast<long>(g.from_index));
+    rows_.insert(rows_.begin() + static_cast<long>(target), row);
+    yield_from_y_.erase(yield_from_y_.begin() +
+                        static_cast<long>(g.from_index));
+    yield_from_y_.insert(yield_from_y_.begin() + static_cast<long>(target),
+                         row_from_y);
+  }
+  PositionRows();
+  // The card glides to the row's slot -- one motion for a drop and for a
+  // cancel (Dia measures the same curve for both).
+  settle_from_ = card_rect_;
+  settle_to_ = views::View::ConvertRectToTarget(
+      row_list_, this,
+      gfx::Rect(0, static_cast<int>(target) * helium::kSpaceManageRowHeight,
+                ghost_->width(), ghost_->height()));
+  if (moved && service_) {
+    // Our own change: the synchronous notification must not rebuild the
+    // rows under the releasing Row's frame. They already sit in the new
+    // order; the deferred Sync() re-syncs them in place.
+    {
+      base::AutoReset<bool> suppress(&suppress_rebuild_, true);
+      service_->MoveSpace(space_id, target);
+    }
+    if (rebuild_pending_) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&HeliumSpaceManageView::Sync,
+                                    weak_factory_.GetWeakPtr()));
+    }
+  }
+  if (!gesture_) {
+    return;  // The write came back as a different list and ended it.
+  }
+  if (settle_from_ == settle_to_) {
+    FinishRowDrag();
+    return;
+  }
+  settle_animation_.Reset(0.0);
+  settle_animation_.Show();
+}
+
+void HeliumSpaceManageView::FinishRowDrag() {
+  if (!gesture_) {
+    return;
+  }
+  // Taken down first: the resets below may call back into this view.
+  Row* const row = gesture_->row;
+  gesture_.reset();
+  settle_animation_.Reset(0.0);
+  yield_animation_.Reset(0.0);
+  yield_from_y_.clear();
+  row->Disarm();
+  row->SetAway(false);
+  // Identity first, then the layer goes: SetTransform is what holds a layer
+  // for the transform, and DestroyLayer should not race it.
+  ghost_->SetTransform(gfx::Transform());
+  ghost_->DestroyLayer();
+  ghost_->SetVisible(false);
+  shadow_->SetVisible(false);
+  shadow_->SetTransform(gfx::Transform());
+  shadow_->DestroyLayer();
+  card_rect_ = gfx::Rect();
+  PositionRows();
+  // The rows moved under a pointer that sent no exits. One turn later, not
+  // from inside whatever frame ended the gesture (a Row's release, a
+  // removal): the resync dispatches a mouse event of its own.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&HeliumSpaceManageView::ResyncHover,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void HeliumSpaceManageView::ResyncHover() {
+  // The pinned rows' ResyncHoverFromCursor: clear what is stale, then one
+  // synthesized move lights whatever the pointer *is* on.
+  for (Row* row : rows_) {
+    row->ClearStaleHover();
+  }
+  if (views::Widget* const widget = GetWidget()) {
+    widget->SynthesizeMouseMoveEvent();
+  }
+}
+
+void HeliumSpaceManageView::SetCardRect(const gfx::Rect& rect) {
+  card_rect_ = rect;
+  ghost_->SetTransform(gfx::Transform::MakeTranslation(
+      static_cast<float>(rect.x()), static_cast<float>(rect.y())));
+  shadow_->SetCardBoundsByTransform(rect);
+  StackCardLayersOnTop();
+}
+
+void HeliumSpaceManageView::StackCardLayersOnTop() {
+  // The card has to clear everything it can be dragged over -- the bar, the
+  // media strip -- and those own layers later in the region's child order.
+  // ⛔ Only when the order is wrong (after the first frame it never is):
+  // every restack is a full layer-tree sync of the whole window
+  // (WorkspaceEntryDragOverlay::StackLayersOnTop, user 2026-08-25).
+  ui::Layer* const card = ghost_->layer();
+  ui::Layer* const shadow = shadow_->layer();
+  ui::Layer* const parent = card ? card->parent() : nullptr;
+  if (!parent || !shadow || shadow->parent() != parent) {
+    return;
+  }
+  const auto& children = parent->children();
+  const size_t n = children.size();
+  if (n >= 2 && children[n - 1] == card && children[n - 2] == shadow) {
+    return;
+  }
+  parent->StackAtTop(shadow);
+  parent->StackAtTop(card);
+}
+
+void HeliumSpaceManageView::RestoreOpenedState() {
+  if (!service_) {
+    return;
+  }
+  // Our own writes, and the sheet is on its way out: no rebuilds.
+  base::AutoReset<bool> suppress(&suppress_rebuild_, true);
+  std::vector<std::string> opened_ids;
+  for (const OpenedSpace& opened : opened_with_) {
+    opened_ids.push_back(opened.id);
+    const helium_workspace::WorkspaceSpace* const space =
+        service_->FindSpaceById(opened.id);
+    if (space && space->icon != opened.icon) {
+      service_->SetSpaceIcon(opened.id, opened.icon);
+    }
+  }
+  std::vector<std::string> current_ids;
+  for (const helium_workspace::WorkspaceSpace& space : service_->spaces()) {
+    current_ids.push_back(space.id);
+  }
+  const std::vector<std::string> order =
+      helium::SpaceManageRestoredOrder(opened_ids, current_ids);
+  // Front to back, each space to its own slot; untouched ones cost nothing.
+  for (size_t i = 0; i < order.size() && i < service_->spaces().size(); ++i) {
+    if (service_->spaces()[i].id != order[i]) {
+      service_->MoveSpace(order[i], i);
+    }
+  }
+}
+
+void HeliumSpaceManageView::ShowRowMenu(Row* row,
+                                        const gfx::Rect& anchor,
+                                        int run_types,
+                                        ui::mojom::MenuSourceType source_type) {
+  if (gesture_) {
+    return;
+  }
+  menu_space_id_ = row->space_id();
+  // The sheet's own copy of the menu: Manage Spaces… is where the user
+  // already is, so that item is left out (WorkspaceSpaceMenuModel::Host).
+  menu_model_ = std::make_unique<WorkspaceSpaceMenuModel>(
+      base::BindRepeating(&HeliumSpaceManageView::RunRowMenuCommand,
+                          base::Unretained(this)),
+      WorkspaceSpaceMenuModel::Host::kManageSheet);
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), run_types,
+      base::BindRepeating(&HeliumSpaceManageView::OnRowMenuClosed,
+                          weak_factory_.GetWeakPtr()));
+  // The row keeps its capsule and "···" while the menu is up (T042 latch);
+  // held weakly, a re-sync may replace the rows under an open menu.
+  menu_row_ = row->GetWeakPtr();
+  row->SetMenuOpen(true);
+  const base::WeakPtr<HeliumSpaceManageView> alive = weak_factory_.GetWeakPtr();
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, anchor,
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+  // T042 M1: RunMenuAt's two early returns never call the closed callback.
+  if (!alive) {
+    return;
+  }
+  if (menu_row_ && !menu_runner_->IsRunning()) {
+    OnRowMenuClosed();
+  }
+}
+
+void HeliumSpaceManageView::RunRowMenuCommand(WorkspaceSpaceMenuCommand command) {
+  const std::string space_id = menu_space_id_;
+  switch (command) {
+    case WorkspaceSpaceMenuCommand::kChangeIcon: {
+      // The picker over this row's icon; the sheet stays up and the row
+      // re-syncs from the service when the pick lands.
+      Row* anchor_row = nullptr;
+      for (Row* row : rows_) {
+        if (row->space_id() == space_id) {
+          anchor_row = row;
+        }
+      }
+      if (anchor_row) {
+        const helium_workspace::WorkspaceSpace* space =
+            service_ ? service_->FindSpaceById(space_id) : nullptr;
+        on_pick_icon_.Run(anchor_row->icon_anchor(), space_id,
+                          space ? space->icon : std::string());
+      }
+      break;
+    }
+    case WorkspaceSpaceMenuCommand::kManageSpaces:
+      // Not in this host's model.
+      break;
+    case WorkspaceSpaceMenuCommand::kRename:
+    case WorkspaceSpaceMenuCommand::kNewFolder:
+    case WorkspaceSpaceMenuCommand::kDelete:
+      // These act on the sidebar underneath: the host closes this sheet
+      // first (deferred -- the menu model is mid-ExecuteCommand).
+      on_command_.Run(space_id, command);
+      break;
+  }
+}
+
+void HeliumSpaceManageView::OnRowMenuClosed() {
+  if (menu_row_) {
+    menu_row_->SetMenuOpen(false);
+  }
+  menu_row_ = nullptr;
+}
+
+void HeliumSpaceManageView::OnDonePressed() {
+  // A card still gliding has already been committed (or cancelled).
+  FinishRowDrag();
+  on_close_.Run();
+}
+
+void HeliumSpaceManageView::OnCancelPressed() {
+  FinishRowDrag();
+  // Nothing this sheet changed is kept (user 2026-09-17). The changes were
+  // live -- the bar followed every drop and every icon -- so they are put
+  // back rather than never written.
+  RestoreOpenedState();
+  on_close_.Run();
+}
+
+void HeliumSpaceManageView::OnNewSpacePressed() {
+  // Swapping to the Create form keeps what was done here, like Done.
+  FinishRowDrag();
+  on_new_space_.Run();
+}
+
+BEGIN_METADATA(HeliumSpaceManageView)
+END_METADATA
