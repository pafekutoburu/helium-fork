+  const raw_ptr<BrowserWindowInterface> browser_;
+  const base::RepeatingClosure on_close_;
+  const base::RepeatingClosure on_new_space_;
+  const CommandCallback on_command_;
+  const PickIconCallback on_pick_icon_;
