+gfx::FontList FontOfSize(int size, gfx::Font::Weight weight) {
+  return gfx::FontList()
+      .DeriveWithSizeDelta(size - gfx::FontList().GetFontSize())
+      .DeriveWithWeight(weight);
+}
+
+// The hovered-row capsule: the head row's recipe (workspace_space_head_row_
+// view.cc), instant like every sidebar hover. Under the native material the
+// toolbar colour is not a pixel colour, so that branch paints an overlay.
+SkColor HoverFillFor(const views::View* view, const ui::ColorProvider* colors) {
+  const SkColor sidebar = colors->GetColor(kColorToolbar);
+  return helium::ShouldUseNativeFrameMaterials(view)
+             ? helium::GetSidebarHoverSurfaceOverlay(sidebar)
+             : helium::GetSidebarHoverSurfaceColor(sidebar);
+}
+
+int CornerRadius() {
+  return GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius);
+}
