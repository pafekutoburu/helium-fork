+// ---------------------------------------------------------------------------
+// RowList: the ScrollView's contents. Its layout is the sheet's
+// PositionRows(), so a size change mid-drag keeps the gap.
+
+class HeliumSpaceManageView::RowList : public views::View {
+  METADATA_HEADER(RowList, views::View)
+
+ public:
+  explicit RowList(HeliumSpaceManageView* sheet) : sheet_(sheet) {}
+  RowList(const RowList&) = delete;
+  RowList& operator=(const RowList&) = delete;
+  ~RowList() override = default;
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    // The width is the viewport's (the ScrollView has no horizontal bar);
+    // the height is the rows', which is what the ScrollView scrolls.
+    const int width =
+        available_size.width().is_bounded() ? available_size.width().value()
+                                            : 0;
+    return gfx::Size(width, static_cast<int>(sheet_->rows_.size()) *
+                                helium::kSpaceManageRowHeight);
+  }
+  void Layout(PassKey) override { sheet_->PositionRows(); }
+
+ private:
+  const raw_ptr<HeliumSpaceManageView> sheet_;
+};
+
+BEGIN_METADATA(HeliumSpaceManageView, RowList)
+END_METADATA
