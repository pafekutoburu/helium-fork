+// ---------------------------------------------------------------------------
+// "+ New Space": a row-shaped button under the list.
+
+class HeliumSpaceManageView::NewSpaceRow : public views::Button {
+  METADATA_HEADER(NewSpaceRow, views::Button)
+
+ public:
+  explicit NewSpaceRow(PressedCallback callback)
+      : views::Button(std::move(callback)) {
+    SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+    GetViewAccessibility().SetRole(ax::mojom::Role::kButton);
+    GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_HELIUM_WS_NEW_SPACE));
+    views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::OFF);
+
+    plus_ = AddChildView(std::make_unique<views::ImageView>());
+    plus_->SetCanProcessEventsWithinSubtree(false);
+    plus_->SetImage(ui::ImageModel::FromVectorIcon(
+        kAddIcon, ui::kColorLabelForegroundSecondary,
+        helium::kSpaceManageGlyphSize));
+
+    label_ = AddChildView(std::make_unique<views::Label>(
+        l10n_util::GetStringUTF16(IDS_HELIUM_WS_NEW_SPACE),
+        views::style::CONTEXT_LABEL, views::style::STYLE_SECONDARY));
+    label_->SetCanProcessEventsWithinSubtree(false);
+    label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label_->SetElideBehavior(gfx::ELIDE_TAIL);
+    label_->SetAutoColorReadabilityEnabled(false);
+    label_->SetSkipSubpixelRenderingOpacityCheck(true);
+    label_->SetSubpixelRenderingEnabled(false);
+  }
+  NewSpaceRow(const NewSpaceRow&) = delete;
+  NewSpaceRow& operator=(const NewSpaceRow&) = delete;
+  ~NewSpaceRow() override = default;
+
+  // views::Button:
+  void Layout(PassKey) override {
+    const helium::SpaceManageRowLayout l =
+        helium::ComputeSpaceManageRowLayout(width());
+    plus_->SetBoundsRect(l.icon);
+    // The label may run to the row's end: this row has no "···" or handle.
+    label_->SetBounds(l.name.x(), 0,
+                      std::max(width() - l.name.x() - helium::kSpaceManageGlyphGap,
+                               0),
+                      height());
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    if (GetState() == STATE_HOVERED || GetState() == STATE_PRESSED) {
+      cc::PaintFlags fill;
+      fill.setStyle(cc::PaintFlags::kFill_Style);
+      fill.setAntiAlias(true);
+      fill.setColor(HoverFillFor(this, colors));
+      canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), CornerRadius(), fill);
+    }
+  }
+
+ private:
+  raw_ptr<views::ImageView> plus_ = nullptr;
+  raw_ptr<views::Label> label_ = nullptr;
+};
+
+BEGIN_METADATA(HeliumSpaceManageView, NewSpaceRow)
+END_METADATA
