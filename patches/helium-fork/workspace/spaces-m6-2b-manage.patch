+HeliumSpaceManageView::HeliumSpaceManageView(BrowserWindowInterface* browser,
+                                             base::RepeatingClosure on_close,
+                                             base::RepeatingClosure on_new_space,
+                                             CommandCallback on_command,
+                                             PickIconCallback on_pick_icon)
+    : views::AnimationDelegateViews(this),
+      browser_(browser),
+      on_close_(std::move(on_close)),
+      on_new_space_(std::move(on_new_space)),
+      on_command_(std::move(on_command)),
+      on_pick_icon_(std::move(on_pick_icon)) {
+  DCHECK_EQ(helium::kSpaceManageRowHeight,
+            GetLayoutConstant(LayoutConstant::kVerticalTabHeight));
+
+  title_ = AddChildView(std::make_unique<views::Label>(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_MANAGE_TITLE)));
+  title_->SetFontList(FontOfSize(helium::kSpaceManageTitleFontSize,
+                                 gfx::Font::Weight::BOLD));
+  title_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  title_->SetAutoColorReadabilityEnabled(false);
+  title_->SetSkipSubpixelRenderingOpacityCheck(true);
+  title_->SetSubpixelRenderingEnabled(false);
+
+  // The rows scroll when there are more than fit (no auto-scroll while
+  // dragging this round). ⛔ The viewport owns a layer that masks to bounds
+  // (composited scrolling is on by default on macOS): anything that has to
+  // be seen past the list -- the floating card, its shadow -- cannot live in
+  // here (user 2026-09-17: the shadow was cut off at the row's own edges).
+  auto scroll = std::make_unique<views::ScrollView>();
+  // Default is the dialog background; the rows sit on the sidebar.
+  scroll->SetBackgroundColor(std::nullopt);
+  scroll->SetHorizontalScrollBarMode(views::ScrollView::ScrollBarMode::kDisabled);
+  scroll->SetVerticalScrollBarMode(
+      views::ScrollView::ScrollBarMode::kHiddenButEnabled);
+  scroll->SetDrawOverflowIndicator(false);
+  // ⛔ Off by default: without it the ScrollView keeps the contents at their
+  // own size (never set here, so the viewport's), the rows past the viewport
+  // cannot be scrolled to and RowList::CalculatePreferredSize is dead code
+  // (reviewer 2026-09-17; probe managescroll: 19 of 24 rows, wheel inert).
+  scroll->SetUseContentsPreferredSize(true);
+  auto row_list = std::make_unique<RowList>(this);
+  row_list_ = row_list.get();
+  scroll->SetContents(std::move(row_list));
+  scroll_ = AddChildView(std::move(scroll));
+
+  new_space_ = AddChildView(std::make_unique<NewSpaceRow>(base::BindRepeating(
+      &HeliumSpaceManageView::OnNewSpacePressed, base::Unretained(this))));
+  done_ = AddChildView(std::make_unique<DoneButton>(base::BindRepeating(
+      &HeliumSpaceManageView::OnDonePressed, base::Unretained(this))));
+  cancel_ = AddChildView(std::make_unique<CancelButton>(base::BindRepeating(
+      &HeliumSpaceManageView::OnCancelPressed, base::Unretained(this))));
+
+  // The floating card and its shadow, last so they paint above the rest
+  // (shadow first: layered siblings paint in child order). The pinned rows'
+  // pair lives on the region for the same reason these live out here: every
+  // layer below masks to bounds. Hidden until a row lifts, and layerless
+  // too (M3.10-r1: no resting layers) -- the shadow view is born with one,
+  // so it goes here and comes back for the flight, as the pinned overlay
+  // does with its own (reviewer 2026-09-17).
+  shadow_ = AddChildView(std::make_unique<HeliumCardShadowView>());
+  shadow_->SetShadowCornerRadius(CornerRadius());
+  shadow_->SetVisible(false);
+  shadow_->DestroyLayer();
+  ghost_ = AddChildView(std::make_unique<Row>(this));
+  ghost_->MakeGhost();
+  ghost_->SetVisible(false);
+
+  // The pinned rows' motion (arc_sidebar_surface.h, fitted to Dia).
+  yield_animation_.SetSlideDuration(helium::kSidebarDragYieldDuration);
+  yield_animation_.SetTweenType(helium::kSidebarDragYieldTween);
+  settle_animation_.SetSlideDuration(helium::kSidebarDragSettleDuration);
+  settle_animation_.SetTweenType(helium::kSidebarDragSettleTween);
+
+  GetViewAccessibility().SetRole(ax::mojom::Role::kGroup);
+  GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_MANAGE_TITLE));
+  // The sheet holds the focus while it is up, so Escape and Return reach
+  // OnKeyPressed (an accelerator alone is not enough once the focus is in
+  // the page -- pitfalls 「M6 轮2 2a」#3); nothing inside it is focusable.
+  SetFocusBehavior(FocusBehavior::ALWAYS);
+}
+
+HeliumSpaceManageView::~HeliumSpaceManageView() = default;
+
+void HeliumSpaceManageView::OnIconPicked(const std::string& space_id,
+                                         const std::string& icon) {
+  if (service_) {
+    service_->SetSpaceIcon(space_id, icon);
+  }
