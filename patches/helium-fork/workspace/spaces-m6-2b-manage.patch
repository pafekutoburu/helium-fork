+TEST_F(WorkspaceServiceTest, MoveSpaceClampsBeyondTheEnd) {
+  const std::string a = service_->AddSpace(u"A", "", kDefaultSpaceId);
+  const std::string b = service_->AddSpace(u"B", "", a);
+  ASSERT_THAT(SpaceShape(*service_), ElementsAre(kDefaultSpaceId, a, b));
+  ASSERT_TRUE(service_->MoveSpace(kDefaultSpaceId, 99));
+  EXPECT_THAT(SpaceShape(*service_), ElementsAre(a, b, kDefaultSpaceId));
+  // The last slot among the remaining two is exactly 2.
+  ASSERT_TRUE(service_->MoveSpace(a, 2));
+  EXPECT_THAT(SpaceShape(*service_), ElementsAre(b, kDefaultSpaceId, a));
+}
+
+TEST_F(WorkspaceServiceTest, MoveSpaceToItsOwnSlotKeepsTheOrder) {
+  const std::string a = service_->AddSpace(u"A", "", kDefaultSpaceId);
+  const std::string b = service_->AddSpace(u"B", "", a);
+  SpacesChangedCounter counter(service_.get());
+  ASSERT_TRUE(service_->MoveSpace(a, 1));
+  EXPECT_THAT(SpaceShape(*service_), ElementsAre(kDefaultSpaceId, a, b));
+  ASSERT_TRUE(service_->MoveSpace(kDefaultSpaceId, 0));
+  EXPECT_THAT(SpaceShape(*service_), ElementsAre(kDefaultSpaceId, a, b));
+  // Each call is one notification, order change or not.
+  EXPECT_EQ(2, counter.count());
+}
+
+TEST_F(WorkspaceServiceTest, MoveSpaceUnknownIdIsRefusedSilently) {
+  const std::string a = service_->AddSpace(u"A", "", kDefaultSpaceId);
+  SpacesChangedCounter counter(service_.get());
+  EXPECT_FALSE(service_->MoveSpace("no-such-space", 0));
+  EXPECT_THAT(SpaceShape(*service_), ElementsAre(kDefaultSpaceId, a));
+  EXPECT_EQ(0, counter.count());
+}
+
+TEST_F(WorkspaceServiceTest, MoveSpaceKeepsPositionsDenseAndPersists) {
+  const std::string a = service_->AddSpace(u"A", "", kDefaultSpaceId);
+  const std::string b = service_->AddSpace(u"B", "", a);
+  const std::string c = service_->AddSpace(u"C", "", b);
+  SpacesChangedCounter counter(service_.get());
+  ASSERT_TRUE(service_->MoveSpace(c, 0));
+  ASSERT_TRUE(service_->MoveSpace(kDefaultSpaceId, 3));
+  ASSERT_TRUE(service_->MoveSpace(b, 1));
+  EXPECT_EQ(3, counter.count());
+  EXPECT_THAT(SpaceShape(*service_), ElementsAre(c, b, a, kDefaultSpaceId));
+  for (size_t i = 0; i < service_->spaces().size(); ++i) {
+    EXPECT_EQ(static_cast<int>(i), service_->spaces()[i].position);
+  }
+  service_->Shutdown();
+
+  WorkspaceService reloaded(&prefs_, u"Personal");
+  EXPECT_THAT(SpaceShape(reloaded), ElementsAre(c, b, a, kDefaultSpaceId));
+  for (size_t i = 0; i < reloaded.spaces().size(); ++i) {
+    EXPECT_EQ(static_cast<int>(i), reloaded.spaces()[i].position);
+  }
+}
