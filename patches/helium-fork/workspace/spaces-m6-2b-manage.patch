+
+void VerticalTabStripRegionView::RunManageSheetCommand(
+    const std::string& space_id,
+    WorkspaceSpaceMenuCommand command) {
+  // Rename / New Folder / Delete act on the sidebar underneath (the head
+  // row's field, the current space's list, the undo bar -- all suppressed
+  // while a sheet is up), so the sheet goes first; then the command runs
+  // exactly as from the bar icon's own menu.
+  CloseSidebarSheet();
+  if (space_bar_) {
+    space_bar_->RunSpaceMenuCommand(space_id, command);
+  }
+}
