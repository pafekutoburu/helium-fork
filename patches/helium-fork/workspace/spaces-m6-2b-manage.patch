+}
+
+void HeliumSpaceManageView::Layout(PassKey) {
+  const helium::SpaceManageLayout l =
+      helium::ComputeSpaceManageLayout(size(), rows_.size());
+  title_->SetBoundsRect(l.title);
+  scroll_->SetBoundsRect(l.list);
+  new_space_->SetBoundsRect(l.new_space_row);
