+// ---------------------------------------------------------------------------
+// Row: one space. Icon slot (emoji / vector glyph / 8pt dot), the name, the
+// "···" under the pointer, the drag handle at the right edge. The same class
+// is the floating card (MakeGhost), so the card is the row to the pixel.
+
+class HeliumSpaceManageView::Row : public views::View,
+                                   public views::ContextMenuController {
+  METADATA_HEADER(Row, views::View)
+
+ public:
+  explicit Row(HeliumSpaceManageView* sheet) : sheet_(sheet) {
+    SetNotifyEnterExitOnChild(true);
+    GetViewAccessibility().SetRole(ax::mojom::Role::kListItem);
+
+    icon_label_ = AddChildView(std::make_unique<views::Label>());
+    icon_label_->SetCanProcessEventsWithinSubtree(false);
+    icon_label_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    icon_label_->SetAutoColorReadabilityEnabled(false);
+    // ⛔ The list's contents sit on a non-opaque layer (composited scrolling)
+    // and the floating card gets one of its own: a Label DCHECKs subpixel
+    // text there (label.cc). An emoji has none to lose; the name below is
+    // set the same way.
+    icon_label_->SetSubpixelRenderingEnabled(false);
+    icon_label_->SetFontList(icon_label_->font_list().DeriveWithSizeDelta(
+        helium::kSpaceManageGlyphSize - icon_label_->font_list().GetFontSize()));
+    // The slot is laid out wider than the glyph size (Layout); never "…".
+    icon_label_->SetElideBehavior(gfx::NO_ELIDE);
+
+    icon_image_ = AddChildView(std::make_unique<views::ImageView>());
+    icon_image_->SetCanProcessEventsWithinSubtree(false);
+    icon_image_->SetVisible(false);
+
+    name_ = AddChildView(std::make_unique<views::Label>(
+        std::u16string(), views::style::CONTEXT_LABEL,
+        views::style::STYLE_PRIMARY));
+    name_->SetCanProcessEventsWithinSubtree(false);
+    name_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    name_->SetElideBehavior(gfx::ELIDE_TAIL);
+    name_->SetAutoColorReadabilityEnabled(false);
+    name_->SetSkipSubpixelRenderingOpacityCheck(true);
+    name_->SetSubpixelRenderingEnabled(false);
+
+    auto menu_button = views::CreateVectorImageButtonWithNativeTheme(
+        base::BindRepeating(&Row::OnMenuPressed, base::Unretained(this)),
+        kMoreVertIcon, helium::kSpaceManageGlyphSize);
+    menu_button->SetTooltipText(
+        l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_MENU_BUTTON));
+    menu_button->GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_MENU_BUTTON));
+    menu_button->SetVisible(false);
+    menu_button_ = AddChildView(std::move(menu_button));
+
+    // The handle is a picture: the press lands on the row, which drags from
+    // anywhere; the glyph only says so (and turns the pointer into a hand).
+    handle_ = AddChildView(std::make_unique<views::ImageView>());
+    handle_->SetCanProcessEventsWithinSubtree(false);
+    handle_->SetImage(ui::ImageModel::FromVectorIcon(
+        kHeliumDragHandleIcon, ui::kColorLabelForegroundSecondary,
+        helium::kSpaceManageGlyphSize));
+    handle_->GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_MANAGE_HANDLE));
+
+    // The row's right-click is the same menu as its "···" (the head row's
+    // and the bar icon's contract). ⛔ Only rows carry a controller, never
+    // the sheet or the list (M4-r2: a controller on a sidebar container
+    // replaces the window menu on its blank).
+    set_context_menu_controller(this);
+  }
+  Row(const Row&) = delete;
+  Row& operator=(const Row&) = delete;
+  ~Row() override = default;
+
+  // The floating card: this row's picture on the card's fill, inert.
+  void MakeGhost() {
+    ghost_ = true;
+    SetCanProcessEventsWithinSubtree(false);
+    set_context_menu_controller(nullptr);
+    GetViewAccessibility().SetIsIgnored(true);
+    GetViewAccessibility().SetIsLeaf(true);
+  }
+
+  const std::string& space_id() const { return space_id_; }
+  views::View* icon_anchor() { return icon_label_; }
+  base::WeakPtr<Row> GetWeakPtr() { return weak_factory_.GetWeakPtr(); }
+
+  void SetSpace(const helium_workspace::WorkspaceSpace& space) {
+    space_id_ = space.id;
+    if (icon_ != space.icon) {
+      icon_ = space.icon;
+      if (helium_workspace::IsVectorIconRef(icon_)) {
+        const gfx::VectorIcon* vector = FindSpaceVectorIcon(
+            helium_workspace::VectorIconRefName(icon_));
+        icon_image_->SetImage(
+            vector ? ui::ImageModel::FromVectorIcon(
+                         *vector, ui::kColorLabelForegroundSecondary,
+                         helium::kSpaceManageGlyphSize)
+                   : ui::ImageModel());
+        icon_label_->SetText(std::u16string());
+      } else {
+        icon_image_->SetImage(ui::ImageModel());
+        icon_label_->SetText(base::UTF8ToUTF16(icon_));
+      }
+      icon_image_->SetVisible(helium_workspace::IsVectorIconRef(icon_));
+      icon_label_->SetVisible(!icon_.empty() &&
+                              !helium_workspace::IsVectorIconRef(icon_));
+      SchedulePaint();
+    }
+    if (name_->GetText() != space.name) {
+      name_->SetText(space.name);
+      // ⛔ An empty accessible name aborts under DCHECKs; a space with no
+      // name reads as the default one.
+      GetViewAccessibility().SetName(
+          space.name.empty()
+              ? l10n_util::GetStringUTF16(IDS_HELIUM_WS_NEW_SPACE_DEFAULT_NAME)
+              : space.name);
+    }
+  }
+
+  // The sheet's hooks around a drag. While its card is in the air the row
+  // paints nothing, but stays where it is, a visible child of the list: it
+  // is RootView's pressed handler, and hiding or reparenting it would drop
+  // the rest of the gesture.
+  void SetAway(bool away) {
+    if (away_ == away) {
+      return;
+    }
+    away_ = away;
+    // No exit arrives during the press: the "···" a hover had shown must go
+    // now (reviewer 2026-09-16).
+    UpdateMenuButtonVisibility();
+    SchedulePaint();
+  }
+  // The sheet ended the gesture from outside (Escape, a settle): what is
+  // left of the press is not a drag any more.
+  void Disarm() { armed_ = false; }
+  // After a drag the rows have moved under a pointer that sent no exits.
+  // Only ever clears (M3.11-r1): lighting is the synthesized move's job.
+  void ClearStaleHover() {
+    if (hovered_ && !IsMouseHovered()) {
+      hovered_ = false;
+      UpdateMenuButtonVisibility();
+      SchedulePaint();
+    }
+  }
+
+  void SetMenuOpen(bool open) {
+    if (menu_open_ == open) {
+      return;
+    }
+    menu_open_ = open;
+    UpdateMenuButtonVisibility();
+    SchedulePaint();
+  }
+
+  // views::View:
+  void Layout(PassKey) override {
+    const helium::SpaceManageRowLayout l =
+        helium::ComputeSpaceManageRowLayout(width());
+    gfx::Rect emoji = l.icon;
+    emoji.Outset(helium::kSpaceManageEmojiSlop);
+    icon_label_->SetBoundsRect(emoji);
+    icon_image_->SetBoundsRect(l.icon);
+    name_->SetBoundsRect(l.name);
+    menu_button_->SetBoundsRect(l.menu);
+    handle_->SetBoundsRect(l.handle);
+  }
+
+  void PaintChildren(const views::PaintInfo& info) override {
+    if (!away_) {
+      views::View::PaintChildren(info);
+    }
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    views::View::OnPaint(canvas);
+    const ui::ColorProvider* colors = GetColorProvider();
+    if (!colors || away_) {
+      return;
+    }
+    if (ghost_) {
+      // In the air: the floating card every sidebar card wears when it
+      // leaves its row (the undo bar, the picker, the dragged entry).
+      cc::PaintFlags fill;
+      fill.setStyle(cc::PaintFlags::kFill_Style);
+      fill.setAntiAlias(true);
+      fill.setColor(helium::GetSidebarFloatingCardColor(
+          colors->GetColor(kColorToolbar)));
+      canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), CornerRadius(), fill);
+    } else if (hovered_ || menu_open_) {
+      cc::PaintFlags fill;
+      fill.setStyle(cc::PaintFlags::kFill_Style);
+      fill.setAntiAlias(true);
+      fill.setColor(HoverFillFor(this, colors));
+      canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), CornerRadius(), fill);
+    }
+    if (icon_.empty()) {
+      // No icon: the bar's 8pt dot, centred in the slot.
+      const helium::SpaceManageRowLayout l =
+          helium::ComputeSpaceManageRowLayout(width());
+      cc::PaintFlags dot;
+      dot.setStyle(cc::PaintFlags::kFill_Style);
+      dot.setAntiAlias(true);
+      dot.setColor(colors->GetColor(ui::kColorLabelForegroundSecondary));
+      canvas->DrawCircle(gfx::PointF(l.icon.CenterPoint()),
+                         helium::kSpaceManageDotSize / 2.0f, dot);
+    }
+  }
+
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    hovered_ = true;
+    UpdateMenuButtonVisibility();
+    SchedulePaint();
+  }
+
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    // An exit is final (T042): with SetNotifyEnterExitOnChild the only
+    // exits that arrive are RootView's own.
+    hovered_ = false;
+    UpdateMenuButtonVisibility();
+    SchedulePaint();
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton()) {
+      return false;
+    }
+    // Anywhere on the row, like a pinned row (user 2026-09-17); the "···"
+    // is a child button and takes its own presses. Claiming the press makes
+    // this row RootView's handler for the drag and the release that follow,
+    // wherever the pointer goes. A press that never moves does nothing.
+    press_ = event.location();
+    armed_ = true;
+    return true;
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    if (!armed_) {
+      return false;
+    }
+    // Row coordinates throughout: the row does not move while it is away.
+    if (!away_) {
+      if (!views::View::ExceededDragThreshold(event.location() - press_)) {
+        return true;
+      }
+      sheet_->BeginRowDrag(this, press_, event.location());
+      return true;
+    }
+    sheet_->UpdateRowDrag(event.location());
+    return true;
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (!armed_) {
+      return;
+    }
+    armed_ = false;
+    if (away_) {
+      // The sheet may write to the service from here; it copies what it
+      // needs first and this row touches nothing afterwards.
+      sheet_->EndRowDrag(/*commit=*/true);
+    }
+  }
+
+  void OnMouseCaptureLost() override {
+    if (!armed_) {
+      return;
+    }
+    armed_ = false;
+    if (away_) {
+      sheet_->EndRowDrag(/*commit=*/false);
+    }
+  }
+
+  ui::Cursor GetCursor(const ui::MouseEvent& event) override {
+    // Arc g23: a hand over the handle, a closed hand while the card flies.
+    if (away_) {
+      return ui::Cursor(ui::mojom::CursorType::kGrabbing);
+    }
+    const helium::SpaceManageRowLayout l =
+        helium::ComputeSpaceManageRowLayout(width());
+    if (l.handle_hit.Contains(event.location())) {
+      return ui::Cursor(ui::mojom::CursorType::kGrab);
+    }
+    return views::View::GetCursor(event);
+  }
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override {
+    if (away_) {
+      return;
+    }
+    sheet_->ShowRowMenu(this, gfx::Rect(point, gfx::Size()),
+                        views::MenuRunner::HAS_MNEMONICS |
+                            views::MenuRunner::CONTEXT_MENU,
+                        source_type);
+  }
+
+ private:
+  void OnMenuPressed() {
+    if (away_) {
+      return;
+    }
+    sheet_->ShowRowMenu(this, menu_button_->GetBoundsInScreen(),
+                        views::MenuRunner::HAS_MNEMONICS,
+                        ui::mojom::MenuSourceType::kMouse);
+  }
+
+  void UpdateMenuButtonVisibility() {
+    // Arc: the "···" exists only under the pointer (and while its menu is
+    // up); never while the row is in the air, never on the card.
+    menu_button_->SetVisible((hovered_ || menu_open_) && !away_ && !ghost_);
+  }
+
+  const raw_ptr<HeliumSpaceManageView> sheet_;
+  std::string space_id_;
+  std::string icon_;
+  raw_ptr<views::Label> icon_label_ = nullptr;
+  raw_ptr<views::ImageView> icon_image_ = nullptr;
+  raw_ptr<views::Label> name_ = nullptr;
+  raw_ptr<views::ImageButton> menu_button_ = nullptr;
+  raw_ptr<views::ImageView> handle_ = nullptr;
+  bool hovered_ = false;
+  bool menu_open_ = false;
+  bool ghost_ = false;
+  bool away_ = false;
+  // Between a press on the row and its release.
+  bool armed_ = false;
+  // Where the button went down, in this row's coordinates.
+  gfx::Point press_;
+  base::WeakPtrFactory<Row> weak_factory_{this};
+};
+
+BEGIN_METADATA(HeliumSpaceManageView, Row)
+END_METADATA
