+// "Cancel": the form's Cancel -- plain 12pt text, no border, no ink drop. A
+// LabelButton subclass only because the label's font is a protected reach.
+
+class HeliumSpaceManageView::CancelButton : public views::LabelButton {
+  METADATA_HEADER(CancelButton, views::LabelButton)
+
+ public:
+  explicit CancelButton(PressedCallback callback)
+      : views::LabelButton(
+            std::move(callback),
+            l10n_util::GetStringUTF16(IDS_HELIUM_WS_SPACE_FORM_CANCEL)) {
+    SetBorder(nullptr);
+    SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    SetLabelStyle(views::style::STYLE_SECONDARY);
+    label()->SetFontList(FontOfSize(helium::kSpaceManageCancelFontSize,
+                                    gfx::Font::Weight::SEMIBOLD));
+    label()->SetSkipSubpixelRenderingOpacityCheck(true);
+    label()->SetSubpixelRenderingEnabled(false);
+    views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::OFF);
+  }
+  CancelButton(const CancelButton&) = delete;
+  CancelButton& operator=(const CancelButton&) = delete;
+  ~CancelButton() override = default;
+};
