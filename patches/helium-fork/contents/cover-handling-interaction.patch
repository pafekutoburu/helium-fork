--- /dev/null
+++ src/cc/trees/helium_handling_interaction.cc
@@ -0,0 +1,57 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "cc/trees/helium_handling_interaction.h"
+
+#include <atomic>
+
+#include "base/containers/flat_set.h"
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "base/thread_annotations.h"
+
+namespace cc {
+
+namespace {
+
+struct Registry {
+  base::Lock lock;
+  base::flat_set<int> ids GUARDED_BY(lock);
+};
+
+Registry& GetRegistry() {
+  static base::NoDestructor<Registry> registry;
+  return *registry;
+}
+
+// How many hosts are registered: every LayerTreeHostImpl asks once a frame,
+// and in a renderer (or a browser window not animating) the answer is "none"
+// without taking the lock.
+std::atomic<int> g_registered{0};
+
+}  // namespace
+
+void SetLayerTreeHostHandlingInteraction(int layer_tree_host_id,
+                                         bool handling) {
+  Registry& registry = GetRegistry();
+  base::AutoLock auto_lock(registry.lock);
+  if (handling) {
+    if (registry.ids.insert(layer_tree_host_id).second) {
+      g_registered.fetch_add(1, std::memory_order_relaxed);
+    }
+  } else if (registry.ids.erase(layer_tree_host_id)) {
+    g_registered.fetch_sub(1, std::memory_order_relaxed);
+  }
+}
+
+bool IsLayerTreeHostHandlingInteraction(int layer_tree_host_id) {
+  if (g_registered.load(std::memory_order_relaxed) == 0) {
+    return false;
+  }
+  Registry& registry = GetRegistry();
+  base::AutoLock auto_lock(registry.lock);
+  return registry.ids.contains(layer_tree_host_id);
+}
+
+}  // namespace cc
