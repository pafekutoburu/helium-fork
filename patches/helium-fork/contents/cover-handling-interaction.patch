@@ -0,0 +1,28 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CC_TREES_HELIUM_HANDLING_INTERACTION_H_
+#define CC_TREES_HELIUM_HANDLING_INTERACTION_H_
+
+#include "cc/cc_export.h"
+
+namespace cc {
+
+// helium-fork r1031: a LayerTreeHost whose own client is animating in answer
+// to the user -- the browser window's ui::Compositor while the sidebar's
+// Cmd+S cover runs -- can have its frames say they are handling an
+// interaction (CompositorFrameMetadata::is_handling_interaction), the way an
+// active scroll's do. viz then draws them as soon as they come rather than
+// waiting, up to the deadline, for embedded clients still expected to submit
+// (viz::DisplayScheduler: HasDamageDueToInteraction): on a page whose renderer
+// is busy re-laying out for the new width, that wait made a 60 Hz display
+// drop every second to fourth frame. Keyed by LayerTreeHost::GetId(); any
+// thread. Nothing registers in a renderer, so its frames are as upstream's.
+CC_EXPORT void SetLayerTreeHostHandlingInteraction(int layer_tree_host_id,
+                                                   bool handling);
+CC_EXPORT bool IsLayerTreeHostHandlingInteraction(int layer_tree_host_id);
+
+}  // namespace cc
+
+#endif  // CC_TREES_HELIUM_HANDLING_INTERACTION_H_
