+// helium-fork: decouple the visible viewport from the surface.
+//
+// RenderWidgetHostViewBase::SetInsets() is NOTIMPLEMENTED, and on mac that has
+// a visible cost. When browser UI slides over the bottom of the page -- the Arc
+// shell's address bar band retracting -- the only two options without this are
+// both wrong: resize the view every frame, which on an in-process mac window
+// reallocates the surface (BrowserCompositorMac::UpdateSurfaceFromNSView takes
+// a new LocalSurfaceId whenever the size changes) and lets viz paint gutter
+// quads along the bottom; or keep the size and clip, which is what the band
+// does today -- and then blink lays out against a viewport one band taller than
+// the strip the user can see, so the bottom of the page, the bottom of its
+// scrollbar and anything anchored with `position: fixed; bottom: 0` all sit
+// below the clip. Measured on a page scrolled to the bottom: 30 rows of real
+// content gone for the length of the collapse.
+//
+// Insets fix that by construction. The view -- and therefore the surface --
+// keeps its size, so there is no new LocalSurfaceId and no gutter; only
+// visible_viewport_size in the VisualProperties changes
+// (RenderWidgetHostImpl reads it straight out of GetVisibleViewportSize()), so
+// blink lays out against exactly the strip that is on screen.
+//
+// Aura has had this since the virtual keyboard needed it; this is the same
+// contract, minus its LocalSurfaceId allocation, which exists there because
+// Aura's inset comes with a *size* change and ours deliberately does not.
+void RenderWidgetHostViewMac::SetInsets(const gfx::Insets& insets) {
+  if (insets == insets_) {
+    return;
+  }
+  insets_ = insets;
+  if (host()) {
+    host()->SynchronizeVisualProperties();
+  }
+}
+
+gfx::Size RenderWidgetHostViewMac::GetVisibleViewportSize() {
+  gfx::Rect visible(GetViewBounds().size());
+  visible.Inset(insets_);
+  return visible.size();
+}
+
+gfx::Size RenderWidgetHostViewMac::GetVisibleViewportSizeDevicePx() {
+  const float scale = GetDeviceScaleFactor();
+  gfx::Rect visible(gfx::ScaleToCeiledSize(GetViewBounds().size(), scale));
+  visible.Inset(gfx::ScaleToCeiledInsets(insets_, scale));
+  return visible.size();
+}
+
 bool RenderWidgetHostViewMac::IsPointerLocked() {
   return pointer_locked_;
 }
