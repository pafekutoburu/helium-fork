--- src.orig/content/public/browser/render_widget_host_view.h
+++ src/content/public/browser/render_widget_host_view.h
@@ -336,6 +336,24 @@ class CONTENT_EXPORT RenderWidgetHostVie
   virtual void SetForceSpecifiedDeadline(
       std::optional<uint32_t> deadline_in_frames) {}
 
+  // helium-fork: while set, a surface embedded before the renderer has produced
+  // a frame at the new size is stretched to fill the view instead of being
+  // pinned top-left with the remainder painted in the page's background color.
+  //
+  // That remainder is what the Arc shell's address bar band leaves behind when
+  // it retracts: the contents grow by the band's height in one step, and a page
+  // slow enough to miss the deadline shows a band-height slab of flat color
+  // along the bottom of the card until it catches up. Stretching is the lesser
+  // artifact -- the growth is 34 of 760 points, so the stale frame is scaled by
+  // ~4.5% for the few frames it is on screen, where the slab is a hard edge
+  // with no content behind it at all.
+  //
+  // Deliberately not the deadline: holding the swap long enough for a slow page
+  // outlasts the band's own animation, so the slide is swallowed and the band
+  // reads as an instant jump. Measured: the gutter goes away either way, but
+  // holding turns 6 animated frames into 1.
+  virtual void SetStretchContentDuringResize(bool stretch) {}
+
