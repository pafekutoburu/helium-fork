+void BrowserView::SetContentsStretchDuringResize(bool stretch) {
+  if (!multi_contents_view_ || contents_stretch_during_resize_ == stretch) {
+    return;
+  }
+  contents_stretch_during_resize_ = stretch;
+  for (ContentsContainerView* pane :
+       multi_contents_view_->contents_container_views()) {
+    for (views::WebView* web_view :
+         {static_cast<views::WebView*>(pane->contents_view()),
+          pane->devtools_web_view()}) {
+      content::WebContents* contents =
+          web_view ? web_view->web_contents() : nullptr;
+      if (!contents) {
+        continue;
+      }
+      if (content::RenderWidgetHostView* rwhv =
+              contents->GetRenderWidgetHostView()) {
+        rwhv->SetStretchContentDuringResize(stretch);
+      }
+    }
+  }
+}
