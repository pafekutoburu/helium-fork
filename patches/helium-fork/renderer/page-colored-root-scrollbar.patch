+// static
+std::optional<mojom::blink::ColorScheme>
+ScrollableArea::ColorSchemeFromBackground(const ComputedStyle& style) {
+  const Color background_color =
+      style.VisitedDependentColor(GetCSSPropertyBackgroundColor());
+  if (background_color.IsFullyTransparent()) {
+    return std::nullopt;
+  }
+  return background_color.GetLightness(Color::ColorSpace::kHSL) <= 0.5f
+             ? mojom::blink::ColorScheme::kDark
+             : mojom::blink::ColorScheme::kLight;
+}
