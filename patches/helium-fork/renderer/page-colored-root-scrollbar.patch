+
+// static
+blink::Color Scrollbar::DeriveScrollbarThumbColor(const blink::Color& track) {
+  // helium-fork: enough separation to grab, not so much that the scrollbar
+  // becomes the loudest thing on a dark page. Calibrated against the stock
+  // dark-scheme pair this replaces -- track (44,44,44), thumb (107,107,107) --
+  // which is the same ratio, so a page that happens to be that grey keeps the
+  // scrollbar it had before.
+  constexpr float kThumbTowardContrast = 0.32f;
+  const blink::Color contrast =
+      track.GetLightness(blink::Color::ColorSpace::kHSL) <= 0.5f
+          ? blink::Color::kWhite
+          : blink::Color::kBlack;
+  return blink::Color::InterpolateColors(
+      blink::Color::ColorSpace::kSRGB, std::nullopt, track, contrast,
+      kThumbTowardContrast);
+}
