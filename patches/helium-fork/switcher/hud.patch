--- /dev/null
+++ src/chrome/browser/ui/helium/helium_tab_switcher_controller.cc
@@ -0,0 +1,372 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/helium_tab_switcher_controller.h"
+
+#include <algorithm>
+#include <numeric>
+#include <set>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_data.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_user_gesture_details.h"
+#include "chrome/browser/ui/thumbnails/thumbnail_tab_helper.h"
+#include "chrome/browser/ui/views/tabs/switcher/tab_switcher_hud_view.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/base_window.h"
+#include "ui/events/event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/views/event_monitor.h"
+
+namespace {
+
+// How long Ctrl has to be held before the HUD becomes visible. A quick
+// Ctrl+Tab tap commits before this fires, so the HUD never flashes.
+constexpr base::TimeDelta kHudDelay = base::Milliseconds(150);
+
+// Upper bound on how much longer the HUD may wait for in-flight thumbnail
+// decodes after kHudDelay. Once shown, the HUD content is frozen — images
+// that miss this window keep their favicon placeholder for the session.
+constexpr base::TimeDelta kShowGateCap = base::Milliseconds(100);
+
+constexpr int kMinHudCount = 3;
+constexpr int kMaxHudCount = 9;
+
+}  // namespace
+
+DEFINE_USER_DATA(HeliumTabSwitcherController);
+
+HeliumTabSwitcherController::HeliumTabSwitcherController(
+    BrowserWindowInterface* browser_window,
+    PrefService* pref_service)
+    : browser_window_(browser_window),
+      pref_service_(pref_service),
+      scoped_unowned_user_data_(browser_window->GetUnownedUserDataHost(),
+                                *this) {}
+
+HeliumTabSwitcherController::~HeliumTabSwitcherController() {
+  if (cycling_) {
+    StopCycling();
+  }
+}
+
+// static
+HeliumTabSwitcherController* HeliumTabSwitcherController::From(
+    BrowserWindowInterface* browser_window) {
+  if (!browser_window) {
+    return nullptr;
+  }
+  return Get(browser_window->GetUnownedUserDataHost());
+}
+
+// static
+bool HeliumTabSwitcherController::MaybeHandleCycleCommand(
+    BrowserWindowInterface* browser_window,
+    int command_id) {
+  HeliumTabSwitcherController* controller = From(browser_window);
+  return controller && controller->HandleCycleCommand(command_id);
+}
+
+void HeliumTabSwitcherController::CommitIndex(size_t index) {
+  if (!cycling_ || index >= mru_tabs_.size()) {
+    return;
+  }
+  highlighted_ = index;
+  CommitCycling();
+}
+
+void HeliumTabSwitcherController::CancelCycling() {
+  if (!cycling_) {
+    return;
+  }
+  StopCycling();
+}
+
+bool HeliumTabSwitcherController::HandleCycleCommand(int command_id) {
+  if (!pref_service_->GetBoolean(prefs::kTabSwitcherHudEnabled)) {
+    return false;
+  }
+
+  if (!cycling_ && !StartCycling()) {
+    return false;
+  }
+
+  Advance(command_id == IDC_SELECT_PREVIOUS_TAB ? -1 : 1);
+  return true;
+}
+
+bool HeliumTabSwitcherController::StartCycling() {
+  TabStripModel* model = GetTabStripModel();
+  if (!model || model->count() < 2) {
+    return false;
+  }
+
+  views::Widget* browser_widget = GetBrowserWidget();
+  if (!browser_widget) {
+    return false;
+  }
+
+  // Snapshot tabs in MRU order (the active tab has the most recent
+  // last-active time, so it naturally sorts first).
+  const int count = model->count();
+  std::vector<int> indices(count);
+  std::iota(indices.begin(), indices.end(), 0);
+  std::sort(indices.begin(), indices.end(), [model](int a, int b) {
+    return model->GetWebContentsAt(a)->GetLastActiveTimeTicks() >
+           model->GetWebContentsAt(b)->GetLastActiveTimeTicks();
+  });
+
+  const int hud_count =
+      std::clamp(pref_service_->GetInteger(prefs::kTabSwitcherHudCount),
+                 kMinHudCount, kMaxHudCount);
+  const size_t cycle_size =
+      std::min(static_cast<size_t>(hud_count), indices.size());
+
+  mru_tabs_.clear();
+  for (size_t i = 0; i < cycle_size; ++i) {
+    mru_tabs_.push_back(model->GetTabAtIndex(indices[i])->GetHandle());
+  }
+  overflow_count_ = indices.size() - cycle_size;
+
+  // Kick off a fast-path capture for tabs without stored thumbnail data —
+  // notably the active tab, which is only ever captured when switched away
+  // from. Despite its name this API has no hidden-state requirement: for
+  // visible tabs it does a direct CopyFromSurface (~ms), comfortably inside
+  // kHudDelay; for background tabs without a copyable surface it silently
+  // no-ops.
+  for (const tabs::TabHandle& handle : mru_tabs_) {
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab) {
+      continue;
+    }
+    auto* thumbnail_helper =
+        ThumbnailTabHelper::FromWebContents(tab->GetContents());
+    if (thumbnail_helper && !thumbnail_helper->thumbnail()->has_data()) {
+      thumbnail_helper->CaptureThumbnailOnTabBackgrounded();
+    }
+  }
+  highlighted_ = 0;
+  cycling_ = true;
+
+  model->AddObserver(this);
+  browser_widget_observation_.Observe(browser_widget);
+  event_monitor_ = views::EventMonitor::CreateWindowMonitor(
+      this, browser_widget->GetNativeWindow(),
+      {ui::EventType::kKeyPressed, ui::EventType::kKeyReleased,
+       ui::EventType::kMousePressed});
+  hud_timer_.Start(FROM_HERE, kHudDelay,
+                   base::BindOnce(&HeliumTabSwitcherController::ShowHud,
+                                  base::Unretained(this)));
+  return true;
+}
+
+void HeliumTabSwitcherController::Advance(int delta) {
+  if (mru_tabs_.empty()) {
+    return;
+  }
+  const size_t size = mru_tabs_.size();
+  highlighted_ = delta > 0 ? (highlighted_ + 1) % size
+                           : (highlighted_ + size - 1) % size;
+  if (hud_view_) {
+    hud_view_->SetHighlightedIndex(highlighted_);
+  }
+}
+
+void HeliumTabSwitcherController::ShowHud() {
+  if (!cycling_ || hud_widget_) {
+    return;
+  }
+
+  views::Widget* browser_widget = GetBrowserWidget();
+  if (!browser_widget) {
+    CancelCycling();
+    return;
+  }
+
+  std::vector<tabs::TabData> cards;
+  cards.reserve(mru_tabs_.size());
+  for (const tabs::TabHandle& handle : mru_tabs_) {
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab) {
+      continue;
+    }
+    cards.push_back(tabs::TabData::FromTabInterface(tab));
+  }
+  if (cards.size() != mru_tabs_.size() || cards.size() < 2) {
+    // A tab died between snapshot and display; keep it simple and bail.
+    CancelCycling();
+    return;
+  }
+
+  auto view = std::make_unique<TabSwitcherHudView>(
+      this, std::move(cards), highlighted_, overflow_count_);
+
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.parent = browser_widget->GetNativeView();
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.accept_events = true;
+  // Keep the browser window as the key window so it continues to receive
+  // the Ctrl release / further Ctrl+Tab presses (see FindBarHost for the
+  // full rationale on Activatable::kNo).
+  params.activatable = views::Widget::InitParams::Activatable::kNo;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kDrop;
+  params.name = "HeliumTabSwitcherHud";
+
+  hud_widget_ = std::make_unique<views::Widget>();
+  hud_widget_->Init(std::move(params));
+  hud_view_ = hud_widget_->SetContentsView(std::move(view));
+
+  const gfx::Rect browser_bounds = browser_widget->GetWindowBoundsInScreen();
+  const gfx::Size size = hud_view_->GetPreferredSize();
+  hud_widget_->SetBounds(
+      gfx::Rect(browser_bounds.x() + (browser_bounds.width() - size.width()) / 2,
+                browser_bounds.y() +
+                    (browser_bounds.height() - size.height()) / 2,
+                size.width(), size.height()));
+
+  // Show gate: wait (bounded) until every card with stored thumbnail data
+  // has its decoded image, so the HUD appears fully formed and never
+  // repaints afterwards. SetReadyCallback fires synchronously if nothing is
+  // pending.
+  hud_view_->SetReadyCallback(
+      base::BindOnce(&HeliumTabSwitcherController::ShowHudWidgetNow,
+                     base::Unretained(this)));
+  if (hud_widget_ && !hud_widget_->IsVisible()) {
+    show_gate_timer_.Start(
+        FROM_HERE, kShowGateCap,
+        base::BindOnce(&HeliumTabSwitcherController::ShowHudWidgetNow,
+                       base::Unretained(this)));
+  }
+}
+
+void HeliumTabSwitcherController::ShowHudWidgetNow() {
+  if (!cycling_ || !hud_widget_ || hud_widget_->IsVisible()) {
+    return;
+  }
+  show_gate_timer_.Stop();
+  hud_view_->Freeze();
+  hud_widget_->ShowInactive();
+}
+
+void HeliumTabSwitcherController::CommitCycling() {
+  const tabs::TabHandle handle = mru_tabs_[highlighted_];
+  StopCycling();
+
+  tabs::TabInterface* tab = handle.Get();
+  if (!tab) {
+    return;
+  }
+  TabStripModel* model = GetTabStripModel();
+  if (!model) {
+    return;
+  }
+  const int index = model->GetIndexOfTab(tab);
+  if (index < 0) {
+    return;
+  }
+  model->ActivateTabAt(index,
+                       TabStripUserGestureDetails(
+                           TabStripUserGestureDetails::GestureType::kOther));
+}
+
+void HeliumTabSwitcherController::StopCycling() {
+  cycling_ = false;
+  hud_timer_.Stop();
+  show_gate_timer_.Stop();
+  event_monitor_.reset();
+  browser_widget_observation_.Reset();
+  if (TabStripModel* model = GetTabStripModel()) {
+    model->RemoveObserver(this);
+  }
+  hud_view_ = nullptr;
+  hud_widget_.reset();
+  mru_tabs_.clear();
+  overflow_count_ = 0;
+  highlighted_ = 0;
+}
+
+TabStripModel* HeliumTabSwitcherController::GetTabStripModel() {
+  return browser_window_->GetTabStripModel();
+}
+
+views::Widget* HeliumTabSwitcherController::GetBrowserWidget() {
+  ui::BaseWindow* window = browser_window_->GetWindow();
+  if (!window) {
+    return nullptr;
+  }
+  return views::Widget::GetWidgetForNativeWindow(window->GetNativeWindow());
+}
+
+void HeliumTabSwitcherController::OnEvent(const ui::Event& event) {
+  if (event.type() == ui::EventType::kKeyReleased &&
+      event.AsKeyEvent()->key_code() == ui::VKEY_CONTROL) {
+    CommitCycling();
+    return;
+  }
+
+  if (event.type() == ui::EventType::kKeyPressed &&
+      event.AsKeyEvent()->key_code() == ui::VKEY_ESCAPE) {
+    CancelCycling();
+    return;
+  }
+
+  if (event.type() == ui::EventType::kMousePressed) {
+    // Clicks on the HUD itself arrive at the HUD widget, not the monitored
+    // browser window, so any press seen here is outside the HUD.
+    CancelCycling();
+  }
+}
+
+void HeliumTabSwitcherController::OnWidgetActivationChanged(
+    views::Widget* widget,
+    bool active) {
+  if (!active) {
+    CancelCycling();
+  }
+}
+
+void HeliumTabSwitcherController::OnWidgetDestroying(views::Widget* widget) {
+  CancelCycling();
+}
+
+void HeliumTabSwitcherController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (!cycling_ || change.type() != TabStripModelChange::kRemoved) {
+    return;
+  }
+
+  const tabs::TabHandle highlighted_handle =
+      highlighted_ < mru_tabs_.size() ? mru_tabs_[highlighted_]
+                                      : tabs::TabHandle::Null();
+
+  std::erase_if(mru_tabs_,
+                [](const tabs::TabHandle& handle) { return !handle.Get(); });
+
+  if (mru_tabs_.size() < 2) {
+    CancelCycling();
+    return;
+  }
+
+  const auto it = std::ranges::find(mru_tabs_, highlighted_handle);
+  highlighted_ = it != mru_tabs_.end()
+                     ? static_cast<size_t>(it - mru_tabs_.begin())
+                     : std::min(highlighted_, mru_tabs_.size() - 1);
+
+  if (hud_widget_) {
+    // Rare path: rebuild the HUD with the surviving tabs.
+    hud_view_ = nullptr;
+    hud_widget_.reset();
+    ShowHud();
+  }
+}
