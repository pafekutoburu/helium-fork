+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_HELIUM_TAB_SWITCHER_CONTROLLER_H_
+#define CHROME_BROWSER_UI_HELIUM_HELIUM_TAB_SWITCHER_CONTROLLER_H_
+
+#include <memory>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+#include "ui/events/event_observer.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_observer.h"
+
+class BrowserWindowInterface;
+class PrefService;
+class TabStripModel;
+class TabSwitcherHudView;
+
+namespace views {
+class EventMonitor;
+}  // namespace views
+
+// Implements the visual Ctrl+Tab switcher with the macOS Cmd+Tab interaction
+// model:
+//   - A quick Ctrl+Tab tap instantly activates the most recently used tab
+//     (no HUD ever appears).
+//   - Holding Ctrl for longer than a short delay shows a centered HUD with
+//     one card per tab (thumbnail + favicon + title) in MRU order. Further
+//     Tab presses move the highlight without activating intermediate tabs.
+//   - Releasing Ctrl commits the highlighted tab; Esc or clicking the
+//     browser window cancels.
+//
+// Cycling commands are intercepted in
+// BrowserCommandController::HandleCommandWithDisposition() before the default
+// IDC_SELECT_NEXT_TAB / IDC_SELECT_PREVIOUS_TAB handling; when the
+// helium.workspace.ctrl_tab_hud pref is disabled this class consumes nothing
+// and the stock (Helium MRU / positional) cycling behavior applies.
+class HeliumTabSwitcherController : public ui::EventObserver,
+                                    public views::WidgetObserver,
+                                    public TabStripModelObserver {
+ public:
+  DECLARE_USER_DATA(HeliumTabSwitcherController);
+
+  HeliumTabSwitcherController(BrowserWindowInterface* browser_window,
+                              PrefService* pref_service);
+  HeliumTabSwitcherController(const HeliumTabSwitcherController&) = delete;
+  HeliumTabSwitcherController& operator=(const HeliumTabSwitcherController&) =
+      delete;
+  ~HeliumTabSwitcherController() override;
+
+  static HeliumTabSwitcherController* From(
+      BrowserWindowInterface* browser_window);
+
+  // Returns true if the command was consumed by the switcher. Called from
+  // BrowserCommandController for IDC_SELECT_NEXT_TAB /
+  // IDC_SELECT_PREVIOUS_TAB.
+  static bool MaybeHandleCycleCommand(BrowserWindowInterface* browser_window,
+                                      int command_id);
+
+  // Called by TabSwitcherHudView when a card is clicked.
+  void CommitIndex(size_t index);
+
+  // Stops cycling without activating any tab.
+  void CancelCycling();
+
+  bool IsCyclingForTesting() const { return cycling_; }
+
+ private:
+  bool HandleCycleCommand(int command_id);
+  bool StartCycling();
+  void Advance(int delta);
+  void ShowHud();
+  // Makes the (already created) HUD widget visible and freezes its content.
+  // Reached either from the all-thumbnails-ready callback or from the
+  // bounded show-gate timer, whichever fires first; idempotent.
+  void ShowHudWidgetNow();
+  void CommitCycling();
+  // Shared teardown for commit and cancel paths.
+  void StopCycling();
+
+  TabStripModel* GetTabStripModel();
+  views::Widget* GetBrowserWidget();
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override;
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override;
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+  const raw_ptr<BrowserWindowInterface> browser_window_;
+  const raw_ptr<PrefService> pref_service_;
+
+  // State below is only meaningful while |cycling_| is true.
+  bool cycling_ = false;
+  // Cycle set in MRU order (active tab first), capped by the
+  // helium.workspace.ctrl_tab_hud_count pref.
+  std::vector<tabs::TabHandle> mru_tabs_;
+  // Number of open tabs not included in |mru_tabs_|.
+  size_t overflow_count_ = 0;
+  size_t highlighted_ = 0;
+  base::OneShotTimer hud_timer_;
+  base::OneShotTimer show_gate_timer_;
+  std::unique_ptr<views::EventMonitor> event_monitor_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      browser_widget_observation_{this};
+  std::unique_ptr<views::Widget> hud_widget_;
+  raw_ptr<TabSwitcherHudView> hud_view_ = nullptr;
+
+  ui::ScopedUnownedUserData<HeliumTabSwitcherController>
+      scoped_unowned_user_data_;
+};
+
+#endif  // CHROME_BROWSER_UI_HELIUM_HELIUM_TAB_SWITCHER_CONTROLLER_H_
