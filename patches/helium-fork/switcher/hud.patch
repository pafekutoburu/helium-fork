+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_SWITCHER_TAB_SWITCHER_HUD_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_SWITCHER_TAB_SWITCHER_HUD_VIEW_H_
+
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/tabs/tab_data.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+class HeliumTabSwitcherController;
+
+// The centered Ctrl+Tab switcher overlay: a horizontal row of cards
+// (thumbnail + favicon + title) in MRU order with one highlighted entry.
+// Pure presentation; all interaction state lives in
+// HeliumTabSwitcherController, which owns the hosting widget.
+class TabSwitcherHudView : public views::View {
+  METADATA_HEADER(TabSwitcherHudView, views::View)
+
+ public:
+  TabSwitcherHudView(HeliumTabSwitcherController* controller,
+                     std::vector<tabs::TabData> tabs,
+                     size_t highlighted_index,
+                     size_t overflow_count);
+  TabSwitcherHudView(const TabSwitcherHudView&) = delete;
+  TabSwitcherHudView& operator=(const TabSwitcherHudView&) = delete;
+  ~TabSwitcherHudView() override;
+
+  void SetHighlightedIndex(size_t index);
+
+  // True once every card whose thumbnail already had captured data has
+  // received (and displayed) its decoded image. Cards without data show a
+  // large-favicon placeholder and are not waited for.
+  bool AllExpectedImagesReady() const { return pending_images_ == 0; }
+
+  // Invoked (at most once) when AllExpectedImagesReady() becomes true.
+  void SetReadyCallback(base::OnceClosure callback);
+
+  // Stops accepting further thumbnail updates so the view never changes
+  // after it becomes visible.
+  void Freeze();
+
+ private:
+  class CardView;
+
+  void OnCardImageReady();
+
+  std::vector<raw_ptr<CardView>> cards_;
+  size_t highlighted_index_ = 0;
+  size_t pending_images_ = 0;
+  base::OnceClosure ready_callback_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_SWITCHER_TAB_SWITCHER_HUD_VIEW_H_
