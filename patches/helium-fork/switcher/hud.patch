--- /dev/null
+++ src/chrome/browser/ui/views/tabs/switcher/tab_switcher_hud_view.cc
@@ -0,0 +1,230 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/switcher/tab_switcher_hud_view.h"
+
+#include <algorithm>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/helium/helium_tab_switcher_controller.h"
+#include "chrome/browser/ui/thumbnails/thumbnail_image.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/geometry/rounded_corners_f.h"
+#include "ui/gfx/text_constants.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/button/button.h"
+#include "ui/views/controls/image_view.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/layout/box_layout_view.h"
+
+namespace {
+
+constexpr int kThumbnailWidth = 200;
+constexpr int kThumbnailHeight = 125;
+constexpr int kCardCornerRadius = 12;
+constexpr int kCardBorderThickness = 2;
+constexpr int kCardPadding = 8;
+constexpr int kHudCornerRadius = 16;
+constexpr int kHudPadding = 16;
+constexpr int kCardSpacing = 12;
+constexpr int kFaviconSize = 16;
+constexpr int kFallbackFaviconSize = 32;
+
+}  // namespace
+
+// A single tab card: thumbnail on top, favicon + title below. Clicking the
+// card commits that tab.
+class TabSwitcherHudView::CardView : public views::Button {
+  METADATA_HEADER(CardView, views::Button)
+
+ public:
+  CardView(HeliumTabSwitcherController* controller,
+           const tabs::TabData& data,
+           size_t index,
+           base::OnceClosure on_first_image)
+      : views::Button(
+            base::BindRepeating(&HeliumTabSwitcherController::CommitIndex,
+                                base::Unretained(controller),
+                                index)),
+        on_first_image_(std::move(on_first_image)) {
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical,
+        gfx::Insets(kCardPadding), kCardPadding));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kStart);
+
+    thumbnail_ = AddChildView(std::make_unique<views::ImageView>());
+    thumbnail_->SetPreferredSize(
+        gfx::Size(kThumbnailWidth, kThumbnailHeight));
+    thumbnail_->SetHorizontalAlignment(views::ImageView::Alignment::kCenter);
+    thumbnail_->SetVerticalAlignment(views::ImageView::Alignment::kCenter);
+
+    auto* title_row = AddChildView(std::make_unique<views::BoxLayoutView>());
+    title_row->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+    title_row->SetBetweenChildSpacing(kCardPadding);
+    title_row->SetCrossAxisAlignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+
+    auto* favicon = title_row->AddChildView(std::make_unique<views::ImageView>());
+    favicon->SetImage(data.favicon);
+    favicon->SetImageSize(gfx::Size(kFaviconSize, kFaviconSize));
+
+    auto* title = title_row->AddChildView(std::make_unique<views::Label>());
+    title->SetText(data.title);
+    title->SetElideBehavior(gfx::ELIDE_TAIL);
+    title->SetMaximumWidthSingleLine(kThumbnailWidth - kFaviconSize -
+                                     2 * kCardPadding);
+    title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+
+    // Until (unless) a thumbnail arrives, show a large favicon centered in
+    // the thumbnail slot. Discarded tabs stay in this state.
+    thumbnail_->SetImage(data.favicon);
+    thumbnail_->SetImageSize(
+        gfx::Size(kFallbackFaviconSize, kFallbackFaviconSize));
+
+    if (data.thumbnail) {
+      subscription_ = data.thumbnail->Subscribe();
+      subscription_->SetSizeHint(
+          gfx::Size(kThumbnailWidth, kThumbnailHeight));
+      subscription_->SetUncompressedImageCallback(base::BindRepeating(
+          &CardView::OnThumbnailAvailable, weak_factory_.GetWeakPtr()));
+      // With no captured data this is a no-op (thumbnail_image.cc bails
+      // early); the image then arrives via the capture kicked off in
+      // HeliumTabSwitcherController::StartCycling().
+      if (data.thumbnail->has_data()) {
+        data.thumbnail->RequestThumbnailImage();
+      }
+    }
+
+    GetViewAccessibility().SetName(
+        data.title.empty() ? u"tab" : data.title);
+    SetHighlighted(false);
+  }
+
+  CardView(const CardView&) = delete;
+  CardView& operator=(const CardView&) = delete;
+  ~CardView() override = default;
+
+  // Drops the thumbnail subscription so the card never changes once the
+  // HUD is visible.
+  void Freeze() { subscription_.reset(); }
+
+  void SetHighlighted(bool highlighted) {
+    if (highlighted) {
+      SetBorder(views::CreateRoundedRectBorder(
+          kCardBorderThickness, kCardCornerRadius,
+          ui::kColorFocusableBorderFocused));
+    } else {
+      SetBorder(views::CreateEmptyBorder(kCardBorderThickness));
+    }
+  }
+
+ private:
+  void OnThumbnailAvailable(gfx::ImageSkia image) {
+    if (image.isNull() || image.width() < 1 || image.height() < 1) {
+      return;
+    }
+    // Aspect-fit into the thumbnail slot.
+    const float scale =
+        std::min(static_cast<float>(kThumbnailWidth) / image.width(),
+                 static_cast<float>(kThumbnailHeight) / image.height());
+    thumbnail_->SetImage(ui::ImageModel::FromImageSkia(image));
+    thumbnail_->SetImageSize(
+        gfx::Size(static_cast<int>(image.width() * scale),
+                  static_cast<int>(image.height() * scale)));
+    if (on_first_image_) {
+      std::move(on_first_image_).Run();
+    }
+  }
+
+  raw_ptr<views::ImageView> thumbnail_ = nullptr;
+  std::unique_ptr<ThumbnailImage::Subscription> subscription_;
+  base::OnceClosure on_first_image_;
+  base::WeakPtrFactory<CardView> weak_factory_{this};
+};
+
+BEGIN_METADATA(TabSwitcherHudView, CardView)
+END_METADATA
+
+TabSwitcherHudView::TabSwitcherHudView(
+    HeliumTabSwitcherController* controller,
+    std::vector<tabs::TabData> tabs,
+    size_t highlighted_index,
+    size_t overflow_count) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(kHudPadding),
+      kCardSpacing));
+
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  layer()->SetRoundedCornerRadius(gfx::RoundedCornersF(kHudCornerRadius));
+  layer()->SetIsFastRoundedCorner(true);
+  SetBackground(views::CreateSolidBackground(ui::kColorBubbleBackground));
+
+  for (size_t i = 0; i < tabs.size(); ++i) {
+    // Only cards with already-captured data are awaited by the show gate;
+    // the rest keep their favicon placeholder.
+    base::OnceClosure on_first_image;
+    if (tabs[i].thumbnail && tabs[i].thumbnail->has_data()) {
+      ++pending_images_;
+      on_first_image = base::BindOnce(&TabSwitcherHudView::OnCardImageReady,
+                                      base::Unretained(this));
+    }
+    cards_.push_back(AddChildView(std::make_unique<CardView>(
+        controller, tabs[i], i, std::move(on_first_image))));
+  }
+
+  if (overflow_count > 0) {
+    auto* overflow = AddChildView(std::make_unique<views::Label>());
+    overflow->SetText(u"+" +
+                      base::UTF8ToUTF16(base::NumberToString(overflow_count)));
+  }
+
+  highlighted_index_ = std::min(highlighted_index, cards_.size() - 1);
+  cards_[highlighted_index_]->SetHighlighted(true);
+}
+
+TabSwitcherHudView::~TabSwitcherHudView() = default;
+
+void TabSwitcherHudView::SetHighlightedIndex(size_t index) {
+  if (index >= cards_.size() || index == highlighted_index_) {
+    return;
+  }
+  cards_[highlighted_index_]->SetHighlighted(false);
+  highlighted_index_ = index;
+  cards_[highlighted_index_]->SetHighlighted(true);
+}
+
+void TabSwitcherHudView::SetReadyCallback(base::OnceClosure callback) {
+  ready_callback_ = std::move(callback);
+  if (pending_images_ == 0 && ready_callback_) {
+    std::move(ready_callback_).Run();
+  }
+}
+
+void TabSwitcherHudView::Freeze() {
+  for (CardView* card : cards_) {
+    card->Freeze();
+  }
+}
+
+void TabSwitcherHudView::OnCardImageReady() {
+  if (pending_images_ > 0 && --pending_images_ == 0 && ready_callback_) {
+    std::move(ready_callback_).Run();
+  }
+}
+
+BEGIN_METADATA(TabSwitcherHudView)
+END_METADATA
