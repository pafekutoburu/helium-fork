--- src.orig/chrome/browser/ui/helium/helium_layout_state_controller.h
+++ src/chrome/browser/ui/helium/helium_layout_state_controller.h
@@ -21,16 +21,20 @@ enum class HeliumLayoutType {
   kMaxValue = kDynamic,
 };
 
-// helium-fork: the Arc shell has a single layout (the sidebar) and three
-// forms, which differ only in how the address bar band behaves. The band is
-// the one piece of top chrome the shell still has, so this replaces the
-// old zen-mode boolean rather than sitting beside it.
+// helium-fork: the Arc shell has a single layout (the sidebar) and two
+// reachable forms, which differ only in how the address bar band behaves.
+// The band is the one piece of top chrome the shell still has, so this
+// replaces the old zen-mode boolean rather than sitting beside it.
 enum class HeliumAddressBarMode {
   // The band is always visible above the contents.
   kDocked = 0,
   // No band at all; the address entry lives in the sidebar.
   kHidden = 1,
   // The band reveals on hover and hides again (what zen mode used to be).
+  // Retired 2026-08-16: nothing offers it and stored values migrate to
+  // kDocked (NormalizeAddressBarMode). The enumerator stays because the zen
+  // machinery it named is still in the tree -- the hidden sidebar's hover
+  // reveal runs on the same animations.
   kAuto = 2,
   kMaxValue = kAuto,
 };
