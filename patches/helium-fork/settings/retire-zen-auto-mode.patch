===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_address_bar_mode.h
@@ -0,0 +1,30 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_HELIUM_ARC_ADDRESS_BAR_MODE_H_
+#define CHROME_BROWSER_UI_HELIUM_ARC_ADDRESS_BAR_MODE_H_
+
+// helium-fork: the stored address-bar-mode pref values, as bare ints so the
+// rule below can live in the minimal unit-test target (the controller header
+// pulls prefs and unowned_user_data, which that target cannot link). The
+// literals are static_assert-pinned to HeliumAddressBarMode in
+// helium_layout_state_controller.cc.
+namespace helium {
+
+inline constexpr int kAddressBarModeDocked = 0;
+inline constexpr int kAddressBarModeHidden = 1;
+// Zen, retired 2026-08-16. Kept named so the rule reads as what it is.
+inline constexpr int kAddressBarModeRetiredAuto = 2;
+
+// Any stored value that is not docked or hidden -- out of range, or the
+// retired zen value -- reads as docked.
+inline constexpr int NormalizeAddressBarMode(int value) {
+  return (value == kAddressBarModeDocked || value == kAddressBarModeHidden)
+             ? value
+             : kAddressBarModeDocked;
+}
+
+}  // namespace helium
+
+#endif  // CHROME_BROWSER_UI_HELIUM_ARC_ADDRESS_BAR_MODE_H_
Index: src/chrome/browser/ui/helium/arc_address_bar_mode_unittest.cc
===================================================================
--- /dev/null
+++ src/chrome/browser/ui/helium/arc_address_bar_mode_unittest.cc
@@ -0,0 +1,31 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/helium/arc_address_bar_mode.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace helium {
+namespace {
+
+TEST(ArcAddressBarModeTest, KeepsReachableModes) {
+  EXPECT_EQ(kAddressBarModeDocked,
+            NormalizeAddressBarMode(kAddressBarModeDocked));
+  EXPECT_EQ(kAddressBarModeHidden,
+            NormalizeAddressBarMode(kAddressBarModeHidden));
+}
+
+TEST(ArcAddressBarModeTest, RetiredAutoReadsAsDocked) {
+  EXPECT_EQ(kAddressBarModeDocked,
+            NormalizeAddressBarMode(kAddressBarModeRetiredAuto));
+}
+
+TEST(ArcAddressBarModeTest, OutOfRangeReadsAsDocked) {
+  EXPECT_EQ(kAddressBarModeDocked, NormalizeAddressBarMode(-1));
+  EXPECT_EQ(kAddressBarModeDocked, NormalizeAddressBarMode(3));
+  EXPECT_EQ(kAddressBarModeDocked, NormalizeAddressBarMode(1000));
+}
+
+}  // namespace
+}  // namespace helium
